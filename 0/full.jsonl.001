d":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"b15f7769-e227-41ef-9739-cb580b198acb","isSidechain":false,"promptId":"afea6d65-2af9-420c-969b-b55d07c96f18","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A9JC9x6WvPv9W7Sh6vuFcc","type":"tool_result","content":"The file /Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean has been updated successfully. (note: the file had been modified on disk since you last read it — the edit applied cleanly, but the file contains other changes not in your context. Read it before edits that depend on surrounding content.)"}]},"uuid":"a92a94ff-4843-4c75-a75a-9e9988f55920","timestamp":"2026-10-31T22:11:05.140Z","toolUseResult":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","oldString":"/-! ## R4 (MM-03.3 §9.2) -/","newString":"/-! ## Copies and pointers (L6: `transfer`, `store`, `issue`) -/\n\n/-- The bytes of the range of the leaf `l` in `s2`, if its allocation is registered. -/\ndef rangeBytes (s2 : MM02.State) (L : Layout) (l : Nat) : Option (List MM02.AByte) :=\n  (s2.allocs (L l).alloc).map fun a => a.bytesAt (L l).off (L l).len\n\n/-- L6: the bytes of the range of the leaf `l` in `s2` as the argument of a write, value and\nprovenance of each initialised byte (\"avec les octets lus, provenance comprise\"). -/\ndef bytesOf (s2 : MM02.State) (L : Layout) (l : Nat) : Nat → UInt8 × Option Nat := fun i =>\n  match (s2.allocs (L l).alloc).map fun a => a.bytes ((L l).off + i) with\n  | some (.init v p) => (v, p)\n  | _ => (0, none)\n\n/-- L6: the pairs of corresponding leaves of `transfer src dst` (`corr`, the ordered isomorphism\nof O4.2), in the order of the leaves of the source. -/\ndef transferPairs (P : List Place) (src dst : Nat) : List (Nat × Nat) :=\n  (footprint P src).filterMap fun l => (corr P src dst l).map fun l' => (l, l')\n\n/-- L6 (`transfer`): for each pair `(l, l')`, a read of the range of `l` (`ReadStep`), then a write\nof the range of `l'` (`WriteStep`) with the bytes of the range of `l`. Held authorities and owned\nstorage give no step. -/\ndef copyOps (s2 : MM02.State) (L : Layout) : List (Nat × Nat) → List Op2\n  | [] => []\n  | (l, l') :: ps => .read (leafAcc s2 L .read l) :: .write (leafAcc s2 L .write l') (bytesOf s2 L l) ::\n      copyOps s2 L ps\n\n/-- L6 (`transfer src dst`): the copy of the corresponding leaves. -/\ndef transferOps (s2 : MM02.State) (L : Layout) (P : List Place) (src dst : Nat) : List Op2 :=\n  copyOps s2 L (transferPairs P src dst)\n\n/-- L6, hypothesis `SameSizeAlong` (types, spec 4): two corresponding leaves have the same size. -/\ndef SameSizeAlong (L : Layout) (P : List Place) (src dst : Nat) : Prop :=\n  ∀ l l', (l, l') ∈ transferPairs P src dst → (L l).len = (L l').len\n\ntheorem mem_transferPairs {P : List Place} {src dst l l' : Nat} :\n    (l, l') ∈ transferPairs P src dst ↔ l ∈ footprint P src ∧ corr P src dst l = some l' := by\n  simp only [transferPairs, List.mem_filterMap]\n  constructor\n  · rintro ⟨x, hx, e⟩\n    cases hc : corr P src dst x with\n    | none => rw [hc] at e; cases e\n    | some y => rw [hc] at e; cases e; exact ⟨hx, hc⟩\n  · rintro ⟨h, e⟩; exact ⟨l, h, by rw [e]; rfl⟩\n\n/-- L6: after the write of the range of a leaf in a state that keeps the allocations of `s2`, the\nrange holds the bytes written, all initialised. -/\ntheorem rangeBytes_write {s2 t : MM02.State} (hd : Dom s2 t) {L : Layout} {l : Nat}\n    {w : Nat → UInt8 × Option Nat} (h : AllocP s2 (L l).alloc fun _ => True) :\n    rangeBytes (t.write (leafAcc s2 L .write l) w) L l =\n      some ((List.range (L l).len).map fun i => .init (w i).1 (w i).2) := by\n  obtain ⟨a, ha, -⟩ := h\n  obtain ⟨b, hb, -, e, -⟩ := hd _ a ha\n  have hacc : leafAcc s2 L .write l = leafAcc t L .write l := by rw [leafAcc_of ha, leafAcc_of hb, e]\n  rw [hacc, rangeBytes, write_allocs, leafAcc_of hb]\n  simp only [↓reduceIte, hb, Option.map_some, Nat.add_sub_cancel_left, Option.some.injEq,\n    MM02.Alloc.bytesAt, MM02.Alloc.write, List.map_inj_left, List.mem_range]\n  intro i hi\n  have hr : (L l).off ≤ (L l).off + i ∧ (L l).off + i < (L l).off + (L l).len :=\n    ⟨Nat.le_add_right _ _, by omega⟩\n  simp only [hr, and_self, ↓reduceIte, Nat.add_sub_cancel_left]\n\n/-- L6: the run of the copies of a transfer, from a state `t` that keeps the allocations of the\nstate `s2` where the sequence was computed: every read and write has the outcome `ok` when the\nsource ranges are live and initialised and the destination ranges live, under `dec` along the run\nand `stat` (K5); the run keeps the allocations; every destination range ends initialised. -/\ntheorem copyOps_run {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {s2 : MM02.State} {L : Layout} (hstatR : ∀ s ac, ObR.stat s ac)\n    (hstatW : ∀ s ac w, ObW.stat s ac w) :\n    ∀ (ps : List (Nat × Nat)) (t : MM02.State), Dom s2 t →\n      (∀ l l', (l, l') ∈ ps →\n        (AllocP s2 (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size ∧\n          a.InitRange (L l).off (L l).len) ∧\n        AllocP s2 (L l').alloc fun a => a.live = true ∧ (L l').off + (L l').len ≤ a.size) →\n      DecAlong ObR ObW t (copyOps s2 L ps) →\n      AllOk C ObR ObW t (copyOps s2 L ps) ∧ Dom t (exec t (copyOps s2 L ps)) ∧\n        ∀ l l', (l, l') ∈ ps →\n          AllocP (exec t (copyOps s2 L ps)) (L l').alloc fun a => a.InitRange (L l').off (L l').len\n  | [], t, _, _, _ => ⟨trivial, Dom.refl _, fun _ _ h => by cases h⟩\n  | (l, l') :: ps, t, hd, hps, hdec => by\n    obtain ⟨hsrc, hdst⟩ := hps l l' (List.mem_cons_self ..)\n    -- the source and destination in `t`\n    have hsrc' : AllocP t (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size ∧\n        a.InitRange (L l).off (L l).len :=\n      hsrc.of_dom hd fun a a' _ e2 e3 _ hb ⟨h1, h2, h3⟩ =>\n        ⟨e3 ▸ h1, e2 ▸ h2, fun i hi => hb _ (h3 i hi)⟩\n    have hdst' : AllocP t (L l').alloc fun a => a.live = true ∧ (L l').off + (L l').len ≤ a.size :=\n      hdst.of_dom hd fun a a' _ e2 e3 _ _ ⟨h1, h2⟩ => ⟨e3 ▸ h1, e2 ▸ h2⟩\n    have eR : leafAcc s2 L .read l = leafAcc t L .read l :=\n      (leafAcc_dom hd (hsrc.mono fun _ _ => trivial)).symm\n    have eW : leafAcc s2 L .write l' = leafAcc t L .write l' :=\n      (leafAcc_dom hd (hdst.mono fun _ _ => trivial)).symm\n    obtain ⟨hdecR, hdecW, hdec⟩ := hdec\n    -- the read\n    obtain ⟨a, ha, hla, hsz, hin⟩ := hsrc'\n    have hread : MM02.Read t (leafAcc s2 L .read l) := by\n      rw [eR, leafAcc_of ha]\n      have e : a.base + (L l).off - a.base = (L l).off := Nat.add_sub_cancel_left _ _\n      exact ⟨a, ha, hla, ⟨Nat.le_add_right _ _, by simp only; omega⟩, by simp only [e]; exact hin,\n        .inl rfl⟩\n    have hok := MM02.ReadStep.ok (ObR := ObR) (by rw [eR, leafAcc_of ha]; exact ha)\n      ⟨hread, hdecR, hstatR _ _⟩\n    -- the write\n    have hw := write_leaf_ok (ObW := ObW) (w := bytesOf s2 L l) hstatW hdst' (by rw [← eW]; exact hdecW)\n    rw [← eW] at hw\n    have hd₁ : Dom t (t.write (leafAcc s2 L .write l') (bytesOf s2 L l)) := Dom.write _ _ _\n    have ih := copyOps_run hstatR hstatW ps _ (hd.trans hd₁)\n      (fun m m' hm => hps m m' (List.mem_cons_of_mem _ hm)) hdec\n    refine ⟨⟨⟨_, hok⟩, hw, ih.1⟩, hd₁.trans ih.2.1, fun m m' hm => ?_⟩\n    rcases List.mem_cons.1 hm with e | hm\n    · cases e\n      have := rangeBytes_write (w := bytesOf s2 L l) (hd.trans (Dom.refl _))\n        (L := L) (l := l') (hdst.mono fun _ _ => trivial)\n      obtain ⟨b, hb, -⟩ := hdst'\n      have hinit : AllocP (t.write (leafAcc s2 L .write l') (bytesOf s2 L l)) (L l').alloc\n          fun a => a.InitRange (L l').off (L l').len := by\n        rw [eW]; exact write_leaf_init ⟨b, hb, trivial⟩\n      exact hinit.of_dom ih.2.1 fun _ _ _ _ _ _ hb h i hi => hb _ (h i hi)\n    · exact ih.2.2 m m' hm\n\n/-- A leaf of a usable place has its allocation live and its range within it (K1 (c), K3). -/\ntheorem live_of_usable_part {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout}\n    {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3) (hR : ReprB tok ptok provOf L s3 s2) {q l : Nat}\n    (hu : s3.Usable q) (hl : l ∈ footprint s3.P q) :\n    AllocP s2 (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size := by\n  obtain ⟨hlP, hlf, hlq⟩ := mem_footprint.1 hl\n  have hul : s3.Usable l := usable_of_partOf hwf (l + 1) l q (Nat.lt_succ_self l) hlq hu\n  obtain ⟨r, hr, hlr⟩ := exists_rootPlace hwf (l + 1) l (Nat.lt_succ_self l) hlP\n  exact (hR.live r hr.1 hr (usable_of_part hwf hlr hul) l (mem_footprint.2 ⟨hlP, hlf, hlr⟩)).and\n    (hR.lwf.within l hlP hlf)\n\n/-- `ReprB` carries over when the places keep their parents and only change owners between places,\nthe MM-02 state keeps its allocations, usability, stack and `freed` marks are unchanged, and every\nleaf that becomes `Init` has its range initialised (L6: `transfer` moves the owners of the owned\nstorage, A5). -/\ntheorem ReprB.transport {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout}\n    {s3 s3' : S3} {s2 s2' : MM02.State} (hR : ReprB tok ptok provOf L s3 s2) (hd : Dom s2 s2')\n    (hlen : s3'.P.length = s3.P.length) (hpar : parentOf s3'.P = parentOf s3.P)\n    (hown : ∀ (q : Nat) (pl' : Place), s3'.P[q]? = some pl' → ∃ pl : Place, s3.P[q]? = some pl ∧\n      (pl'.owner = pl.owner ∨ (pl'.owner.isPlace = true ∧ pl.owner.isPlace = true)))\n    (hF : s3'.F = s3.F) (hfr : s3'.freed = s3.freed) (hU : ∀ q, s3'.Usable q ↔ s3.Usable q)\n    (hI : ∀ l < s3.P.length, isLeaf s3.P l → s3'.I l = .init →\n      s3.I l = .init ∨ AllocP s2' (L l).alloc fun a => a.InitRange (L l).off (L l).len) :\n    ReprB tok ptok provOf L s3' s2' := by\n  have hfp : ∀ q, footprint s3'.P q = footprint s3.P q := footprint_congr hlen hpar\n  have hleaf : ∀ l, isLeaf s3'.P l ↔ isLeaf s3.P l := fun l => by simp only [isLeaf, hlen, hpar]\n  have hroot : ∀ r, RootPlace s3'.P r ↔ RootPlace s3.P r := fun r => by\n    simp only [RootPlace, hlen, hpar]\n  -- the owner of a root, read in `s3'`\n  have hfr' : ∀ r (pl' : Place), s3'.P[r]? = some pl' → ∃ pl : Place, s3.P[r]? = some pl ∧\n      (∀ f, pl'.owner = .frame f → pl.owner = .frame f) ∧\n      (pl'.owner.isPlace = true → pl.owner.isPlace = true) := fun r pl' h => by\n    obtain ⟨pl, hpl, e⟩ := hown r pl' h\n    refine ⟨pl, hpl, fun f hf => ?_, fun hp => ?_⟩\n    · rcases e with e | ⟨h1, -⟩\n      · rw [← e, hf]\n      · rw [hf] at h1; cases h1\n    · rcases e with e | ⟨-, h2⟩\n      · rw [← e]; exact hp\n      · exact h2\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>\n    simp only [hlen, hfp, hleaf, hroot, hF, hfr, hU]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact fun l hl hlf => (hR.lwf.within l hl hlf).of_dom hd fun a a' _ e _ _ _ h => e ▸ h\n  · exact hR.inj\n  · intro r hr hrt\n    cases hpl' : s3'.P[r]? with\n    | none => trivial\n    | some pl' =>\n      obtain ⟨pl, hpl, hfrm, -⟩ := hfr' r pl' hpl'\n      have := hR.tokens r hr hrt\n      rw [hpl] at this\n      show OptP (tokOf tok pl'.owner) _ True\n      cases ho' : pl'.owner with\n      | place _ => trivial\n      | frame f =>\n        have e := hfrm f ho'\n        simp only [OptP, e, tokOf] at this\n        exact fun l hl => (this l hl).of_dom hd fun _ _ _ _ _ e _ h => e ▸ h\n  · exact fun r hr hrt => OptP.imp (hR.provTokens r hr hrt) (fun _ h l hl =>\n      (h l hl).of_dom hd fun _ _ _ _ _ e _ h => e ▸ h) id\n  · exact fun r hr hrt hu l hl => (hR.live r hr hrt hu l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h\n  · intro l hl hlf hi\n    rcases hI l hl hlf hi with h | h\n    · exact (hR.init l hl hlf h).of_dom hd fun a a' _ _ _ _ hb h i hi => hb _ (h i hi)\n    · exact h\n  · exact fun r hr hrt hf l hl => (hR.freed r hr hrt hf l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h\n  · intro r hr hrt hg l hl\n    have hg' : OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False := by\n      cases hpl' : s3'.P[r]? with\n      | none => rw [hpl'] at hg; exact hg.elim\n      | some pl' =>\n        rw [hpl'] at hg\n        obtain ⟨pl, hpl, hfrm, -⟩ := hfr' r pl' hpl'\n        rw [hpl]\n        show FrameGone s3.F pl.owner\n        cases ho' : pl'.owner with\n        | place _ => rw [ho'] at hg; exact hg.elim\n        | frame f => rw [ho'] at hg; rw [hfrm f ho']; exact hg\n    exact (hR.exited r hr hrt hg' l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h\n  · intro r hr hrt hu hf ho l hl\n    have ho' : OptP (s3.P[r]?) (fun pl => pl.owner.isPlace = true) False := by\n      cases hpl' : s3'.P[r]? with\n      | none => rw [hpl'] at ho; exact ho.elim\n      | some pl' =>\n        rw [hpl'] at ho\n        obtain ⟨pl, hpl, -, hplc⟩ := hfr' r pl' hpl'\n        rw [hpl]; exact hplc ho\n    exact (hR.leaked r hr hrt hu hf ho' l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h\n\n/-- R6 for `transfer` (MM-03.3 §9.2, O4; L6: for each pair of corresponding leaves, a `ReadStep` of\nthe source range then a `WriteStep` of the destination range with the bytes read, provenance\nincluded; held authorities and owned storage give no step): under `WF3`, `SameSizeAlong` (spec 4),\n`dec` along the run and `stat` (K5), every read and write has the outcome `ok` and the arrival\nstates are in `Repr`. The source ranges stay initialised in MM-02; MM-03 makes them unreadable\n(`Moved`). -/\ntheorem r6_transfer {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3}\n    {s2 : MM02.State} {src dst : Nat} (hwf : WF3 s3) (hR : Repr tok ptok provOf L s3 s2)\n    (h : TransferStep k src dst s3 (.ok s3')) (hstatR : ∀ s ac, ObR.stat s ac)\n    (hstatW : ∀ s ac w, ObW.stat s ac w)\n    (hdec : DecAlong ObR ObW s2 (transferOps s2 L s3.P src dst)) :\n    AllOk C ObR ObW s2 (transferOps s2 L s3.P src dst) ∧\n      Repr tok ptok provOf L s3' (exec s2 (transferOps s2 L s3.P src dst)) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  have hsu := hpre.1\n  have hinit := hpre.2.1\n  have hdu := hpre.2.2.1\n  have hdu' := hpre.2.2.2.2.2.2.2.1\n  have hsh := hpre.2.2.2.2.2.2.2.2.2.2.2.2.2.2\n  have hdl : dst < s3.P.length := hdu.lt\n  have hrun := copyOps_run (C := C) (L := L) (s2 := s2) hstatR hstatW (transferPairs s3.P src dst)\n    s2 (Dom.refl _) (fun l l' hm => by\n      obtain ⟨hl, hc⟩ := mem_transferPairs.1 hm\n      obtain ⟨l'', hc', hl''⟩ := corr_leaf_fwd hwf hdl hsh hl\n      rw [hc] at hc'; cases hc'\n      obtain ⟨hlP, hlf, -⟩ := mem_footprint.1 hl\n      exact ⟨(live_of_usable_part hwf hR.toReprB hsu hl).and (hR.init l hlP hlf (hinit l hl)) |>.mono\n        fun _ ⟨⟨h1, h2⟩, h3⟩ => ⟨h1, h2, h3⟩, live_of_usable_part hwf hR.toReprB hdu hl''⟩) hdec\n  refine ⟨hrun.1, ReprB.transport hR.toReprB hrun.2.1 (by simp [transferEff]) ?_ ?_ rfl rfl\n    (fun q => ⟨transfer_usable_back hwf hsu, transfer_usable_fwd hwf hdu'⟩) ?_,\n    exec_wf _ _ hR.wf2⟩\n  · funext i; simp only [parentOf, transferEff, List.getElem?_map]\n    cases s3.P[i]? with\n    | none => rfl\n    | some pl => simp only [Option.map_some, Option.bind_some]; split <;> rfl\n  · intro q pl' hq\n    simp only [transferEff, List.getElem?_map] at hq\n    cases hp : s3.P[q]? with\n    | none => rw [hp] at hq; cases hq\n    | some pl =>\n      rw [hp] at hq; simp only [Option.map_some, Option.some.injEq] at hq\n      refine ⟨pl, rfl, ?_⟩\n      split at hq\n      · rename_i hh\n        subst hq\n        right\n        cases ho : pl.owner with\n        | frame _ => rw [ho] at hh; exact hh.elim\n        | place r => exact ⟨by simp [mvTo], rfl⟩\n      · subst hq; exact .inl rfl\n  · intro l _ _ hi\n    simp only [transferEff] at hi\n    split at hi\n    · rename_i hld\n      obtain ⟨m, hm, hc⟩ := corr_leaf_back hsh hld\n      exact .inr (hrun.2.2 m l (mem_transferPairs.2 ⟨hm, hc⟩))\n    · split at hi\n      · cases hi\n      · exact .inl hi\n\n/-- L6: parametric encoding of pointers into bytes (spec 11): `enc addr prov i` is the `i`-th byte\nof a pointer to the address `addr` with provenance `prov`; `decode` reads an address back. -/\nstructure PtrEnc where\n  enc : Nat → Option Nat → Nat → UInt8 × Option Nat\n  decode : (Nat → UInt8 × Option Nat) → Nat\n\n/-- L6, obligation of the encoding: `decode (enc addr prov)` is `addr`, and every byte carries the\nprovenance `prov`. -/\ndef PtrEncOK (pe : PtrEnc) : Prop :=\n  ∀ addr prov, pe.decode (pe.enc addr prov) = addr ∧ ∀ i, (pe.enc addr prov i).2 = prov\n\n/-- L6: address of the first byte of the region `rg`: base of the allocation of its first leaf plus\nthe offset of that leaf. -/\ndef regionAddr (s2 : MM02.State) (L : Layout) (rg : List Nat) : Nat :=\n  match rg.head? with\n  | some l => (((s2.allocs (L l).alloc).map (·.base)).getD 0) + (L l).off\n  | none => 0\n\n/-- L6: provenance of the region `rg`: the allocation of its first leaf (none for an empty\nregion). -/\ndef regionProv (L : Layout) (rg : List Nat) : Option Nat := rg.head?.map fun l => (L l).alloc\n\n/-- L6, `ptrBytes`: the bytes of a pointer to the region `rg`. -/\ndef ptrBytes (pe : PtrEnc) (s2 : MM02.State) (L : Layout) (rg : List Nat) :\n    Nat → UInt8 × Option Nat :=\n  pe.enc (regionAddr s2 L rg) (regionProv L rg)\n\n/-- L6 (`store a p`): one write of the range of the leaf `p` with the bytes of a pointer to the\nregion covered by `a`. -/\ndef storeOps (pe : PtrEnc) (s2 : MM02.State) (L : Layout) (s3 : S3) (a p : Nat) : List Op2 :=\n  [.write (leafAcc s2 L .write p) (ptrBytes pe s2 L (s3.afp a))]\n\n/-- L6 (`issue`): one write of the range of the destination with the bytes of a pointer to the\nblock; `available` and `issued` are abstract state of the arena entry (library obligation). -/\ndef issueOps (pe : PtrEnc) (s2 : MM02.State) (L : Layout) (region : List Nat) (dst : Nat) :\n    List Op2 :=\n  [.write (leafAcc s2 L .write dst) (ptrBytes pe s2 L region)]\n\n/-- L6: the pointer to a region whose first leaf `l` is covered by an active authority is neither\nlost nor fabricated: its provenance is the allocation of `l`, which is live, and its address is\nthe address of `l`, within that allocation. -/\ntheorem ptr_target {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 : S3}\n    {s2 : MM02.State} (hwf : WF3 s3) (hnd : NoDangling s3) (hfl : FpLeaves s3)\n    (hR : ReprB tok ptok provOf L s3 s2) {a : Nat} {y : Authority} (hy : s3.A[a]? = some y)\n    (ya : y.active = true) {rg : List Nat} (hrg : ∀ l ∈ rg, l ∈ y.footprint) {l : Nat}\n    (hl : rg.head? = some l) :\n    regionProv L rg = some (L l).alloc ∧ ∃ al, s2.allocs (L l).alloc = some al ∧ al.live = true ∧\n      regionAddr s2 L rg = al.base + (L l).off ∧ (L l).off + (L l).len ≤ al.size := by\n  have hlr : l ∈ rg := List.mem_of_getElem? (by rw [List.head?_eq_getElem?] at hl; exact hl)\n  obtain ⟨hlP, hlf, hlive⟩ := covered_live hwf hnd hfl hR hy ya (hrg l hlr)\n  obtain ⟨al, hal, hla, hsz⟩ := hlive.and (hR.lwf.within l hlP hlf)\n  refine ⟨by simp [regionProv, hl], al, hal, hla, ?_, hsz⟩\n  simp [regionAddr, hl, hal]\n\n/-- R6 for `store a p` (MM-03.3 §9.2, O8; L6: `WriteStep` of the range of `p` with `ptrBytes` of the\nregion of `a`): under `WF3`, `dec` and `stat` (K5), the write has the outcome `ok`, the arrival\nstates are in `Repr`, and the range of `p` holds the bytes of the pointer. -/\ntheorem r6_store {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3}\n    {s2 : MM02.State} {pe : PtrEnc} {a p : Nat} (hwf : WF3 s3) (hR : Repr tok ptok provOf L s3 s2)\n    (h : StoreStep a p s3 (.ok s3')) (hstatW : ∀ s ac w, ObW.stat s ac w)\n    (hdec : ObW.dec s2 (leafAcc s2 L .write p) (ptrBytes pe s2 L (s3.afp a))) :\n    AllOk C ObR ObW s2 (storeOps pe s2 L s3 a p) ∧\n      Repr tok ptok provOf L s3' (exec s2 (storeOps pe s2 L s3 a p)) ∧\n      rangeBytes (exec s2 (storeOps pe s2 L s3 a p)) L p = some ((List.range (L p).len).map\n        fun i => .init (ptrBytes pe s2 L (s3.afp a) i).1 (ptrBytes pe s2 L (s3.afp a) i).2) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  obtain ⟨y, hy, -⟩ := store_pre_auth hpre.1\n  have hpu : s3.Usable p := hpre.2.1\n  have hpleaf : isLeaf s3.P p := by\n    have := hpre; unfold StorePre at this; exact this.2.2.2.2.2.1\n  have hpf : p ∈ footprint s3.P p := mem_footprint.2 ⟨hpu.lt, hpleaf, hpu.lt, .inl rfl⟩\n  have hlive := live_of_usable_part hwf hR.toReprB hpu hpf\n  have hex : AllocP s2 (L p).alloc fun _ => True := hlive.mono fun _ _ => trivial\n  refine ⟨⟨write_leaf_ok hstatW hlive hdec, trivial⟩, ⟨?_, exec_wf _ _ hR.wf2⟩,\n    rangeBytes_write (Dom.refl _) hex⟩\n  refine hR.toReprB.change (Dom.write _ _ _) (by rw [storeEff_eq hy]) (by rw [storeEff_eq hy])\n    (by rw [storeEff_eq hy]) (by rw [storeEff_eq hy]) fun l _ _ hi => ?_\n  rw [storeEff_eq hy] at hi; simp only at hi\n  split at hi\n  · rename_i e; subst e; exact .inr (write_leaf_init hex)\n  · exact .inl hi\n\n/-- R6 for `issue` (MM-03.3 §9.2, O18; L6: `WriteStep` of the range of the destination with\n`ptrBytes` of the block; `available` and `issued` are abstract state of the arena entry): under\n`WF3`, `dec` and `stat` (K5), the write has the outcome `ok`, the arrival states are in `Repr`, and\nthe range of the destination holds the bytes of the pointer. -/\ntheorem r6_issue {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3}\n    {s2 : MM02.State} {pe : PtrEnc} {i via dst : Nat} {region : List Nat} (hwf : WF3 s3)\n    (hR : Repr tok ptok provOf L s3 s2) (h : IssueAt k i via region dst s3 (.ok s3'))\n    (hstatW : ∀ s ac w, ObW.stat s ac w)\n    (hdec : ObW.dec s2 (leafAcc s2 L .write dst) (ptrBytes pe s2 L region)) :\n    AllOk C ObR ObW s2 (issueOps pe s2 L region dst) ∧\n      Repr tok ptok provOf L s3' (exec s2 (issueOps pe s2 L region dst)) ∧\n      rangeBytes (exec s2 (issueOps pe s2 L region dst)) L dst = some ((List.range (L dst).len).map\n        fun i => .init (ptrBytes pe s2 L region i).1 (ptrBytes pe s2 L region i).2) := by\n  cases h with\n  | ok har hst =>\n    cases hst with\n    | ok hstat _ _ _ =>\n      have hdu : s3.Usable dst := hstat.2.2.2.1\n      have hdleaf : isLeaf s3.P dst := hstat.2.2.2.2.2.2.1\n      have hdf : dst ∈ footprint s3.P dst := mem_footprint.2 ⟨hdu.lt, hdleaf, hdu.lt, .inl rfl⟩\n      have hlive := live_of_usable_part hwf hR.toReprB hdu hdf\n      have hex : AllocP s2 (L dst).alloc fun _ => True := hlive.mono fun _ _ => trivial\n      refine ⟨⟨write_leaf_ok hstatW hlive hdec, trivial⟩, ⟨?_, exec_wf _ _ hR.wf2⟩,\n        rangeBytes_write (Dom.refl _) hex⟩\n      refine hR.toReprB.change (Dom.write _ _ _) rfl rfl rfl rfl fun l _ _ hi => ?_\n      simp only [arenaSet, issueEff, S3.addAuth] at hi\n      split at hi\n      · rename_i e; subst e; exact .inr (write_leaf_init hex)\n      · exact .inl hi\n\n/-! ## R4 (MM-03.3 §9.2) -/","originalFile":null,"structuredPatch":[{"oldStart":2012,"oldLines":6,"newStart":2012,"newLines":391,"lines":["       Repr tok ptok provOf L s3' (exec s2 (exitOps L tok s3)) :=","   r6_exit (reachable_invariants hdd hr).1 (reachable_fpLeaves_frameOwnedLive hdd hr).2 hR htc h"," ","+/-! ## Copies and pointers (L6: `transfer`, `store`, `issue`) -/","+","+/-- The bytes of the range of the leaf `l` in `s2`, if its allocation is registered. -/","+def rangeBytes (s2 : MM02.State) (L : Layout) (l : Nat) : Option (List MM02.AByte) :=","+  (s2.allocs (L l).alloc).map fun a => a.bytesAt (L l).off (L l).len","+","+/-- L6: the bytes of the range of the leaf `l` in `s2` as the argument of a write, value and","+provenance of each initialised byte (\"avec les octets lus, provenance comprise\"). -/","+def bytesOf (s2 : MM02.State) (L : Layout) (l : Nat) : Nat → UInt8 × Option Nat := fun i =>","+  match (s2.allocs (L l).alloc).map fun a => a.bytes ((L l).off + i) with","+  | some (.init v p) => (v, p)","+  | _ => (0, none)","+","+/-- L6: the pairs of corresponding leaves of `transfer src dst` (`corr`, the ordered isomorphism","+of O4.2), in the order of the leaves of the source. -/","+def transferPairs (P : List Place) (src dst : Nat) : List (Nat × Nat) :=","+  (footprint P src).filterMap fun l => (corr P src dst l).map fun l' => (l, l')","+","+/-- L6 (`transfer`): for each pair `(l, l')`, a read of the range of `l` (`ReadStep`), then a write","+of the range of `l'` (`WriteStep`) with the bytes of the range of `l`. Held authorities and owned","+storage give no step. -/","+def copyOps (s2 : MM02.State) (L : Layout) : List (Nat × Nat) → List Op2","+  | [] => []","+  | (l, l') :: ps => .read (leafAcc s2 L .read l) :: .write (leafAcc s2 L .write l') (bytesOf s2 L l) ::","+      copyOps s2 L ps","+","+/-- L6 (`transfer src dst`): the copy of the corresponding leaves. -/","+def transferOps (s2 : MM02.State) (L : Layout) (P : List Place) (src dst : Nat) : List Op2 :=","+  copyOps s2 L (transferPairs P src dst)","+","+/-- L6, hypothesis `SameSizeAlong` (types, spec 4): two corresponding leaves have the same size. -/","+def SameSizeAlong (L : Layout) (P : List Place) (src dst : Nat) : Prop :=","+  ∀ l l', (l, l') ∈ transferPairs P src dst → (L l).len = (L l').len","+","+theorem mem_transferPairs {P : List Place} {src dst l l' : Nat} :","+    (l, l') ∈ transferPairs P src dst ↔ l ∈ footprint P src ∧ corr P src dst l = some l' := by","+  simp only [transferPairs, List.mem_filterMap]","+  constructor","+  · rintro ⟨x, hx, e⟩","+    cases hc : corr P src dst x with","+    | none => rw [hc] at e; cases e","+    | some y => rw [hc] at e; cases e; exact ⟨hx, hc⟩","+  · rintro ⟨h, e⟩; exact ⟨l, h, by rw [e]; rfl⟩","+","+/-- L6: after the write of the range of a leaf in a state that keeps the allocations of `s2`, the","+range holds the bytes written, all initialised. -/","+theorem rangeBytes_write {s2 t : MM02.State} (hd : Dom s2 t) {L : Layout} {l : Nat}","+    {w : Nat → UInt8 × Option Nat} (h : AllocP s2 (L l).alloc fun _ => True) :","+    rangeBytes (t.write (leafAcc s2 L .write l) w) L l =","+      some ((List.range (L l).len).map fun i => .init (w i).1 (w i).2) := by","+  obtain ⟨a, ha, -⟩ := h","+  obtain ⟨b, hb, -, e, -⟩ := hd _ a ha","+  have hacc : leafAcc s2 L .write l = leafAcc t L .write l := by rw [leafAcc_of ha, leafAcc_of hb, e]","+  rw [hacc, rangeBytes, write_allocs, leafAcc_of hb]","+  simp only [↓reduceIte, hb, Option.map_some, Nat.add_sub_cancel_left, Option.some.injEq,","+    MM02.Alloc.bytesAt, MM02.Alloc.write, List.map_inj_left, List.mem_range]","+  intro i hi","+  have hr : (L l).off ≤ (L l).off + i ∧ (L l).off + i < (L l).off + (L l).len :=","+    ⟨Nat.le_add_right _ _, by omega⟩","+  simp only [hr, and_self, ↓reduceIte, Nat.add_sub_cancel_left]","+","+/-- L6: the run of the copies of a transfer, from a state `t` that keeps the allocations of the","+state `s2` where the sequence was computed: every read and write has the outcome `ok` when the","+source ranges are live and initialised and the destination ranges live, under `dec` along the run","+and `stat` (K5); the run keeps the allocations; every destination range ends initialised. -/","+theorem copyOps_run {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {s2 : MM02.State} {L : Layout} (hstatR : ∀ s ac, ObR.stat s ac)","+    (hstatW : ∀ s ac w, ObW.stat s ac w) :","+    ∀ (ps : List (Nat × Nat)) (t : MM02.State), Dom s2 t →","+      (∀ l l', (l, l') ∈ ps →","+        (AllocP s2 (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size ∧","+          a.InitRange (L l).off (L l).len) ∧","+        AllocP s2 (L l').alloc fun a => a.live = true ∧ (L l').off + (L l').len ≤ a.size) →","+      DecAlong ObR ObW t (copyOps s2 L ps) →","+      AllOk C ObR ObW t (copyOps s2 L ps) ∧ Dom t (exec t (copyOps s2 L ps)) ∧","+        ∀ l l', (l, l') ∈ ps →","+          AllocP (exec t (copyOps s2 L ps)) (L l').alloc fun a => a.InitRange (L l').off (L l').len","+  | [], t, _, _, _ => ⟨trivial, Dom.refl _, fun _ _ h => by cases h⟩","+  | (l, l') :: ps, t, hd, hps, hdec => by","+    obtain ⟨hsrc, hdst⟩ := hps l l' (List.mem_cons_self ..)","+    -- the source and destination in `t`","+    have hsrc' : AllocP t (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size ∧","+        a.InitRange (L l).off (L l).len :=","+      hsrc.of_dom hd fun a a' _ e2 e3 _ hb ⟨h1, h2, h3⟩ =>","+        ⟨e3 ▸ h1, e2 ▸ h2, fun i hi => hb _ (h3 i hi)⟩","+    have hdst' : AllocP t (L l').alloc fun a => a.live = true ∧ (L l').off + (L l').len ≤ a.size :=","+      hdst.of_dom hd fun a a' _ e2 e3 _ _ ⟨h1, h2⟩ => ⟨e3 ▸ h1, e2 ▸ h2⟩","+    have eR : leafAcc s2 L .read l = leafAcc t L .read l :=","+      (leafAcc_dom hd (hsrc.mono fun _ _ => trivial)).symm","+    have eW : leafAcc s2 L .write l' = leafAcc t L .write l' :=","+      (leafAcc_dom hd (hdst.mono fun _ _ => trivial)).symm","+    obtain ⟨hdecR, hdecW, hdec⟩ := hdec","+    -- the read","+    obtain ⟨a, ha, hla, hsz, hin⟩ := hsrc'","+    have hread : MM02.Read t (leafAcc s2 L .read l) := by","+      rw [eR, leafAcc_of ha]","+      have e : a.base + (L l).off - a.base = (L l).off := Nat.add_sub_cancel_left _ _","+      exact ⟨a, ha, hla, ⟨Nat.le_add_right _ _, by simp only; omega⟩, by simp only [e]; exact hin,","+        .inl rfl⟩","+    have hok := MM02.ReadStep.ok (ObR := ObR) (by rw [eR, leafAcc_of ha]; exact ha)","+      ⟨hread, hdecR, hstatR _ _⟩","+    -- the write","+    have hw := write_leaf_ok (ObW := ObW) (w := bytesOf s2 L l) hstatW hdst' (by rw [← eW]; exact hdecW)","+    rw [← eW] at hw","+    have hd₁ : Dom t (t.write (leafAcc s2 L .write l') (bytesOf s2 L l)) := Dom.write _ _ _","+    have ih := copyOps_run hstatR hstatW ps _ (hd.trans hd₁)","+      (fun m m' hm => hps m m' (List.mem_cons_of_mem _ hm)) hdec","+    refine ⟨⟨⟨_, hok⟩, hw, ih.1⟩, hd₁.trans ih.2.1, fun m m' hm => ?_⟩","+    rcases List.mem_cons.1 hm with e | hm","+    · cases e","+      have := rangeBytes_write (w := bytesOf s2 L l) (hd.trans (Dom.refl _))","+        (L := L) (l := l') (hdst.mono fun _ _ => trivial)","+      obtain ⟨b, hb, -⟩ := hdst'","+      have hinit : AllocP (t.write (leafAcc s2 L .write l') (bytesOf s2 L l)) (L l').alloc","+          fun a => a.InitRange (L l').off (L l').len := by","+        rw [eW]; exact write_leaf_init ⟨b, hb, trivial⟩","+      exact hinit.of_dom ih.2.1 fun _ _ _ _ _ _ hb h i hi => hb _ (h i hi)","+    · exact ih.2.2 m m' hm","+","+/-- A leaf of a usable place has its allocation live and its range within it (K1 (c), K3). -/","+theorem live_of_usable_part {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout}","+    {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3) (hR : ReprB tok ptok provOf L s3 s2) {q l : Nat}","+    (hu : s3.Usable q) (hl : l ∈ footprint s3.P q) :","+    AllocP s2 (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size := by","+  obtain ⟨hlP, hlf, hlq⟩ := mem_footprint.1 hl","+  have hul : s3.Usable l := usable_of_partOf hwf (l + 1) l q (Nat.lt_succ_self l) hlq hu","+  obtain ⟨r, hr, hlr⟩ := exists_rootPlace hwf (l + 1) l (Nat.lt_succ_self l) hlP","+  exact (hR.live r hr.1 hr (usable_of_part hwf hlr hul) l (mem_footprint.2 ⟨hlP, hlf, hlr⟩)).and","+    (hR.lwf.within l hlP hlf)","+","+/-- `ReprB` carries over when the places keep their parents and only change owners between places,","+the MM-02 state keeps its allocations, usability, stack and `freed` marks are unchanged, and every","+leaf that becomes `Init` has its range initialised (L6: `transfer` moves the owners of the owned","+storage, A5). -/","+theorem ReprB.transport {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout}","+    {s3 s3' : S3} {s2 s2' : MM02.State} (hR : ReprB tok ptok provOf L s3 s2) (hd : Dom s2 s2')","+    (hlen : s3'.P.length = s3.P.length) (hpar : parentOf s3'.P = parentOf s3.P)","+    (hown : ∀ (q : Nat) (pl' : Place), s3'.P[q]? = some pl' → ∃ pl : Place, s3.P[q]? = some pl ∧","+      (pl'.owner = pl.owner ∨ (pl'.owner.isPlace = true ∧ pl.owner.isPlace = true)))","+    (hF : s3'.F = s3.F) (hfr : s3'.freed = s3.freed) (hU : ∀ q, s3'.Usable q ↔ s3.Usable q)","+    (hI : ∀ l < s3.P.length, isLeaf s3.P l → s3'.I l = .init →","+      s3.I l = .init ∨ AllocP s2' (L l).alloc fun a => a.InitRange (L l).off (L l).len) :","+    ReprB tok ptok provOf L s3' s2' := by","+  have hfp : ∀ q, footprint s3'.P q = footprint s3.P q := footprint_congr hlen hpar","+  have hleaf : ∀ l, isLeaf s3'.P l ↔ isLeaf s3.P l := fun l => by simp only [isLeaf, hlen, hpar]","+  have hroot : ∀ r, RootPlace s3'.P r ↔ RootPlace s3.P r := fun r => by","+    simp only [RootPlace, hlen, hpar]","+  -- the owner of a root, read in `s3'`","+  have hfr' : ∀ r (pl' : Place), s3'.P[r]? = some pl' → ∃ pl : Place, s3.P[r]? = some pl ∧","+      (∀ f, pl'.owner = .frame f → pl.owner = .frame f) ∧","+      (pl'.owner.isPlace = true → pl.owner.isPlace = true) := fun r pl' h => by","+    obtain ⟨pl, hpl, e⟩ := hown r pl' h","+    refine ⟨pl, hpl, fun f hf => ?_, fun hp => ?_⟩","+    · rcases e with e | ⟨h1, -⟩","+      · rw [← e, hf]","+      · rw [hf] at h1; cases h1","+    · rcases e with e | ⟨-, h2⟩","+      · rw [← e]; exact hp","+      · exact h2","+  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>","+    simp only [hlen, hfp, hleaf, hroot, hF, hfr, hU]","+  · exact hR.lwf.sameAlloc","+  · exact hR.lwf.disjoint","+  · exact fun l hl hlf => (hR.lwf.within l hl hlf).of_dom hd fun a a' _ e _ _ _ h => e ▸ h","+  · exact hR.inj","+  · intro r hr hrt","+    cases hpl' : s3'.P[r]? with","+    | none => trivial","+    | some pl' =>","+      obtain ⟨pl, hpl, hfrm, -⟩ := hfr' r pl' hpl'","+      have := hR.tokens r hr hrt","+      rw [hpl] at this","+      show OptP (tokOf tok pl'.owner) _ True","+      cases ho' : pl'.owner with","+      | place _ => trivial","+      | frame f =>","+        have e := hfrm f ho'","+        simp only [OptP, e, tokOf] at this","+        exact fun l hl => (this l hl).of_dom hd fun _ _ _ _ _ e _ h => e ▸ h","+  · exact fun r hr hrt => OptP.imp (hR.provTokens r hr hrt) (fun _ h l hl =>","+      (h l hl).of_dom hd fun _ _ _ _ _ e _ h => e ▸ h) id","+  · exact fun r hr hrt hu l hl => (hR.live r hr hrt hu l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h","+  · intro l hl hlf hi","+    rcases hI l hl hlf hi with h | h","+    · exact (hR.init l hl hlf h).of_dom hd fun a a' _ _ _ _ hb h i hi => hb _ (h i hi)","+    · exact h","+  · exact fun r hr hrt hf l hl => (hR.freed r hr hrt hf l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h","+  · intro r hr hrt hg l hl","+    have hg' : OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False := by","+      cases hpl' : s3'.P[r]? with","+      | none => rw [hpl'] at hg; exact hg.elim","+      | some pl' =>","+        rw [hpl'] at hg","+        obtain ⟨pl, hpl, hfrm, -⟩ := hfr' r pl' hpl'","+        rw [hpl]","+        show FrameGone s3.F pl.owner","+        cases ho' : pl'.owner with","+        | place _ => rw [ho'] at hg; exact hg.elim","+        | frame f => rw [ho'] at hg; rw [hfrm f ho']; exact hg","+    exact (hR.exited r hr hrt hg' l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h","+  · intro r hr hrt hu hf ho l hl","+    have ho' : OptP (s3.P[r]?) (fun pl => pl.owner.isPlace = true) False := by","+      cases hpl' : s3'.P[r]? with","+      | none => rw [hpl'] at ho; exact ho.elim","+      | some pl' =>","+        rw [hpl'] at ho","+        obtain ⟨pl, hpl, -, hplc⟩ := hfr' r pl' hpl'","+        rw [hpl]; exact hplc ho","+    exact (hR.leaked r hr hrt hu hf ho' l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h","+","+/-- R6 for `transfer` (MM-03.3 §9.2, O4; L6: for each pair of corresponding leaves, a `ReadStep` of","+the source range then a `WriteStep` of the destination range with the bytes read, provenance","+included; held authorities and owned storage give no step): under `WF3`, `SameSizeAlong` (spec 4),","+`dec` along the run and `stat` (K5), every read and write has the outcome `ok` and the arrival","+states are in `Repr`. The source ranges stay initialised in MM-02; MM-03 makes them unreadable","+(`Moved`). -/","+theorem r6_transfer {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3}","+    {s2 : MM02.State} {src dst : Nat} (hwf : WF3 s3) (hR : Repr tok ptok provOf L s3 s2)","+    (h : TransferStep k src dst s3 (.ok s3')) (hstatR : ∀ s ac, ObR.stat s ac)","+    (hstatW : ∀ s ac w, ObW.stat s ac w)","+    (hdec : DecAlong ObR ObW s2 (transferOps s2 L s3.P src dst)) :","+    AllOk C ObR ObW s2 (transferOps s2 L s3.P src dst) ∧","+      Repr tok ptok provOf L s3' (exec s2 (transferOps s2 L s3.P src dst)) := by","+  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+  have hsu := hpre.1","+  have hinit := hpre.2.1","+  have hdu := hpre.2.2.1","+  have hdu' := hpre.2.2.2.2.2.2.2.1","+  have hsh := hpre.2.2.2.2.2.2.2.2.2.2.2.2.2.2","+  have hdl : dst < s3.P.length := hdu.lt","+  have hrun := copyOps_run (C := C) (L := L) (s2 := s2) hstatR hstatW (transferPairs s3.P src dst)","+    s2 (Dom.refl _) (fun l l' hm => by","+      obtain ⟨hl, hc⟩ := mem_transferPairs.1 hm","+      obtain ⟨l'', hc', hl''⟩ := corr_leaf_fwd hwf hdl hsh hl","+      rw [hc] at hc'; cases hc'","+      obtain ⟨hlP, hlf, -⟩ := mem_footprint.1 hl","+      exact ⟨(live_of_usable_part hwf hR.toReprB hsu hl).and (hR.init l hlP hlf (hinit l hl)) |>.mono","+        fun _ ⟨⟨h1, h2⟩, h3⟩ => ⟨h1, h2, h3⟩, live_of_usable_part hwf hR.toReprB hdu hl''⟩) hdec","+  refine ⟨hrun.1, ReprB.transport hR.toReprB hrun.2.1 (by simp [transferEff]) ?_ ?_ rfl rfl","+    (fun q => ⟨transfer_usable_back hwf hsu, transfer_usable_fwd hwf hdu'⟩) ?_,","+    exec_wf _ _ hR.wf2⟩","+  · funext i; simp only [parentOf, transferEff, List.getElem?_map]","+    cases s3.P[i]? with","+    | none => rfl","+    | some pl => simp only [Option.map_some, Option.bind_some]; split <;> rfl","+  · intro q pl' hq","+    simp only [transferEff, List.getElem?_map] at hq","+    cases hp : s3.P[q]? with","+    | none => rw [hp] at hq; cases hq","+    | some pl =>","+      rw [hp] at hq; simp only [Option.map_some, Option.some.injEq] at hq","+      refine ⟨pl, rfl, ?_⟩","+      split at hq","+      · rename_i hh","+        subst hq","+        right","+        cases ho : pl.owner with","+        | frame _ => rw [ho] at hh; exact hh.elim","+        | place r => exact ⟨by simp [mvTo], rfl⟩","+      · subst hq; exact .inl rfl","+  · intro l _ _ hi","+    simp only [transferEff] at hi","+    split at hi","+    · rename_i hld","+      obtain ⟨m, hm, hc⟩ := corr_leaf_back hsh hld","+      exact .inr (hrun.2.2 m l (mem_transferPairs.2 ⟨hm, hc⟩))","+    · split at hi","+      · cases hi","+      · exact .inl hi","+","+/-- L6: parametric encoding of pointers into bytes (spec 11): `enc addr prov i` is the `i`-th byte","+of a pointer to the address `addr` with provenance `prov`; `decode` reads an address back. -/","+structure PtrEnc where","+  enc : Nat → Option Nat → Nat → UInt8 × Option Nat","+  decode : (Nat → UInt8 × Option Nat) → Nat","+","+/-- L6, obligation of the encoding: `decode (enc addr prov)` is `addr`, and every byte carries the","+provenance `prov`. -/","+def PtrEncOK (pe : PtrEnc) : Prop :=","+  ∀ addr prov, pe.decode (pe.enc addr prov) = addr ∧ ∀ i, (pe.enc addr prov i).2 = prov","+","+/-- L6: address of the first byte of the region `rg`: base of the allocation of its first leaf plus","+the offset of that leaf. -/","+def regionAddr (s2 : MM02.State) (L : Layout) (rg : List Nat) : Nat :=","+  match rg.head? with","+  | some l => (((s2.allocs (L l).alloc).map (·.base)).getD 0) + (L l).off","+  | none => 0","+","+/-- L6: provenance of the region `rg`: the allocation of its first leaf (none for an empty","+region). -/","+def regionProv (L : Layout) (rg : List Nat) : Option Nat := rg.head?.map fun l => (L l).alloc","+","+/-- L6, `ptrBytes`: the bytes of a pointer to the region `rg`. -/","+def ptrBytes (pe : PtrEnc) (s2 : MM02.State) (L : Layout) (rg : List Nat) :","+    Nat → UInt8 × Option Nat :=","+  pe.enc (regionAddr s2 L rg) (regionProv L rg)","+","+/-- L6 (`store a p`): one write of the range of the leaf `p` with the bytes of a pointer to the","+region covered by `a`. -/","+def storeOps (pe : PtrEnc) (s2 : MM02.State) (L : Layout) (s3 : S3) (a p : Nat) : List Op2 :=","+  [.write (leafAcc s2 L .write p) (ptrBytes pe s2 L (s3.afp a))]","+","+/-- L6 (`issue`): one write of the range of the destination with the bytes of a pointer to the","+block; `available` and `issued` are abstract state of the arena entry (library obligation). -/","+def issueOps (pe : PtrEnc) (s2 : MM02.State) (L : Layout) (region : List Nat) (dst : Nat) :","+    List Op2 :=","+  [.write (leafAcc s2 L .write dst) (ptrBytes pe s2 L region)]","+","+/-- L6: the pointer to a region whose first leaf `l` is covered by an active authority is neither","+lost nor fabricated: its provenance is the allocation of `l`, which is live, and its address is","+the address of `l`, within that allocation. -/","+theorem ptr_target {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 : S3}","+    {s2 : MM02.State} (hwf : WF3 s3) (hnd : NoDangling s3) (hfl : FpLeaves s3)","+    (hR : ReprB tok ptok provOf L s3 s2) {a : Nat} {y : Authority} (hy : s3.A[a]? = some y)","+    (ya : y.active = true) {rg : List Nat} (hrg : ∀ l ∈ rg, l ∈ y.footprint) {l : Nat}","+    (hl : rg.head? = some l) :","+    regionProv L rg = some (L l).alloc ∧ ∃ al, s2.allocs (L l).alloc = some al ∧ al.live = true ∧","+      regionAddr s2 L rg = al.base + (L l).off ∧ (L l).off + (L l).len ≤ al.size := by","+  have hlr : l ∈ rg := List.mem_of_getElem? (by rw [List.head?_eq_getElem?] at hl; exact hl)","+  obtain ⟨hlP, hlf, hlive⟩ := covered_live hwf hnd hfl hR hy ya (hrg l hlr)","+  obtain ⟨al, hal, hla, hsz⟩ := hlive.and (hR.lwf.within l hlP hlf)","+  refine ⟨by simp [regionProv, hl], al, hal, hla, ?_, hsz⟩","+  simp [regionAddr, hl, hal]","+","+/-- R6 for `store a p` (MM-03.3 §9.2, O8; L6: `WriteStep` of the range of `p` with `ptrBytes` of the","+region of `a`): under `WF3`, `dec` and `stat` (K5), the write has the outcome `ok`, the arrival","+states are in `Repr`, and the range of `p` holds the bytes of the pointer. -/","+theorem r6_store {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3}","+    {s2 : MM02.State} {pe : PtrEnc} {a p : Nat} (hwf : WF3 s3) (hR : Repr tok ptok provOf L s3 s2)","+    (h : StoreStep a p s3 (.ok s3')) (hstatW : ∀ s ac w, ObW.stat s ac w)","+    (hdec : ObW.dec s2 (leafAcc s2 L .write p) (ptrBytes pe s2 L (s3.afp a))) :","+    AllOk C ObR ObW s2 (storeOps pe s2 L s3 a p) ∧","+      Repr tok ptok provOf L s3' (exec s2 (storeOps pe s2 L s3 a p)) ∧","+      rangeBytes (exec s2 (storeOps pe s2 L s3 a p)) L p = some ((List.range (L p).len).map","+        fun i => .init (ptrBytes pe s2 L (s3.afp a) i).1 (ptrBytes pe s2 L (s3.afp a) i).2) := by","+  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+  obtain ⟨y, hy, -⟩ := store_pre_auth hpre.1","+  have hpu : s3.Usable p := hpre.2.1","+  have hpleaf : isLeaf s3.P p := by","+    have := hpre; unfold StorePre at this; exact this.2.2.2.2.2.1","+  have hpf : p ∈ footprint s3.P p := mem_footprint.2 ⟨hpu.lt, hpleaf, hpu.lt, .inl rfl⟩","+  have hlive := live_of_usable_part hwf hR.toReprB hpu hpf","+  have hex : AllocP s2 (L p).alloc fun _ => True := hlive.mono fun _ _ => trivial","+  refine ⟨⟨write_leaf_ok hstatW hlive hdec, trivial⟩, ⟨?_, exec_wf _ _ hR.wf2⟩,","+    rangeBytes_write (Dom.refl _) hex⟩","+  refine hR.toReprB.change (Dom.write _ _ _) (by rw [storeEff_eq hy]) (by rw [storeEff_eq hy])","+    (by rw [storeEff_eq hy]) (by rw [storeEff_eq hy]) fun l _ _ hi => ?_","+  rw [storeEff_eq hy] at hi; simp only at hi","+  split at hi","+  · rename_i e; subst e; exact .inr (write_leaf_init hex)","+  · exact .inl hi","+","+/-- R6 for `issue` (MM-03.3 §9.2, O18; L6: `WriteStep` of the range of the destination with","+`ptrBytes` of the block; `available` and `issued` are abstract state of the arena entry): under","+`WF3`, `dec` and `stat` (K5), the write has the outcome `ok`, the arrival states are in `Repr`, and","+the range of the destination holds the bytes of the pointer. -/","+theorem r6_issue {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3}","+    {s2 : MM02.State} {pe : PtrEnc} {i via dst : Nat} {region : List Nat} (hwf : WF3 s3)","+    (hR : Repr tok ptok provOf L s3 s2) (h : IssueAt k i via region dst s3 (.ok s3'))","+    (hstatW : ∀ s ac w, ObW.stat s ac w)","+    (hdec : ObW.dec s2 (leafAcc s2 L .write dst) (ptrBytes pe s2 L region)) :","+    AllOk C ObR ObW s2 (issueOps pe s2 L region dst) ∧","+      Repr tok ptok provOf L s3' (exec s2 (issueOps pe s2 L region dst)) ∧","+      rangeBytes (exec s2 (issueOps pe s2 L region dst)) L dst = some ((List.range (L dst).len).map","+        fun i => .init (ptrBytes pe s2 L region i).1 (ptrBytes pe s2 L region i).2) := by","+  cases h with","+  | ok har hst =>","+    cases hst with","+    | ok hstat _ _ _ =>","+      have hdu : s3.Usable dst := hstat.2.2.2.1","+      have hdleaf : isLeaf s3.P dst := hstat.2.2.2.2.2.2.1","+      have hdf : dst ∈ footprint s3.P dst := mem_footprint.2 ⟨hdu.lt, hdleaf, hdu.lt, .inl rfl⟩","+      have hlive := live_of_usable_part hwf hR.toReprB hdu hdf","+      have hex : AllocP s2 (L dst).alloc fun _ => True := hlive.mono fun _ _ => trivial","+      refine ⟨⟨write_leaf_ok hstatW hlive hdec, trivial⟩, ⟨?_, exec_wf _ _ hR.wf2⟩,","+        rangeBytes_write (Dom.refl _) hex⟩","+      refine hR.toReprB.change (Dom.write _ _ _) rfl rfl rfl rfl fun l _ _ hi => ?_","+      simp only [arenaSet, issueEff, S3.addAuth] at hi","+      split at hi","+      · rename_i e; subst e; exact .inr (write_leaf_init hex)","+      · exact .inl hi","+"," /-! ## R4 (MM-03.3 §9.2) -/"," "," /-- R4 (MM-03.3 §9.2, from `NoDangling`, §2.6): on a reached state of MM-03 in `Repr` with an MM-02"]}],"userModified":false,"replaceAll":false,"staleRecovered":true,"contentNotInModelContext":true},"sourceToolAssistantUUID":"b15f7769-e227-41ef-9739-cb580b198acb","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"type":"last-prompt","lastPrompt":"# Tâche : jalon 2, passe 2 — raffinement MM-03 → MM-02 (transfer, store, issue, DDSound, épinglage, simulation)  ## Git Même branche `formal/refinement_0.1`, à la suite. Pas de merge, pas de PR. Tout…","leafUuid":"a92a94ff-4843-4c75-a75a-9e9988f55920","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180"}
