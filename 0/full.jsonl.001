{"parentUuid":"f5987745-25d7-4a1d-82e1-c3a469fc2d01","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014YDEp9nYaPu5pXMu7E4o9e","type":"tool_result","content":"The file /Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean has been updated successfully. (note: the file had been modified on disk since you last read it — the edit applied cleanly, but the file contains other changes not in your context. Read it before edits that depend on surrounding content.)"}]},"uuid":"35953f42-44c9-42c6-8291-36404a03093b","timestamp":"2026-10-31T19:31:49.606Z","toolUseResult":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","oldString":"/-! ## Smoke test -/","newString":"/-! ## Allocations (K2, K4: `enterFrame`, `alloc`, static storage) -/\n\nsection AllocOps\nvariable (pl : Placement) (g : Nat → Geom) (fa : Option Nat)\n\ntheorem allocOps_next : ∀ (roots : List Nat) (s : MM02.State),\n    (exec s (allocOps pl g fa s roots)).next = s.next + roots.length\n  | [], _ => rfl\n  | _ :: is, s => by\n    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).next = _\n    rw [allocOps_next is]; simp only [MM02.State.alloc, List.length_cons]; omega\n\ntheorem allocOps_old : ∀ (roots : List Nat) (s : MM02.State) (i : Nat), i < s.next →\n    (exec s (allocOps pl g fa s roots)).allocs i = s.allocs i\n  | [], _, _, _ => rfl\n  | _ :: is, s, i, hi => by\n    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).allocs i = _\n    rw [allocOps_old is _ i (by simp only [MM02.State.alloc]; omega)]\n    simp [MM02.State.alloc, Nat.ne_of_lt hi]\n\ntheorem allocOps_new : ∀ (roots : List Nat) (s : MM02.State) (j i : Nat), roots[j]? = some i →\n    ∃ b, (exec s (allocOps pl g fa s roots)).allocs (s.next + j) =\n      some ⟨(g i).space, b, (g i).size, (g i).align, true, fun _ => .uninit, fa⟩\n  | [], _, _, _, h => by simp at h\n  | k :: is, s, 0, i, h => by\n    simp only [List.getElem?_cons_zero, Option.some.injEq] at h; subst h\n    refine ⟨pl s (g k), ?_⟩\n    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).allocs _ = _\n    rw [allocOps_old is _ _ (by simp [MM02.State.alloc])]\n    simp [MM02.State.alloc]\n  | k :: is, s, j + 1, i, h => by\n    simp only [List.getElem?_cons_succ] at h\n    obtain ⟨b, hb⟩ := allocOps_new is (s.alloc (g k).space (pl s (g k)) (g k).size (g k).align fa)\n      j i h\n    refine ⟨b, ?_⟩\n    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).allocs _ = _\n    rw [show s.next + (j + 1) = (s.alloc (g k).space (pl s (g k)) (g k).size (g k).align fa).next + j\n      by simp only [MM02.State.alloc]; omega]\n    exact hb\n\ntheorem allocOps_wf : ∀ (roots : List Nat) (s : MM02.State), MM02.WF s →\n    MM02.WF (exec s (allocOps pl g fa s roots))\n  | [], _, h => h\n  | _ :: is, _, h => allocOps_wf is _ (MM02.alloc_wf h _ _ _ _ _)\n\n/-- K2, K4: the allocations of the roots have the outcome `ok` (MM-02.2, création brute) under the\nobligation of the placement and valid alignments. -/\ntheorem allocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {pl : Placement} {g : Nat → Geom} {fa : Option Nat} (hpl : PlacementOK pl) :\n    ∀ (roots : List Nat) (s : MM02.State), MM02.WF s →\n      (∀ i ∈ roots, 0 < (g i).align ∧ MM02.Pow2 (g i).align) →\n      AllOk C ObR ObW s (allocOps pl g fa s roots)\n  | [], _, _, _ => trivial\n  | i :: is, s, h, hg => by\n    obtain ⟨h0, h2⟩ := hg i (List.mem_cons_self ..)\n    exact ⟨.ok (hpl s (g i) h h0 h2),\n      allocOps_ok hpl is _ (MM02.alloc_wf h _ _ _ _ _) fun i hi => hg i (List.mem_cons_of_mem _ hi)⟩\n\nend AllocOps\n\ntheorem AllocP.of_eq {s s' : MM02.State} {i : Nat} {p : MM02.Alloc → Prop} (h : AllocP s i p)\n    (he : s'.allocs i = s.allocs i) : AllocP s' i p :=\n  let ⟨a, ha, hpa⟩ := h; ⟨a, he.trans ha, hpa⟩\n\n/-! ## Shapes appended to the places (C6 of MM-03) -/\n\nsection Shape\nvariable {P : List Place} {hd : Holder} {ls : List (Option Nat × Option Nat × Nat)}\n\ntheorem shape_isLeaf_old (hsh : ShapeOK P.length ls) {l : Nat} (hl : l < P.length) :\n    isLeaf (shapeP P hd ls) l ↔ isLeaf P l := by\n  constructor\n  · intro h r hr; rw [← shape_parentOf_lt hr]; exact h r (by rw [shapeP_len]; omega)\n  · intro h r hr e\n    by_cases hrn : r < P.length\n    · rw [shape_parentOf_lt hrn] at e; exact h r hrn e\n    · rw [shapeP_len] at hr\n      have hi : r - P.length < ls.length := by omega\n      have hp := shape_parentOf_new (P := P) (hd := hd) hi\n      rw [show P.length + (r - P.length) = r by omega, e] at hp\n      have := (hsh (r - P.length) (List.mem_range.2 hi)).1\n      rw [← hp] at this; simp only [OptP] at this; omega\n\ntheorem shape_rootPlace_old {r : Nat} (hr : r < P.length) :\n    RootPlace (shapeP P hd ls) r ↔ RootPlace P r := by\n  simp only [RootPlace, shape_parentOf_lt hr, shapeP_len]; omega\n\ntheorem shape_rootPlace_new {r : Nat} (h : RootPlace (shapeP P hd ls) r) (hr : P.length ≤ r) :\n    ∃ i, r = P.length + i ∧ i ∈ rootIdx ls := by\n  obtain ⟨hlt, hn⟩ := h\n  rw [shapeP_len] at hlt\n  have hi : r - P.length < ls.length := by omega\n  have hp := shape_parentOf_new (P := P) (hd := hd) hi\n  rw [show P.length + (r - P.length) = r by omega, hn] at hp\n  exact ⟨r - P.length, by omega, mem_rootIdx hi hp.symm⟩\n\n/-- Every new place is a part of a new root place (MM-03.3.2; C6). -/\ntheorem shape_part_root (hsh : ShapeOK P.length ls) : ∀ m l, l < m → P.length ≤ l →\n    l < (shapeP P hd ls).length → ∃ i ∈ rootIdx ls, partOf (shapeP P hd ls) l (P.length + i)\n  | 0, _, h, _, _ => absurd h (Nat.not_lt_zero _)\n  | m + 1, l, hlm, hge, hl => by\n    rw [shapeP_len] at hl\n    have hi : l - P.length < ls.length := by omega\n    have hp := shape_parentOf_new (P := P) (hd := hd) hi\n    rw [show P.length + (l - P.length) = l by omega] at hp\n    cases hb : (ls[l - P.length]?).bind (·.1) with\n    | none =>\n      refine ⟨l - P.length, mem_rootIdx hi hb, by rw [shapeP_len]; omega, .inl (by omega)⟩\n    | some p =>\n      have h1 := (hsh (l - P.length) (List.mem_range.2 hi)).1\n      rw [hb] at h1; simp only [OptP] at h1\n      rw [hb] at hp\n      obtain ⟨i, hi', hpi⟩ := shape_part_root hsh m p (by omega) (by omega) (by rw [shapeP_len]; omega)\n      refine ⟨i, hi', by rw [shapeP_len]; omega, .inr ?_⟩\n      rw [chain_cons hp (by omega)]\n      rcases hpi.2 with e | e\n      · rw [e]; exact List.mem_cons_self ..\n      · exact List.mem_cons_of_mem _ e\n\nend Shape\n\n/-- K1, K2: layout of the new roots `roots` of the places `P'` appended after `n` old places, in\nfresh allocations: the leaves of the `j`-th new root `n + i` are in the allocation `next + j`,\nwithin the size of `g i`; two distinct new leaves of one allocation have disjoint ranges. -/\nstructure NewLayout (L : Layout) (P' : List Place) (n next : Nat) (g : Nat → Geom)\n    (roots : List Nat) : Prop where\n  place : ∀ j < roots.length, OptP (roots[j]?) (fun i => ∀ l ∈ footprint P' (n + i),\n    (L l).alloc = next + j ∧ (L l).off + (L l).len ≤ (g i).size) True\n  disjoint : ∀ l < P'.length, ∀ l' < P'.length, n ≤ l → n ≤ l' → isLeaf P' l → isLeaf P' l' →\n    l ≠ l' → (L l).alloc = (L l').alloc →\n    MM02.RangeDisjoint (L l).off (L l).len (L l').off (L l').len\n\nset_option synthInstance.maxSize 512 in\ninstance (L : Layout) (P' : List Place) (n next : Nat) (g : Nat → Geom) (roots : List Nat) :\n    Decidable (NewLayout L P' n next g roots) :=\n  decidable_of_iff\n    ((∀ j < roots.length, OptP (roots[j]?) (fun i => ∀ l ∈ footprint P' (n + i),\n      (L l).alloc = next + j ∧ (L l).off + (L l).len ≤ (g i).size) True) ∧\n     (∀ l < P'.length, ∀ l' < P'.length, n ≤ l → n ≤ l' → isLeaf P' l → isLeaf P' l' →\n      l ≠ l' → (L l).alloc = (L l').alloc →\n      MM02.RangeDisjoint (L l).off (L l).len (L l').off (L l').len))\n    ⟨fun ⟨a, b⟩ => ⟨a, b⟩, fun ⟨a, b⟩ => ⟨a, b⟩⟩\n\ntheorem NewLayout.at {L : Layout} {P' : List Place} {n next : Nat} {g : Nat → Geom}\n    {roots : List Nat} (h : NewLayout L P' n next g roots) {j i : Nat} (hj : roots[j]? = some i)\n    {l : Nat} (hl : l ∈ footprint P' (n + i)) :\n    (L l).alloc = next + j ∧ (L l).off + (L l).len ≤ (g i).size := by\n  have := h.place j (lt_of_getElem? hj); rw [hj] at this; exact this l hl\n\n/-- A usable place is not owned by a frame popped from the stack (MM-03.3.2). -/\ntheorem not_frameGone_of_usable {s : S3} {q : Nat} {pl : Place} (hu : s.Usable q)\n    (hpl : s.P[q]? = some pl) : ¬ FrameGone s.F pl.owner := by\n  have := hu.owner_live hpl\n  cases ho : pl.owner with\n  | frame f => rw [ho] at this; exact fun h => h this\n  | place _ => exact fun h => by rw [ho] at h; exact h\n\n/-- K2, K3: `Repr` carries over when new places, a shape appended after the old ones, receive one\nfresh allocation per new root (`allocOps`), laid out by `NewLayout`: the old places keep their\nusability, `freed` marks and frame; the new places are usable and not freed; no leaf becomes\n`Init`; a new root owned by the frame `f` has the token `tok f`. -/\ntheorem repr_extend {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {hd : Holder}\n    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}\n    {fa : Option Nat} (hR : Repr tok L s3 s2) (hwf : MM02.WF s2)\n    (hP : s3'.P = shapeP s3.P hd ls) (hsh : ShapeOK s3.P.length ls)\n    (hUold : ∀ q < s3.P.length, s3'.Usable q → s3.Usable q)\n    (hUold' : ∀ q < s3.P.length, s3.Usable q → s3'.Usable q)\n    (hUnew : ∀ i < ls.length, s3'.Usable (s3.P.length + i))\n    (hfr : ∀ q, s3'.freed q = if s3.P.length ≤ q then false else s3.freed q)\n    (hI : ∀ l, s3'.I l = .init → l < s3.P.length ∧ s3.I l = .init)\n    (hgone : ∀ q < s3.P.length, ∀ pl : Place, s3.P[q]? = some pl → FrameGone s3'.F pl.owner →\n      FrameGone s3.F pl.owner)\n    (htok : ∀ f, hd = .frame f → fa = some (tok f))\n    (hNL : NewLayout L s3'.P s3.P.length s2.next g (rootIdx ls)) :\n    Repr tok L s3' (exec s2 (allocOps pl g fa s2 (rootIdx ls))) := by\n  -- notations\n  have hlen : s3'.P.length = s3.P.length + ls.length := by rw [hP, shapeP_len]\n  have hold := allocOps_old pl g fa (rootIdx ls) s2\n  have hnew := allocOps_new pl g fa (rootIdx ls) s2\n  have hget : ∀ q < s3.P.length, s3'.P[q]? = s3.P[q]? := fun q hq => by rw [hP, shapeP_lt hq]\n  have hleaf : ∀ l < s3.P.length, isLeaf s3'.P l ↔ isLeaf s3.P l := fun l hl => by\n    rw [hP]; exact shape_isLeaf_old hsh hl\n  have hroot : ∀ r < s3.P.length, RootPlace s3'.P r ↔ RootPlace s3.P r := fun r hr => by\n    rw [hP]; exact shape_rootPlace_old hr\n  have hfp : ∀ r < s3.P.length, ∀ l, l ∈ footprint s3'.P r ↔ l ∈ footprint s3.P r :=\n    fun r hr l => by rw [hP]; exact shape_footprint_old hsh hr l\n  have hfpge : ∀ i l, l ∈ footprint s3'.P (s3.P.length + i) → s3.P.length ≤ l := fun i l h => by\n    rw [hP] at h; exact shape_root_fp_ge h\n  -- an old leaf is in an allocation of `s2`\n  have hlt : ∀ l < s3.P.length, isLeaf s3.P l → (L l).alloc < s2.next := fun l hl hlf =>\n    (hR.lwf.within l hl hlf).lt hwf\n  -- a new root place is the `j`-th root of the shape\n  have hnr : ∀ r < s3'.P.length, RootPlace s3'.P r → ¬ r < s3.P.length →\n      ∃ j i, (rootIdx ls)[j]? = some i ∧ r = s3.P.length + i := fun r _ hr hn => by\n    rw [hP] at hr\n    obtain ⟨i, e, hi⟩ := shape_rootPlace_new hr (by omega)\n    obtain ⟨j, hj⟩ := List.getElem?_of_mem hi\n    exact ⟨j, i, hj, e⟩\n  -- a new leaf is in the footprint of a new root\n  have hnl : ∀ l < s3'.P.length, isLeaf s3'.P l → ¬ l < s3.P.length →\n      ∃ j i, (rootIdx ls)[j]? = some i ∧ l ∈ footprint s3'.P (s3.P.length + i) :=\n    fun l hl hlf hn => by\n      obtain ⟨i, hi, hpart⟩ := shape_part_root (P := s3.P) (hd := hd) hsh (l + 1) l\n        (Nat.lt_succ_self l) (by omega) (by rw [← hP]; exact hl)\n      obtain ⟨j, hj⟩ := List.getElem?_of_mem hi\n      exact ⟨j, i, hj, mem_footprint.2 ⟨hl, hlf, by rw [hP]; exact hpart⟩⟩\n  -- the allocation of a leaf of a new root\n  have hna : ∀ j i, (rootIdx ls)[j]? = some i → ∀ l ∈ footprint s3'.P (s3.P.length + i),\n      (L l).alloc = s2.next + j ∧ (L l).off + (L l).len ≤ (g i).size ∧\n      ∃ b, (exec s2 (allocOps pl g fa s2 (rootIdx ls))).allocs (L l).alloc =\n        some ⟨(g i).space, b, (g i).size, (g i).align, true, fun _ => .uninit, fa⟩ :=\n    fun j i hj l hl => by\n      obtain ⟨e, hs⟩ := hNL.at hj hl\n      obtain ⟨b, hb⟩ := hnew j i hj\n      exact ⟨e, hs, b, by rw [e]; exact hb⟩\n  -- the new places are not old\n  have hroot_lt : ∀ j i, (rootIdx ls)[j]? = some i → i < ls.length := fun j i hj =>\n    (rootIdx_mem hj).1\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n  · -- K1 (a)\n    intro r hr hrt l hl l' hl'\n    by_cases hro : r < s3.P.length\n    · exact hR.lwf.sameAlloc r hro ((hroot r hro).1 hrt) l ((hfp r hro l).1 hl) l'\n        ((hfp r hro l').1 hl')\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt hro\n      rw [(hna j i hj l hl).1, (hna j i hj l' hl').1]\n  · -- K1 (b)\n    intro l hl l' hl' hlf hlf' hne he\n    by_cases ho : l < s3.P.length <;> by_cases ho' : l' < s3.P.length\n    · exact hR.lwf.disjoint l ho l' ho' ((hleaf l ho).1 hlf) ((hleaf l' ho').1 hlf') hne he\n    · obtain ⟨j, i, hj, hm⟩ := hnl l' hl' hlf' ho'\n      have := hlt l ho ((hleaf l ho).1 hlf); rw [he, (hna j i hj l' hm).1] at this; omega\n    · obtain ⟨j, i, hj, hm⟩ := hnl l hl hlf ho\n      have := hlt l' ho' ((hleaf l' ho').1 hlf'); rw [← he, (hna j i hj l hm).1] at this; omega\n    · exact hNL.disjoint l hl l' hl' (by omega) (by omega) hlf hlf' hne he\n  · -- K1 (c)\n    intro l hl hlf\n    by_cases ho : l < s3.P.length\n    · have h := hR.lwf.within l ho ((hleaf l ho).1 hlf)\n      exact h.of_eq (hold _ (h.lt hwf))\n    · obtain ⟨j, i, hj, hm⟩ := hnl l hl hlf ho\n      obtain ⟨-, hs, b, hb⟩ := hna j i hj l hm\n      exact ⟨_, hb, hs⟩\n  · -- K2: injectivity\n    intro r hr r' hr' hrt hrt' hne l hl l' hl'\n    by_cases ho : r < s3.P.length <;> by_cases ho' : r' < s3.P.length\n    · exact hR.inj r ho r' ho' ((hroot r ho).1 hrt) ((hroot r' ho').1 hrt') hne l\n        ((hfp r ho l).1 hl) l' ((hfp r' ho' l').1 hl')\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r' hr' hrt' ho'\n      have hlf := (mem_footprint.1 ((hfp r ho l).1 hl)).2.1\n      have := hlt l (mem_footprint.1 ((hfp r ho l).1 hl)).1 hlf\n      rw [(hna j i hj l' hl').1]; omega\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho\n      have hlf := (mem_footprint.1 ((hfp r' ho' l').1 hl')).2.1\n      have := hlt l' (mem_footprint.1 ((hfp r' ho' l').1 hl')).1 hlf\n      rw [(hna j i hj l hl).1]; omega\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho\n      obtain ⟨j', i', hj', rfl⟩ := hnr r' hr' hrt' ho'\n      rw [(hna j i hj l hl).1, (hna j' i' hj' l' hl').1]\n      intro e\n      have : j = j' := by omega\n      subst this; rw [hj] at hj'; cases hj'; exact hne rfl\n  · -- K2: tokens\n    intro r hr hrt\n    by_cases ho : r < s3.P.length\n    · rw [hget r ho]\n      exact OptP.imp (hR.tokens r ho ((hroot r ho).1 hrt)) (fun _ h => OptP.imp h\n        (fun _ h l hl => by\n          have h1 := h l ((hfp r ho l).1 hl)\n          exact h1.of_eq (hold _ (h1.lt hwf))) id) id\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho\n      rw [hP, shapeP_new (hroot_lt j i hj)]\n      simp only [OptP]\n      unfold shapeOwner; split\n      · trivial\n      · rename_i hno\n        cases hhd : hd with\n        | place _ => trivial\n        | frame f =>\n          intro l hl\n          obtain ⟨-, -, b, hb⟩ := hna j i hj l (by rw [hP]; exact hl)\n          exact ⟨_, hb, htok f hhd⟩\n  · -- K3: usable roots\n    intro r hr hrt hu l hl\n    by_cases ho : r < s3.P.length\n    · have h := hR.live r ho ((hroot r ho).1 hrt) (hUold r ho hu) l ((hfp r ho l).1 hl)\n      exact h.of_eq (hold _ (h.lt hwf))\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho\n      obtain ⟨-, -, b, hb⟩ := hna j i hj l hl\n      exact ⟨_, hb, rfl⟩\n  · -- K3: `Init` leaves\n    intro l hl hlf hi\n    obtain ⟨ho, hi'⟩ := hI l hi\n    have h := hR.init l ho ((hleaf l ho).1 hlf) hi'\n    exact h.of_eq (hold _ (h.lt hwf))\n  · -- K3: freed roots\n    intro r hr hrt hf l hl\n    rw [hfr] at hf\n    by_cases ho : r < s3.P.length\n    · rw [if_neg (by omega)] at hf\n      have h := hR.freed r ho ((hroot r ho).1 hrt) hf l ((hfp r ho l).1 hl)\n      exact h.of_eq (hold _ (h.lt hwf))\n    · rw [if_pos (by omega)] at hf; cases hf\n  · -- K3: roots of an exited frame\n    intro r hr hrt hg l hl\n    by_cases ho : r < s3.P.length\n    · rw [hget r ho] at hg\n      have hg' : OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False := by\n        cases hpl : s3.P[r]? with\n        | none => rw [hpl] at hg; exact hg\n        | some pl => rw [hpl] at hg; exact hgone r ho pl hpl hg\n      have h := hR.exited r ho ((hroot r ho).1 hrt) hg' l ((hfp r ho l).1 hl)\n      exact h.of_eq (hold _ (h.lt hwf))\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho\n      have hu := hUnew i (hroot_lt j i hj)\n      cases hpl : s3'.P[s3.P.length + i]? with\n      | none => rw [hpl] at hg; exact hg.elim\n      | some pl => rw [hpl] at hg; exact absurd hg (not_frameGone_of_usable hu hpl)\n  · -- K3: leaked roots\n    intro r hr hrt hu hf ho' l hl\n    by_cases ho : r < s3.P.length\n    · rw [hfr, if_neg (by omega)] at hf\n      rw [hget r ho] at ho'\n      have h := hR.leaked r ho ((hroot r ho).1 hrt) (fun h => hu (hUold' r ho h)) hf ho' l\n        ((hfp r ho l).1 hl)\n      exact h.of_eq (hold _ (h.lt hwf))\n    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho\n      exact absurd (hUnew i (hroot_lt j i hj)) hu\n\n/-! ## Smoke test -/","originalFile":null,"structuredPatch":[{"oldStart":443,"oldLines":6,"newStart":443,"newLines":335,"lines":["     · show AllOk C ObR ObW (Op2.eff _ s2) _; rw [e₁]; exact this.1","     · show Repr tok L _ (exec (Op2.eff _ s2) _); rw [e₁]; exact this.2"," ","+/-! ## Allocations (K2, K4: `enterFrame`, `alloc`, static storage) -/","+","+section AllocOps","+variable (pl : Placement) (g : Nat → Geom) (fa : Option Nat)","+","+theorem allocOps_next : ∀ (roots : List Nat) (s : MM02.State),","+    (exec s (allocOps pl g fa s roots)).next = s.next + roots.length","+  | [], _ => rfl","+  | _ :: is, s => by","+    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).next = _","+    rw [allocOps_next is]; simp only [MM02.State.alloc, List.length_cons]; omega","+","+theorem allocOps_old : ∀ (roots : List Nat) (s : MM02.State) (i : Nat), i < s.next →","+    (exec s (allocOps pl g fa s roots)).allocs i = s.allocs i","+  | [], _, _, _ => rfl","+  | _ :: is, s, i, hi => by","+    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).allocs i = _","+    rw [allocOps_old is _ i (by simp only [MM02.State.alloc]; omega)]","+    simp [MM02.State.alloc, Nat.ne_of_lt hi]","+","+theorem allocOps_new : ∀ (roots : List Nat) (s : MM02.State) (j i : Nat), roots[j]? = some i →","+    ∃ b, (exec s (allocOps pl g fa s roots)).allocs (s.next + j) =","+      some ⟨(g i).space, b, (g i).size, (g i).align, true, fun _ => .uninit, fa⟩","+  | [], _, _, _, h => by simp at h","+  | k :: is, s, 0, i, h => by","+    simp only [List.getElem?_cons_zero, Option.some.injEq] at h; subst h","+    refine ⟨pl s (g k), ?_⟩","+    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).allocs _ = _","+    rw [allocOps_old is _ _ (by simp [MM02.State.alloc])]","+    simp [MM02.State.alloc]","+  | k :: is, s, j + 1, i, h => by","+    simp only [List.getElem?_cons_succ] at h","+    obtain ⟨b, hb⟩ := allocOps_new is (s.alloc (g k).space (pl s (g k)) (g k).size (g k).align fa)","+      j i h","+    refine ⟨b, ?_⟩","+    show (exec (s.alloc _ _ _ _ fa) (allocOps pl g fa _ is)).allocs _ = _","+    rw [show s.next + (j + 1) = (s.alloc (g k).space (pl s (g k)) (g k).size (g k).align fa).next + j","+      by simp only [MM02.State.alloc]; omega]","+    exact hb","+","+theorem allocOps_wf : ∀ (roots : List Nat) (s : MM02.State), MM02.WF s →","+    MM02.WF (exec s (allocOps pl g fa s roots))","+  | [], _, h => h","+  | _ :: is, _, h => allocOps_wf is _ (MM02.alloc_wf h _ _ _ _ _)","+","+/-- K2, K4: the allocations of the roots have the outcome `ok` (MM-02.2, création brute) under the","+obligation of the placement and valid alignments. -/","+theorem allocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {pl : Placement} {g : Nat → Geom} {fa : Option Nat} (hpl : PlacementOK pl) :","+    ∀ (roots : List Nat) (s : MM02.State), MM02.WF s →","+      (∀ i ∈ roots, 0 < (g i).align ∧ MM02.Pow2 (g i).align) →","+      AllOk C ObR ObW s (allocOps pl g fa s roots)","+  | [], _, _, _ => trivial","+  | i :: is, s, h, hg => by","+    obtain ⟨h0, h2⟩ := hg i (List.mem_cons_self ..)","+    exact ⟨.ok (hpl s (g i) h h0 h2),","+      allocOps_ok hpl is _ (MM02.alloc_wf h _ _ _ _ _) fun i hi => hg i (List.mem_cons_of_mem _ hi)⟩","+","+end AllocOps","+","+theorem AllocP.of_eq {s s' : MM02.State} {i : Nat} {p : MM02.Alloc → Prop} (h : AllocP s i p)","+    (he : s'.allocs i = s.allocs i) : AllocP s' i p :=","+  let ⟨a, ha, hpa⟩ := h; ⟨a, he.trans ha, hpa⟩","+","+/-! ## Shapes appended to the places (C6 of MM-03) -/","+","+section Shape","+variable {P : List Place} {hd : Holder} {ls : List (Option Nat × Option Nat × Nat)}","+","+theorem shape_isLeaf_old (hsh : ShapeOK P.length ls) {l : Nat} (hl : l < P.length) :","+    isLeaf (shapeP P hd ls) l ↔ isLeaf P l := by","+  constructor","+  · intro h r hr; rw [← shape_parentOf_lt hr]; exact h r (by rw [shapeP_len]; omega)","+  · intro h r hr e","+    by_cases hrn : r < P.length","+    · rw [shape_parentOf_lt hrn] at e; exact h r hrn e","+    · rw [shapeP_len] at hr","+      have hi : r - P.length < ls.length := by omega","+      have hp := shape_parentOf_new (P := P) (hd := hd) hi","+      rw [show P.length + (r - P.length) = r by omega, e] at hp","+      have := (hsh (r - P.length) (List.mem_range.2 hi)).1","+      rw [← hp] at this; simp only [OptP] at this; omega","+","+theorem shape_rootPlace_old {r : Nat} (hr : r < P.length) :","+    RootPlace (shapeP P hd ls) r ↔ RootPlace P r := by","+  simp only [RootPlace, shape_parentOf_lt hr, shapeP_len]; omega","+","+theorem shape_rootPlace_new {r : Nat} (h : RootPlace (shapeP P hd ls) r) (hr : P.length ≤ r) :","+    ∃ i, r = P.length + i ∧ i ∈ rootIdx ls := by","+  obtain ⟨hlt, hn⟩ := h","+  rw [shapeP_len] at hlt","+  have hi : r - P.length < ls.length := by omega","+  have hp := shape_parentOf_new (P := P) (hd := hd) hi","+  rw [show P.length + (r - P.length) = r by omega, hn] at hp","+  exact ⟨r - P.length, by omega, mem_rootIdx hi hp.symm⟩","+","+/-- Every new place is a part of a new root place (MM-03.3.2; C6). -/","+theorem shape_part_root (hsh : ShapeOK P.length ls) : ∀ m l, l < m → P.length ≤ l →","+    l < (shapeP P hd ls).length → ∃ i ∈ rootIdx ls, partOf (shapeP P hd ls) l (P.length + i)","+  | 0, _, h, _, _ => absurd h (Nat.not_lt_zero _)","+  | m + 1, l, hlm, hge, hl => by","+    rw [shapeP_len] at hl","+    have hi : l - P.length < ls.length := by omega","+    have hp := shape_parentOf_new (P := P) (hd := hd) hi","+    rw [show P.length + (l - P.length) = l by omega] at hp","+    cases hb : (ls[l - P.length]?).bind (·.1) with","+    | none =>","+      refine ⟨l - P.length, mem_rootIdx hi hb, by rw [shapeP_len]; omega, .inl (by omega)⟩","+    | some p =>","+      have h1 := (hsh (l - P.length) (List.mem_range.2 hi)).1","+      rw [hb] at h1; simp only [OptP] at h1","+      rw [hb] at hp","+      obtain ⟨i, hi', hpi⟩ := shape_part_root hsh m p (by omega) (by omega) (by rw [shapeP_len]; omega)","+      refine ⟨i, hi', by rw [shapeP_len]; omega, .inr ?_⟩","+      rw [chain_cons hp (by omega)]","+      rcases hpi.2 with e | e","+      · rw [e]; exact List.mem_cons_self ..","+      · exact List.mem_cons_of_mem _ e","+","+end Shape","+","+/-- K1, K2: layout of the new roots `roots` of the places `P'` appended after `n` old places, in","+fresh allocations: the leaves of the `j`-th new root `n + i` are in the allocation `next + j`,","+within the size of `g i`; two distinct new leaves of one allocation have disjoint ranges. -/","+structure NewLayout (L : Layout) (P' : List Place) (n next : Nat) (g : Nat → Geom)","+    (roots : List Nat) : Prop where","+  place : ∀ j < roots.length, OptP (roots[j]?) (fun i => ∀ l ∈ footprint P' (n + i),","+    (L l).alloc = next + j ∧ (L l).off + (L l).len ≤ (g i).size) True","+  disjoint : ∀ l < P'.length, ∀ l' < P'.length, n ≤ l → n ≤ l' → isLeaf P' l → isLeaf P' l' →","+    l ≠ l' → (L l).alloc = (L l').alloc →","+    MM02.RangeDisjoint (L l).off (L l).len (L l').off (L l').len","+","+set_option synthInstance.maxSize 512 in","+instance (L : Layout) (P' : List Place) (n next : Nat) (g : Nat → Geom) (roots : List Nat) :","+    Decidable (NewLayout L P' n next g roots) :=","+  decidable_of_iff","+    ((∀ j < roots.length, OptP (roots[j]?) (fun i => ∀ l ∈ footprint P' (n + i),","+      (L l).alloc = next + j ∧ (L l).off + (L l).len ≤ (g i).size) True) ∧","+     (∀ l < P'.length, ∀ l' < P'.length, n ≤ l → n ≤ l' → isLeaf P' l → isLeaf P' l' →","+      l ≠ l' → (L l).alloc = (L l').alloc →","+      MM02.RangeDisjoint (L l).off (L l).len (L l').off (L l').len))","+    ⟨fun ⟨a, b⟩ => ⟨a, b⟩, fun ⟨a, b⟩ => ⟨a, b⟩⟩","+","+theorem NewLayout.at {L : Layout} {P' : List Place} {n next : Nat} {g : Nat → Geom}","+    {roots : List Nat} (h : NewLayout L P' n next g roots) {j i : Nat} (hj : roots[j]? = some i)","+    {l : Nat} (hl : l ∈ footprint P' (n + i)) :","+    (L l).alloc = next + j ∧ (L l).off + (L l).len ≤ (g i).size := by","+  have := h.place j (lt_of_getElem? hj); rw [hj] at this; exact this l hl","+","+/-- A usable place is not owned by a frame popped from the stack (MM-03.3.2). -/","+theorem not_frameGone_of_usable {s : S3} {q : Nat} {pl : Place} (hu : s.Usable q)","+    (hpl : s.P[q]? = some pl) : ¬ FrameGone s.F pl.owner := by","+  have := hu.owner_live hpl","+  cases ho : pl.owner with","+  | frame f => rw [ho] at this; exact fun h => h this","+  | place _ => exact fun h => by rw [ho] at h; exact h","+","+/-- K2, K3: `Repr` carries over when new places, a shape appended after the old ones, receive one","+fresh allocation per new root (`allocOps`), laid out by `NewLayout`: the old places keep their","+usability, `freed` marks and frame; the new places are usable and not freed; no leaf becomes","+`Init`; a new root owned by the frame `f` has the token `tok f`. -/","+theorem repr_extend {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {hd : Holder}","+    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}","+    {fa : Option Nat} (hR : Repr tok L s3 s2) (hwf : MM02.WF s2)","+    (hP : s3'.P = shapeP s3.P hd ls) (hsh : ShapeOK s3.P.length ls)","+    (hUold : ∀ q < s3.P.length, s3'.Usable q → s3.Usable q)","+    (hUold' : ∀ q < s3.P.length, s3.Usable q → s3'.Usable q)","+    (hUnew : ∀ i < ls.length, s3'.Usable (s3.P.length + i))","+    (hfr : ∀ q, s3'.freed q = if s3.P.length ≤ q then false else s3.freed q)","+    (hI : ∀ l, s3'.I l = .init → l < s3.P.length ∧ s3.I l = .init)","+    (hgone : ∀ q < s3.P.length, ∀ pl : Place, s3.P[q]? = some pl → FrameGone s3'.F pl.owner →","+      FrameGone s3.F pl.owner)","+    (htok : ∀ f, hd = .frame f → fa = some (tok f))","+    (hNL : NewLayout L s3'.P s3.P.length s2.next g (rootIdx ls)) :","+    Repr tok L s3' (exec s2 (allocOps pl g fa s2 (rootIdx ls))) := by","+  -- notations","+  have hlen : s3'.P.length = s3.P.length + ls.length := by rw [hP, shapeP_len]","+  have hold := allocOps_old pl g fa (rootIdx ls) s2","+  have hnew := allocOps_new pl g fa (rootIdx ls) s2","+  have hget : ∀ q < s3.P.length, s3'.P[q]? = s3.P[q]? := fun q hq => by rw [hP, shapeP_lt hq]","+  have hleaf : ∀ l < s3.P.length, isLeaf s3'.P l ↔ isLeaf s3.P l := fun l hl => by","+    rw [hP]; exact shape_isLeaf_old hsh hl","+  have hroot : ∀ r < s3.P.length, RootPlace s3'.P r ↔ RootPlace s3.P r := fun r hr => by","+    rw [hP]; exact shape_rootPlace_old hr","+  have hfp : ∀ r < s3.P.length, ∀ l, l ∈ footprint s3'.P r ↔ l ∈ footprint s3.P r :=","+    fun r hr l => by rw [hP]; exact shape_footprint_old hsh hr l","+  have hfpge : ∀ i l, l ∈ footprint s3'.P (s3.P.length + i) → s3.P.length ≤ l := fun i l h => by","+    rw [hP] at h; exact shape_root_fp_ge h","+  -- an old leaf is in an allocation of `s2`","+  have hlt : ∀ l < s3.P.length, isLeaf s3.P l → (L l).alloc < s2.next := fun l hl hlf =>","+    (hR.lwf.within l hl hlf).lt hwf","+  -- a new root place is the `j`-th root of the shape","+  have hnr : ∀ r < s3'.P.length, RootPlace s3'.P r → ¬ r < s3.P.length →","+      ∃ j i, (rootIdx ls)[j]? = some i ∧ r = s3.P.length + i := fun r _ hr hn => by","+    rw [hP] at hr","+    obtain ⟨i, e, hi⟩ := shape_rootPlace_new hr (by omega)","+    obtain ⟨j, hj⟩ := List.getElem?_of_mem hi","+    exact ⟨j, i, hj, e⟩","+  -- a new leaf is in the footprint of a new root","+  have hnl : ∀ l < s3'.P.length, isLeaf s3'.P l → ¬ l < s3.P.length →","+      ∃ j i, (rootIdx ls)[j]? = some i ∧ l ∈ footprint s3'.P (s3.P.length + i) :=","+    fun l hl hlf hn => by","+      obtain ⟨i, hi, hpart⟩ := shape_part_root (P := s3.P) (hd := hd) hsh (l + 1) l","+        (Nat.lt_succ_self l) (by omega) (by rw [← hP]; exact hl)","+      obtain ⟨j, hj⟩ := List.getElem?_of_mem hi","+      exact ⟨j, i, hj, mem_footprint.2 ⟨hl, hlf, by rw [hP]; exact hpart⟩⟩","+  -- the allocation of a leaf of a new root","+  have hna : ∀ j i, (rootIdx ls)[j]? = some i → ∀ l ∈ footprint s3'.P (s3.P.length + i),","+      (L l).alloc = s2.next + j ∧ (L l).off + (L l).len ≤ (g i).size ∧","+      ∃ b, (exec s2 (allocOps pl g fa s2 (rootIdx ls))).allocs (L l).alloc =","+        some ⟨(g i).space, b, (g i).size, (g i).align, true, fun _ => .uninit, fa⟩ :=","+    fun j i hj l hl => by","+      obtain ⟨e, hs⟩ := hNL.at hj hl","+      obtain ⟨b, hb⟩ := hnew j i hj","+      exact ⟨e, hs, b, by rw [e]; exact hb⟩","+  -- the new places are not old","+  have hroot_lt : ∀ j i, (rootIdx ls)[j]? = some i → i < ls.length := fun j i hj =>","+    (rootIdx_mem hj).1","+  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩","+  · -- K1 (a)","+    intro r hr hrt l hl l' hl'","+    by_cases hro : r < s3.P.length","+    · exact hR.lwf.sameAlloc r hro ((hroot r hro).1 hrt) l ((hfp r hro l).1 hl) l'","+        ((hfp r hro l').1 hl')","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt hro","+      rw [(hna j i hj l hl).1, (hna j i hj l' hl').1]","+  · -- K1 (b)","+    intro l hl l' hl' hlf hlf' hne he","+    by_cases ho : l < s3.P.length <;> by_cases ho' : l' < s3.P.length","+    · exact hR.lwf.disjoint l ho l' ho' ((hleaf l ho).1 hlf) ((hleaf l' ho').1 hlf') hne he","+    · obtain ⟨j, i, hj, hm⟩ := hnl l' hl' hlf' ho'","+      have := hlt l ho ((hleaf l ho).1 hlf); rw [he, (hna j i hj l' hm).1] at this; omega","+    · obtain ⟨j, i, hj, hm⟩ := hnl l hl hlf ho","+      have := hlt l' ho' ((hleaf l' ho').1 hlf'); rw [← he, (hna j i hj l hm).1] at this; omega","+    · exact hNL.disjoint l hl l' hl' (by omega) (by omega) hlf hlf' hne he","+  · -- K1 (c)","+    intro l hl hlf","+    by_cases ho : l < s3.P.length","+    · have h := hR.lwf.within l ho ((hleaf l ho).1 hlf)","+      exact h.of_eq (hold _ (h.lt hwf))","+    · obtain ⟨j, i, hj, hm⟩ := hnl l hl hlf ho","+      obtain ⟨-, hs, b, hb⟩ := hna j i hj l hm","+      exact ⟨_, hb, hs⟩","+  · -- K2: injectivity","+    intro r hr r' hr' hrt hrt' hne l hl l' hl'","+    by_cases ho : r < s3.P.length <;> by_cases ho' : r' < s3.P.length","+    · exact hR.inj r ho r' ho' ((hroot r ho).1 hrt) ((hroot r' ho').1 hrt') hne l","+        ((hfp r ho l).1 hl) l' ((hfp r' ho' l').1 hl')","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r' hr' hrt' ho'","+      have hlf := (mem_footprint.1 ((hfp r ho l).1 hl)).2.1","+      have := hlt l (mem_footprint.1 ((hfp r ho l).1 hl)).1 hlf","+      rw [(hna j i hj l' hl').1]; omega","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho","+      have hlf := (mem_footprint.1 ((hfp r' ho' l').1 hl')).2.1","+      have := hlt l' (mem_footprint.1 ((hfp r' ho' l').1 hl')).1 hlf","+      rw [(hna j i hj l hl).1]; omega","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho","+      obtain ⟨j', i', hj', rfl⟩ := hnr r' hr' hrt' ho'","+      rw [(hna j i hj l hl).1, (hna j' i' hj' l' hl').1]","+      intro e","+      have : j = j' := by omega","+      subst this; rw [hj] at hj'; cases hj'; exact hne rfl","+  · -- K2: tokens","+    intro r hr hrt","+    by_cases ho : r < s3.P.length","+    · rw [hget r ho]","+      exact OptP.imp (hR.tokens r ho ((hroot r ho).1 hrt)) (fun _ h => OptP.imp h","+        (fun _ h l hl => by","+          have h1 := h l ((hfp r ho l).1 hl)","+          exact h1.of_eq (hold _ (h1.lt hwf))) id) id","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho","+      rw [hP, shapeP_new (hroot_lt j i hj)]","+      simp only [OptP]","+      unfold shapeOwner; split","+      · trivial","+      · rename_i hno","+        cases hhd : hd with","+        | place _ => trivial","+        | frame f =>","+          intro l hl","+          obtain ⟨-, -, b, hb⟩ := hna j i hj l (by rw [hP]; exact hl)","+          exact ⟨_, hb, htok f hhd⟩","+  · -- K3: usable roots","+    intro r hr hrt hu l hl","+    by_cases ho : r < s3.P.length","+    · have h := hR.live r ho ((hroot r ho).1 hrt) (hUold r ho hu) l ((hfp r ho l).1 hl)","+      exact h.of_eq (hold _ (h.lt hwf))","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho","+      obtain ⟨-, -, b, hb⟩ := hna j i hj l hl","+      exact ⟨_, hb, rfl⟩","+  · -- K3: `Init` leaves","+    intro l hl hlf hi","+    obtain ⟨ho, hi'⟩ := hI l hi","+    have h := hR.init l ho ((hleaf l ho).1 hlf) hi'","+    exact h.of_eq (hold _ (h.lt hwf))","+  · -- K3: freed roots","+    intro r hr hrt hf l hl","+    rw [hfr] at hf","+    by_cases ho : r < s3.P.length","+    · rw [if_neg (by omega)] at hf","+      have h := hR.freed r ho ((hroot r ho).1 hrt) hf l ((hfp r ho l).1 hl)","+      exact h.of_eq (hold _ (h.lt hwf))","+    · rw [if_pos (by omega)] at hf; cases hf","+  · -- K3: roots of an exited frame","+    intro r hr hrt hg l hl","+    by_cases ho : r < s3.P.length","+    · rw [hget r ho] at hg","+      have hg' : OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False := by","+        cases hpl : s3.P[r]? with","+        | none => rw [hpl] at hg; exact hg","+        | some pl => rw [hpl] at hg; exact hgone r ho pl hpl hg","+      have h := hR.exited r ho ((hroot r ho).1 hrt) hg' l ((hfp r ho l).1 hl)","+      exact h.of_eq (hold _ (h.lt hwf))","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho","+      have hu := hUnew i (hroot_lt j i hj)","+      cases hpl : s3'.P[s3.P.length + i]? with","+      | none => rw [hpl] at hg; exact hg.elim","+      | some pl => rw [hpl] at hg; exact absurd hg (not_frameGone_of_usable hu hpl)","+  · -- K3: leaked roots","+    intro r hr hrt hu hf ho' l hl","+    by_cases ho : r < s3.P.length","+    · rw [hfr, if_neg (by omega)] at hf","+      rw [hget r ho] at ho'","+      have h := hR.leaked r ho ((hroot r ho).1 hrt) (fun h => hu (hUold' r ho h)) hf ho' l","+        ((hfp r ho l).1 hl)","+      exact h.of_eq (hold _ (h.lt hwf))","+    · obtain ⟨j, i, hj, rfl⟩ := hnr r hr hrt ho","+      exact absurd (hUnew i (hroot_lt j i hj)) hu","+"," /-! ## Smoke test -/"," "," namespace Smoke"]}],"userModified":false,"replaceAll":false,"staleRecovered":true,"contentNotInModelContext":true},"sourceToolAssistantUUID":"f5987745-25d7-4a1d-82e1-c3a469fc2d01","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
