laude-fable-5-2","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
