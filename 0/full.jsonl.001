,"       (fun r _ hrt hu => ?_) (fun r _ _ hf => .inl (by rw [e] at hf; exact hf))","       (fun r _ hrt hg => ?_) (fun r _ hrt hu hf ho => ?_)","     · have hu' : ({ s3 with F := F₀ } : S3).Usable r :="]},{"oldStart":1803,"oldLines":12,"newStart":1805,"newLines":12,"lines":[" states are in `Repr`. -/"," theorem r6_noStep {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","     {k : K} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}","-    (hR : ReprB tok ptok provOf L s3 s2) (h : NoStep k s3 s3') :","-    AllOk C ObR ObW s2 [] ∧ ReprB tok ptok provOf L s3' (exec s2 []) := by","-  refine ⟨trivial, ?_⟩","+    (hR : Repr tok ptok provOf L s3 s2) (h : NoStep k s3 s3') :","+    AllOk C ObR ObW s2 [] ∧ Repr tok ptok provOf L s3' (exec s2 []) := by","+  refine ⟨trivial, ?_, hR.wf2⟩","   have same : ∀ {s' : S3}, s'.P = s3.P → s'.F = s3.F → s'.dead = s3.dead → s'.freed = s3.freed →","       s'.I = s3.I → ReprB tok ptok provOf L s' s2 := fun hP hF hd hfr hI =>","-    hR.shrink hP hF hfr (fun _ h => h.of_eqs hP hF hd) (fun _ h => by rw [← hI]; exact h)","+    hR.toReprB.shrink hP hF hfr (fun _ h => h.of_eqs hP hF hd) (fun _ h => by rw [← hI]; exact h)","   cases h with","   | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl","   | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl"]},{"oldStart":1819,"oldLines":7,"newStart":1821,"newLines":7,"lines":["   | endUse hs =>","     rename_i p","     obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","-    refine hR.shrink rfl rfl rfl (fun q hq => S3.Usable.mono (s := s3) (s' := endUseEff s3 p) rfl","+    refine hR.toReprB.shrink rfl rfl rfl (fun q hq => S3.Usable.mono (s := s3) (s' := endUseEff s3 p) rfl","       (fun _ h => h) (fun q' hq' => ?_) hq)","       (fun l hl => ?_)","     · simp only [endUseEff, cleanup, endUseS, Bool.or_eq_false_iff] at hq'; exact hq'.1"]},{"oldStart":1840,"oldLines":8,"newStar