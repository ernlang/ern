/Concurrency/Transfer.lean:25:def spawnCreate (s : SC) (c : Nat) (ls : LocalShape) : SC := spawnEff s c [] ls\nErn/Concurrency/Transfer.lean:29:def transfersEff (c : Nat) : SC → List (Nat × Nat) → SC\nErn/Concurrency/Transfer.lean:35:def yieldEff (t : SC) (ps : List Nat) (f : Nat) : SC :=\nErn/Concurrency/Transfer.lean:130:structure SpawnValPre (k : K) (s : SC) (c : Nat) (ps : List Nat) (ls : LocalShape)\nErn/Concurrency/Transfer.lean:185:def SpawnValStep (k : K) (s : SC) (c : Nat) (ps : List Nat) (ls : LocalShape)\nErn/Concurrency/Sync.lean:29:def deriveSyncEff (s : SC) (c g : Nat) : SC :=","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"963cd802-b680-4217-b3a1-8f29a367e030","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"901eaa5f-4453-470f-af69-4d5a0d4f3ae7","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
