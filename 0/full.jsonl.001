lit` change no initialisation, and `store` initialises only the destination, which"]},{"oldStart":594,"oldLines":9,"newStart":606,"newLines":11,"lines":[" "," /-! ## Marks are never reused (`mark_no_aba`) -/"," ","-/-- The marks of the stack `i` name the stack `i` and have identifiers below `fresh`. -/","+/-- The marks of the stack `i` are pairwise distinct, name the stack `i` and have identifiers below","+`fresh`. -/"," def MarksWF (d : DS) : Prop :=","-  ∀ (i : Nat) (st : Stack), d.stacks[i]? = some st → ∀ m ∈ st.marks, m.stack = i ∧ m.id < d.fresh","+  ∀ (i : Nat) (st : Stack), d.stacks[i]? = some st →","+    st.marks.Nodup ∧ ∀ m ∈ st.marks, m.stack = i ∧ m.id < d.fresh"," "," /-- The mark `m` is live in no stack, and its identifier was given out. -/"," def Gone (d : DS) (m : Mark) : Prop :="]},{"oldStart":621,"oldLines":6,"newStart":635,"newLines":13,"lines":["   · exact hQ _ st hst m (hm m hm')","   · exact hQ i st'' h m hm'"," ","+theorem stacks_set_nodup {d : DS} {j : Nat} {st st' : Stack} (hst : d.stacks[j]? = some st)","+    (hw : MarksWF d) {i : Nat} {st'' : Stack} (h : (d.stacks.set j st')[i]? = some st'')","+    (hsub : st'.marks <+ st.marks) : st''.marks.Nodup := by","+  rcases getElem?_set_cases h with ⟨rfl, rfl⟩ | ⟨-, h⟩","+  · exact (hw _ st hst).1.sublist hsub","+  · exact (hw i st'' h).1","+"," theorem dexec_gone {d d' : DS} {o : DOp} {m : Mark} (h : dexec k d o = .ok d') (hg : Gone d m) :","     Gone d' m := by","   obtain ⟨hid, hno⟩ := hg"]},{"oldStart":671,"oldLines":34,"newStart":692,"newLines":46,"lines":[" "," theorem dexec_marksWF {d d' : DS} {o : DOp} (h : dexec k d o = .ok d') (hw : MarksWF d) :","     MarksWF d' := by","+  have hQ : ∀ (i : Nat) (st : Stack), d.stacks[i]? = some st → ∀ m ∈ st.marks,","+      m.stack = i ∧ m.id < d.fresh := fun i st h => (hw i st h).2","   cases o with","   | kernel o =>","     obtain ⟨-, hs, hf⟩ := dexec_kernel h","-    intro i st h' m hm; rw [hs] at h'; rw [hf]; exact hw i st h' m hm","+    intro i st h';