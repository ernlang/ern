: every leaf of the layout has a non-empty range. -/","-theorem KL_dd : DDSound KL :=","-  ddSound_instance K0 (L := π4.L) fun l => by unfold π4 piOf autoL; simp","+/-- Decision 1 of jalon 2, the source of MM23-H01: the contracts whose `DeclaredDisjoint` is the","+disjointness of the leaves of the two regions, as a parameter `K` (the draft `MM23` is unchanged). -/","+def KLf : K := { K0 with DeclaredDisjoint := fun r r' => ∀ l ∈ r, l ∉ r' }"," ","-def r4s : SSt := sst KL [] π4 r4","-","-/-- **MM23-H01** (passe 2, `ddSound_of_layout`). With `DeclaredDisjoint` instantiated by the byte","-disjointness of the leaves, two regions sharing the leaf 2 are not declared disjoint, and their","-`split` is rejected; the regions `[1]` and `[2]` are declared disjoint, with disjoint bytes, and","-their `split` runs in a translated execution, `DDSound` holding. Expected: rejected through","-`DDSound`, declared regions with disjoint bytes; obtained: the same. -/","-theorem H01 : DDSound KL ∧ ¬ KL.DeclaredDisjoint [1, 2] [2] ∧ SplitStep KL 0 [[1, 2], [2]] r4s.1 .reject ∧","-    ByteDisjoint π4.L [1] [2] ∧","-    ∃ os, AllOk Ceq CaseSim.obR CaseSim.obW MM02.State.empty os ∧","-      Repr π4.tok π4.ptok (sst KL [] π4 (r4 ++ [.split 0 [[1], [2]]])).2.1 π4.L","-        (sst KL [] π4 (r4 ++ [.split 0 [[1], [2]]])).1 (sst KL [] π4 (r4 ++ [.split 0 [[1], [2]]])).2.2 :=","-  ⟨KL_dd, by decide, .reject (by decide), (show KL.DeclaredDisjoint [1] [2] by decide),","-    (sim_of (P := P4) (z := []) KL_dd (by decide) (by decide) (by decide) (by decide)).imp","-      fun _ h => ⟨h.1, h.2.2.1⟩⟩","+instance : ∀ r r', Decidable (KLf.DeclaredDisjoint r r') := fun r r' =>","+  inferInstanceAs (Decidable (∀ l ∈ r, l ∉ r'))","+instance : DecidablePred KLf.SharedMutable := fun l =>","+  inferInstanceAs (Decidable (l ∈ ([] : List Nat)))","+instance : DecidablePred KLf.Pinned := fun l => inferInstanceAs (Decidable (l ∈ ([] : List Nat)))","+instance : DecidablePred KLf.ExternalDone := fun l =>","+  inferInstanceAs (Decidable (l ∈ ([] : List Nat)))","+instance : DecidablePred KLf.Deallocable := fun l =>","+  inferInstanceAs (Decidable (l ∈ ([] : List Nat)))","+instance : ∀ p a, Decidable (KLf.FreeCompat p a) := fun p a =>","+  inferInstanceAs (Decidable ((p, a) ∈ ([] : List (Nat × Nat))))","+instance : ∀ p ls s, Decidable (KLf.Satisfiable p ls s) := fun _ _ _ => instDecidableTrue","+","+/-- `DDSound` of the instantiation by leaf disjointness: immediate (MM-03.3.8). -/","+theorem KLf_dd : DDSound KLf := fun _ _ h => h","+","+def r4s : SSt := sst KLf [] π4 r4","+/-- R4 after the `split` of the structure into the regions `[1]` and `[2]`. -/","+def r4d : SSt := sst KLf [] π4 (r4 ++ [.split 0 [[1], [2]]])","+","+/-- **MM23-H01** (decision 1 of jalon 2; L7, `byteDisjoint_of_leaves`). With `DeclaredDisjoint`","+instantiated by the disjointness of the leaves, two regions sharing the leaf 2 are not declared","+disjoint and their `split` is rejected; the regions `[1]` and `[2]` are declared disjoint and their","+`split` runs in a translated execution. In its MM-02 state, every pair of declared regions of leaves","+has disjoint bytes, through `LayoutWF` of `Repr`. Expected: rejected through `DDSound`","+(instantiation by leaves), declared regions with disjoint bytes; obtained: the same. -/","+theorem H01 : DDSound KLf ∧ ¬ KLf.DeclaredDisjoint [1, 2] [2] ∧","+    SplitStep KLf 0 [[1, 2], [2]] r4s.1 .reject ∧ KLf.DeclaredDisjoint [1] [2] ∧","+    SplitStep KLf 0 [[1], [2]] r4s.1 (.ok (splitEff r4s.1 0 [[1], [2]])) ∧","+    (∃ os, AllOk Ceq CaseSim.obR CaseSim.obW MM02.State.empty os ∧","+      Repr π4.tok π4.ptok r4d.2.1 π4.L r4d.1 r4d.2.2) ∧","+    ∀ r r', KLf.DeclaredDisjoint r r' → (∀ l ∈ r, l < r4d.1.P.length ∧ isLeaf r4d.1.P l) →","+      (∀ l ∈ r', l < r4d.1.P.length ∧ isLeaf r4d.1.P l) → ByteDisjoint π4.L r r' := by","+  obtain ⟨os, hok, -, hR, -⟩ := sim_of (k := KLf) (statics := []) (P := P4) (z := [])","+    (ops := r4 ++ [.split 0 [[1], [2]]]) KLf_dd (by decide) (by decide) 