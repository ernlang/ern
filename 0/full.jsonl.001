aEntry) (region : List Nat) (dst : Nat) : Prop where\nErn/MemoryModel/Arena.lean:770:structure ResetPre (s : S3) (E : ArenaEntry) : Prop where\nErn/MemoryModel/Arena.lean:1541:inductive LStep (k : K) : LState → LState → Prop where\nErn/MemoryModel/Arena.lean:1551:inductive LStepNG (k : K) : LState → LState → Prop where","is_error":false}]},"uuid":"874d4fbe-f0a3-428a-9b38-ec5975827962","timestamp":"2026-11-12T16:26:36.234Z","toolUseResult":{"stdout":"Ern/MemoryModel:\nAccess\nArena.lean\nMachine.lean\nRefinement.lean\nRefinementArena.lean\n\nErn/MemoryModel/Access:\nBasic.lean\nHolderCover.lean\nInvariants.lean\nLemmas.lean\nMain.lean\nOps.lean\nPreserve\nRename\nStatics.lean\nTransferSource.lean\nErn/MemoryModel/Access/Invariants.lean:49:structure WF3 (s : S3) : Prop where\nErn/MemoryModel/Access/Basic.lean:56:structure Place where\nErn/MemoryModel/Access/Basic.lean:124:structure Authority where\nErn/MemoryModel/Access/Basic.lean:134:structure PinOb where\nErn/MemoryModel/Access/Basic.lean:143:structure S3 where\nErn/MemoryModel/Access/Basic.lean:166:structure K where\nErn/MemoryModel/Access/Basic.lean:235:structure KRule (n : Nat) (R : (Nat → Bool) → Nat → Bool) : Prop where\nErn/MemoryModel/Access/Ops.lean:29:structure DerivePre (s : S3) (src : Nat) (region : List Nat) (m : Mode) : Prop where\nErn/MemoryModel/Access/Ops.lean:86:structure SplitPre (k : K) (s : S3) (src : Nat) (rs : List (List Nat)) : Prop where\nErn/MemoryModel/Access/Ops.lean:135:structure ReleasePre (s : S3) (a : Nat) : Prop where\nErn/MemoryModel/Access/Ops.lean:287:structure TransferPre (k : K) (s : S3) (src dst : Nat) : Prop where\nErn/MemoryModel/Access/Ops.lean:357:structure DependPre (s : S3) (q x : Nat) : Prop where\nErn/MemoryModel/Access/Ops.lean:388:structure StorePre (s : S3) (a p : Nat) : Prop where\nErn/MemoryModel/Access/Ops.lean:498:structure EnterPre (s : S3) (ps : List Nat) (ls : LocalShape) : Prop where\nErn/MemoryModel/Access/Ops.lean:556:structure ExitPre (k : K) (s : S3) : Pr