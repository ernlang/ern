e st ∧ PushStatic d.s st dst ∧ st.top + size ≤ st.cells.length ∧","+      IssueSeq k d.s st (cellsOf st st.top size) dst ∧","+      d' = { d with","+        s := issueSeqEff d.s st (cellsOf st st.top size) dst","+        stacks := d.stacks.set j","+          { st with","+            top := st.top + size","+            blocks := st.blocks ++ [⟨st.top, size, d.s.A.length, dst⟩] } } := by","+  unfold push at h","+  split at h","+  · cases h","+  · rename_i st hst","+    split at h","+    · split at h","+      · split at h","+        · cases h; exact ⟨st, hst, by assumption, by assumption, by assumption, rfl⟩","+        · cases h","+      · cases h","+    · cases h","+","+theorem mark_ok {d d' : DS} {j : Nat} (h : mark d j = .ok d') :","+    ∃ st, d.stacks[j]? = some st ∧","+      d' = { d with","+        stacks := d.stacks.set j { st with marks := st.marks ++ [⟨j, d.fresh, st.top⟩] }","+        fresh := d.fresh + 1 } := by","+  unfold mark at h","+  split at h","+  · cases h","+  · rename_i st hst; cases h; exact ⟨st, hst, rfl⟩","+","+theorem rewind_ok {d d' : DS} {j : Nat} {m : Mark} (h : rewind k d j m = .ok d') :","+    ∃ st, d.stacks[j]? = some st ∧ m ∈ st.marks ∧ RewindSeq k d.s st m ∧","+      d' = { d with","+        s := releaseEff (d.s.addAuth (blockOf d.s st.arena (above st m))) d.s.A.length","+        stacks := d.stacks.set j","+          { st with","+            top := m.top","+            blocks := st.blocks.filter (·.base < m.top)","+            marks := st.marks.takeWhile (· ≠ m) } } := by","+  unfold rewind at h","+  split at h","+  · cases h","+  · rename_i st hst","+    split at h","+    · split at h","+      · cases h; exact ⟨st, hst, by assumption, by assumption, rfl⟩","+      · cases h","+    · cases h","+","+theorem grow_ok {d d' : DS} {j b extra : Nat} (h : grow k d j b extra = .ok d') :","+    ∃ st x, d.stacks[j]? = some st ∧ st.blocks.getLast? = some x ∧ 0 < extra ∧ x.auth = b ∧","+      x.base + x.size = st.top ∧ ReleasePre d.s b ∧ x.base + x.size + extra ≤ st.cells.length ∧","+      IssueSeq k (releaseEff d.s b) st (cellsOf st x.base (x.size + extra)) x.dst ∧","+      d' = { d with","+        s := issueSeqEff (releaseEff d.s b) st (cellsOf st x.base (x.size + extra)) x.dst","+        stacks := d.stacks.set j","+          { st with","+            top := x.base + x.size + extra","+            blocks := st.blocks.dropLast ++ [⟨x.base, x.size + extra, d.s.A.length, x.dst⟩] } } := by","+  unfold grow at h","+  split at h","+  · cases h","+  · rename_i st hst","+    split at h","+    · cases h","+    · rename_i x hx","+      split at h","+      · rename_i hc","+        split at h","+        · split at h","+          · cases h","+            exact ⟨st, x, hst, hx, hc.1, hc.2.1, hc.2.2.1, hc.2.2.2, by assumption, by assumption, rfl⟩","+          · cases h","+        · cases h","+      · cases h","+","+/-! ## The kernel part of the library is reached -/","+","+theorem releaseEff_len (s : S3) (a : Nat) : (releaseEff s a).A.length = s.A.length := by","+  unfold releaseEff; split <;> simp","+","+theorem releaseEff_I (s : S3) (a : Nat) : (releaseEff s a).I = s.I := by","+  unfold releaseEff; split <;> rfl","+","+theorem releaseEff_P (s : S3) (a : Nat) : (releaseEff s a).P = s.P := by","+  unfold releaseEff; split <;> rfl","+","+/-- The derived `issue` is a `split` step then a `store` step of `Reachable` (O2, O8). -/","+theorem issueSeq_reach {statics : Statics} {s : S3} {st : Stack} {r : List Nat} {dst : Nat}","+    (hr : Reachable k statics s) (h : IssueSeq k s st r dst) :","+    Reachable k statics (s.addAuth (blockOf s st.arena r)) ∧","+      Reachable k statics (issueSeqEff s st r dst) := by","+  have h1 : Reachable k statics (s.addAuth (blockOf s st.arena r)) :=","+    .split hr (rs := [r]) (src := st.internal) (.ok h.1)","+  exact ⟨h1, .store h1 (.ok h.2)⟩","+","+/-- Every `ok` step of the library takes kernel steps of `Reachable` only. -/","+theorem dexec_reach {statics : Statics} {d d' : DS} {o : DOp} (hr : Reachable k statics d.s)","+    (h : dexec k d o = .ok d') : Reachable k statics d'.s := by","+  cases o with","+  | kernel o => exact reachable_step hr (kexec_step k (dexec_kernel h).1)","+  | newStack st i => obtain ⟨-, -, rfl⟩ := newStack_ok h; exact hr","+  | push j size dst =>","+    obtain ⟨st, -, -, -, hseq, rfl⟩ := push_ok h; exact (issueSeq_reach hr hseq).2","+  | mark j => obtain ⟨st, -, rfl⟩ := mark_ok h; exact hr","+  | rewind j m =>","+    obtain ⟨st, -, -, ⟨hsp, hrel⟩, rfl⟩ := rewind_ok h","+    have h1 : Reachable k statics (d.s.addAuth (blockOf d.s st.arena (above st m))) :=","+      .split hr (rs := [above st m]) (src := st.internal) (.ok hsp)","+    exact .release h1 (.ok hrel)","+  | grow j b extra =>","+    obtain ⟨st, x, -, -, -, -, -, hrel, -, hseq, rfl⟩ := grow_ok h","+    exact (issueSeq_reach (.release hr (.ok hrel)) hseq).2","+","+theorem drun_reach {statics : Statics} : ∀ {d d' : DS} {os : List DOp},","+    Reachable k statics d.s → drun k d os = some d' → Reachable k statics d'.s","+  | d, d', [], hr, h => by simp only [drun, Option.some.injEq] at h; subst h; exact hr","+  | d, d', o :: os, hr, h => by","+    simp only [drun] at h","+    split at h","+    · rename_i d₁ h₁; exact drun_reach (dexec_reach hr h₁) h","+    · cases h","+","+end Inv","+"," end Ern.Lib.DataStack"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Lib/DataStack.lean"]}},"serverClassifierContext":{"request":"36bf2449-7fbe-4192-b481-586c20e10dbd","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/derivability_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visib