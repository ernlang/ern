0 : SC := lv9.set (pinEff (lv9.view 0) 8)\n113\t/-- `unpin(0)` (O16). -/\n114\tdef lv11 : SC := lv10.set (unpinEff (lv10.view 0) 0)\n115\t/-- `alloc(provider = P, owner = Y, one leaf)` (O14): place 10, root authority 10 held by `Y`. -/\n116\tdef lv12 : SC := lv11.set (allocEff (lv11.view 0) 8 [(none, 0)])\n117\t/-- `free(10)` (O13). -/\n118\tdef lv13 : SC := lv12.set (freeEff (lv12.view 0) 10)\n119\t/-- `endUse(Y)` (O12). -/\n120\tdef lv14 : SC := lv13.set (endUseEff (lv13.view 0) 8)\n121\t\n122\t/-- The labels of the trace of legitimate uses. -/\n123\tdef lvLbls : List Label :=\n124\t  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 6 1), .newMutex 0 6,\n125\t   .kernel 0 (.derive 2 [5, 6] .modify), .kernel 0 (.store 7 7), .newArena 0 4 7, .reset 0 0,\n126\t   .kernel 0 (.split 4 [[8]]), .kernel 0 (.read 9 [8]), .kernel 0 (.writeShared 9 [8]),\n127\t   .kernel 0 (.release 9), .kernel 0 (.pin 8), .kernel 0 (.unpin 0),\n128\t   .kernel 0 (.alloc 9 8 [(none, 0)]), .kernel 0 (.free 10 0), .kernel 0 (.endUse 8)]\n129\t\n130\t/-- The named states of the trace of legitimate uses. -/\n131\tdef lvσ (i : Nat) : SC × SyncReg × ArenaReg :=\n132\t  [(lv0, [], []), (lv1, [], []), (lv2, [], []), (lv2, lvReg, []), (lv3, lvReg, []),\n133\t    (lv4, lvReg, []), (lv4, lvReg, lvAr), (lv5, lvReg, lvAr5), (lv6, lvReg, lvAr5),\n134\t    (lv7, lvReg, lvAr5), (lv8, lvReg, lvAr5), (lv9, lvReg, lvAr5), (lv10, lvReg, lvAr5),\n135\t    (lv11, lvReg, lvAr5), (lv12, lvReg, lvAr5), (lv13, lvReg, lvAr5), (lv14, lvReg, lvAr5)].getD i\n136\t    (lv14, lvReg, lvAr5)\n137\t\n138\t/-- The trace of legitimate uses from the initial state, each step admitted by `Encap5R`. -/\n139\ttheorem lv_steps : Steps5R KL L0\n140\t    [(lv0, [], []), (lv1, [], []), (lv2, [], []), (lv2, lvReg, []), (lv3, lvReg, []),\n141\t      (lv4, lvReg, []), (lv4, lvReg, lvAr), (lv5, lvReg, lvAr5), (lv6, lvReg, lvAr5),\n142\t      (lv7, lvReg, lvAr5), (lv8, lvReg, lvAr5), (lv9, lvReg, lvAr5), (lv10, lvReg, lvAr5),\n143\t      (lv11, lvReg, lvAr5), (lv12, lvReg, lvAr5), (lv13, lvReg, lvAr5), (lv14, lvReg, lvAr5)]\n144\t    lvLbls :=\n145\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n146\t  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n147\t  .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|\n148\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n149\t  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n150\t  .cons (by decide) (.newArena ⟨by decide, .ok (by decide)⟩) <|\n151\t  .cons (by decide) (.reset ⟨by decide, _, .ok rfl (.ok (by decide)) (.ok (by decide)) (by decide),\n152\t    rfl⟩) <|\n153\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n154\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n155\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n156\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n157\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n158\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n159\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide) trivial, rfl⟩) <|\n160\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n161\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n162\t\n163\t/-- Brief of slice 3, task 3: the trace of legitimate uses is a `RunFull` from the initial state,\n164\tand entry `e` is live before each step from `derive(root_ST0)` on: `derive`, `store`, `newArena`,\n165\t`reset`, `split`, `read3`, `writeShared`, `release`, `pin`, `unpin`, `alloc`, `free`, `endUse`\n166\tare `ok` and admitted under a live entry, their rights resting on root authorities of `f0` or on\n167\tthe split block (WC5.2 C22 item 6: another valid chain suffices). -/\n168\ttheorem lv_full : lvσ 0 = (SC.ofS3 (S3.init lvst), [], []) ∧ RunFull KL L0 lvσ lvLbls ∧\n169\t    ∀ i, 3 ≤ i → i < lvLbls.length → LiveAt (lvσ i) := by\n170\t  refine ⟨rfl, runFull_of_run7 (run7_of_run5R (lv_steps.run _) (by decide)) (by decide), ?_⟩\n171\t  decide\n172\t\n173\tend Ern.Concurrency.FullEncap.NonRegression"}]}}
