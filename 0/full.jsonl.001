{"parentUuid":"c5664f6f-31e4-4245-955b-110d5a5bb2b4","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BdtHTZQENukdMQzjSctQus","type":"tool_result","content":"3690\t      rw [this, hq] at hpl; cases hpl; rw [ho] at ho'; cases ho'\n3691\t\n3692\t/-- Place `q` belongs to frame `f` through ownership (A5): it is owned by `f`, or by a place that\n3693\tbelongs to `f`. -/\n3694\tinductive OwnedByFrame (P : List Place) (f : Nat) : Nat → Prop where\n3695\t  | frame {q : Nat} {pl : Place} : P[q]? = some pl → pl.owner = .frame f → OwnedByFrame P f q\n3696\t  | place {q o : Nat} {pl : Place} : P[q]? = some pl → pl.owner = .place o → OwnedByFrame P f o →\n3697\t      OwnedByFrame P f q\n3698\t\n3699\t/-- After the exit, no place that belongs to the exited frame through ownership is usable\n3700\t(MM-03.3.1; MM-03.3 §4, O7; A5): the locals of the frame and their owned storage, transitively. -/\n3701\ttheorem exitFrame_kills_owned {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s) (hinv : Inv3base s)\n3702\t    (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n3703\t    ∀ q, OwnedByFrame s.P f q → ¬ s'.Usable q := by\n3704\t  have hk := (exitFrame_kills_locals hwf hinv hF h).2.1\n3705\t  have hP : s'.P = s.P := by obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h; rw [exitEff_eq hF]\n3706\t  intro q hq\n3707\t  induction hq with\n3708\t  | @frame q pl hpl ho => exact hk q pl hpl ho\n3709\t  | @place q o pl hpl ho _ ih =>\n3710\t    intro hu\n3711\t    cases hu with\n3712\t    | frame hpl' _ ho' _ => rw [hP, hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'\n3713\t    | place hpl' _ ho' hU =>\n3714\t      rw [hP, hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'; exact ih hU\n3715\t\n3716\t/-- `exitFrame_reanchors_to_origin` (MM-03.3.7; A7): every anchor of a place usable after the\n3717\texit is replaced by the first surviving authority among itself and its ancestors along `origin`,\n3718\twhich is valid after the exit. -/\n3719\ttheorem exitFrame_reanchors_to_origin {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s)\n3720\t    (hinv : Inv3base s) (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n3721\t    ∀ q, s'.Usable q → ∀ x ∈ s.D q, ∃ z, firstSurv s F₀ (x :: s.ancs x) = some z ∧\n3722\t      (z = x ∨ z ∈ s.ancs x) ∧ z ∈ s'.D q ∧ s'.Active z := by\n3723\t  have hp := exit_preserves hwf hinv h\n3724\t  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n3725\t  unfold ExitPre at hpre; rw [hF] at hpre\n3726\t  obtain ⟨-, hR1, -⟩ := hpre\n3727\t  have e := exitEff_eq hF\n3728\t  intro q hq x hx\n3729\t  have hq₁ : ({ s with F := F₀ } : S3).Usable q :=\n3730\t    (S3.Usable.congr (s := ({ s with F := F₀ } : S3)) (by rw [e]) (by rw [e]) (by rw [e])).1 hq\n3731\t  have hne := hR1 q (List.mem_range.2 hq₁.lt) hq₁ x hx\n3732\t  cases hz : firstSurv s F₀ (x :: s.ancs x) with\n3733\t  | none => exact absurd hz hne\n3734\t  | some z =>\n3735\t    have hmem : z ∈ (exitEff s).D q := by\n3736\t      rw [e]; exact List.mem_map.2 ⟨x, hx, by simp [hz]⟩\n3737\t    refine ⟨z, rfl, ?_, hmem, hp.2.2.2.1 q hq z hmem⟩\n3738\t    exact List.mem_cons.1 (firstSurv_some hz).1\n3739\t\n3740\t/-- `dependent_cannot_escape_frame` (MM-03.3.6; MM-03.3 §4, O7.3; §10): after the exit, every\n3741\tanchor of a usable place is active and held by a live holder, so by no authority of the exited\n3742\tframe. -/\n3743\ttheorem dependent_cannot_escape_frame {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s)\n3744\t    (hinv : Inv3base s) (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n3745\t    ∀ q, s'.Usable q → ∀ x ∈ s'.D q, ∃ y, s'.A[x]? = some y ∧ y.active = true ∧\n3746\t      HolderLive s' y.holder ∧ y.holder ≠ .frame f := by\n3747\t  intro q hq x hx\n3748\t  obtain ⟨y, hy, ya⟩ := (exit_preserves hwf hinv h).2.2.2.1 q hq x hx\n3749\t  exact ⟨y, hy, ya, exitFrame_releases_all hwf.nodup hF h x y hy ya⟩\n3750\t\n3751\t/-! ## Release of authorities whose holder died (A4, A5, A6) -/\n3752\t\n3753\t/-- Releases every authority whose holder is no longer live (A4, A5): its value has ended or its\n3754\tstorage is dead. -/\n3755\tdef cleanup (s : S3) : S3 :=\n3756\t  { s with A := s.A.map fun y => if HolderLive s y.holder then y else { y with active := false } }\n3757\t\n3758\t/-- The authorities of `s₁` are those of `s`, some of them released. -/\n3759\tdef OnlyReleases (s s₁ : S3) : Prop :=\n3760\t  s₁.A.length = s.A.length ∧ ∀ (j : Nat) (z : Authority), s₁.A[j]? = some z →\n3761\t    ∃ y, s.A[j]? = some y ∧ z.mode = y.mode ∧ z.origin = y.origin ∧ z.footprint = y.footprint ∧\n3762\t      z.holder = y.holder ∧ (z.active = true → y.active = true)\n3763\t\n3764\ttheorem OnlyReleases.org {s s₁ : S3} (h : OnlyReleases s s₁) : s₁.org = s.org := by\n3765\t  funext j; simp only [S3.org]\n3766\t  cases hz : s₁.A[j]? with\n3767\t  | none =>\n3768\t    have : s.A.length ≤ j := by have := List.getElem?_eq_none_iff.1 hz; rw [h.1] at this; exact this\n3769\t    rw [List.getElem?_eq_none_iff.2 this]"}]},"uuid":"951cd755-846c-4afd-9528-62f330a04620","timestamp":"2026-10-31T19:09:39.403Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","content":"      rw [this, hq] at hpl; cases hpl; rw [ho] at ho'; cases ho'\n\n/-- Place `q` belongs to frame `f` through ownership (A5): it is owned by `f`, or by a place that\nbelongs to `f`. -/\ninductive OwnedByFrame (P : List Place) (f : Nat) : Nat → Prop where\n  | frame {q : Nat} {pl : Place} : P[q]? = some pl → pl.owner = .frame f → OwnedByFrame P f q\n  | place {q o : Nat} {pl : Place} : P[q]? = some pl → pl.owner = .place o → OwnedByFrame P f o →\n      OwnedByFrame P f q\n\n/-- After the exit, no place that belongs to the exited frame through ownership is usable\n(MM-03.3.1; MM-03.3 §4, O7; A5): the locals of the frame and their owned storage, transitively. -/\ntheorem exitFrame_kills_owned {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s) (hinv : Inv3base s)\n    (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n    ∀ q, OwnedByFrame s.P f q → ¬ s'.Usable q := by\n  have hk := (exitFrame_kills_locals hwf hinv hF h).2.1\n  have hP : s'.P = s.P := by obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h; rw [exitEff_eq hF]\n  intro q hq\n  induction hq with\n  | @frame q pl hpl ho => exact hk q pl hpl ho\n  | @place q o pl hpl ho _ ih =>\n    intro hu\n    cases hu with\n    | frame hpl' _ ho' _ => rw [hP, hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'\n    | place hpl' _ ho' hU =>\n      rw [hP, hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'; exact ih hU\n\n/-- `exitFrame_reanchors_to_origin` (MM-03.3.7; A7): every anchor of a place usable after the\nexit is replaced by the first surviving authority among itself and its ancestors along `origin`,\nwhich is valid after the exit. -/\ntheorem exitFrame_reanchors_to_origin {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s)\n    (hinv : Inv3base s) (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n    ∀ q, s'.Usable q → ∀ x ∈ s.D q, ∃ z, firstSurv s F₀ (x :: s.ancs x) = some z ∧\n      (z = x ∨ z ∈ s.ancs x) ∧ z ∈ s'.D q ∧ s'.Active z := by\n  have hp := exit_preserves hwf hinv h\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  unfold ExitPre at hpre; rw [hF] at hpre\n  obtain ⟨-, hR1, -⟩ := hpre\n  have e := exitEff_eq hF\n  intro q hq x hx\n  have hq₁ : ({ s with F := F₀ } : S3).Usable q :=\n    (S3.Usable.congr (s := ({ s with F := F₀ } : S3)) (by rw [e]) (by rw [e]) (by rw [e])).1 hq\n  have hne := hR1 q (List.mem_range.2 hq₁.lt) hq₁ x hx\n  cases hz : firstSurv s F₀ (x :: s.ancs x) with\n  | none => exact absurd hz hne\n  | some z =>\n    have hmem : z ∈ (exitEff s).D q := by\n      rw [e]; exact List.mem_map.2 ⟨x, hx, by simp [hz]⟩\n    refine ⟨z, rfl, ?_, hmem, hp.2.2.2.1 q hq z hmem⟩\n    exact List.mem_cons.1 (firstSurv_some hz).1\n\n/-- `dependent_cannot_escape_frame` (MM-03.3.6; MM-03.3 §4, O7.3; §10): after the exit, every\nanchor of a usable place is active and held by a live holder, so by no authority of the exited\nframe. -/\ntheorem dependent_cannot_escape_frame {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s)\n    (hinv : Inv3base s) (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n    ∀ q, s'.Usable q → ∀ x ∈ s'.D q, ∃ y, s'.A[x]? = some y ∧ y.active = true ∧\n      HolderLive s' y.holder ∧ y.holder ≠ .frame f := by\n  intro q hq x hx\n  obtain ⟨y, hy, ya⟩ := (exit_preserves hwf hinv h).2.2.2.1 q hq x hx\n  exact ⟨y, hy, ya, exitFrame_releases_all hwf.nodup hF h x y hy ya⟩\n\n/-! ## Release of authorities whose holder died (A4, A5, A6) -/\n\n/-- Releases every authority whose holder is no longer live (A4, A5): its value has ended or its\nstorage is dead. -/\ndef cleanup (s : S3) : S3 :=\n  { s with A := s.A.map fun y => if HolderLive s y.holder then y else { y with active := false } }\n\n/-- The authorities of `s₁` are those of `s`, some of them released. -/\ndef OnlyReleases (s s₁ : S3) : Prop :=\n  s₁.A.length = s.A.length ∧ ∀ (j : Nat) (z : Authority), s₁.A[j]? = some z →\n    ∃ y, s.A[j]? = some y ∧ z.mode = y.mode ∧ z.origin = y.origin ∧ z.footprint = y.footprint ∧\n      z.holder = y.holder ∧ (z.active = true → y.active = true)\n\ntheorem OnlyReleases.org {s s₁ : S3} (h : OnlyReleases s s₁) : s₁.org = s.org := by\n  funext j; simp only [S3.org]\n  cases hz : s₁.A[j]? with\n  | none =>\n    have : s.A.length ≤ j := by have := List.getElem?_eq_none_iff.1 hz; rw [h.1] at this; exact this\n    rw [List.getElem?_eq_none_iff.2 this]","numLines":80,"startLine":3690,"totalLines":11961}},"sourceToolAssistantUUID":"c5664f6f-31e4-4245-955b-110d5a5bb2b4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"951cd755-846c-4afd-9528-62f330a04620","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgaqpDcu5gfF8rTgL72PE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WM9kPbkjfuiCfTs11Cz8iC","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":3866,"limit":160},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4904,"cache_read_input_tokens":207492,"output_tokens":297,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4904,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":297,"cache_read_input_tokens":207492,"cache_creation_input_tokens":4904,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4904},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01WM9kPbkjfuiCfTs11Cz8iC":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":3866,"limit":160}},"serverClassifierRequest":"29386a5e-96ae-4d02-9469-133e803cae0b","apiBlockIndex":2,"requestId":"req_011CgaqpDFKY6BAqbDPQRS89","requestRef":"9b66d0ab-3bcb-4d0e-8a80-9b1748b2d2af","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"600b21a6-cc2d-4af9-9674-ab5618c62985","timestamp":"2026-10-31T19:09:40.278Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"600b21a6-cc2d-4af9-9674-ab5618c62985","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WM9kPbkjfuiCfTs11Cz8iC","type":"tool_result","content":"3866\t/-! ## `writeShared` (A9) -/\n3867\t\n3868\t/-- Preconditions of `writeShared` (A9), the only mutation permitted from an `Observe`\n3869\tauthority: `a` exercisable at `Observe`, the mode it requests (B2); on each leaf, a present\n3870\teffective mode of `a`, a\n3871\t`SharedMutable` leaf (MM-03.3.8), valid dependencies. -/\n3872\tdef WriteSharedPre (k : K) (s : S3) (a : Nat) (ls : List Nat) : Prop :=\n3873\t  s.ExercisableAt a .observe ∧ ∀ p ∈ ls, effective s a p ≠ none ∧ k.SharedMutable p ∧ DepsValid s p\n3874\t\n3875\tinstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (a : Nat) (ls : List Nat) :\n3876\t    Decidable (WriteSharedPre k s a ls) := by\n3877\t  unfold WriteSharedPre; infer_instance\n3878\t\n3879\t/-- `writeShared` as a relation (A9): written leaves become `Init`; no authority changes. -/\n3880\tdef WriteSharedStep (k : K) (a : Nat) (ls : List Nat) (s : S3) : Outcome3 S3 → Prop :=\n3881\t  Guarded (WriteSharedPre k s a ls) (write3Eff s ls)\n3882\t\n3883\t/-- `writeShared_only_shared` (A9): a shared write only touches `SharedMutable` leaves. -/\n3884\ttheorem writeShared_only_shared {k : K} {s s' : S3} {a : Nat} {ls : List Nat}\n3885\t    (h : WriteSharedStep k a ls s (.ok s')) : ∀ p ∈ ls, k.SharedMutable p :=\n3886\t  fun p hp => ((Guarded.ok_iff.1 h).1.2 p hp).2.1\n3887\t\n3888\t/-- `writeShared` preserves `WF3` and `Inv3base` (A9: it does not weaken I1). -/\n3889\ttheorem writeShared_preserves {k : K} {s s' : S3} {a : Nat} {ls : List Nat} (hwf : WF3 s)\n3890\t    (hinv : Inv3base s) (h : WriteSharedStep k a ls s (.ok s')) : WF3 s' ∧ Inv3base s' := by\n3891\t  obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n3892\t  exact ⟨hwf.of_eq rfl rfl rfl rfl rfl, hinv.1, hinv.2.1, fun q hq x hx =>\n3893\t    hinv.2.2.1 q ((S3.Usable.congr (s := s) (s' := write3Eff s ls) rfl rfl rfl).1 hq) x hx,\n3894\t    i4_always _⟩\n3895\t\n3896\t/-! ## Dynamic pinning (A8) -/\n3897\t\n3898\t/-- Preconditions of `pin p` (A8): `p` usable, exercisable `Modify` on `p` (B2; `Modify` for\n3899\t`pin`, B10). -/\n3900\tdef PinPre (s : S3) (p : Nat) : Prop := s.Usable p ∧ HasRight s .modify p\n3901\t\n3902\tinstance (s : S3) (p : Nat) : Decidable (PinPre s p) := by unfold PinPre; infer_instance\n3903\t\n3904\t/-- Effect of `pin p` / `unpin p` (A8): the leaves of `p` become pinned or unpinned. -/\n3905\tdef pinEff (s : S3) (p : Nat) (b : Bool) : S3 :=\n3906\t  { s with pin := fun l => if l ∈ footprint s.P p then b else s.pin l }\n3907\t\n3908\t/-- `pin` as a relation (A8). -/\n3909\tdef PinStep (p : Nat) (s : S3) : Outcome3 S3 → Prop := Guarded (PinPre s p) (pinEff s p true)\n3910\t\n3911\t/-- Preconditions of `unpin p` (A8): the external use of every leaf of `p` is done\n3912\t(`ExternalDone`, MM-03.3.8); B3: the right of `pin`, exercisable `Modify` on `p`. -/\n3913\tdef UnpinPre (k : K) (s : S3) (p : Nat) : Prop :=\n3914\t  (∀ l ∈ footprint s.P p, k.ExternalDone l) ∧ HasRight s .modify p\n3915\t\n3916\tinstance (k : K) [DecidablePred k.ExternalDone] (s : S3) (p : Nat) :\n3917\t    Decidable (UnpinPre k s p) := by\n3918\t  unfold UnpinPre; infer_instance\n3919\t\n3920\t/-- `unpin` as a relation (A8). -/\n3921\tdef UnpinStep (k : K) (p : Nat) (s : S3) : Outcome3 S3 → Prop :=\n3922\t  Guarded (UnpinPre k s p) (pinEff s p false)\n3923\t\n3924\t/-- Pinning changes neither authorities nor places: `WF3` and `Inv3base` are preserved (A8). -/\n3925\ttheorem pinEff_preserves {s : S3} {p : Nat} {b : Bool} (hwf : WF3 s) (hinv : Inv3base s) :\n3926\t    WF3 (pinEff s p b) ∧ Inv3base (pinEff s p b) :=\n3927\t  ⟨hwf.of_eq rfl rfl rfl rfl rfl, hinv.1, hinv.2.1, fun q hq x hx =>\n3928\t    hinv.2.2.1 q ((S3.Usable.congr (s := s) (s' := pinEff s p b) rfl rfl rfl).1 hq) x hx,\n3929\t    i4_always _⟩\n3930\t\n3931\t/-! ## `endUse` (A6) -/\n3932\t\n3933\t/-- The value at `p` ends (A6), before releasing authorities whose holder died: the leaves of\n3934\t`p` become `Uninit`; the authorities held by `p` or one of its parts are released; the anchors\n3935\tof `p` and its parts are removed; the places owned by `p` or one of its parts are logically\n3936\tdead. -/\n3937\tdef endUseS (s : S3) (p : Nat) : S3 :=\n3938\t  { s with\n3939\t    I := fun l => if l ∈ footprint s.P p then .uninit else s.I l\n3940\t    D := fun q => if partOf s.P q p then [] else s.D q\n3941\t    dead := fun q => s.dead q || match s.P[q]? with\n3942\t      | some pl => decide (heldIn s.P p pl.owner)\n3943\t      | none => false\n3944\t    A := s.A.map fun y => if heldIn s.P p y.holder then { y with active := false } else y }\n3945\t\n3946\t/-- Effect of `endUse p` (A6): `endUseS`, then the authorities whose holder died are released.\n3947\tNo storage is released: `freed` is unchanged. -/\n3948\tdef endUseEff (s : S3) (p : Nat) : S3 := cleanup (endUseS s p)\n3949\t\n3950\t/-- Leaves that end with the value at `p` (A6): those of `p`, and those of places that stop\n3951\tbeing usable. -/\n3952\tdef EndingLeaf (s : S3) (p l : Nat) : Prop :=\n3953\t  l ∈ footprint s.P p ∨ (s.Usable l ∧ ¬ (endUseS s p).Usable l)\n3954\t\n3955\tinstance (s : S3) (p l : Nat) : Decidable (EndingLeaf s p l) := by\n3956\t  unfold EndingLeaf; infer_instance\n3957\t\n3958\t/-- Root of the value at `p` (A6, pass-1 arbitrage 2): an authority without origin covering a\n3959\tleaf of `p`. -/\n3960\tdef IsRootOf (s : S3) (p : Nat) (y : Authority) : Prop :=\n3961\t  y.origin = none ∧ ∃ l ∈ footprint s.P p, l ∈ y.footprint\n3962\t\n3963\tinstance (s : S3) (p : Nat) (y : Authority) : Decidable (IsRootOf s p y) := by\n3964\t  unfold IsRootOf; infer_instance\n3965\t\n3966\t/-- Authority `a` is released by the end of the value at `p` (A4, A6): it is active, and held\n3967\twithin `p` (released by `endUseS`) or by a holder that is not live after `endUseS` (released by\n3968\t`cleanup`). Under the possession clause of `WF3`, that holder dies with `p`. -/\n3969\tdef EndUseReleased (s : S3) (p a : Nat) : Prop :=\n3970\t  OptP (s.A[a]?) (fun z => z.active = true ∧\n3971\t    (heldIn s.P p z.holder ∨ ¬ HolderLive (endUseS s p) z.holder)) False\n3972\t\n3973\tinstance (s : S3) (p a : Nat) : Decidable (EndUseReleased s p a) := by\n3974\t  unfold EndUseReleased; infer_instance\n3975\t\n3976\t/-- Authority `j` does not block the end of the value at `p` (A6): if it is an active derived\n3977\tauthority on an ending leaf, or descending from an authority that the end releases\n3978\t(MM-03.3 §3, O3.2), it is held within `p` or its holder dies. -/\n3979\tdef EndUseAccessOK (s : S3) (p j : Nat) : Prop :=\n3980\t  OptP (s.A[j]?) (fun y => y.active = true → y.origin ≠ none →\n3981\t    ((∃ l ∈ y.footprint, EndingLeaf s p l) ∨ ∃ a ∈ s.ancs j, EndUseReleased s p a) →\n3982\t      heldIn s.P p y.holder ∨ ¬ HolderLive (endUseS s p) y.holder) True\n3983\t\n3984\tinstance (s : S3) (p j : Nat) : Decidable (EndUseAccessOK s p j) := by\n3985\t  unfold EndUseAccessOK OptP; split <;> infer_instance\n3986\t\n3987\t/-- Anchor `x` survives the end of the value at `p` (A6): not held within `p`, not the root of\n3988\t`p`, with a holder that stays live. -/\n3989\tdef EndUseAnchorOK (s : S3) (p x : Nat) : Prop :=\n3990\t  OptP (s.A[x]?) (fun y => ¬ heldIn s.P p y.holder ∧ ¬ IsRootOf s p y ∧\n3991\t    HolderLive (endUseS s p) y.holder) True\n3992\t\n3993\tinstance (s : S3) (p x : Nat) : Decidable (EndUseAnchorOK s p x) := by\n3994\t  unfold EndUseAnchorOK OptP; split <;> infer_instance\n3995\t\n3996\t/-- Preconditions of `endUse p` (A6). Usability of the anchored places is read after the end:\n3997\ta place that dies with `p` has no usable dependent afterwards. In order: `p` usable;\n3998\texercisable `Modify` on `p` (A2);\n3999\tno active derived authority on an ending leaf, or descending from an authority that the end\n4000\treleases (MM-03.3 §3, O3.2), held elsewhere than in `p` and staying live; no\n4001\tusable place anchored on an authority held by `p`, on its root, or held by a holder that dies;\n4002\tC5: no ending leaf pinned, dynamically (A8) or statically (`Pinned`), whatever `ExternalDone`\n4003\tsays: external obligations end only through `unpin`. The ending leaves include those of the\n4004\towned places, which die (A6). C8: `p` itself stays usable, its leaves `Uninit`. -/\n4005\tdef EndUsePre (k : K) (s : S3) (p : Nat) : Prop :=\n4006\t  s.Usable p ∧ HasRight s .modify p ∧\n4007\t  (∀ j ∈ List.range s.A.length, EndUseAccessOK s p j) ∧\n4008\t  (∀ q ∈ List.range s.P.length, (endUseS s p).Usable q → ∀ x ∈ (endUseS s p).D q,\n4009\t    EndUseAnchorOK s p x) ∧\n4010\t  (∀ l ∈ List.range s.P.length, EndingLeaf s p l → s.pin l = false ∧ ¬ k.Pinned l)\n4011\t\n4012\tinstance (k : K) [DecidablePred k.Pinned] (s : S3) (p : Nat) :\n4013\t    Decidable (EndUsePre k s p) := by\n4014\t  unfold EndUsePre; infer_instance\n4015\t\n4016\t/-- `endUse` as a relation (A6). -/\n4017\tdef EndUseStep (k : K) (p : Nat) (s : S3) : Outcome3 S3 → Prop :=\n4018\t  Guarded (EndUsePre k s p) (endUseEff s p)\n4019\t\n4020\ttheorem endUseS_releases (s : S3) (p : Nat) : OnlyReleases s (endUseS s p) := by\n4021\t  refine ⟨by simp [endUseS], fun j z hz => ?_⟩\n4022\t  simp only [endUseS, List.getElem?_map] at hz\n4023\t  cases hy : s.A[j]? with\n4024\t  | none => rw [hy] at hz; cases hz\n4025\t  | some y =>"}]},"uuid":"bec908c6-ece2-4877-bfaf-8936d53fe876","timestamp":"2026-10-31T19:09:40.306Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","content":"/-! ## `writeShared` (A9) -/\n\n/-- Preconditions of `writeShared` (A9), the only mutation permitted from an `Observe`\nauthority: `a` exercisable at `Observe`, the mode it requests (B2); on each leaf, a present\neffective mode of `a`, a\n`SharedMutable` leaf (MM-03.3.8), valid dependencies. -/\ndef WriteSharedPre (k : K) (s : S3) (a : Nat) (ls : List Nat) : Prop :=\n  s.ExercisableAt a .observe ∧ ∀ p ∈ ls, effective s a p ≠ none ∧ k.SharedMutable p ∧ DepsValid s p\n\ninstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (a : Nat) (ls : List Nat) :\n    Decidable (WriteSharedPre k s a ls) := by\n  unfold WriteSharedPre; infer_instance\n\n/-- `writeShared` as a relation (A9): written leaves become `Init`; no authority changes. -/\ndef WriteSharedStep (k : K) (a : Nat) (ls : List Nat) (s : S3) : Outcome3 S3 → Prop :=\n  Guarded (WriteSharedPre k s a ls) (write3Eff s ls)\n\n/-- `writeShared_only_shared` (A9): a shared write only touches `SharedMutable` leaves. -/\ntheorem writeShared_only_shared {k : K} {s s' : S3} {a : Nat} {ls : List Nat}\n    (h : WriteSharedStep k a ls s (.ok s')) : ∀ p ∈ ls, k.SharedMutable p :=\n  fun p hp => ((Guarded.ok_iff.1 h).1.2 p hp).2.1\n\n/-- `writeShared` preserves `WF3` and `Inv3base` (A9: it does not weaken I1). -/\ntheorem writeShared_preserves {k : K} {s s' : S3} {a : Nat} {ls : List Nat} (hwf : WF3 s)\n    (hinv : Inv3base s) (h : WriteSharedStep k a ls s (.ok s')) : WF3 s' ∧ Inv3base s' := by\n  obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n  exact ⟨hwf.of_eq rfl rfl rfl rfl rfl, hinv.1, hinv.2.1, fun q hq x hx =>\n    hinv.2.2.1 q ((S3.Usable.congr (s := s) (s' := write3Eff s ls) rfl rfl rfl).1 hq) x hx,\n    i4_always _⟩\n\n/-! ## Dynamic pinning (A8) -/\n\n/-- Preconditions of `pin p` (A8): `p` usable, exercisable `Modify` on `p` (B2; `Modify` for\n`pin`, B10). -/\ndef PinPre (s : S3) (p : Nat) : Prop := s.Usable p ∧ HasRight s .modify p\n\ninstance (s : S3) (p : Nat) : Decidable (PinPre s p) := by unfold PinPre; infer_instance\n\n/-- Effect of `pin p` / `unpin p` (A8): the leaves of `p` become pinned or unpinned. -/\ndef pinEff (s : S3) (p : Nat) (b : Bool) : S3 :=\n  { s with pin := fun l => if l ∈ footprint s.P p then b else s.pin l }\n\n/-- `pin` as a relation (A8). -/\ndef PinStep (p : Nat) (s : S3) : Outcome3 S3 → Prop := Guarded (PinPre s p) (pinEff s p true)\n\n/-- Preconditions of `unpin p` (A8): the external use of every leaf of `p` is done\n(`ExternalDone`, MM-03.3.8); B3: the right of `pin`, exercisable `Modify` on `p`. -/\ndef UnpinPre (k : K) (s : S3) (p : Nat) : Prop :=\n  (∀ l ∈ footprint s.P p, k.ExternalDone l) ∧ HasRight s .modify p\n\ninstance (k : K) [DecidablePred k.ExternalDone] (s : S3) (p : Nat) :\n    Decidable (UnpinPre k s p) := by\n  unfold UnpinPre; infer_instance\n\n/-- `unpin` as a relation (A8). -/\ndef UnpinStep (k : K) (p : Nat) (s : S3) : Outcome3 S3 → Prop :=\n  Guarded (UnpinPre k s p) (pinEff s p false)\n\n/-- Pinning changes neither authorities nor places: `WF3` and `Inv3base` are preserved (A8). -/\ntheorem pinEff_preserves {s : S3} {p : Nat} {b : Bool} (hwf : WF3 s) (hinv : Inv3base s) :\n    WF3 (pinEff s p b) ∧ Inv3base (pinEff s p b) :=\n  ⟨hwf.of_eq rfl rfl rfl rfl rfl, hinv.1, hinv.2.1, fun q hq x hx =>\n    hinv.2.2.1 q ((S3.Usable.congr (s := s) (s' := pinEff s p b) rfl rfl rfl).1 hq) x hx,\n    i4_always _⟩\n\n/-! ## `endUse` (A6) -/\n\n/-- The value at `p` ends (A6), before releasing authorities whose holder died: the leaves of\n`p` become `Uninit`; the authorities held by `p` or one of its parts are released; the anchors\nof `p` and its parts are removed; the places owned by `p` or one of its parts are logically\ndead. -/\ndef endUseS (s : S3) (p : Nat) : S3 :=\n  { s with\n    I := fun l => if l ∈ footprint s.P p then .uninit else s.I l\n    D := fun q => if partOf s.P q p then [] else s.D q\n    dead := fun q => s.dead q || match s.P[q]? with\n      | some pl => decide (heldIn s.P p pl.owner)\n      | none => false\n    A := s.A.map fun y => if heldIn s.P p y.holder then { y with active := false } else y }\n\n/-- Effect of `endUse p` (A6): `endUseS`, then the authorities whose holder died are released.\nNo storage is released: `freed` is unchanged. -/\ndef endUseEff (s : S3) (p : Nat) : S3 := cleanup (endUseS s p)\n\n/-- Leaves that end with the value at `p` (A6): those of `p`, and those of places that stop\nbeing usable. -/\ndef EndingLeaf (s : S3) (p l : Nat) : Prop :=\n  l ∈ footprint s.P p ∨ (s.Usable l ∧ ¬ (endUseS s p).Usable l)\n\ninstance (s : S3) (p l : Nat) : Decidable (EndingLeaf s p l) := by\n  unfold EndingLeaf; infer_instance\n\n/-- Root of the value at `p` (A6, pass-1 arbitrage 2): an authority without origin covering a\nleaf of `p`. -/\ndef IsRootOf (s : S3) (p : Nat) (y : Authority) : Prop :=\n  y.origin = none ∧ ∃ l ∈ footprint s.P p, l ∈ y.footprint\n\ninstance (s : S3) (p : Nat) (y : Authority) : Decidable (IsRootOf s p y) := by\n  unfold IsRootOf; infer_instance\n\n/-- Authority `a` is released by the end of the value at `p` (A4, A6): it is active, and held\nwithin `p` (released by `endUseS`) or by a holder that is not live after `endUseS` (released by\n`cleanup`). Under the possession clause of `WF3`, that holder dies with `p`. -/\ndef EndUseReleased (s : S3) (p a : Nat) : Prop :=\n  OptP (s.A[a]?) (fun z => z.active = true ∧\n    (heldIn s.P p z.holder ∨ ¬ HolderLive (endUseS s p) z.holder)) False\n\ninstance (s : S3) (p a : Nat) : Decidable (EndUseReleased s p a) := by\n  unfold EndUseReleased; infer_instance\n\n/-- Authority `j` does not block the end of the value at `p` (A6): if it is an active derived\nauthority on an ending leaf, or descending from an authority that the end releases\n(MM-03.3 §3, O3.2), it is held within `p` or its holder dies. -/\ndef EndUseAccessOK (s : S3) (p j : Nat) : Prop :=\n  OptP (s.A[j]?) (fun y => y.active = true → y.origin ≠ none →\n    ((∃ l ∈ y.footprint, EndingLeaf s p l) ∨ ∃ a ∈ s.ancs j, EndUseReleased s p a) →\n      heldIn s.P p y.holder ∨ ¬ HolderLive (endUseS s p) y.holder) True\n\ninstance (s : S3) (p j : Nat) : Decidable (EndUseAccessOK s p j) := by\n  unfold EndUseAccessOK OptP; split <;> infer_instance\n\n/-- Anchor `x` survives the end of the value at `p` (A6): not held within `p`, not the root of\n`p`, with a holder that stays live. -/\ndef EndUseAnchorOK (s : S3) (p x : Nat) : Prop :=\n  OptP (s.A[x]?) (fun y => ¬ heldIn s.P p y.holder ∧ ¬ IsRootOf s p y ∧\n    HolderLive (endUseS s p) y.holder) True\n\ninstance (s : S3) (p x : Nat) : Decidable (EndUseAnchorOK s p x) := by\n  unfold EndUseAnchorOK OptP; split <;> infer_instance\n\n/-- Preconditions of `endUse p` (A6). Usability of the anchored places is read after the end:\na place that dies with `p` has no usable dependent afterwards. In order: `p` usable;\nexercisable `Modify` on `p` (A2);\nno active derived authority on an ending leaf, or descending from an authority that the end\nreleases (MM-03.3 §3, O3.2), held elsewhere than in `p` and staying live; no\nusable place anchored on an authority held by `p`, on its root, or held by a holder that dies;\nC5: no ending leaf pinned, dynamically (A8) or statically (`Pinned`), whatever `ExternalDone`\nsays: external obligations end only through `unpin`. The ending leaves include those of the\nowned places, which die (A6). C8: `p` itself stays usable, its leaves `Uninit`. -/\ndef EndUsePre (k : K) (s : S3) (p : Nat) : Prop :=\n  s.Usable p ∧ HasRight s .modify p ∧\n  (∀ j ∈ List.range s.A.length, EndUseAccessOK s p j) ∧\n  (∀ q ∈ List.range s.P.length, (endUseS s p).Usable q → ∀ x ∈ (endUseS s p).D q,\n    EndUseAnchorOK s p x) ∧\n  (∀ l ∈ List.range s.P.length, EndingLeaf s p l → s.pin l = false ∧ ¬ k.Pinned l)\n\ninstance (k : K) [DecidablePred k.Pinned] (s : S3) (p : Nat) :\n    Decidable (EndUsePre k s p) := by\n  unfold EndUsePre; infer_instance\n\n/-- `endUse` as a relation (A6). -/\ndef EndUseStep (k : K) (p : Nat) (s : S3) : Outcome3 S3 → Prop :=\n  Guarded (EndUsePre k s p) (endUseEff s p)\n\ntheorem endUseS_releases (s : S3) (p : Nat) : OnlyReleases s (endUseS s p) := by\n  refine ⟨by simp [endUseS], fun j z hz => ?_⟩\n  simp only [endUseS, List.getElem?_map] at hz\n  cases hy : s.A[j]? with\n  | none => rw [hy] at hz; cases hz\n  | some y =>","numLines":160,"startLine":3866,"totalLines":11961}},"sourceToolAssistantUUID":"600b21a6-cc2d-4af9-9674-ab5618c62985","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"type":"api-request-blob","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","hash":"a1443a42c3e974c008bf3ad2d5ff4f1ea7370fc473f7b9b164c605cb3f771f90","message":{"role":"assistant","content":[{"type":"text","text":"Still reading the MM-03 draft: next are `endUse`, `free`, `alloc`, `S3.init` and `Reachable`."},{"type":"tool_use","id":"toolu_01BdtHTZQENukdMQzjSctQus","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":3690,"limit":80},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01WM9kPbkjfuiCfTs11Cz8iC","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":3866,"limit":160},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","hash":"d07d517088e8a36b4f596cd4d8028b38d4490bd52ebc2e030dc77135493f5531","message":{"role":"user","content":[{"tool_use_id":"toolu_01BdtHTZQENukdMQzjSctQus","type":"tool_result","content":"3690\t      rw [this, hq] at hpl; cases hpl; rw [ho] at ho'; cases ho'\n3691\t\n3692\t/-- Place `q` belongs to frame `f` through ownership (A5): it is owned by `f`, or by a place that\n3693\tbelongs to `f`. -/\n3694\tinductive OwnedByFrame (P : List Place) (f : Nat) : Nat → Prop where\n3695\t  | frame {q : Nat} {pl : Place} : P[q]? = some pl → pl.owner = .frame f → OwnedByFrame P f q\n3696\t  | place {q o : Nat} {pl : Place} : P[q]? = some pl → pl.owner = .place o → OwnedByFrame P f o →\n3697\t      OwnedByFrame P f q\n3698\t\n3699\t/-- After the exit, no place that belongs to the exited frame through ownership is usable\n3700\t(MM-03.3.1; MM-03.3 §4, O7; A5): the locals of the frame and their owned storage, transitively. -/\n3701\ttheorem exitFrame_kills_owned {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s) (hinv : Inv3base s)\n3702\t    (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n3703\t    ∀ q, OwnedByFrame s.P f q → ¬ s'.Usable q := by\n3704\t  have hk := (exitFrame_kills_locals hwf hinv hF h).2.1\n3705\t  have hP : s'.P = s.P := by obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h; rw [exitEff_eq hF]\n3706\t  intro q hq\n3707\t  induction hq with\n3708\t  | @frame q pl hpl ho => exact hk q pl hpl ho\n3709\t  | @place q o pl hpl ho _ ih =>\n3710\t    intro hu\n3711\t    cases hu with\n3712\t    | frame hpl' _ ho' _ => rw [hP, hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'\n3713\t    | place hpl' _ ho' hU =>\n3714\t      rw [hP, hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'; exact ih hU\n3715\t\n3716\t/-- `exitFrame_reanchors_to_origin` (MM-03.3.7; A7): every anchor of a place usable after the\n3717\texit is replaced by the first surviving authority among itself and its ancestors along `origin`,\n3718\twhich is valid after the exit. -/\n3719\ttheorem exitFrame_reanchors_to_origin {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s)\n3720\t    (hinv : Inv3base s) (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n3721\t    ∀ q, s'.Usable q → ∀ x ∈ s.D q, ∃ z, firstSurv s F₀ (x :: s.ancs x) = some z ∧\n3722\t      (z = x ∨ z ∈ s.ancs x) ∧ z ∈ s'.D q ∧ s'.Active z := by\n3723\t  have hp := exit_preserves hwf hinv h\n3724\t  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n3725\t  unfold ExitPre at hpre; rw [hF] at hpre\n3726\t  obtain ⟨-, hR1, -⟩ := hpre\n3727\t  have e := exitEff_eq hF\n3728\t  intro q hq x hx\n3729\t  have hq₁ : ({ s with F := F₀ } : S3).Usable q :=\n3730\t    (S3.Usable.congr (s := ({ s with F := F₀ } : S3)) (by rw [e]) (by rw [e]) (by rw [e])).1 hq\n3731\t  have hne := hR1 q (List.mem_range.2 hq₁.lt) hq₁ x hx\n3732\t  cases hz : firstSurv s F₀ (x :: s.ancs x) with\n3733\t  | none => exact absurd hz hne\n3734\t  | some z =>\n3735\t    have hmem : z ∈ (exitEff s).D q := by\n3736\t      rw [e]; exact List.mem_map.2 ⟨x, hx, by simp [hz]⟩\n3737\t    refine ⟨z, rfl, ?_, hmem, hp.2.2.2.1 q hq z hmem⟩\n3738\t    exact List.mem_cons.1 (firstSurv_some hz).1\n3739\t\n3740\t/-- `dependent_cannot_escape_frame` (MM-03.3.6; MM-03.3 §4, O7.3; §10): after the exit, every\n3741\tanchor of a usable place is active and held by a live holder, so by no authority of the exited\n3742\tframe. -/\n3743\ttheorem dependent_cannot_escape_frame {k : K} {s s' : S3} {f : Nat} {F₀ : Frames} (hwf : WF3 s)\n3744\t    (hinv : Inv3base s) (hF : s.F = f :: F₀) (h : ExitStep k s (.ok s')) :\n3745\t    ∀ q, s'.Usable q → ∀ x ∈ s'.D q, ∃ y, s'.A[x]? = some y ∧ y.active = true ∧\n3746\t      HolderLive s' y.holder ∧ y.holder ≠ .frame f := by\n3747\t  intro q hq x hx\n3748\t  obtain ⟨y, hy, ya⟩ := (exit_preserves hwf hinv h).2.2.2.1 q hq x hx\n3749\t  exact ⟨y, hy, ya, exitFrame_releases_all hwf.nodup hF h x y hy ya⟩\n3750\t\n3751\t/-! ## Release of authorities whose holder died (A4, A5, A6) -/\n3752\t\n3753\t/-- Releases every authority whose holder is no longer live (A4, A5): its value has ended or its\n3754\tstorage is dead. -/\n3755\tdef cleanup (s : S3) : S3 :=\n3756\t  { s with A := s.A.map fun y => if HolderLive s y.holder then y else { y with active := false } }\n3757\t\n3758\t/-- The authorities of `s₁` are those of `s`, some of them released. -/\n3759\tdef OnlyReleases (s s₁ : S3) : Prop :=\n3760\t  s₁.A.length = s.A.length ∧ ∀ (j : Nat) (z : Authority), s₁.A[j]? = some z →\n3761\t    ∃ y, s.A[j]? = some y ∧ z.mode = y.mode ∧ z.origin = y.origin ∧ z.footprint = y.footprint ∧\n3762\t      z.holder = y.holder ∧ (z.active = true → y.active = true)\n3763\t\n3764\ttheorem OnlyReleases.org {s s₁ : S3} (h : OnlyReleases s s₁) : s₁.org = s.org := by\n3765\t  funext j; simp only [S3.org]\n3766\t  cases hz : s₁.A[j]? with\n3767\t  | none =>\n3768\t    have : s.A.length ≤ j := by have := List.getElem?_eq_none_iff.1 hz; rw [h.1] at this; exact this\n3769\t    rw [List.getElem?_eq_none_iff.2 this]"},{"tool_use_id":"toolu_01WM9kPbkjfuiCfTs11Cz8iC","type":"tool_result","content":"3866\t/-! ## `writeShared` (A9) -/\n3867\t\n3868\t/-- Preconditions of `writeShared` (A9), the only mutation permitted from an `Observe`\n3869\tauthority: `a` exercisable at `Observe`, the mode it requests (B2); on each leaf, a present\n3870\teffective mode of `a`, a\n3871\t`SharedMutable` leaf (MM-03.3.8), valid dependencies. -/\n3872\tdef WriteSharedPre (k : K) (s : S3) (a : Nat) (ls : List Nat) : Prop :=\n3873\t  s.ExercisableAt a .observe ∧ ∀ p ∈ ls, effective s a p ≠ none ∧ k.SharedMutable p ∧ DepsValid s p\n3874\t\n3875\tinstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (a : Nat) (ls : List Nat) :\n3876\t    Decidable (WriteSharedPre k s a ls) := by\n3877\t  unfold WriteSharedPre; infer_instance\n3878\t\n3879\t/-- `writeShared` as a relation (A9): written leaves become `Init`; no authority changes. -/\n3880\tdef WriteSharedStep (k : K) (a : Nat) (ls : List Nat) (s : S3) : Outcome3 S3 → Prop :=\n3881\t  Guarded (WriteSharedPre k s a ls) (write3Eff s ls)\n3882\t\n3883\t/-- `writeShared_only_shared` (A9): a shared write only touches `SharedMutable` leaves. -/\n3884\ttheorem writeShared_only_shared {k : K} {s s' : S3} {a : Nat} {ls : List Nat}\n3885\t    (h : WriteSharedStep k a ls s (.ok s')) : ∀ p ∈ ls, k.SharedMutable p :=\n3886\t  fun p hp => ((Guarded.ok_iff.1 h).1.2 p hp).2.1\n3887\t\n3888\t/-- `writeShared` preserves `WF3` and `Inv3base` (A9: it does not weaken I1). -/\n3889\ttheorem writeShared_preserves {k : K} {s s' : S3} {a : Nat} {ls : List Nat} (hwf : WF3 s)\n3890\t    (hinv : Inv3base s) (h : WriteSharedStep k a ls s (.ok s')) : WF3 s' ∧ Inv3base s' := by\n3891\t  obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n3892\t  exact ⟨hwf.of_eq rfl rfl rfl rfl rfl, hinv.1, hinv.2.1, fun q hq x hx =>\n3893\t    hinv.2.2.1 q ((S3.Usable.congr (s := s) (s' := write3Eff s ls) rfl rfl rfl).1 hq) x hx,\n3894\t    i4_always _⟩\n3895\t\n3896\t/-! ## Dynamic pinning (A8) -/\n3897\t\n3898\t/-- Preconditions of `pin p` (A8): `p` usable, exercisable `Modify` on `p` (B2; `Modify` for\n3899\t`pin`, B10). -/\n3900\tdef PinPre (s : S3) (p : Nat) : Prop := s.Usable p ∧ HasRight s .modify p\n3901\t\n3902\tinstance (s : S3) (p : Nat) : Decidable (PinPre s p) := by unfold PinPre; infer_instance\n3903\t\n3904\t/-- Effect of `pin p` / `unpin p` (A8): the leaves of `p` become pinned or unpinned. -/\n3905\tdef pinEff (s : S3) (p : Nat) (b : Bool) : S3 :=\n3906\t  { s with pin := fun l => if l ∈ footprint s.P p then b else s.pin l }\n3907\t\n3908\t/-- `pin` as a relation (A8). -/\n3909\tdef PinStep (p : Nat) (s : S3) : Outcome3 S3 → Prop := Guarded (PinPre s p) (pinEff s p true)\n3910\t\n3911\t/-- Preconditions of `unpin p` (A8): the external use of every leaf of `p` is done\n3912\t(`ExternalDone`, MM-03.3.8); B3: the right of `pin`, exercisable `Modify` on `p`. -/\n3913\tdef UnpinPre (k : K) (s : S3) (p : Nat) : Prop :=\n3914\t  (∀ l ∈ footprint s.P p, k.ExternalDone l) ∧ HasRight s .modify p\n3915\t\n3916\tinstance (k : K) [DecidablePred k.ExternalDone] (s : S3) (p : Nat) :\n3917\t    Decidable (UnpinPre k s p) := by\n3918\t  unfold UnpinPre; infer_instance\n3919\t\n3920\t/-- `unpin` as a relation (A8). -/\n3921\tdef UnpinStep (k : K) (p : Nat) (s : S3) : Outcome3 S3 → Prop :=\n3922\t  Guarded (UnpinPre k s p) (pinEff s p false)\n3923\t\n3924\t/-- Pinning changes neither authorities nor places: `WF3` and `Inv3base` are preserved (A8). -/\n3925\ttheorem pinEff_preserves {s : S3} {p : Nat} {b : Bool} (hwf : WF3 s) (hinv : Inv3base s) :\n3926\t    WF3 (pinEff s p b) ∧ Inv3base (pinEff s p b) :=\n3927\t  ⟨hwf.of_eq rfl rfl rfl rfl rfl, hinv.1, hinv.2.1, fun q hq x hx =>\n3928\t    hinv.2.2.1 q ((S3.Usable.congr (s := s) (s' := pinEff s p b) rfl rfl rfl).1 hq) x hx,\n3929\t    i4_always _⟩\n3930\t\n3931\t/-! ## `endUse` (A6) -/\n3932\t\n3933\t/-- The value at `p` ends (A6), before releasing authorities whose holder died: the leaves of\n3934\t`p` become `Uninit`; the authorities held by `p` or one of its parts are released; the anchors\n3935\tof `p` and its parts are removed; the places owned by `p` or one of its parts are logically\n3936\tdead. -/\n3937\tdef endUseS (s : S3) (p : Nat) : S3 :=\n3938\t  { s with\n3939\t    I := fun l => if l ∈ footprint s.P p then .uninit else s.I l\n3940\t    D := fun q => if partOf s.P q p then [] else s.D q\n3941\t    dead := fun q => s.dead q || match s.P[q]? with\n3942\t      | some pl => decide (heldIn s.P p pl.owner)\n3943\t      | none => false\n3944\t    A := s.A.map fun y => if heldIn s.P p y.holder then { y with active := false } else y }\n3945\t\n3946\t/-- Effect of `endUse p` (A6): `endUseS`, then the authorities whose holder died are released.\n3947\tNo storage is released: `freed` is unchanged. -/\n3948\tdef endUseEff (s : S3) (p : Nat) : S3 := cleanup (endUseS s p)\n3949\t\n3950\t/-- Leaves that end with the value at `p` (A6): those of `p`, and those of places that stop\n3951\tbeing usable. -/\n3952\tdef EndingLeaf (s : S3) (p l : Nat) : Prop :=\n3953\t  l ∈ footprint s.P p ∨ (s.Usable l ∧ ¬ (endUseS s p).Usable l)\n3954\t\n3955\tinstance (s : S3) (p l : Nat) : Decidable (EndingLeaf s p l) := by\n3956\t  unfold EndingLeaf; infer_instance\n3957\t\n3958\t/-- Root of the value at `p` (A6, pass-1 arbitrage 2): an authority without origin covering a\n3959\tleaf of `p`. -/\n3960\tdef IsRootOf (s : S3) (p : Nat) (y : Authority) : Prop :=\n3961\t  y.origin = none ∧ ∃ l ∈ footprint s.P p, l ∈ y.footprint\n3962\t\n3963\tinstance (s : S3) (p : Nat) (y : Authority) : Decidable (IsRootOf s p y) := by\n3964\t  unfold IsRootOf; infer_instance\n3965\t\n3966\t/-- Authority `a` is released by the end of the value at `p` (A4, A6): it is active, and held\n3967\twithin `p` (released by `endUseS`) or by a holder that is not live after `endUseS` (released by\n3968\t`cleanup`). Under the possession clause of `WF3`, that holder dies with `p`. -/\n3969\tdef EndUseReleased (s : S3) (p a : Nat) : Prop :=\n3970\t  OptP (s.A[a]?) (fun z => z.active = true ∧\n3971\t    (heldIn s.P p z.holder ∨ ¬ HolderLive (endUseS s p) z.holder)) False\n3972\t\n3973\tinstance (s : S3) (p a : Nat) : Decidable (EndUseReleased s p a) := by\n3974\t  unfold EndUseReleased; infer_instance\n3975\t\n3976\t/-- Authority `j` does not block the end of the value at `p` (A6): if it is an active derived\n3977\tauthority on an ending leaf, or descending from an authority that the end releases\n3978\t(MM-03.3 §3, O3.2), it is held within `p` or its holder dies. -/\n3979\tdef EndUseAccessOK (s : S3) (p j : Nat) : Prop :=\n3980\t  OptP (s.A[j]?) (fun y => y.active = true → y.origin ≠ none →\n3981\t    ((∃ l ∈ y.footprint, EndingLeaf s p l) ∨ ∃ a ∈ s.ancs j, EndUseReleased s p a) →\n3982\t      heldIn s.P p y.holder ∨ ¬ HolderLive (endUseS s p) y.holder) True\n3983\t\n3984\tinstance (s : S3) (p j : Nat) : Decidable (EndUseAccessOK s p j) := by\n3985\t  unfold EndUseAccessOK OptP; split <;> infer_instance\n3986\t\n3987\t/-- Anchor `x` survives the end of the value at `p` (A6): not held within `p`, not the root of\n3988\t`p`, with a holder that stays live. -/\n3989\tdef EndUseAnchorOK (s : S3) (p x : Nat) : Prop :=\n3990\t  OptP (s.A[x]?) (fun y => ¬ heldIn s.P p y.holder ∧ ¬ IsRootOf s p y ∧\n3991\t    HolderLive (endUseS s p) y.holder) True\n3992\t\n3993\tinstance (s : S3) (p x : Nat) : Decidable (EndUseAnchorOK s p x) := by\n3994\t  unfold EndUseAnchorOK OptP; split <;> infer_instance\n3995\t\n3996\t/-- Preconditions of `endUse p` (A6). Usability of the anchored places is read after the end:\n3997\ta place that dies with `p` has no usable dependent afterwards. In order: `p` usable;\n3998\texercisable `Modify` on `p` (A2);\n3999\tno active derived authority on an ending leaf, or descending from an authority that the end\n4000\treleases (MM-03.3 §3, O3.2), held elsewhere than in `p` and staying live; no\n4001\tusable place anchored on an authority held by `p`, on its root, or held by a holder that dies;\n4002\tC5: no ending leaf pinned, dynamically (A8) or statically (`Pinned`), whatever `ExternalDone`\n4003\tsays: external obligations end only through `unpin`. The ending leaves include those of the\n4004\towned places, which die (A6). C8: `p` itself stays usable, its leaves `Uninit`. -/\n4005\tdef EndUsePre (k : K) (s : S3) (p : Nat) : Prop :=\n4006\t  s.Usable p ∧ HasRight s .modify p ∧\n4007\t  (∀ j ∈ List.range s.A.length, EndUseAccessOK s p j) ∧\n4008\t  (∀ q ∈ List.range s.P.length, (endUseS s p).Usable q → ∀ x ∈ (endUseS s p).D q,\n4009\t    EndUseAnchorOK s p x) ∧\n4010\t  (∀ l ∈ List.range s.P.length, EndingLeaf s p l → s.pin l = false ∧ ¬ k.Pinned l)\n4011\t\n4012\tinstance (k : K) [DecidablePred k.Pinned] (s : S3) (p : Nat) :\n4013\t    Decidable (EndUsePre k s p) := by\n4014\t  unfold EndUsePre; infer_instance\n4015\t\n4016\t/-- `endUse` as a relation (A6). -/\n4017\tdef EndUseStep (k : K) (p : Nat) (s : S3) : Outcome3 S3 → Prop :=\n4018\t  Guarded (EndUsePre k s p) (endUseEff s p)\n4019\t\n4020\ttheorem endUseS_releases (s : S3) (p : Nat) : OnlyReleases s (endUseS s p) := by\n4021\t  refine ⟨by simp [endUseS], fun j z hz => ?_⟩\n4022\t  simp only [endUseS, List.getElem?_map] at hz\n4023\t  cases hy : s.A[j]? with\n4024\t  | none => rw [hy] at hz; cases hz\n4025\t  | some y =>"}]}}
