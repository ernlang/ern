1","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"parentUuid":"81353ab5-926b-442b-8bf1-1f7afab91f50","isSidechain":false,"promptId":"ad10e2fd-52be-47f7-a4f7-932245537372","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VU7Wbt9V5jLKvTyEV71HTa","type":"tool_result","content":"140\t/-- `c1 : terminate` (WC5.2 C7), after step 8. -/\n141\tdef aj11 : SC := termEffC ag10 1\n142\t/-- Step 10 of W-AG-J, `c0 : acquire(e)`: grant `g′`, authority 7 (WC5.2 C16). -/\n143\tdef aj12 : SC := deriveSyncEff aj11 0 3\n144\t/-- Step 11 of W-AG-J, `c0 : write3(T)` via `g′` (O10). -/\n145\tdef aj13 : SC := aj12.set (write3Eff (aj12.view 0) [3])\n146\t\n147\t/-- The labels of W-AG-J: steps 1 to 8, `c1 : terminate`, `c0 : join(c1)`, steps 9 to 11. -/\n148\tdef ajLbls : List Label :=\n149\t  abLbls ++ [.kernel 1 (.release 6), .terminate 1, .join 0 1, .resetLock 0 0, .acquire 0 0,\n150\t    .kernel 0 (.write 7 [3])]\n151\t\n152\t/-- The named states of W-AG-J. -/\n153\tdef ajσ (i : Nat) : SC × SyncReg × ArenaReg :=\n154\t  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ab3, regX, []), (ab4, regX, []),\n155\t    (ab5, abReg, []), (ab6, abReg, []), (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []),\n156\t    (ag10, abReg, []), (aj11, abReg, []), (aj11, abReg, []), (aj11, regX, []),\n157\t    (aj12, agReg, []), (aj13, agReg, [])].getD i (aj13, agReg, [])\n158\t\n159\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG-J: the synchronized twin is `ok` at every step and\n160\tadmitted; from the initial state, the trace is a `RunFull` (WC5.2 C7, C8). -/\n161\ttheorem W_AGJ_run : ajσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 ajσ ajLbls := by\n162\t  have h : Steps5R KM L0\n163\t      [(x2, regX, []), (ab3, regX, []), (ab4, regX, []), (ab5, abReg, []), (ab6, abReg, []),\n164\t        (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []), (ag10, abReg, []),\n165\t        (aj11, abReg, []), (aj11, abReg, []), (aj11, regX, []), (aj12, agReg, []),\n166\t        (aj13, agReg, [])]\n167\t      [.kernel 0 (.derive 0 [2] .observe), .kernel 0 (.enter [4] []), .acquire 0 0,\n168\t        .kernel 0 (.derive 5 [3] .modify), .spawn 0 [6] [], .kernel 0 .exit,\n169\t        .kernel 1 (.write 6 [3]), .kernel 1 (.release 6), .terminate 1, .join 0 1,\n170\t        .resetLock 0 0, .acquire 0 0, .kernel 0 (.write 7 [3])] :=\n171\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n172\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n173\t    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n174\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n175\t    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n176\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n177\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n178\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n179\t    .cons (by decide) (.terminate ⟨by decide, .ok (by decide)⟩) <|\n180\t    .cons (by decide) (.join (.ok (by decide) (by decide))) <|\n181\t    .cons (by decide) (.resetLock ⟨by decide, ⟨3, some 5⟩, rfl, by decide, by decide, by decide,\n182\t      rfl⟩) <|\n183\t    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n184\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n185\t  exact ⟨rfl, runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))\n186\t    (by decide)⟩\n187\t\n188\t/-! ## The strict graph -/\n189\t\n190\t/-- `corpus-spec2-m3.md` v14 §2 terdecies, strict graph of W-AG: the two writes of `T`, by `c1`\n191\t(step 7, index 9) and by `c0` (step 11, index 13), form an exclusive pair with no strict `hb` path;\n192\tthe pair violates strict `HandoffOrderedAt` (WC5.2 C46); the trace has a strict `Race` and is not\n193\tstrictly `HandoffOrdered`. -/\n194\ttheorem W_AG_strict : ExclPair agLbls 9 13 3 ∧ ¬ HBS agσ L0 agLbls (.step 9) (.step 13) ∧\n195\t    ¬ HandoffOrderedAtS agσ L0 agLbls 9 13 3 ∧ ¬ HandoffOrderedS agσ L0 agLbls ∧\n196\t    RaceS agσ L0 agLbls := by\n197\t  have hp : ExclPair agLbls 9 13 3 :=\n198\t    ⟨by decide, by decide, 0, 1, .modify, .modify, by decide, ⟨rfl, by decide, rfl⟩,\n199\t      ⟨rfl, by decide, rfl⟩, Or.inl rfl⟩\n200\t  have hnb : ¬ HBS agσ L0 agLbls (.step 9) (.step 13) := by decide\n201\t  have hno : ¬ HandoffOrderedAtS agσ L0 agLbls 9 13 3 := by decide\n202\t  exact ⟨hp, hnb, hno, fun h => hno (h 9 13 3 hp), ⟨9, 13, 3, hp, hnb⟩⟩\n203\t\n204\t/-- `corpus-spec2-m3.md` v14 §2 terdecies, strict graph of W-AG-J: write of `c1` (index 9) →`po`\n205\t`terminate(c1)` (index 11) →`sw` `join(c1)` (index 12) →`po` write of `c0` (index 15); the pair\n206\tsatisfies strict `HandoffOrderedAt` (WC5.2 C46), and the trace, whose only accesses are these two\n207\twrites, is strictly `HandoffOrdered` and has no strict `Race`. -/\n208\ttheorem W_AGJ_strict : PO ajσ ajLbls (.step 9) (.step 11) ∧\n209\t    SWS ajσ L0 ajLbls (.step 11) (.step 12) ∧ PO ajσ ajLbls (.step 12) (.step 15) ∧\n210\t    HBS ajσ L0 ajLbls (.step 9) (.step 15) ∧ HandoffOrderedS ajσ L0 ajLbls ∧\n211\t    ¬ RaceS ajσ L0 ajLbls := by\n212\t  have hkey : ∀ k (h : k < ajLbls.length), (ajLbls[k]'h).accMode ≠ none → k = 9 ∨ k = 15 := by\n213\t    decide\n214\t  have hb : HBS ajσ L0 ajLbls (.step 9) (.step 15) := by decide\n215\t  refine ⟨by decide, by decide, by decide, hb, handoffOrderedS_of_two hkey (by decide) ?_,\n216\t    not_raceS_of_two hkey (by decide) hb⟩\n217\t  rintro l ⟨_, c, m, ⟨-, hl, -⟩⟩\n218\t  rw [List.mem_singleton.1 hl]\n219\t  decide\n220\t\n221\t/-! ## W-AG′ -/\n222\t\n223\t/-- A1, `c1 : y := derive(x, Modify, {T})`, authority 7 (O1). -/\n224\tdef ap1 : SC := ab9.set (deriveEff (ab9.view 1) 6 [3] .modify)\n225\t/-- A2, `c1 : spawn c2` yielding `y` (WC5.2 C4): context 2, initial frame 3. -/\n226\tdef ap2 : SC := spawnEff ap1 1 [7] []\n227\t/-- A3, `c1 : terminate` (WC5.2 C7): `x` is released, `y` survives and is reanchored. -/\n228\tdef ap3 : SC := termEffC ap2 1\n229\t/-- A4, `c2 : write3(T)` via `y` (O10). -/\n230\tdef ap4 : SC := ap3.set (write3Eff (ap3.view 2) [3])\n231\t\n232\t/-- The labels of W-AG′: steps 1 to 7 of W-AG, then A1 to A4. -/\n233\tdef apLbls : List Label :=\n234\t  abLbls ++ [.kernel 1 (.derive 6 [3] .modify), .spawn 1 [7] [], .terminate 1,\n235\t    .kernel 2 (.write 7 [3])]\n236\t\n237\t/-- The named states of W-AG′. -/\n238\tdef apσ (i : Nat) : SC × SyncReg × ArenaReg :=\n239\t  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ab3, regX, []), (ab4, regX, []),\n240\t    (ab5, abReg, []), (ab6, abReg, []), (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []),\n241\t    (ap1, abReg, []), (ap2, abReg, []), (ap3, abReg, []), (ap4, abReg, [])].getD i\n242\t    (ap4, abReg, [])\n243\t\n244\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG′: A1 to A4 are `ok` and admitted (O1, WC5.2 C4, C7,\n245\tO10); from the initial state, the trace is a `RunFull`. The covering descendants of `guarded`,\n246\tstep by step: `{x}` after step 7; `{x, y}` after A1 (a creation, of origin `x`, already in the\n247\tset); unchanged after A2; `{y}` after A3 (no creation; the origin of `y` goes from `x` to\n248\t`guarded`); unchanged after A4. -/\n249\ttheorem W_AGp_run : apσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 apσ apLbls ∧\n250\t    covSet ab9 3 = [6] ∧ covSet ap1 3 = [6, 7] ∧ ap1.flat.org 7 = some 6 ∧\n251\t    covSet ap2 3 = [6, 7] ∧ covSet ap3 3 = [7] ∧ ap3.A.length = ap2.A.length ∧\n252\t    ap2.flat.org 7 = some 6 ∧ ap3.flat.org 7 = some 3 ∧ covSet ap4 3 = [7] := by\n253\t  have h : Steps5R KM L0\n254\t      [(x2, regX, []), (ab3, regX, []), (ab4, regX, []), (ab5, abReg, []), (ab6, abReg, []),\n255\t        (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []), (ap1, abReg, []), (ap2, abReg, []),\n256\t        (ap3, abReg, []), (ap4, abReg, [])]\n257\t      [.kernel 0 (.derive 0 [2] .observe), .kernel 0 (.enter [4] []), .acquire 0 0,\n258\t        .kernel 0 (.derive 5 [3] .modify), .spawn 0 [6] [], .kernel 0 .exit,\n259\t        .kernel 1 (.write 6 [3]), .kernel 1 (.derive 6 [3] .modify), .spawn 1 [7] [],\n260\t        .terminate 1, .kernel 2 (.write 7 [3])] :=\n261\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n262\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n263\t    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n264\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n265\t    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n266\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n267\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n268\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n269\t    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n270\t    .cons (by decide) (.terminate ⟨by decide, .ok (by decide)⟩) <|\n271\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n272\t  exact ⟨rfl, runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))\n273\t    (by decide), by decide, by decide, by decide, by decide, by decide, by decide, by decide,\n274\t    by decide, by decide⟩\n275\t\n276\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG′, negative after A3: `c0 : resetLock(e)` is refused;\n277\tC18.2 fails, `y` being an active descendant of `guarded` covering `T`. -/\n278\ttheorem W_AGp_neg : (∀ st', ¬ ResetLockOk L0 ap3 abReg 0 0 st') ∧ CoveringDesc ap3 3 7 := by\n279\t  refine ⟨?_, by decide⟩\n280\t  rintro st' ⟨-, e, he, -, hn, -⟩\n281\t  cases he\n282\t  exact absurd hn (by decide)\n283\t\n284\tend Ern.Concurrency.FullEncap.AbandonedGrant\n285\t"}]},"uuid":"d4d40550-d6aa-457c-91bf-8d453cbbffcf","timestamp":"2026-11-12T23:46:08.874Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/AbandonedGrant.lean","content":"/-- `c1 : terminate` (WC5.2 C7), after step 8. -/\ndef aj11 : SC := termEffC ag10 1\n/-- Step 10 of W-AG-J, `c0 : acquire(e)`: grant `g′`, authority 7 (WC5.2 C16). -/\ndef aj12 : SC := deriveSyncEff aj11 0 3\n/-- Step 11 of W-AG-J, `c0 : write3(T)` via `g′` (O10). -/\ndef aj13 : SC := aj12.set (write3Eff (aj12.view 0) [3])\n\n/-- The labels of W-AG-J: steps 1 to 8, `c1 : terminate`, `c0 : join(c1)`, steps 9 to 11. -/\ndef ajLbls : List Label :=\n  abLbls ++ [.kernel 1 (.release 6), .terminate 1, .join 0 1, .resetLock 0 0, .acquire 0 0,\n    .kernel 0 (.write 7 [3])]\n\n/-- The named states of W-AG-J. -/\ndef ajσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ab3, regX, []), (ab4, regX, []),\n    (ab5, abReg, []), (ab6, abReg, []), (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []),\n    (ag10, abReg, []), (aj11, abReg, []), (aj11, abReg, []), (aj11, regX, []),\n    (aj12, agReg, []), (aj13, agReg, [])].getD i (aj13, agReg, [])\n\n/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG-J: the synchronized twin is `ok` at every step and\nadmitted; from the initial state, the trace is a `RunFull` (WC5.2 C7, C8). -/\ntheorem W_AGJ_run : ajσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 ajσ ajLbls := by\n  have h : Steps5R KM L0\n      [(x2, regX, []), (ab3, regX, []), (ab4, regX, []), (ab5, abReg, []), (ab6, abReg, []),\n        (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []), (ag10, abReg, []),\n        (aj11, abReg, []), (aj11, abReg, []), (aj11, regX, []), (aj12, agReg, []),\n        (aj13, agReg, [])]\n      [.kernel 0 (.derive 0 [2] .observe), .kernel 0 (.enter [4] []), .acquire 0 0,\n        .kernel 0 (.derive 5 [3] .modify), .spawn 0 [6] [], .kernel 0 .exit,\n        .kernel 1 (.write 6 [3]), .kernel 1 (.release 6), .terminate 1, .join 0 1,\n        .resetLock 0 0, .acquire 0 0, .kernel 0 (.write 7 [3])] :=\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.terminate ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.join (.ok (by decide) (by decide))) <|\n    .cons (by decide) (.resetLock ⟨by decide, ⟨3, some 5⟩, rfl, by decide, by decide, by decide,\n      rfl⟩) <|\n    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))\n    (by decide)⟩\n\n/-! ## The strict graph -/\n\n/-- `corpus-spec2-m3.md` v14 §2 terdecies, strict graph of W-AG: the two writes of `T`, by `c1`\n(step 7, index 9) and by `c0` (step 11, index 13), form an exclusive pair with no strict `hb` path;\nthe pair violates strict `HandoffOrderedAt` (WC5.2 C46); the trace has a strict `Race` and is not\nstrictly `HandoffOrdered`. -/\ntheorem W_AG_strict : ExclPair agLbls 9 13 3 ∧ ¬ HBS agσ L0 agLbls (.step 9) (.step 13) ∧\n    ¬ HandoffOrderedAtS agσ L0 agLbls 9 13 3 ∧ ¬ HandoffOrderedS agσ L0 agLbls ∧\n    RaceS agσ L0 agLbls := by\n  have hp : ExclPair agLbls 9 13 3 :=\n    ⟨by decide, by decide, 0, 1, .modify, .modify, by decide, ⟨rfl, by decide, rfl⟩,\n      ⟨rfl, by decide, rfl⟩, Or.inl rfl⟩\n  have hnb : ¬ HBS agσ L0 agLbls (.step 9) (.step 13) := by decide\n  have hno : ¬ HandoffOrderedAtS agσ L0 agLbls 9 13 3 := by decide\n  exact ⟨hp, hnb, hno, fun h => hno (h 9 13 3 hp), ⟨9, 13, 3, hp, hnb⟩⟩\n\n/-- `corpus-spec2-m3.md` v14 §2 terdecies, strict graph of W-AG-J: write of `c1` (index 9) →`po`\n`terminate(c1)` (index 11) →`sw` `join(c1)` (index 12) →`po` write of `c0` (index 15); the pair\nsatisfies strict `HandoffOrderedAt` (WC5.2 C46), and the trace, whose only accesses are these two\nwrites, is strictly `HandoffOrdered` and has no strict `Race`. -/\ntheorem W_AGJ_strict : PO ajσ ajLbls (.step 9) (.step 11) ∧\n    SWS ajσ L0 ajLbls (.step 11) (.step 12) ∧ PO ajσ ajLbls (.step 12) (.step 15) ∧\n    HBS ajσ L0 ajLbls (.step 9) (.step 15) ∧ HandoffOrderedS ajσ L0 ajLbls ∧\n    ¬ RaceS ajσ L0 ajLbls := by\n  have hkey : ∀ k (h : k < ajLbls.length), (ajLbls[k]'h).accMode ≠ none → k = 9 ∨ k = 15 := by\n    decide\n  have hb : HBS ajσ L0 ajLbls (.step 9) (.step 15) := by decide\n  refine ⟨by decide, by decide, by decide, hb, handoffOrderedS_of_two hkey (by decide) ?_,\n    not_raceS_of_two hkey (by decide) hb⟩\n  rintro l ⟨_, c, m, ⟨-, hl, -⟩⟩\n  rw [List.mem_singleton.1 hl]\n  decide\n\n/-! ## W-AG′ -/\n\n/-- A1, `c1 : y := derive(x, Modify, {T})`, authority 7 (O1). -/\ndef ap1 : SC := ab9.set (deriveEff (ab9.view 1) 6 [3] .modify)\n/-- A2, `c1 : spawn c2` yielding `y` (WC5.2 C4): context 2, initial frame 3. -/\ndef ap2 : SC := spawnEff ap1 1 [7] []\n/-- A3, `c1 : terminate` (WC5.2 C7): `x` is released, `y` survives and is reanchored. -/\ndef ap3 : SC := termEffC ap2 1\n/-- A4, `c2 : write3(T)` via `y` (O10). -/\ndef ap4 : SC := ap3.set (write3Eff (ap3.view 2) [3])\n\n/-- The labels of W-AG′: steps 1 to 7 of W-AG, then A1 to A4. -/\ndef apLbls : List Label :=\n  abLbls ++ [.kernel 1 (.derive 6 [3] .modify), .spawn 1 [7] [], .terminate 1,\n    .kernel 2 (.write 7 [3])]\n\n/-- The named states of W-AG′. -/\ndef apσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ab3, regX, []), (ab4, regX, []),\n    (ab5, abReg, []), (ab6, abReg, []), (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []),\n    (ap1, abReg, []), (ap2, abReg, []), (ap3, abReg, []), (ap4, abReg, [])].getD i\n    (ap4, abReg, [])\n\n/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG′: A1 to A4 are `ok` and admitted (O1, WC5.2 C4, C7,\nO10); from the initial state, the trace is a `RunFull`. The covering descendants of `guarded`,\nstep by step: `{x}` after step 7; `{x, y}` after A1 (a creation, of origin `x`, already in the\nset); unchanged after A2; `{y}` after A3 (no creation; the origin of `y` goes from `x` to\n`guarded`); unchanged after A4. -/\ntheorem W_AGp_run : apσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 apσ apLbls ∧\n    covSet ab9 3 = [6] ∧ covSet ap1 3 = [6, 7] ∧ ap1.flat.org 7 = some 6 ∧\n    covSet ap2 3 = [6, 7] ∧ covSet ap3 3 = [7] ∧ ap3.A.length = ap2.A.length ∧\n    ap2.flat.org 7 = some 6 ∧ ap3.flat.org 7 = some 3 ∧ covSet ap4 3 = [7] := by\n  have h : Steps5R KM L0\n      [(x2, regX, []), (ab3, regX, []), (ab4, regX, []), (ab5, abReg, []), (ab6, abReg, []),\n        (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []), (ap1, abReg, []), (ap2, abReg, []),\n        (ap3, abReg, []), (ap4, abReg, [])]\n      [.kernel 0 (.derive 0 [2] .observe), .kernel 0 (.enter [4] []), .acquire 0 0,\n        .kernel 0 (.derive 5 [3] .modify), .spawn 0 [6] [], .kernel 0 .exit,\n        .kernel 1 (.write 6 [3]), .kernel 1 (.derive 6 [3] .modify), .spawn 1 [7] [],\n        .terminate 1, .kernel 2 (.write 7 [3])] :=\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.terminate ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))\n    (by decide), by decide, by decide, by decide, by decide, by decide, by decide, by decide,\n    by decide, by decide⟩\n\n/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG′, negative after A3: `c0 : resetLock(e)` is refused;\nC18.2 fails, `y` being an active descendant of `guarded` covering `T`. -/\ntheorem W_AGp_neg : (∀ st', ¬ ResetLockOk L0 ap3 abReg 0 0 st') ∧ CoveringDesc ap3 3 7 := by\n  refine ⟨?_, by decide⟩\n  rintro st' ⟨-, e, he, -, hn, -⟩\n  cases he\n  exact absurd hn (by decide)\n\nend Ern.Concurrency.FullEncap.AbandonedGrant\n","numLines":146,"startLine":140,"totalLines":285}},"sourceToolAssistantUUID":"81353ab5-926b-442b-8bf1-1f7afab91f50","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"4a8c780b3c3352118774f8b806087f0350cf617f05c9f111d94cee818c108741","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Reading the W-AG witness statements to fill the « attendu / obtenu » table."},{"type":"tool_use","id":"toolu_01V7HT9dgBFqSzmC1baeMeaC","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/AbandonedGrant.lean","offset":1,"limit":140},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01VU7Wbt9V5jLKvTyEV71HTa","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/AbandonedGrant.lean","offset":140,"limit":160},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"8c78e7cb28df05362d8dd363e7f0557bbab049c751b40a81bcf2154052397ab0","message":{"role":"user","content":[{"tool_use_id":"toolu_01V7HT9dgBFqSzmC1baeMeaC","type":"tool_result","content":"1\timport Ern.Concurrency.FullEncap.Protected\n2\timport Ern.Concurrency.Corpus.MutexEdgeStrict\n3\t\n4\t/-!\n5\t# Witnesses W-AG, W-AG-J and W-AG′\n6\t\n7\t`corpus-spec2-m3.md` v14 §2 terdecies: a grant abandoned by frame exit while a derivative of it\n8\tsurvives in another context. One theorem per expected fact, preconditions by `decide`; the\n9\tverdicts are written from the corpus. Contract `KM`, layout `L0`, from `MX₃`; the corpus step `k`\n10\tof W-AG is the label of index `k + 2` (`MX₃` takes three labels).\n11\t\n12\t* W-AG: steps 1 to 7 are the trace of `protected_runFull_refuted`; steps 8 to 11 recover the mutex\n13\t  without `join`.\n14\t* W-AG-J: the same with `c1 : terminate` and `c0 : join(c1)` between steps 8 and 9.\n15\t* W-AG′: from the state after step 7, a derivation and a reanchoring while the recorded grant is\n16\t  inactive.\n17\t-/\n18\t\n19\tset_option autoImplicit false\n20\t\n21\tnamespace Ern.Concurrency.FullEncap.AbandonedGrant\n22\t\n23\topen Ern.MemoryModel Ern.MemoryModel.Access Ern.Concurrency Ern.Concurrency.MutexReal\n24\topen Ern.Concurrency.Corpus Ern.Concurrency.FullEncap.Protected\n25\topen Ern.Concurrency.FullEncap.Witness (instDecidableEncap5R)\n26\topen Ern.Concurrency.Corpus.MutexEdgeStrict (handoffOrderedS_of_two not_raceS_of_two)\n27\topen Ern.Concurrency.Traces (L0)\n28\t\n29\t/-- The covering descendants of `g` in state `s` (WC5.2 C22; brief of the complement, \"Descendants\n30\tcouvrants\"): the active strict descendants of `g` by the current origin chain, read transitively,\n31\tthat cover a leaf of `footprint(g)` (`CoveringDesc`), listed by identity. -/\n32\tdef covSet (s : SC) (g : Nat) : List Nat :=\n33\t  (List.range s.A.length).filter fun j => decide (CoveringDesc s g j)\n34\t\n35\t/-! ## W-AG -/\n36\t\n37\t/-- Step 8, `c1 : release(x)` (O3). -/\n38\tdef ag10 : SC := ab9.set (releaseEff (ab9.view 1) 6)\n39\t/-- Step 10, `c0 : acquire(e)`: grant `g′`, authority 7, held by frame 0 (WC5.2 C16). -/\n40\tdef ag11 : SC := deriveSyncEff ag10 0 3\n41\t/-- The registry with `g′` recorded. -/\n42\tdef agReg : SyncReg := [⟨3, some 7⟩]\n43\t/-- Step 11, `c0 : write3(T)` via `g′` (O10). -/\n44\tdef ag12 : SC := ag11.set (write3Eff (ag11.view 0) [3])\n45\t\n46\t/-- The labels of W-AG: `MX₃`, then steps 1 to 11. -/\n47\tdef agLbls : List Label :=\n48\t  abLbls ++ [.kernel 1 (.release 6), .resetLock 0 0, .acquire 0 0, .kernel 0 (.write 7 [3])]\n49\t\n50\t/-- The named states of W-AG. -/\n51\tdef agσ (i : Nat) : SC × SyncReg × ArenaReg :=\n52\t  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ab3, regX, []), (ab4, regX, []),\n53\t    (ab5, abReg, []), (ab6, abReg, []), (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []),\n54\t    (ag10, abReg, []), (ag10, regX, []), (ag11, agReg, []), (ag12, agReg, [])].getD i\n55\t    (ag12, agReg, [])\n56\t\n57\t/-- The steps of W-AG from `MX₃`, each admitted by `Encap5R`. -/\n58\ttheorem ag_steps : Steps5R KM L0\n59\t    [(x2, regX, []), (ab3, regX, []), (ab4, regX, []), (ab5, abReg, []), (ab6, abReg, []),\n60\t      (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []), (ag10, abReg, []), (ag10, regX, []),\n61\t      (ag11, agReg, []), (ag12, agReg, [])]\n62\t    [.kernel 0 (.derive 0 [2] .observe), .kernel 0 (.enter [4] []), .acquire 0 0,\n63\t      .kernel 0 (.derive 5 [3] .modify), .spawn 0 [6] [], .kernel 0 .exit, .kernel 1 (.write 6 [3]),\n64\t      .kernel 1 (.release 6), .resetLock 0 0, .acquire 0 0, .kernel 0 (.write 7 [3])] :=\n65\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n66\t  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n67\t  .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n68\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n69\t  .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n70\t  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n71\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n72\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n73\t  .cons (by decide) (.resetLock ⟨by decide, ⟨3, some 5⟩, rfl, by decide, by decide, by decide,\n74\t    rfl⟩) <|\n75\t  .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n76\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n77\t\n78\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG, steps 1 to 11: every step is an `ok` kernel or\n79\tlibrary step (O1, O6, WC5.2 C14–C16, O1, C4, C6, O10, O3, C18, C16, O10) and is admitted by the\n80\tcomplete encapsulation; from the initial state, the trace is a `RunFull`. -/\n81\ttheorem W_AG_run : agσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 agσ agLbls :=\n82\t  ⟨rfl, runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps ag_steps).run _) (by decide))\n83\t    (by decide)⟩\n84\t\n85\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG, facts on step 6 (`c0 : exitFrameC(f1)`, from `ab7`\n86\tto `ab8`; Spec 1 §73 effect, WC5.2 C6):\n87\t* no authority is created;\n88\t* the origin of `x` (authority 6) goes from `g` (5) to `guarded` (3), its footprint and own mode\n89\t  unchanged;\n90\t* the covering descendants of `guarded` are `g` and `x` before the step, `x` alone after it;\n91\t* after the step, `e` is live (WC5.2 C12), `grant = some g` with `g` inactive, and `root_M` has\n92\t  effective `Modify` on `slot` and `lock` again (Spec 1 §43.2). -/\n93\ttheorem W_AG_6_facts : ab8.A.length = ab7.A.length ∧\n94\t    ab7.flat.org 6 = some 5 ∧ ab8.flat.org 6 = some 3 ∧ ab8.flat.afp 6 = ab7.flat.afp 6 ∧\n95\t    (ab8.A[6]?).map (·.mode) = (ab7.A[6]?).map (·.mode) ∧\n96\t    covSet ab7 3 = [5, 6] ∧ covSet ab8 3 = [6] ∧\n97\t    (⟨3, some 5⟩ : SyncEntry).Live ab8 ∧ ¬ ab8.flat.Active 5 ∧\n98\t    effective ab8.flat 0 1 = some .modify ∧ effective ab8.flat 0 2 = some .modify := by\n99\t  decide\n100\t\n101\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG, refusal a, from the state after step 7:\n102\t`c0 : acquire(e)` has no `ok` outcome. C14.1 and C14.3 hold (the entry is live; `root_M` gives the\n103\tcontroller access); C14.2 fails (`grant = some g`); C15.4 (Spec 1 §60.2, the effective mode of\n104\t`guarded` on `T`) and C15.5 (§60.3, the active `x` overlaps `T` outside the origin chain of\n105\t`guarded`) fail too. -/\n106\ttheorem W_AG_a : (∀ st', ¬ AcquireOk KM L0 ab9 abReg 0 0 st') ∧\n107\t    (⟨3, some 5⟩ : SyncEntry).Live ab9 ∧ CtrlRight L0 ab9 ⟨3, some 5⟩ (ab9.view 0).top ∧\n108\t    ¬ (∀ l ∈ (ab9.view 0).afp 3, Allows (effective (ab9.view 0) 3 l) .modify) ∧\n109\t    ¬ (∀ b ∈ List.range ab9.A.length, OptP (ab9.A[b]?) (fun y => y.active = true →\n110\t      b ∉ 3 :: (ab9.view 0).ancs 3 → (∃ l ∈ (ab9.view 0).afp 3, l ∈ y.footprint) →\n111\t        y.mode = .observe ∧ Mode.modify = .observe) True) := by\n112\t  refine ⟨?_, by decide, by decide, by decide, by decide⟩\n113\t  rintro st' ⟨-, e, he, ⟨-, hg, -⟩, -⟩\n114\t  cases he; cases hg\n115\t\n116\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG, refusal b: `c0 : unlock(e)` is refused; C17.2 fails,\n117\tthe recorded grant `g` being inactive (Spec 1 §62.1). -/\n118\ttheorem W_AG_b : (∀ st', ¬ UnlockOk L0 ab9 abReg 0 0 st') ∧ ¬ (ab9.view 0).Active 5 := by\n119\t  refine ⟨?_, by decide⟩\n120\t  rintro st' ⟨-, e, g, he, -, hg, hrel, -⟩\n121\t  cases he; cases hg\n122\t  exact absurd hrel.active (by decide)\n123\t\n124\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG, refusal c: `c0 : resetLock(e)` is refused; C18.2\n125\tfails, `x`, an active descendant of `guarded`, covering `T`. C18.1 holds through `root_M`. -/\n126\ttheorem W_AG_c : (∀ st', ¬ ResetLockOk L0 ab9 abReg 0 0 st') ∧ ¬ NoCoveringDesc ab9 3 ∧\n127\t    CoveringDesc ab9 3 6 ∧ (ab9.view 0).ExercisableAt 3 .modify := by\n128\t  refine ⟨?_, by decide, by decide, by decide⟩\n129\t  rintro st' ⟨-, e, he, -, hn, -⟩\n130\t  cases he\n131\t  exact absurd hn (by decide)\n132\t\n133\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG, refusal d: `c0 : read3(T)` with `access = guarded`\n134\tis refused; O9.2 fails, the effective mode of `guarded` on `T` being absent (Spec 1 §43.3). -/\n135\ttheorem W_AG_d : opStepC KM (.read 3 [3]) 0 ab9 .reject ∧ effective ab9.flat 3 3 = none :=\n136\t  ⟨⟨by decide, _, .reject (by decide), rfl⟩, by decide⟩\n137\t\n138\t/-! ## W-AG-J -/\n139\t\n140\t/-- `c1 : terminate` (WC5.2 C7), after step 8. -/"},{"tool_use_id":"toolu_01VU7Wbt9V5jLKvTyEV71HTa","type":"tool_result","content":"140\t/-- `c1 : terminate` (WC5.2 C7), after step 8. -/\n141\tdef aj11 : SC := termEffC ag10 1\n142\t/-- Step 10 of W-AG-J, `c0 : acquire(e)`: grant `g′`, authority 7 (WC5.2 C16). -/\n143\tdef aj12 : SC := deriveSyncEff aj11 0 3\n144\t/-- Step 11 of W-AG-J, `c0 : write3(T)` via `g′` (O10). -/\n145\tdef aj13 : SC := aj12.set (write3Eff (aj12.view 0) [3])\n146\t\n147\t/-- The labels of W-AG-J: steps 1 to 8, `c1 : terminate`, `c0 : join(c1)`, steps 9 to 11. -/\n148\tdef ajLbls : List Label :=\n149\t  abLbls ++ [.kernel 1 (.release 6), .terminate 1, .join 0 1, .resetLock 0 0, .acquire 0 0,\n150\t    .kernel 0 (.write 7 [3])]\n151\t\n152\t/-- The named states of W-AG-J. -/\n153\tdef ajσ (i : Nat) : SC × SyncReg × ArenaReg :=\n154\t  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ab3, regX, []), (ab4, regX, []),\n155\t    (ab5, abReg, []), (ab6, abReg, []), (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []),\n156\t    (ag10, abReg, []), (aj11, abReg, []), (aj11, abReg, []), (aj11, regX, []),\n157\t    (aj12, agReg, []), (aj13, agReg, [])].getD i (aj13, agReg, [])\n158\t\n159\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG-J: the synchronized twin is `ok` at every step and\n160\tadmitted; from the initial state, the trace is a `RunFull` (WC5.2 C7, C8). -/\n161\ttheorem W_AGJ_run : ajσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 ajσ ajLbls := by\n162\t  have h : Steps5R KM L0\n163\t      [(x2, regX, []), (ab3, regX, []), (ab4, regX, []), (ab5, abReg, []), (ab6, abReg, []),\n164\t        (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []), (ag10, abReg, []),\n165\t        (aj11, abReg, []), (aj11, abReg, []), (aj11, regX, []), (aj12, agReg, []),\n166\t        (aj13, agReg, [])]\n167\t      [.kernel 0 (.derive 0 [2] .observe), .kernel 0 (.enter [4] []), .acquire 0 0,\n168\t        .kernel 0 (.derive 5 [3] .modify), .spawn 0 [6] [], .kernel 0 .exit,\n169\t        .kernel 1 (.write 6 [3]), .kernel 1 (.release 6), .terminate 1, .join 0 1,\n170\t        .resetLock 0 0, .acquire 0 0, .kernel 0 (.write 7 [3])] :=\n171\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n172\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n173\t    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n174\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n175\t    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n176\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n177\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n178\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n179\t    .cons (by decide) (.terminate ⟨by decide, .ok (by decide)⟩) <|\n180\t    .cons (by decide) (.join (.ok (by decide) (by decide))) <|\n181\t    .cons (by decide) (.resetLock ⟨by decide, ⟨3, some 5⟩, rfl, by decide, by decide, by decide,\n182\t      rfl⟩) <|\n183\t    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n184\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n185\t  exact ⟨rfl, runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))\n186\t    (by decide)⟩\n187\t\n188\t/-! ## The strict graph -/\n189\t\n190\t/-- `corpus-spec2-m3.md` v14 §2 terdecies, strict graph of W-AG: the two writes of `T`, by `c1`\n191\t(step 7, index 9) and by `c0` (step 11, index 13), form an exclusive pair with no strict `hb` path;\n192\tthe pair violates strict `HandoffOrderedAt` (WC5.2 C46); the trace has a strict `Race` and is not\n193\tstrictly `HandoffOrdered`. -/\n194\ttheorem W_AG_strict : ExclPair agLbls 9 13 3 ∧ ¬ HBS agσ L0 agLbls (.step 9) (.step 13) ∧\n195\t    ¬ HandoffOrderedAtS agσ L0 agLbls 9 13 3 ∧ ¬ HandoffOrderedS agσ L0 agLbls ∧\n196\t    RaceS agσ L0 agLbls := by\n197\t  have hp : ExclPair agLbls 9 13 3 :=\n198\t    ⟨by decide, by decide, 0, 1, .modify, .modify, by decide, ⟨rfl, by decide, rfl⟩,\n199\t      ⟨rfl, by decide, rfl⟩, Or.inl rfl⟩\n200\t  have hnb : ¬ HBS agσ L0 agLbls (.step 9) (.step 13) := by decide\n201\t  have hno : ¬ HandoffOrderedAtS agσ L0 agLbls 9 13 3 := by decide\n202\t  exact ⟨hp, hnb, hno, fun h => hno (h 9 13 3 hp), ⟨9, 13, 3, hp, hnb⟩⟩\n203\t\n204\t/-- `corpus-spec2-m3.md` v14 §2 terdecies, strict graph of W-AG-J: write of `c1` (index 9) →`po`\n205\t`terminate(c1)` (index 11) →`sw` `join(c1)` (index 12) →`po` write of `c0` (index 15); the pair\n206\tsatisfies strict `HandoffOrderedAt` (WC5.2 C46), and the trace, whose only accesses are these two\n207\twrites, is strictly `HandoffOrdered` and has no strict `Race`. -/\n208\ttheorem W_AGJ_strict : PO ajσ ajLbls (.step 9) (.step 11) ∧\n209\t    SWS ajσ L0 ajLbls (.step 11) (.step 12) ∧ PO ajσ ajLbls (.step 12) (.step 15) ∧\n210\t    HBS ajσ L0 ajLbls (.step 9) (.step 15) ∧ HandoffOrderedS ajσ L0 ajLbls ∧\n211\t    ¬ RaceS ajσ L0 ajLbls := by\n212\t  have hkey : ∀ k (h : k < ajLbls.length), (ajLbls[k]'h).accMode ≠ none → k = 9 ∨ k = 15 := by\n213\t    decide\n214\t  have hb : HBS ajσ L0 ajLbls (.step 9) (.step 15) := by decide\n215\t  refine ⟨by decide, by decide, by decide, hb, handoffOrderedS_of_two hkey (by decide) ?_,\n216\t    not_raceS_of_two hkey (by decide) hb⟩\n217\t  rintro l ⟨_, c, m, ⟨-, hl, -⟩⟩\n218\t  rw [List.mem_singleton.1 hl]\n219\t  decide\n220\t\n221\t/-! ## W-AG′ -/\n222\t\n223\t/-- A1, `c1 : y := derive(x, Modify, {T})`, authority 7 (O1). -/\n224\tdef ap1 : SC := ab9.set (deriveEff (ab9.view 1) 6 [3] .modify)\n225\t/-- A2, `c1 : spawn c2` yielding `y` (WC5.2 C4): context 2, initial frame 3. -/\n226\tdef ap2 : SC := spawnEff ap1 1 [7] []\n227\t/-- A3, `c1 : terminate` (WC5.2 C7): `x` is released, `y` survives and is reanchored. -/\n228\tdef ap3 : SC := termEffC ap2 1\n229\t/-- A4, `c2 : write3(T)` via `y` (O10). -/\n230\tdef ap4 : SC := ap3.set (write3Eff (ap3.view 2) [3])\n231\t\n232\t/-- The labels of W-AG′: steps 1 to 7 of W-AG, then A1 to A4. -/\n233\tdef apLbls : List Label :=\n234\t  abLbls ++ [.kernel 1 (.derive 6 [3] .modify), .spawn 1 [7] [], .terminate 1,\n235\t    .kernel 2 (.write 7 [3])]\n236\t\n237\t/-- The named states of W-AG′. -/\n238\tdef apσ (i : Nat) : SC × SyncReg × ArenaReg :=\n239\t  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ab3, regX, []), (ab4, regX, []),\n240\t    (ab5, abReg, []), (ab6, abReg, []), (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []),\n241\t    (ap1, abReg, []), (ap2, abReg, []), (ap3, abReg, []), (ap4, abReg, [])].getD i\n242\t    (ap4, abReg, [])\n243\t\n244\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG′: A1 to A4 are `ok` and admitted (O1, WC5.2 C4, C7,\n245\tO10); from the initial state, the trace is a `RunFull`. The covering descendants of `guarded`,\n246\tstep by step: `{x}` after step 7; `{x, y}` after A1 (a creation, of origin `x`, already in the\n247\tset); unchanged after A2; `{y}` after A3 (no creation; the origin of `y` goes from `x` to\n248\t`guarded`); unchanged after A4. -/\n249\ttheorem W_AGp_run : apσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 apσ apLbls ∧\n250\t    covSet ab9 3 = [6] ∧ covSet ap1 3 = [6, 7] ∧ ap1.flat.org 7 = some 6 ∧\n251\t    covSet ap2 3 = [6, 7] ∧ covSet ap3 3 = [7] ∧ ap3.A.length = ap2.A.length ∧\n252\t    ap2.flat.org 7 = some 6 ∧ ap3.flat.org 7 = some 3 ∧ covSet ap4 3 = [7] := by\n253\t  have h : Steps5R KM L0\n254\t      [(x2, regX, []), (ab3, regX, []), (ab4, regX, []), (ab5, abReg, []), (ab6, abReg, []),\n255\t        (ab7, abReg, []), (ab8, abReg, []), (ab9, abReg, []), (ap1, abReg, []), (ap2, abReg, []),\n256\t        (ap3, abReg, []), (ap4, abReg, [])]\n257\t      [.kernel 0 (.derive 0 [2] .observe), .kernel 0 (.enter [4] []), .acquire 0 0,\n258\t        .kernel 0 (.derive 5 [3] .modify), .spawn 0 [6] [], .kernel 0 .exit,\n259\t        .kernel 1 (.write 6 [3]), .kernel 1 (.derive 6 [3] .modify), .spawn 1 [7] [],\n260\t        .terminate 1, .kernel 2 (.write 7 [3])] :=\n261\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n262\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n263\t    .cons (by decide) (.acquire ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, rfl⟩) <|\n264\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n265\t    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n266\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n267\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n268\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n269\t    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n270\t    .cons (by decide) (.terminate ⟨by decide, .ok (by decide)⟩) <|\n271\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n272\t  exact ⟨rfl, runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))\n273\t    (by decide), by decide, by decide, by decide, by decide, by decide, by decide, by decide,\n274\t    by decide, by decide⟩\n275\t\n276\t/-- `corpus-spec2-m3.md` v14 §2 terdecies W-AG′, negative after A3: `c0 : resetLock(e)` is refused;\n277\tC18.2 fails, `y` being an active descendant of `guarded` covering `T`. -/\n278\ttheorem W_AGp_neg : (∀ st', ¬ ResetLockOk L0 ap3 abReg 0 0 st') ∧ CoveringDesc ap3 3 7 := by\n279\t  refine ⟨?_, by decide⟩\n280\t  rintro st' ⟨-, e, he, -, hn, -⟩\n281\t  cases he\n282\t  exact absurd hn (by decide)\n283\t\n284\tend Ern.Concurrency.FullEncap.AbandonedGrant\n285\t"}]}}
