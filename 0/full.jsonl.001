{"parentUuid":"264ddc25-b695-45a1-ada3-87f7e99f861c","isSidechain":false,"attachment":{"type":"file","filename":"/private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/verif/zz_lens_f_check.lean","content":{"type":"text","file":{"filePath":"/private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/verif/zz_lens_f_check.lean","content":"import Ern.MM23\nopen Ern.MM03 Ern.MM23\n\nnamespace ZZ\n\ndef sNoRoot : S3 :=\n  { F := [0], nF := 1, P := [⟨none, .frame 0, 0⟩], I := fun _ => .uninit, A := [],\n    D := fun _ => [], dead := fun _ => false, freed := fun _ => false, pin := fun _ => false,\n    arenas := [], callParams := fun _ => [] }\n\ntheorem wf_noRoot : WF3 sNoRoot := by\n  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n  · intro b y; simp [sNoRoot]\n  · intro a x; simp [sNoRoot]\n  · decide\n  · decide\n  · decide\n  · intro q pl f hq ho\n    match q, hq with\n    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho; decide\n  · intro q pl o hq ho\n    match q, hq with\n    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho\n  · intro q pl r hq hp\n    match q, hq with\n    | 0, hq => simp [sNoRoot] at hq; subst hq; cases hp\n  · intro a y hy; simp [sNoRoot] at hy\n  · intro a y l hy; simp [sNoRoot] at hy\n  · intro x z l r hz; simp [sNoRoot] at hz\n\ntheorem noRoot_usable : RootPlace sNoRoot.P 0 ∧ sNoRoot.Usable 0 ∧ sNoRoot.A = [] := by decide\ntheorem noRoot_not_rootLive : ¬ RootLive sNoRoot := fun h => by\n  obtain ⟨i, z, pr, hz, -⟩ := h 0 (by decide) (by decide)\n  simp [sNoRoot] at hz\n\ndef sCyc : S3 :=\n  { F := [0], nF := 1, P := [⟨none, .place 1, 0⟩, ⟨none, .place 0, 0⟩], I := fun _ => .uninit,\n    A := [], D := fun _ => [], dead := fun _ => false, freed := fun _ => false,\n    pin := fun _ => false, arenas := [], callParams := fun _ => [] }\n\ntheorem wf_cyc : WF3 sCyc := by\n  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n  · intro b y; simp [sCyc]\n  · intro a x; simp [sCyc]\n  · decide\n  · decide\n  · decide\n  · intro q pl f hq ho\n    match q, hq with\n    | 0, hq => simp [sCyc] at hq; subst hq; cases ho\n    | 1, hq => simp [sCyc] at hq; subst hq; cases ho\n  · intro q pl o hq ho\n    match q, hq with\n    | 0, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n    | 1, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n  · intro q pl r hq hp\n    match q, hq with\n    | 0, hq => simp [sCyc] at hq; subst hq; cases hp\n    | 1, hq => simp [sCyc] at hq; subst hq; cases hp\n  · intro a y hy; simp [sCyc] at hy\n  · intro a y l hy; simp [sCyc] at hy\n  · intro x z l r hz; simp [sCyc] at hz\n\ntheorem cyc_P : sCyc.P[0]? = some ⟨none, .place 1, 0⟩ ∧ sCyc.P[1]? = some ⟨none, .place 0, 0⟩ := by decide\n\n#print axioms wf_noRoot\n#print axioms wf_cyc\n\nopen Cases\ndef Tok (tok : Nat → Nat) (L : Layout) (s3 : S3) (s2 : Ern.MM02.State) : Prop :=\n  ∀ r < s3.P.length, RootPlace s3.P r → OptP (s3.P[r]?) (fun pl =>\n    OptP (tokOf tok pl.owner) (fun d => ∀ l ∈ footprint s3.P r,\n      AllocP s2 (L l).alloc (·.freeAuth = some d)) True) True\nset_option synthInstance.maxSize 4096 in\ninstance (tok : Nat → Nat) (L : Layout) (s3 : S3) (s2 : Ern.MM02.State) : Decidable (Tok tok L s3 s2) := by\n  unfold Tok; infer_instance\n\n-- Lsa (Cases): besides K1 (a), the clause `tokens` of Repr also fails\nexample : Repr tk L e6 m3x ∧ Tok tk L e6 m3x ∧ ¬ Tok tk Lsa e6 m3x := by decide\nexample : (m3x.allocs 4).map (·.freeAuth) = some none ∧ (e6.P[3]?).map (·.owner) = some (.frame 1) := by decide\n-- Lwi: tokens holds\nexample : Tok tk Lwi e1 m1 := by decide\n-- variant: fresh allocation with the frame token, only (a) can fail\ndef m3y : Ern.MM02.State := exec m3 [.alloc 0 (topPlacement m3 (g 0)) 8 4 (some 101)]\nexample : Tok tk Lsa e6 m3y := by decide\nend ZZ\n","numLines":87,"startLine":1,"totalLines":87}},"displayPath":"../../../../../../private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/verif/zz_lens_f_check.lean"},"type":"attachment","uuid":"661fe249-478f-40e5-907c-d1a86a14a77b","timestamp":"2026-10-31T22:24:19.808Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/verif/zz_lens_f_check.lean\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\timport Ern.MM23\n2\topen Ern.MM03 Ern.MM23\n3\t\n4\tnamespace ZZ\n5\t\n6\tdef sNoRoot : S3 :=\n7\t  { F := [0], nF := 1, P := [⟨none, .frame 0, 0⟩], I := fun _ => .uninit, A := [],\n8\t    D := fun _ => [], dead := fun _ => false, freed := fun _ => false, pin := fun _ => false,\n9\t    arenas := [], callParams := fun _ => [] }\n10\t\n11\ttheorem wf_noRoot : WF3 sNoRoot := by\n12\t  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n13\t  · intro b y; simp [sNoRoot]\n14\t  · intro a x; simp [sNoRoot]\n15\t  · decide\n16\t  · decide\n17\t  · decide\n18\t  · intro q pl f hq ho\n19\t    match q, hq with\n20\t    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho; decide\n21\t  · intro q pl o hq ho\n22\t    match q, hq with\n23\t    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho\n24\t  · intro q pl r hq hp\n25\t    match q, hq with\n26\t    | 0, hq => simp [sNoRoot] at hq; subst hq; cases hp\n27\t  · intro a y hy; simp [sNoRoot] at hy\n28\t  · intro a y l hy; simp [sNoRoot] at hy\n29\t  · intro x z l r hz; simp [sNoRoot] at hz\n30\t\n31\ttheorem noRoot_usable : RootPlace sNoRoot.P 0 ∧ sNoRoot.Usable 0 ∧ sNoRoot.A = [] := by decide\n32\ttheorem noRoot_not_rootLive : ¬ RootLive sNoRoot := fun h => by\n33\t  obtain ⟨i, z, pr, hz, -⟩ := h 0 (by decide) (by decide)\n34\t  simp [sNoRoot] at hz\n35\t\n36\tdef sCyc : S3 :=\n37\t  { F := [0], nF := 1, P := [⟨none, .place 1, 0⟩, ⟨none, .place 0, 0⟩], I := fun _ => .uninit,\n38\t    A := [], D := fun _ => [], dead := fun _ => false, freed := fun _ => false,\n39\t    pin := fun _ => false, arenas := [], callParams := fun _ => [] }\n40\t\n41\ttheorem wf_cyc : WF3 sCyc := by\n42\t  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n43\t  · intro b y; simp [sCyc]\n44\t  · intro a x; simp [sCyc]\n45\t  · decide\n46\t  · decide\n47\t  · decide\n48\t  · intro q pl f hq ho\n49\t    match q, hq with\n50\t    | 0, hq => simp [sCyc] at hq; subst hq; cases ho\n51\t    | 1, hq => simp [sCyc] at hq; subst hq; cases ho\n52\t  · intro q pl o hq ho\n53\t    match q, hq with\n54\t    | 0, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n55\t    | 1, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n56\t  · intro q pl r hq hp\n57\t    match q, hq with\n58\t    | 0, hq => simp [sCyc] at hq; subst hq; cases hp\n59\t    | 1, hq => simp [sCyc] at hq; subst hq; cases hp\n60\t  · intro a y hy; simp [sCyc] at hy\n61\t  · intro a y l hy; simp [sCyc] at hy\n62\t  · intro x z l r hz; simp [sCyc] at hz\n63\t\n64\ttheorem cyc_P : sCyc.P[0]? = some ⟨none, .place 1, 0⟩ ∧ sCyc.P[1]? = some ⟨none, .place 0, 0⟩ := by decide\n65\t\n66\t#print axioms wf_noRoot\n67\t#print axioms wf_cyc\n68\t\n69\topen Cases\n70\tdef Tok (tok : Nat → Nat) (L : Layout) (s3 : S3) (s2 : Ern.MM02.State) : Prop :=\n71\t  ∀ r < s3.P.length, RootPlace s3.P r → OptP (s3.P[r]?) (fun pl =>\n72\t    OptP (tokOf tok pl.owner) (fun d => ∀ l ∈ footprint s3.P r,\n73\t      AllocP s2 (L l).alloc (·.freeAuth = some d)) True) True\n74\tset_option synthInstance.maxSize 4096 in\n75\tinstance (tok : Nat → Nat) (L : Layout) (s3 : S3) (s2 : Ern.MM02.State) : Decidable (Tok tok L s3 s2) := by\n76\t  unfold Tok; infer_instance\n77\t\n78\t-- Lsa (Cases): besides K1 (a), the clause `tokens` of Repr also fails\n79\texample : Repr tk L e6 m3x ∧ Tok tk L e6 m3x ∧ ¬ Tok tk Lsa e6 m3x := by decide\n80\texample : (m3x.allocs 4).map (·.freeAuth) = some none ∧ (e6.P[3]?).map (·.owner) = some (.frame 1) := by decide\n81\t-- Lwi: tokens holds\n82\texample : Tok tk Lwi e1 m1 := by decide\n83\t-- variant: fresh allocation with the frame token, only (a) can fail\n84\tdef m3y : Ern.MM02.State := exec m3 [.alloc 0 (topPlacement m3 (g 0)) 8 4 (some 101)]\n85\texample : Tok tk Lsa e6 m3y := by decide\n86\tend ZZ\n87\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
