ority derived from a","-companion of the pool and covering a leaf of an entry \"porte la génération courante de l'entrée\":","-it is, or descends from, an entry authority of that entry tagged with its current generation, and","-the entry is live; (3) every active companion has as active descendants only the entry authorities","-of its resolution. -/","+/-- Second clause of `PoolInv` (material §4), literally, for the pool `pl`: every active authority","+derived from a companion of the pool and covering a leaf of an entry \"porte la génération courante","+de l'entrée\": it is, or descends from, an entry authority of that entry tagged with its current","+generation; and the entry is live. -/","+def PoolInvGen (ps : PS) (pl : Pool) : Prop :=","+  ∀ r ∈ ps.res, r.pool = pl.id → ∀ j ∈ List.range ps.s.A.length, ps.s.Active j →","+    r.comp ∈ ps.s.ancs j → ∀ i ∈ List.range pl.slots.length,","+      (∃ l ∈ ps.s.afp j, l ∈ footprint ps.s.P (slotPlace pl i)) →","+      OptP (pl.slots[i]?) (fun sl => sl.live = true ∧ ∃ e ∈ r.entries, e.2.1 = i ∧","+        e.2.2 = sl.gen ∧ (e.1 = j ∨ e.1 ∈ ps.s.ancs j)) False","+","+instance (ps : PS) (pl : Pool) : Decidable (PoolInvGen ps pl) := by","+  unfold PoolInvGen; infer_instance","+","+/-- Third clause of `PoolInv` (material §4), literally, for the pool `pl`: \"toute compagne active a","+au plus les autorités d'entrée de sa résolution pour descendants\", read on active descendants. -/","+def PoolInvDesc (ps : PS) (pl : Pool) : Prop :=","+  ∀ r ∈ ps.res, r.pool = pl.id → ps.s.Active r.comp → ∀ j ∈ List.range ps.s.A.length,","+    ps.s.Active j → r.comp ∈ ps.s.ancs j → j ∈ r.entries.map (·.1)","+","+instance (ps : PS) (pl : Pool) : Decidable (PoolInvDesc ps pl) := by","+  unfold PoolInvDesc; infer_instance","+","+/-- First clause of `PoolInv` (material §4) for the pool `pl`: entries pairwise disjoint and within","+the storage. -/","+def PoolInvDisj (ps : PS) (pl : Pool) : Prop :=","+  (∀ i₁ ∈ List.range pl.slots.length, ∀ i₂ ∈ List.range pl.slots.length, i₁ ≠ i₂ →","+    ∀ l ∈ footprint ps.s.P (slotPlace pl i₁), l ∉ footprint ps.s.P (slotPlace pl i₂)) ∧","+  ∀ sl ∈ pl.slots, ∀ l ∈ footprint ps.s.P sl.place, l ∈ footprint ps.s.P pl.storage","+","+instance (ps : PS) (pl : Pool) : Decidable (PoolInvDisj ps pl) := by","+  unfold PoolInvDisj; infer_instance","+","+/-- `PoolInv` of the material (§4), literally, for every live pool (`internal` active): the three","+clauses `PoolInvDisj`, `PoolInvGen` and `PoolInvDesc`. -/"," def PoolInv (ps : PS) : Prop :=","   ∀ pl ∈ ps.pools, ps.s.Active pl.internal →","-    (∀ i₁ ∈ List.range pl.slots.length, ∀ i₂ ∈ List.range pl.slots.length, i₁ ≠ i₂ →","-      ∀ l ∈ footprint ps.s.P (slotPlace pl i₁), l ∉ footprint ps.s.P (slotPlace pl i₂)) ∧","-    (∀ sl ∈ pl.slots, ∀ l ∈ footprint ps.s.P sl.place, l ∈ footprint ps.s.P pl.storage) ∧","-    (∀ r ∈ ps.res, r.pool = pl.id → ∀ j ∈ List.range ps.s.A.length, ps.s.Active j →","-      r.comp ∈ ps.s.ancs j → ∀ i ∈ List.range pl.slots.length,","-        (∃ l ∈ ps.s.afp j, l ∈ footprint ps.s.P (slotPlace pl i)) →","-        OptP (pl.slots[i]?) (fun sl => sl.live = true ∧ ∃ e ∈ r.entries, e.2.1 = i ∧","-          e.2.2 = sl.gen ∧ (e.1 = j ∨ e.1 ∈ ps.s.ancs j)) False) ∧","-    (∀ r ∈ ps.res, r.pool = pl.id → ps.s.Active r.comp → ∀ j ∈ List.range ps.s.A.length,","-      ps.s.Active j → r.comp ∈ ps.s.ancs j → j ∈ r.entries.map (·.1))","-","-example (ps : PS) (pl : Pool) (r : Res) (j : Nat) : Decidable (∀ i ∈ List.range pl.slots.length,","-        (∃ l ∈ ps.s.afp j, l ∈ footprint ps.s.P (slotPlace pl i)) →","-        OptP (pl.slots[i]?) (fun sl => sl.live = true ∧ ∃ e ∈ r.entries, e.2.1 = i ∧","-          e.2.2 = sl.gen ∧ (e.1 = j ∨ e.1 ∈ ps.s.ancs j)) False) := inferInstance","-example (ps : PS) (pl : Pool) : Decidable (∀ i₁ ∈ List.range pl.slots.length, ∀ i₂ ∈ List.range pl.slots.length, i₁ ≠ i₂ →","-      ∀ l ∈ footprint ps.s.P (slotPlace pl i₁), l ∉ footprint ps.s.P (slotPlace pl i₂)) := inferInstance","-example (ps : PS) (pl : Pool) : Decidable (∀ r ∈ ps.res, r.pool = pl.id → ps.s.Active r.comp → ∀ j ∈ List.range ps.s.A.length,","-      ps.s.Active j → r.comp ∈ ps.s.ancs j → j ∈ r.entries.map (·.1)) := inferInstance","+    PoolInvDisj ps pl ∧ PoolInvGen ps pl ∧ PoolInvDesc ps pl","+","+instance (ps : PS) : Decidable (PoolInv ps) := by unfold PoolInv; infer_instance"," "," end Ern.HandlePool"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/HandlePool.lean"]}},"serverClassifierContext":{"request":"74a9857f-39a8-49cd-a9d7-0044965a13ab","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/validation_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"b58ff2fe-6242-48ad-8af5-3dfe841d2e33","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/validation_0.1","slug":"effervescent-gathering-wind"}
