n4124-def FreeDeact (s : S3) (p a : Nat) : Prop :=\n4125-  OptP (s.A[a]?) (fun z => z.active = true ∧ ((∃ l ∈ z.footprint, l ∈ footprint s.P p) ∨\n4126-    heldIn s.P p z.holder ∨ ¬ HolderLive (freeS s p) z.holder)) False\n4127-\n--\n4134:def FreeAccessOK (s : S3) (p j : Nat) : Prop :=\n4135-  OptP (s.A[j]?) (fun y => y.active = true → y.origin ≠ none →\n4136-    ((∃ l ∈ y.footprint, FreedLeaf s p l) ∨ ∃ a ∈ s.ancs j, FreeDeact s p a) →\n4137-      heldIn s.P p y.holder ∨ ¬ HolderLive (freeS s p) y.holder) True\n4138-\n4139-instance (s : S3) (p j : Nat) : Decidable (FreeAccessOK s p j) := by\n4140-  unfold FreeAccessOK OptP; split <;> infer_instance\n4141-\n4142-/-- Anchor `x` survives the release of `p` (A6): it covers no leaf of `p`, is not held within\n4143-`p`, and its holder stays live. -/\n4144:def FreeAnchorOK (s : S3) (p x : Nat) : Prop :=\n4145-  OptP (s.A[x]?) (fun y => ¬ (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∧ ¬ heldIn s.P p y.holder ∧\n4146-    HolderLive (freeS s p) y.holder) True\n4147-\n4148-instance (s : S3) (p x : Nat) : Decidable (FreeAnchorOK s p x) := by\n4149-  unfold FreeAnchorOK OptP; split <;> infer_instance\n4150-\n4151-/-- Preconditions of `free p auth` (A6), in order: `p` deallocable by the allocator contract\n4152-(`Deallocable`) and `auth` a compatible deallocation authority (`FreeCompat`, MM-03.3.8); `p` a\n4153-usable owned root (a part is not a unit of storage, and `WF3` gives a part the `dead` flag of its\n4154-parent); exercisable `Modify` on `p` (B2); no active derived authority on a freed leaf, or\n4155-descending from a deactivated authority, held elsewhere and staying live; no usable place\n4156-anchored on an authority covering `p`, held within `p`, or whose holder dies; no freed leaf\n8755:abbrev K0 : K := KT [] [] [] [] []\n8756-\n8757-theorem KT_dd (sh pinned done dealloc : List Nat) (compat : List (Nat × Nat)) :\n8758-    DDSound (KT sh pinned done dealloc compat) := fun _ _ h => h.elim\n--\n8810:abbrev KA : K := KT [0] 