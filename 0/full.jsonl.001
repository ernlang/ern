ld a' p b m' y hy ha hle hp hb hc ih =>","+    intro hlt","+    rw [addAuth_lt hlt] at hy","+    by_cases hbl : b < s.A.length","+    · exact .held hy ha hle hp (ih hbl) fun l hl => allows_addAuth_back hbl (hc l hl)","+    · have hbe : b = s.A.length := by","+        have := hb.lt; simp [S3.addAuth] at this; omega","+      subst hbe","+      refine .held hy ha hle hp (exercisable_of_modify hsrc) fun l hl => ?_","+      obtain ⟨x, hx, hlx⟩ := mem_of_allows (hc l hl)","+      rw [addAuth_self] at hx; cases hx","+      rw [hfp l hlx]; exact allows_some_modify m'","+","+/-- `HasRight` in the state where the block `y₀` is added, on a place none of whose leaves the block","+covers, comes from `HasRight` before. -/","+theorem hasRight_addAuth_back {s : S3} {y₀ : Authority} {src p : Nat} {m : Mode}","+    (hsrc : s.ExercisableAt src .modify)","+    (hfp : ∀ l ∈ y₀.footprint, effective s src l = some .modify)","+    (hout : ∀ l ∈ footprint s.P p, l ∉ y₀.footprint) (h : HasRight (s.addAuth y₀) m p) :","+    HasRight s m p := by","+  obtain ⟨a, -, ha, hall⟩ := h","+  by_cases hlt : a < s.A.length","+  · exact ⟨a, List.mem_range.2 hlt, exercisable_addAuth_back hsrc hfp ha hlt,","+      fun l hl => allows_addAuth_back hlt (hall l hl)⟩","+  · have hae : a = s.A.length := by","+      have := ha.lt; simp [S3.addAuth] at this; omega","+    subst hae","+    obtain ⟨l, hl⟩ : ∃ l, l ∈ footprint s.P p := by","+      by_contra hn; push_neg at hn","+      exact absurd ha (by","+        intro he; exact absurd he (by","+          intro _; exact (hn 0) (by exact absurd (hall 0) (by simp_all)) ))","+    obtain ⟨x, hx, hlx⟩ := mem_of_allows (hall l hl)","+    rw [addAuth_self] at hx; cases hx","+    exact absurd hlx (hout l hl)","+"," end Ern.Derived.Arena"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Derived/Arena.lean"]}},"serverClassifierContext":{"request":"9b740861-c753-4dea-a83e-57d8150008ea","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernla