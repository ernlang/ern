"  (sim_of (KT_dd _ _ _ _ _) (by decide) (by decide) (by decide) (by decide)).imp\n    fun _ h => ⟨h.1, h.2.1, h.2.2.1⟩\n\n/-- **MM23-H05**\"\"\",\"\"\"  (sim_of (P := P3) (z := []) (KT_dd _ _ _ _ _) (by decide) (by decide) (by decide)\n    (by decide)).imp fun _ h => ⟨h.1, h.2.1, h.2.2.1⟩\n\n/-- **MM23-H05**\"\"\")\ns=s.replace(\"\"\"    (sim_of KL_dd (by decide) (by decide) trivial (by decide)).imp fun _ h => ⟨h.1, h.2.2.1⟩⟩\"\"\",\"\"\"    (sim_of (P := P4) (z := []) KL_dd (by decide) (by decide) (by decide) (by decide)).imp\n      fun _ h => ⟨h.1, h.2.2.1⟩⟩\"\"\")\ns=s.replace(\"\"\"  ⟨(sim_of (KT_dd _ _ _ _ _) (by decide) (by decide) trivial (by decide)).imp\n    fun _ h => ⟨h.1, h.2.2.1⟩, by decide, by decide, by decide, by decide, by decide, by decide⟩\"\"\",\"\"\"  ⟨(sim_of (P := P5) (z := []) (KT_dd _ _ _ _ _) (by decide) (by decide) (by decide)\n    (by decide)).imp fun _ h => ⟨h.1, h.2.2.1⟩, by decide, by decide, by decide, by decide,\n    by decide, by decide⟩\"\"\")\ns=s.replace(\"\"\"  ⟨(sim_of (KT_dd _ _ _ _ _) (by decide) (by decide) trivial (by decide)).imp\n    fun _ h => ⟨h.1, h.2.2.1⟩, by decide, by decide, by decide, by decide⟩\"\"\",\"\"\"  ⟨(sim_of (P := P6) (z := []) (KT_dd _ _ _ _ _) (by decide) (by decide) (by decide)\n    (by decide)).imp fun _ h => ⟨h.1, h.2.2.1⟩, by decide, by decide, by decide, by decide⟩\"\"\")\ns=s.replace(\"\"\"  ⟨(sim_of (KT_dd _ _ _ _ _) (by decide) (by decide) trivial (by decide)).imp\n    fun _ h => ⟨h.1, h.2.1⟩, by decide, .fail (by decide) (fun h => h)⟩\"\"\",\"\"\"  ⟨(sim_of (P := P7) (z := [2]) (KT_dd _ _ _ _ _) (by decide) (by decide) (by decide)\n    (by decide)).imp fun _ h => ⟨h.1, h.2.1⟩, by decide, .fail (by decide) (fun h => h)⟩\"\"\")\ns=s.replace(\"\"\"  exact ⟨hc.1, hc.2, by decide, by decide, fun a h => by\n    have : r1b.I 1 = .moved := by decide\n    rw [this] at h; cases h.2.1⟩\"\"\",\"\"\"  exact ⟨hc.1, hc.2, by decide, by decide, fun a h => by\n    have h2 := h.2.1\n    rw [show r1b.I 1 = .moved by decide] at h2; cases h2⟩\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n 'paramsOf' Ern/MM23/Horrors.lean | head; time ~/.elan/bin/lake build Ern.MM23.Horrors 2>&1 | grep -v '^✔' | grep -E '^error|warning' | head -40","description":"Make layouts explicit and fix proofs, rebuild","timeout":600000},"caller":{"type":"direct"}}]}}
