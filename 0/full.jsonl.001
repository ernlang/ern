-11-14T07:52:59.919Z","advisorModel":"claude-fable-5-2","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"parentUuid":"8eb2ea26-2832-4e86-88fb-87147146f145","isSidechain":false,"promptId":"c6363317-3632-459e-8779-ebed992e8329","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017aqvukuAdwhzZqByvqMb3L","type":"tool_result","content":"/-- Along the transfer phases, every source has, for every leaf of its footprint in the state\nbefore the step, an authority of the creator attributable without a live `guarded` with\neffective `Modify` there (WC5.2 C5.2, C43). -/\ntheorem phases_cap {s : SC} {reg : SyncReg} {c : Nat}\n    (hfp : ∀ (a : Nat) (y : Authority), s.A[a]? = some y → ∀ l ∈ y.footprint, l < s.P.length)\n    (htop : s.nF ≠ (s.view c).top) (hne : s.stk c ≠ []) :\n    ∀ (t : SC) (vs : List (Nat × Nat)), PhaseRel s c t →\n      (∀ v ∈ vs, s.P.length ≤ v.2 ∧ v.2 < t.P.length) → ValRightsG reg c t vs →\n      ∀ v ∈ vs, ∀ l ∈ footprint s.P v.1, ∃ x ∈ List.range s.A.length,\n        Attr5 s reg c x .modify ∧ Allows (effective s.flat x l) .modify\n  | _, [], _, _, _ => fun _ hv => (List.not_mem_nil hv).elim\n  | t, w :: vs, h, hd, ⟨⟨hr, _⟩, hrest⟩ => by\n    intro v hv l hl\n    rcases List.mem_cons.1 hv with rfl | hv\n    · obtain ⟨a, -, hx, hall⟩ := hr\n      obtain ⟨ha, hx'⟩ := exer5_back h hfp htop hx\n      have hl1 := (mem_footprint.1 hl).1\n      have hq : v.1 < s.P.length := Nat.lt_of_le_of_lt (fp_ge hl) hl1\n      refine ⟨a, List.mem_range.2 ha, Exer5.attr5 hne hx', ?_⟩\n      rw [← h.eff a l ha hl1]\n      exact hall l ((h.fpOld v.1 hq l).2 hl)\n    · obtain ⟨hd1, hd2⟩ := hd w (List.mem_cons_self ..)\n      have h' := phaseRel_transfer (src := w.1) h hd1 hd2\n      have hlen : (transferEffC t c w.1 w.2).P.length = t.P.length := by\n        show (transferEff (t.view c) w.1 w.2).P.length = _; rw [transfer_len]; rfl\n      exact phases_cap hfp htop hne _ vs h'\n        (fun u hu => by rw [hlen]; exact hd u (List.mem_cons_of_mem _ hu)) hrest v hv l hl\n\n/-- An `ok` by-value `spawn` is executed by a live context under its preconditions (WC5.2 C4,\nC5). -/\ntheorem spawnVal_pre {k : K} {L : MutexLayout} {c : Nat} {ps : List Nat} {ls : LocalShape}\n    {vs : List (Nat × Nat)} {st st' : SC × SyncReg × ArenaReg}\n    (h : LStep k L (.spawnVal c ps ls vs) st st') :\n    st.1.Live c ∧ SpawnValPre k st.1 c ps ls vs := by\n  cases h with\n  | spawnVal hv => exact ⟨hv.1, (Guarded.ok_iff.1 hv.2).1⟩\n\n/-- Brief of the complement, task 4: on a `RunFull` from the initial state, under `DDSound`, a\nby-value `spawn` step of `c` is made with, for every leaf of every source in the state before the\nstep, an authority attributable to `c` without a live `guarded` with effective `Modify` on it\n(WC5.2 C5.2, C43), so with `cap5(c, l) = Modify`. -/\ntheorem spawnVal_cap_pre {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {c : Nat} {ps : List Nat}\n    {ls : LocalShape} {vs : List (Nat × Nat)} (hl : lbls[i] = .spawnVal c ps ls vs) :\n    ∀ v ∈ vs, ∀ l ∈ footprint (σ i).1.P v.1,\n      (∃ x ∈ List.range (σ i).1.A.length, Attr5 (σ i).1 (σ i).2.1 c x .modify ∧\n        Allows (effective (σ i).1.flat x l) .modify) ∧\n      Allows (cap5 (σ i).1 (σ i).2.1 c l) .modify := by\n  obtain ⟨hk, -⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n  have hs := (h i hi).2\n  have hp := (h i hi).1.2\n  rw [hl] at hs hp\n  obtain ⟨hlive, hpre⟩ := spawnVal_pre hs\n  have hF := hk.parts.1\n  have hw := hk.parts.2.1\n  have hne := hF.nonempty c hlive\n  have hfp : ∀ (a : Nat) (y : Authority), (σ i).1.A[a]? = some y →\n      ∀ l ∈ y.footprint, l < (σ i).1.P.length := fun a y hy l hl =>\n    (hw.footprints a y hy l hl).1\n  have htop : (σ i).1.nF ≠ ((σ i).1.view c).top := by\n    intro he\n    have hmem : ((σ i).1.view c).top ∈ (σ i).1.frames := by\n      have hc : c < (σ i).1.C.length := by\n        unfold SC.Live at hlive\n        cases hx : (σ i).1.C[c]? with\n        | none => rw [hx] at hlive; exact hlive.elim\n        | some x => exact (List.getElem?_eq_some_iff.1 hx).1\n      exact List.mem_flatMap.2 ⟨c, List.mem_range.2 hc, view_top_mem hne⟩\n    have := hF.bound _ hmem\n    omega\n  have hb₀ := spawn_base (ps := []) (ls := ls) hk hne (fun _ h => by cases h) hpre.localsOK\n  have h₀ := phaseRel_create (c := c) hb₀.2.1 hpre.localsOK hlive hne\n  have hd : ∀ v ∈ vs, (σ i).1.P.length ≤ v.2 ∧ v.2 < (spawnCreate (σ i).1 c ls).P.length := by\n    intro v hv\n    obtain ⟨j, hj, he⟩ := hpre.freshDst v hv\n    have hjl : j < ls.toShape.length := List.mem_range.1 (List.mem_filter.1 hj).1\n    have hlen : (spawnCreate (σ i).1 c ls).P.length = (σ i).1.P.length + ls.toShape.length := by\n      show (shapeP (σ i).1.P _ _).length = _; simp [shapeP]\n    rw [he, hlen]; exact ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hjl _⟩\n  intro v hv l hl\n  obtain ⟨x, hx, hax, hex⟩ := phases_cap hfp htop hne _ vs h₀ hd hp v hv l hl\n  exact ⟨⟨x, hx, hax, hex⟩, cap5_of hax hex⟩\n\nend Ern.Concurrency.FullEncap\n      OptP (st.1.A[g]?) (fun y => HolderRightG (st.1, st.2.1) c y.holder) False) False ∧\n      CtrlRight5 L (st.1, st.2.1) e c) False\n  | .resetLock c i => ResetExerG (st.1, st.2.1) c i ∧\n      OptP (st.2.1[i]?) (fun e => CtrlRight5 L (st.1, st.2.1) e c) False\n  | .spawnVal c _ ls vs => ValRightsG st.2.1 c (spawnCreate st.1 c ls) vs\n  | .newArena c storage internal => HasRight5 (st.1, st.2.1) c .modify storage ∧\n      Exer5 st.1 st.2.1 c internal .modify\n  | .issue c i region dst => OptP (st.2.2[i]?) (fun E => MetaRightG (st.1, st.2.1) c E ∧\n      HasRight5 (st.1, st.2.1) c .modify dst ∧ Exer5 st.1 st.2.1 c E.internal .modify ∧\n      HasRight5 (issueMid st.1 c E region, st.2.1) c .modify dst ∧\n      HasRight5 (storeEffC (issueMid st.1 c E region) c st.1.A.length dst, st.2.1) c .modify dst)\n      False\n  | .reset c i => OptP (st.2.2[i]?) (fun E => Exer5 st.1 st.2.1 c E.internal .modify ∧\n      OptP ((resetMid st.1 c E).A[st.1.A.length]?)\n        (fun y => HolderRightG (resetMid st.1 c E, st.2.1) c y.holder) False) False\n  | _ => True\n\n/-- Decidability of `PremG`. -/\ninstance (k : K) [DecidablePred k.SharedMutable] (L : MutexLayout) (st : SC × SyncReg × ArenaReg)\n    (lbl : Label) : Decidable (PremG k L st lbl) := by\n  unfold PremG; split <;> infer_instance\n\n/-- The complete encapsulation of a step from `st` to `st'` (brief of slice 3): `Encap7` and the\nguard-free forms of the inventory. -/\ndef EncapFull (k : K) (L : MutexLayout) (st : SC × SyncReg × ArenaReg) (lbl : Label)\n    (st' : SC × SyncReg × ArenaReg) : Prop :=\n  Encap7 k L st lbl st' ∧ PremG k L st lbl\n\n/-- `RunFull` (brief of slice 3): a run with named states every step of which satisfies\n`EncapFull` and is an `ok` step. -/\ndef RunFull (k : K) (L : MutexLayout) (σ : Nat → SC × SyncReg × ArenaReg) (lbls : List Label) :\n    Prop :=\n  ∀ i (h : i < lbls.length), EncapFull k L (σ i) lbls[i] (σ (i + 1)) ∧\n    LStep k L lbls[i] (σ i) (σ (i + 1))\n\n/-! ## Each guard-free form entails its premise -/\n\n/-- `OutsideG` entails the source-access clause of `transfer` (Spec 1 §63.4). -/\ntheorem outside_of_outsideG {s : SC} {reg : SyncReg} {c src : Nat} (h : OutsideG (s, reg) c src) :\n    Outside s c src := by\n  obtain ⟨g, hg, hgr, hall⟩ := h\n  exact ⟨g, hg, grounds_of_groundsG hgr, hall⟩\n\n/-- `ValRightsG` entails the right premises of the transfer phases (WC5.2 C5.2). -/\ntheorem valRights_of_G {reg : SyncReg} {c : Nat} :\n    ∀ (t : SC) (vs : List (Nat × Nat)), ValRightsG reg c t vs → ValRights c t vs\n  | _, [], _ => trivial\n  | _, _ :: vs, ⟨⟨hr, ho⟩, h⟩ =>\n    ⟨⟨hasRight_of_hasRight5 hr, outside_of_outsideG ho⟩, valRights_of_G _ vs h⟩\n\n/-- `AuthG` entails the library authorization (WC5.2 C14 items 1–3, C15 item 3). -/\ntheorem auth_of_authG {L : MutexLayout} {st : SC × SyncReg} {c g : Nat} (h : AuthG L st c g) :\n    LibSyncAuthorized L st.2 st.1 g (st.1.view c).top := by\n  obtain ⟨e, he, hg, hl, hn, hc⟩ := h\n  exact ⟨e, he, hg, hl, hn, ctrlRight_of_ctrlRight5 hc⟩\n\n/-- The view of `c` after a `store` executed by `c` is the `store` on the view (WC5.2 C2). -/\ntheorem view_storeEffC (s : SC) (c a p : Nat) :\n    (storeEffC s c a p).view c = storeEff (s.view c) a p :=\n  SC.view_set (by unfold storeEff; split <;> rfl)","is_error":false}]},"uuid":"1655a02e-c773-4a95-8114-76ee1663f679","timestamp":"2026-11-14T07:53:00.069Z","toolUseResult":{"stdout":"/-- Along the transfer phases, every source has, for every leaf of its footprint in the state\nbefore the step, an authority of the creator attributable without a live `guarded` with\neffective `Modify` there (WC5.2 C5.2, C43). -/\ntheorem phases_cap {s : SC} {reg : SyncReg} {c : Nat}\n    (hfp : ∀ (a : Nat) (y : Authority), s.A[a]? = some y → ∀ l ∈ y.footprint, l < s.P.length)\n    (htop : s.nF ≠ (s.view c).top) (hne : s.stk c ≠ []) :\n    ∀ (t : SC) (vs : List (Nat × Nat)), PhaseRel s c t →\n      (∀ v ∈ vs, s.P.length ≤ v.2 ∧ v.2 < t.P.length) → ValRightsG reg c t vs →\n      ∀ v ∈ vs, ∀ l ∈ footprint s.P v.1, ∃ x ∈ List.range s.A.length,\n        Attr5 s reg c x .modify ∧ Allows (effective s.flat x l) .modify\n  | _, [], _, _, _ => fun _ hv => (List.not_mem_nil hv).elim\n  | t, w :: vs, h, hd, ⟨⟨hr, _⟩, hrest⟩ => by\n    intro v hv l hl\n    rcases List.mem_cons.1 hv with rfl | hv\n    · obtain ⟨a, -, hx, hall⟩ := hr\n      obtain ⟨ha, hx'⟩ := exer5_back h hfp htop hx\n      have hl1 := (mem_footprint.1 hl).1\n      have hq : v.1 < s.P.length := Nat.lt_of_le_of_lt (fp_ge hl) hl1\n      refine ⟨a, List.mem_range.2 ha, Exer5.attr5 hne hx', ?_⟩\n      rw [← h.eff a l ha hl1]\n      exact hall l ((h.fpOld v.1 hq l).2 hl)\n    · obtain ⟨hd1, hd2⟩ := hd w (List.mem_cons_self ..)\n      have h' := phaseRel_transfer (src := w.1) h hd1 hd2\n      have hlen : (transferEffC t c w.1 w.2).P.length = t.P.length := by\n        show (transferEff (t.view c) w.1 w.2).P.length = _; rw [transfer_len]; rfl\n      exact phases_cap hfp htop hne _ vs h'\n        (fun u hu => by rw [hlen]; exact hd u (List.mem_cons_of_mem _ hu)) hrest v hv l hl\n\n/-- An `ok` by-value `spawn` is executed by a live context under its preconditions (WC5.2 C4,\nC5). -/\ntheorem spawnVal_pre {k : K} {L : MutexLayout} {c : Nat} {ps : List Nat} {ls : LocalShape}\n    {vs : List (Nat × Nat)} {st st' : SC × SyncReg × ArenaReg}\n    (h : LStep k L (.spawnVal c ps ls vs) st st') :\n    st.1.Live c ∧ SpawnValPre k st.1 c ps ls vs := by\n  cases h with\n  | spawnVal hv => exact ⟨hv.1, (Guarded.ok_iff.1 hv.2).1⟩\n\n/-- Brief of the complement, task 4: on a `RunFull` from the initial state, under `DDSound`, a\nby-value `spawn` step of `c` is made with, for every leaf of every source in the state before the\nstep, an authority attributable to `c` without a live `guarded` with effective `Modify` on it\n(WC5.2 C5.2, C43), so with `cap5(c, l) = Modify`. -/\ntheorem spawnVal_cap_pre {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {c : Nat} {ps : List Nat}\n    {ls : LocalShape} {vs : List (Nat × Nat)} (hl : lbls[i] = .spawnVal c ps ls vs) :\n    ∀ v ∈ vs, ∀ l ∈ footprint (σ i).1.P v.1,\n      (∃ x ∈ List.range (σ i).1.A.length, Attr5 (σ i).1 (σ i).2.1 c x .modify ∧\n        Allows (effective (σ i).1.flat x l) .modify) ∧\n      Allows (cap5 (σ i).1 (σ i).2.1 c l) .modify := by\n  obtain ⟨hk, -⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n  have hs := (h i hi).2\n  have hp := (h i hi).1.2\n  rw [hl] at hs hp\n  obtain ⟨hlive, hpre⟩ := spawnVal_pre hs\n  have hF := hk.parts.1\n  have hw := hk.parts.2.1\n  have hne := hF.nonempty c hlive\n  have hfp : ∀ (a : Nat) (y : Authority), (σ i).1.A[a]? = some y →\n      ∀ l ∈ y.footprint, l < (σ i).1.P.length := fun a y hy l hl =>\n    (hw.footprints a y hy l hl).1\n  have htop : (σ i).1.nF ≠ ((σ i).1.view c).top := by\n    intro he\n    have hmem : ((σ i).1.view c).top ∈ (σ i).1.frames := by\n      have hc : c < (σ i).1.C.length := by\n        unfold SC.Live at hlive\n        cases hx : (σ i).1.C[c]? with\n        | none => rw [hx] at hlive; exact hlive.elim\n        | some x => exact (List.getElem?_eq_some_iff.1 hx).1\n      exact List.mem_flatMap.2 ⟨c, List.mem_range.2 hc, view_top_mem hne⟩\n    have := hF.bound _ hmem\n    omega\n  have hb₀ := spawn_base (ps := []) (ls := ls) hk hne (fun _ h => by cases h) hpre.localsOK\n  have h₀ := phaseRel_create (c := c) hb₀.2.1 hpre.localsOK hlive hne\n  have hd : ∀ v ∈ vs, (σ i).1.P.length ≤ v.2 ∧ v.2 < (spawnCreate (σ i).1 c ls).P.length := by\n    intro v hv\n    obtain ⟨j, hj, he⟩ := hpre.freshDst v hv\n    have hjl : j < ls.toShape.length := List.mem_range.1 (List.mem_filter.1 hj).1\n    have hlen : (spawnCreate (σ i).1 c ls).P.length = (σ i).1.P.length + ls.toShape.length := by\n      show (shapeP (σ i).1.P _ _).length = _; simp [shapeP]\n    rw [he, hlen]; exact ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hjl _⟩\n  intro v hv l hl\n  obtain ⟨x, hx, hax, hex⟩ := phases_cap hfp htop hne _ vs h₀ hd hp v hv l hl\n  exact ⟨⟨x, hx, hax, hex⟩, cap5_of hax hex⟩\n\nend Ern.Concurrency.FullEncap\n      OptP (st.1.A[g]?) (fun y => HolderRightG (st.1, st.2.1) c y.holder) False) False ∧\n      CtrlRight5 L (st.1, st.2.1) e c) False\n  | .resetLock c i => ResetExerG (st.1, st.2.1) c i ∧\n      OptP (st.2.1[i]?) (fun e => CtrlRight5 L (st.1, st.2.1) e c) False\n  | .spawnVal c _ ls vs => ValRightsG st.2.1 c (spawnCreate st.1 c ls) vs\n  | .newArena c storage internal => HasRight5 (st.1, st.2.1) c .modify storage ∧\n      Exer5 st.1 st.2.1 c internal .modify\n  | .issue c i region dst => OptP (st.2.2[i]?) (fun E => MetaRightG (st.1, st.2.1) c E ∧\n      HasRight5 (st.1, st.2.1) c .modify dst ∧ Exer5 st.1 st.2.1 c E.internal .modify ∧\n      HasRight5 (issueMid st.1 c E region, st.2.1) c .modify dst ∧\n      HasRight5 (storeEffC (issueMid st.1 c E region) c st.1.A.length dst, st.2.1) c .modify dst)\n      False\n  | .reset c i => OptP (st.2.2[i]?) (fun E => Exer5 st.1 st.2.1 c E.internal .modify ∧\n      OptP ((resetMid st.1 c E).A[st.1.A.length]?)\n        (fun y => HolderRightG (resetMid st.1 c E, st.2.1) c y.holder) False) False\n  | _ => True\n\n/-- Decidability of `PremG`. -/\ninstance (k : K) [DecidablePred k.SharedMutable] (L : MutexLayout) (st : SC × SyncReg × ArenaReg)\n    (lbl : Label) : Decidable (PremG k L st lbl) := by\n  unfold PremG; split <;> infer_instance\n\n/-- The complete encapsulation of a step from `st` to `st'` (brief of slice 3): `Encap7` and the\nguard-free forms of the inventory. -/\ndef EncapFull (k : K) (L : MutexLayout) (st : SC × SyncReg × ArenaReg) (lbl : Label)\n    (st' : SC × SyncReg × ArenaReg) : Prop :=\n  Encap7 k L st lbl st' ∧ PremG k L st lbl\n\n/-- `RunFull` (brief of slice 3): a run with named states every step of which satisfies\n`EncapFull` and is an `ok` step. -/\ndef RunFull (k : K) (L : MutexLayout) (σ : Nat → SC × SyncReg × ArenaReg) (lbls : List Label) :\n    Prop :=\n  ∀ i (h : i < lbls.length), EncapFull k L (σ i) lbls[i] (σ (i + 1)) ∧\n    LStep k L lbls[i] (σ i) (σ (i + 1))\n\n/-! ## Each guard-free form entails its premise -/\n\n/-- `OutsideG` entails the source-access clause of `transfer` (Spec 1 §63.4). -/\ntheorem outside_of_outsideG {s : SC} {reg : SyncReg} {c src : Nat} (h : OutsideG (s, reg) c src) :\n    Outside s c src := by\n  obtain ⟨g, hg, hgr, hall⟩ := h\n  exact ⟨g, hg, grounds_of_groundsG hgr, hall⟩\n\n/-- `ValRightsG` entails the right premises of the transfer phases (WC5.2 C5.2). -/\ntheorem valRights_of_G {reg : SyncReg} {c : Nat} :\n    ∀ (t : SC) (vs : List (Nat × Nat)), ValRightsG reg c t vs → ValRights c t vs\n  | _, [], _ => trivial\n  | _, _ :: vs, ⟨⟨hr, ho⟩, h⟩ =>\n    ⟨⟨hasRight_of_hasRight5 hr, outside_of_outsideG ho⟩, valRights_of_G _ vs h⟩\n\n/-- `AuthG` entails the library authorization (WC5.2 C14 items 1–3, C15 item 3). -/\ntheorem auth_of_authG {L : MutexLayout} {st : SC × SyncReg} {c g : Nat} (h : AuthG L st c g) :\n    LibSyncAuthorized L st.2 st.1 g (st.1.view c).top := by\n  obtain ⟨e, he, hg, hl, hn, hc⟩ := h\n  exact ⟨e, he, hg, hl, hn, ctrlRight_of_ctrlRight5 hc⟩\n\n/-- The view of `c` after a `store` executed by `c` is the `store` on the view (WC5.2 C2). -/\ntheorem view_storeEffC (s : SC) (c a p : Nat) :\n    (storeEffC s c a p).view c = storeEff (s.view c) a p :=\n  SC.view_set (by unfold storeEff; split <;> rfl)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"1a82607e-3945-4eb2-a71d-55f9e136cd63","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"8eb2ea26-2832-4e86-88fb-87147146f145","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
