anch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"parentUuid":"787b1e76-ee29-47d3-b5a2-4092250bc16c","isSidechain":false,"promptId":"ad10e2fd-52be-47f7-a4f7-932245537372","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015krXxELFV64bz2CzSLLfxS","type":"tool_result","content":"175\t/-! ## Traces under an older encapsulation -/\n176\t\n177\t/-- The labels of S2 (`s2_trace`): `MX₄`, `c1 : acquire(e)`, `write3(T)`, `unlock(e)`. -/\n178\tdef s2Lbls : List Label := mx4Lbls ++ [.acquire 1 0, .kernel 1 (.write 5 [3]), .unlock 1 0]\n179\t\n180\t/-- `corpus-spec2-m3.md` §1 S2 (`s2_trace`, `cycle_trace5`) is a `RunFull` from the initial\n181\tstate: the prefix of W-RL₀ of its eight labels. -/\n182\ttheorem S2_full : (MutexEdge.rl0Lbls.take 8) = s2Lbls ∧\n183\t    RunFull KM L0 MutexEdge.rl0σ (MutexEdge.rl0Lbls.take 8) :=\n184\t  ⟨rfl, RunFull.take NonRegression.runAmF_traces_full.2.2.2.2.2.2.1 8⟩\n185\t\n186\t/-- `corpus-spec2-m3.md` §1 S10 (`s10_trace`, up to `transfer(M, M′)`) is a `RunFull` from the\n187\tinitial state: the prefix of the replayed S10 of its seven labels. -/\n188\ttheorem S10_full : RunFull KM L0 MutexReal.NonRegression.s10σ\n189\t    (MutexReal.NonRegression.s10Lbls.take 7) :=\n190\t  RunFull.take NonRegression.runAmF_traces_full.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 7\n191\t\n192\t/-- The labels of S3 in full (`s3_trace`). -/\n193\tdef s3fLbls : List Label :=\n194\t  MutexReal.NonRegression.s3Lbls ++ [.unlock 1 0, .acquire 0 0, .issue 0 0 [6] 7]\n195\t\n196\t/-- The named states of S3 in full. -/\n197\tdef s3fσ (i : Nat) : SC × SyncReg × ArenaReg :=\n198\t  [(a0, [], []), (a1, [], []), (a2, [], []), (a2, [], arA), (a3, [], arA), (a4, [], arA),\n199\t    (a4, regA, arA), (a5, regA, arA), (a6, regA, arA), (a7, regA8, arA), (a8, regA8, arA1),\n200\t    (a9, regA, arA1), (a10, regA10, arA1), (a11, regA10, arA2)].getD i (a11, regA10, arA2)\n201\t\n202\t/-- `corpus-spec2-m3.md` §1 S3 in full (`s3_trace`: the arena administered through the mutex grant,\n203\tboth issues and the reacquisition) is a `RunFull` from the initial state. -/\n204\ttheorem S3_full : s3fσ 0 = (SC.ofS3 (S3.init arst), [], []) ∧ RunFull KA L0 s3fσ s3fLbls := by\n205\t  have hn : NewMutexOk KA L0 arA a4 [] 0 5 (a4, regA) := ⟨by decide, by decide, rfl⟩\n206\t  have ha : NewArenaStepC a2 [] [] 0 4 4 (.ok (a2, arA)) := ⟨by decide, .ok (by decide)⟩\n207\t  have h : Steps5R KA L0 [(a0, [], []), (a1, [], []), (a2, [], []), (a2, [], arA), (a3, [], arA),\n208\t      (a4, [], arA), (a4, regA, arA), (a5, regA, arA), (a6, regA, arA), (a7, regA8, arA),\n209\t      (a8, regA8, arA1), (a9, regA, arA1), (a10, regA10, arA1), (a11, regA10, arA2)] s3fLbls :=\n210\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n211\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n212\t    .cons (by decide) (.newArena ha) <|\n213\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n214\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n215\t    .cons (by decide) (.newMutex hn) <|\n216\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n217\t    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n218\t    .cons (by decide) (.acquire S3_2_ok) <|\n219\t    .cons (by decide) (.issue S3_3_ok) <|\n220\t    .cons (by decide) (.unlock S3_5_ok) <|\n221\t    .cons (by decide) (.acquire S3_6_ok) <|\n222\t    .cons (by decide) (.issue S3_8_ok) .nil\n223\t  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n224\t\n225\t/-- The labels of S4 (`s4_trace`, `s4_trace5R`). -/\n226\tdef s4Lbls : List Label :=\n227\t  [.kernel 0 (.enter [] [(none, 0), (none, 0)]), .kernel 0 (.write 1 [1]),\n228\t   .kernel 0 (.write 2 [2]), .kernel 0 (.alloc 2 1 [(none, 0)]),\n229\t   .spawnVal 0 [] [(none, 0)] [(1, 4)], .kernel 0 .exit]\n230\t\n231\topen Ern.Concurrency.Traces in\n232\t/-- The named states of S4. -/\n233\tdef s4σ (i : Nat) : SC × SyncReg × ArenaReg :=\n234\t  [(q0, [], []), (q1, [], []), (q2, [], []), (q3, [], []), (q4, [], []), (q5, [], []),\n235\t    (q6, [], [])].getD i (q6, [], [])\n236\t\n237\topen Ern.Concurrency.Traces in\n238\t/-- `corpus-spec2-m3.md` §1 S4 (`s4_trace`): a detached child survives its creator; the trace is a\n239\t`RunFull` from the initial state (no mutex). -/\n240\ttheorem S4_full : s4σ 0 = (SC.ofS3 (S3.init s4st), [], []) ∧ RunFull K0 L0 s4σ s4Lbls := by\n241\t  have h : Steps5R K0 L0 [(q0, [], []), (q1, [], []), (q2, [], []), (q3, [], []), (q4, [], []),\n242\t      (q5, [], []), (q6, [], [])] s4Lbls :=\n243\t    .cons (by decide) (.kernel s4_steps.1) <| .cons (by decide) (.kernel s4_steps.2.1) <|\n244\t    .cons (by decide) (.kernel s4_steps.2.2.1) <| .cons (by decide) (.kernel s4_steps.2.2.2.1) <|\n245\t    .cons (by decide) (.spawnVal s4_steps.2.2.2.2.1) <|\n246\t    .cons (by decide) (.kernel s4_steps.2.2.2.2.2) .nil\n247\t  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n248\t\n249\t/-- The labels of S9 (`s9_trace`, `S9_1_ok`, `S9_2_ok`). -/\n250\tdef s9Lbls : List Label :=\n251\t  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .kernel 0 (.derive 3 [7] .modify),\n252\t   .kernel 0 (.store 5 5), .newMutex 0 4, .newMutex 0 5, .acquire 0 0, .acquire 0 1]\n253\t\n254\t/-- The named states of S9. -/\n255\tdef s9σ (i : Nat) : SC × SyncReg × ArenaReg :=\n256\t  [(n0, [], []), (n1, [], []), (n2, [], []), (n3, [], []), (n4, [], []), (n4, [⟨4, none⟩], []),\n257\t    (n4, reg9, []), (n5, [⟨4, some 6⟩, ⟨5, none⟩], []),\n258\t    (n6, [⟨4, some 6⟩, ⟨5, some 7⟩], [])].getD i (n6, [⟨4, some 6⟩, ⟨5, some 7⟩], [])\n259\t\n260\t/-- `corpus-spec2-m3.md` §1 S9 (two mutexes, both acquired by context 0) is admitted: the trace is\n261\ta `RunFull` from the initial state, as the corpus v14 expects. -/\n262\ttheorem S9_full : s9σ 0 = (SC.ofS3 (S3.init s9st), [], []) ∧ RunFull K9 L0 s9σ s9Lbls := by\n263\t  have h : Steps5R K9 L0 [(n0, [], []), (n1, [], []), (n2, [], []), (n3, [], []), (n4, [], []),\n264\t      (n4, [⟨4, none⟩], []), (n4, reg9, []), (n5, [⟨4, some 6⟩, ⟨5, none⟩], []),\n265\t      (n6, [⟨4, some 6⟩, ⟨5, some 7⟩], [])] s9Lbls :=\n266\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n267\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n268\t    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n269\t    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n270\t    .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|\n271\t    .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|\n272\t    .cons (by decide) (.acquire S9_1_ok.1) <|\n273\t    .cons (by decide) (.acquire S9_2_ok.1) .nil\n274\t  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n275\t\n276\t/-! ## The traces of WC4 -/\n277\t\n278\topen Ern.Concurrency.Traces in\n279\t/-- The named states of `mutex_trace` (WC4 C13, C16, C17). -/\n280\tdef mtσ (i : Nat) : SC × SyncReg × ArenaReg :=\n281\t  [(c0, [], []), (c0, reg1, []), (c2, reg2, []), (c3, reg1, [])].getD i (c3, reg1, [])\n282\t\n283\topen Ern.Concurrency.Traces in\n284\t/-- `mutex_trace` (`newMutex`, `acquire`, `unlock` from `c0`) is a `RunFull`. -/\n285\ttheorem mutex_full : RunFull K0 L0 mtσ [.newMutex 0 1, .acquire 0 0, .unlock 0 0] := by\n286\t  have h : Steps5R K0 L0 [(c0, [], []), (c0, reg1, []), (c2, reg2, []), (c3, reg1, [])]\n287\t      [.newMutex 0 1, .acquire 0 0, .unlock 0 0] :=\n288\t    .cons (by decide) (.newMutex newMutex_ok.1) <|\n289\t    .cons (by decide) (.acquire acquire_enabled) <|\n290\t    .cons (by decide) (.unlock unlock_enabled) .nil\n291\t  exact runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)\n292\t\n293\topen Ern.Concurrency.Traces in\n294\t/-- `distinct_controllers_trace` (two `newMutex` with distinct controllers from `d1`) is a\n295\t`RunFull`. -/\n296\ttheorem distinct_full : RunFull K0 L0\n297\t    (fun i => [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])].getD i\n298\t      (d1, [⟨2, none⟩, ⟨3, none⟩], [])) [.newMutex 0 2, .newMutex 0 3] := by\n299\t  have h : Steps5R K0 L0 [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])]\n300\t      [.newMutex 0 2, .newMutex 0 3] :=\n301\t    .cons (by decide) (.newMutex distinct_controllers_ok.1) <|\n302\t    .cons (by decide) (.newMutex distinct_controllers_ok.2.1) .nil\n303\t  exact runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)\n304\t\n305\topen Ern.Concurrency.EncapTraces in\n306\t/-- The named states of `traceB` (WC4 S18, transfer of the whole mutex under the grant). -/\n307\tdef tBσ (i : Nat) : SC × SyncReg × ArenaReg :=\n308\t  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (e3, reg2, []), (eB, reg2, [])].getD i\n309\t    (eB, reg2, [])\n310\t\n311\topen Ern.Concurrency.EncapTraces in\n312\t/-- The named states of `traceA` (WC4 S18, transfer of the whole mutex without grant); its prefix\n313\tof three labels is `traceMutex`. -/\n314\tdef tAσ (i : Nat) : SC × SyncReg × ArenaReg :=\n315\t  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (eA, reg1, [])].getD i\n316\t    (eA, reg1, [])\n317\t\n318\topen Ern.Concurrency.EncapTraces in\n319\t/-- `traceA`, `traceB` and `traceMutex` (`EncapTraces`, WC4) are `RunFull` traces. -/\n320\ttheorem wc4_full :\n321\t    RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n322\t      .kernel 0 (.transfer 0 4)] ∧\n323\t    RunFull K0 L0 tBσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n324\t      .acquire 0 0, .kernel 0 (.transfer 0 4)] ∧\n325\t    RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n326\t      .newMutex 0 4] := by\n327\t  have hA : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n328\t      (eA, reg1, [])] [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n329\t      .kernel 0 (.transfer 0 4)] :=\n330\t    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n331\t    .cons (by decide) (.newMutex step_newMutex.1) <|\n332\t    .cons (by decide) (.kernel stepA_transfer) .nil\n333\t  have hB : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n334\t      (e3, reg2, []), (eB, reg2, [])] [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n335\t      .newMutex 0 4, .acquire 0 0, .kernel 0 (.transfer 0 4)] :=\n336\t    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n337\t    .cons (by decide) (.newMutex step_newMutex.1) <| .cons (by decide) (.acquire step_acquire.1) <|\n338\t    .cons (by decide) (.kernel stepB_transfer) .nil\n339\t  have rA : RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n340\t      .newMutex 0 4, .kernel 0 (.transfer 0 4)] :=\n341\t    runFull_of_run7 (run7_of_run5R (hA.run (eA, reg1, [])) (by decide)) (by decide)\n342\t  exact ⟨rA, runFull_of_run7 (run7_of_run5R (hB.run (eB, reg2, [])) (by decide)) (by decide),\n343\t    RunFull.take rA 3⟩\n344\t\n345\tend Ern.Concurrency.FullEncap.Replay\n346\t"}]},"uuid":"a6d414e9-4cc0-409b-85a0-c02eca0fb932","timestamp":"2026-11-12T23:39:52.534Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/Replay.lean","content":"/-! ## Traces under an older encapsulation -/\n\n/-- The labels of S2 (`s2_trace`): `MX₄`, `c1 : acquire(e)`, `write3(T)`, `unlock(e)`. -/\ndef s2Lbls : List Label := mx4Lbls ++ [.acquire 1 0, .kernel 1 (.write 5 [3]), .unlock 1 0]\n\n/-- `corpus-spec2-m3.md` §1 S2 (`s2_trace`, `cycle_trace5`) is a `RunFull` from the initial\nstate: the prefix of W-RL₀ of its eight labels. -/\ntheorem S2_full : (MutexEdge.rl0Lbls.take 8) = s2Lbls ∧\n    RunFull KM L0 MutexEdge.rl0σ (MutexEdge.rl0Lbls.take 8) :=\n  ⟨rfl, RunFull.take NonRegression.runAmF_traces_full.2.2.2.2.2.2.1 8⟩\n\n/-- `corpus-spec2-m3.md` §1 S10 (`s10_trace`, up to `transfer(M, M′)`) is a `RunFull` from the\ninitial state: the prefix of the replayed S10 of its seven labels. -/\ntheorem S10_full : RunFull KM L0 MutexReal.NonRegression.s10σ\n    (MutexReal.NonRegression.s10Lbls.take 7) :=\n  RunFull.take NonRegression.runAmF_traces_full.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 7\n\n/-- The labels of S3 in full (`s3_trace`). -/\ndef s3fLbls : List Label :=\n  MutexReal.NonRegression.s3Lbls ++ [.unlock 1 0, .acquire 0 0, .issue 0 0 [6] 7]\n\n/-- The named states of S3 in full. -/\ndef s3fσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(a0, [], []), (a1, [], []), (a2, [], []), (a2, [], arA), (a3, [], arA), (a4, [], arA),\n    (a4, regA, arA), (a5, regA, arA), (a6, regA, arA), (a7, regA8, arA), (a8, regA8, arA1),\n    (a9, regA, arA1), (a10, regA10, arA1), (a11, regA10, arA2)].getD i (a11, regA10, arA2)\n\n/-- `corpus-spec2-m3.md` §1 S3 in full (`s3_trace`: the arena administered through the mutex grant,\nboth issues and the reacquisition) is a `RunFull` from the initial state. -/\ntheorem S3_full : s3fσ 0 = (SC.ofS3 (S3.init arst), [], []) ∧ RunFull KA L0 s3fσ s3fLbls := by\n  have hn : NewMutexOk KA L0 arA a4 [] 0 5 (a4, regA) := ⟨by decide, by decide, rfl⟩\n  have ha : NewArenaStepC a2 [] [] 0 4 4 (.ok (a2, arA)) := ⟨by decide, .ok (by decide)⟩\n  have h : Steps5R KA L0 [(a0, [], []), (a1, [], []), (a2, [], []), (a2, [], arA), (a3, [], arA),\n      (a4, [], arA), (a4, regA, arA), (a5, regA, arA), (a6, regA, arA), (a7, regA8, arA),\n      (a8, regA8, arA1), (a9, regA, arA1), (a10, regA10, arA1), (a11, regA10, arA2)] s3fLbls :=\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.newArena ha) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.newMutex hn) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.spawn ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.acquire S3_2_ok) <|\n    .cons (by decide) (.issue S3_3_ok) <|\n    .cons (by decide) (.unlock S3_5_ok) <|\n    .cons (by decide) (.acquire S3_6_ok) <|\n    .cons (by decide) (.issue S3_8_ok) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\n/-- The labels of S4 (`s4_trace`, `s4_trace5R`). -/\ndef s4Lbls : List Label :=\n  [.kernel 0 (.enter [] [(none, 0), (none, 0)]), .kernel 0 (.write 1 [1]),\n   .kernel 0 (.write 2 [2]), .kernel 0 (.alloc 2 1 [(none, 0)]),\n   .spawnVal 0 [] [(none, 0)] [(1, 4)], .kernel 0 .exit]\n\nopen Ern.Concurrency.Traces in\n/-- The named states of S4. -/\ndef s4σ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(q0, [], []), (q1, [], []), (q2, [], []), (q3, [], []), (q4, [], []), (q5, [], []),\n    (q6, [], [])].getD i (q6, [], [])\n\nopen Ern.Concurrency.Traces in\n/-- `corpus-spec2-m3.md` §1 S4 (`s4_trace`): a detached child survives its creator; the trace is a\n`RunFull` from the initial state (no mutex). -/\ntheorem S4_full : s4σ 0 = (SC.ofS3 (S3.init s4st), [], []) ∧ RunFull K0 L0 s4σ s4Lbls := by\n  have h : Steps5R K0 L0 [(q0, [], []), (q1, [], []), (q2, [], []), (q3, [], []), (q4, [], []),\n      (q5, [], []), (q6, [], [])] s4Lbls :=\n    .cons (by decide) (.kernel s4_steps.1) <| .cons (by decide) (.kernel s4_steps.2.1) <|\n    .cons (by decide) (.kernel s4_steps.2.2.1) <| .cons (by decide) (.kernel s4_steps.2.2.2.1) <|\n    .cons (by decide) (.spawnVal s4_steps.2.2.2.2.1) <|\n    .cons (by decide) (.kernel s4_steps.2.2.2.2.2) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\n/-- The labels of S9 (`s9_trace`, `S9_1_ok`, `S9_2_ok`). -/\ndef s9Lbls : List Label :=\n  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .kernel 0 (.derive 3 [7] .modify),\n   .kernel 0 (.store 5 5), .newMutex 0 4, .newMutex 0 5, .acquire 0 0, .acquire 0 1]\n\n/-- The named states of S9. -/\ndef s9σ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(n0, [], []), (n1, [], []), (n2, [], []), (n3, [], []), (n4, [], []), (n4, [⟨4, none⟩], []),\n    (n4, reg9, []), (n5, [⟨4, some 6⟩, ⟨5, none⟩], []),\n    (n6, [⟨4, some 6⟩, ⟨5, some 7⟩], [])].getD i (n6, [⟨4, some 6⟩, ⟨5, some 7⟩], [])\n\n/-- `corpus-spec2-m3.md` §1 S9 (two mutexes, both acquired by context 0) is admitted: the trace is\na `RunFull` from the initial state, as the corpus v14 expects. -/\ntheorem S9_full : s9σ 0 = (SC.ofS3 (S3.init s9st), [], []) ∧ RunFull K9 L0 s9σ s9Lbls := by\n  have h : Steps5R K9 L0 [(n0, [], []), (n1, [], []), (n2, [], []), (n3, [], []), (n4, [], []),\n      (n4, [⟨4, none⟩], []), (n4, reg9, []), (n5, [⟨4, some 6⟩, ⟨5, none⟩], []),\n      (n6, [⟨4, some 6⟩, ⟨5, some 7⟩], [])] s9Lbls :=\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n    .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n    .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|\n    .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|\n    .cons (by decide) (.acquire S9_1_ok.1) <|\n    .cons (by decide) (.acquire S9_2_ok.1) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\n/-! ## The traces of WC4 -/\n\nopen Ern.Concurrency.Traces in\n/-- The named states of `mutex_trace` (WC4 C13, C16, C17). -/\ndef mtσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(c0, [], []), (c0, reg1, []), (c2, reg2, []), (c3, reg1, [])].getD i (c3, reg1, [])\n\nopen Ern.Concurrency.Traces in\n/-- `mutex_trace` (`newMutex`, `acquire`, `unlock` from `c0`) is a `RunFull`. -/\ntheorem mutex_full : RunFull K0 L0 mtσ [.newMutex 0 1, .acquire 0 0, .unlock 0 0] := by\n  have h : Steps5R K0 L0 [(c0, [], []), (c0, reg1, []), (c2, reg2, []), (c3, reg1, [])]\n      [.newMutex 0 1, .acquire 0 0, .unlock 0 0] :=\n    .cons (by decide) (.newMutex newMutex_ok.1) <|\n    .cons (by decide) (.acquire acquire_enabled) <|\n    .cons (by decide) (.unlock unlock_enabled) .nil\n  exact runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)\n\nopen Ern.Concurrency.Traces in\n/-- `distinct_controllers_trace` (two `newMutex` with distinct controllers from `d1`) is a\n`RunFull`. -/\ntheorem distinct_full : RunFull K0 L0\n    (fun i => [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])].getD i\n      (d1, [⟨2, none⟩, ⟨3, none⟩], [])) [.newMutex 0 2, .newMutex 0 3] := by\n  have h : Steps5R K0 L0 [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])]\n      [.newMutex 0 2, .newMutex 0 3] :=\n    .cons (by decide) (.newMutex distinct_controllers_ok.1) <|\n    .cons (by decide) (.newMutex distinct_controllers_ok.2.1) .nil\n  exact runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)\n\nopen Ern.Concurrency.EncapTraces in\n/-- The named states of `traceB` (WC4 S18, transfer of the whole mutex under the grant). -/\ndef tBσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (e3, reg2, []), (eB, reg2, [])].getD i\n    (eB, reg2, [])\n\nopen Ern.Concurrency.EncapTraces in\n/-- The named states of `traceA` (WC4 S18, transfer of the whole mutex without grant); its prefix\nof three labels is `traceMutex`. -/\ndef tAσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (eA, reg1, [])].getD i\n    (eA, reg1, [])\n\nopen Ern.Concurrency.EncapTraces in\n/-- `traceA`, `traceB` and `traceMutex` (`EncapTraces`, WC4) are `RunFull` traces. -/\ntheorem wc4_full :\n    RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .kernel 0 (.transfer 0 4)] ∧\n    RunFull K0 L0 tBσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .acquire 0 0, .kernel 0 (.transfer 0 4)] ∧\n    RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n      .newMutex 0 4] := by\n  have hA : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n      (eA, reg1, [])] [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .kernel 0 (.transfer 0 4)] :=\n    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n    .cons (by decide) (.newMutex step_newMutex.1) <|\n    .cons (by decide) (.kernel stepA_transfer) .nil\n  have hB : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n      (e3, reg2, []), (eB, reg2, [])] [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n      .newMutex 0 4, .acquire 0 0, .kernel 0 (.transfer 0 4)] :=\n    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n    .cons (by decide) (.newMutex step_newMutex.1) <| .cons (by decide) (.acquire step_acquire.1) <|\n    .cons (by decide) (.kernel stepB_transfer) .nil\n  have rA : RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n      .newMutex 0 4, .kernel 0 (.transfer 0 4)] :=\n    runFull_of_run7 (run7_of_run5R (hA.run (eA, reg1, [])) (by decide)) (by decide)\n  exact ⟨rA, runFull_of_run7 (run7_of_run5R (hB.run (eB, reg2, [])) (by decide)) (by decide),\n    RunFull.take rA 3⟩\n\nend Ern.Concurrency.FullEncap.Replay\n","numLines":172,"startLine":175,"totalLines":346}},"sourceToolAssistantUUID":"787b1e76-ee29-47d3-b5a2-4092250bc16c","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
