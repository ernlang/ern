ry `i` (`AmCond`); for\n`newMutex(g)` by `c`, `NewMutexRight`; no condition on other steps. -/\ndef AmCondF (L : MutexLayout) (st : SC × SyncReg × ArenaReg) : Label → Prop\n  | .resetLock c i => OptP (st.2.1[i]?) (fun e => CtrlRight L st.1 e (st.1.view c).top) False\n  | .newMutex c g => NewMutexRight L st.1 c g\n  | _ => True\n\n/-- Decidability of `AmCondF`. -/\ninstance (L : MutexLayout) (st : SC × SyncReg × ArenaReg) (lbl : Label) :\n    Decidable (AmCondF L st lbl) := by\n  unfold AmCondF; split <;> infer_instance\n\n/-- A final amended execution (brief, final pass): a `Run7` each `resetLock` step of which satisfies\nthe clause of the proposed C18 item 4 and each `newMutex` step the clause of the proposed C13\nitem 11. -/\ndef RunAmF (k : K) (L : MutexLayout) (σ : Nat → SC × SyncReg × ArenaReg) (lbls : List Label) :\n    Prop :=\n  Run7 k L σ lbls ∧ ∀ i (h : i < lbls.length), AmCondF L (σ i) lbls[i]\n\n/-- `AmCondF` contains `AmCond`. -/\ntheorem amCond_of_amCondF {L : MutexLayout} {st : SC × SyncReg × ArenaReg} {lbl : Label}\n    (h : AmCondF L st lbl) : AmCond L st lbl := by\n  cases lbl <;> first | exact h | exact trivial\n\n/-- An `ok` `newMutex` step is a `NewMutexOk` of the registry, the arena registry unchanged. -/\ntheorem lstep_newMutex {k : K} {L : MutexLayout} {c g : Nat} {st st' : SC × SyncReg × ArenaReg}\n    (h : LStep k L (.newMutex c g) st st') :\n    NewMutexOk k L st.2.2 st.1 st.2.1 c g (st'.1, st'.2.1) := by\n  cases h with\n  | newMutex hn => exact hn\n\n/-- In a final amended execution, every `resetLock` step is an amended `resetLock` that is `ok`. -/\ntheorem RunAmF.resetLock {k : K} {L : MutexLayout} {σ : Nat → SC × SyncReg × ArenaReg}\n    {lbls : List Label} (h : RunAmF k L σ lbls) {i : Nat} (hi : i < lbls.length) {c j : Nat}\n    (hl : lbls[i] = .resetLock c j) :\n    ResetLockAmOk L (σ i).1 (σ i).2.1 c j ((σ (i + 1)).1, (σ (i + 1)).2.1) := by\n  have hs := (h.1 i hi).2\n  have ha := h.2 i hi\n  rw [hl] at hs ha\n  exact ⟨lstep_resetLock hs, ha⟩\n\n/-- In a final amended execution, every `newMutex` step is an amended `newMutex` that is `ok`. -/\ntheorem RunAmF.newMutex {k : K} {L : MutexLayout} {σ : Nat → SC × SyncReg × ArenaReg}\n    {lbls : List Label} (h : RunAmF k L σ lbls) {i : Nat} (hi : i < lbls.length) {c g : Nat}\n    (hl : lbls[i] = .newMutex c g) :\n    NewMutexAmOk k L (σ i).2.2 (σ i).1 (σ i).2.1 c g ((σ (i + 1)).1, (σ (i + 1)).2.1) := by\n  have hs := (h.1 i hi).2\n  have ha := h.2 i hi\n  rw [hl] at hs ha\n  exact ⟨lstep_newMutex hs, ha⟩\n\nend Ern.Concurrency.MutexReal\nErn/Concurrency/MutexReal/Amend.lean:68:def CtlRestr (L : MutexLayout) (st : SC × SyncReg × ArenaReg) (lbl : Label)\nErn/Concurrency/MutexReal/Amend.lean-69-    (st' : SC × SyncReg × ArenaReg) : Prop :=\nErn/Concurrency/MutexReal/Amend.lean-70-  ∀ i ∈ List.range st.2.1.length, OptP (st.2.1[i]?) (fun x => x.Live st.1 →\nErn/Concurrency/MutexReal/Amend.lean-71-    OptP (ControlOf L st.1 x) (fun ctl => TouchesX L st lbl ctl →\nErn/Concurrency/MutexReal/Amend.lean-72-      ctlOp i lbl ≠ none ∨ C223Move L (st.1, st.2.1) lbl ∨ ¬ x.Live st'.1) True) True\nErn/Concurrency/MutexReal/Amend.lean-73-\nErn/Concurrency/MutexReal/Amend.lean-74-/-- Decidability of `CtlRestr`. -/\nErn/Concurrency/MutexReal/Amend.lean-75-instance (L : MutexLayout) (st : SC × SyncReg × ArenaReg) (lbl : Label)\nErn/Concurrency/MutexReal/Amend.lean-76-    (st' : SC × SyncReg × ArenaReg) : Decidable (CtlRestr L st lbl st') := by\n--\nErn/Concurrency/MutexReal/Amend.lean:93:def Encap6 (k : K) (L : MutexLayout) (st : SC × SyncReg × ArenaReg) (lbl : Label)\nErn/Concurrency/MutexReal/Amend.lean-94-    (st' : SC × SyncReg × ArenaReg) : Prop :=\nErn/Concurrency/MutexReal/Amend.lean-95-  Encap5R k L st lbl ∧ CtlRestr L st lbl st'\nErn/Concurrency/MutexReal/Amend.lean-96-\nErn/Concurrency/MutexReal/Amend.lean-97-/-- `Run6` (brief, corrective pass): a run with named states every step of which satisfies\nErn/Concurrency/MutexReal/Amend.lean-98-`Encap6` and is an `ok` step. -/\nErn/Concurrency/MutexReal/Amend.lean:99:def Run6 (k : K) (L : MutexLayout) (σ : Nat → SC × SyncReg × ArenaReg) (lbls : List Label) :\nErn/Concurrency/MutexReal/Amend.lean-100-    Prop :=\nErn/Concurrency/MutexReal/Amend.lean-101-  ∀ i (h : i < lbls.length), Encap6 k L (σ i) lbls[i] (σ (i + 1)) ∧\nErn/Concurrency/MutexReal/Amend.lean-102-    LStep k L lbls[i] (σ i) (σ (i + 1))\nErn/Concurrency/MutexReal/Amend.lean-103-\nErn/Concurrency/MutexReal/Amend.lean-104-/-- Brief, corrective pass, task 1: every `Run6` is a `Run5R`. -/\nErn/Concurrency/MutexReal/Amend.lean-105-theorem run6_run5R {k : K} {L : MutexLayout} {σ : Nat → SC × SyncReg × ArenaReg}\nErn/Concurrency/MutexReal/Amend.lean-106-    {lbls : List Label} (h : Run6 k L σ lbls) : Run5R k L σ lbls :=\nErn/Concurrency/MutexReal/Amend.lean-107-  fun i hi => ⟨(h i hi).1.1, (h i hi).2⟩\n--\nErn/Concurrency/MutexReal/Amend.lean:138:def AmCond (L : MutexLayout) (st : SC × SyncReg × ArenaReg) : Label → Prop\nErn/Concurrency/MutexReal/Amend.lean-139-  | .resetLock c i => OptP (st.2.1[i]?) (fun e => CtrlRight L st.1 e (st.1.view c).top) False\nErn/Concurrency/MutexReal/Amend.lean-140-  | _ => True\nErn/Concurrency/MutexReal/Amend.lean-141-\nErn/Concurrency/MutexReal/Amend.lean-142-/-- Decidability of `AmCond`. -/\nErn/Concurrency/MutexReal/Amend.lean-143-instance (L : MutexLayout) (st : SC × SyncReg × ArenaReg) (lbl : Label) :\nErn/Concurrency/MutexReal/Amend.lean-144-    Decidable (AmCond L st lbl) := by\nErn/Concurrency/MutexReal/Amend.lean-145-  unfold AmCond; split <;> infer_instance\nErn/Concurrency/MutexReal/Amend.lean-146-\n--\nErn/Concurrency/MutexReal/Amend.lean:149:def RunAm (k : K) (L : MutexLayout) (σ : Nat → SC × SyncReg × ArenaReg) (lbls : List Label) :\nErn/Concurrency/MutexReal/Amend.lean-150-    Prop :=\nErn/Concurrency/MutexReal/Amend.lean-151-  Run6 k L σ lbls ∧ ∀ i (h : i < lbls.length), AmCond L (σ i) lbls[i]\nErn/Concurrency/MutexReal/Amend.lean-152-\nErn/Concurrency/MutexReal/Amend.lean-153-/-- An `ok` `resetLock` step is a `ResetLockOk` of the registry. -/\nErn/Concurrency/MutexReal/Amend.lean-154-theorem lstep_resetLock {k : K} {L : MutexLayout} {c i : Nat} {st st' : SC × SyncReg × ArenaReg}\nErn/Concurrency/MutexReal/Amend.lean-155-    (h : LStep k L (.resetLock c i) st st') :\nErn/Concurrency/MutexReal/Amend.lean-156-    ResetLockOk L st.1 st.2.1 c i (st'.1, st'.2.1) := by\nErn/Concurrency/MutexReal/Amend.lean-157-  cases h with","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"23dcdd5b-087a-4043-8260-718fee40ebe1","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"bb2abd0c-a0f1-48fb-9dd1-edda66802b41","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
