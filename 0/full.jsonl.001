"     .cons (by decide) (.newMutex newMutex_ok.1) <|","     .cons (by decide) (.acquire acquire_enabled) <|","     .cons (by decide) (.unlock unlock_enabled) .nil","-  exact runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)","+  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩","+","+open Ern.Concurrency.Traces in","+/-- The named states of `distinct_controllers_trace`. -/","+def dtσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])].getD i","+    (d1, [⟨2, none⟩, ⟨3, none⟩], [])","+","+/-- The labels of `distinct_controllers_trace`. -/","+def dtLbls : List Label := [.newMutex 0 2, .newMutex 0 3]"," "," open Ern.Concurrency.Traces in","-/-- `distinct_controllers_trace` (two `newMutex` with distinct controllers from `d1`) is a","-`RunFull`. -/","-theorem distinct_full : RunFull K0 L0","-    (fun i => [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])].getD i","-      (d1, [⟨2, none⟩, ⟨3, none⟩], [])) [.newMutex 0 2, .newMutex 0 3] := by","+/-- `distinct_controllers_trace` (two `newMutex` with distinct controllers from `d1`, WC5.2 C13)","+is a `RunFull` from the initial state. -/","+theorem distinct_full : dtσ 0 = (SC.ofS3 (S3.init mst3), [], []) ∧ RunFull K0 L0 dtσ dtLbls := by","   have h : Steps5R K0 L0 [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])]","-      [.newMutex 0 2, .newMutex 0 3] :=","+      dtLbls :=","     .cons (by decide) (.newMutex distinct_controllers_ok.1) <|","     .cons (by decide) (.newMutex distinct_controllers_ok.2.1) .nil","-  exact runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)","+  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩"," "," open Ern.Concurrency.EncapTraces in","-/-- The named states of `traceB` (WC4 S18, transfer of the whole mutex under the grant). -/","+/-- The named states of `traceB` (WC5.2 §V S18, positive: transfer of the whole mutex under the","+grant). -/"," def tBσ (i : Nat) : SC × SyncReg × ArenaReg :=","   [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (e3, reg2, []), (eB, reg2, [])].getD i","     (eB, reg2, [])"," "," open Ern.Concurrency.EncapTraces in","-/-- The named states of `traceA` (WC4 S18, transfer of the whole mutex without grant); its prefix","-of three labels is `traceMutex`. -/","+/-- The named states of `traceA` (WC5.2 §V S18, positive: transfer of the whole mutex without","+grant); its prefix of three labels is `traceMutex`. -/"," def tAσ (i : Nat) : SC × SyncReg × ArenaReg :=","   [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (eA, reg1, [])].getD i","     (eA, reg1, [])"," "," open Ern.Concurrency.EncapTraces in","-/-- `traceA`, `traceB` and `traceMutex` (`EncapTraces`, WC4) are `RunFull` traces. -/","-theorem wc4_full :","+/-- `traceA`, `traceB` and `traceMutex` (`EncapTraces`) are `RunFull` traces from the initial","+state. -/","+theorem wc4_full : tAσ 0 = (SC.ofS3 (S3.init est), [], []) ∧ tBσ 0 = tAσ 0 ∧","     RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,","       .kernel 0 (.transfer 0 4)] ∧","     RunFull K0 L0 tBσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,"]},{"oldStart":329,"oldLines":7,"newStart":341,"newLines":111,"lines":["   have rA : RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),","       .newMutex 0 4, .kernel 0 (.transfer 0 4)] :=","     runFull_of_run7 (run7_of_run5R (hA.run (eA, reg1, [])) (by decide)) (by decide)","-  exact ⟨rA, runFull_of_run7 (run7_of_run5R (hB.run (eB, reg2, [])) (by decide)) (by decide),","+  exact ⟨rfl, rfl, rA,","+    runFull_of_run7 (run7_of_run5R (hB.run (eB, reg2, [])) (by decide)) (by decide),","     RunFull.take rA 3⟩"," ","+open Ern.Concurrency.EncapTraces in","+/-- The named states of `endUse_mutex_kills_entry`. -/","+def kmσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (eM, reg1, [])].getD i (eM, reg1, [])","+","+/-- The labels of `endUse_mutex_kills_entry`. -/","+def kmLbls : List Label :=","+  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4, .kernel 0 (.endUse 0)]","+","+open Ern.Concurrency.EncapTraces in","+/-- `endUse_mutex_kills_entry` (WC5.2 C22 item 5, S17b positive: `endUse(M)` kills the entry) is a","+`RunFull` from the initial state. -/","+theorem endUseM_full : kmσ 0 = (SC.ofS3 (S3.init est), [], []) ∧ RunFull K0 L0 kmσ kmLbls := by","+  have h : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),","+      (eM, reg1, [])] kmLbls :=","+    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|","+    .cons (by decide) (.newMutex step_newMutex.1) <|","+    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil","+  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩","+","+/-- The named states of `endUse_slot_kills_entry`. -/","+def ksσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(EncapTraces.z0, [], []), (EncapTraces.z0, [⟨1, none⟩], []),","+    (EncapTraces.z2, [⟨1, none⟩], [])].getD i (EncapTraces.z2, [⟨1, none⟩], [])","+","+/-- The labels of `endUse_slot_kills_entry`. -/","+def ksLbls : List Label := [.newMutex 0 1, .kernel 0 (.endUse 1)]","+","+/-- `endUse_slot_kills_entry` (WC5.2 C22 item 5, S17b positive: `endUse(slot)` kills the entry) is","+a `RunFull` from the initial state. -/","+theorem endUseSlot_full : ksσ 0 = (SC.ofS3 (S3.init EncapTraces.sst), [], []) ∧","+    RunFull K0 L0 ksσ ksLbls := by","+  have h : Steps5R K0 L0 [(EncapTraces.z0, [], []), (EncapTraces.z0, [⟨1, none⟩], []),","+      (EncapTraces.z2, [⟨1, none⟩], [])] ksLbls :=","+    .cons (by decide) (.newMutex EncapTraces.z_newMutex) <|","+    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil","+  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩","+","+/-! ## Positive twins of the corpus §1 and §2 -/","+","+/-- The named states of the twin of W-C22.3 (b). -/","+def tbσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(Corpus.w0, [], []), (Corpus.w0, [⟨1, none⟩], []), (Corpus.w2, [⟨1, none⟩], [])].getD i","+    (Corpus.w2, [⟨1, none⟩], [])","+","+/-- The labels of the twin of W-C22.3 (b). -/","+def tbLbls : List Label := [.newMutex 0 1, .kernel 0 (.transfer 0 7)]","+","+/-- `corpus-spec2-m3.md` §2 W-C22.3 (b), twin (`W_C22_3b_ok`: `newMutex(guarded)`, then","+`transfer(M, M′)`) is a `RunFull` from the initial state. -/","+theorem W_C22_3b_twin_full : tbσ 0 = (SC.ofS3 (S3.init Corpus.wst), [], []) ∧","+    RunFull Corpus.KW L0 tbσ tbLbls := by","+  have hn : NewMutexOk Corpus.KW L0 [] Corpus.w0 [] 0 1 (Corpus.w0, [⟨1, none⟩]) :=","+    ⟨by decide, by decide, rfl⟩","+  have h : Steps5R Corpus.KW L0 [(Corpus.w0, [], []), (Corpus.w0, [⟨1, none⟩], []),","+      (Corpus.w2, [⟨1, none⟩], [])] tbLbls :=","+    .cons (by decide) (.newMutex hn) <| .cons (by decide) (.kernel Corpus.W_C22_3b_ok.1) .nil","+  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩","+","+open Ern.Concurrency.EncapTraces in","+/-- The named states of the twin of S17a. -/","+def saσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (Corpus.eS, reg1, []),","+    (Corpus.eL, reg1, [])].getD i (Corpus.eL, reg1, [])","+","+/-- The labels of the twin of S17a. -/","+def saLbls : List Label :=","+  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,","+    .kernel 0 (.endUse 1), .kernel 0 (.endUse 2)]","+","+open Ern.Concurrency.EncapTraces in","+/-- `corpus-spec2-m3.md` §1 S17a, twin (`S17a_2_ok`: `MX₃`, then `endUse(slot)`, which kills the","+entry, then `endUse(lock)`) is a `RunFull` from the initial state. -/","+theorem S17a_twin_full : saσ 0 = (SC.ofS3 (S3.init est), [], []) ∧ RunFull K0 L0 saσ saLbls := by","+  have h : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),","+      (Corpus.eS, reg1, []), (Corpus.eL, reg1, [])] saLbls :=","+    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|","+    .cons (by decide) (.newMutex step_newMutex.1) <|","+    .cons (by decide) (.kernel Corpus.S17a_2_ok.1) <|","+    .cons (by decide) (.kernel Corpus.S17a_2_ok.2.2.2.1) .nil","+  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩","+","+/-! ## The sweep of the complement on the replayed traces -/","+","+open Ern.Concurrency.FullEncap.Sweep in","+/-- Brief of the complement, tasks 2, 3 and 5, on the replayed traces: the closure, the three","+cases, the absence of another context's capacity on a dying leaf, and the kinds that kill a leaf","+(`KillOK`) are checked at every step. -/","+theorem sweep_replay :","+    (SweepOK L0 wrσ wrLbls ∧ KillOK wrσ wrLbls) ∧ (SweepOK L0 cgσ cgLbls ∧ KillOK cgσ cgLbls) ∧","+    (SweepOK L0 s3fσ s3fLbls ∧ KillOK s3fσ s3fLbls) ∧","+    (SweepOK L0 s4σ s4Lbls ∧ KillOK s4σ s4Lbls) ∧ (SweepOK L0 s9σ s9Lbls ∧ KillOK s9σ s9Lbls) ∧","+    (SweepOK L0 mtσ mtLbls ∧ KillOK mtσ mtLbls) ∧ (SweepOK L0 dtσ dtLbls ∧ KillOK dtσ dtLbls) ∧","+    (SweepOK L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,","+      .kernel 0 (.transfer 0 4)] ∧ KillOK tAσ [.kernel 0 (.derive 1 [3] .modify),","+      .kernel 0 (.store 4 1), .newMutex 0 4, .kernel 0 (.transfer 0 4)]) ∧","+    (SweepOK L0 tBσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,","+      .acquire 0 0, .kernel 0 (.transfer 0 4)] ∧ KillOK tBσ [.kernel 0 (.derive 1 [3] .modify),","+      .kernel 0 (.store 4 1), .newMutex 0 4, .acquire 0 0, .kernel 0 (.transfer 0 4)]) ∧","+    (SweepOK L0 kmσ kmLbls ∧ KillOK kmσ kmLbls) ∧ (SweepOK L0 ksσ ksLbls ∧ KillOK ksσ ksLbls) ∧","+    (SweepOK L0 tbσ tbLbls ∧ KillOK tbσ tbLbls) ∧ (SweepOK L0 saσ saLbls ∧ KillOK saσ saLbls) := by","+  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide","+"," end Ern.Concurrency.FullEncap.Replay"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/Replay.lean"]}},"serverClassifierContext":{"request":"1e2a53aa-4d72-4bb3-8104-a1828756f191","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"d6a6c093-19e3-44c2-92c3-1b86dbdf2349","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"c8eae4195cae189cdedb47e28f35642fa72bbd7853e899704fdbde304fd4965b","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01TV56SE1DLtz5hrobGtfKSZ","name":"Bash","input":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && python3 - <<'EOF'\np='Ern/Concurrency/FullEncap/Replay.lean'\ns=open(p).read()\na=s.index(\"/-! ## The traces of WC4 -/\")\ns=s[:a]+'''/-! ## The traces of `Traces` and `EncapTraces` -/\n\nopen Ern.Concurrency.Traces in\n/-- The named states of `mutex_trace` (WC5.2 C13, C16, C17). -/\ndef mtσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(c0, [], []), (c0, reg1, []), (c2, reg2, []), (c3, reg1, [])].getD i (c3, reg1, [])\n\n/-- The labels of `mutex_trace`. -/\ndef mtLbls : List Label := [.newMutex 0 1, .acquire 0 0, .unlock 0 0]\n\nopen Ern.Concurrency.Traces in\n/-- `mutex_trace` (`newMutex`, `acquire`, `unlock` from `c0`, WC5.2 C13, C16, C17) is a `RunFull`\nfrom the initial state. -/\ntheorem mutex_full : mtσ 0 = (SC.ofS3 (S3.init mst), [], []) ∧ RunFull K0 L0 mtσ mtLbls := by\n  have h : Steps5R K0 L0 [(c0, [], []), (c0, reg1, []), (c2, reg2, []), (c3, reg1, [])] mtLbls :=\n    .cons (by decide) (.newMutex newMutex_ok.1) <|\n    .cons (by decide) (.acquire acquire_enabled) <|\n    .cons (by decide) (.unlock unlock_enabled) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\nopen Ern.Concurrency.Traces in\n/-- The named states of `distinct_controllers_trace`. -/\ndef dtσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])].getD i\n    (d1, [⟨2, none⟩, ⟨3, none⟩], [])\n\n/-- The labels of `distinct_controllers_trace`. -/\ndef dtLbls : List Label := [.newMutex 0 2, .newMutex 0 3]\n\nopen Ern.Concurrency.Traces in\n/-- `distinct_controllers_trace` (two `newMutex` with distinct controllers from `d1`, WC5.2 C13)\nis a `RunFull` from the initial state. -/\ntheorem distinct_full : dtσ 0 = (SC.ofS3 (S3.init mst3), [], []) ∧ RunFull K0 L0 dtσ dtLbls := by\n  have h : Steps5R K0 L0 [(d1, [], []), (d1, [⟨2, none⟩], []), (d1, [⟨2, none⟩, ⟨3, none⟩], [])]\n      dtLbls :=\n    .cons (by decide) (.newMutex distinct_controllers_ok.1) <|\n    .cons (by decide) (.newMutex distinct_controllers_ok.2.1) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\nopen Ern.Concurrency.EncapTraces in\n/-- The named states of `traceB` (WC5.2 §V S18, positive: transfer of the whole mutex under the\ngrant). -/\ndef tBσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (e3, reg2, []), (eB, reg2, [])].getD i\n    (eB, reg2, [])\n\nopen Ern.Concurrency.EncapTraces in\n/-- The named states of `traceA` (WC5.2 §V S18, positive: transfer of the whole mutex without\ngrant); its prefix of three labels is `traceMutex`. -/\ndef tAσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (eA, reg1, [])].getD i\n    (eA, reg1, [])\n\nopen Ern.Concurrency.EncapTraces in\n/-- `traceA`, `traceB` and `traceMutex` (`EncapTraces`) are `RunFull` traces from the initial\nstate. -/\ntheorem wc4_full : tAσ 0 = (SC.ofS3 (S3.init est), [], []) ∧ tBσ 0 = tAσ 0 ∧\n    RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .kernel 0 (.transfer 0 4)] ∧\n    RunFull K0 L0 tBσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .acquire 0 0, .kernel 0 (.transfer 0 4)] ∧\n    RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n      .newMutex 0 4] := by\n  have hA : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n      (eA, reg1, [])] [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .kernel 0 (.transfer 0 4)] :=\n    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n    .cons (by decide) (.newMutex step_newMutex.1) <|\n    .cons (by decide) (.kernel stepA_transfer) .nil\n  have hB : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n      (e3, reg2, []), (eB, reg2, [])] [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n      .newMutex 0 4, .acquire 0 0, .kernel 0 (.transfer 0 4)] :=\n    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n    .cons (by decide) (.newMutex step_newMutex.1) <| .cons (by decide) (.acquire step_acquire.1) <|\n    .cons (by decide) (.kernel stepB_transfer) .nil\n  have rA : RunFull K0 L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1),\n      .newMutex 0 4, .kernel 0 (.transfer 0 4)] :=\n    runFull_of_run7 (run7_of_run5R (hA.run (eA, reg1, [])) (by decide)) (by decide)\n  exact ⟨rfl, rfl, rA,\n    runFull_of_run7 (run7_of_run5R (hB.run (eB, reg2, [])) (by decide)) (by decide),\n    RunFull.take rA 3⟩\n\nopen Ern.Concurrency.EncapTraces in\n/-- The named states of `endUse_mutex_kills_entry`. -/\ndef kmσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (eM, reg1, [])].getD i (eM, reg1, [])\n\n/-- The labels of `endUse_mutex_kills_entry`. -/\ndef kmLbls : List Label :=\n  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4, .kernel 0 (.endUse 0)]\n\nopen Ern.Concurrency.EncapTraces in\n/-- `endUse_mutex_kills_entry` (WC5.2 C22 item 5, S17b positive: `endUse(M)` kills the entry) is a\n`RunFull` from the initial state. -/\ntheorem endUseM_full : kmσ 0 = (SC.ofS3 (S3.init est), [], []) ∧ RunFull K0 L0 kmσ kmLbls := by\n  have h : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n      (eM, reg1, [])] kmLbls :=\n    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n    .cons (by decide) (.newMutex step_newMutex.1) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\n/-- The named states of `endUse_slot_kills_entry`. -/\ndef ksσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(EncapTraces.z0, [], []), (EncapTraces.z0, [⟨1, none⟩], []),\n    (EncapTraces.z2, [⟨1, none⟩], [])].getD i (EncapTraces.z2, [⟨1, none⟩], [])\n\n/-- The labels of `endUse_slot_kills_entry`. -/\ndef ksLbls : List Label := [.newMutex 0 1, .kernel 0 (.endUse 1)]\n\n/-- `endUse_slot_kills_entry` (WC5.2 C22 item 5, S17b positive: `endUse(slot)` kills the entry) is\na `RunFull` from the initial state. -/\ntheorem endUseSlot_full : ksσ 0 = (SC.ofS3 (S3.init EncapTraces.sst), [], []) ∧\n    RunFull K0 L0 ksσ ksLbls := by\n  have h : Steps5R K0 L0 [(EncapTraces.z0, [], []), (EncapTraces.z0, [⟨1, none⟩], []),\n      (EncapTraces.z2, [⟨1, none⟩], [])] ksLbls :=\n    .cons (by decide) (.newMutex EncapTraces.z_newMutex) <|\n    .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\n/-! ## Positive twins of the corpus §1 and §2 -/\n\n/-- The named states of the twin of W-C22.3 (b). -/\ndef tbσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(Corpus.w0, [], []), (Corpus.w0, [⟨1, none⟩], []), (Corpus.w2, [⟨1, none⟩], [])].getD i\n    (Corpus.w2, [⟨1, none⟩], [])\n\n/-- The labels of the twin of W-C22.3 (b). -/\ndef tbLbls : List Label := [.newMutex 0 1, .kernel 0 (.transfer 0 7)]\n\n/-- `corpus-spec2-m3.md` §2 W-C22.3 (b), twin (`W_C22_3b_ok`: `newMutex(guarded)`, then\n`transfer(M, M′)`) is a `RunFull` from the initial state. -/\ntheorem W_C22_3b_twin_full : tbσ 0 = (SC.ofS3 (S3.init Corpus.wst), [], []) ∧\n    RunFull Corpus.KW L0 tbσ tbLbls := by\n  have hn : NewMutexOk Corpus.KW L0 [] Corpus.w0 [] 0 1 (Corpus.w0, [⟨1, none⟩]) :=\n    ⟨by decide, by decide, rfl⟩\n  have h : Steps5R Corpus.KW L0 [(Corpus.w0, [], []), (Corpus.w0, [⟨1, none⟩], []),\n      (Corpus.w2, [⟨1, none⟩], [])] tbLbls :=\n    .cons (by decide) (.newMutex hn) <| .cons (by decide) (.kernel Corpus.W_C22_3b_ok.1) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\nopen Ern.Concurrency.EncapTraces in\n/-- The named states of the twin of S17a. -/\ndef saσ (i : Nat) : SC × SyncReg × ArenaReg :=\n  [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []), (Corpus.eS, reg1, []),\n    (Corpus.eL, reg1, [])].getD i (Corpus.eL, reg1, [])\n\n/-- The labels of the twin of S17a. -/\ndef saLbls : List Label :=\n  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n    .kernel 0 (.endUse 1), .kernel 0 (.endUse 2)]\n\nopen Ern.Concurrency.EncapTraces in\n/-- `corpus-spec2-m3.md` §1 S17a, twin (`S17a_2_ok`: `MX₃`, then `endUse(slot)`, which kills the\nentry, then `endUse(lock)`) is a `RunFull` from the initial state. -/\ntheorem S17a_twin_full : saσ 0 = (SC.ofS3 (S3.init est), [], []) ∧ RunFull K0 L0 saσ saLbls := by\n  have h : Steps5R K0 L0 [(e0, [], []), (e1, [], []), (e2, [], []), (e2, reg1, []),\n      (Corpus.eS, reg1, []), (Corpus.eL, reg1, [])] saLbls :=\n    .cons (by decide) (.kernel step_derive) <| .cons (by decide) (.kernel step_store) <|\n    .cons (by decide) (.newMutex step_newMutex.1) <|\n    .cons (by decide) (.kernel Corpus.S17a_2_ok.1) <|\n    .cons (by decide) (.kernel Corpus.S17a_2_ok.2.2.2.1) .nil\n  exact ⟨rfl, runFull_of_run7 (run7_of_run5R (h.run _) (by decide)) (by decide)⟩\n\n/-! ## The sweep of the complement on the replayed traces -/\n\nopen Ern.Concurrency.FullEncap.Sweep in\n/-- Brief of the complement, tasks 2, 3 and 5, on the replayed traces: the closure, the three\ncases, the absence of another context's capacity on a dying leaf, and the kinds that kill a leaf\n(`KillOK`) are checked at every step. -/\ntheorem sweep_replay :\n    (SweepOK L0 wrσ wrLbls ∧ KillOK wrσ wrLbls) ∧ (SweepOK L0 cgσ cgLbls ∧ KillOK cgσ cgLbls) ∧\n    (SweepOK L0 s3fσ s3fLbls ∧ KillOK s3fσ s3fLbls) ∧\n    (SweepOK L0 s4σ s4Lbls ∧ KillOK s4σ s4Lbls) ∧ (SweepOK L0 s9σ s9Lbls ∧ KillOK s9σ s9Lbls) ∧\n    (SweepOK L0 mtσ mtLbls ∧ KillOK mtσ mtLbls) ∧ (SweepOK L0 dtσ dtLbls ∧ KillOK dtσ dtLbls) ∧\n    (SweepOK L0 tAσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .kernel 0 (.transfer 0 4)] ∧ KillOK tAσ [.kernel 0 (.derive 1 [3] .modify),\n      .kernel 0 (.store 4 1), .newMutex 0 4, .kernel 0 (.transfer 0 4)]) ∧\n    (SweepOK L0 tBσ [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 4 1), .newMutex 0 4,\n      .acquire 0 0, .kernel 0 (.transfer 0 4)] ∧ KillOK tBσ [.kernel 0 (.derive 1 [3] .modify),\n      .kernel 0 (.store 4 1), .newMutex 0 4, .acquire 0 0, .kernel 0 (.transfer 0 4)]) ∧\n    (SweepOK L0 kmσ kmLbls ∧ KillOK kmσ kmLbls) ∧ (SweepOK L0 ksσ ksLbls ∧ KillOK ksσ ksLbls) ∧\n    (SweepOK L0 tbσ tbLbls ∧ KillOK tbσ tbLbls) ∧ (SweepOK L0 saσ saLbls ∧ KillOK saσ saLbls) := by\n  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide\n\nend Ern.Concurrency.FullEncap.Replay\n'''\nopen(p,'w').write(s)\nEOF\necho ok","description":"Rewrite the trace section and add replay sweep"},"caller":{"type":"direct"}}]}}
