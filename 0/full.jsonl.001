essionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"a4364aab-7c1f-406f-be7f-e9a0b90448f8","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016g2yHX27Vk5hCM2TZCnzTr","type":"tool_result","content":"The file /Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean has been updated successfully."}]},"uuid":"e333d3ce-02d2-40df-af59-acf3f1612691","timestamp":"2026-10-31T19:28:47.300Z","toolUseResult":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","oldString":"/-! ## Smoke test -/","newString":"/-! ## Sequences: composition -/\n\ntheorem exec_append (s : MM02.State) (os os' : List Op2) :\n    exec s (os ++ os') = exec (exec s os) os' := by\n  induction os generalizing s with\n  | nil => rfl\n  | cons o os ih => exact ih _\n\ntheorem along_append {p : MM02.State → Op2 → Prop} {s : MM02.State} {os os' : List Op2} :\n    Along p s (os ++ os') ↔ Along p s os ∧ Along p (exec s os) os' := by\n  induction os generalizing s with\n  | nil => simp [Along, exec]\n  | cons o os ih => simp only [List.cons_append, Along, exec, ih, and_assoc]\n\n/-! ## Allocations kept by a step of MM-02 -/\n\n/-- `s'` keeps every allocation of `s` with its address space, base, size, alignment, liveness\nand token, and every initialised byte of it initialised (MM-02.C: a write only initialises;\nMM-02.A: an allocation leaves the others intact). -/\ndef Dom (s s' : MM02.State) : Prop :=\n  ∀ i a, s.allocs i = some a → ∃ a', s'.allocs i = some a' ∧ a'.space = a.space ∧\n    a'.base = a.base ∧ a'.size = a.size ∧ a'.align = a.align ∧ a'.live = a.live ∧\n    a'.freeAuth = a.freeAuth ∧ ∀ j, a.bytes j ≠ .uninit → a'.bytes j ≠ .uninit\n\ntheorem Dom.refl (s : MM02.State) : Dom s s :=\n  fun _ a h => ⟨a, h, rfl, rfl, rfl, rfl, rfl, rfl, fun _ h => h⟩\n\ntheorem Dom.trans {s s' s'' : MM02.State} (h : Dom s s') (h' : Dom s' s'') : Dom s s'' := by\n  intro i a ha\n  obtain ⟨a', ha', e1, e2, e3, e4, e5, e6, hb⟩ := h i a ha\n  obtain ⟨a'', ha'', f1, f2, f3, f4, f5, f6, hb'⟩ := h' i a' ha'\n  exact ⟨a'', ha'', f1.trans e1, f2.trans e2, f3.trans e3, f4.trans e4, f5.trans e5, f6.trans e6,\n    fun j hj => hb' j (hb j hj)⟩\n\ntheorem write_allocs (s : MM02.State) (ac : MM02.Access) (w : Nat → UInt8 × Option Nat) (i : Nat) :\n    (s.write ac w).allocs i = if i = ac.prov then\n      (s.allocs i).map (fun a => a.write (ac.addr - a.base) ac.len w) else s.allocs i := rfl\n\ntheorem Dom.write (s : MM02.State) (ac : MM02.Access) (w : Nat → UInt8 × Option Nat) :\n    Dom s (s.write ac w) := by\n  intro i a ha\n  rw [write_allocs]\n  split\n  · refine ⟨a.write (ac.addr - a.base) ac.len w, by rw [ha]; rfl, rfl, rfl, rfl, rfl, rfl, rfl,\n      fun j hj => ?_⟩\n    simp only [MM02.Alloc.write]\n    split\n    · exact fun h => by cases h\n    · exact hj\n  · exact ⟨a, ha, rfl, rfl, rfl, rfl, rfl, rfl, fun _ h => h⟩\n\ntheorem Dom.alloc {s : MM02.State} (hwf : MM02.WF s) (space base size align : Nat)\n    (fa : Option Nat) : Dom s (s.alloc space base size align fa) := fun i a ha =>\n  ⟨a, (MM02.alloc_fresh hwf space base size align fa ha).2, rfl, rfl, rfl, rfl, rfl, rfl,\n    fun _ h => h⟩\n\ntheorem AllocP.of_dom {s s' : MM02.State} {i : Nat} {p : MM02.Alloc → Prop} (h : AllocP s i p)\n    (hd : Dom s s')\n    (hp : ∀ a a' : MM02.Alloc, a'.base = a.base → a'.size = a.size → a'.live = a.live →\n      a'.freeAuth = a.freeAuth → (∀ j, a.bytes j ≠ .uninit → a'.bytes j ≠ .uninit) → p a → p a') :\n    AllocP s' i p := by\n  obtain ⟨a, ha, hpa⟩ := h\n  obtain ⟨a', ha', -, e2, e3, -, e5, e6, hb⟩ := hd i a ha\n  exact ⟨a', ha', hp a a' e2 e3 e5 e6 hb hpa⟩\n\ntheorem AllocP.and {s : MM02.State} {i : Nat} {p q : MM02.Alloc → Prop} (hp : AllocP s i p)\n    (hq : AllocP s i q) : AllocP s i fun a => p a ∧ q a := by\n  obtain ⟨a, ha, h1⟩ := hp\n  obtain ⟨b, hb, h2⟩ := hq\n  rw [ha] at hb; cases hb\n  exact ⟨a, ha, h1, h2⟩\n\ntheorem AllocP.mono {s : MM02.State} {i : Nat} {p q : MM02.Alloc → Prop} (h : AllocP s i p)\n    (hpq : ∀ a, p a → q a) : AllocP s i q :=\n  let ⟨a, ha, hpa⟩ := h; ⟨a, ha, hpq a hpa⟩\n\ntheorem AllocP.lt {s : MM02.State} (hwf : MM02.WF s) {i : Nat} {p : MM02.Alloc → Prop}\n    (h : AllocP s i p) : i < s.next :=\n  Nat.lt_of_not_le fun hle => by obtain ⟨a, ha, -⟩ := h; rw [hwf i hle] at ha; cases ha\n\n/-! ## Transport of `Repr` -/\n\n/-- `Repr` carries over when the MM-02 state only keeps its allocations (`Dom`) and the MM-03 state\nkeeps its places, stack, `dead` and `freed` marks, every leaf that becomes `Init` having its range\ninitialised (K3). -/\ntheorem Repr.change {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 s2' : MM02.State}\n    (hR : Repr tok L s3 s2) (hd : Dom s2 s2') (hP : s3'.P = s3.P) (hF : s3'.F = s3.F)\n    (hdead : s3'.dead = s3.dead) (hfr : s3'.freed = s3.freed)\n    (hI : ∀ l < s3.P.length, isLeaf s3.P l → s3'.I l = .init →\n      s3.I l = .init ∨ AllocP s2' (L l).alloc fun a => a.InitRange (L l).off (L l).len) :\n    Repr tok L s3' s2' := by\n  have hU : ∀ q, s3'.Usable q ↔ s3.Usable q := fun q => S3.Usable.congr hP hF hdead\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP, hF, hfr, hU]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact fun l hl hlf => (hR.lwf.within l hl hlf).of_dom hd fun a a' _ e _ _ _ h => e ▸ h\n  · exact hR.inj\n  · intro r hr hrt\n    have := hR.tokens r hr hrt\n    unfold OptP at this ⊢; split\n    · rename_i pl hpl; rw [hpl] at this; simp only at this\n      unfold OptP at this ⊢; split\n      · rename_i d hd'; rw [hd'] at this\n        exact fun l hl => (this l hl).of_dom hd fun a a' _ _ _ e _ h => e ▸ h\n      · trivial\n    · trivial\n  · exact fun r hr hrt hu l hl => (hR.live r hr hrt hu l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h\n  · intro l hl hlf hi\n    rcases hI l hl hlf hi with h | h\n    · exact (hR.init l hl hlf h).of_dom hd fun a a' _ _ _ _ hb h i hi => hb _ (h i hi)\n    · exact h\n  · exact fun r hr hrt hf l hl => (hR.freed r hr hrt hf l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h\n  · exact fun r hr hrt hg l hl => (hR.exited r hr hrt hg l hl).of_dom hd\n      fun a a' _ _ e _ _ h => e ▸ h\n  · exact fun r hr hrt hu hf ho l hl => (hR.leaked r hr hrt hu hf ho l hl).of_dom hd\n      fun a a' _ _ e _ _ h => e ▸ h\n\n/-! ## Writes (K4: `write3`, `writeShared`; K3: `S3.init`) -/\n\ntheorem leafAcc_of {s2 : MM02.State} {L : Layout} {au : MM02.Auth} {l : Nat} {a : MM02.Alloc}\n    (h : s2.allocs (L l).alloc = some a) :\n    leafAcc s2 L au l = ⟨a.base + (L l).off, (L l).alloc, (L l).len, au⟩ := by\n  simp [leafAcc, h]\n\ntheorem leafAcc_dom {s2 s2' : MM02.State} (hd : Dom s2 s2') {L : Layout} {au : MM02.Auth} {l : Nat}\n    (h : AllocP s2 (L l).alloc fun _ => True) : leafAcc s2' L au l = leafAcc s2 L au l := by\n  obtain ⟨a, ha, -⟩ := h\n  obtain ⟨a', ha', -, e, -⟩ := hd _ a ha\n  rw [leafAcc_of ha, leafAcc_of ha', e]\n\n/-- K4, MM-02.C: the write of the range of a leaf whose allocation is live and contains the range\nhas the outcome `ok`, under `dec` (K5) and in the sequential fragment (K5). -/\ntheorem write_leaf_ok {ObW : MM02.WriteOblSpec} {s2 : MM02.State} {L : Layout} {l : Nat}\n    {w : Nat → UInt8 × Option Nat} (hstat : ∀ s ac w, ObW.stat s ac w)\n    (h : AllocP s2 (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size)\n    (hdec : ObW.dec s2 (leafAcc s2 L .write l) w) :\n    MM02.WriteStep ObW (leafAcc s2 L .write l) w s2 (.ok (s2.write (leafAcc s2 L .write l) w)) := by\n  obtain ⟨a, ha, hl, hs⟩ := h\n  refine .ok ⟨⟨a, ?_, hl, ?_, .inr rfl⟩, hdec, hstat _ _ _⟩\n  · rw [leafAcc_of ha]; exact ha\n  · rw [leafAcc_of ha]; exact ⟨Nat.le_add_right _ _, by simp only; omega⟩\n\n/-- MM-02.C: after the write of the range of a leaf, the range is initialised. -/\ntheorem write_leaf_init {s2 : MM02.State} {L : Layout} {l : Nat} {w : Nat → UInt8 × Option Nat}\n    (h : AllocP s2 (L l).alloc fun _ => True) :\n    AllocP (s2.write (leafAcc s2 L .write l) w) (L l).alloc\n      fun a => a.InitRange (L l).off (L l).len := by\n  obtain ⟨a, ha, -⟩ := h\n  refine ⟨a.write (L l).off (L l).len w, ?_, fun i hi => ?_⟩\n  · rw [write_allocs, leafAcc_of ha]; simp [ha]\n  · simp only [MM02.Alloc.write]\n    rw [if_pos (by omega)]; exact fun h => by cases h\n\ntheorem write3Eff_cons (s : S3) (l : Nat) (ls : List Nat) :\n    write3Eff (write3Eff s [l]) ls = write3Eff s (l :: ls) := by\n  simp only [write3Eff]; congr 1; funext p\n  by_cases h1 : p ∈ ls <;> by_cases h2 : p = l <;> simp [h1, h2]\n\n/-- K4, R2 core: the writes of the ranges of leaves whose allocations are live have the outcome\n`ok`, and the states where those leaves are `Init` stay in `Repr`, under `dec` along the\nsequence and in the sequential fragment (K5). -/\ntheorem repr_writes {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok : Nat → Nat} {L : Layout} {w : Nat → Nat → UInt8 × Option Nat}\n    (hstat : ∀ s ac w, ObW.stat s ac w) :\n    ∀ (ls : List Nat) (s3 : S3) (s2 : MM02.State), Repr tok L s3 s2 →\n      (∀ l ∈ ls, l < s3.P.length ∧ isLeaf s3.P l ∧ LiveAlloc s2 (L l).alloc) →\n      DecAlong ObR ObW s2 (writeOps s2 L w ls) →\n      AllOk C ObR ObW s2 (writeOps s2 L w ls) ∧\n        Repr tok L (write3Eff s3 ls) (exec s2 (writeOps s2 L w ls))\n  | [], s3, s2, hR, _, _ => by\n    refine ⟨trivial, hR.change (Dom.refl _) rfl rfl rfl rfl fun l _ _ h => .inl ?_⟩\n    simpa [write3Eff] using h\n  | l :: ls, s3, s2, hR, hls, hdec => by\n    obtain ⟨hl, hlf, hlive⟩ := hls l (List.mem_cons_self ..)\n    have hw := (hR.lwf.within l hl hlf)\n    have hex : AllocP s2 (L l).alloc fun _ => True := hw.mono fun _ _ => trivial\n    set s2₁ := s2.write (leafAcc s2 L .write l) (w l) with hs2₁\n    have hd₁ : Dom s2 s2₁ := Dom.write _ _ _\n    have hR₁ : Repr tok L (write3Eff s3 [l]) s2₁ := by\n      refine hR.change hd₁ rfl rfl rfl rfl fun l' _ _ h => ?_\n      simp only [write3Eff, List.mem_singleton] at h\n      split at h\n      · rename_i e; subst e; exact .inr (write_leaf_init hex)\n      · exact .inl h\n    have hops : writeOps s2₁ L w ls = writeOps s2 L w ls := by\n      simp only [writeOps, List.map_inj_left]\n      intro l' hl'\n      obtain ⟨hl'P, hl'f, -⟩ := hls l' (List.mem_cons_of_mem _ hl')\n      rw [leafAcc_dom hd₁ ((hR.lwf.within l' hl'P hl'f).mono fun _ _ => trivial)]\n    simp only [writeOps, List.map_cons, Along, Op2.Dec] at hdec\n    obtain ⟨hdec₀, hdec⟩ := hdec\n    rw [show Op2.eff (.write (leafAcc s2 L .write l) (w l)) s2 = s2₁ from rfl] at hdec\n    have := repr_writes ls (write3Eff s3 [l]) s2₁ hR₁ (fun l' hl' => by\n      obtain ⟨h1, h2, h3⟩ := hls l' (List.mem_cons_of_mem _ hl')\n      exact ⟨h1, h2, h3.of_dom hd₁ fun _ _ _ _ e _ _ h => e ▸ h⟩) (by rw [hops] at hdec ⊢; exact hdec)\n    rw [hops, write3Eff_cons] at this\n    exact ⟨⟨write_leaf_ok hstat (hlive.and hw) hdec₀, this.1⟩, this.2⟩\n\n/-! ## Smoke test -/","originalFile":null,"structuredPatch":[{"oldStart":246,"oldLines":6,"newStart":246,"newLines":204,"lines":["   | s, i :: is => .alloc (g i).space (pl s (g i)) (g i).size (g i).align fa ::","       allocOps pl g fa (s.alloc (g i).space (pl s (g i)) (g i).size (g i).align fa) is"," ","+/-! ## Sequences: composition -/","+","+theorem exec_append (s : MM02.State) (os os' : List Op2) :","+    exec s (os ++ os') = exec (exec s os) os' := by","+  induction os generalizing s with","+  | nil => rfl","+  | cons o os ih => exact ih _","+","+theorem along_append {p : MM02.State → Op2 → Prop} {s : MM02.State} {os os' : List Op2} :","+    Along p s (os ++ os') ↔ Along p s os ∧ Along p (exec s os) os' := by","+  induction os generalizing s with","+  | nil => simp [Along, exec]","+  | cons o os ih => simp only [List.cons_append, Along, exec, ih, and_assoc]","+","+/-! ## Allocations kept by a step of MM-02 -/","+","+/-- `s'` keeps every allocation of `s` with its address space, base, size, alignment, liveness","+and token, and every initialised byte of it initialised (MM-02.C: a write only initialises;","+MM-02.A: an allocation leaves the others intact). -/","+def Dom (s s' : MM02.State) : Prop :=","+  ∀ i a, s.allocs i = some a → ∃ a', s'.allocs i = some a' ∧ a'.space = a.space ∧","+    a'.base = a.base ∧ a'.size = a.size ∧ a'.align = a.align ∧ a'.live = a.live ∧","+    a'.freeAuth = a.freeAuth ∧ ∀ j, a.bytes j ≠ .uninit → a'.bytes j ≠ .uninit","+","+theorem Dom.refl (s : MM02.State) : Dom s s :=","+  fun _ a h => ⟨a, h, rfl, rfl, rfl, rfl, rfl, rfl, fun _ h => h⟩","+","+theorem Dom.trans {s s' s'' : MM02.State} (h : Dom s s') (h' : Dom s' s'') : Dom s s'' := by","+  intro i a ha","+  obtain ⟨a', ha', e1, e2, e3, e4, e5, e6, hb⟩ := h i a ha","+  obtain ⟨a'', ha'', f1, f2, f3, f4, f5, f6, hb'⟩ := h' i a' ha'","+  exact ⟨a'', ha'', f1.trans e1, f2.trans e2, f3.trans e3, f4.trans e4, f5.trans e5, f6.trans e6,","+    fun j hj => hb' j (hb j hj)⟩","+","+theorem write_allocs (s : MM02.State) (ac : MM02.Access) (w : Nat → UInt8 × Option Nat) (i : Nat) :","+    (s.write ac w).allocs i = if i = ac.prov then","+      (s.allocs i).map (fun a => a.write (ac.addr - a.base) ac.len w) else s.allocs i := rfl","+","+theorem Dom.write (s : MM02.State) (ac : MM02.Access) (w : Nat → UInt8 × Option Nat) :","+    Dom s (s.write ac w) := by","+  intro i a ha","+  rw [write_allocs]","+  split","+  · refine ⟨a.write (ac.addr - a.base) ac.len w, by rw [ha]; rfl, rfl, rfl, rfl, rfl, rfl, rfl,","+      fun j hj => ?_⟩","+    simp only [MM02.Alloc.write]","+    split","+    · exact fun h => by cases h","+    · exact hj","+  · exact ⟨a, ha, rfl, rfl, rfl, rfl, rfl, rfl, fun _ h => h⟩","+","+theorem Dom.alloc {s : MM02.State} (hwf : MM02.WF s) (space base size align : Nat)","+    (fa : Option Nat) : Dom s (s.alloc space base size align fa) := fun i a ha =>","+  ⟨a, (MM02.alloc_fresh hwf space base size align fa ha).2, rfl, rfl, rfl, rfl, rfl, rfl,","+    fun _ h => h⟩","+","+theorem AllocP.of_dom {s s' : MM02.State} {i : Nat} {p : MM02.Alloc → Prop} (h : AllocP s i p)","+    (hd : Dom s s')","+    (hp : ∀ a a' : MM02.Alloc, a'.base = a.base → a'.size = a.size → a'.live = a.live →","+      a'.freeAuth = a.freeAuth → (∀ j, a.bytes j ≠ .uninit → a'.bytes j ≠ .uninit) → p a → p a') :","+    AllocP s' i p := by","+  obtain ⟨a, ha, hpa⟩ := h","+  obtain ⟨a', ha', -, e2, e3, -, e5, e6, hb⟩ := hd i a ha","+  exact ⟨a', ha', hp a a' e2 e3 e5 e6 hb hpa⟩","+","+theorem AllocP.and {s : MM02.State} {i : Nat} {p q : MM02.Alloc → Prop} (hp : AllocP s i p)","+    (hq : AllocP s i q) : AllocP s i fun a => p a ∧ q a := by","+  obtain ⟨a, ha, h1⟩ := hp","+  obtain ⟨b, hb, h2⟩ := hq","+  rw [ha] at hb; cases hb","+  exact ⟨a, ha, h1, h2⟩","+","+theorem AllocP.mono {s : MM02.State} {i : Nat} {p q : MM02.Alloc → Prop} (h : AllocP s i p)","+    (hpq : ∀ a, p a → q a) : AllocP s i q :=","+  let ⟨a, ha, hpa⟩ := h; ⟨a, ha, hpq a hpa⟩","+","+theorem AllocP.lt {s : MM02.State} (hwf : MM02.WF s) {i : Nat} {p : MM02.Alloc → Prop}","+    (h : AllocP s i p) : i < s.next :=","+  Nat.lt_of_not_le fun hle => by obtain ⟨a, ha, -⟩ := h; rw [hwf i hle] at ha; cases ha","+","+/-! ## Transport of `Repr` -/","+","+/-- `Repr` carries over when the MM-02 state only keeps its allocations (`Dom`) and the MM-03 state","+keeps its places, stack, `dead` and `freed` marks, every leaf that becomes `Init` having its range","+initialised (K3). -/","+theorem Repr.change {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 s2' : MM02.State}","+    (hR : Repr tok L s3 s2) (hd : Dom s2 s2') (hP : s3'.P = s3.P) (hF : s3'.F = s3.F)","+    (hdead : s3'.dead = s3.dead) (hfr : s3'.freed = s3.freed)","+    (hI : ∀ l < s3.P.length, isLeaf s3.P l → s3'.I l = .init →","+      s3.I l = .init ∨ AllocP s2' (L l).alloc fun a => a.InitRange (L l).off (L l).len) :","+    Repr tok L s3' s2' := by","+  have hU : ∀ q, s3'.Usable q ↔ s3.Usable q := fun q => S3.Usable.congr hP hF hdead","+  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP, hF, hfr, hU]","+  · exact hR.lwf.sameAlloc","+  · exact hR.lwf.disjoint","+  · exact fun l hl hlf => (hR.lwf.within l hl hlf).of_dom hd fun a a' _ e _ _ _ h => e ▸ h","+  · exact hR.inj","+  · intro r hr hrt","+    have := hR.tokens r hr hrt","+    unfold OptP at this ⊢; split","+    · rename_i pl hpl; rw [hpl] at this; simp only at this","+      unfold OptP at this ⊢; split","+      · rename_i d hd'; rw [hd'] at this","+        exact fun l hl => (this l hl).of_dom hd fun a a' _ _ _ e _ h => e ▸ h","+      · trivial","+    · trivial","+  · exact fun r hr hrt hu l hl => (hR.live r hr hrt hu l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h","+  · intro l hl hlf hi","+    rcases hI l hl hlf hi with h | h","+    · exact (hR.init l hl hlf h).of_dom hd fun a a' _ _ _ _ hb h i hi => hb _ (h i hi)","+    · exact h","+  · exact fun r hr hrt hf l hl => (hR.freed r hr hrt hf l hl).of_dom hd fun a a' _ _ e _ _ h => e ▸ h","+  · exact fun r hr hrt hg l hl => (hR.exited r hr hrt hg l hl).of_dom hd","+      fun a a' _ _ e _ _ h => e ▸ h","+  · exact fun r hr hrt hu hf ho l hl => (hR.leaked r hr hrt hu hf ho l hl).of_dom hd","+      fun a a' _ _ e _ _ h => e ▸ h","+","+/-! ## Writes (K4: `write3`, `writeShared`; K3: `S3.init`) -/","+","+theorem leafAcc_of {s2 : MM02.State} {L : Layout} {au : MM02.Auth} {l : Nat} {a : MM02.Alloc}","+    (h : s2.allocs (L l).alloc = some a) :","+    leafAcc s2 L au l = ⟨a.base + (L l).off, (L l).alloc, (L l).len, au⟩ := by","+  simp [leafAcc, h]","+","+theorem leafAcc_dom {s2 s2' : MM02.State} (hd : Dom s2 s2') {L : Layout} {au : MM02.Auth} {l : Nat}","+    (h : AllocP s2 (L l).alloc fun _ => True) : leafAcc s2' L au l = leafAcc s2 L au l := by","+  obtain ⟨a, ha, -⟩ := h","+  obtain ⟨a', ha', -, e, -⟩ := hd _ a ha","+  rw [leafAcc_of ha, leafAcc_of ha', e]","+","+/-- K4, MM-02.C: the write of the range of a leaf whose allocation is live and contains the range","+has the outcome `ok`, under `dec` (K5) and in the sequential fragment (K5). -/","+theorem write_leaf_ok {ObW : MM02.WriteOblSpec} {s2 : MM02.State} {L : Layout} {l : Nat}","+    {w : Nat → UInt8 × Option Nat} (hstat : ∀ s ac w, ObW.stat s ac w)","+    (h : AllocP s2 (L l).alloc fun a => a.live = true ∧ (L l).off + (L l).len ≤ a.size)","+    (hdec : ObW.dec s2 (leafAcc s2 L .write l) w) :","+    MM02.WriteStep ObW (leafAcc s2 L .write l) w s2 (.ok (s2.write (leafAcc s2 L .write l) w)) := by","+  obtain ⟨a, ha, hl, hs⟩ := h","+  refine .ok ⟨⟨a, ?_, hl, ?_, .inr rfl⟩, hdec, hstat _ _ _⟩","+  · rw [leafAcc_of ha]; exact ha","+  · rw [leafAcc_of ha]; exact ⟨Nat.le_add_right _ _, by simp only; omega⟩","+","+/-- MM-02.C: after the write of the range of a leaf, the range is initialised. -/","+theorem write_leaf_init {s2 : MM02.State} {L : Layout} {l : Nat} {w : Nat → UInt8 × Option Nat}","+    (h : AllocP s2 (L l).alloc fun _ => True) :","+    AllocP (s2.write (leafAcc s2 L .write l) w) (L l).alloc","+      fun a => a.InitRange (L l).off (L l).len := by","+  obtain ⟨a, ha, -⟩ := h","+  refine ⟨a.write (L l).off (L l).len w, ?_, fun i hi => ?_⟩","+  · rw [write_allocs, leafAcc_of ha]; simp [ha]","+  · simp only [MM02.Alloc.write]","+    rw [if_pos (by omega)]; exact fun h => by cases h","+","+theorem write3Eff_cons (s : S3) (l : Nat) (ls : List Nat) :","+    write3Eff (write3Eff s [l]) ls = write3Eff s (l :: ls) := by","+  simp only [write3Eff]; congr 1; funext p","+  by_cases h1 : p ∈ ls <;> by_cases h2 : p = l <;> simp [h1, h2]","+","+/-- K4, R2 core: the writes of the ranges of leaves whose allocations are live have the outcome","+`ok`, and the states where those leaves are `Init` stay in `Repr`, under `dec` along the","+sequence and in the sequential fragment (K5). -/","+theorem repr_writes {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {tok : Nat → Nat} {L : Layout} {w : Nat → Nat → UInt8 × Option Nat}","+    (hstat : ∀ s ac w, ObW.stat s ac w) :","+    ∀ (ls : List Nat) (s3 : S3) (s2 : MM02.State), Repr tok L s3 s2 →","+      (∀ l ∈ ls, l < s3.P.length ∧ isLeaf s3.P l ∧ LiveAlloc s2 (L l).alloc) →","+      DecAlong ObR ObW s2 (writeOps s2 L w ls) →","+      AllOk C ObR ObW s2 (writeOps s2 L w ls) ∧","+        Repr tok L (write3Eff s3 ls) (exec s2 (writeOps s2 L w ls))","+  | [], s3, s2, hR, _, _ => by","+    refine ⟨trivial, hR.change (Dom.refl _) rfl rfl rfl rfl fun l _ _ h => .inl ?_⟩","+    simpa [write3Eff] using h","+  | l :: ls, s3, s2, hR, hls, hdec => by","+    obtain ⟨hl, hlf, hlive⟩ := hls l (List.mem_cons_self ..)","+    have hw := (hR.lwf.within l hl hlf)","+    have hex : AllocP s2 (L l).alloc fun _ => True := hw.mono fun _ _ => trivial","+    set s2₁ := s2.write (leafAcc s2 L .write l) (w l) with hs2₁","+    have hd₁ : Dom s2 s2₁ := Dom.write _ _ _","+    have hR₁ : Repr tok L (write3Eff s3 [l]) s2₁ := by","+      refine hR.change hd₁ rfl rfl rfl rfl fun l' _ _ h => ?_","+      simp only [write3Eff, List.mem_singleton] at h","+      split at h","+      · rename_i e; subst e; exact .inr (write_leaf_init hex)","+      · exact .inl h","+    have hops : writeOps s2₁ L w ls = writeOps s2 L w ls := by","+      simp only [writeOps, List.map_inj_left]","+      intro l' hl'","+      obtain ⟨hl'P, hl'f, -⟩ := hls l' (List.mem_cons_of_mem _ hl')","+      rw [leafAcc_dom hd₁ ((hR.lwf.within l' hl'P hl'f).mono fun _ _ => trivial)]","+    simp only [writeOps, List.map_cons, Along, Op2.Dec] at hdec","+    obtain ⟨hdec₀, hdec⟩ := hdec","+    rw [show Op2.eff (.write (leafAcc s2 L .write l) (w l)) s2 = s2₁ from rfl] at hdec","+    have := repr_writes ls (write3Eff s3 [l]) s2₁ hR₁ (fun l' hl' => by","+      obtain ⟨h1, h2, h3⟩ := hls l' (List.mem_cons_of_mem _ hl')","+      exact ⟨h1, h2, h3.of_dom hd₁ fun _ _ _ _ e _ _ h => e ▸ h⟩) (by rw [hops] at hdec ⊢; exact hdec)","+    rw [hops, write3Eff_cons] at this","+    exact ⟨⟨write_leaf_ok hstat (hlive.and hw) hdec₀, this.1⟩, this.2⟩","+"," /-! ## Smoke test -/"," "," namespace Smoke"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"a4364aab-7c1f-406f-be7f-e9a0b90448f8","permissionDecision":{"decision":"accept","source