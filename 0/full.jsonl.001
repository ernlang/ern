 => `current\n        let (a, b) := perMod.getD mod (0, 0)\n        perMod := perMod.insert mod (a + 1, if ni then b + 1 else b)\n        let axs ← liftCoreM (collectAxioms n)\n        for ax in axs do\n          if ax != ``propext && ax != ``Quot.sound then\n            bad := bad.push n\n    | _ => pure ()\n  logInfo m!\"total {total}, non-internal {nonInt}, bad {bad.size}: {bad.toList.take 10}\"\n  for m in [`Ern.Concurrency.EventModel.Closure, `Ern.Concurrency.EventModel.Graph, `Ern.Concurrency.EventModel.Lemmas, `Ern.Concurrency.EventModel.Witness] do\n    logInfo m!\"{m}: {perMod.getD m (0,0)}\"\n----\nimport Lean\nimport Ern\nopen Lean Elab Command\n\n#eval show CommandElabM Unit from do\n  let env ← getEnv\n  let mut lines : Array String := #[]\n  for (n, ci) in env.constants.toList do\n    match ci with\n    | .thmInfo _ =>\n      let s := n.toString\n      if s.startsWith \"Ern.Concurrency\" || s.startsWith \"_private.Ern.Concurrency\" then\n        let mod := match env.getModuleIdxFor? n with\n          | some i => env.header.moduleNames[i.toNat]!\n          | none => `current\n        lines := lines.push s!\"{s}\\t{mod}\\t{n.isInternal}\"\n    | _ => pure ()\n  IO.FS.writeFile (System.FilePath.mk (← IO.getEnv \"OUT\").get!) (String.intercalate \"\\n\" (lines.qsort (· < ·)).toList)","is_error":false}]},"uuid":"8c5ccb57-0496-45d4-9d34-0ad358d40eef","timestamp":"2026-11-12T23:46:16.203Z","toolUseResult":{"stdout":"AG.lean\nAudit.lean\nAudit2.lean\nAudit5.lean\nAudit6.lean\nAx.lean\nAxDying.lean\nAxNew.lean\nC.lean\nCW.lean\nCl.lean\nCl2.lean\nDy.lean\nEC.lean\nEP.lean\nES.lean\nESP.lean\nEvTest.lean\nG12.lean\nG12s.lean\nGr.lean\nGr2.lean\nHE.lean\nLe.lean\nME.lean\nMES.lean\nMEax.lean\nP.lean\nPS.lean\nR.lean\nRI.lean\nSV.lean\nScanRights.lean\nT6.lean\nT7.lean\nW.lean\nWi.lean\na.txt\nadded.txt\nadded_encap.txt\nax0.lean\nax1.lean\nax10.lean\nax11.lean\nax12.lean\nax13.lean\nax14.lean\nax2.lean\nax3.lean\nax4.lean\nax5.lean\nax6.lean\nax7.lean\nax8.lean\n