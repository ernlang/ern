{"parentUuid":"dad91ada-eac1-4bfa-bbc7-12ffa3dc0ccd","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013wfCiKdvVdtCWoKiEc1HJG","type":"tool_result","content":"The file /Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean has been updated successfully."}]},"uuid":"916e8fa3-9253-451f-80bc-bb7b11cc5005","timestamp":"2026-10-31T19:40:08.569Z","toolUseResult":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","oldString":"/-! ## Smoke test -/","newString":"/-! ## Two invariants of the reached states missing from the draft -/\n\n/-- A place owned by a frame is not marked dead (MM-03.3.2: `endUse` and `free` mark dead only\nstorage owned by a value, O12, O13; a local of a frame dies by the exit of the frame, O7). -/\ndef FrameOwnedLive (s : S3) : Prop :=\n  ∀ (q : Nat) (pl : Place) (f : Nat), s.P[q]? = some pl → pl.owner = .frame f → s.dead q = false\n\n/-- `FpLeaves` carries over when the old leaves stay leaves and every leaf covered after the step\nis covered before it or is a leaf of a place after it. -/\ntheorem FpLeaves.step {s s' : S3} (hwf : WF3 s) (h : FpLeaves s)\n    (hleaf : ∀ l < s.P.length, isLeaf s.P l → isLeaf s'.P l)\n    (hA : ∀ j z, s'.A[j]? = some z → ∀ l ∈ z.footprint,\n      (∃ y j', s.A[j']? = some y ∧ l ∈ y.footprint) ∨ ∃ q, l ∈ footprint s'.P q) :\n    FpLeaves s' := by\n  intro j z hz l hl\n  rcases hA j z hz l hl with ⟨y, j', hy, hly⟩ | ⟨q, hq⟩\n  · exact hleaf l (hwf.fp j' y hy l hly) (h j' y hy l hly)\n  · exact (mem_footprint.1 hq).2.1\n\n/-- `FrameOwnedLive` carries over when every place owned by a frame after the step was owned by\nthat frame with the same `dead` mark before it, or is alive. -/\ntheorem FrameOwnedLive.step {s s' : S3} (h : FrameOwnedLive s)\n    (hP : ∀ q pl f, s'.P[q]? = some pl → pl.owner = .frame f →\n      (∃ pl', s.P[q]? = some pl' ∧ pl'.owner = .frame f ∧ s'.dead q = s.dead q) ∨\n        s'.dead q = false) : FrameOwnedLive s' := by\n  intro q pl f hq ho\n  rcases hP q pl f hq ho with ⟨pl', hq', ho', e⟩ | e\n  · rw [e]; exact h q pl' f hq' ho'\n  · exact e\n\ntheorem isLeaf_of_parentOf {P P' : List Place} (hlen : P'.length = P.length)\n    (hpar : parentOf P' = parentOf P) {l : Nat} (h : isLeaf P l) : isLeaf P' l := by\n  simp only [isLeaf, hlen, hpar]; exact h\n\n/-- `FpLeaves` and `FrameOwnedLive` are preserved by every step of `Reachable` (`Step`), under\n`WF3`. -/\ntheorem step_fpLeaves_frameOwnedLive {k : K} {s s' : S3} (hwf : WF3 s)\n    (h : FpLeaves s ∧ FrameOwnedLive s) (hs : Step k s s') :\n    FpLeaves s' ∧ FrameOwnedLive s' := by\n  obtain ⟨hfl, hfo⟩ := h\n  -- steps changing no place and keeping each footprint\n  have same : ∀ {s'' : S3}, s''.P = s.P → s''.dead = s.dead →\n      (∀ j z, s''.A[j]? = some z → ∃ y, s.A[j]? = some y ∧ z.footprint = y.footprint) →\n      FpLeaves s'' ∧ FrameOwnedLive s'' := fun hP hd hA =>\n    ⟨hfl.step hwf (fun l _ h => hP ▸ h) fun j z hz l hl => by\n      obtain ⟨y, hy, e⟩ := hA j z hz; exact .inl ⟨y, j, hy, e ▸ hl⟩,\n     hfo.step fun q pl f hq ho => .inl ⟨pl, hP ▸ hq, ho, by rw [hd]⟩⟩\n  have sameA : ∀ {s'' : S3}, s''.P = s.P → s''.dead = s.dead → s''.A = s.A →\n      FpLeaves s'' ∧ FrameOwnedLive s'' := fun hP hd hA =>\n    same hP hd fun j z hz => ⟨z, hA ▸ hz, rfl⟩\n  -- steps appending authorities to `A`, places unchanged\n  have app : ∀ {s'' : S3} (extra : List Authority), s''.P = s.P → s''.dead = s.dead →\n      s''.A = s.A ++ extra → (∀ z ∈ extra, ∀ l ∈ z.footprint,\n        (∃ y j', s.A[j']? = some y ∧ l ∈ y.footprint) ∨ ∃ q, l ∈ footprint s.P q) →\n      FpLeaves s'' ∧ FrameOwnedLive s'' := fun hP hd hA hx =>\n    ⟨hfl.step hwf (fun l _ h => hP ▸ h) fun j z hz l hl => by\n      rw [hA] at hz\n      by_cases hj : j < s.A.length\n      · rw [List.getElem?_append_left hj] at hz; exact .inl ⟨z, j, hz, hl⟩\n      · rw [List.getElem?_append_right (by omega)] at hz\n        rcases hx z (List.mem_of_getElem? hz) l hl with h | ⟨q, hq⟩\n        · exact .inl h\n        · exact .inr ⟨q, hP ▸ hq⟩,\n     hfo.step fun q pl f hq ho => .inl ⟨pl, hP ▸ hq, ho, by rw [hd]⟩⟩\n  cases hs with\n  | kernel hk =>\n    cases hk with\n    | derive hs =>\n      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n      exact app [_] rfl rfl rfl fun z hz l hl => by\n        rw [List.mem_singleton.1 hz] at hl; exact .inr ⟨_, hl⟩\n    | split hs =>\n      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs\n      refine app _ rfl rfl rfl fun z hz l hl => .inl ?_\n      obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hz\n      have := (hpre.2.2.2.1 r hr l hl).1\n      unfold S3.afp at this; split at this\n      · exact ⟨_, _, ‹_›, this⟩\n      · cases this\n    | release hs =>\n      rename_i a\n      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n      cases hy : s.A[a]? with\n      | none => exact sameA (by simp [releaseEff, hy]) (by simp [releaseEff, hy]) (by simp [releaseEff, hy])\n      | some y =>\n        refine same (by simp [releaseEff, hy]) (by simp [releaseEff, hy]) fun j z hz => ?_\n        rw [release_get hy] at hz; split at hz\n        · rename_i e; subst e; cases hz; exact ⟨y, hy, rfl⟩\n        · exact ⟨z, hz, rfl⟩\n    | transfer hs =>\n      rename_i src dst\n      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n      have hlen : (transferEff s src dst).P.length = s.P.length := by simp [transferEff]\n      have hpar : parentOf (transferEff s src dst).P = parentOf s.P := by\n        funext i; simp only [parentOf, transferEff, List.getElem?_map]\n        cases s.P[i]? with\n        | none => rfl\n        | some pl => simp only [Option.map_some, Option.bind_some]; split <;> rfl\n      refine ⟨hfl.step hwf (fun l _ h => isLeaf_of_parentOf hlen hpar h) fun j z hz l hl => ?_,\n        hfo.step fun q pl f hq ho => ?_⟩\n      · simp only [transferEff, List.getElem?_map] at hz\n        cases hy : s.A[j]? with\n        | none => rw [hy] at hz; cases hz\n        | some y =>\n          rw [hy] at hz; simp only [Option.map_some, Option.some.injEq] at hz\n          refine .inl ⟨y, j, hy, ?_⟩\n          split at hz <;> (subst hz; exact hl)\n      · simp only [transferEff, List.getElem?_map] at hq\n        cases hp : s.P[q]? with\n        | none => rw [hp] at hq; cases hq\n        | some pl' =>\n          rw [hp] at hq; simp only [Option.map_some, Option.some.injEq] at hq\n          split at hq\n          · subst hq\n            rename_i hh\n            cases ho' : pl'.owner with\n            | frame f' => rw [ho'] at hh; exact hh.elim\n            | place r => rw [ho'] at ho; simp [mvTo] at ho\n          · subst hq; exact .inl ⟨pl, hp, ho, rfl⟩\n    | depend hs =>\n      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl\n    | enter hs =>\n      rename_i ps ls\n      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs\n      have hsh := enterPre_shapeOK hpre.1\n      refine ⟨hfl.step hwf (fun l hl h => (shape_isLeaf_old hsh hl).2 h) fun j z hz l hl => ?_,\n        hfo.step fun q pl f hq ho => ?_⟩\n      · rcases enter_get hz with ⟨-, y, hy, rfl⟩ | ⟨-, i, -, rfl⟩\n        · refine .inl ⟨y, j, hy, ?_⟩\n          split at hl <;> exact hl\n        · exact .inr ⟨_, hl⟩\n      · by_cases hqn : q < s.P.length\n        · have : (enterEff s ps ls).P[q]? = s.P[q]? := enterP_lt hqn\n          refine .inl ⟨pl, this ▸ hq, ho, ?_⟩\n          simp [enterEff, Nat.not_le.2 hqn]\n        · exact .inr (by simp [enterEff, Nat.le_of_not_lt hqn])\n    | exit hs =>\n      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n      unfold exitEff; split\n      · rename_i F₀ _\n        refine same rfl rfl fun j z hz => ?_\n        rw [getElem?_mapI] at hz\n        cases hy : s.A[j]? with\n        | none => rw [hy] at hz; cases hz\n        | some y =>\n          rw [hy] at hz; simp only [Option.map_some, Option.some.injEq] at hz; subst hz\n          refine ⟨y, rfl, ?_⟩\n          unfold exitG; split\n          · split <;> rfl\n          · rfl\n      · exact sameA rfl rfl rfl\n    | read hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl\n    | write hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl\n    | writeShared hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl\n    | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl\n    | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl\n    | endUse hs =>\n      rename_i p\n      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n      have hor := (endUseS_releases s p).trans cleanup_releases\n      refine ⟨hfl.step hwf (fun l _ h => h) fun j z hz l hl => ?_, hfo.step fun q pl f hq ho => ?_⟩\n      · obtain ⟨y, hy, -, -, e, -⟩ := hor.2 j z hz; exact .inl ⟨y, j, hy, e ▸ hl⟩\n      · refine .inl ⟨pl, hq, ho, ?_⟩\n        simp only [endUseEff, cleanup, endUseS]\n        have hq' : s.P[q]? = some pl := hq\n        rw [hq', ho]; simp [heldIn]\n    | free hs =>\n      rename_i p auth\n      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs\n      have hor := (freeS_releases s p).trans cleanup_releases\n      refine ⟨hfl.step hwf (fun l _ h => h) fun j z hz l hl => ?_, hfo.step fun q pl f hq ho => ?_⟩\n      · obtain ⟨y, hy, -, -, e, -⟩ := hor.2 j z hz; exact .inl ⟨y, j, hy, e ▸ hl⟩\n      · refine .inl ⟨pl, hq, ho, ?_⟩\n        have hq' : s.P[q]? = some pl := hq\n        have hnp : ¬ partOf s.P q p := fun hpart => by\n          obtain ⟨pl₁, pr, h1, h2, e⟩ := hwf.ownerOf hpart\n          have hor := hpre.2.2.2.1\n          unfold OwnedRoot at hor; rw [h2] at hor\n          rw [hq'] at h1; cases h1; rw [ho] at e\n          obtain ⟨-, hpl⟩ := hor; rw [← e] at hpl; cases hpl\n        simp [freeEff, cleanup, freeS, hnp]\n    | alloc hs =>\n      rename_i pr ow ls\n      cases hs with\n      | ok hst _ =>\n        have hsh := hst.2.2.2.2.2.1\n        refine ⟨hfl.step hwf (fun l hl h => (shape_isLeaf_old hsh hl).2 h) fun j z hz l hl => ?_,\n          hfo.step fun q pl f hq ho => ?_⟩\n        · rcases alloc_get hz with ⟨-, hy⟩ | ⟨-, i, -, rfl⟩\n          · exact .inl ⟨z, j, hy, hl⟩\n          · exact .inr ⟨_, hl⟩\n        · by_cases hqn : q < s.P.length\n          · have : (allocEff s pr ow ls).P[q]? = s.P[q]? := allocP_lt hqn\n            refine .inl ⟨pl, this ▸ hq, ho, ?_⟩\n            simp [allocEff, Nat.not_le.2 hqn]\n          · exact .inr (by simp [allocEff, Nat.le_of_not_lt hqn])\n    | store hs =>\n      rename_i a p\n      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs\n      obtain ⟨y, hy, -⟩ := store_pre_auth hpre.1\n      refine same (by rw [storeEff_eq hy]) (by rw [storeEff_eq hy]) fun j z hz => ?_\n      rw [store_get hy] at hz; split at hz\n      · rename_i e; subst e; cases hz; exact ⟨y, hy, rfl⟩\n      · exact ⟨z, hz, rfl⟩\n  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl\n  | issue hs =>\n    cases hs with\n    | ok har hst =>\n      cases hst with\n      | ok hstat _ _ _ =>\n        refine app [_] rfl rfl rfl fun z hz l hl => .inl ?_\n        rw [List.mem_singleton.1 hz] at hl\n        have := hstat.2.2.1 l hl\n        unfold S3.afp at this; split at this\n        · exact ⟨_, _, ‹_›, this⟩\n        · cases this\n  | reset hs =>\n    rename_i i via\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold resetAtEff; split\n    · exact sameA rfl rfl rfl\n    · exact sameA rfl rfl rfl\n\n/-- `FpLeaves` and `FrameOwnedLive` hold on every reached state (MM-03.3 §2.1, §10), under\n`DDSound k`, the hypothesis under which `WF3` is proved on reached states. -/\ntheorem reachable_fpLeaves_frameOwnedLive {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n    (h : Reachable k statics s) : FpLeaves s ∧ FrameOwnedLive s := by\n  have st : ∀ {s s' : S3}, Reachable k statics s → FpLeaves s ∧ FrameOwnedLive s → Step k s s' →\n      FpLeaves s' ∧ FrameOwnedLive s' := fun hr ih hs =>\n    step_fpLeaves_frameOwnedLive (reachable_invariants hdd hr).1 ih hs\n  induction h with\n  | init _ =>\n    refine ⟨fun j z hz l hl => ?_, fun _ _ _ _ _ => rfl⟩\n    obtain ⟨i, -, rfl⟩ := init_get hz\n    exact (mem_footprint.1 hl).2.1\n  | derive hr hs ih => exact st hr ih (.kernel (.derive hs))\n  | split hr hs ih => exact st hr ih (.kernel (.split hs))\n  | release hr hs ih => exact st hr ih (.kernel (.release hs))\n  | transfer hr hs ih => exact st hr ih (.kernel (.transfer hs))\n  | depend hr hs ih => exact st hr ih (.kernel (.depend hs))\n  | enter hr hs ih => exact st hr ih (.kernel (.enter hs))\n  | exit hr hs ih => exact st hr ih (.kernel (.exit hs))\n  | read hr hs ih => exact st hr ih (.kernel (.read hs))\n  | write hr hs ih => exact st hr ih (.kernel (.write hs))\n  | writeShared hr hs ih => exact st hr ih (.kernel (.writeShared hs))\n  | pin hr hs ih => exact st hr ih (.kernel (.pin hs))\n  | unpin hr hs ih => exact st hr ih (.kernel (.unpin hs))\n  | endUse hr hs ih => exact st hr ih (.kernel (.endUse hs))\n  | free hr hs ih => exact st hr ih (.kernel (.free hs))\n  | alloc hr hs ih => exact st hr ih (.kernel (.alloc hs))\n  | newArena hr hs ih => exact st hr ih (.newArena hs)\n  | issue hr hs ih => exact st hr ih (.issue hs)\n  | reset hr hs ih => exact st hr ih (.reset hs)\n  | store hr hs ih => exact st hr ih (.kernel (.store hs))\n\n/-! ## Smoke test -/","originalFile":null,"structuredPatch":[{"oldStart":998,"oldLines":6,"newStart":998,"newLines":261,"lines":["     obtain ⟨y, hy, ya, hly⟩ := covered_of_effective (hc l hl).1","     exact covered_live hwf hnd hfl hR hy ya hly) hdec"," ","+/-! ## Two invariants of the reached states missing from the draft -/","+","+/-- A place owned by a frame is not marked dead (MM-03.3.2: `endUse` and `free` mark dead only","+storage owned by a value, O12, O13; a local of a frame dies by the exit of the frame, O7). -/","+def FrameOwnedLive (s : S3) : Prop :=","+  ∀ (q : Nat) (pl : Place) (f : Nat), s.P[q]? = some pl → pl.owner = .frame f → s.dead q = false","+","+/-- `FpLeaves` carries over when the old leaves stay leaves and every leaf covered after the step","+is covered before it or is a leaf of a place after it. -/","+theorem FpLeaves.step {s s' : S3} (hwf : WF3 s) (h : FpLeaves s)","+    (hleaf : ∀ l < s.P.length, isLeaf s.P l → isLeaf s'.P l)","+    (hA : ∀ j z, s'.A[j]? = some z → ∀ l ∈ z.footprint,","+      (∃ y j', s.A[j']? = some y ∧ l ∈ y.footprint) ∨ ∃ q, l ∈ footprint s'.P q) :","+    FpLeaves s' := by","+  intro j z hz l hl","+  rcases hA j z hz l hl with ⟨y, j', hy, hly⟩ | ⟨q, hq⟩","+  · exact hleaf l (hwf.fp j' y hy l hly) (h j' y hy l hly)","+  · exact (mem_footprint.1 hq).2.1","+","+/-- `FrameOwnedLive` carries over when every place owned by a frame after the step was owned by","+that frame with the same `dead` mark before it, or is alive. -/","+theorem FrameOwnedLive.step {s s' : S3} (h : FrameOwnedLive s)","+    (hP : ∀ q pl f, s'.P[q]? = some pl → pl.owner = .frame f →","+      (∃ pl', s.P[q]? = some pl' ∧ pl'.owner = .frame f ∧ s'.dead q = s.dead q) ∨","+        s'.dead q = false) : FrameOwnedLive s' := by","+  intro q pl f hq ho","+  rcases hP q pl f hq ho with ⟨pl', hq', ho', e⟩ | e","+  · rw [e]; exact h q pl' f hq' ho'","+  · exact e","+","+theorem isLeaf_of_parentOf {P P' : List Place} (hlen : P'.length = P.length)","+    (hpar : parentOf P' = parentOf P) {l : Nat} (h : isLeaf P l) : isLeaf P' l := by","+  simp only [isLeaf, hlen, hpar]; exact h","+","+/-- `FpLeaves` and `FrameOwnedLive` are preserved by every step of `Reachable` (`Step`), under","+`WF3`. -/","+theorem step_fpLeaves_frameOwnedLive {k : K} {s s' : S3} (hwf : WF3 s)","+    (h : FpLeaves s ∧ FrameOwnedLive s) (hs : Step k s s') :","+    FpLeaves s' ∧ FrameOwnedLive s' := by","+  obtain ⟨hfl, hfo⟩ := h","+  -- steps changing no place and keeping each footprint","+  have same : ∀ {s'' : S3}, s''.P = s.P → s''.dead = s.dead →","+      (∀ j z, s''.A[j]? = some z → ∃ y, s.A[j]? = some y ∧ z.footprint = y.footprint) →","+      FpLeaves s'' ∧ FrameOwnedLive s'' := fun hP hd hA =>","+    ⟨hfl.step hwf (fun l _ h => hP ▸ h) fun j z hz l hl => by","+      obtain ⟨y, hy, e⟩ := hA j z hz; exact .inl ⟨y, j, hy, e ▸ hl⟩,","+     hfo.step fun q pl f hq ho => .inl ⟨pl, hP ▸ hq, ho, by rw [hd]⟩⟩","+  have sameA : ∀ {s'' : S3}, s''.P = s.P → s''.dead = s.dead → s''.A = s.A →","+      FpLeaves s'' ∧ FrameOwnedLive s'' := fun hP hd hA =>","+    same hP hd fun j z hz => ⟨z, hA ▸ hz, rfl⟩","+  -- steps appending authorities to `A`, places unchanged","+  have app : ∀ {s'' : S3} (extra : List Authority), s''.P = s.P → s''.dead = s.dead →","+      s''.A = s.A ++ extra → (∀ z ∈ extra, ∀ l ∈ z.footprint,","+        (∃ y j', s.A[j']? = some y ∧ l ∈ y.footprint) ∨ ∃ q, l ∈ footprint s.P q) →","+      FpLeaves s'' ∧ FrameOwnedLive s'' := fun hP hd hA hx =>","+    ⟨hfl.step hwf (fun l _ h => hP ▸ h) fun j z hz l hl => by","+      rw [hA] at hz","+      by_cases hj : j < s.A.length","+      · rw [List.getElem?_append_left hj] at hz; exact .inl ⟨z, j, hz, hl⟩","+      · rw [List.getElem?_append_right (by omega)] at hz","+        rcases hx z (List.mem_of_getElem? hz) l hl with h | ⟨q, hq⟩","+        · exact .inl h","+        · exact .inr ⟨q, hP ▸ hq⟩,","+     hfo.step fun q pl f hq ho => .inl ⟨pl, hP ▸ hq, ho, by rw [hd]⟩⟩","+  cases hs with","+  | kernel hk =>","+    cases hk with","+    | derive hs =>","+      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+      exact app [_] rfl rfl rfl fun z hz l hl => by","+        rw [List.mem_singleton.1 hz] at hl; exact .inr ⟨_, hl⟩","+    | split hs =>","+      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs","+      refine app _ rfl rfl rfl fun z hz l hl => .inl ?_","+      obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hz","+      have := (hpre.2.2.2.1 r hr l hl).1","+      unfold S3.afp at this; split at this","+      · exact ⟨_, _, ‹_›, this⟩","+      · cases this","+    | release hs =>","+      rename_i a","+      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+      cases hy : s.A[a]? with","+      | none => exact sameA (by simp [releaseEff, hy]) (by simp [releaseEff, hy]) (by simp [releaseEff, hy])","+      | some y =>","+        refine same (by simp [releaseEff, hy]) (by simp [releaseEff, hy]) fun j z hz => ?_","+        rw [release_get hy] at hz; split at hz","+        · rename_i e; subst e; cases hz; exact ⟨y, hy, rfl⟩","+        · exact ⟨z, hz, rfl⟩","+    | transfer hs =>","+      rename_i src dst","+      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+      have hlen : (transferEff s src dst).P.length = s.P.length := by simp [transferEff]","+      have hpar : parentOf (transferEff s src dst).P = parentOf s.P := by","+        funext i; simp only [parentOf, transferEff, List.getElem?_map]","+        cases s.P[i]? with","+        | none => rfl","+        | some pl => simp only [Option.map_some, Option.bind_some]; split <;> rfl","+      refine ⟨hfl.step hwf (fun l _ h => isLeaf_of_parentOf hlen hpar h) fun j z hz l hl => ?_,","+        hfo.step fun q pl f hq ho => ?_⟩","+      · simp only [transferEff, List.getElem?_map] at hz","+        cases hy : s.A[j]? with","+        | none => rw [hy] at hz; cases hz","+        | some y =>","+          rw [hy] at hz; simp only [Option.map_some, Option.some.injEq] at hz","+          refine .inl ⟨y, j, hy, ?_⟩","+          split at hz <;> (subst hz; exact hl)","+      · simp only [transferEff, List.getElem?_map] at hq","+        cases hp : s.P[q]? with","+        | none => rw [hp] at hq; cases hq","+        | some pl' =>","+          rw [hp] at hq; simp only [Option.map_some, Option.some.injEq] at hq","+          split at hq","+          · subst hq","+            rename_i hh","+            cases ho' : pl'.owner with","+            | frame f' => rw [ho'] at hh; exact hh.elim","+            | place r => rw [ho'] at ho; simp [mvTo] at ho","+          · subst hq; exact .inl ⟨pl, hp, ho, rfl⟩","+    | depend hs =>","+      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl","+    | enter hs =>","+      rename_i ps ls","+      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs","+      have hsh := enterPre_shapeOK hpre.1","+      refine ⟨hfl.step hwf (fun l hl h => (shape_isLeaf_old hsh hl).2 h) fun j z hz l hl => ?_,","+        hfo.step fun q pl f hq ho => ?_⟩","+      · rcases enter_get hz with ⟨-, y, hy, rfl⟩ | ⟨-, i, -, rfl⟩","+        · refine .inl ⟨y, j, hy, ?_⟩","+          split at hl <;> exact hl","+        · exact .inr ⟨_, hl⟩","+      · by_cases hqn : q < s.P.length","+        · have : (enterEff s ps ls).P[q]? = s.P[q]? := enterP_lt hqn","+          refine .inl ⟨pl, this ▸ hq, ho, ?_⟩","+          simp [enterEff, Nat.not_le.2 hqn]","+        · exact .inr (by simp [enterEff, Nat.le_of_not_lt hqn])","+    | exit hs =>","+      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+      unfold exitEff; split","+      · rename_i F₀ _","+        refine same rfl rfl fun j z hz => ?_","+        rw [getElem?_mapI] at hz","+        cases hy : s.A[j]? with","+        | none => rw [hy] at hz; cases hz","+        | some y =>","+          rw [hy] at hz; simp only [Option.map_some, Option.some.injEq] at hz; subst hz","+          refine ⟨y, rfl, ?_⟩","+          unfold exitG; split","+          · split <;> rfl","+          · rfl","+      · exact sameA rfl rfl rfl","+    | read hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl","+    | write hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl","+    | writeShared hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl","+    | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl","+    | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl","+    | endUse hs =>","+      rename_i p","+      obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+      have hor := (endUseS_releases s p).trans cleanup_releases","+      refine ⟨hfl.step hwf (fun l _ h => h) fun j z hz l hl => ?_, hfo.step fun q pl f hq ho => ?_⟩","+      · obtain ⟨y, hy, -, -, e, -⟩ := hor.2 j z hz; exact .inl ⟨y, j, hy, e ▸ hl⟩","+      · refine .inl ⟨pl, hq, ho, ?_⟩","+        simp only [endUseEff, cleanup, endUseS]","+        have hq' : s.P[q]? = some pl := hq","+        rw [hq', ho]; simp [heldIn]","+    | free hs =>","+      rename_i p auth","+      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs","+      have hor := (freeS_releases s p).trans cleanup_releases","+      refine ⟨hfl.step hwf (fun l _ h => h) fun j z hz l hl => ?_, hfo.step fun q pl f hq ho => ?_⟩","+      · obtain ⟨y, hy, -, -, e, -⟩ := hor.2 j z hz; exact .inl ⟨y, j, hy, e ▸ hl⟩","+      · refine .inl ⟨pl, hq, ho, ?_⟩","+        have hq' : s.P[q]? = some pl := hq","+        have hnp : ¬ partOf s.P q p := fun hpart => by","+          obtain ⟨pl₁, pr, h1, h2, e⟩ := hwf.ownerOf hpart","+          have hor := hpre.2.2.2.1","+          unfold OwnedRoot at hor; rw [h2] at hor","+          rw [hq'] at h1; cases h1; rw [ho] at e","+          obtain ⟨-, hpl⟩ := hor; rw [← e] at hpl; cases hpl","+        simp [freeEff, cleanup, freeS, hnp]","+    | alloc hs =>","+      rename_i pr ow ls","+      cases hs with","+      | ok hst _ =>","+        have hsh := hst.2.2.2.2.2.1","+        refine ⟨hfl.step hwf (fun l hl h => (shape_isLeaf_old hsh hl).2 h) fun j z hz l hl => ?_,","+          hfo.step fun q pl f hq ho => ?_⟩","+        · rcases alloc_get hz with ⟨-, hy⟩ | ⟨-, i, -, rfl⟩","+          · exact .inl ⟨z, j, hy, hl⟩","+          · exact .inr ⟨_, hl⟩","+        · by_cases hqn : q < s.P.length","+          · have : (allocEff s pr ow ls).P[q]? = s.P[q]? := allocP_lt hqn","+            refine .inl ⟨pl, this ▸ hq, ho, ?_⟩","+            simp [allocEff, Nat.not_le.2 hqn]","+          · exact .inr (by simp [allocEff, Nat.le_of_not_lt hqn])","+    | store hs =>","+      rename_i a p","+      obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs","+      obtain ⟨y, hy, -⟩ := store_pre_auth hpre.1","+      refine same (by rw [storeEff_eq hy]) (by rw [storeEff_eq hy]) fun j z hz => ?_","+      rw [store_get hy] at hz; split at hz","+      · rename_i e; subst e; cases hz; exact ⟨y, hy, rfl⟩","+      · exact ⟨z, hz, rfl⟩","+  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact sameA rfl rfl rfl","+  | issue hs =>","+    cases hs with","+    | ok har hst =>","+      cases hst with","+      | ok hstat _ _ _ =>","+        refine app [_] rfl rfl rfl fun z hz l hl => .inl ?_","+        rw [List.mem_singleton.1 hz] at hl","+        have := hstat.2.2.1 l hl","+        unfold S3.afp at this; split at this","+        · exact ⟨_, _, ‹_›, this⟩","+        · cases this","+  | reset hs =>","+    rename_i i via","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    unfold resetAtEff; split","+    · exact sameA rfl rfl rfl","+    · exact sameA rfl rfl rfl","+","+/-- `FpLeaves` and `FrameOwnedLive` hold on every reached state (MM-03.3 §2.1, §10), under","+`DDSound k`, the hypothesis under which `WF3` is proved on reached states. -/","+theorem reachable_fpLeaves_frameOwnedLive {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}","+    (h : Reachable k statics s) : FpLeaves s ∧ FrameOwnedLive s := by","+  have st : ∀ {s s' : S3}, Reachable k statics s → FpLeaves s ∧ FrameOwnedLive s → Step k s s' →","+      FpLeaves s' ∧ FrameOwnedLive s' := fun hr ih hs =>","+    step_fpLeaves_frameOwnedLive (reachable_invariants hdd hr).1 ih hs","+  induction h with","+  | init _ =>","+    refine ⟨fun j z hz l hl => ?_, fun _ _ _ _ _ => rfl⟩","+    obtain ⟨i, -, rfl⟩ := init_get hz","+    exact (mem_footprint.1 hl).2.1","+  | derive hr hs ih => exact st hr ih (.kernel (.derive hs))","+  | split hr hs ih => exact st hr ih (.kernel (.split hs))","+  | release hr hs ih => exact st hr ih (.kernel (.release hs))","+  | transfer hr hs ih => exact st hr ih (.kernel (.transfer hs))","+  | depend hr hs ih => exact st hr ih (.kernel (.depend hs))","+  | enter hr hs ih => exact st hr ih (.kernel (.enter hs))","+  | exit hr hs ih => exact st hr ih (.kernel (.exit hs))","+  | read hr hs ih => exact st hr ih (.kernel (.read hs))","+  | write hr hs ih => exact st hr ih (.kernel (.write hs))","+  | writeShared hr hs ih => exact st hr ih (.kernel (.writeShared hs))","+  | pin hr hs ih => exact st hr ih (.kernel (.pin hs))","+  | unpin hr hs ih => exact st hr ih (.kernel (.unpin hs))","+  | endUse hr hs ih => exact st hr ih (.kernel (.endUse hs))","+  | free hr hs ih => exact st hr ih (.kernel (.free hs))","+  | alloc hr hs ih => exact st hr ih (.kernel (.alloc hs))","+  | newArena hr hs ih => exact st hr ih (.newArena hs)","+  | issue hr hs ih => exact st hr ih (.issue hs)","+  | reset hr hs ih => exact st hr ih (.reset hs)","+  | store hr hs ih => exact st hr ih (.kernel (.store hs))","+"," /-! ## Smoke test -/"," "," namespace Smoke"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"dad91ada-eac1-4bfa-bbc7-12ffa3dc0ccd","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
