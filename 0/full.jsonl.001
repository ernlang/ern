yModel/Access/Lemmas.lean-152-/-- Footprints depend only on the number of places and on structural parents (§40). -/\n135:theorem eff_present {t : S3} {y l : Nat} (h : effective t y l ≠ none) :\n136-    ∃ z, t.A[y]? = some z ∧ z.active = true ∧ l ∈ z.footprint ∧ Mode.modify ∉ descModes t y l := by\n137-  unfold effective at h\n138-  split at h\n139-  · rename_i z hz\n140-    split at h\n141-    · rename_i hc\nErn/MemoryModel/Access/Lemmas.lean:1165:theorem mvTo_part {s : S3} (hw : WF3 s) {src dst : Nat} (hd : dst < s.P.length) {h : Holder}\nErn/MemoryModel/Access/Lemmas.lean-1166-    (hh : heldIn s.P src h) : ∃ r', mvTo s.P src dst h = .place r' ∧ partOf s.P r' dst := by\nErn/MemoryModel/Access/Lemmas.lean-1167-  cases h with\nErn/MemoryModel/Access/Lemmas.lean-1168-  | frame f => exact hh.elim\nErn/MemoryModel/Access/Lemmas.lean-1169-  | place r =>\n695:theorem WF3.parent_lt {s : S3} (hw : WF3 s) {i o : Nat} (h : parentOf s.P i = some o) :\n696-    o < i ∧ o < s.P.length := by\n697-  simp only [parentOf] at h\n698-  cases hp : s.P[i]? with","is_error":false}]},"uuid":"b8181407-871c-44c8-927f-bb3f76f1ef60","timestamp":"2026-11-12T23:14:14.275Z","toolUseResult":{"stdout":"Ern/MemoryModel/Access/Lemmas.lean:43:theorem chain_none {org : Nat → Option Nat} {i : Nat} (h : org i = none) : chain org i = [] :=\nErn/MemoryModel/Access/Lemmas.lean-44-  chainF_none h i\nErn/MemoryModel/Access/Lemmas.lean-45-\nErn/MemoryModel/Access/Lemmas.lean-46-/-- The chain of `i` is its link followed by the chain of the link (§40, §42). -/\nErn/MemoryModel/Access/Lemmas.lean-47-theorem chain_cons {org : Nat → Option Nat} {i o : Nat} (h : org i = some o) (hlt : o < i) :\n--\nErn/MemoryModel/Access/Lemmas.lean:66:theorem chain_lt {org : Nat → Option Nat} {i j : Nat} (h : j ∈ chain org i) : j < i :=\nErn/MemoryModel/Access/Lemmas.lean-67-  chainF_lt i i j h\nErn/MemoryModel/Access/Lemmas.lean-68-\nErn/MemoryModel/Access/Lemmas.lean-69-/-- A chain within fuel `k` has at most `k` elements (§49, 