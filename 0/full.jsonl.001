region of `a` (base + offset) and that carry, each, the provenance of the allocation of `l`, which","+is live and contains the range of `l`: no address or provenance is lost or fabricated. -/","+theorem pointer_sound_store {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec}","+    {ObW : MM02.WriteOblSpec} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout}","+    {s3 s3' : S3} {s2 : MM02.State} {pe : PtrEnc} {a p : Nat} (hwf : WF3 s3)","+    (hnd : NoDangling s3) (hfl : FpLeaves s3) (hR : Repr tok ptok provOf L s3 s2)","+    (h : StoreStep a p s3 (.ok s3')) (hstatW : ∀ s ac w, ObW.stat s ac w)","+    (hdec : ObW.dec s2 (leafAcc s2 L .write p) (ptrBytes pe s2 L (s3.afp a)))","+    {l : Nat} (hl : (s3.afp a).head? = some l)","+    (hpe : PtrEncAt pe (regionAddr s2 L (s3.afp a)) (regionProv L (s3.afp a))) :","+    pe.decode (ptrBytes pe s2 L (s3.afp a)) = regionAddr s2 L (s3.afp a) ∧","+      (∀ i, (ptrBytes pe s2 L (s3.afp a) i).2 = some (L l).alloc) ∧","+      (∃ al, s2.allocs (L l).alloc = some al ∧ al.live = true ∧","+        regionAddr s2 L (s3.afp a) = al.base + (L l).off ∧ (L l).off + (L l).len ≤ al.size) ∧","+      rangeBytes (exec s2 (storeOps pe s2 L s3 a p)) L p = some ((List.range (L p).len).map","+        fun i => .init (ptrBytes pe s2 L (s3.afp a) i).1 (ptrBytes pe s2 L (s3.afp a) i).2) := by","+  have hst := (r6_store (C := C) (ObR := ObR) hwf hR h hstatW hdec).2.2","+  obtain ⟨hpre, -⟩ := Guarded.ok_iff.1 h","+  obtain ⟨y, hy, ya, -, -⟩ := store_pre_auth hpre.1","+  have hrg : ∀ x ∈ s3.afp a, x ∈ y.footprint := fun x hx => by simpa [S3.afp, hy] using hx","+  obtain ⟨hprov, hta⟩ := ptr_target hwf hnd hfl hR.toReprB hy ya hrg hl","+  refine ⟨hpe.1, fun i => ?_, hta, hst⟩","+  rw [← hprov]; exact hpe.2 i","+","+/-- L6, `pointer_sound` for `issue`: under the obligation of the encoding for the pointer written,","+the range of the destination holds bytes that decode to the address of the first leaf `l` of the","+block and carry, each, the provenance of the allocation of `l` (the allocation of the storage of the","+arena), which is live and contains the range of `l`. -/","+theorem pointer_sound_issue {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec}","+    {ObW : MM02.WriteOblSpec} {k : K} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}","+    {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pe : PtrEnc} {i via dst : Nat}","+    {region : List Nat} (hwf : WF3 s3) (hnd : NoDangling s3) (hfl : FpLeaves s3)","+    (hR : Repr tok ptok provOf L s3 s2) (h : IssueAt k i via region dst s3 (.ok s3'))","+    (hstatW : ∀ s ac w, ObW.stat s ac w)","+    (hdec : ObW.dec s2 (leafAcc s2 L .write dst) (ptrBytes pe s2 L region))","+    {l : Nat} (hl : region.head? = some l)","+    (hpe : PtrEncAt pe (regionAddr s2 L region) (regionProv L region)) :","+    pe.decode (ptrBytes pe s2 L region) = regionAddr s2 L region ∧","+      (∀ i, (ptrBytes pe s2 L region i).2 = some (L l).alloc) ∧","+      (∃ al, s2.allocs (L l).alloc = some al ∧ al.live = true ∧","+        regionAddr s2 L region = al.base + (L l).off ∧ (L l).off + (L l).len ≤ al.size) ∧","+      rangeBytes (exec s2 (issueOps pe s2 L region dst)) L dst = some ((List.range (L dst).len).map","+        fun i => .init (ptrBytes pe s2 L region i).1 (ptrBytes pe s2 L region i).2) := by","+  have hst := (r6_issue (C := C) (ObR := ObR) hwf hR h hstatW hdec).2.2","+  cases h with","+  | ok har hstep =>","+    cases hstep with","+    | ok hstat _ _ _ =>","+      have hact := hstat.2.1","+      obtain ⟨y, hy, ya⟩ := hact","+      have hrg : ∀ x ∈ region, x ∈ y.footprint := fun x hx => by","+        have := hstat.2.2.1 x hx; simpa [S3.afp, hy] using this","+      obtain ⟨hprov, hta⟩ := ptr_target hwf hnd hfl hR.toReprB hy ya hrg hl","+      refine ⟨hpe.1, fun i => ?_, hta, hst⟩","+      rw [← hprov]; exact hpe.2 i","+"," /-! ## Real `DDSound` (L7) -/"," "," /-- L7: instantiation of `K.DeclaredDisjoint` by the disjointness of the byte ranges of the leaves of"]}]}],"moreFiles":0,"changedFiles