"\"\",\"\"\"    refine hR.toReprB.shrink rfl rfl rfl (fun q hq => S3.Usable.mono\"\"\")\n# exit reachable\nrep(\"\"\"    (hR : ReprB tok ptok provOf L s3 s2) (htc : TokCompat C tok) (h : ExitStep k s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (exitOps L tok s3) ∧ ReprB tok ptok provOf L s3' (exec s2 (exitOps L tok s3)) :=\"\"\",\"\"\"    (hR : Repr tok ptok provOf L s3 s2) (htc : TokCompat C tok) (h : ExitStep k s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (exitOps L tok s3) ∧\n      Repr tok ptok provOf L s3' (exec s2 (exitOps L tok s3)) :=\"\"\")\n# r4\nrep(\"\"\"    {s2 : MM02.State} (hdd : DDSound k) (hr : Reachable k statics s3) (hR : ReprB tok ptok provOf L s3 s2) :\"\"\",\"\"\"    {s2 : MM02.State} (hdd : DDSound k) (hr : Reachable k statics s3)\n    (hR : Repr tok ptok provOf L s3 s2) :\"\"\")\nrep(\"\"\"    (reachable_invariants hdd hr).2.1.nd (reachable_fpLeaves_frameOwnedLive hdd hr).1 hR hy ya hl\"\"\",\"\"\"    (reachable_invariants hdd hr).2.1.nd (reachable_fpLeaves_frameOwnedLive hdd hr).1 hR.toReprB hy ya\n    hl\"\"\")\nopen(p,'w').write(s)\nEOF\n~/.elan/bin/lake env lean Ern/MM23.lean 2>&1 | grep -E \"^Ern\" | head","description":"Convert exit, no-step, R4 theorems to Repr"},"caller":{"type":"direct"}}]}}
