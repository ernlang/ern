\n115-  | t, v :: vs => ValTransferPre k fin t c v.1 v.2 ∧\n116-      ValTransfersPre k fin c (transferEffC t c v.1 v.2) vs\n117-\n118-/-- Decidability of `ValTransfersPre` (WC4 C5.2). -/\n119-instance instDecidableValTransfersPre (k : K) [DecidablePred k.Pinned] (fin : S3) (c : Nat) :\n120-    (t : SC) → (vs : List (Nat × Nat)) → Decidable (ValTransfersPre k fin c t vs)\n121-  | _, [] => isTrue trivial\n122-  | t, v :: vs =>\n123-    haveI := instDecidableValTransfersPre k fin c (transferEffC t c v.1 v.2) vs\n124-    inferInstanceAs (Decidable (ValTransferPre k fin t c v.1 v.2 ∧ _))\n125-\n126-/-- Preconditions of the by-value composite executed by `c` (WC4 C4.1, C4.3, C4.5, C4.6, C5.1–C5.4\n127-and C5 items 1–5). C4.2 (fresh identities), C4.4 and C5 item 6 (no duplication) hold by\n128-construction of `spawnValEff`; the preservation obligations of WC4 C4 and C5 are theorems, not\n129-preconditions. -/\n130-structure SpawnValPre (k : K) (s : SC) (c : Nat) (ps : List Nat) (ls : LocalShape)\n131-    (vs : List (Nat × Nat)) : Prop where\n132-  /-- WC4 C4.1: the creating context and its current frame are live. -/\n133-  creatorLive : s.stk c ≠ []\n134-  /-- WC4 C4.3, C5.3 (Spec 1 §72.1): every parameter is an active derived authority held by the\n135-  creating frame before the composite. -/\n136-  params : ∀ a ∈ ps, OptP ((s.view c).A[a]?) (fun y => y.active = true ∧\n137-    y.holder = .frame (s.view c).top ∧ y.origin ≠ none) False\n138-  /-- WC4 C4.5 (Spec 1 §72.2): the locals form a well-formed shape. -/","is_error":false}]},"uuid":"7cc39f2e-04f6-4334-a63b-460c359166f0","timestamp":"2026-11-13T01:29:42.766Z","toolUseResult":{"stdout":"24:/-! ## Yield and transfer commute -/\n28:theorem mapI_map_comm {F : Nat → Authority → Authority} {G : Authority → Authority} :\n41:def yieldF (ps : List Nat) (f : Nat) (j : Nat) (y : Authority) : Authority :=\n45:def moveF (P : List Place) (src dst : Nat) (y : Authority) : Authority :=\n49:theorem not_heldIn_frame {P : List Place} 