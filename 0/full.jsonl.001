Concurrency/Cap.lean-81-    | held hy => exact List.mem_range.2 (lt_of_getElem? hy)\nErn/Concurrency/Cap.lean-82-  cases m with\nErn/Concurrency/Cap.lean-83-  | modify =>\nErn/Concurrency/Cap.lean-84-    have h1 : CapAt s c l .modify := ⟨x, hb, hx, he⟩\nErn/Concurrency/Cap.lean-85-    simp only [cap, h1, ↓reduceIte]; exact Or.inr rfl\nErn/Concurrency/Cap.lean-86-  | observe =>\nErn/Concurrency/Cap.lean-87-    by_cases h : CapAt s c l .modify\nErn/MemoryModel/Access/Ops.lean:475:def enterEff (s : S3) (ps : List Nat) (ls : LocalShape) : S3 :=\nErn/MemoryModel/Access/Ops.lean-476-  { F := s.nF :: s.F, nF := s.nF + 1, P := enterP s ls\nErn/MemoryModel/Access/Ops.lean-477-    I := fun l => if s.P.length ≤ l then .uninit else s.I l\nErn/MemoryModel/Access/Ops.lean-478-    A := mapI (fun j y => if j ∈ ps then { y with holder := .frame s.nF } else y) 0 s.A ++\nErn/MemoryModel/Access/Ops.lean-479-      (rootIdx ls.toShape).map fun i =>\nErn/MemoryModel/Access/Ops.lean-480-        ⟨.modify, none, footprint (enterP s ls) (s.P.length + i),\nErn/MemoryModel/Access/Ops.lean-481-          shapeOwner ls.toShape (.frame s.nF) i, true⟩\nErn/MemoryModel/Access/Ops.lean-482-    D := fun q => if s.P.length ≤ q then [] else s.D q\nErn/MemoryModel/Access/Ops.lean-483-    dead := fun q => if s.P.length ≤ q then false else s.dead q\nErn/MemoryModel/Access/Ops.lean-484-    pins := s.pins }\nErn/MemoryModel/Access/Ops.lean-485-\nErn/MemoryModel/Access/Ops.lean-486-/-- Origin protection on entry for parameter `p` in state `s'` (§72.3): if `p` is a `Modify`\nErn/MemoryModel/Access/Ops.lean-487-authority with direct origin `o`, `o` is exercisable in no mode. -/\n--\nErn/MemoryModel/Access/Ops.lean:699:def endUseEff (s : S3) (p : Nat) : S3 := cleanup (endUseS s p)\nErn/MemoryModel/Access/Ops.lean-700-\nErn/MemoryModel/Access/Ops.lean-701-/-- Leaf whose use ends with the value at `p` (§69.2, §69.4): a leaf of `p` or of storage that\nErn/MemoryModel/Access/Ops.lean-702-stops being usable. -/\nErn/MemoryModel/Access/Ops.lean-703-def EndingLeaf (s : S3) (p l : Nat) : Prop :=\nErn/MemoryModel/Access/Ops.lean-704-  l ∈ footprint s.P p ∨ (isLeaf s.P l ∧ s.Usable l ∧ ¬ (endUseS s p).Usable l)\nErn/MemoryModel/Access/Ops.lean-705-\nErn/MemoryModel/Access/Ops.lean-706-/-- Decidability of `EndingLeaf` (§69). -/\nErn/MemoryModel/Access/Ops.lean-707-instance (s : S3) (p l : Nat) : Decidable (EndingLeaf s p l) := by\nErn/MemoryModel/Access/Ops.lean-708-  unfold EndingLeaf; infer_instance\nErn/MemoryModel/Access/Ops.lean-709-\nErn/MemoryModel/Access/Ops.lean-710-/-- Root authority of the value at `p` (§69.3): an authority with no origin covering a leaf of\nErn/MemoryModel/Access/Ops.lean-711-`p`. -/\n--\nErn/MemoryModel/Access/Ops.lean:812:def freeEff (s : S3) (p : Nat) : S3 := cleanup (freeS s p)\nErn/MemoryModel/Access/Ops.lean-813-\nErn/MemoryModel/Access/Ops.lean-814-/-- Leaf of the released unit (§70.3, §70.4): a leaf of `p` or of storage that stops being\nErn/MemoryModel/Access/Ops.lean-815-usable. -/\nErn/MemoryModel/Access/Ops.lean-816-def FreedLeaf (s : S3) (p l : Nat) : Prop :=\nErn/MemoryModel/Access/Ops.lean-817-  l ∈ footprint s.P p ∨ (isLeaf s.P l ∧ s.Usable l ∧ ¬ (freeS s p).Usable l)\nErn/MemoryModel/Access/Ops.lean-818-\nErn/MemoryModel/Access/Ops.lean-819-/-- Decidability of `FreedLeaf` (§70). -/\nErn/MemoryModel/Access/Ops.lean-820-instance (s : S3) (p l : Nat) : Decidable (FreedLeaf s p l) := by\nErn/MemoryModel/Access/Ops.lean-821-  unfold FreedLeaf; infer_instance\nErn/MemoryModel/Access/Ops.lean-822-\nErn/MemoryModel/Access/Ops.lean-823-/-- Authority `j` does not block `free p` (§70.3): if it is an active derivative over the\nErn/MemoryModel/Access/Ops.lean-824-footprint being freed, it is held within `p` or its holder dies. -/\nErn/Concurrency/Frames.lean:225:def exitEffC (s : SC) (c : Nat) : SC :=\nErn/Concurrency/Frames.lean-226-  { s.set (exitEff (s.view c)) with\nErn/Concurrency/Frames.lean-227-    C := reparent (s.C.modify c fun x => { x with 