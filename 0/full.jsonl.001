Reg) : Prop := ∃ e ∈ st.2.1, e.Live st.1","+","+/-- Decidability of `LiveAt`. -/","+instance (st : SC × SyncReg × ArenaReg) : Decidable (LiveAt st) := by","+  unfold LiveAt; infer_instance","+","+/-- Statics of the trace of legitimate uses (Spec 1 §47): those of W-GI (block MX without `M′`, the","+free arena storage `ST0` with `R1`, `R2`, the arena value `AV0`), and two root leaves of the base","+frame, `8` (`Y`, `Init`) and `9` (`P`, `Init`). Root authorities: `0` of `M`, `1` of `T` (held by","+`M`), `2` of `ST0`, `3` of `AV0`, `4` of `Y`, `5` of `P`; all but `1` held by frame 0. -/","+def lvst : Statics := Witness.gist ++ [((none, none, 0), true), ((none, none, 0), true)]","+","+/-- The statics are well formed (Spec 1 §47). -/","+theorem lvst_ok : StaticsOK lvst := by decide","+","+/-- The contract of the trace: `lock` (place 2) and `Y` (place 8) are `SharedMutable`. -/","+abbrev KL : K := Corpus.KC [2, 8]","+","+/-- The arena of the trace (Spec 1 §46). -/","+def lvE : Arena.ArenaEntry := ⟨4, 7, [5, 6], []⟩","+","+/-- Initial state. -/","+def lv0 : SC := SC.ofS3 (S3.init lvst)","+/-- `guarded := derive(root_T, Modify, footprint(T))`, authority 6 (O1). -/","+def lv1 : SC := lv0.set (deriveEff (lv0.view 0) 1 [3] .modify)","+/-- `store(guarded, slot)` (O8). -/","+def lv2 : SC := storeEffC lv1 0 6 1","+/-- The registry after `newMutex(guarded)` (WC5.2 C13): entry `e`, live from now on. -/","+def lvReg : SyncReg := [⟨6, none⟩]","+/-- `internal0 := derive(root_ST0, Modify, footprint(ST0))`, authority 7 (O1). -/","+def lv3 : SC := lv2.set (deriveEff (lv2.view 0) 2 [5, 6] .modify)","+/-- `store(internal0, AV0)` (O8). -/","+def lv4 : SC := storeEffC lv3 0 7 7","+/-- The arena registry after `newArena(ST0, internal0)` (Spec 1 §76). -/","+def lvAr : ArenaReg := [lvE]","+/-- `reset(arena0)` (Spec 1 §78): `derive` of `internal0` over the storage (authority 8), then","+`release` of it. -/","+def lv5 : SC := lv4.set (releaseEff (deriveEff (lv4.view 0) 7 [5, 6] .modify) 8)","+/-- The arena registry after the reset (Spec 1 §78 effect). -/","+def lvAr5 : ArenaReg := lvAr.set 0 (Arena.resetMeta lv4.flat lvE)","+/-- `split(root_Y, [[Y]])`, the block is authority 9 (O2). -/","+def lv6 : SC := lv5.set (splitEff (lv5.view 0) 4 [[8]])","+/-- `read3(Y)` via the block (O9): the state is unchanged. -/","+def lv7 : SC := lv6.set (lv6.view 0)","+/-- `writeShared(Y)` via the block (O11). -/","+def lv8 : SC := lv7.set (write3Eff (lv7.view 0) [8])","+/-- `release(block)` (O3). -/","+def lv9 : SC := lv8.set (releaseEff (lv8.view 0) 9)","+/-- `pin(Y)` (O15): obligation 0. -/","+def lv10 : SC := lv9.set (pinEff (lv9.view 0) 8)","+/-- `unpin(0)` (O16). -/","+def lv11 : SC := lv10.set (unpinEff (lv10.view 0) 0)","+/-- `alloc(provider = P, owner = Y, one leaf)` (O14): place 10, root authority 10 held by `Y`. -/","+def lv12 : SC := lv11.set (allocEff (lv11.view 0) 8 [(none, 0)])","+/-- `free(10)` (O13). -/","+def lv13 : SC := lv12.set (freeEff (lv12.view 0) 10)","+/-- `endUse(Y)` (O12). -/","+def lv14 : SC := lv13.set (endUseEff (lv13.view 0) 8)","+","+/-- The labels of the trace of legitimate uses. -/","+def lvLbls : List Label :=","+  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 6 1), .newMutex 0 6,","+   .kernel 0 (.derive 2 [5, 6] .modify), .kernel 0 (.store 7 7), .newArena 0 4 7, .reset 0 0,","+   .kernel 0 (.split 4 [[8]]), .kernel 0 (.read 9 [8]), .kernel 0 (.writeShared 9 [8]),","+   .kernel 0 (.release 9), .kernel 0 (.pin 8), .kernel 0 (.unpin 0),","+   .kernel 0 (.alloc 9 8 [(none, 0)]), .kernel 0 (.free 10 0), .kernel 0 (.endUse 8)]","+","+/-- The named states of the trace of legitimate uses. -/","+def lvσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(lv0, [], []), (lv1, [], []), (lv2, [], []), (lv2, lvReg, []), (lv3, lvReg, []),","+    (lv4, lvReg, []), (lv4, lvReg, lvAr), (lv5, lvReg, lvAr5), (lv6, lvReg, lvAr5),","+    (lv7, lvReg, lvAr5), (lv8, lvReg, lvAr5), (lv9, lvReg, lvAr5), (lv10, lvReg, lvAr5),","+    (lv11, lvReg, lvAr5), (lv12, lvReg, lvAr5), (lv13, lvReg, lvAr5), (lv14, lvReg, lvAr5)].getD i","+    (lv14, lvReg, lvAr5)","+","+/-- The trace of legitimate uses from the initial state, each step admitted by `Encap5R`. -/","+theorem lv_steps : Steps5R KL L0","+    [(lv0, [], []), (lv1, [], []), (lv2, [], []), (lv2, lvReg, []), (lv3, lvReg, []),","+      (lv4, lvReg, []), (lv4, lvReg, lvAr), (lv5, lvReg, lvAr5), (lv6, lvReg, lvAr5),","+      (lv7, lvReg, lvAr5), (lv8, lvReg, lvAr5), (lv9, lvReg, lvAr5), (lv10, lvReg, lvAr5),","+      (lv11, lvReg, lvAr5), (lv12, lvReg, lvAr5), (lv13, lvReg, lvAr5), (lv14, lvReg, lvAr5)]","+    lvLbls :=","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|","+  .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|","+  .cons (by decide) (.newArena ⟨by decide, .ok (by decide)⟩) <|","+  .cons (by decide) (.reset ⟨by decide, _, .ok rfl (.ok (by decide)) (.ok (by decide)) (by decide),","+    rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide) trivial, rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil","+","+/-- Brief of slice 3, task 3: the trace of legitimate uses is a `RunFull` from the initial state,","+and entry `e` is live before each step from `derive(root_ST0)` on: `derive`, `store`, `newArena`,","+`reset`, `split`, `read3`, `writeShared`, `release`, `pin`, `unpin`, `alloc`, `free`, `endUse`","+are `ok` and admitted under a live entry, their rights resting on root authorities of `f0` or on","+the split block (WC5.2 C22 item 6: another valid chain suffices). -/","+theorem lv_full : lvσ 0 = (SC.ofS3 (S3.init lvst), [], []) ∧ RunFull KL L0 lvσ lvLbls ∧","+    ∀ i, 3 ≤ i → i < lvLbls.length → LiveAt (lvσ i) := by","+  refine ⟨rfl, runFull_of_run7 (run7_of_run5R (lv_steps.run _) (by decide)) (by decide), ?_⟩","+  decide","+"," end Ern.Concurrency.FullEncap.NonRegression"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/NonRegression.lean"]}},"serverClassifierContext":{"request":"43b9622e-d325-4c5c-b596-b30597638d10","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"fade0de6-6428-4726-bd29-87475727b218","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"parentUuid":"ea9295f9-de6f-41b8-8da7-a767999c9339","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/NonRegression.lean","snippet":"52\t    runFull_of_run7 h13.1 (by decide), runFull_of_run7 h14.1 (by decide),\n53\t    runFull_of_run7 h15.1 (by decide), runFull_of_run7 h16.1 (by decide),\n54\t    runFull_of_run7 h17.1 (by decide), runFull_of_run7 h18.1 (by decide),\n55\t    runFull_of_run7 t1.1 (by decide), runFull_of_run7 t2.1 (by decide),\n56\t    runFull_of_run7 t3.1 (by decide), runFull_of_run7 t4.1 (by decide),\n57\t    runFull_of_run7 FinalWitness.alloc_owner_M_admitted.2 (by decide),\n58\t    runFull_of_run7 FinalWitness.depend_admitted (by decide)⟩\n59\t\n60\t/-! ## Legitimate uses under a live entry -/\n61\t\n62\t/-- Some entry of the registry is live in the state. -/\n63\tdef LiveAt (st : SC × SyncReg × ArenaReg) : Prop := ∃ e ∈ st.2.1, e.Live st.1\n64\t\n65\t/-- Decidability of `LiveAt`. -/\n66\tinstance (st : SC × SyncReg × ArenaReg) : Decidable (LiveAt st) := by\n67\t  unfold LiveAt; infer_instance\n68\t\n69\t/-- Statics of the trace of legitimate uses (Spec 1 §47): those of W-GI (block MX without `M′`, the\n70\tfree arena storage `ST0` with `R1`, `R2`, the arena value `AV0`), and two root leaves of the base\n71\tframe, `8` (`Y`, `Init`) and `9` (`P`, `Init`). Root authorities: `0` of `M`, `1` of `T` (held by\n72\t`M`), `2` of `ST0`, `3` of `AV0`, `4` of `Y`, `5` of `P`; all but `1` held by frame 0. -/\n73\tdef lvst : Statics := Witness.gist ++ [((none, none, 0), true), ((none, none, 0), true)]\n74\t\n75\t/-- The statics are well formed (Spec 1 §47). -/\n76\ttheorem lvst_ok : StaticsOK lvst := by decide\n77\t\n78\t/-- The contract of the trace: `lock` (place 2) and `Y` (place 8) are `SharedMutable`. -/\n79\tabbrev KL : K := Corpus.KC [2, 8]\n80\t\n81\t/-- The arena of the trace (Spec 1 §46). -/\n82\tdef lvE : Arena.ArenaEntry := ⟨4, 7, [5, 6], []⟩\n83\t\n84\t/-- Initial state. -/\n85\tdef lv0 : SC := SC.ofS3 (S3.init lvst)\n86\t/-- `guarded := derive(root_T, Modify, footprint(T))`, authority 6 (O1). -/\n87\tdef lv1 : SC := lv0.set (deriveEff (lv0.view 0) 1 [3] .modify)\n88\t/-- `store(guarded, slot)` (O8). -/\n89\tdef lv2 : SC := storeEffC lv1 0 6 1\n90\t/-- The registry after `newMutex(guarded)` (WC5.2 C13): entry `e`, live from now on. -/\n91\tdef lvReg : SyncReg := [⟨6, none⟩]\n92\t/-- `internal0 := derive(root_ST0, Modify, footprint(ST0))`, authority 7 (O1). -/\n93\tdef lv3 : SC := lv2.set (deriveEff (lv2.view 0) 2 [5, 6] .modify)\n94\t/-- `store(internal0, AV0)` (O8). -/\n95\tdef lv4 : SC := storeEffC lv3 0 7 7\n96\t/-- The arena registry after `newArena(ST0, internal0)` (Spec 1 §76). -/\n97\tdef lvAr : ArenaReg := [lvE]\n98\t/-- `reset(arena0)` (Spec 1 §78): `derive` of `internal0` over the storage (authority 8), then\n99\t`release` of it. -/\n100\tdef lv5 : SC := lv4.set (releaseEff (deriveEff (lv4.view 0) 7 [5, 6] .modify) 8)\n101\t/-- The arena registry after the reset (Spec 1 §78 effect). -/\n102\tdef lvAr5 : ArenaReg := lvAr.set 0 (Arena.resetMeta lv4.flat lvE)\n103\t/-- `split(root_Y, [[Y]])`, the block is authority 9 (O2). -/\n104\tdef lv6 : SC := lv5.set (splitEff (lv5.view 0) 4 [[8]])\n105\t/-- `read3(Y)` via the block (O9): the state is unchanged. -/\n106\tdef lv7 : SC := lv6.set (lv6.view 0)\n107\t/-- `writeShared(Y)` via the block (O11). -/\n108\tdef lv8 : SC := lv7.set (write3Eff (lv7.view 0) [8])\n109\t/-- `release(block)` (O3). -/\n110\tdef lv9 : SC := lv8.set (releaseEff (lv8.view 0) 9)\n111\t/-- `pin(Y)` (O15): obligation 0. -/\n112\tdef lv10 : SC := lv9.set (pinEff (lv9.view 0) 8)\n113\t/-- `unpin(0)` (O16). -/\n114\tdef lv11 : SC := lv10.set (unpinEff (lv10.view 0) 0)\n115\t/-- `alloc(provider = P, owner = Y, one leaf)` (O14): place 10, root authority 10 held by `Y`. -/\n116\tdef lv12 : SC := lv11.set (allocEff (lv11.view 0) 8 [(none, 0)])\n117\t/-- `free(10)` (O13). -/\n118\tdef lv13 : SC := lv12.set (freeEff (lv12.view 0) 10)\n119\t/-- `endUse(Y)` (O12). -/\n120\tdef lv14 : SC := lv13.set (endUseEff (lv13.view 0) 8)\n121\t\n122\t/-- The labels of the trace of legitimate uses. -/\n123\tdef lvLbls : List Label :=\n124\t  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 6 1), .newMutex 0 6,\n125\t   .kernel 0 (.derive 2 [5, 6] .modify), .kernel 0 (.store 7 7), .newArena 0 4 7, .reset 0 0,\n126\t   .kernel 0 (.split 4 [[8]]), .kernel 0 (.read 9 [8]), .kernel 0 (.writeShared 9 [8]),\n127\t   .kernel 0 (.release 9), .kernel 0 (.pin 8), .kernel 0 (.unpin 0),\n128\t   .kernel 0 (.alloc 9 8 [(none, 0)]), .kernel 0 (.free 10 0), .kernel 0 (.endUse 8)]\n129\t\n130\t/-- The named states of the trace of legitimate uses. -/\n131\tdef lvσ (i : Nat) : SC × SyncReg × ArenaReg :=\n132\t  [(lv0, [], []), (lv1, [], []), (lv2, [], []), (lv2, lvReg, []), (lv3, lvReg, []),\n133\t    (lv4, lvReg, []), (lv4, lvReg, lvAr), (lv5, lvReg, lvAr5), (lv6, lvReg, lvAr5),\n134\t    (lv7, lvReg, lvAr5), (lv8, lvReg, lvAr5), (lv9, lvReg, lvAr5), (lv10, lvReg, lvAr5),\n135\t    (lv11, lvReg, lvAr5), (lv12, lvReg, lvAr5), (lv13, lvReg, lvAr5), (lv14, lvReg, lvAr5)].getD i\n136\t    (lv14, lvReg, lvAr5)\n137\t\n138\t/-- The trace of legitimate uses from the initial state, each step admitted by `Encap5R`. -/\n139\ttheorem lv_steps : Steps5R KL L0\n140\t    [(lv0, [], []), (lv1, [], []), (lv2, [], []), (lv2, lvReg, []), (lv3, lvReg, []),\n141\t      (lv4, lvReg, []), (lv4, lvReg, lvAr), (lv5, lvReg, lvAr5), (lv6, lvReg, lvAr5),\n142\t      (lv7, lvReg, lvAr5), (lv8, lvReg, lvAr5), (lv9, lvReg, lvAr5), (lv10, lvReg, lvAr5),\n143\t      (lv11, lvReg, lvAr5), (lv12, lvReg, lvAr5), (lv13, lvReg, lvAr5), (lv14, lvReg, lvAr5)]\n144\t    lvLbls :=\n145\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n146\t  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n147\t  .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|\n148\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n149\t  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|\n150\t  .cons (by decide) (.newArena ⟨by decide, .ok (by decide)⟩) <|\n151\t  .cons (by decide) (.reset ⟨by decide, _, .ok rfl (.ok (by decide)) (.ok (by decide)) (by decide),\n152\t    rfl⟩) <|\n153\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n154\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n155\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n156\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n157\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n158\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n159\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide) trivial, rfl⟩) <|\n160\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|\n161\t  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) .nil\n162\t\n163\t/-- Brief of slice 3, task 3: the trace of legitimate uses is a `RunFull` from the initial state,\n164\tand entry `e` is live before each step from `derive(root_ST0)` on: `derive`, `store`, `newArena`,\n165\t`reset`, `split`, `read3`, `writeShared`, `release`, `pin`, `unpin`, `alloc`, `free`, `endUse`\n166\tare `ok` and admitted under a live entry, their rights resting on root authorities of `f0` or on\n167\tthe split block (WC5.2 C22 item 6: another valid chain suffices). -/\n168\ttheorem lv_full : lvσ 0 = (SC.ofS3 (S3.init lvst), [], []) ∧ RunFull KL L0 lvσ lvLbls ∧\n169\t    ∀ i, 3 ≤ i → i < lvLbls.length → LiveAt (lvσ i) := by\n170\t  refine ⟨rfl, runFull_of_run7 (run7_of_run5R (lv_steps.run _) (by decide)) (by decide), ?_⟩\n171\t  decide\n172\t\n173\tend Ern.Concurrency.FullEncap.NonRegression","rereadEntry":{"timestamp":1794502361787,"contentHash":"3ram77ma0cd1y","contentLength":9835}},"type":"attachment","uuid":"b60edc36-aa5a-4424-bd5d-755a0c85e51f","timestamp":"2026-11-12T16: