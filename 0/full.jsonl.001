,{"oldStart":4034,"oldLines":7,"newStart":4041,"newLines":8,"lines":[" "," /-- The invariants of MM-03 and `Repr` on a prefix of the run. -/"," theorem inv {s3 : S3} {pv : Nat → Option Nat} {s2 : MM02.State} (h : Run s3 pv s2) :","-    Repr π.tok π.ptok pv L s3 s2 ∧ WF3 s3 ∧ NoDangling s3 ∧ FpLeaves s3 ∧ Reachable KS [] s3 := by","+    Repr π.tok π.ptok pv L s3 s2 ∧ WF3 s3 ∧ NoDangling s3 ∧ FpLeaves s3 ∧","+      Reachable KS [] s3 := by","   obtain ⟨_, _, -, hR, hr⟩ := sim h","   exact ⟨hR, (reachable_invariants (KT_dd _ _ _ _ _) hr).1,","     (reachable_invariants (KT_dd _ _ _ _ _) hr).2.1.nd,"]},{"oldStart":4045,"oldLines":25,"newStart":4053,"newLines":30,"lines":[" offset 0), and each carries the provenance 4, a live allocation. -/"," example : AllOk C obR obW n9 (issueOps pe n9 L [5] 7) ∧ Repr π.tok π.ptok pvA L x10 n10 := by","   obtain ⟨hR, hwf, -⟩ := inv run9","-  have := r6_issue (C := C) (ObR := obR) (ObW := obW) (pe := pe) hwf hR step10 (fun _ _ _ => trivial)","+  have := r6_issue (C := C) (ObR := obR) (ObW := obW) (pe := pe) hwf hR step10","+    (fun _ _ _ => trivial)","     (by show (leafAcc n9 L .write 7).addr % 4 = 0; decide)","   exact ⟨this.1, this.2.1⟩","-example : pe.decode (ptrBytes pe n9 L [5]) = 104 ∧ (∀ i, (ptrBytes pe n9 L [5] i).2 = some 4) ∧","+example : pe.decode (ptrBytes pe n9 L [5]) = 104 ∧","+    (∀ i, (ptrBytes pe n9 L [5] i).2 = some 4) ∧","     (∃ al, n9.allocs 4 = some al ∧ al.live = true ∧ regionAddr n9 L [5] = al.base + 0) := by","   obtain ⟨hR, hwf, hnd, hfl, -⟩ := inv run9","-  obtain ⟨h1, h2, ⟨al, h3, h4, h5, -⟩, -⟩ := pointer_sound_issue (C := C) (ObR := obR) (ObW := obW) (pe := pe)","+  obtain ⟨h1, h2, ⟨al, h3, h4, h5, -⟩, -⟩ := pointer_sound_issue (C := C) (ObR := obR)","+    (ObW := obW) (pe := pe)","     hwf hnd hfl hR step10 (fun _ _ _ => trivial)","-    (by show (leafAcc n9 L .write 7).addr % 4 = 0; decide) (l := 5) rfl ⟨by decide, fun _ => rfl⟩","+    (by show (leafAcc n9 L .write 7).addr % 4 = 0; decide) (l := 5) rfl","+    ⟨by decide, fun _ => rfl⟩","   exact ⟨h1.trans (by decide), h2, al, h3, h4, h5⟩"," example : rangeBytes n10 L 7 = some ([104, 0, 0, 0, 0, 0, 0, 0].map fun v => .init v (some 4)) := by","   decide"," ","-/-- `store` (L6), `pointer_sound_store`: the bytes written in 8 decode to the address 8 of the leaf 0","-covered by the authority 5, and each carries the provenance 0, the allocation of 0. -/","+/-- `store` (L6), `pointer_sound_store`: the bytes written in 8 decode to the address 8 of the","+leaf 0 covered by the authority 5, and each carries the provenance 0, the allocation of 0. -/"," example : pe.decode (ptrBytes pe n10 L (x10.afp 5)) = 8 ∧","     (∀ i, (ptrBytes pe n10 L (x10.afp 5) i).2 = some 0) := by","   obtain ⟨hR, hwf, hnd, hfl, -⟩ := inv run10","-  obtain ⟨h1, h2, -⟩ := pointer_sound_store (C := C) (ObR := obR) (ObW := obW) (pe := pe) hwf hnd hfl hR","+  obtain ⟨h1, h2, -⟩ := pointer_sound_store (C := C) (ObR := obR) (ObW := obW) (pe := pe) hwf hnd","+    hfl hR","     (.ok (by decide) : StoreStep 5 8 x10 (.ok x11)) (fun _ _ _ => trivial)","     (by show (leafAcc n10 L .write 8).addr % 4 = 0; decide) (l := 0) (by decide)","     ⟨by decide, fun _ => rfl⟩"]},{"oldStart":4089,"oldLines":7,"newStart":4102,"newLines":8,"lines":[" example : (x12.A[9]?).map (·.holder) = some (.place 2) ∧ x12.F = [2, 1, 0] := by decide"," /-- Without the write of `issue` or of `transfer`, `Repr` fails (K3: an `Init` leaf has its bytes"," initialised). -/","-example : ¬ ReprB π.tok π.ptok pvA L x10 n9 ∧ ¬ ReprB π.tok π.ptok pvA L x12 n11 := by decide","+example : ¬ ReprB π.tok π.ptok pvA L x10 n9 ∧ ¬ ReprB π.tok π.ptok pvA L x12 n11 := by","+  decide"," "," /-- L8 along the run (`simulation_pinned`): the leaf 1, pinned before the transfer, keeps a live"," allocation and its address across the reads and writes of the step. -/"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean"]}},"serverClassifierContext":{"request":"757f6dd0-a22c-4f1