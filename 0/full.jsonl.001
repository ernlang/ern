ide)\n-- H03\ndef h03o : List Op := [.enter [] (S2 ++ [L1]), .derive 0 1 .modify, .store 2 3]\nexample : (prun K0 (PS.init []) h03o).isSome = true := by decide\ndef h03 := run K0 [] h03o\ndef h03t := run K0 [] [.enter [] (S2 ++ [L1])]\nexample : Write3Step 0 [1] h03.s .reject := .reject (by decide)\nexample : Write3Step 0 [1] h03t.s (.ok (write3Eff h03t.s [1])) := .ok (by decide)\n-- H04\nexample : (prun K0 (PS.init []) [.enter [] S2, .split 0 [[1], [2]], .write 1 [1], .write 2 [2]]).isSome = true := by decide\nexample : DeriveStep 0 1 .modify h01.s .reject := .reject (by decide)\ndef h04 := run K0 [] [.enter [] S2, .derive 0 1 .modify]\nexample : DeriveStep 0 1 .modify h04.s .reject := .reject (by decide)\nexample : DeriveStep 0 2 .modify h04.s (.ok (deriveEff h04.s 0 2 .modify)) := .ok (by decide)\n-- H05\ndef h05 := run K0 [] [.enter [] (S2 ++ [L1]), .write 0 [1, 2]]\nexample : TransferStep K0 0 1 h05.s .reject := .reject (by decide)\nexample : (prun K0 (PS.init []) [.enter [] (S2 ++ [L1]), .write 0 [1, 2], .transfer 1 3, .transfer 3 1]).isSome = true := by decide\n-- H06\nexample : (prun K0 (PS.init []) [.enter [] [L1], .derive 0 0 .modify, .derive 1 0 .observe, .release 2, .release 1, .write 0 [0]]).isSome = true := by decide\n-- H07\ndef stS : Statics := [((none, none, 0), false)]\ndef h07o : List Op := [.derive 0 0 .modify, .enter [1] [L1, L1], .write 2 [1], .write 3 [2],\n  .derive 2 1 .observe, .depend 2 4, .derive 3 2 .modify, .enter [1, 5] []]\nexample : (prun K0 (PS.init stS) h07o).isSome = true := by decide\ndef h07 := run K0 stS h07o\nexample : TransferStep K0 2 0 h07.s .reject := .reject (by decide)\ndef h07t := run K0 stS [.derive 0 0 .modify, .enter [1] [L1, L1], .write 2 [1], .write 3 [2],\n  .derive 2 1 .observe, .derive 3 2 .modify, .enter [1, 5] []]\nexample : TransferStep K0 2 0 h07t.s (.ok (transferEff h07t.s 2 0)) := .ok (by decide)\n-- H08 / H09\ndef h89 : List Op := [.enter [] [L1, L1], .write 0 [0], .derive 0 0 .modify, .derive 1 1 .modify,\n  .enter [2, 3] [L1, L1]]\nexample : (prun K0 (PS.init []) (h89 ++ [.derive 2 0 .observe, .derive 6 0 .observe, .write 4 [2], .depend 2 7, .transfer 2 1, .exit])).isSome = true := by decide\ndef h09 := run K0 [] (h89 ++ [.derive 5 3 .observe, .derive 6 3 .observe, .write 4 [2], .depend 2 7])\nexample : (prun K0 (PS.init []) (h89 ++ [.derive 5 3 .observe, .derive 6 3 .observe, .write 4 [2], .depend 2 7])).isSome = true := by decide\nexample : TransferStep K0 2 1 h09.s .reject := .reject (by decide)\ndef h09t := run K0 [] (h89 ++ [.derive 5 3 .observe, .derive 6 3 .observe, .write 4 [2]])\nexample : TransferStep K0 2 1 h09t.s (.ok (transferEff h09t.s 2 1)) := .ok (by decide)\n-- H10\ndef h10p : List Op := [.enter [] [L1, L1, (some 1, none, 0), (some 1, none, 0), L1], .write 0 [0],\n  .derive 0 0 .observe, .derive 3 0 .observe, .store 4 2, .depend 1 3, .write 1 [3]]\nexample : (prun K0 (PS.init []) (h10p ++ [.transfer 2 4, .endUse 1])).isSome = true := by decide\ndef h10 := run K0 [] (h10p ++ [.transfer 2 4, .endUse 1])\nexample : ReleaseStep 3 h10.s .reject := .reject (by decide)\nexample : (prun K0 (PS.init []) (h10p ++ [.endUse 1, .release 3])).isSome = true := by decide\n-- H11\ndef h11p : List Op := [.enter [] [L1, L1, L1, L1], .write 1 [1],\n  .alloc 1 0 [L1, (some 4, none, 0), (some 4, none, 0)], .write 0 [0], .newArena 4 4,\n  .issue 0 0 [5] 2, .issue 0 0 [6] 3, .transfer 2 6]\nexample : (prun K0 (PS.init []) h11p).isSome = true := by decide\ndef h11 := run K0 [] h11p\nexample : ResetAtStep K0 0 0 h11.s .reject := .reject (by decide)\nexample : (prun K0 (PS.init []) (h11p ++ [.endUse 3, .endUse 6, .reset 0 0])).isSome = true := by decide\n-- H12\ndef h12p : List Op := [.enter [] [L1, L1, L1], .write 0 [0], .write 2 [2], .derive 0 0 .observe,\n  .store 3 1]\ndef h12 := run K0 [] (h12p ++ [.depend 2 3])\nexample : (prun K0 (PS.init []) (h12p ++ [.depend 2 3])).isSome = true := by decide\nexample : EndUseStep K0 1 h12.s .reject := .reject (by decide)\nexample :