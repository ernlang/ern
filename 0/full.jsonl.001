.Usable.mono (s' := { t with F := F' }) (s := t) rfl (fun f h => (hF f).1 h)\nErn/Concurrency/Context.lean-324-    (fun _ h => h),\nErn/Concurrency/FullEncap/SpawnValCap.lean:100:theorem ne_none_of_allows {e : Option Mode} {m : Mode} (h : Allows e m) : e ≠ none := by","is_error":false}]},"uuid":"81675f1a-f6a2-4560-8543-97eb28b14114","timestamp":"2026-11-14T08:23:54.299Z","toolUseResult":{"stdout":"361:structure TermPre (k : K) (s : SC) (c : Nat) : Prop where\n362-  /-- WC4 C7: a non-initial context (WC4 C3: the base frame never exits). -/\n363-  nonInitial : c ≠ 0\n364-  /-- WC4 C7: the nested call frames have ended; only the initial frame remains. -/\n365-  initialOnly : (s.stk c).length = 1\n366-  /-- Spec 1 §73.1 re-indexed: the initial frame has a surviving parent. -/\n367-  hasParent : OptP (s.ctxParent c) (fun p => p ∈ s.frames ∧ p ∉ s.stk c) False\n368-  /-- Spec 1 §73.2, §73.4, §73.5: every anchor of a place usable after the exit has a surviving\n369-  authority among itself and its origins. -/\n370-  anchors : ∀ q ∈ List.range s.P.length, ({ s.view c with F := (s.view c).F.tail } : S3).Usable q →\n371-    ∀ x ∈ s.D q, firstSurv (s.view c) (s.view c).F.tail (x :: (s.view c).ancs x) ≠ none\n372-  /-- Spec 1 §73.4: every surviving derived authority has a surviving active origin. -/\n373-  origins : ∀ a ∈ List.range s.A.length, Survives (s.view c) (s.view c).F.tail a →\n374-    (s.view c).org a ≠ none → firstSurv (s.view c) (s.view c).F.tail ((s.view c).ancs a) ≠ none\n375-  /-- Spec 1 §73.3: no leaf of a place that dies with the frame is pinned. -/\n376-  notPinned : ∀ q ∈ List.range s.P.length, (s.view c).Usable q →\n377-    ¬ ({ s.view c with F := (s.view c).F.tail } : S3).Usable q →\n/Users/guygouri/.elan/toolchains/leanprover--lean4---v4.35.0/src/lean/Init/Data/Bool.lean:200:@[simp] theorem or_eq_false_iff : ∀ {x y : Bool}, (x || y) = false ↔ x = false ∧ y = false := by decide\nErn/Concurrency/Context.lean:321:theorem usable_mem_congr (hF : ∀ f, f ∈ F' ↔ f