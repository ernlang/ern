r--@   1 guy  wheel   20224 Oct 31 23:03 r6sec.lean\n-rw-r--r--@   1 guy  wheel   16287 Oct 31 23:19 sim.lean\n    2273 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/MM23_p1.lean\n     393 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/cases_p1.lean\n     408 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/cases_p2a.lean\n     159 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/check_corr_leaves.lean\n     226 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/check_pinned_live.lean\n     153 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/corr_leaves.lean\n     216 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/pinned_live.lean\n     324 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/r6sec.lean\n     292 /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/sim.lean\n    4444 total\n/-! ## Cases (step 6 of the task)\n\nEach verdict is checked by `decide` on the precondition of the MM-03 step and on `Repr`, which is\ndecidable; the MM-02 sequences are exhibited by the definitions `opsN` and their effects. Each\nrefinement theorem is applied to a step of one scenario reached from `S3.init`. The obligations `dec` of the\ntest cases ask an access aligned on 4 bytes, a non-trivial instance (K5); `stat` is `True`, as K5\nfixes for the sequential fragment. -/\n\nnamespace CaseInit\n\n/-- One static leaf, declared `Init`, in a 4-byte range of the static allocation. -/\ndef st : Statics := [((none, none, 0), true)]\ndef L : Layout := fun _ => ⟨0, 0, 4⟩\ndef tk : Nat → Nat := fun f => 100 + f\n/-- Provider tokens (L4) and the ghost `provOf`: no root is allocated by `alloc`. -/\ndef ptk : Nat → Nat := fun pr => 6 + pr\ndef prov : Nat → Option Nat := fun _ => none\ndef g : Nat → Geom := fun _ => ⟨0, 4, 4⟩\ndef w : Nat → Nat → UInt8 × Option Nat := fun l i => ((l + i).toUInt8, none)\n/-- Test obligations (K5): `dec`, an access aligned on 4 bytes; `stat`, true. -/\ndef obR : MM02.ReadOblSpec := ⟨fun _ ac => ac.addr % 4 = 0, fun _ _ => True⟩\ndef obW : MM02.WriteOblSpec := ⟨fun _ ac _ => ac.addr % 4 = 0, fun _ _ _ => True⟩\ninstance : ∀ s o, Decidable (Op2.Dec obR obW s o) := fun s o => by\n  cases o <;> simp only [Op2.Dec, obR, obW] <;> infer_instance\ndef s2 : MM02.State := exec MM02.State.empty (initOps topPlacement g tk L w st)\n\n/-- `repr_init` on the static storage, and the same verdict by `decide`; without the write of the\nstatic, `Repr` fails (K3: an `Init` leaf has its bytes initialised). -/\nexample : ReprB tk ptk prov L (S3.init st) s2 :=\n  (repr_init (C := fun _ _ => False) (ObR := obR) (ObW := obW) (by decide) topPlacement_ok\n    (by decide) (by decide) (by decide) (fun _ _ _ => trivial) (by decide)).2.toReprB\nexample : ReprB tk ptk prov L (S3.init st) s2 := by decide\nexample : ¬ ReprB tk ptk prov L (S3.init st)\n    (exec MM02.State.empty (allocOps topPlacement g (some (tk 0)) MM02.State.empty [0])) := by\n  decide\n\n/-- Counterexample kept (report, (f)): the draft `canRead3` does not ask the leaves read to be\nusable (MM-03.3 O9.1). In a state outside the reached ones, where the static 0 is freed but its\nroot authority stays active, `read3` is `ok`, `Repr` holds, and the MM-02 read is `ub`: R1 needs\n`NoDangling`. -/\ndef cx : S3 := { S3.init st with dead := fun _ => true, freed := fun _ => true }\ndef cx2 : MM02.State := s2.dealloc 0\nexample : ReprB tk ptk prov L cx cx2 := by decide\nexample : Read3Step 0 [0] cx (.ok cx) := .ok (by decide)\nexample : MM02.ReadStep obR (leafAcc cx2 L .read 0) cx2 .ub :=\n  .ub fun ⟨h, _⟩ => absurd h (by decide)\nexample : ¬ NoDangling cx := fun h => h 0 _ rfl rfl 0 (by decide) 0 (by decide) (by decide)\n\nend CaseInit","is_error":false}]},"uuid":"3b8e298b-effd-4829-a864-33f53ba5b913","timestamp":"2026-10-31T22:25:00.992Z","toolUseResult":{"stdout":"/private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/mm23/:\ntotal 232\ndrwxr-xr-x@  16 guy  wheel    512 Oct 31 20:58 .\ndrwx------@ 324 guy  wheel  10368 Oct 31 23:00 ..\n-rw-r--r--@   1 guy  wheel   1188 Oct 31 20:33 ax.lean\n-rw-r--r--@   1 guy  wheel    754 Oct 31 20:33 ax2.lean\n-rw-r--r--@   1 guy  wheel    532 Oct 31 20:33 ax3.lean\n-rw-r--r--@   1 guy  wheel   3264 Oct 31 20:54 ax_all23.lean\n-rw-r--r--@   1 guy  wheel   8765 Oct 31 20:54 ax_out23.txt\n-rw-r--r--@   1 guy  wheel    697 Oct 31 20:55 axcheck.lean\n-rwxr-xr-x@   1 guy  wheel    804 Oct 31 20:33 axsweep23.sh\n-rw-r--r--@   1 guy  wheel  13526 Oct 31 20:52 cases.lean\n-rw-r--r--@   1 guy  wheel  42674 Oct 31 20:33 chk.lean\n-rw-r--r--@   1 guy  wheel    336 Oct 31 20:25 dec.lean\n-rw-r--r--@   1 guy  wheel    103 Oct 31 20:19 lint.lean\n-rw-r--r--@   1 guy  wheel   3052 Oct 31 21:28 log.md\n-rw-r--r--@   1 guy  wheel   1498 Oct 31 20:58 owned.lean\n-rw-r--r--@   1 guy  wheel    305 Oct 31 20:43 t.lean\n\n/private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/:\ntotal 536\ndrwxr-xr-x@  11 guy  wheel     352 Oct 31 23:19 .\ndrwx------@ 324 guy  wheel   10368 Oct 31 23:00 ..\n-rw-r--r--@   1 guy  wheel  127594 Oct 31 23:00 MM23_p1.lean\n-rw-r--r--@   1 guy  wheel   24461 Oct 31 23:01 cases_p1.lean\n-rw-r--r--@   1 guy  wheel   25855 Oct 31 23:06 cases_p2a.lean\n-rw-r--r--@   1 guy  wheel    9135 Oct 31 23:04 check_corr_leaves.lean\n-rw-r--r--@   1 guy  wheel   12461 Oct 31 23:05 check_pinned_live.lean\n-rw-r--r--@   1 guy  wheel    8283 Oct 31