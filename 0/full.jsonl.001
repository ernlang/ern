{"parentUuid":"b635f467-44aa-42f5-afa1-de4980945450","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgatPPGUHdGqk9DMhB71C","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2554,"cache_read_input_tokens":511861,"output_tokens":24048,"output_tokens_details":{"thinking_tokens":9045},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2554,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":24048,"cache_read_input_tokens":511861,"cache_creation_input_tokens":2554,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2554},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":70106,"thinkingDisplay":"updates","serverClassifierRequest":"9e028c4b-32d9-43bc-8451-5d18bc224a8d","apiBlockIndex":0,"requestId":"req_011CgatPNxcpod7K6qa9dV3A","requestRef":"661b6baa-7f6f-4069-a337-8ea4a2161d10","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"704cde02-d336-4160-bdff-8ad282de8299","timestamp":"2026-10-31T19:44:31.617Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"704cde02-d336-4160-bdff-8ad282de8299","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgatPPGUHdGqk9DMhB71C","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0143VCSw574ExjwFwgY13Av5","name":"Edit","input":{"replace_all":false,"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","old_string":"/-! ## Smoke test -/","new_string":"/-! ## Allocation of a root place (K2) -/\n\n/-- Every place has a leaf (MM-03.3.2), under `WF3`: a part comes after its parent. -/\ntheorem exists_leaf {s : S3} (hwf : WF3 s) : ∀ m q, s.P.length ≤ q + m → q < s.P.length →\n    ∃ l, l ∈ footprint s.P q\n  | 0, q, hm, hq => absurd hq (by omega)\n  | m + 1, q, hm, hq => by\n    by_cases h : ∃ r, r < s.P.length ∧ parentOf s.P r = some q\n    · obtain ⟨r, hr, hp⟩ := h\n      have hlt := (hwf.parent_lt hp).1\n      obtain ⟨l, hl⟩ := exists_leaf hwf m r (by omega) hr\n      exact ⟨l, footprint_sub hwf ⟨hr, .inr (by rw [chain_cons hp hlt]; exact List.mem_cons_self ..)⟩\n        hl⟩\n    · exact ⟨q, mem_footprint.2 ⟨hq, fun r hr e => h ⟨r, hr, e⟩, hq, .inl rfl⟩⟩\n\n/-- K2: the allocation of the root place `r`, read on the first leaf of its footprint. -/\ndef rootAlloc (L : Layout) (P : List Place) (r : Nat) : Nat := (L ((footprint P r).headD r)).alloc\n\ntheorem headD_mem_footprint {s : S3} (hwf : WF3 s) {r : Nat} (hr : r < s.P.length) :\n    (footprint s.P r).headD r ∈ footprint s.P r := by\n  obtain ⟨l, hl⟩ := exists_leaf hwf s.P.length r (by omega) hr\n  cases h : footprint s.P r with\n  | nil => rw [h] at hl; cases hl\n  | cons x xs => exact List.mem_cons_self ..\n\n/-- K1 (a), K2: every leaf of a root place is in the allocation of the root. -/\ntheorem rootAlloc_eq {L : Layout} {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3)\n    (hlw : LayoutWF L s3 s2) {r : Nat} (hr : RootPlace s3.P r) {l : Nat}\n    (hl : l ∈ footprint s3.P r) : (L l).alloc = rootAlloc L s3.P r :=\n  hlw.sameAlloc r hr.1 hr l hl _ (headD_mem_footprint hwf hr.1)\n\n/-! ## Deallocations (K4: `free`, `exitFrame`) -/\n\ntheorem exec_wf : ∀ (ops : List Op2) (s : MM02.State), MM02.WF s → MM02.WF (exec s ops)\n  | [], _, h => h\n  | o :: os, _, h => exec_wf os _ (by\n      cases o\n      · exact h\n      · exact MM02.write_wf h _ _\n      · exact MM02.dealloc_wf h _\n      · exact MM02.alloc_wf h _ _ _ _ _)\n\n/-- K4 (`free`, `exitFrame`): one deallocation of each allocation of `ids`, with the\ndeallocation authority `au` (MM-02.D). -/\ndef deallocOps (ids : List Nat) (au : Nat) : List Op2 := ids.map fun i => .dealloc i au\n\ntheorem dealloc_allocs (s : MM02.State) (id i : Nat) :\n    (s.dealloc id).allocs i =\n      if i = id then (s.allocs i).map (fun a => { a with live := false }) else s.allocs i := rfl\n\ntheorem exec_deallocOps (au : Nat) : ∀ (ids : List Nat) (s : MM02.State) (j : Nat),\n    (exec s (deallocOps ids au)).allocs j =\n      if j ∈ ids then (s.allocs j).map (fun a => { a with live := false }) else s.allocs j\n  | [], s, j => by simp [deallocOps, exec]\n  | i :: is, s, j => by\n    show (exec (s.dealloc i) (deallocOps is au)).allocs j = _\n    rw [exec_deallocOps au is, dealloc_allocs]\n    by_cases h1 : j ∈ is <;> by_cases h2 : j = i <;>\n      simp only [h1, h2, List.mem_cons, true_or, or_true, or_false, ↓reduceIte, Option.map_map,\n        Function.comp_def]\n\n/-- K4: the deallocations of distinct live allocations whose token is compatible with `au` have\nthe outcome `ok` (MM-02.D). -/\ntheorem deallocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {au : Nat} : ∀ (ids : List Nat) (s : MM02.State), ids.Pairwise (· ≠ ·) →\n      (∀ i ∈ ids, AllocP s i fun a => a.live = true ∧ ∃ d, a.freeAuth = some d ∧ C au d) →\n      AllOk C ObR ObW s (deallocOps ids au)\n  | [], _, _, _ => trivial\n  | i :: is, s, hp, h => by\n    obtain ⟨hne, hp⟩ := List.pairwise_cons.1 hp\n    obtain ⟨a, ha, hl, d, hd, hc⟩ := h i (List.mem_cons_self ..)\n    refine ⟨.ok ⟨a, ha, hl, d, hd, hc⟩, deallocOps_ok is _ hp fun j hj => ?_⟩\n    have hji : j ≠ i := fun e => hne j hj e.symm\n    exact (h j (List.mem_cons_of_mem _ hj)).of_eq (by rw [dealloc_allocs]; simp only [hji, ↓reduceIte])\n\n/-- K3: `Repr` carries over when the places, the stack and the `freed` marks do not change, no\nplace becomes usable and no leaf becomes `Init` (`endUse` and the steps without MM-02 step). -/\ntheorem Repr.shrink {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (hP : s3'.P = s3.P) (hF : s3'.F = s3.F) (hfr : s3'.freed = s3.freed)\n    (hU : ∀ q, s3'.Usable q → s3.Usable q) (hI : ∀ l, s3'.I l = .init → s3.I l = .init) :\n    Repr tok L s3' s2 := by\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP, hF, hfr]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact hR.lwf.within\n  · exact hR.inj\n  · exact hR.tokens\n  · exact fun r hr hrt hu => hR.live r hr hrt (hU r hu)\n  · exact fun l hl hlf hi => hR.init l hl hlf (hI l hi)\n  · exact hR.freed\n  · exact hR.exited\n  · intro r hr hrt hu hf ho\n    by_cases hu' : s3.Usable r\n    · exact hR.live r hr hrt hu'\n    · exact hR.leaked r hr hrt hu' hf ho\n\n/-- K3, K4: `Repr` carries over to the deallocation of the allocations `ids` when the places do\nnot change, no leaf becomes `Init`, a root usable after was usable before and keeps its\nallocation, a root freed or exited after was so before or has its allocation deallocated, and a\nleaked root after was usable or not freed before and keeps its allocation. -/\ntheorem repr_deallocs {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (ids : List Nat) (au : Nat) (hP : s3'.P = s3.P)\n    (hI : ∀ l, s3'.I l = .init → s3.I l = .init)\n    (hlive : ∀ r < s3.P.length, RootPlace s3.P r → s3'.Usable r →\n      s3.Usable r ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids)\n    (hfreed : ∀ r < s3.P.length, RootPlace s3.P r → s3'.freed r = true →\n      s3.freed r = true ∨ ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)\n    (hexit : ∀ r < s3.P.length, RootPlace s3.P r →\n      OptP (s3.P[r]?) (fun pl => FrameGone s3'.F pl.owner) False →\n      OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False ∨\n        ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)\n    (hleak : ∀ r < s3.P.length, RootPlace s3.P r → ¬ s3'.Usable r → s3'.freed r = false →\n      OptP (s3.P[r]?) (fun pl => pl.owner.isPlace = true) False →\n      (s3.Usable r ∨ s3.freed r = false) ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids) :\n    Repr tok L s3' (exec s2 (deallocOps ids au)) := by\n  have hall := exec_deallocOps au ids s2\n  have keep : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∉ ids →\n      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hj =>\n    h.of_eq (by rw [hall]; simp only [hj, ↓reduceIte])\n  have meta : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p →\n      (∀ a : MM02.Alloc, p a → p { a with live := false }) →\n      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hp => by\n    obtain ⟨a, ha, hpa⟩ := h\n    by_cases hj : j ∈ ids\n    · exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], hp a hpa⟩\n    · exact ⟨a, by rw [hall]; simp only [hj, ↓reduceIte, ha], hpa⟩\n  have dead : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∈ ids →\n      DeadAlloc (exec s2 (deallocOps ids au)) j := fun j p h hj => by\n    obtain ⟨a, ha, -⟩ := h\n    exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], rfl⟩\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact fun l hl hlf => meta _ _ (hR.lwf.within l hl hlf) fun _ h => h\n  · exact hR.inj\n  · exact fun r hr hrt => OptP.imp (hR.tokens r hr hrt) (fun _ h => OptP.imp h\n      (fun _ h l hl => meta _ _ (h l hl) fun _ h => h) id) id\n  · intro r hr hrt hu l hl\n    obtain ⟨hu', hn⟩ := hlive r hr hrt hu\n    exact keep _ _ (hR.live r hr hrt hu' l hl) (hn l hl)\n  · exact fun l hl hlf hi => meta _ _ (hR.init l hl hlf (hI l hi)) fun _ h => h\n  · intro r hr hrt hf l hl\n    rcases hfreed r hr hrt hf with h | h\n    · exact meta _ _ (hR.freed r hr hrt h l hl) fun _ _ => rfl\n    · exact dead _ _ (hR.lwf.within l hr (mem_footprint.1 hl).2.1) (h l hl)\n  · intro r hr hrt hg l hl\n    rcases hexit r hr hrt hg with h | h\n    · exact meta _ _ (hR.exited r hr hrt h l hl) fun _ _ => rfl\n    · exact dead _ _ (hR.lwf.within l (mem_footprint.1 hl).1 (mem_footprint.1 hl).2.1) (h l hl)\n  · intro r hr hrt hu hf ho l hl\n    obtain ⟨h, hn⟩ := hleak r hr hrt hu hf ho\n    have hl' : LiveAlloc s2 (L l).alloc := by\n      by_cases hu' : s3.Usable r\n      · exact hR.live r hr hrt hu' l hl\n      · exact hR.leaked r hr hrt hu' (h.resolve_left hu') ho l hl\n    exact keep _ _ hl' (hn l hl)\n\n/-! ## R6 (MM-03.3 §9.2; K4) -/\n\n/-- MM-03.3.8 (`Deallocable`, `FreeCompat`) and K4 (\"`free` ↦ `DeallocStep`, autorité\n`Compatible` issue de `FreeCompat`\"): obligation of the contracts towards MM-02 in the state `s2`:\nwhen the contracts permit `free p auth`, every leaf of `p` is in an allocation with a token\ncompatible with `auth` (MM-02.D). -/\ndef FreeSound (k : K) (C : Nat → Nat → Prop) (L : Layout) (s3 : S3) (s2 : MM02.State) : Prop :=\n  ∀ p auth, k.Deallocable p → k.FreeCompat p auth → ∀ l ∈ footprint s3.P p,\n    AllocP s2 (L l).alloc fun a => ∃ d, a.freeAuth = some d ∧ C auth d\n\n/-- K2: the token proper to each frame is compatible with itself (MM-02.D): the authority that\n`exitFrame` presents for an automatic allocation of the frame `f` is `tok f`, compatible by\nconstruction. -/\ndef TokCompat (C : Nat → Nat → Prop) (tok : Nat → Nat) : Prop := ∀ f, C (tok f) (tok f)\n\ntheorem exec_readOps (s2 s2' : MM02.State) (L : Layout) :\n    ∀ ls : List Nat, exec s2 (readOps s2' L ls) = s2\n  | [] => rfl\n  | _ :: ls => exec_readOps s2 s2' L ls\n\n/-- R6 for `read3` (MM-03.3 §9.2; K4): the reads of MM-02 have the outcome `ok` and the arrival\nstates are in `Repr`; hypotheses of `r1_read3`. -/\ntheorem r6_read3 {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {a : Nat} {ls : List Nat}\n    (hwf : WF3 s3) (hnd : NoDangling s3) (hfl : FpLeaves s3) (hR : Repr tok L s3 s2)\n    (h : Read3Step a ls s3 (.ok s3')) (hstat : ∀ s ac, ObR.stat s ac)\n    (hdec : ∀ l ∈ ls, ObR.dec s2 (leafAcc s2 L .read l)) :\n    AllOk C ObR ObW s2 (readOps s2 L ls) ∧ Repr tok L s3' (exec s2 (readOps s2 L ls)) := by\n  have h1 := r1_read3 hwf hnd hfl hR h hstat hdec\n  obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n  refine ⟨?_, by rw [exec_readOps]; exact hR⟩\n  have : ∀ ls', (∀ l ∈ ls', l ∈ ls) → AllOk C ObR ObW s2 (readOps s2 L ls') := fun ls' => by\n    induction ls' with\n    | nil => exact fun _ => trivial\n    | cons l ls' ih =>\n      intro hs\n      obtain ⟨al, -, -, hok, -⟩ := h1 l (hs l (List.mem_cons_self ..))\n      exact ⟨⟨_, hok⟩, ih fun l' hl' => hs l' (List.mem_cons_of_mem _ hl')⟩\n  exact this ls fun _ h => h\n\n/-- R6 for `alloc` of outcome `ok` (MM-03.3 §9.2, O14; K4: `alloc` `ok` ↦ `AllocStep`): for a\nshape with one root (O14: \"une nouvelle racine\"), the allocation of MM-02, at the base chosen by\nthe placement, has the outcome `ok`, and the arrival states are in `Repr`, for every geometry of\nvalid alignment, every token `fa` and every layout of the new leaves in the fresh allocation\n(`NewLayout`). -/\ntheorem r6_alloc {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}\n    {fa : Option Nat} {i : Nat} (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2)\n    (hpl : PlacementOK pl) (hg : 0 < (g i).align ∧ MM02.Pow2 (g i).align)\n    (h : MM03.AllocStep k pr ow ls s3 (.ok s3')) (hone : rootIdx ls = [i])\n    (hNL : NewLayout L s3'.P s3.P.length s2.next g [i]) :\n    AllOk C ObR ObW s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] ∧\n      Repr tok L s3' (exec s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa]) := by\n  cases h with\n  | ok hst _ =>\n    have e : allocOps pl g fa s2 [i] = [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] :=\n      rfl\n    rw [← e, ← hone]\n    refine ⟨allocOps_ok hpl _ _ hwf2 (by rw [hone]; intro j hj; rw [List.mem_singleton.1 hj]; exact hg),\n      repr_extend (hd := .place ow) hR hwf2 rfl hst.2.2.2.2.2.1\n        (fun q hq hu => alloc_usable_back hwf hu hq) (fun _ _ hu => alloc_usable_old hu)\n        (fun i hi => alloc_usable_new hst (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)\n        (fun l hl => ?_) (fun _ _ _ _ h => h) (fun _ h => by cases h) (by rw [hone]; exact hNL)⟩\n    simp only [allocEff] at hl\n    split at hl\n    · cases hl\n    · rename_i hn\n      refine ⟨by omega, ?_⟩\n      split at hl\n      · exact hst.2.2.2.2.1 l ‹_›\n      · exact hl\n\n/-- R6 for `alloc` of outcome `fail` (MM-03.3 §9.2, O14; K4: `alloc` `fail` ↦ no step): the state\nis unchanged and stays in `Repr`. -/\ntheorem r6_alloc_fail {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} (hR : Repr tok L s3 s2)\n    (h : MM03.AllocStep k pr ow ls s3 (.fail s3')) :\n    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by\n  obtain ⟨rfl, -⟩ := alloc_fail_unchanged h; exact ⟨trivial, hR⟩\n\n/-- R6 for `free` (MM-03.3 §9.2, O13; K4: `free` ↦ `DeallocStep` of the allocation of the root,\nauthority `auth`, compatible by `FreeCompat`): under `WF3` and the obligation `FreeSound` of the\ncontracts, the deallocation has the outcome `ok` and the arrival states are in `Repr`. -/\ntheorem r6_free {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {p auth : Nat}\n    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hfs : FreeSound k C L s3 s2)\n    (h : FreeStep k p auth s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (deallocOps [rootAlloc L s3.P p] auth) ∧\n      Repr tok L s3' (exec s2 (deallocOps [rootAlloc L s3.P p] auth)) := by\n  obtain ⟨⟨hdl, hfc, hu, hor, -⟩, rfl⟩ := Guarded.ok_iff.1 h\n  have hpr : RootPlace s3.P p := by\n    refine ⟨hu.lt, ?_⟩\n    unfold OwnedRoot at hor; unfold parentOf\n    cases hpl : s3.P[p]? with\n    | none => rw [hpl] at hor; exact hor.elim\n    | some pl => rw [hpl] at hor; exact hor.1\n  have hl0 := headD_mem_footprint hwf hpr.1\n  have hnu : ¬ (freeEff s3 p).Usable p := fun h' => by\n    have := h'.dead_false\n    simp [freeEff, cleanup, freeS, partOf, hpr.1] at this\n  have hne : ∀ r, (freeEff s3 p).Usable r → r ≠ p := fun r h' e => hnu (e ▸ h')\n  have hUb : ∀ r, (freeEff s3 p).Usable r → s3.Usable r := fun r h' =>\n    S3.Usable.mono rfl (fun _ h => h) (fun q hq => by\n      simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff] at hq; exact hq.1) h'\n  have hdiff : ∀ r, RootPlace s3.P r → r ≠ p → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ∉ [rootAlloc L s3.P p] := fun r hr hrp l hl hm => by\n    rw [List.mem_singleton] at hm\n    exact hR.inj r hr.1 p hpr.1 hr hpr hrp l hl _ hl0 hm\n  refine ⟨deallocOps_ok _ _ (List.pairwise_singleton _ _) fun i hi => ?_, ?_⟩\n  · rw [List.mem_singleton.1 hi]\n    exact (hR.live p hpr.1 hpr hu _ hl0).and (hfs p auth hdl hfc _ hl0)\n  · refine repr_deallocs hR _ _ rfl (fun _ h => h) (fun r _ hrt hu' => ⟨hUb r hu',\n      hdiff r hrt (hne r hu')⟩) (fun r _ hrt hf => ?_) (fun _ _ _ h => .inl h)\n      (fun r _ hrt _ hf _ => ?_)\n    · simp only [freeEff, cleanup, freeS, Bool.or_eq_true, decide_eq_true_eq] at hf\n      rcases hf with hf | rfl\n      · exact .inl hf\n      · exact .inr fun l hl => List.mem_singleton.2 (rootAlloc_eq hwf hR.lwf hpr hl)\n    · simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hf\n      exact ⟨.inr hf.1, hdiff r hrt hf.2⟩\n\n/-- R6 for `enterFrame` (MM-03.3 §9.2, O6; K4: `enterFrame` ↦ one `AllocStep` per root local):\nunder `WF3`, the allocations of the root locals, with the token of the new frame (K2), at the bases\nchosen by the placement, have the outcome `ok`, and the arrival states are in `Repr`, for every\ngeometry of valid alignment and every layout of the new leaves (`NewLayout`). -/\ntheorem r6_enter {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {ps : List Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}\n    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2) (hpl : PlacementOK pl)\n    (hg : ∀ i ∈ rootIdx ls, 0 < (g i).align ∧ MM02.Pow2 (g i).align)\n    (h : EnterStep ps ls s3 (.ok s3')) (hNL : NewLayout L s3'.P s3.P.length s2.next g (rootIdx ls)) :\n    AllOk C ObR ObW s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls)) ∧\n      Repr tok L s3' (exec s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls))) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  refine ⟨allocOps_ok hpl _ _ hwf2 hg, repr_extend (hd := .frame s3.nF) hR hwf2 rfl\n    (enterPre_shapeOK hpre.1) (fun q hq hu => enter_usable_back hwf hu hq)\n    (fun _ _ hu => enter_usable_old hu)\n    (fun i hi => enter_usable_new hpre.1 (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)\n    (fun l hl => ?_) (fun q _ pl _ hg => ?_) (fun f e => by cases e; rfl) hNL⟩\n  · simp only [enterEff] at hl\n    split at hl\n    · cases hl\n    · exact ⟨by omega, hl⟩\n  · cases ho : pl.owner with\n    | place _ => rw [ho] at hg; exact hg\n    | frame f => rw [ho] at hg; exact fun h => hg (List.mem_cons_of_mem _ h)\n\n/-- K4 (`exitFrame`): the root places owned by the frame `f`, the roots of its automatic\nallocations. -/\ndef frameRoots (s3 : S3) (f : Nat) : List Nat :=\n  (List.range s3.P.length).filter fun r =>\n    decide (RootPlace s3.P r) && decide (OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False)\n\ntheorem mem_frameRoots {s3 : S3} {f r : Nat} :\n    r ∈ frameRoots s3 f ↔ RootPlace s3.P r ∧ OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False := by\n  simp only [frameRoots, List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq]\n  exact ⟨fun h => h.2, fun h => ⟨h.1.1, h.1, h.2⟩⟩\n\n/-- K4 (`exitFrame` ↦ one `DeallocStep` per automatic allocation of the frame, none for the owned\nstorage that dies with it): the deallocations of the allocations of the root places owned by the\ncurrent frame, with its token (K2). -/\ndef exitOps (L : Layout) (tok : Nat → Nat) (s3 : S3) : List Op2 :=\n  deallocOps ((frameRoots s3 s3.top).map (rootAlloc L s3.P)) (tok s3.top)\n\n/-- R6 for `exitFrame` (MM-03.3 §9.2, O7; K4): under `WF3`, `FrameOwnedLive` and the compatibility\nof the frame tokens (K2), the deallocations of the automatic allocations of the exited frame have\nthe outcome `ok`, and the arrival states are in `Repr`: owned storage that dies with the frame\nkeeps its allocation live (leak). -/\ntheorem r6_exit {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} (hwf : WF3 s3)\n    (hfo : FrameOwnedLive s3) (hR : Repr tok L s3 s2) (htc : TokCompat C tok)\n    (h : ExitStep k s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (exitOps L tok s3) ∧ Repr tok L s3' (exec s2 (exitOps L tok s3)) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  obtain ⟨f, F₀, hF⟩ : ∃ f F₀, s3.F = f :: F₀ := by\n    unfold ExitPre at hpre; split at hpre\n    · exact ⟨_, _, ‹_›⟩\n    · exact hpre.elim\n  have htop : s3.top = f := by simp [S3.top, hF]\n  have hfF₀ : f ∉ F₀ := by have := hwf.nodup; rw [hF] at this; exact (List.nodup_cons.1 this).1\n  have e := exitEff_eq hF\n  have hhead : ∀ r ∈ frameRoots s3 f, (footprint s3.P r).headD r ∈ footprint s3.P r := fun r hr =>\n    headD_mem_footprint hwf (mem_frameRoots.1 hr).1.1\n  -- the allocations of two distinct roots differ\n  have hinj : ∀ r r', RootPlace s3.P r → RootPlace s3.P r' → r ≠ r' → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ≠ rootAlloc L s3.P r' := fun r r' hr hr' hne l hl =>\n    hR.inj r hr.1 r' hr'.1 hr hr' hne l hl _ (headD_mem_footprint hwf hr'.1)\n  -- a root owned by the frame `f` is not another root\n  have hnotin : ∀ r, RootPlace s3.P r → r ∉ frameRoots s3 f → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ∉ (frameRoots s3 f).map (rootAlloc L s3.P) := fun r hr hn l hl hm => by\n    obtain ⟨r', hr', he⟩ := List.mem_map.1 hm\n    exact hinj r r' hr (mem_frameRoots.1 hr').1 (fun e => hn (e ▸ hr')) l hl he.symm\n  have howner : ∀ r, r ∈ frameRoots s3 f → ∃ pl, s3.P[r]? = some pl ∧ pl.owner = .frame f :=\n    fun r hr => by\n      have := (mem_frameRoots.1 hr).2\n      unfold OptP at this; split at this\n      · exact ⟨_, ‹_›, this⟩\n      · exact this.elim\n  unfold exitOps; rw [htop]\n  refine ⟨deallocOps_ok _ _ ?_ fun i hi => ?_, ?_⟩\n  · refine List.pairwise_map.2 (((pairwise_lt_range _).filter _).imp_of_mem\n      fun ha hb hlt => ?_)\n    exact hinj _ _ (mem_frameRoots.1 ha).1 (mem_frameRoots.1 hb).1 (Nat.ne_of_lt hlt) _ (hhead _ ha)\n  · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hi\n    obtain ⟨pl, hpl, ho⟩ := howner r hr\n    have hrt := (mem_frameRoots.1 hr).1\n    have hu : s3.Usable r := .frame hpl (hfo r pl f hpl ho) ho (by rw [hF]; exact List.mem_cons_self ..)\n    have ht := hR.tokens r hrt.1 hrt\n    rw [hpl] at ht; simp only [OptP] at ht; rw [ho] at ht\n    exact ((hR.live r hrt.1 hrt hu _ (hhead r hr)).and (ht _ (hhead r hr))).mono\n      fun a ⟨h1, h2⟩ => ⟨h1, _, h2, htc f⟩\n  · refine repr_deallocs hR _ _ (by rw [e]) (fun _ h => by rw [e] at h; exact h)\n      (fun r _ hrt hu => ?_) (fun r _ _ hf => .inl (by rw [e] at hf; exact hf))\n      (fun r _ hrt hg => ?_) (fun r _ hrt hu hf ho => ?_)\n    · have hu' : ({ s3 with F := F₀ } : S3).Usable r :=\n        (S3.Usable.congr (s := ({ s3 with F := F₀ } : S3)) (by rw [e]) (by rw [e]) (by rw [e])).1 hu\n      refine ⟨S3.Usable.mono rfl (fun g hg => by rw [hF]; exact List.mem_cons_of_mem _ hg)\n        (fun _ h => h) hu', hnotin r hrt fun hm => ?_⟩\n      obtain ⟨pl, hpl, ho⟩ := howner r hm\n      cases hu' with\n      | frame hpl' _ ho' hf' => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'; exact hfF₀ hf'\n      | place hpl' _ ho' _ => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'\n    · rw [e] at hg\n      cases hpl : s3.P[r]? with\n      | none => rw [hpl] at hg; exact hg.elim\n      | some pl =>\n        rw [hpl] at hg; simp only [OptP] at hg ⊢\n        cases ho : pl.owner with\n        | place _ => rw [ho] at hg; exact hg.elim\n        | frame g =>\n          rw [ho] at hg; simp only [FrameGone] at hg ⊢\n          by_cases hgf : g = f\n          · subst hgf\n            refine .inr fun l hl => List.mem_map.2 ⟨r, mem_frameRoots.2 ⟨hrt, ?_⟩,\n              (rootAlloc_eq hwf hR.lwf hrt hl).symm⟩\n            rw [hpl]; exact ho\n          · exact .inl fun hm => by rw [hF] at hm; exact (List.mem_cons.1 hm).elim hgf hg\n    · refine ⟨.inr (by rw [e] at hf; exact hf), hnotin r hrt fun hm => ?_⟩\n      obtain ⟨pl, hpl, ho'⟩ := howner r hm\n      rw [hpl] at ho; simp only [OptP] at ho; rw [ho'] at ho; cases ho\n\n/-- K4: the `ok` steps of MM-03 to which no MM-02 step corresponds: `derive`, `split`, `release`,\n`depend`, `endUse`, `pin`, `unpin`, `newArena`, `reset`. -/\ninductive NoStep (k : K) : S3 → S3 → Prop where\n  | derive {s s' : S3} {src q : Nat} {m : Mode} : DeriveStep src q m s (.ok s') → NoStep k s s'\n  | split {s s' : S3} {src : Nat} {rs : List (List Nat)} :\n      SplitStep k src rs s (.ok s') → NoStep k s s'\n  | release {s s' : S3} {a : Nat} : ReleaseStep a s (.ok s') → NoStep k s s'\n  | depend {s s' : S3} {q x : Nat} : DependStep q x s (.ok s') → NoStep k s s'\n  | endUse {s s' : S3} {p : Nat} : EndUseStep k p s (.ok s') → NoStep k s s'\n  | pin {s s' : S3} {p : Nat} : PinStep p s (.ok s') → NoStep k s s'\n  | unpin {s s' : S3} {p : Nat} : UnpinStep k p s (.ok s') → NoStep k s s'\n  | newArena {s s' : S3} {st i : Nat} : NewArenaStep st i s (.ok s') → NoStep k s s'\n  | reset {s s' : S3} {i via : Nat} : ResetAtStep k i via s (.ok s') → NoStep k s s'\n\n/-- R6 for the steps without MM-02 step (MM-03.3 §9.2; K4): the empty sequence, and the arrival\nstates are in `Repr`. -/\ntheorem r6_noStep {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (h : NoStep k s3 s3') :\n    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by\n  refine ⟨trivial, ?_⟩\n  have same : ∀ {s' : S3}, s'.P = s3.P → s'.F = s3.F → s'.dead = s3.dead → s'.freed = s3.freed →\n      s'.I = s3.I → Repr tok L s' s2 := fun hP hF hd hfr hI =>\n    hR.shrink hP hF hfr (fun _ h => h.of_eqs hP hF hd) (fun _ h => by rw [← hI]; exact h)\n  cases h with\n  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | release hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold releaseEff; split <;> exact same rfl rfl rfl rfl rfl\n  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | endUse hs =>\n    rename_i p\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    refine hR.shrink rfl rfl rfl (fun q hq => S3.Usable.mono rfl (fun _ h => h) (fun q' hq' => ?_) hq)\n      (fun l hl => ?_)\n    · simp only [endUseEff, cleanup, endUseS, Bool.or_eq_false_iff] at hq'; exact hq'.1\n    · simp only [endUseEff, cleanup, endUseS] at hl; split at hl\n      · cases hl\n      · exact hl\n  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | reset hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold resetAtEff; split\n    · exact same rfl rfl rfl rfl rfl\n    · exact same rfl rfl rfl rfl rfl\n\n/-! ## Smoke test -/"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2554,"cache_read_input_tokens":511861,"output_tokens":24048,"output_tokens_details":{"thinking_tokens":9045},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2554,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":24048,"cache_read_input_tokens":511861,"cache_creation_input_tokens":2554,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2554},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_0143VCSw574ExjwFwgY13Av5":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","old_string":"/-! ## Smoke test -/","new_string":"/-! ## Allocation of a root place (K2) -/\n\n/-- Every place has a leaf (MM-03.3.2), under `WF3`: a part comes after its parent. -/\ntheorem exists_leaf {s : S3} (hwf : WF3 s) : ∀ m q, s.P.length ≤ q + m → q < s.P.length →\n    ∃ l, l ∈ footprint s.P q\n  | 0, q, hm, hq => absurd hq (by omega)\n  | m + 1, q, hm, hq => by\n    by_cases h : ∃ r, r < s.P.length ∧ parentOf s.P r = some q\n    · obtain ⟨r, hr, hp⟩ := h\n      have hlt := (hwf.parent_lt hp).1\n      obtain ⟨l, hl⟩ := exists_leaf hwf m r (by omega) hr\n      exact ⟨l, footprint_sub hwf ⟨hr, .inr (by rw [chain_cons hp hlt]; exact List.mem_cons_self ..)⟩\n        hl⟩\n    · exact ⟨q, mem_footprint.2 ⟨hq, fun r hr e => h ⟨r, hr, e⟩, hq, .inl rfl⟩⟩\n\n/-- K2: the allocation of the root place `r`, read on the first leaf of its footprint. -/\ndef rootAlloc (L : Layout) (P : List Place) (r : Nat) : Nat := (L ((footprint P r).headD r)).alloc\n\ntheorem headD_mem_footprint {s : S3} (hwf : WF3 s) {r : Nat} (hr : r < s.P.length) :\n    (footprint s.P r).headD r ∈ footprint s.P r := by\n  obtain ⟨l, hl⟩ := exists_leaf hwf s.P.length r (by omega) hr\n  cases h : footprint s.P r with\n  | nil => rw [h] at hl; cases hl\n  | cons x xs => exact List.mem_cons_self ..\n\n/-- K1 (a), K2: every leaf of a root place is in the allocation of the root. -/\ntheorem rootAlloc_eq {L : Layout} {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3)\n    (hlw : LayoutWF L s3 s2) {r : Nat} (hr : RootPlace s3.P r) {l : Nat}\n    (hl : l ∈ footprint s3.P r) : (L l).alloc = rootAlloc L s3.P r :=\n  hlw.sameAlloc r hr.1 hr l hl _ (headD_mem_footprint hwf hr.1)\n\n/-! ## Deallocations (K4: `free`, `exitFrame`) -/\n\ntheorem exec_wf : ∀ (ops : List Op2) (s : MM02.State), MM02.WF s → MM02.WF (exec s ops)\n  | [], _, h => h\n  | o :: os, _, h => exec_wf os _ (by\n      cases o\n      · exact h\n      · exact MM02.write_wf h _ _\n      · exact MM02.dealloc_wf h _\n      · exact MM02.alloc_wf h _ _ _ _ _)\n\n/-- K4 (`free`, `exitFrame`): one deallocation of each allocation of `ids`, with the\ndeallocation authority `au` (MM-02.D). -/\ndef deallocOps (ids : List Nat) (au : Nat) : List Op2 := ids.map fun i => .dealloc i au\n\ntheorem dealloc_allocs (s : MM02.State) (id i : Nat) :\n    (s.dealloc id).allocs i =\n      if i = id then (s.allocs i).map (fun a => { a with live := false }) else s.allocs i := rfl\n\ntheorem exec_deallocOps (au : Nat) : ∀ (ids : List Nat) (s : MM02.State) (j : Nat),\n    (exec s (deallocOps ids au)).allocs j =\n      if j ∈ ids then (s.allocs j).map (fun a => { a with live := false }) else s.allocs j\n  | [], s, j => by simp [deallocOps, exec]\n  | i :: is, s, j => by\n    show (exec (s.dealloc i) (deallocOps is au)).allocs j = _\n    rw [exec_deallocOps au is, dealloc_allocs]\n    by_cases h1 : j ∈ is <;> by_cases h2 : j = i <;>\n      simp only [h1, h2, List.mem_cons, true_or, or_true, or_false, ↓reduceIte, Option.map_map,\n        Function.comp_def]\n\n/-- K4: the deallocations of distinct live allocations whose token is compatible with `au` have\nthe outcome `ok` (MM-02.D). -/\ntheorem deallocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {au : Nat} : ∀ (ids : List Nat) (s : MM02.State), ids.Pairwise (· ≠ ·) →\n      (∀ i ∈ ids, AllocP s i fun a => a.live = true ∧ ∃ d, a.freeAuth = some d ∧ C au d) →\n      AllOk C ObR ObW s (deallocOps ids au)\n  | [], _, _, _ => trivial\n  | i :: is, s, hp, h => by\n    obtain ⟨hne, hp⟩ := List.pairwise_cons.1 hp\n    obtain ⟨a, ha, hl, d, hd, hc⟩ := h i (List.mem_cons_self ..)\n    refine ⟨.ok ⟨a, ha, hl, d, hd, hc⟩, deallocOps_ok is _ hp fun j hj => ?_⟩\n    have hji : j ≠ i := fun e => hne j hj e.symm\n    exact (h j (List.mem_cons_of_mem _ hj)).of_eq (by rw [dealloc_allocs]; simp only [hji, ↓reduceIte])\n\n/-- K3: `Repr` carries over when the places, the stack and the `freed` marks do not change, no\nplace becomes usable and no leaf becomes `Init` (`endUse` and the steps without MM-02 step). -/\ntheorem Repr.shrink {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (hP : s3'.P = s3.P) (hF : s3'.F = s3.F) (hfr : s3'.freed = s3.freed)\n    (hU : ∀ q, s3'.Usable q → s3.Usable q) (hI : ∀ l, s3'.I l = .init → s3.I l = .init) :\n    Repr tok L s3' s2 := by\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP, hF, hfr]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact hR.lwf.within\n  · exact hR.inj\n  · exact hR.tokens\n  · exact fun r hr hrt hu => hR.live r hr hrt (hU r hu)\n  · exact fun l hl hlf hi => hR.init l hl hlf (hI l hi)\n  · exact hR.freed\n  · exact hR.exited\n  · intro r hr hrt hu hf ho\n    by_cases hu' : s3.Usable r\n    · exact hR.live r hr hrt hu'\n    · exact hR.leaked r hr hrt hu' hf ho\n\n/-- K3, K4: `Repr` carries over to the deallocation of the allocations `ids` when the places do\nnot change, no leaf becomes `Init`, a root usable after was usable before and keeps its\nallocation, a root freed or exited after was so before or has its allocation deallocated, and a\nleaked root after was usable or not freed before and keeps its allocation. -/\ntheorem repr_deallocs {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (ids : List Nat) (au : Nat) (hP : s3'.P = s3.P)\n    (hI : ∀ l, s3'.I l = .init → s3.I l = .init)\n    (hlive : ∀ r < s3.P.length, RootPlace s3.P r → s3'.Usable r →\n      s3.Usable r ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids)\n    (hfreed : ∀ r < s3.P.length, RootPlace s3.P r → s3'.freed r = true →\n      s3.freed r = true ∨ ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)\n    (hexit : ∀ r < s3.P.length, RootPlace s3.P r →\n      OptP (s3.P[r]?) (fun pl => FrameGone s3'.F pl.owner) False →\n      OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False ∨\n        ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)\n    (hleak : ∀ r < s3.P.length, RootPlace s3.P r → ¬ s3'.Usable r → s3'.freed r = false →\n      OptP (s3.P[r]?) (fun pl => pl.owner.isPlace = true) False →\n      (s3.Usable r ∨ s3.freed r = false) ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids) :\n    Repr tok L s3' (exec s2 (deallocOps ids au)) := by\n  have hall := exec_deallocOps au ids s2\n  have keep : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∉ ids →\n      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hj =>\n    h.of_eq (by rw [hall]; simp only [hj, ↓reduceIte])\n  have meta : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p →\n      (∀ a : MM02.Alloc, p a → p { a with live := false }) →\n      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hp => by\n    obtain ⟨a, ha, hpa⟩ := h\n    by_cases hj : j ∈ ids\n    · exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], hp a hpa⟩\n    · exact ⟨a, by rw [hall]; simp only [hj, ↓reduceIte, ha], hpa⟩\n  have dead : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∈ ids →\n      DeadAlloc (exec s2 (deallocOps ids au)) j := fun j p h hj => by\n    obtain ⟨a, ha, -⟩ := h\n    exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], rfl⟩\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact fun l hl hlf => meta _ _ (hR.lwf.within l hl hlf) fun _ h => h\n  · exact hR.inj\n  · exact fun r hr hrt => OptP.imp (hR.tokens r hr hrt) (fun _ h => OptP.imp h\n      (fun _ h l hl => meta _ _ (h l hl) fun _ h => h) id) id\n  · intro r hr hrt hu l hl\n    obtain ⟨hu', hn⟩ := hlive r hr hrt hu\n    exact keep _ _ (hR.live r hr hrt hu' l hl) (hn l hl)\n  · exact fun l hl hlf hi => meta _ _ (hR.init l hl hlf (hI l hi)) fun _ h => h\n  · intro r hr hrt hf l hl\n    rcases hfreed r hr hrt hf with h | h\n    · exact meta _ _ (hR.freed r hr hrt h l hl) fun _ _ => rfl\n    · exact dead _ _ (hR.lwf.within l hr (mem_footprint.1 hl).2.1) (h l hl)\n  · intro r hr hrt hg l hl\n    rcases hexit r hr hrt hg with h | h\n    · exact meta _ _ (hR.exited r hr hrt h l hl) fun _ _ => rfl\n    · exact dead _ _ (hR.lwf.within l (mem_footprint.1 hl).1 (mem_footprint.1 hl).2.1) (h l hl)\n  · intro r hr hrt hu hf ho l hl\n    obtain ⟨h, hn⟩ := hleak r hr hrt hu hf ho\n    have hl' : LiveAlloc s2 (L l).alloc := by\n      by_cases hu' : s3.Usable r\n      · exact hR.live r hr hrt hu' l hl\n      · exact hR.leaked r hr hrt hu' (h.resolve_left hu') ho l hl\n    exact keep _ _ hl' (hn l hl)\n\n/-! ## R6 (MM-03.3 §9.2; K4) -/\n\n/-- MM-03.3.8 (`Deallocable`, `FreeCompat`) and K4 (\"`free` ↦ `DeallocStep`, autorité\n`Compatible` issue de `FreeCompat`\"): obligation of the contracts towards MM-02 in the state `s2`:\nwhen the contracts permit `free p auth`, every leaf of `p` is in an allocation with a token\ncompatible with `auth` (MM-02.D). -/\ndef FreeSound (k : K) (C : Nat → Nat → Prop) (L : Layout) (s3 : S3) (s2 : MM02.State) : Prop :=\n  ∀ p auth, k.Deallocable p → k.FreeCompat p auth → ∀ l ∈ footprint s3.P p,\n    AllocP s2 (L l).alloc fun a => ∃ d, a.freeAuth = some d ∧ C auth d\n\n/-- K2: the token proper to each frame is compatible with itself (MM-02.D): the authority that\n`exitFrame` presents for an automatic allocation of the frame `f` is `tok f`, compatible by\nconstruction. -/\ndef TokCompat (C : Nat → Nat → Prop) (tok : Nat → Nat) : Prop := ∀ f, C (tok f) (tok f)\n\ntheorem exec_readOps (s2 s2' : MM02.State) (L : Layout) :\n    ∀ ls : List Nat, exec s2 (readOps s2' L ls) = s2\n  | [] => rfl\n  | _ :: ls => exec_readOps s2 s2' L ls\n\n/-- R6 for `read3` (MM-03.3 §9.2; K4): the reads of MM-02 have the outcome `ok` and the arrival\nstates are in `Repr`; hypotheses of `r1_read3`. -/\ntheorem r6_read3 {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {a : Nat} {ls : List Nat}\n    (hwf : WF3 s3) (hnd : NoDangling s3) (hfl : FpLeaves s3) (hR : Repr tok L s3 s2)\n    (h : Read3Step a ls s3 (.ok s3')) (hstat : ∀ s ac, ObR.stat s ac)\n    (hdec : ∀ l ∈ ls, ObR.dec s2 (leafAcc s2 L .read l)) :\n    AllOk C ObR ObW s2 (readOps s2 L ls) ∧ Repr tok L s3' (exec s2 (readOps s2 L ls)) := by\n  have h1 := r1_read3 hwf hnd hfl hR h hstat hdec\n  obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n  refine ⟨?_, by rw [exec_readOps]; exact hR⟩\n  have : ∀ ls', (∀ l ∈ ls', l ∈ ls) → AllOk C ObR ObW s2 (readOps s2 L ls') := fun ls' => by\n    induction ls' with\n    | nil => exact fun _ => trivial\n    | cons l ls' ih =>\n      intro hs\n      obtain ⟨al, -, -, hok, -⟩ := h1 l (hs l (List.mem_cons_self ..))\n      exact ⟨⟨_, hok⟩, ih fun l' hl' => hs l' (List.mem_cons_of_mem _ hl')⟩\n  exact this ls fun _ h => h\n\n/-- R6 for `alloc` of outcome `ok` (MM-03.3 §9.2, O14; K4: `alloc` `ok` ↦ `AllocStep`): for a\nshape with one root (O14: \"une nouvelle racine\"), the allocation of MM-02, at the base chosen by\nthe placement, has the outcome `ok`, and the arrival states are in `Repr`, for every geometry of\nvalid alignment, every token `fa` and every layout of the new leaves in the fresh allocation\n(`NewLayout`). -/\ntheorem r6_alloc {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}\n    {fa : Option Nat} {i : Nat} (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2)\n    (hpl : PlacementOK pl) (hg : 0 < (g i).align ∧ MM02.Pow2 (g i).align)\n    (h : MM03.AllocStep k pr ow ls s3 (.ok s3')) (hone : rootIdx ls = [i])\n    (hNL : NewLayout L s3'.P s3.P.length s2.next g [i]) :\n    AllOk C ObR ObW s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] ∧\n      Repr tok L s3' (exec s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa]) := by\n  cases h with\n  | ok hst _ =>\n    have e : allocOps pl g fa s2 [i] = [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] :=\n      rfl\n    rw [← e, ← hone]\n    refine ⟨allocOps_ok hpl _ _ hwf2 (by rw [hone]; intro j hj; rw [List.mem_singleton.1 hj]; exact hg),\n      repr_extend (hd := .place ow) hR hwf2 rfl hst.2.2.2.2.2.1\n        (fun q hq hu => alloc_usable_back hwf hu hq) (fun _ _ hu => alloc_usable_old hu)\n        (fun i hi => alloc_usable_new hst (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)\n        (fun l hl => ?_) (fun _ _ _ _ h => h) (fun _ h => by cases h) (by rw [hone]; exact hNL)⟩\n    simp only [allocEff] at hl\n    split at hl\n    · cases hl\n    · rename_i hn\n      refine ⟨by omega, ?_⟩\n      split at hl\n      · exact hst.2.2.2.2.1 l ‹_›\n      · exact hl\n\n/-- R6 for `alloc` of outcome `fail` (MM-03.3 §9.2, O14; K4: `alloc` `fail` ↦ no step): the state\nis unchanged and stays in `Repr`. -/\ntheorem r6_alloc_fail {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} (hR : Repr tok L s3 s2)\n    (h : MM03.AllocStep k pr ow ls s3 (.fail s3')) :\n    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by\n  obtain ⟨rfl, -⟩ := alloc_fail_unchanged h; exact ⟨trivial, hR⟩\n\n/-- R6 for `free` (MM-03.3 §9.2, O13; K4: `free` ↦ `DeallocStep` of the allocation of the root,\nauthority `auth`, compatible by `FreeCompat`): under `WF3` and the obligation `FreeSound` of the\ncontracts, the deallocation has the outcome `ok` and the arrival states are in `Repr`. -/\ntheorem r6_free {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {p auth : Nat}\n    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hfs : FreeSound k C L s3 s2)\n    (h : FreeStep k p auth s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (deallocOps [rootAlloc L s3.P p] auth) ∧\n      Repr tok L s3' (exec s2 (deallocOps [rootAlloc L s3.P p] auth)) := by\n  obtain ⟨⟨hdl, hfc, hu, hor, -⟩, rfl⟩ := Guarded.ok_iff.1 h\n  have hpr : RootPlace s3.P p := by\n    refine ⟨hu.lt, ?_⟩\n    unfold OwnedRoot at hor; unfold parentOf\n    cases hpl : s3.P[p]? with\n    | none => rw [hpl] at hor; exact hor.elim\n    | some pl => rw [hpl] at hor; exact hor.1\n  have hl0 := headD_mem_footprint hwf hpr.1\n  have hnu : ¬ (freeEff s3 p).Usable p := fun h' => by\n    have := h'.dead_false\n    simp [freeEff, cleanup, freeS, partOf, hpr.1] at this\n  have hne : ∀ r, (freeEff s3 p).Usable r → r ≠ p := fun r h' e => hnu (e ▸ h')\n  have hUb : ∀ r, (freeEff s3 p).Usable r → s3.Usable r := fun r h' =>\n    S3.Usable.mono rfl (fun _ h => h) (fun q hq => by\n      simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff] at hq; exact hq.1) h'\n  have hdiff : ∀ r, RootPlace s3.P r → r ≠ p → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ∉ [rootAlloc L s3.P p] := fun r hr hrp l hl hm => by\n    rw [List.mem_singleton] at hm\n    exact hR.inj r hr.1 p hpr.1 hr hpr hrp l hl _ hl0 hm\n  refine ⟨deallocOps_ok _ _ (List.pairwise_singleton _ _) fun i hi => ?_, ?_⟩\n  · rw [List.mem_singleton.1 hi]\n    exact (hR.live p hpr.1 hpr hu _ hl0).and (hfs p auth hdl hfc _ hl0)\n  · refine repr_deallocs hR _ _ rfl (fun _ h => h) (fun r _ hrt hu' => ⟨hUb r hu',\n      hdiff r hrt (hne r hu')⟩) (fun r _ hrt hf => ?_) (fun _ _ _ h => .inl h)\n      (fun r _ hrt _ hf _ => ?_)\n    · simp only [freeEff, cleanup, freeS, Bool.or_eq_true, decide_eq_true_eq] at hf\n      rcases hf with hf | rfl\n      · exact .inl hf\n      · exact .inr fun l hl => List.mem_singleton.2 (rootAlloc_eq hwf hR.lwf hpr hl)\n    · simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hf\n      exact ⟨.inr hf.1, hdiff r hrt hf.2⟩\n\n/-- R6 for `enterFrame` (MM-03.3 §9.2, O6; K4: `enterFrame` ↦ one `AllocStep` per root local):\nunder `WF3`, the allocations of the root locals, with the token of the new frame (K2), at the bases\nchosen by the placement, have the outcome `ok`, and the arrival states are in `Repr`, for every\ngeometry of valid alignment and every layout of the new leaves (`NewLayout`). -/\ntheorem r6_enter {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {ps : List Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}\n    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2) (hpl : PlacementOK pl)\n    (hg : ∀ i ∈ rootIdx ls, 0 < (g i).align ∧ MM02.Pow2 (g i).align)\n    (h : EnterStep ps ls s3 (.ok s3')) (hNL : NewLayout L s3'.P s3.P.length s2.next g (rootIdx ls)) :\n    AllOk C ObR ObW s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls)) ∧\n      Repr tok L s3' (exec s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls))) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  refine ⟨allocOps_ok hpl _ _ hwf2 hg, repr_extend (hd := .frame s3.nF) hR hwf2 rfl\n    (enterPre_shapeOK hpre.1) (fun q hq hu => enter_usable_back hwf hu hq)\n    (fun _ _ hu => enter_usable_old hu)\n    (fun i hi => enter_usable_new hpre.1 (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)\n    (fun l hl => ?_) (fun q _ pl _ hg => ?_) (fun f e => by cases e; rfl) hNL⟩\n  · simp only [enterEff] at hl\n    split at hl\n    · cases hl\n    · exact ⟨by omega, hl⟩\n  · cases ho : pl.owner with\n    | place _ => rw [ho] at hg; exact hg\n    | frame f => rw [ho] at hg; exact fun h => hg (List.mem_cons_of_mem _ h)\n\n/-- K4 (`exitFrame`): the root places owned by the frame `f`, the roots of its automatic\nallocations. -/\ndef frameRoots (s3 : S3) (f : Nat) : List Nat :=\n  (List.range s3.P.length).filter fun r =>\n    decide (RootPlace s3.P r) && decide (OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False)\n\ntheorem mem_frameRoots {s3 : S3} {f r : Nat} :\n    r ∈ frameRoots s3 f ↔ RootPlace s3.P r ∧ OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False := by\n  simp only [frameRoots, List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq]\n  exact ⟨fun h => h.2, fun h => ⟨h.1.1, h.1, h.2⟩⟩\n\n/-- K4 (`exitFrame` ↦ one `DeallocStep` per automatic allocation of the frame, none for the owned\nstorage that dies with it): the deallocations of the allocations of the root places owned by the\ncurrent frame, with its token (K2). -/\ndef exitOps (L : Layout) (tok : Nat → Nat) (s3 : S3) : List Op2 :=\n  deallocOps ((frameRoots s3 s3.top).map (rootAlloc L s3.P)) (tok s3.top)\n\n/-- R6 for `exitFrame` (MM-03.3 §9.2, O7; K4): under `WF3`, `FrameOwnedLive` and the compatibility\nof the frame tokens (K2), the deallocations of the automatic allocations of the exited frame have\nthe outcome `ok`, and the arrival states are in `Repr`: owned storage that dies with the frame\nkeeps its allocation live (leak). -/\ntheorem r6_exit {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} (hwf : WF3 s3)\n    (hfo : FrameOwnedLive s3) (hR : Repr tok L s3 s2) (htc : TokCompat C tok)\n    (h : ExitStep k s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (exitOps L tok s3) ∧ Repr tok L s3' (exec s2 (exitOps L tok s3)) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  obtain ⟨f, F₀, hF⟩ : ∃ f F₀, s3.F = f :: F₀ := by\n    unfold ExitPre at hpre; split at hpre\n    · exact ⟨_, _, ‹_›⟩\n    · exact hpre.elim\n  have htop : s3.top = f := by simp [S3.top, hF]\n  have hfF₀ : f ∉ F₀ := by have := hwf.nodup; rw [hF] at this; exact (List.nodup_cons.1 this).1\n  have e := exitEff_eq hF\n  have hhead : ∀ r ∈ frameRoots s3 f, (footprint s3.P r).headD r ∈ footprint s3.P r := fun r hr =>\n    headD_mem_footprint hwf (mem_frameRoots.1 hr).1.1\n  -- the allocations of two distinct roots differ\n  have hinj : ∀ r r', RootPlace s3.P r → RootPlace s3.P r' → r ≠ r' → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ≠ rootAlloc L s3.P r' := fun r r' hr hr' hne l hl =>\n    hR.inj r hr.1 r' hr'.1 hr hr' hne l hl _ (headD_mem_footprint hwf hr'.1)\n  -- a root owned by the frame `f` is not another root\n  have hnotin : ∀ r, RootPlace s3.P r → r ∉ frameRoots s3 f → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ∉ (frameRoots s3 f).map (rootAlloc L s3.P) := fun r hr hn l hl hm => by\n    obtain ⟨r', hr', he⟩ := List.mem_map.1 hm\n    exact hinj r r' hr (mem_frameRoots.1 hr').1 (fun e => hn (e ▸ hr')) l hl he.symm\n  have howner : ∀ r, r ∈ frameRoots s3 f → ∃ pl, s3.P[r]? = some pl ∧ pl.owner = .frame f :=\n    fun r hr => by\n      have := (mem_frameRoots.1 hr).2\n      unfold OptP at this; split at this\n      · exact ⟨_, ‹_›, this⟩\n      · exact this.elim\n  unfold exitOps; rw [htop]\n  refine ⟨deallocOps_ok _ _ ?_ fun i hi => ?_, ?_⟩\n  · refine List.pairwise_map.2 (((pairwise_lt_range _).filter _).imp_of_mem\n      fun ha hb hlt => ?_)\n    exact hinj _ _ (mem_frameRoots.1 ha).1 (mem_frameRoots.1 hb).1 (Nat.ne_of_lt hlt) _ (hhead _ ha)\n  · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hi\n    obtain ⟨pl, hpl, ho⟩ := howner r hr\n    have hrt := (mem_frameRoots.1 hr).1\n    have hu : s3.Usable r := .frame hpl (hfo r pl f hpl ho) ho (by rw [hF]; exact List.mem_cons_self ..)\n    have ht := hR.tokens r hrt.1 hrt\n    rw [hpl] at ht; simp only [OptP] at ht; rw [ho] at ht\n    exact ((hR.live r hrt.1 hrt hu _ (hhead r hr)).and (ht _ (hhead r hr))).mono\n      fun a ⟨h1, h2⟩ => ⟨h1, _, h2, htc f⟩\n  · refine repr_deallocs hR _ _ (by rw [e]) (fun _ h => by rw [e] at h; exact h)\n      (fun r _ hrt hu => ?_) (fun r _ _ hf => .inl (by rw [e] at hf; exact hf))\n      (fun r _ hrt hg => ?_) (fun r _ hrt hu hf ho => ?_)\n    · have hu' : ({ s3 with F := F₀ } : S3).Usable r :=\n        (S3.Usable.congr (s := ({ s3 with F := F₀ } : S3)) (by rw [e]) (by rw [e]) (by rw [e])).1 hu\n      refine ⟨S3.Usable.mono rfl (fun g hg => by rw [hF]; exact List.mem_cons_of_mem _ hg)\n        (fun _ h => h) hu', hnotin r hrt fun hm => ?_⟩\n      obtain ⟨pl, hpl, ho⟩ := howner r hm\n      cases hu' with\n      | frame hpl' _ ho' hf' => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'; exact hfF₀ hf'\n      | place hpl' _ ho' _ => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'\n    · rw [e] at hg\n      cases hpl : s3.P[r]? with\n      | none => rw [hpl] at hg; exact hg.elim\n      | some pl =>\n        rw [hpl] at hg; simp only [OptP] at hg ⊢\n        cases ho : pl.owner with\n        | place _ => rw [ho] at hg; exact hg.elim\n        | frame g =>\n          rw [ho] at hg; simp only [FrameGone] at hg ⊢\n          by_cases hgf : g = f\n          · subst hgf\n            refine .inr fun l hl => List.mem_map.2 ⟨r, mem_frameRoots.2 ⟨hrt, ?_⟩,\n              (rootAlloc_eq hwf hR.lwf hrt hl).symm⟩\n            rw [hpl]; exact ho\n          · exact .inl fun hm => by rw [hF] at hm; exact (List.mem_cons.1 hm).elim hgf hg\n    · refine ⟨.inr (by rw [e] at hf; exact hf), hnotin r hrt fun hm => ?_⟩\n      obtain ⟨pl, hpl, ho'⟩ := howner r hm\n      rw [hpl] at ho; simp only [OptP] at ho; rw [ho'] at ho; cases ho\n\n/-- K4: the `ok` steps of MM-03 to which no MM-02 step corresponds: `derive`, `split`, `release`,\n`depend`, `endUse`, `pin`, `unpin`, `newArena`, `reset`. -/\ninductive NoStep (k : K) : S3 → S3 → Prop where\n  | derive {s s' : S3} {src q : Nat} {m : Mode} : DeriveStep src q m s (.ok s') → NoStep k s s'\n  | split {s s' : S3} {src : Nat} {rs : List (List Nat)} :\n      SplitStep k src rs s (.ok s') → NoStep k s s'\n  | release {s s' : S3} {a : Nat} : ReleaseStep a s (.ok s') → NoStep k s s'\n  | depend {s s' : S3} {q x : Nat} : DependStep q x s (.ok s') → NoStep k s s'\n  | endUse {s s' : S3} {p : Nat} : EndUseStep k p s (.ok s') → NoStep k s s'\n  | pin {s s' : S3} {p : Nat} : PinStep p s (.ok s') → NoStep k s s'\n  | unpin {s s' : S3} {p : Nat} : UnpinStep k p s (.ok s') → NoStep k s s'\n  | newArena {s s' : S3} {st i : Nat} : NewArenaStep st i s (.ok s') → NoStep k s s'\n  | reset {s s' : S3} {i via : Nat} : ResetAtStep k i via s (.ok s') → NoStep k s s'\n\n/-- R6 for the steps without MM-02 step (MM-03.3 §9.2; K4): the empty sequence, and the arrival\nstates are in `Repr`. -/\ntheorem r6_noStep {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (h : NoStep k s3 s3') :\n    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by\n  refine ⟨trivial, ?_⟩\n  have same : ∀ {s' : S3}, s'.P = s3.P → s'.F = s3.F → s'.dead = s3.dead → s'.freed = s3.freed →\n      s'.I = s3.I → Repr tok L s' s2 := fun hP hF hd hfr hI =>\n    hR.shrink hP hF hfr (fun _ h => h.of_eqs hP hF hd) (fun _ h => by rw [← hI]; exact h)\n  cases h with\n  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | release hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold releaseEff; split <;> exact same rfl rfl rfl rfl rfl\n  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | endUse hs =>\n    rename_i p\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    refine hR.shrink rfl rfl rfl (fun q hq => S3.Usable.mono rfl (fun _ h => h) (fun q' hq' => ?_) hq)\n      (fun l hl => ?_)\n    · simp only [endUseEff, cleanup, endUseS, Bool.or_eq_false_iff] at hq'; exact hq'.1\n    · simp only [endUseEff, cleanup, endUseS] at hl; split at hl\n      · cases hl\n      · exact hl\n  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | reset hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold resetAtEff; split\n    · exact same rfl rfl rfl rfl rfl\n    · exact same rfl rfl rfl rfl rfl\n\n/-! ## Smoke test -/"}},"serverClassifierRequest":"9e028c4b-32d9-43bc-8451-5d18bc224a8d","apiBlockIndex":1,"requestId":"req_011CgatPNxcpod7K6qa9dV3A","requestRef":"661b6baa-7f6f-4069-a337-8ea4a2161d10","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"962a4030-10b3-4436-a88e-22abb2daa08b","timestamp":"2026-10-31T19:46:12.058Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"962a4030-10b3-4436-a88e-22abb2daa08b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgatPPGUHdGqk9DMhB71C","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01R5PvoUKfV3pvpTzRxFPuBj","name":"Bash","input":{"command":"~/.elan/bin/lake env lean Ern/MM23.lean 2>&1 | grep -E \"error|warning\" -A12 | head -100","description":"Compile step 3"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2554,"cache_read_input_tokens":511861,"output_tokens":24048,"output_tokens_details":{"thinking_tokens":9045},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2554,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":24048,"cache_read_input_tokens":511861,"cache_creation_input_tokens":2554,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2554},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01R5PvoUKfV3pvpTzRxFPuBj":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && ~/.elan/bin/lake env lean Ern/MM23.lean 2>&1 | grep -E \"error|warning\" -A12 | head -100","description":"Compile step 3"}},"wireIngestContext":{"toolu_01R5PvoUKfV3pvpTzRxFPuBj":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal"}},"serverClassifierRequest":"9e028c4b-32d9-43bc-8451-5d18bc224a8d","apiBlockIndex":2,"requestId":"req_011CgatPNxcpod7K6qa9dV3A","requestRef":"661b6baa-7f6f-4069-a337-8ea4a2161d10","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"4b10cfd0-8dc6-4792-8e59-9cc8d41c46c8","timestamp":"2026-10-31T19:46:13.141Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"962a4030-10b3-4436-a88e-22abb2daa08b","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0143VCSw574ExjwFwgY13Av5","type":"tool_result","content":"The file /Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean has been updated successfully. (note: the file had been modified on disk since you last read it — the edit applied cleanly, but the file contains other changes not in your context. Read it before edits that depend on surrounding content.)"}]},"uuid":"13dc02fe-1f90-4ed4-84be-76c28edae4f7","timestamp":"2026-10-31T19:46:13.733Z","toolUseResult":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","oldString":"/-! ## Smoke test -/","newString":"/-! ## Allocation of a root place (K2) -/\n\n/-- Every place has a leaf (MM-03.3.2), under `WF3`: a part comes after its parent. -/\ntheorem exists_leaf {s : S3} (hwf : WF3 s) : ∀ m q, s.P.length ≤ q + m → q < s.P.length →\n    ∃ l, l ∈ footprint s.P q\n  | 0, q, hm, hq => absurd hq (by omega)\n  | m + 1, q, hm, hq => by\n    by_cases h : ∃ r, r < s.P.length ∧ parentOf s.P r = some q\n    · obtain ⟨r, hr, hp⟩ := h\n      have hlt := (hwf.parent_lt hp).1\n      obtain ⟨l, hl⟩ := exists_leaf hwf m r (by omega) hr\n      exact ⟨l, footprint_sub hwf ⟨hr, .inr (by rw [chain_cons hp hlt]; exact List.mem_cons_self ..)⟩\n        hl⟩\n    · exact ⟨q, mem_footprint.2 ⟨hq, fun r hr e => h ⟨r, hr, e⟩, hq, .inl rfl⟩⟩\n\n/-- K2: the allocation of the root place `r`, read on the first leaf of its footprint. -/\ndef rootAlloc (L : Layout) (P : List Place) (r : Nat) : Nat := (L ((footprint P r).headD r)).alloc\n\ntheorem headD_mem_footprint {s : S3} (hwf : WF3 s) {r : Nat} (hr : r < s.P.length) :\n    (footprint s.P r).headD r ∈ footprint s.P r := by\n  obtain ⟨l, hl⟩ := exists_leaf hwf s.P.length r (by omega) hr\n  cases h : footprint s.P r with\n  | nil => rw [h] at hl; cases hl\n  | cons x xs => exact List.mem_cons_self ..\n\n/-- K1 (a), K2: every leaf of a root place is in the allocation of the root. -/\ntheorem rootAlloc_eq {L : Layout} {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3)\n    (hlw : LayoutWF L s3 s2) {r : Nat} (hr : RootPlace s3.P r) {l : Nat}\n    (hl : l ∈ footprint s3.P r) : (L l).alloc = rootAlloc L s3.P r :=\n  hlw.sameAlloc r hr.1 hr l hl _ (headD_mem_footprint hwf hr.1)\n\n/-! ## Deallocations (K4: `free`, `exitFrame`) -/\n\ntheorem exec_wf : ∀ (ops : List Op2) (s : MM02.State), MM02.WF s → MM02.WF (exec s ops)\n  | [], _, h => h\n  | o :: os, _, h => exec_wf os _ (by\n      cases o\n      · exact h\n      · exact MM02.write_wf h _ _\n      · exact MM02.dealloc_wf h _\n      · exact MM02.alloc_wf h _ _ _ _ _)\n\n/-- K4 (`free`, `exitFrame`): one deallocation of each allocation of `ids`, with the\ndeallocation authority `au` (MM-02.D). -/\ndef deallocOps (ids : List Nat) (au : Nat) : List Op2 := ids.map fun i => .dealloc i au\n\ntheorem dealloc_allocs (s : MM02.State) (id i : Nat) :\n    (s.dealloc id).allocs i =\n      if i = id then (s.allocs i).map (fun a => { a with live := false }) else s.allocs i := rfl\n\ntheorem exec_deallocOps (au : Nat) : ∀ (ids : List Nat) (s : MM02.State) (j : Nat),\n    (exec s (deallocOps ids au)).allocs j =\n      if j ∈ ids then (s.allocs j).map (fun a => { a with live := false }) else s.allocs j\n  | [], s, j => by simp [deallocOps, exec]\n  | i :: is, s, j => by\n    show (exec (s.dealloc i) (deallocOps is au)).allocs j = _\n    rw [exec_deallocOps au is, dealloc_allocs]\n    by_cases h1 : j ∈ is <;> by_cases h2 : j = i <;>\n      simp only [h1, h2, List.mem_cons, true_or, or_true, or_false, ↓reduceIte, Option.map_map,\n        Function.comp_def]\n\n/-- K4: the deallocations of distinct live allocations whose token is compatible with `au` have\nthe outcome `ok` (MM-02.D). -/\ntheorem deallocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {au : Nat} : ∀ (ids : List Nat) (s : MM02.State), ids.Pairwise (· ≠ ·) →\n      (∀ i ∈ ids, AllocP s i fun a => a.live = true ∧ ∃ d, a.freeAuth = some d ∧ C au d) →\n      AllOk C ObR ObW s (deallocOps ids au)\n  | [], _, _, _ => trivial\n  | i :: is, s, hp, h => by\n    obtain ⟨hne, hp⟩ := List.pairwise_cons.1 hp\n    obtain ⟨a, ha, hl, d, hd, hc⟩ := h i (List.mem_cons_self ..)\n    refine ⟨.ok ⟨a, ha, hl, d, hd, hc⟩, deallocOps_ok is _ hp fun j hj => ?_⟩\n    have hji : j ≠ i := fun e => hne j hj e.symm\n    exact (h j (List.mem_cons_of_mem _ hj)).of_eq (by rw [dealloc_allocs]; simp only [hji, ↓reduceIte])\n\n/-- K3: `Repr` carries over when the places, the stack and the `freed` marks do not change, no\nplace becomes usable and no leaf becomes `Init` (`endUse` and the steps without MM-02 step). -/\ntheorem Repr.shrink {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (hP : s3'.P = s3.P) (hF : s3'.F = s3.F) (hfr : s3'.freed = s3.freed)\n    (hU : ∀ q, s3'.Usable q → s3.Usable q) (hI : ∀ l, s3'.I l = .init → s3.I l = .init) :\n    Repr tok L s3' s2 := by\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP, hF, hfr]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact hR.lwf.within\n  · exact hR.inj\n  · exact hR.tokens\n  · exact fun r hr hrt hu => hR.live r hr hrt (hU r hu)\n  · exact fun l hl hlf hi => hR.init l hl hlf (hI l hi)\n  · exact hR.freed\n  · exact hR.exited\n  · intro r hr hrt hu hf ho\n    by_cases hu' : s3.Usable r\n    · exact hR.live r hr hrt hu'\n    · exact hR.leaked r hr hrt hu' hf ho\n\n/-- K3, K4: `Repr` carries over to the deallocation of the allocations `ids` when the places do\nnot change, no leaf becomes `Init`, a root usable after was usable before and keeps its\nallocation, a root freed or exited after was so before or has its allocation deallocated, and a\nleaked root after was usable or not freed before and keeps its allocation. -/\ntheorem repr_deallocs {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (ids : List Nat) (au : Nat) (hP : s3'.P = s3.P)\n    (hI : ∀ l, s3'.I l = .init → s3.I l = .init)\n    (hlive : ∀ r < s3.P.length, RootPlace s3.P r → s3'.Usable r →\n      s3.Usable r ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids)\n    (hfreed : ∀ r < s3.P.length, RootPlace s3.P r → s3'.freed r = true →\n      s3.freed r = true ∨ ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)\n    (hexit : ∀ r < s3.P.length, RootPlace s3.P r →\n      OptP (s3.P[r]?) (fun pl => FrameGone s3'.F pl.owner) False →\n      OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False ∨\n        ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)\n    (hleak : ∀ r < s3.P.length, RootPlace s3.P r → ¬ s3'.Usable r → s3'.freed r = false →\n      OptP (s3.P[r]?) (fun pl => pl.owner.isPlace = true) False →\n      (s3.Usable r ∨ s3.freed r = false) ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids) :\n    Repr tok L s3' (exec s2 (deallocOps ids au)) := by\n  have hall := exec_deallocOps au ids s2\n  have keep : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∉ ids →\n      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hj =>\n    h.of_eq (by rw [hall]; simp only [hj, ↓reduceIte])\n  have meta : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p →\n      (∀ a : MM02.Alloc, p a → p { a with live := false }) →\n      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hp => by\n    obtain ⟨a, ha, hpa⟩ := h\n    by_cases hj : j ∈ ids\n    · exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], hp a hpa⟩\n    · exact ⟨a, by rw [hall]; simp only [hj, ↓reduceIte, ha], hpa⟩\n  have dead : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∈ ids →\n      DeadAlloc (exec s2 (deallocOps ids au)) j := fun j p h hj => by\n    obtain ⟨a, ha, -⟩ := h\n    exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], rfl⟩\n  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP]\n  · exact hR.lwf.sameAlloc\n  · exact hR.lwf.disjoint\n  · exact fun l hl hlf => meta _ _ (hR.lwf.within l hl hlf) fun _ h => h\n  · exact hR.inj\n  · exact fun r hr hrt => OptP.imp (hR.tokens r hr hrt) (fun _ h => OptP.imp h\n      (fun _ h l hl => meta _ _ (h l hl) fun _ h => h) id) id\n  · intro r hr hrt hu l hl\n    obtain ⟨hu', hn⟩ := hlive r hr hrt hu\n    exact keep _ _ (hR.live r hr hrt hu' l hl) (hn l hl)\n  · exact fun l hl hlf hi => meta _ _ (hR.init l hl hlf (hI l hi)) fun _ h => h\n  · intro r hr hrt hf l hl\n    rcases hfreed r hr hrt hf with h | h\n    · exact meta _ _ (hR.freed r hr hrt h l hl) fun _ _ => rfl\n    · exact dead _ _ (hR.lwf.within l hr (mem_footprint.1 hl).2.1) (h l hl)\n  · intro r hr hrt hg l hl\n    rcases hexit r hr hrt hg with h | h\n    · exact meta _ _ (hR.exited r hr hrt h l hl) fun _ _ => rfl\n    · exact dead _ _ (hR.lwf.within l (mem_footprint.1 hl).1 (mem_footprint.1 hl).2.1) (h l hl)\n  · intro r hr hrt hu hf ho l hl\n    obtain ⟨h, hn⟩ := hleak r hr hrt hu hf ho\n    have hl' : LiveAlloc s2 (L l).alloc := by\n      by_cases hu' : s3.Usable r\n      · exact hR.live r hr hrt hu' l hl\n      · exact hR.leaked r hr hrt hu' (h.resolve_left hu') ho l hl\n    exact keep _ _ hl' (hn l hl)\n\n/-! ## R6 (MM-03.3 §9.2; K4) -/\n\n/-- MM-03.3.8 (`Deallocable`, `FreeCompat`) and K4 (\"`free` ↦ `DeallocStep`, autorité\n`Compatible` issue de `FreeCompat`\"): obligation of the contracts towards MM-02 in the state `s2`:\nwhen the contracts permit `free p auth`, every leaf of `p` is in an allocation with a token\ncompatible with `auth` (MM-02.D). -/\ndef FreeSound (k : K) (C : Nat → Nat → Prop) (L : Layout) (s3 : S3) (s2 : MM02.State) : Prop :=\n  ∀ p auth, k.Deallocable p → k.FreeCompat p auth → ∀ l ∈ footprint s3.P p,\n    AllocP s2 (L l).alloc fun a => ∃ d, a.freeAuth = some d ∧ C auth d\n\n/-- K2: the token proper to each frame is compatible with itself (MM-02.D): the authority that\n`exitFrame` presents for an automatic allocation of the frame `f` is `tok f`, compatible by\nconstruction. -/\ndef TokCompat (C : Nat → Nat → Prop) (tok : Nat → Nat) : Prop := ∀ f, C (tok f) (tok f)\n\ntheorem exec_readOps (s2 s2' : MM02.State) (L : Layout) :\n    ∀ ls : List Nat, exec s2 (readOps s2' L ls) = s2\n  | [] => rfl\n  | _ :: ls => exec_readOps s2 s2' L ls\n\n/-- R6 for `read3` (MM-03.3 §9.2; K4): the reads of MM-02 have the outcome `ok` and the arrival\nstates are in `Repr`; hypotheses of `r1_read3`. -/\ntheorem r6_read3 {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {a : Nat} {ls : List Nat}\n    (hwf : WF3 s3) (hnd : NoDangling s3) (hfl : FpLeaves s3) (hR : Repr tok L s3 s2)\n    (h : Read3Step a ls s3 (.ok s3')) (hstat : ∀ s ac, ObR.stat s ac)\n    (hdec : ∀ l ∈ ls, ObR.dec s2 (leafAcc s2 L .read l)) :\n    AllOk C ObR ObW s2 (readOps s2 L ls) ∧ Repr tok L s3' (exec s2 (readOps s2 L ls)) := by\n  have h1 := r1_read3 hwf hnd hfl hR h hstat hdec\n  obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n  refine ⟨?_, by rw [exec_readOps]; exact hR⟩\n  have : ∀ ls', (∀ l ∈ ls', l ∈ ls) → AllOk C ObR ObW s2 (readOps s2 L ls') := fun ls' => by\n    induction ls' with\n    | nil => exact fun _ => trivial\n    | cons l ls' ih =>\n      intro hs\n      obtain ⟨al, -, -, hok, -⟩ := h1 l (hs l (List.mem_cons_self ..))\n      exact ⟨⟨_, hok⟩, ih fun l' hl' => hs l' (List.mem_cons_of_mem _ hl')⟩\n  exact this ls fun _ h => h\n\n/-- R6 for `alloc` of outcome `ok` (MM-03.3 §9.2, O14; K4: `alloc` `ok` ↦ `AllocStep`): for a\nshape with one root (O14: \"une nouvelle racine\"), the allocation of MM-02, at the base chosen by\nthe placement, has the outcome `ok`, and the arrival states are in `Repr`, for every geometry of\nvalid alignment, every token `fa` and every layout of the new leaves in the fresh allocation\n(`NewLayout`). -/\ntheorem r6_alloc {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}\n    {fa : Option Nat} {i : Nat} (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2)\n    (hpl : PlacementOK pl) (hg : 0 < (g i).align ∧ MM02.Pow2 (g i).align)\n    (h : MM03.AllocStep k pr ow ls s3 (.ok s3')) (hone : rootIdx ls = [i])\n    (hNL : NewLayout L s3'.P s3.P.length s2.next g [i]) :\n    AllOk C ObR ObW s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] ∧\n      Repr tok L s3' (exec s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa]) := by\n  cases h with\n  | ok hst _ =>\n    have e : allocOps pl g fa s2 [i] = [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] :=\n      rfl\n    rw [← e, ← hone]\n    refine ⟨allocOps_ok hpl _ _ hwf2 (by rw [hone]; intro j hj; rw [List.mem_singleton.1 hj]; exact hg),\n      repr_extend (hd := .place ow) hR hwf2 rfl hst.2.2.2.2.2.1\n        (fun q hq hu => alloc_usable_back hwf hu hq) (fun _ _ hu => alloc_usable_old hu)\n        (fun i hi => alloc_usable_new hst (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)\n        (fun l hl => ?_) (fun _ _ _ _ h => h) (fun _ h => by cases h) (by rw [hone]; exact hNL)⟩\n    simp only [allocEff] at hl\n    split at hl\n    · cases hl\n    · rename_i hn\n      refine ⟨by omega, ?_⟩\n      split at hl\n      · exact hst.2.2.2.2.1 l ‹_›\n      · exact hl\n\n/-- R6 for `alloc` of outcome `fail` (MM-03.3 §9.2, O14; K4: `alloc` `fail` ↦ no step): the state\nis unchanged and stays in `Repr`. -/\ntheorem r6_alloc_fail {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} (hR : Repr tok L s3 s2)\n    (h : MM03.AllocStep k pr ow ls s3 (.fail s3')) :\n    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by\n  obtain ⟨rfl, -⟩ := alloc_fail_unchanged h; exact ⟨trivial, hR⟩\n\n/-- R6 for `free` (MM-03.3 §9.2, O13; K4: `free` ↦ `DeallocStep` of the allocation of the root,\nauthority `auth`, compatible by `FreeCompat`): under `WF3` and the obligation `FreeSound` of the\ncontracts, the deallocation has the outcome `ok` and the arrival states are in `Repr`. -/\ntheorem r6_free {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {p auth : Nat}\n    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hfs : FreeSound k C L s3 s2)\n    (h : FreeStep k p auth s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (deallocOps [rootAlloc L s3.P p] auth) ∧\n      Repr tok L s3' (exec s2 (deallocOps [rootAlloc L s3.P p] auth)) := by\n  obtain ⟨⟨hdl, hfc, hu, hor, -⟩, rfl⟩ := Guarded.ok_iff.1 h\n  have hpr : RootPlace s3.P p := by\n    refine ⟨hu.lt, ?_⟩\n    unfold OwnedRoot at hor; unfold parentOf\n    cases hpl : s3.P[p]? with\n    | none => rw [hpl] at hor; exact hor.elim\n    | some pl => rw [hpl] at hor; exact hor.1\n  have hl0 := headD_mem_footprint hwf hpr.1\n  have hnu : ¬ (freeEff s3 p).Usable p := fun h' => by\n    have := h'.dead_false\n    simp [freeEff, cleanup, freeS, partOf, hpr.1] at this\n  have hne : ∀ r, (freeEff s3 p).Usable r → r ≠ p := fun r h' e => hnu (e ▸ h')\n  have hUb : ∀ r, (freeEff s3 p).Usable r → s3.Usable r := fun r h' =>\n    S3.Usable.mono rfl (fun _ h => h) (fun q hq => by\n      simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff] at hq; exact hq.1) h'\n  have hdiff : ∀ r, RootPlace s3.P r → r ≠ p → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ∉ [rootAlloc L s3.P p] := fun r hr hrp l hl hm => by\n    rw [List.mem_singleton] at hm\n    exact hR.inj r hr.1 p hpr.1 hr hpr hrp l hl _ hl0 hm\n  refine ⟨deallocOps_ok _ _ (List.pairwise_singleton _ _) fun i hi => ?_, ?_⟩\n  · rw [List.mem_singleton.1 hi]\n    exact (hR.live p hpr.1 hpr hu _ hl0).and (hfs p auth hdl hfc _ hl0)\n  · refine repr_deallocs hR _ _ rfl (fun _ h => h) (fun r _ hrt hu' => ⟨hUb r hu',\n      hdiff r hrt (hne r hu')⟩) (fun r _ hrt hf => ?_) (fun _ _ _ h => .inl h)\n      (fun r _ hrt _ hf _ => ?_)\n    · simp only [freeEff, cleanup, freeS, Bool.or_eq_true, decide_eq_true_eq] at hf\n      rcases hf with hf | rfl\n      · exact .inl hf\n      · exact .inr fun l hl => List.mem_singleton.2 (rootAlloc_eq hwf hR.lwf hpr hl)\n    · simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hf\n      exact ⟨.inr hf.1, hdiff r hrt hf.2⟩\n\n/-- R6 for `enterFrame` (MM-03.3 §9.2, O6; K4: `enterFrame` ↦ one `AllocStep` per root local):\nunder `WF3`, the allocations of the root locals, with the token of the new frame (K2), at the bases\nchosen by the placement, have the outcome `ok`, and the arrival states are in `Repr`, for every\ngeometry of valid alignment and every layout of the new leaves (`NewLayout`). -/\ntheorem r6_enter {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {ps : List Nat}\n    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}\n    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2) (hpl : PlacementOK pl)\n    (hg : ∀ i ∈ rootIdx ls, 0 < (g i).align ∧ MM02.Pow2 (g i).align)\n    (h : EnterStep ps ls s3 (.ok s3')) (hNL : NewLayout L s3'.P s3.P.length s2.next g (rootIdx ls)) :\n    AllOk C ObR ObW s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls)) ∧\n      Repr tok L s3' (exec s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls))) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  refine ⟨allocOps_ok hpl _ _ hwf2 hg, repr_extend (hd := .frame s3.nF) hR hwf2 rfl\n    (enterPre_shapeOK hpre.1) (fun q hq hu => enter_usable_back hwf hu hq)\n    (fun _ _ hu => enter_usable_old hu)\n    (fun i hi => enter_usable_new hpre.1 (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)\n    (fun l hl => ?_) (fun q _ pl _ hg => ?_) (fun f e => by cases e; rfl) hNL⟩\n  · simp only [enterEff] at hl\n    split at hl\n    · cases hl\n    · exact ⟨by omega, hl⟩\n  · cases ho : pl.owner with\n    | place _ => rw [ho] at hg; exact hg\n    | frame f => rw [ho] at hg; exact fun h => hg (List.mem_cons_of_mem _ h)\n\n/-- K4 (`exitFrame`): the root places owned by the frame `f`, the roots of its automatic\nallocations. -/\ndef frameRoots (s3 : S3) (f : Nat) : List Nat :=\n  (List.range s3.P.length).filter fun r =>\n    decide (RootPlace s3.P r) && decide (OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False)\n\ntheorem mem_frameRoots {s3 : S3} {f r : Nat} :\n    r ∈ frameRoots s3 f ↔ RootPlace s3.P r ∧ OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False := by\n  simp only [frameRoots, List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq]\n  exact ⟨fun h => h.2, fun h => ⟨h.1.1, h.1, h.2⟩⟩\n\n/-- K4 (`exitFrame` ↦ one `DeallocStep` per automatic allocation of the frame, none for the owned\nstorage that dies with it): the deallocations of the allocations of the root places owned by the\ncurrent frame, with its token (K2). -/\ndef exitOps (L : Layout) (tok : Nat → Nat) (s3 : S3) : List Op2 :=\n  deallocOps ((frameRoots s3 s3.top).map (rootAlloc L s3.P)) (tok s3.top)\n\n/-- R6 for `exitFrame` (MM-03.3 §9.2, O7; K4): under `WF3`, `FrameOwnedLive` and the compatibility\nof the frame tokens (K2), the deallocations of the automatic allocations of the exited frame have\nthe outcome `ok`, and the arrival states are in `Repr`: owned storage that dies with the frame\nkeeps its allocation live (leak). -/\ntheorem r6_exit {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} (hwf : WF3 s3)\n    (hfo : FrameOwnedLive s3) (hR : Repr tok L s3 s2) (htc : TokCompat C tok)\n    (h : ExitStep k s3 (.ok s3')) :\n    AllOk C ObR ObW s2 (exitOps L tok s3) ∧ Repr tok L s3' (exec s2 (exitOps L tok s3)) := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  obtain ⟨f, F₀, hF⟩ : ∃ f F₀, s3.F = f :: F₀ := by\n    unfold ExitPre at hpre; split at hpre\n    · exact ⟨_, _, ‹_›⟩\n    · exact hpre.elim\n  have htop : s3.top = f := by simp [S3.top, hF]\n  have hfF₀ : f ∉ F₀ := by have := hwf.nodup; rw [hF] at this; exact (List.nodup_cons.1 this).1\n  have e := exitEff_eq hF\n  have hhead : ∀ r ∈ frameRoots s3 f, (footprint s3.P r).headD r ∈ footprint s3.P r := fun r hr =>\n    headD_mem_footprint hwf (mem_frameRoots.1 hr).1.1\n  -- the allocations of two distinct roots differ\n  have hinj : ∀ r r', RootPlace s3.P r → RootPlace s3.P r' → r ≠ r' → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ≠ rootAlloc L s3.P r' := fun r r' hr hr' hne l hl =>\n    hR.inj r hr.1 r' hr'.1 hr hr' hne l hl _ (headD_mem_footprint hwf hr'.1)\n  -- a root owned by the frame `f` is not another root\n  have hnotin : ∀ r, RootPlace s3.P r → r ∉ frameRoots s3 f → ∀ l ∈ footprint s3.P r,\n      (L l).alloc ∉ (frameRoots s3 f).map (rootAlloc L s3.P) := fun r hr hn l hl hm => by\n    obtain ⟨r', hr', he⟩ := List.mem_map.1 hm\n    exact hinj r r' hr (mem_frameRoots.1 hr').1 (fun e => hn (e ▸ hr')) l hl he.symm\n  have howner : ∀ r, r ∈ frameRoots s3 f → ∃ pl, s3.P[r]? = some pl ∧ pl.owner = .frame f :=\n    fun r hr => by\n      have := (mem_frameRoots.1 hr).2\n      unfold OptP at this; split at this\n      · exact ⟨_, ‹_›, this⟩\n      · exact this.elim\n  unfold exitOps; rw [htop]\n  refine ⟨deallocOps_ok _ _ ?_ fun i hi => ?_, ?_⟩\n  · refine List.pairwise_map.2 (((pairwise_lt_range _).filter _).imp_of_mem\n      fun ha hb hlt => ?_)\n    exact hinj _ _ (mem_frameRoots.1 ha).1 (mem_frameRoots.1 hb).1 (Nat.ne_of_lt hlt) _ (hhead _ ha)\n  · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hi\n    obtain ⟨pl, hpl, ho⟩ := howner r hr\n    have hrt := (mem_frameRoots.1 hr).1\n    have hu : s3.Usable r := .frame hpl (hfo r pl f hpl ho) ho (by rw [hF]; exact List.mem_cons_self ..)\n    have ht := hR.tokens r hrt.1 hrt\n    rw [hpl] at ht; simp only [OptP] at ht; rw [ho] at ht\n    exact ((hR.live r hrt.1 hrt hu _ (hhead r hr)).and (ht _ (hhead r hr))).mono\n      fun a ⟨h1, h2⟩ => ⟨h1, _, h2, htc f⟩\n  · refine repr_deallocs hR _ _ (by rw [e]) (fun _ h => by rw [e] at h; exact h)\n      (fun r _ hrt hu => ?_) (fun r _ _ hf => .inl (by rw [e] at hf; exact hf))\n      (fun r _ hrt hg => ?_) (fun r _ hrt hu hf ho => ?_)\n    · have hu' : ({ s3 with F := F₀ } : S3).Usable r :=\n        (S3.Usable.congr (s := ({ s3 with F := F₀ } : S3)) (by rw [e]) (by rw [e]) (by rw [e])).1 hu\n      refine ⟨S3.Usable.mono rfl (fun g hg => by rw [hF]; exact List.mem_cons_of_mem _ hg)\n        (fun _ h => h) hu', hnotin r hrt fun hm => ?_⟩\n      obtain ⟨pl, hpl, ho⟩ := howner r hm\n      cases hu' with\n      | frame hpl' _ ho' hf' => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'; exact hfF₀ hf'\n      | place hpl' _ ho' _ => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'\n    · rw [e] at hg\n      cases hpl : s3.P[r]? with\n      | none => rw [hpl] at hg; exact hg.elim\n      | some pl =>\n        rw [hpl] at hg; simp only [OptP] at hg ⊢\n        cases ho : pl.owner with\n        | place _ => rw [ho] at hg; exact hg.elim\n        | frame g =>\n          rw [ho] at hg; simp only [FrameGone] at hg ⊢\n          by_cases hgf : g = f\n          · subst hgf\n            refine .inr fun l hl => List.mem_map.2 ⟨r, mem_frameRoots.2 ⟨hrt, ?_⟩,\n              (rootAlloc_eq hwf hR.lwf hrt hl).symm⟩\n            rw [hpl]; exact ho\n          · exact .inl fun hm => by rw [hF] at hm; exact (List.mem_cons.1 hm).elim hgf hg\n    · refine ⟨.inr (by rw [e] at hf; exact hf), hnotin r hrt fun hm => ?_⟩\n      obtain ⟨pl, hpl, ho'⟩ := howner r hm\n      rw [hpl] at ho; simp only [OptP] at ho; rw [ho'] at ho; cases ho\n\n/-- K4: the `ok` steps of MM-03 to which no MM-02 step corresponds: `derive`, `split`, `release`,\n`depend`, `endUse`, `pin`, `unpin`, `newArena`, `reset`. -/\ninductive NoStep (k : K) : S3 → S3 → Prop where\n  | derive {s s' : S3} {src q : Nat} {m : Mode} : DeriveStep src q m s (.ok s') → NoStep k s s'\n  | split {s s' : S3} {src : Nat} {rs : List (List Nat)} :\n      SplitStep k src rs s (.ok s') → NoStep k s s'\n  | release {s s' : S3} {a : Nat} : ReleaseStep a s (.ok s') → NoStep k s s'\n  | depend {s s' : S3} {q x : Nat} : DependStep q x s (.ok s') → NoStep k s s'\n  | endUse {s s' : S3} {p : Nat} : EndUseStep k p s (.ok s') → NoStep k s s'\n  | pin {s s' : S3} {p : Nat} : PinStep p s (.ok s') → NoStep k s s'\n  | unpin {s s' : S3} {p : Nat} : UnpinStep k p s (.ok s') → NoStep k s s'\n  | newArena {s s' : S3} {st i : Nat} : NewArenaStep st i s (.ok s') → NoStep k s s'\n  | reset {s s' : S3} {i via : Nat} : ResetAtStep k i via s (.ok s') → NoStep k s s'\n\n/-- R6 for the steps without MM-02 step (MM-03.3 §9.2; K4): the empty sequence, and the arrival\nstates are in `Repr`. -/\ntheorem r6_noStep {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}\n    (hR : Repr tok L s3 s2) (h : NoStep k s3 s3') :\n    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by\n  refine ⟨trivial, ?_⟩\n  have same : ∀ {s' : S3}, s'.P = s3.P → s'.F = s3.F → s'.dead = s3.dead → s'.freed = s3.freed →\n      s'.I = s3.I → Repr tok L s' s2 := fun hP hF hd hfr hI =>\n    hR.shrink hP hF hfr (fun _ h => h.of_eqs hP hF hd) (fun _ h => by rw [← hI]; exact h)\n  cases h with\n  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | release hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold releaseEff; split <;> exact same rfl rfl rfl rfl rfl\n  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | endUse hs =>\n    rename_i p\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    refine hR.shrink rfl rfl rfl (fun q hq => S3.Usable.mono rfl (fun _ h => h) (fun q' hq' => ?_) hq)\n      (fun l hl => ?_)\n    · simp only [endUseEff, cleanup, endUseS, Bool.or_eq_false_iff] at hq'; exact hq'.1\n    · simp only [endUseEff, cleanup, endUseS] at hl; split at hl\n      · cases hl\n      · exact hl\n  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl\n  | reset hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold resetAtEff; split\n    · exact same rfl rfl rfl rfl rfl\n    · exact same rfl rfl rfl rfl rfl\n\n/-! ## Smoke test -/","originalFile":null,"structuredPatch":[{"oldStart":1292,"oldLines":6,"newStart":1292,"newLines":455,"lines":["   r2_writeShared (reachable_invariants hdd hr).1 (reachable_invariants hdd hr).2.1.nd","     (reachable_fpLeaves_frameOwnedLive hdd hr).1 hR h hstat hdec"," ","+/-! ## Allocation of a root place (K2) -/","+","+/-- Every place has a leaf (MM-03.3.2), under `WF3`: a part comes after its parent. -/","+theorem exists_leaf {s : S3} (hwf : WF3 s) : ∀ m q, s.P.length ≤ q + m → q < s.P.length →","+    ∃ l, l ∈ footprint s.P q","+  | 0, q, hm, hq => absurd hq (by omega)","+  | m + 1, q, hm, hq => by","+    by_cases h : ∃ r, r < s.P.length ∧ parentOf s.P r = some q","+    · obtain ⟨r, hr, hp⟩ := h","+      have hlt := (hwf.parent_lt hp).1","+      obtain ⟨l, hl⟩ := exists_leaf hwf m r (by omega) hr","+      exact ⟨l, footprint_sub hwf ⟨hr, .inr (by rw [chain_cons hp hlt]; exact List.mem_cons_self ..)⟩","+        hl⟩","+    · exact ⟨q, mem_footprint.2 ⟨hq, fun r hr e => h ⟨r, hr, e⟩, hq, .inl rfl⟩⟩","+","+/-- K2: the allocation of the root place `r`, read on the first leaf of its footprint. -/","+def rootAlloc (L : Layout) (P : List Place) (r : Nat) : Nat := (L ((footprint P r).headD r)).alloc","+","+theorem headD_mem_footprint {s : S3} (hwf : WF3 s) {r : Nat} (hr : r < s.P.length) :","+    (footprint s.P r).headD r ∈ footprint s.P r := by","+  obtain ⟨l, hl⟩ := exists_leaf hwf s.P.length r (by omega) hr","+  cases h : footprint s.P r with","+  | nil => rw [h] at hl; cases hl","+  | cons x xs => exact List.mem_cons_self ..","+","+/-- K1 (a), K2: every leaf of a root place is in the allocation of the root. -/","+theorem rootAlloc_eq {L : Layout} {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3)","+    (hlw : LayoutWF L s3 s2) {r : Nat} (hr : RootPlace s3.P r) {l : Nat}","+    (hl : l ∈ footprint s3.P r) : (L l).alloc = rootAlloc L s3.P r :=","+  hlw.sameAlloc r hr.1 hr l hl _ (headD_mem_footprint hwf hr.1)","+","+/-! ## Deallocations (K4: `free`, `exitFrame`) -/","+","+theorem exec_wf : ∀ (ops : List Op2) (s : MM02.State), MM02.WF s → MM02.WF (exec s ops)","+  | [], _, h => h","+  | o :: os, _, h => exec_wf os _ (by","+      cases o","+      · exact h","+      · exact MM02.write_wf h _ _","+      · exact MM02.dealloc_wf h _","+      · exact MM02.alloc_wf h _ _ _ _ _)","+","+/-- K4 (`free`, `exitFrame`): one deallocation of each allocation of `ids`, with the","+deallocation authority `au` (MM-02.D). -/","+def deallocOps (ids : List Nat) (au : Nat) : List Op2 := ids.map fun i => .dealloc i au","+","+theorem dealloc_allocs (s : MM02.State) (id i : Nat) :","+    (s.dealloc id).allocs i =","+      if i = id then (s.allocs i).map (fun a => { a with live := false }) else s.allocs i := rfl","+","+theorem exec_deallocOps (au : Nat) : ∀ (ids : List Nat) (s : MM02.State) (j : Nat),","+    (exec s (deallocOps ids au)).allocs j =","+      if j ∈ ids then (s.allocs j).map (fun a => { a with live := false }) else s.allocs j","+  | [], s, j => by simp [deallocOps, exec]","+  | i :: is, s, j => by","+    show (exec (s.dealloc i) (deallocOps is au)).allocs j = _","+    rw [exec_deallocOps au is, dealloc_allocs]","+    by_cases h1 : j ∈ is <;> by_cases h2 : j = i <;>","+      simp only [h1, h2, List.mem_cons, true_or, or_true, or_false, ↓reduceIte, Option.map_map,","+        Function.comp_def]","+","+/-- K4: the deallocations of distinct live allocations whose token is compatible with `au` have","+the outcome `ok` (MM-02.D). -/","+theorem deallocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {au : Nat} : ∀ (ids : List Nat) (s : MM02.State), ids.Pairwise (· ≠ ·) →","+      (∀ i ∈ ids, AllocP s i fun a => a.live = true ∧ ∃ d, a.freeAuth = some d ∧ C au d) →","+      AllOk C ObR ObW s (deallocOps ids au)","+  | [], _, _, _ => trivial","+  | i :: is, s, hp, h => by","+    obtain ⟨hne, hp⟩ := List.pairwise_cons.1 hp","+    obtain ⟨a, ha, hl, d, hd, hc⟩ := h i (List.mem_cons_self ..)","+    refine ⟨.ok ⟨a, ha, hl, d, hd, hc⟩, deallocOps_ok is _ hp fun j hj => ?_⟩","+    have hji : j ≠ i := fun e => hne j hj e.symm","+    exact (h j (List.mem_cons_of_mem _ hj)).of_eq (by rw [dealloc_allocs]; simp only [hji, ↓reduceIte])","+","+/-- K3: `Repr` carries over when the places, the stack and the `freed` marks do not change, no","+place becomes usable and no leaf becomes `Init` (`endUse` and the steps without MM-02 step). -/","+theorem Repr.shrink {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}","+    (hR : Repr tok L s3 s2) (hP : s3'.P = s3.P) (hF : s3'.F = s3.F) (hfr : s3'.freed = s3.freed)","+    (hU : ∀ q, s3'.Usable q → s3.Usable q) (hI : ∀ l, s3'.I l = .init → s3.I l = .init) :","+    Repr tok L s3' s2 := by","+  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP, hF, hfr]","+  · exact hR.lwf.sameAlloc","+  · exact hR.lwf.disjoint","+  · exact hR.lwf.within","+  · exact hR.inj","+  · exact hR.tokens","+  · exact fun r hr hrt hu => hR.live r hr hrt (hU r hu)","+  · exact fun l hl hlf hi => hR.init l hl hlf (hI l hi)","+  · exact hR.freed","+  · exact hR.exited","+  · intro r hr hrt hu hf ho","+    by_cases hu' : s3.Usable r","+    · exact hR.live r hr hrt hu'","+    · exact hR.leaked r hr hrt hu' hf ho","+","+/-- K3, K4: `Repr` carries over to the deallocation of the allocations `ids` when the places do","+not change, no leaf becomes `Init`, a root usable after was usable before and keeps its","+allocation, a root freed or exited after was so before or has its allocation deallocated, and a","+leaked root after was usable or not freed before and keeps its allocation. -/","+theorem repr_deallocs {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}","+    (hR : Repr tok L s3 s2) (ids : List Nat) (au : Nat) (hP : s3'.P = s3.P)","+    (hI : ∀ l, s3'.I l = .init → s3.I l = .init)","+    (hlive : ∀ r < s3.P.length, RootPlace s3.P r → s3'.Usable r →","+      s3.Usable r ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids)","+    (hfreed : ∀ r < s3.P.length, RootPlace s3.P r → s3'.freed r = true →","+      s3.freed r = true ∨ ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)","+    (hexit : ∀ r < s3.P.length, RootPlace s3.P r →","+      OptP (s3.P[r]?) (fun pl => FrameGone s3'.F pl.owner) False →","+      OptP (s3.P[r]?) (fun pl => FrameGone s3.F pl.owner) False ∨","+        ∀ l ∈ footprint s3.P r, (L l).alloc ∈ ids)","+    (hleak : ∀ r < s3.P.length, RootPlace s3.P r → ¬ s3'.Usable r → s3'.freed r = false →","+      OptP (s3.P[r]?) (fun pl => pl.owner.isPlace = true) False →","+      (s3.Usable r ∨ s3.freed r = false) ∧ ∀ l ∈ footprint s3.P r, (L l).alloc ∉ ids) :","+    Repr tok L s3' (exec s2 (deallocOps ids au)) := by","+  have hall := exec_deallocOps au ids s2","+  have keep : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∉ ids →","+      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hj =>","+    h.of_eq (by rw [hall]; simp only [hj, ↓reduceIte])","+  have meta : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p →","+      (∀ a : MM02.Alloc, p a → p { a with live := false }) →","+      AllocP (exec s2 (deallocOps ids au)) j p := fun j p h hp => by","+    obtain ⟨a, ha, hpa⟩ := h","+    by_cases hj : j ∈ ids","+    · exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], hp a hpa⟩","+    · exact ⟨a, by rw [hall]; simp only [hj, ↓reduceIte, ha], hpa⟩","+  have dead : ∀ j (p : MM02.Alloc → Prop), AllocP s2 j p → j ∈ ids →","+      DeadAlloc (exec s2 (deallocOps ids au)) j := fun j p h hj => by","+    obtain ⟨a, ha, -⟩ := h","+    exact ⟨_, by rw [hall]; simp only [hj, ↓reduceIte, ha, Option.map_some], rfl⟩","+  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [hP]","+  · exact hR.lwf.sameAlloc","+  · exact hR.lwf.disjoint","+  · exact fun l hl hlf => meta _ _ (hR.lwf.within l hl hlf) fun _ h => h","+  · exact hR.inj","+  · exact fun r hr hrt => OptP.imp (hR.tokens r hr hrt) (fun _ h => OptP.imp h","+      (fun _ h l hl => meta _ _ (h l hl) fun _ h => h) id) id","+  · intro r hr hrt hu l hl","+    obtain ⟨hu', hn⟩ := hlive r hr hrt hu","+    exact keep _ _ (hR.live r hr hrt hu' l hl) (hn l hl)","+  · exact fun l hl hlf hi => meta _ _ (hR.init l hl hlf (hI l hi)) fun _ h => h","+  · intro r hr hrt hf l hl","+    rcases hfreed r hr hrt hf with h | h","+    · exact meta _ _ (hR.freed r hr hrt h l hl) fun _ _ => rfl","+    · exact dead _ _ (hR.lwf.within l hr (mem_footprint.1 hl).2.1) (h l hl)","+  · intro r hr hrt hg l hl","+    rcases hexit r hr hrt hg with h | h","+    · exact meta _ _ (hR.exited r hr hrt h l hl) fun _ _ => rfl","+    · exact dead _ _ (hR.lwf.within l (mem_footprint.1 hl).1 (mem_footprint.1 hl).2.1) (h l hl)","+  · intro r hr hrt hu hf ho l hl","+    obtain ⟨h, hn⟩ := hleak r hr hrt hu hf ho","+    have hl' : LiveAlloc s2 (L l).alloc := by","+      by_cases hu' : s3.Usable r","+      · exact hR.live r hr hrt hu' l hl","+      · exact hR.leaked r hr hrt hu' (h.resolve_left hu') ho l hl","+    exact keep _ _ hl' (hn l hl)","+","+/-! ## R6 (MM-03.3 §9.2; K4) -/","+","+/-- MM-03.3.8 (`Deallocable`, `FreeCompat`) and K4 (\"`free` ↦ `DeallocStep`, autorité","+`Compatible` issue de `FreeCompat`\"): obligation of the contracts towards MM-02 in the state `s2`:","+when the contracts permit `free p auth`, every leaf of `p` is in an allocation with a token","+compatible with `auth` (MM-02.D). -/","+def FreeSound (k : K) (C : Nat → Nat → Prop) (L : Layout) (s3 : S3) (s2 : MM02.State) : Prop :=","+  ∀ p auth, k.Deallocable p → k.FreeCompat p auth → ∀ l ∈ footprint s3.P p,","+    AllocP s2 (L l).alloc fun a => ∃ d, a.freeAuth = some d ∧ C auth d","+","+/-- K2: the token proper to each frame is compatible with itself (MM-02.D): the authority that","+`exitFrame` presents for an automatic allocation of the frame `f` is `tok f`, compatible by","+construction. -/","+def TokCompat (C : Nat → Nat → Prop) (tok : Nat → Nat) : Prop := ∀ f, C (tok f) (tok f)","+","+theorem exec_readOps (s2 s2' : MM02.State) (L : Layout) :","+    ∀ ls : List Nat, exec s2 (readOps s2' L ls) = s2","+  | [] => rfl","+  | _ :: ls => exec_readOps s2 s2' L ls","+","+/-- R6 for `read3` (MM-03.3 §9.2; K4): the reads of MM-02 have the outcome `ok` and the arrival","+states are in `Repr`; hypotheses of `r1_read3`. -/","+theorem r6_read3 {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {a : Nat} {ls : List Nat}","+    (hwf : WF3 s3) (hnd : NoDangling s3) (hfl : FpLeaves s3) (hR : Repr tok L s3 s2)","+    (h : Read3Step a ls s3 (.ok s3')) (hstat : ∀ s ac, ObR.stat s ac)","+    (hdec : ∀ l ∈ ls, ObR.dec s2 (leafAcc s2 L .read l)) :","+    AllOk C ObR ObW s2 (readOps s2 L ls) ∧ Repr tok L s3' (exec s2 (readOps s2 L ls)) := by","+  have h1 := r1_read3 hwf hnd hfl hR h hstat hdec","+  obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h","+  refine ⟨?_, by rw [exec_readOps]; exact hR⟩","+  have : ∀ ls', (∀ l ∈ ls', l ∈ ls) → AllOk C ObR ObW s2 (readOps s2 L ls') := fun ls' => by","+    induction ls' with","+    | nil => exact fun _ => trivial","+    | cons l ls' ih =>","+      intro hs","+      obtain ⟨al, -, -, hok, -⟩ := h1 l (hs l (List.mem_cons_self ..))","+      exact ⟨⟨_, hok⟩, ih fun l' hl' => hs l' (List.mem_cons_of_mem _ hl')⟩","+  exact this ls fun _ h => h","+","+/-- R6 for `alloc` of outcome `ok` (MM-03.3 §9.2, O14; K4: `alloc` `ok` ↦ `AllocStep`): for a","+shape with one root (O14: \"une nouvelle racine\"), the allocation of MM-02, at the base chosen by","+the placement, has the outcome `ok`, and the arrival states are in `Repr`, for every geometry of","+valid alignment, every token `fa` and every layout of the new leaves in the fresh allocation","+(`NewLayout`). -/","+theorem r6_alloc {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}","+    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}","+    {fa : Option Nat} {i : Nat} (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2)","+    (hpl : PlacementOK pl) (hg : 0 < (g i).align ∧ MM02.Pow2 (g i).align)","+    (h : MM03.AllocStep k pr ow ls s3 (.ok s3')) (hone : rootIdx ls = [i])","+    (hNL : NewLayout L s3'.P s3.P.length s2.next g [i]) :","+    AllOk C ObR ObW s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] ∧","+      Repr tok L s3' (exec s2 [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa]) := by","+  cases h with","+  | ok hst _ =>","+    have e : allocOps pl g fa s2 [i] = [.alloc (g i).space (pl s2 (g i)) (g i).size (g i).align fa] :=","+      rfl","+    rw [← e, ← hone]","+    refine ⟨allocOps_ok hpl _ _ hwf2 (by rw [hone]; intro j hj; rw [List.mem_singleton.1 hj]; exact hg),","+      repr_extend (hd := .place ow) hR hwf2 rfl hst.2.2.2.2.2.1","+        (fun q hq hu => alloc_usable_back hwf hu hq) (fun _ _ hu => alloc_usable_old hu)","+        (fun i hi => alloc_usable_new hst (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)","+        (fun l hl => ?_) (fun _ _ _ _ h => h) (fun _ h => by cases h) (by rw [hone]; exact hNL)⟩","+    simp only [allocEff] at hl","+    split at hl","+    · cases hl","+    · rename_i hn","+      refine ⟨by omega, ?_⟩","+      split at hl","+      · exact hst.2.2.2.2.1 l ‹_›","+      · exact hl","+","+/-- R6 for `alloc` of outcome `fail` (MM-03.3 §9.2, O14; K4: `alloc` `fail` ↦ no step): the state","+is unchanged and stays in `Repr`. -/","+theorem r6_alloc_fail {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {pr ow : Nat}","+    {ls : List (Option Nat × Option Nat × Nat)} (hR : Repr tok L s3 s2)","+    (h : MM03.AllocStep k pr ow ls s3 (.fail s3')) :","+    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by","+  obtain ⟨rfl, -⟩ := alloc_fail_unchanged h; exact ⟨trivial, hR⟩","+","+/-- R6 for `free` (MM-03.3 §9.2, O13; K4: `free` ↦ `DeallocStep` of the allocation of the root,","+authority `auth`, compatible by `FreeCompat`): under `WF3` and the obligation `FreeSound` of the","+contracts, the deallocation has the outcome `ok` and the arrival states are in `Repr`. -/","+theorem r6_free {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {p auth : Nat}","+    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hfs : FreeSound k C L s3 s2)","+    (h : FreeStep k p auth s3 (.ok s3')) :","+    AllOk C ObR ObW s2 (deallocOps [rootAlloc L s3.P p] auth) ∧","+      Repr tok L s3' (exec s2 (deallocOps [rootAlloc L s3.P p] auth)) := by","+  obtain ⟨⟨hdl, hfc, hu, hor, -⟩, rfl⟩ := Guarded.ok_iff.1 h","+  have hpr : RootPlace s3.P p := by","+    refine ⟨hu.lt, ?_⟩","+    unfold OwnedRoot at hor; unfold parentOf","+    cases hpl : s3.P[p]? with","+    | none => rw [hpl] at hor; exact hor.elim","+    | some pl => rw [hpl] at hor; exact hor.1","+  have hl0 := headD_mem_footprint hwf hpr.1","+  have hnu : ¬ (freeEff s3 p).Usable p := fun h' => by","+    have := h'.dead_false","+    simp [freeEff, cleanup, freeS, partOf, hpr.1] at this","+  have hne : ∀ r, (freeEff s3 p).Usable r → r ≠ p := fun r h' e => hnu (e ▸ h')","+  have hUb : ∀ r, (freeEff s3 p).Usable r → s3.Usable r := fun r h' =>","+    S3.Usable.mono rfl (fun _ h => h) (fun q hq => by","+      simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff] at hq; exact hq.1) h'","+  have hdiff : ∀ r, RootPlace s3.P r → r ≠ p → ∀ l ∈ footprint s3.P r,","+      (L l).alloc ∉ [rootAlloc L s3.P p] := fun r hr hrp l hl hm => by","+    rw [List.mem_singleton] at hm","+    exact hR.inj r hr.1 p hpr.1 hr hpr hrp l hl _ hl0 hm","+  refine ⟨deallocOps_ok _ _ (List.pairwise_singleton _ _) fun i hi => ?_, ?_⟩","+  · rw [List.mem_singleton.1 hi]","+    exact (hR.live p hpr.1 hpr hu _ hl0).and (hfs p auth hdl hfc _ hl0)","+  · refine repr_deallocs hR _ _ rfl (fun _ h => h) (fun r _ hrt hu' => ⟨hUb r hu',","+      hdiff r hrt (hne r hu')⟩) (fun r _ hrt hf => ?_) (fun _ _ _ h => .inl h)","+      (fun r _ hrt _ hf _ => ?_)","+    · simp only [freeEff, cleanup, freeS, Bool.or_eq_true, decide_eq_true_eq] at hf","+      rcases hf with hf | rfl","+      · exact .inl hf","+      · exact .inr fun l hl => List.mem_singleton.2 (rootAlloc_eq hwf hR.lwf hpr hl)","+    · simp only [freeEff, cleanup, freeS, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hf","+      exact ⟨.inr hf.1, hdiff r hrt hf.2⟩","+","+/-- R6 for `enterFrame` (MM-03.3 §9.2, O6; K4: `enterFrame` ↦ one `AllocStep` per root local):","+under `WF3`, the allocations of the root locals, with the token of the new frame (K2), at the bases","+chosen by the placement, have the outcome `ok`, and the arrival states are in `Repr`, for every","+geometry of valid alignment and every layout of the new leaves (`NewLayout`). -/","+theorem r6_enter {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {ps : List Nat}","+    {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}","+    (hwf : WF3 s3) (hR : Repr tok L s3 s2) (hwf2 : MM02.WF s2) (hpl : PlacementOK pl)","+    (hg : ∀ i ∈ rootIdx ls, 0 < (g i).align ∧ MM02.Pow2 (g i).align)","+    (h : EnterStep ps ls s3 (.ok s3')) (hNL : NewLayout L s3'.P s3.P.length s2.next g (rootIdx ls)) :","+    AllOk C ObR ObW s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls)) ∧","+      Repr tok L s3' (exec s2 (allocOps pl g (some (tok s3.nF)) s2 (rootIdx ls))) := by","+  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+  refine ⟨allocOps_ok hpl _ _ hwf2 hg, repr_extend (hd := .frame s3.nF) hR hwf2 rfl","+    (enterPre_shapeOK hpre.1) (fun q hq hu => enter_usable_back hwf hu hq)","+    (fun _ _ hu => enter_usable_old hu)","+    (fun i hi => enter_usable_new hpre.1 (i + 1) i (Nat.lt_succ_self i) hi) (fun _ => rfl)","+    (fun l hl => ?_) (fun q _ pl _ hg => ?_) (fun f e => by cases e; rfl) hNL⟩","+  · simp only [enterEff] at hl","+    split at hl","+    · cases hl","+    · exact ⟨by omega, hl⟩","+  · cases ho : pl.owner with","+    | place _ => rw [ho] at hg; exact hg","+    | frame f => rw [ho] at hg; exact fun h => hg (List.mem_cons_of_mem _ h)","+","+/-- K4 (`exitFrame`): the root places owned by the frame `f`, the roots of its automatic","+allocations. -/","+def frameRoots (s3 : S3) (f : Nat) : List Nat :=","+  (List.range s3.P.length).filter fun r =>","+    decide (RootPlace s3.P r) && decide (OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False)","+","+theorem mem_frameRoots {s3 : S3} {f r : Nat} :","+    r ∈ frameRoots s3 f ↔ RootPlace s3.P r ∧ OptP (s3.P[r]?) (fun pl => pl.owner = .frame f) False := by","+  simp only [frameRoots, List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq]","+  exact ⟨fun h => h.2, fun h => ⟨h.1.1, h.1, h.2⟩⟩","+","+/-- K4 (`exitFrame` ↦ one `DeallocStep` per automatic allocation of the frame, none for the owned","+storage that dies with it): the deallocations of the allocations of the root places owned by the","+current frame, with its token (K2). -/","+def exitOps (L : Layout) (tok : Nat → Nat) (s3 : S3) : List Op2 :=","+  deallocOps ((frameRoots s3 s3.top).map (rootAlloc L s3.P)) (tok s3.top)","+","+/-- R6 for `exitFrame` (MM-03.3 §9.2, O7; K4): under `WF3`, `FrameOwnedLive` and the compatibility","+of the frame tokens (K2), the deallocations of the automatic allocations of the exited frame have","+the outcome `ok`, and the arrival states are in `Repr`: owned storage that dies with the frame","+keeps its allocation live (leak). -/","+theorem r6_exit {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} (hwf : WF3 s3)","+    (hfo : FrameOwnedLive s3) (hR : Repr tok L s3 s2) (htc : TokCompat C tok)","+    (h : ExitStep k s3 (.ok s3')) :","+    AllOk C ObR ObW s2 (exitOps L tok s3) ∧ Repr tok L s3' (exec s2 (exitOps L tok s3)) := by","+  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+  obtain ⟨f, F₀, hF⟩ : ∃ f F₀, s3.F = f :: F₀ := by","+    unfold ExitPre at hpre; split at hpre","+    · exact ⟨_, _, ‹_›⟩","+    · exact hpre.elim","+  have htop : s3.top = f := by simp [S3.top, hF]","+  have hfF₀ : f ∉ F₀ := by have := hwf.nodup; rw [hF] at this; exact (List.nodup_cons.1 this).1","+  have e := exitEff_eq hF","+  have hhead : ∀ r ∈ frameRoots s3 f, (footprint s3.P r).headD r ∈ footprint s3.P r := fun r hr =>","+    headD_mem_footprint hwf (mem_frameRoots.1 hr).1.1","+  -- the allocations of two distinct roots differ","+  have hinj : ∀ r r', RootPlace s3.P r → RootPlace s3.P r' → r ≠ r' → ∀ l ∈ footprint s3.P r,","+      (L l).alloc ≠ rootAlloc L s3.P r' := fun r r' hr hr' hne l hl =>","+    hR.inj r hr.1 r' hr'.1 hr hr' hne l hl _ (headD_mem_footprint hwf hr'.1)","+  -- a root owned by the frame `f` is not another root","+  have hnotin : ∀ r, RootPlace s3.P r → r ∉ frameRoots s3 f → ∀ l ∈ footprint s3.P r,","+      (L l).alloc ∉ (frameRoots s3 f).map (rootAlloc L s3.P) := fun r hr hn l hl hm => by","+    obtain ⟨r', hr', he⟩ := List.mem_map.1 hm","+    exact hinj r r' hr (mem_frameRoots.1 hr').1 (fun e => hn (e ▸ hr')) l hl he.symm","+  have howner : ∀ r, r ∈ frameRoots s3 f → ∃ pl, s3.P[r]? = some pl ∧ pl.owner = .frame f :=","+    fun r hr => by","+      have := (mem_frameRoots.1 hr).2","+      unfold OptP at this; split at this","+      · exact ⟨_, ‹_›, this⟩","+      · exact this.elim","+  unfold exitOps; rw [htop]","+  refine ⟨deallocOps_ok _ _ ?_ fun i hi => ?_, ?_⟩","+  · refine List.pairwise_map.2 (((pairwise_lt_range _).filter _).imp_of_mem","+      fun ha hb hlt => ?_)","+    exact hinj _ _ (mem_frameRoots.1 ha).1 (mem_frameRoots.1 hb).1 (Nat.ne_of_lt hlt) _ (hhead _ ha)","+  · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hi","+    obtain ⟨pl, hpl, ho⟩ := howner r hr","+    have hrt := (mem_frameRoots.1 hr).1","+    have hu : s3.Usable r := .frame hpl (hfo r pl f hpl ho) ho (by rw [hF]; exact List.mem_cons_self ..)","+    have ht := hR.tokens r hrt.1 hrt","+    rw [hpl] at ht; simp only [OptP] at ht; rw [ho] at ht","+    exact ((hR.live r hrt.1 hrt hu _ (hhead r hr)).and (ht _ (hhead r hr))).mono","+      fun a ⟨h1, h2⟩ => ⟨h1, _, h2, htc f⟩","+  · refine repr_deallocs hR _ _ (by rw [e]) (fun _ h => by rw [e] at h; exact h)","+      (fun r _ hrt hu => ?_) (fun r _ _ hf => .inl (by rw [e] at hf; exact hf))","+      (fun r _ hrt hg => ?_) (fun r _ hrt hu hf ho => ?_)","+    · have hu' : ({ s3 with F := F₀ } : S3).Usable r :=","+        (S3.Usable.congr (s := ({ s3 with F := F₀ } : S3)) (by rw [e]) (by rw [e]) (by rw [e])).1 hu","+      refine ⟨S3.Usable.mono rfl (fun g hg => by rw [hF]; exact List.mem_cons_of_mem _ hg)","+        (fun _ h => h) hu', hnotin r hrt fun hm => ?_⟩","+      obtain ⟨pl, hpl, ho⟩ := howner r hm","+      cases hu' with","+      | frame hpl' _ ho' hf' => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'; exact hfF₀ hf'","+      | place hpl' _ ho' _ => rw [hpl] at hpl'; cases hpl'; rw [ho] at ho'; cases ho'","+    · rw [e] at hg","+      cases hpl : s3.P[r]? with","+      | none => rw [hpl] at hg; exact hg.elim","+      | some pl =>","+        rw [hpl] at hg; simp only [OptP] at hg ⊢","+        cases ho : pl.owner with","+        | place _ => rw [ho] at hg; exact hg.elim","+        | frame g =>","+          rw [ho] at hg; simp only [FrameGone] at hg ⊢","+          by_cases hgf : g = f","+          · subst hgf","+            refine .inr fun l hl => List.mem_map.2 ⟨r, mem_frameRoots.2 ⟨hrt, ?_⟩,","+              (rootAlloc_eq hwf hR.lwf hrt hl).symm⟩","+            rw [hpl]; exact ho","+          · exact .inl fun hm => by rw [hF] at hm; exact (List.mem_cons.1 hm).elim hgf hg","+    · refine ⟨.inr (by rw [e] at hf; exact hf), hnotin r hrt fun hm => ?_⟩","+      obtain ⟨pl, hpl, ho'⟩ := howner r hm","+      rw [hpl] at ho; simp only [OptP] at ho; rw [ho'] at ho; cases ho","+","+/-- K4: the `ok` steps of MM-03 to which no MM-02 step corresponds: `derive`, `split`, `release`,","+`depend`, `endUse`, `pin`, `unpin`, `newArena`, `reset`. -/","+inductive NoStep (k : K) : S3 → S3 → Prop where","+  | derive {s s' : S3} {src q : Nat} {m : Mode} : DeriveStep src q m s (.ok s') → NoStep k s s'","+  | split {s s' : S3} {src : Nat} {rs : List (List Nat)} :","+      SplitStep k src rs s (.ok s') → NoStep k s s'","+  | release {s s' : S3} {a : Nat} : ReleaseStep a s (.ok s') → NoStep k s s'","+  | depend {s s' : S3} {q x : Nat} : DependStep q x s (.ok s') → NoStep k s s'","+  | endUse {s s' : S3} {p : Nat} : EndUseStep k p s (.ok s') → NoStep k s s'","+  | pin {s s' : S3} {p : Nat} : PinStep p s (.ok s') → NoStep k s s'","+  | unpin {s s' : S3} {p : Nat} : UnpinStep k p s (.ok s') → NoStep k s s'","+  | newArena {s s' : S3} {st i : Nat} : NewArenaStep st i s (.ok s') → NoStep k s s'","+  | reset {s s' : S3} {i via : Nat} : ResetAtStep k i via s (.ok s') → NoStep k s s'","+","+/-- R6 for the steps without MM-02 step (MM-03.3 §9.2; K4): the empty sequence, and the arrival","+states are in `Repr`. -/","+theorem r6_noStep {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {tok : Nat → Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State}","+    (hR : Repr tok L s3 s2) (h : NoStep k s3 s3') :","+    AllOk C ObR ObW s2 [] ∧ Repr tok L s3' (exec s2 []) := by","+  refine ⟨trivial, ?_⟩","+  have same : ∀ {s' : S3}, s'.P = s3.P → s'.F = s3.F → s'.dead = s3.dead → s'.freed = s3.freed →","+      s'.I = s3.I → Repr tok L s' s2 := fun hP hF hd hfr hI =>","+    hR.shrink hP hF hfr (fun _ h => h.of_eqs hP hF hd) (fun _ h => by rw [← hI]; exact h)","+  cases h with","+  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl","+  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl","+  | release hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    unfold releaseEff; split <;> exact same rfl rfl rfl rfl rfl","+  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl","+  | endUse hs =>","+    rename_i p","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    refine hR.shrink rfl rfl rfl (fun q hq => S3.Usable.mono rfl (fun _ h => h) (fun q' hq' => ?_) hq)","+      (fun l hl => ?_)","+    · simp only [endUseEff, cleanup, endUseS, Bool.or_eq_false_iff] at hq'; exact hq'.1","+    · simp only [endUseEff, cleanup, endUseS] at hl; split at hl","+      · cases hl","+      · exact hl","+  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl","+  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl","+  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact same rfl rfl rfl rfl rfl","+  | reset hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    unfold resetAtEff; split","+    · exact same rfl rfl rfl rfl rfl","+    · exact same rfl rfl rfl rfl rfl","+"," /-! ## Smoke test -/"," "," namespace Smoke"]}],"userModified":false,"replaceAll":false,"staleRecovered":true,"contentNotInModelContext":true},"sourceToolAssistantUUID":"962a4030-10b3-4436-a88e-22abb2daa08b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7