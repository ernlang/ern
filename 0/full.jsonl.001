s accepted (the cell 2 is not returned). In `opsE8` the authority 9 covers","+the cell 3 of a region issued after `⟨0, 0, 0⟩`, now above the top, and `rewind` is accepted (the","+cell 3 is already available). In `opsE3` the empty block 6, issued after the mark and active, does","+not block `rewind`, and stays active once the metadata forget it. -/","+theorem case_rewind_reading :","+    (drun K0 DS.init opsE4).isSome = true ∧","+    (final opsE4).s.A[8]?.map (fun y => (y.active, y.origin, y.footprint)) = some (true, some 5, [2]) ∧","+    (dexec K0 (final opsE4) (.rewind 0 ⟨0, 0, 2⟩)).isOk = true ∧","+    (drun K0 DS.init opsE8).isSome = true ∧","+    (final opsE8).s.A[9]?.map (fun y => (y.active, y.origin, y.footprint)) = some (true, some 5, [3]) ∧","+    (dexec K0 (final opsE8) (.rewind 0 ⟨0, 0, 0⟩)).isOk = true ∧","+    (drun K0 DS.init (opsE3 ++ [.rewind 0 ⟨0, 0, 0⟩])).isSome = true ∧","+    (final (opsE3 ++ [.rewind 0 ⟨0, 0, 0⟩])).s.A[6]?.map (fun y => (y.active, y.origin, y.footprint)) =","+      some (true, some 5, []) := by","+  decide","+","+/-- Block 6 pushed into 5, then a callee entered with only 7, a `Modify` derived from the root of 5:","+it has no right on the stack value 0. -/","+def opsZ : List DOp := setup1 ++ [.push 0 1 5, .kernel (.derive 2 5 .modify), .kernel (.enter [7] [])]","+","+/-- **Static clauses before `fail`** (§58, §77.4; review, DS-5 and Q2-GROW-ORDER): without a right on","+the stack value, `grow` is rejected with or without room; `push` into an `Init` destination is","+rejected; `push` into a destination inside the requested cells is rejected even without room, while","+the same `push` into an outside destination fails. -/","+theorem case_static_before_fail :","+    (drun K0 DS.init opsZ).isSome = true ∧","+    (dexec K0 (final opsZ) (.grow 0 6 5)).isReject = true ∧","+    (dexec K0 (final opsZ) (.grow 0 6 1)).isReject = true ∧","+    (drun K0 DS.init (setup1 ++ [.kernel (.write 2 [5])])).isSome = true ∧","+    (dexec K0 (final (setup1 ++ [.kernel (.write 2 [5])])) (.push 0 1 5)).isReject = true ∧","+    (drun K0 DS.init setup1).isSome = true ∧","+    (dexec K0 (final setup1) (.push 0 4 2)).isReject = true ∧","+    (dexec K0 (final setup1) (.push 0 4 5)).isFail = true := by","+  decide","+"," /-- The kernel states of the cases are reached. -/"," theorem cases_reachable :","     Reachable K0 [] (final opsR).s ∧ Reachable K0 [] (final opsA).s ∧"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Lib/DataStack.lean"]}},"serverClassifierContext":{"request":"500e556e-bb2b-4f0c-a0de-f1fdcabae3fe","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/derivability_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"c7ebfc60-1222-4d0d-9e5d-969cf157ea01","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/derivability_0.1","slug":"effervescent-gathering-wind"}
