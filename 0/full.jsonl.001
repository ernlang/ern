rfl | hb","+    · exact .inl rfl","+    · exact .inr (mem_set_of_ne h hb hne)","+","+theorem mem_set_cases {α : Type} : ∀ {l : List α} {i : Nat} {x b : α}, b ∈ l.set i x →","+    b ∈ l ∨ b = x","+  | [], _, _, _, h => by simp at h","+  | c :: l, 0, x, b, h => by","+    simp only [List.set_cons_zero, List.mem_cons] at h","+    rcases h with rfl | h","+    · exact .inr rfl","+    · exact .inl (List.mem_cons_of_mem _ h)","+  | c :: l, i + 1, x, b, h => by","+    simp only [List.set_cons_succ, List.mem_cons] at h","+    rcases h with rfl | h","+    · exact .inl (List.mem_cons_self ..)","+    · rcases mem_set_cases h with h | h","+      · exact .inl (List.mem_cons_of_mem _ h)","+      · exact .inr h","+","+theorem getElem?_set_eq' {α : Type} : ∀ {l : List α} {i : Nat} {a x : α}, l[i]? = some a →","+    (l.set i x)[i]? = some x","+  | [], _, _, _, h => by simp at h","+  | _ :: _, 0, _, _, _ => by simp","+  | _ :: l, i + 1, a, x, h => by","+    simp only [List.getElem?_cons_succ] at h","+    simp only [List.set_cons_succ, List.getElem?_cons_succ]; exact getElem?_set_eq' h","+","+theorem getElem?_set_ne' {α : Type} : ∀ {l : List α} {i n : Nat} {x : α}, n ≠ i →","+    (l.set i x)[n]? = l[n]?","+  | [], _, _, _, _ => by simp","+  | _ :: _, 0, 0, _, h => absurd rfl h","+  | _ :: _, 0, _ + 1, _, _ => by simp","+  | _ :: _, _ + 1, 0, _, _ => by simp","+  | _ :: l, i + 1, n + 1, x, h => by","+    simp only [List.set_cons_succ, List.getElem?_cons_succ]","+    exact getElem?_set_ne' (l := l) (fun e => h (by rw [e]))","+","+theorem map_set_same {α β : Type} (f : α → β) : ∀ {l : List α} {i : Nat} {a x : α},","+    l[i]? = some a → f x = f a → (l.set i x).map f = l.map f","+  | [], _, _, _, h, _ => by simp at h","+  | b :: l, 0, a, x, h, hf => by","+    simp only [List.getElem?_cons_zero, Option.some.injEq] at h; subst h","+    simp [hf]","+  | b :: l, i + 1, a, x, h, hf => by","+    simp only [List.getElem?_cons_succ] at h","+    simp only [List.set_cons_succ, List.map_cons, map_set_same f h hf]","+","+theorem eq_of_id_eq : ∀ {l : List Pool} {a b : Pool}, (l.map (·.id)).Nodup → a ∈ l → b ∈ l →","+    a.id = b.id → a = b","+  | [], _, _, _, ha, _, _ => by simp at ha","+  | c :: l, a, b, hn, ha, hb, he => by","+    rw [List.map_cons, List.nodup_cons] at hn","+    rcases List.mem_cons.1 ha with rfl | ha <;> rcases List.mem_cons.1 hb with rfl | hb","+    · rfl","+    · exact absurd (he ▸ List.mem_map_of_mem (f := (·.id)) hb) hn.1","+    · exact absurd (he.symm ▸ List.mem_map_of_mem (f := (·.id)) ha) hn.1","+    · exact eq_of_id_eq hn.2 ha hb he","+","+theorem firstFreeF_spec : ∀ {i n : Nat} {l : List Slot}, firstFreeF i l = some n →","+    i ≤ n ∧ ∃ sl, l[n - i]? = some sl ∧ sl.live = false","+  | _, _, [], h => by simp [firstFreeF] at h","+  | i, n, sl :: l, h => by","+    simp only [firstFreeF] at h","+    split at h","+    · obtain ⟨h1, sl', h2, h3⟩ := firstFreeF_spec h","+      refine ⟨by omega, sl', ?_, h3⟩","+      rw [show n - i = (n - (i + 1)) + 1 by omega]; simpa using h2","+    · rename_i hl","+      simp only [Option.some.injEq] at h; subst h","+      exact ⟨Nat.le_refl _, sl, by simp, by simpa using hl⟩","+","+/-- The entry chosen by `allocSlot` is free. -/","+theorem firstFree_free {pl : Pool} {i : Nat} {sl : Slot} (h : firstFree pl = some i)","+    (hs : pl.slots[i]? = some sl) : sl.live = false := by","+  obtain ⟨-, sl', h1, h2⟩ := firstFreeF_spec h","+  rw [Nat.sub_zero, hs] at h1; cases h1; exact h2","+","+theorem mem_batchEntries : ∀ {n : Nat} {hs : List Handle} {e : Nat × Nat × Nat},","+    e ∈ batchEntries n hs → ∃ h ∈ hs, e.2.1 = h.slot ∧ e.2.2 = h.gen","+  | _, [], _, he => by simp [batchEntries, mapI] at he","+  | n, h :: hs, e, he => by","+    simp only [batchEntries, mapI, List.mem_cons] at he","+    rcases he with rfl | he","+    · exact ⟨h, List.mem_cons_self .., rfl, rfl⟩","+    · obtain ⟨h', hh', e1, e2⟩ := mem_batchEntries (n := n + 1) he","+      exact ⟨h', List.mem_cons_of_mem _ hh', e1, e2⟩","+","+/-! ## Invariants of the pool layer -/","+","+/-- Identity, storage, `internal` and entry places of a pool: what `allocSlot` and `freeSlot`","+keep. -/","+def Pool.shape (pl : Pool) : Nat × Nat × Nat × List Nat :=","+  (pl.id, pl.storage, pl.internal, pl.slots.map (·.place))","+","+theorem setSlot_shape {pl : Pool} {i : Nat} {sl x : Slot} (hs : pl.slots[i]? = some sl)","+    (hx : x.place = sl.place) : (setSlot pl i x).shape = pl.shape := by","+  simp only [Pool.shape, setSlot, map_set_same (·.place) hs hx]","+","+theorem shape_mem {l l' : List Pool} (h : l'.map Pool.shape = l.map Pool.shape) {pl : Pool}","+    (hpl : pl ∈ l) : ∃ pl' ∈ l', pl'.shape = pl.shape := by","+  have : pl.shape ∈ l'.map Pool.shape := h ▸ List.mem_map_of_mem hpl","+  obtain ⟨pl', h1, h2⟩ := List.mem_map.1 this","+  exact ⟨pl', h1, h2⟩","+","+theorem shape_ids {l l' : List Pool} (h : l'.map Pool.shape = l.map Pool.shape) :","+    l'.map (·.id) = l.map (·.id) := by","+  have := congrArg (List.map Prod.fst) h","+  simpa [List.map_map, Function.comp_def, Pool.shape] using this","+","+theorem shape_slot {pl pl' : Pool} (h : pl'.shape = pl.shape) {n : Nat} {sl : Slot}","+    (hs : pl.slots[n]? = some sl) : ∃ sl', pl'.slots[n]? = some sl' ∧ sl'.place = sl.place := by","+  have h4 : pl'.slots.map (·.place) = pl.slots.map (·.place) := by","+    simp only [Pool.shape, Prod.mk.injEq] at h; exact h.2.2.2","+  have := congrArg (·[n]?) h4","+  simp only [List.getElem?_map, hs, Option.map_some] at this","+  cases h' : pl'.slots[n]? with","+  | none => rw [h'] at this; cases this","+  | some sl' => rw [h'] at this; exact ⟨sl', rfl, Option.some.inj this⟩","+","+theorem shape_place {pl pl' : Pool} (h : pl'.shape = pl.shape) {sl' : Slot} (hs : sl' ∈ pl'.slots) :","+    ∃ sl ∈ pl.slots, sl.place = sl'.place := by","+  have h4 : pl'.slots.map (·.place) = pl.slots.map (·.place) := by","+    simp only [Pool.shape, Prod.mk.injEq] at h; exact h.2.2.2","+  have : sl'.place ∈ pl.slots.map (·.place) := h4 ▸ List.mem_map_of_mem hs","+  obtain ⟨sl, h1, h2⟩ := List.mem_map.1 this","+  exact ⟨sl, h1, h2⟩","+","+/-- Ghost well-formedness of the pool layer, kept by every step (`pReach_inv`): pool identities","+fresh and distinct (material §4); `internal` a `Modify` authority (F1, through `newArena`); storage","+and entries existing places; each resolution of an existing pool, with a companion created after","+`internal`, of the mode of the resolution, on the footprint of the storage, and entry authorities","+on the footprint of their entry, still derived while active. -/","+def PoolWF (ps : PS) : Prop :=","+  (∀ pl ∈ ps.pools, pl.id < ps.nId) ∧ (ps.pools.map (·.id)).Nodup ∧","+  (∀ pl ∈ ps.pools, OptP (ps.s.A[pl.internal]?) (fun y => y.mode = .modify) False ∧","+    pl.storage < ps.s.P.length ∧ ∀ sl ∈ pl.slots, sl.place < ps.s.P.length) ∧","+  ∀ r ∈ ps.res, ∃ pl ∈ ps.pools, pl.id = r.pool ∧ pl.internal = r.internal ∧","+    r.internal < r.comp ∧","+    OptP (ps.s.A[r.comp]?) (fun y => y.mode = r.mode ∧","+      ∀ l, l ∈ y.footprint ↔ l ∈ footprint ps.s.P pl.storage) False ∧","+    ∀ e ∈ r.entries, ∃ sl, pl.slots[e.2.1]? = some sl ∧","+      OptP (ps.s.A[e.1]?) (fun y => (∀ l, l ∈ y.footprint ↔ l ∈ footprint ps.s.P sl.place) ∧","+        (y.active = true → y.origin ≠ none)) False","+","+/-- `pool_no_stale_access` as a state predicate (material §4, `PoolInv` second clause for the entry","+authorities): an active entry authority carries the current generation of its entry, which is","+live. -/","+def NoStale (ps : PS) : Prop :=","+  ∀ r ∈ ps.res, ∀ e ∈ r.entries, ps.s.Active e.1 → ∃ pl ∈ ps.pools, pl.id = r.pool ∧","+    ∃ sl, pl.slots[e.2.1]? = some sl ∧ sl.gen = e.2.2 ∧ sl.live = true","+","+/-- Exclusivity of the companions (material §4, `pool_resolve_modify_exclusive`): two distinct","+active companions of a pool are both `Observe`. -/","+def CompExcl (ps : PS) : Prop :=","+  ∀ r₁ ∈ ps.res, ∀ r₂ ∈ ps.res, r₁.pool = r₂.pool → r₁.comp ≠ r₂.comp →","+    ps.s.Active r₁.comp → ps.s.Active r₂.comp → r₁.mode = .observe ∧ r₂.mode = .observe","+","+/-- `PoolWF` carries over a change of the kernel state that keeps authorities and footprints and a","+change of pools that keeps their shape. -/","+theorem PoolWF.transport {ps : PS} {s' : S3} {pools' : List Pool} (h : PoolWF ps)","+    (hk : KeepsAuth ps.s s') (hf : FpStable ps.s s')","+    (hp : pools'.map Pool.shape = ps.pools.map Pool.shape) :","+    PoolWF ⟨s', pools', ps.nId, ps.res⟩ := by","+  obtain ⟨h1, h2, h3, h4⟩ := h","+  refine ⟨fun pl' hpl' => ?_, by rw [shape_ids hp]; exact h2, fun pl' hpl' => ?_, fun r hr => ?_⟩","+  · obtain ⟨pl, hpl, e⟩ := shape_mem hp.symm hpl'","+    have := h1 pl hpl","+    simp only [Pool.shape, Prod.mk.injEq] at e; rw [e.1]; exact this","+  · obtain ⟨pl, hpl, e⟩ := shape_mem hp.symm hpl'","+    obtain ⟨hi, hst, hsl⟩ := h3 pl hpl","+    have e' := e; simp only [Pool.shape, Prod.mk.injEq] at e'","+    obtain ⟨y, hy, hm⟩ := optP_false_iff.1 hi","+    obtain ⟨y', hy', hm', -⟩ := hk.get hy","+    refine ⟨optP_false_iff.2 ⟨y', by rw [e'.2.2.1]; exact hy', hm'.trans hm⟩,","+      Nat.lt_of_lt_of_le (e'.2.1 ▸ hst) hf.1, fun sl' hsl' => ?_⟩","+    obtain ⟨sl, hs, hp'⟩ := shape_place e hsl'","+    exact Nat.lt_of_lt_of_le (hp' ▸ hsl sl hs) hf.1","+  · obtain ⟨pl, hpl, hid, hint, hlt, hc, he⟩ := h4 r hr","+    obtain ⟨pl', hpl', e⟩ := shape_mem hp hpl","+    have e' := e; simp only [Pool.shape, Prod.mk.injEq] at e'","+    obtain ⟨-, hst, hsl⟩ := h3 pl hpl","+    refine ⟨pl', hpl', e'.1.trans hid, e'.2.2.1.trans hint, hlt, ?_, fun en hen => ?_⟩","+    · obtain ⟨y, hy, hm, hfp⟩ := optP_false_iff.1 hc","+      obtain ⟨y', hy', hm', hf', -⟩ := hk.get hy","+      refine optP_false_iff.2 ⟨y', hy', hm'.trans hm, fun l => ?_⟩","+      rw [hf', e'.2.1]; exact (hfp l).trans (hf.2 _ hst l).symm","+    · obtain ⟨sl, hs, ho⟩ := he en hen","+      obtain ⟨sl', hs', hpl''⟩ := shape_slot e hs","+      obtain ⟨y, hy, hfp, hor⟩ := optP_false_iff.1 ho","+      obtain ⟨y', hy', -, hf', ha⟩ := hk.get hy","+      refine ⟨sl', hs', optP_false_iff.2 ⟨y', hy', fun l => ?_, fun hya => ?_⟩⟩","+      · rw [hf', hpl'']","+        exact (hfp l).trans (hf.2 _ (hsl sl (List.mem_of_getElem? hs)) l).symm","+      · exact (ha hya).2 (hor (ha hya).1)","+","+theorem NoStale.transport {ps : PS} {s' : S3} (h : NoStale ps) (hw : PoolWF ps)","+    (hk : KeepsAuth ps.s s') : NoStale { ps with s := s' } := by","+  intro r hr e he ha","+  obtain ⟨pl, -, -, -, -, -, hen⟩ := hw.2.2.2 r hr","+  obtain ⟨-, -, ho⟩ := hen e he","+  obtain ⟨y, hy, -⟩ := optP_false_iff.1 ho","+  exact h r hr e he (hk.active (lt_of_getElem? hy) ha)","+","+theorem CompExcl.transport {ps : PS} {s' : S3} (h : CompExcl ps) (hw : PoolWF ps)","+    (hk : KeepsAuth ps.s s') : CompExcl { ps with s := s' } := by","+  intro r₁ hr₁ r₂ hr₂ hp hne ha₁ ha₂","+  have lt : ∀ r ∈ ps.res, r.comp < ps.s.A.length := fun r hr => by","+    obtain ⟨-, -, -, -, -, hc, -⟩ := hw.2.2.2 r hr","+    obtain ⟨y, hy, -⟩ := optP_false_iff.1 hc","+    exact lt_of_getElem? hy","+  exact h r₁ hr₁ r₂ hr₂ hp hne (hk.active (lt r₁ hr₁) ha₁) (hk.active (lt r₂ hr₂) ha₂)","+"," end Ern.HandlePool"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/HandlePool.lean"]}},"serverClassifierContext":{"request":"73a47bb4-f8a6-47c7-b50f-1a5a950e3e0f","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/validation_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolA