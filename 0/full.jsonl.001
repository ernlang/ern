17-precondition; only `ok` is defined. -/\nErn/Concurrency/SyncLib.lean:318:def UnlockOk (L : MutexLayout) (s : SC) (reg : SyncReg) (c i : Nat) (st' : SC × SyncReg) :\nErn/Concurrency/SyncLib.lean-319-    Prop :=\nErn/Concurrency/SyncLib.lean-320-  s.Live c ∧ ∃ e g, reg[i]? = some e ∧ e.Live s ∧ e.grant = some g ∧ ReleasePre (s.view c) g ∧\nErn/Concurrency/SyncLib.lean-321-    CtrlRight L s e (s.view c).top ∧\nErn/Concurrency/SyncLib.lean-322-    st' = (s.set (releaseEff (s.view c) g), reg.set i { e with grant := none })\nErn/Concurrency/SyncLib.lean-323-\nErn/Concurrency/SyncLib.lean-324-/-- `resetLock` of entry `i` executed by `c` (WC4 C18.1–C18.3): the entry becomes available; the\nErn/Concurrency/SyncLib.lean-325-kernel state is unchanged (WC4 C18 effect). WC4 C18.3: \"`ControlOf(entry)` resolves to an\nErn/Concurrency/SyncLib.lean-326-existing, usable controller **leaf**, as required by C21.3\"; the controller-initialization\nErn/Concurrency/SyncLib.lean-327-invariant is not a precondition (WC4 C18.3: \"established separately for every live entry by\nErn/Concurrency/SyncLib.lean-328-C21.7\"). Only `ok` is defined. -/\nErn/Concurrency/SyncLib.lean-329-def ResetLockOk (L : MutexLayout) (s : SC) (reg : SyncReg) (c i : Nat) (st' : SC × SyncReg) :\nErn/Concurrency/SyncLib.lean-330-    Prop :=\nErn/Concurrency/SyncLib.lean-331-  s.Live c ∧ ∃ e, reg[i]? = some e ∧ (s.view c).ExercisableAt e.guarded .modify ∧\nErn/Concurrency/SyncLib.lean-332-    NoCoveringDesc s e.guarded ∧\n--\nErn/Concurrency/SyncLib.lean:406:inductive IssueStepC (k : K) (s : SC) (ar : ArenaReg) (c i : Nat) (region : List Nat)\nErn/Concurrency/SyncLib.lean-407-    (dst : Nat) : Outcome3 (SC × ArenaReg) → Prop where\nErn/Concurrency/SyncLib.lean-408-  | noEntry : s.Live c → ar[i]? = none → IssueStepC k s ar c i region dst .reject\nErn/Concurrency/SyncLib.lean-409-  | static {E : Arena.ArenaEntry} : s.Live c → ar[i]? = some E →\nErn/Concurrency/SyncLib.lean-410-      ¬ Arena.IssueStatic (s.view c) E region dst → IssueStepC k s ar c i region dst .reject\nErn/Concurrency/SyncLib.lean-411-  | fail {E : Arena.ArenaEntry} : s.Live c → ar[i]? = some E →\nErn/Concurrency/SyncLib.lean-412-      Arena.IssueStatic (s.view c) E region dst → ¬ Arena.Avail E region →\nErn/Concurrency/SyncLib.lean-413-      IssueStepC k s ar c i region dst .fail\nErn/Concurrency/SyncLib.lean-414-  | split {E : Arena.ArenaEntry} : ar[i]? = some E → Arena.IssueStatic (s.view c) E region dst →\nErn/Concurrency/SyncLib.lean-415-      Arena.Avail E region → opStepC k (.split E.internal [region]) c s .reject →\nErn/Concurrency/SyncLib.lean-416-      IssueStepC k s ar c i region dst .reject\nErn/Concurrency/SyncLib.lean-417-  | store {E : Arena.ArenaEntry} {s₁ : SC} : ar[i]? = some E →\nErn/Concurrency/SyncLib.lean-418-      Arena.IssueStatic (s.view c) E region dst → Arena.Avail E region →\nErn/Concurrency/SyncLib.lean-419-      opStepC k (.split E.internal [region]) c s (.ok s₁) →\nErn/Concurrency/SyncLib.lean-420-      opStepC k (.store s.A.length dst) c s₁ .reject → IssueStepC k s ar c i region dst .reject","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"fc300026-1e67-43ed-b024-b8c76084967a","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"656c186b-7b10-416c-92c2-9abae2391129"