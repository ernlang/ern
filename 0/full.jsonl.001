sive hI1 hab ha","   · exact absurd (hlw.disjoint l hl l' hl' hlf hlf' e hsame) hover"," ","+/-! ## Simulation (step 5 of the task) -/","+","+/-- An operation of MM-03 with its arguments (MM-03.3 §3–6), the bytes written by `write3` and","+`writeShared` included: they are data of the program, not a choice of the refinement. -/","+inductive Op3 where","+  | derive (src q : Nat) (m : Mode)","+  | split (src : Nat) (rs : List (List Nat))","+  | release (a : Nat)","+  | transfer (src dst : Nat)","+  | depend (q x : Nat)","+  | enter (ps : List Nat) (ls : List (Option Nat × Option Nat × Nat))","+  | exit","+  | read (a : Nat) (ls : List Nat)","+  | write (a : Nat) (ls : List Nat) (w : Nat → Nat → UInt8 × Option Nat)","+  | writeShared (a : Nat) (ls : List Nat) (w : Nat → Nat → UInt8 × Option Nat)","+  | pin (p : Nat)","+  | unpin (p : Nat)","+  | endUse (p : Nat)","+  | free (p auth : Nat)","+  | alloc (pr ow : Nat) (ls : List (Option Nat × Option Nat × Nat))","+  | newArena (st i : Nat)","+  | issue (i via : Nat) (region : List Nat) (dst : Nat)","+  | reset (i via : Nat)","+  | store (a p : Nat)","+","+/-- L1: the shape of an `enterFrame` has no owning element: its locals are owned by the frame. -/","+def NoOwner (ls : List (Option Nat × Option Nat × Nat)) : Prop :=","+  ∀ i < ls.length, (ls[i]?).bind (·.2.1) = none","+","+/-- An `ok` step of MM-03 labelled by its operation, within the envelope of L1 (an `enterFrame`","+whose shape has an owning element is outside the language) and L2 (the shape of `alloc` has exactly","+one root). -/","+def Step3 (k : K) : Op3 → S3 → S3 → Prop","+  | .derive src q m, s, s' => DeriveStep src q m s (.ok s')","+  | .split src rs, s, s' => SplitStep k src rs s (.ok s')","+  | .release a, s, s' => ReleaseStep a s (.ok s')","+  | .transfer src dst, s, s' => TransferStep k src dst s (.ok s')","+  | .depend q x, s, s' => DependStep q x s (.ok s')","+  | .enter ps ls, s, s' => NoOwner ls ∧ EnterStep ps ls s (.ok s')","+  | .exit, s, s' => ExitStep k s (.ok s')","+  | .read a ls, s, s' => Read3Step a ls s (.ok s')","+  | .write a ls _, s, s' => Write3Step a ls s (.ok s')","+  | .writeShared a ls _, s, s' => WriteSharedStep k a ls s (.ok s')","+  | .pin p, s, s' => PinStep p s (.ok s')","+  | .unpin p, s, s' => UnpinStep k p s (.ok s')","+  | .endUse p, s, s' => EndUseStep k p s (.ok s')","+  | .free p auth, s, s' => FreeStep k p auth s (.ok s')","+  | .alloc pr ow ls, s, s' => (∃ i, rootIdx ls = [i]) ∧ AllocStep k pr ow ls s (.ok s')","+  | .newArena st i, s, s' => NewArenaStep st i s (.ok s')","+  | .issue i via region dst, s, s' => IssueAt k i via region dst s (.ok s')","+  | .reset i via, s, s' => ResetAtStep k i via s (.ok s')","+  | .store a p, s, s' => StoreStep a p s (.ok s')","+","+/-- A labelled step is a step of `Reachable` (MM-03.3 §10). -/","+theorem Step3.step {k : K} {op : Op3} {s s' : S3} (h : Step3 k op s s') : Step k s s' := by","+  cases op with","+  | derive => exact .kernel (.derive h)","+  | split => exact .kernel (.split h)","+  | release => exact .kernel (.release h)","+  | transfer => exact .kernel (.transfer h)","+  | depend => exact .kernel (.depend h)","+  | enter => exact .kernel (.enter h.2)","+  | exit => exact .kernel (.exit h)","+  | read => exact .kernel (.read h)","+  | write => exact .kernel (.write h)","+  | writeShared => exact .kernel (.writeShared h)","+  | pin => exact .kernel (.pin h)","+  | unpin => exact .kernel (.unpin h)","+  | endUse => exact .kernel (.endUse h)","+  | free => exact .kernel (.free h)","+  | alloc => exact .kernel (.alloc h.2)","+  | newArena => exact .newArena h","+  | issue => exact .issue h","+  | reset => exact .reset h","+  | store => exact .kernel (.store h)","+","+/-- An execution of MM-03 from `S3.init statics` within the envelope of L1 and L2: the operations,","+most recent first, and the state reached. -/","+inductive Exec3 (k : K) (statics : Statics) : List Op3 → S3 → Prop where","+  | init : ShapeOK 0 (statics.map (·.1)) → Exec3 k statics [] (S3.init statics)","+  | step {ops : List Op3} {s s' : S3} {op : Op3} : Exec3 k statics ops s → Step3 k op s s' →","+      Exec3 k statics (op :: ops) s'","+","+theorem Exec3.reachable {k : K} {statics : Statics} {ops : List Op3} {s : S3}","+    (h : Exec3 k statics ops s) : Reachable k statics s := by","+  induction h with","+  | init hsh => exact .init hsh","+  | step _ hs ih => exact ih.ofStep hs.step","+","+/-- Parameters of the refinement fixed once for a whole execution (step 5): the layout, the frame","+and provider tokens (K2, L4), the placement (K2), the geometry of the allocation of each root place,","+read on its index, the encoding of pointers (L6), the initial bytes of the statics (K3). -/","+structure Params where","+  L : Layout","+  tok : Nat → Nat","+  ptok : Nat → Nat","+  pl : Placement","+  geom : Nat → Geom","+  pe : PtrEnc","+  w0 : Nat → Nat → UInt8 × Option Nat","+","+/-- K4, L6: the MM-02 sequence associated with an MM-03 operation from the states `s3`, `s2`. -/","+def assoc (π : Params) : Op3 → S3 → MM02.State → List Op2","+  | .read _ ls, _, s2 => readOps s2 π.L ls","+  | .write _ ls w, _, s2 => writeOps s2 π.L w ls","+  | .writeShared _ ls w, _, s2 => writeOps s2 π.L w ls","+  | .transfer src dst, s3, s2 => transferOps s2 π.L s3.P src dst","+  | .store a p, s3, s2 => storeOps π.pe s2 π.L s3 a p","+  | .issue _ _ region dst, _, s2 => issueOps π.pe s2 π.L region dst","+  | .alloc pr _ ls, s3, s2 =>","+    allocOps π.pl (fun i => π.geom (s3.P.length + i)) (some (π.ptok pr)) s2 (rootIdx ls)","+  | .enter _ ls, s3, s2 =>","+    allocOps π.pl (fun i => π.geom (s3.P.length + i)) (some (π.tok s3.nF)) s2 (rootIdx ls)","+  | .free p auth, s3, _ => deallocOps [rootAlloc π.L s3.P p] auth","+  | .exit, s3, _ => exitOps π.L π.tok s3","+  | _, _, _ => []","+","+/-- L4: the ghost `provOf` after an operation: `alloc pr _ ls` maps the places it creates to the","+provider `pr`; no other operation changes it. -/","+def provStep : Op3 → S3 → (Nat → Option Nat) → Nat → Option Nat","+  | .alloc pr _ ls, s3, pv => fun r =>","+    if s3.P.length ≤ r ∧ r < s3.P.length + ls.length then some pr else pv r","+  | _, _, pv => pv","+","+/-- K3: the MM-02 operations of the initial state with the parameters `π`. -/","+def initOpsOf (π : Params) (statics : Statics) : List Op2 :=","+  initOps π.pl π.geom π.tok π.L π.w0 statics","+","+/-- The lock-step translation of an MM-03 execution: the operations (most recent first), the MM-03","+state, the ghost `provOf`, the MM-02 operations (in the order of execution) and the MM-02 state.","+It starts with the MM-02 run of `repr_init`; each MM-03 step appends its associated sequence. It is","+determined by the execution and the parameters. -/","+inductive Trans (k : K) (statics : Statics) (π : Params) :","+    List Op3 → S3 → (Nat → Option Nat) → List Op2 → MM02.State → Prop where","+  | init : ShapeOK 0 (statics.map (·.1)) →","+      Trans k statics π [] (S3.init statics) (fun _ => none) (initOpsOf π statics)","+        (exec MM02.State.empty (initOpsOf π statics))","+  | step {ops : List Op3} {s3 s3' : S3} {pv : Nat → Option Nat} {os : List Op2}","+      {s2 : MM02.State} {op : Op3} :","+      Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →","+      Trans k statics π (op :: ops) s3' (provStep op s3 pv) (os ++ assoc π op s3 s2)","+        (exec s2 (assoc π op s3 s2))","+","+/-- Every MM-03 execution has a translation. -/","+theorem Trans.of_exec {k : K} {statics : Statics} (π : Params) {ops : List Op3} {s3 : S3}","+    (h : Exec3 k statics ops s3) : ∃ pv os s2, Trans k statics π ops s3 pv os s2 := by","+  induction h with","+  | init hsh => exact ⟨_, _, _, .init hsh⟩","+  | step _ hs ih => obtain ⟨pv, os, s2, ht⟩ := ih; exact ⟨_, _, _, ht.step hs⟩","+","+/-- K1, K2: the layout obligation of an operation that creates root places: the new roots are laid","+out in fresh allocations, within their geometry (`NewLayout`). -/","+def LayoutObl (π : Params) : Op3 → S3 → S3 → MM02.State → Prop","+  | .enter _ ls, s3, s3', s2 =>","+    NewLayout π.L s3'.P s3.P.length s2.next (fun i => π.geom (s3.P.length + i)) (rootIdx ls)","+  | .alloc _ _ ls, s3, s3', s2 =>","+    NewLayout π.L s3'.P s3.P.length s2.next (fun i => π.geom (s3.P.length + i)) (rootIdx ls)","+  | _, _, _, _ => True","+","+theorem ReprB.provOf_congr {tok ptok : Nat → Nat} {pv pv' : Nat → Option Nat} {L : Layout}","+    {s3 : S3} {s2 : MM02.State} (hR : ReprB tok ptok pv L s3 s2)","+    (h : ∀ r < s3.P.length, pv' r = pv r) : ReprB tok ptok pv' L s3 s2 :=","+  { hR with provTokens := fun r hr hrt => by rw [h r hr]; exact hR.provTokens r hr hrt }","+","+theorem decAlong_readOps {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec} {s2 s2' : MM02.State}","+    {L : Layout} : ∀ {ls : List Nat}, DecAlong ObR ObW s2 (readOps s2' L ls) →","+      ∀ l ∈ ls, ObR.dec s2 (leafAcc s2' L .read l)","+  | [], _, _, h => by cases h","+  | _ :: _, ⟨h0, h⟩, _, hl => by","+    rcases List.mem_cons.1 hl with rfl | hl","+    · exact h0","+    · exact decAlong_readOps h _ hl","+","+/-- `simulation` at each step (step 5): along the translation of an MM-03 execution, every MM-02","+outcome is `ok`, the MM-02 state is the one reached by the run from `State.empty`, the states are","+in `Repr`, the MM-03 state is reached, and the ghost `provOf` is empty beyond the places. The","+hypotheses are fixed for the whole execution or bear on its canonical run (`Trans`): `DDSound k`;","+`stat` (K5); the obligation of the placement and valid alignments (K2); the compatibility of the","+frame tokens (K2); the layout of the statics and of every new root (`LayoutObl`); `dec` along the","+run (K5); `FreeCompat` instantiated by the provider tokens at every `free` (L4). -/","+theorem simulation_each_step {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec}","+    {ObW : MM02.WriteOblSpec} {k : K} {statics : Statics} {π : Params} (hdd : DDSound k)","+    (hstatR : ∀ s ac, ObR.stat s ac) (hstatW : ∀ s ac w, ObW.stat s ac w)","+    (hpl : PlacementOK π.pl) (hg : ∀ r, 0 < (π.geom r).align ∧ MM02.Pow2 (π.geom r).align)","+    (htc : TokCompat C π.tok)","+    (hlay0 : NewLayout π.L (S3.init statics).P 0 0 π.geom (rootIdx (statics.map (·.1))))","+    (hdec0 : DecAlong ObR ObW MM02.State.empty (initOpsOf π statics))","+    (hlay : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →","+      LayoutObl π op s3 s3' s2)","+    (hdec : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →","+      DecAlong ObR ObW s2 (assoc π op s3 s2))","+    (hfc : ∀ ops s3 pv os s2 p auth s3', Trans k statics π ops s3 pv os s2 →","+      Step3 k (.free p auth) s3 s3' → k.FreeCompat p auth → FreeCompatInst C π.ptok pv p auth) :","+    ∀ {ops s3 pv os s2}, Trans k statics π ops s3 pv os s2 →","+      AllOk C ObR ObW MM02.State.empty os ∧ exec MM02.State.empty os = s2 ∧","+      Repr π.tok π.ptok pv π.L s3 s2 ∧ Reachable k statics s3 ∧","+      ∀ r, s3.P.length ≤ r → pv r = none := by","+  intro ops s3 pv os s2 ht","+  induction ht with","+  | init hsh =>","+    have := repr_init (C := C) (ObR := ObR) (ObW := ObW) (tok := π.tok) (ptok := π.ptok)","+      (provOf := fun _ => none) hsh hpl (fun i _ => hg i) hlay0 (fun _ _ => rfl) hstatW hdec0","+    exact ⟨this.1, rfl, this.2, .init hsh, fun _ _ => rfl⟩","+  | @step ops s3 s3' pv os s2 op ht hs ih =>","+    obtain ⟨hok, hex, hR, hr, hpv⟩ := ih","+    have hwf := (reachable_invariants hdd hr).1","+    have hnd := (reachable_invariants hdd hr).2.1.nd","+    have hfl := (reachable_fpLeaves_frameOwnedLive hdd hr).1","+    have hfo := (reachable_fpLeaves_frameOwnedLive hdd hr).2","+    have hr' : Reachable k statics s3' := hr.ofStep hs.step","+    have hdc := hdec ops s3 pv os s2 op s3' ht hs","+    have hly := hlay ops s3 pv os s2 op s3' ht hs","+    -- the MM-02 side of the step","+    have key : AllOk C ObR ObW s2 (assoc π op s3 s2) ∧","+        Repr π.tok π.ptok (provStep op s3 pv) π.L s3' (exec s2 (assoc π op s3 s2)) := by","+      cases op with","+      | derive => exact r6_noStep hR (.derive hs)","+      | split => exact r6_noStep hR (.split hs)","+      | release => exact r6_noStep hR (.release hs)","+      | transfer => exact r6_transfer hwf hR hs hstatR hstatW hdc","+      | depend => exact r6_noStep hR (.depend hs)","+      | enter ps ls =>","+        exact r6_enter hwf hR hpl (fun i _ => hg _) hs.2 (fun i _ => hpv _ (Nat.le_add_right _ _))","+          hly","+      | exit => exact r6_exit hwf hfo hR htc hs","+      | read => exact r6_read3 hwf hnd hfl hR hs hstatR (decAlong_readOps hdc)","+      | write => exact r2_write3 hwf hnd hfl hR hs hstatW hdc","+      | writeShared => exact r2_writeShared hwf hnd hfl hR hs hstatW hdc","+      | pin => exact r6_noStep hR (.pin hs)","+      | unpin => exact r6_noStep hR (.unpin hs)","+      | endUse => exact r6_noStep hR (.endUse hs)","+      | free p auth => exact r6_free hwf hR (hfc ops s3 pv os s2 p auth s3' ht hs) hs","+      | alloc pr ow ls =>","+        obtain ⟨⟨i, hone⟩, hs'⟩ := hs","+        have hi : i < ls.length := (rootIdx_mem (k := 0) (by rw [hone]; rfl)).1","+        have hR₁ : Repr π.tok π.ptok (provStep (.alloc pr ow ls) s3 pv) π.L s3 s2 :=","+          ⟨hR.toReprB.provOf_congr fun r hr => by","+            simp only [provStep, show ¬ (s3.P.length ≤ r ∧ r < s3.P.length + ls.length) from","+              fun h => absurd h.1 (Nat.not_le.2 hr), ↓reduceIte], hR.wf2⟩","+        have := r6_alloc (C := C) (ObR := ObR) (ObW := ObW) (pl := π.pl)","+          (g := fun i => π.geom (s3.P.length + i)) (i := i) hwf hR₁ hpl (hg _) hs' hone","+          (by simp only [provStep, show s3.P.length ≤ s3.P.length + i ∧","+              s3.P.length + i < s3.P.length + ls.length from ⟨Nat.le_add_right _ _, by omega⟩,","+              and_self, ↓reduceIte])","+          (by simp only [LayoutObl] at hly; rw [hone] at hly; exact hly)","+        simp only [assoc, hone]","+        exact this","+      | newArena => exact r6_noStep hR (.newArena hs)","+      | issue => exact (r6_issue hwf hR hs hstatW hdc.1).1.symm ▸ (r6_issue hwf hR hs hstatW hdc.1)","+          |>.imp id fun h => h.1","+      | reset => exact r6_noStep hR (.reset hs)","+      | store => exact (r6_store hwf hR hs hstatW hdc.1).imp id fun h => h.1","+    refine ⟨along_append.2 ⟨hok, hex ▸ key.1⟩, by rw [exec_append, hex], key.2, hr', fun r hr => ?_⟩","+    have hlen := (step_extends hwf hs.step).1","+    cases op with","+    | alloc pr ow ls =>","+      have hP : s3'.P.length = s3.P.length + ls.length := by","+        obtain ⟨-, hs'⟩ := hs","+        cases hs' with","+        | ok _ _ => exact allocP_len s3 ow ls","+      simp only [provStep, show ¬ (s3.P.length ≤ r ∧ r < s3.P.length + ls.length) from","+        fun h => by omega, ↓reduceIte]","+      exact hpv r (by omega)","+    | _ => exact hpv r (by omega)","+","+/-- `simulation` (step 5): every MM-03 execution from `S3.init statics` within the envelope of L1","+and L2 has a translation into an MM-02 run from `State.empty` that starts with the run of","+`repr_init`, appends at each step the sequence associated by K4 and L6, has only `ok` outcomes,","+and is in `Repr` with the MM-03 state at each step (`simulation_each_step` applies to every prefix,","+whose translation is a sub-derivation). The parameters `π` are fixed once for the execution; the","+remaining hypotheses are those of `simulation_each_step`. -/","+theorem simulation {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","+    {k : K} {statics : Statics} {π : Params} (hdd : DDSound k)","+    (hstatR : ∀ s ac, ObR.stat s ac) (hstatW : ∀ s ac w, ObW.stat s ac w)","+    (hpl : PlacementOK π.pl) (hg : ∀ r, 0 < (π.geom r).align ∧ MM02.Pow2 (π.geom r).align)","+    (htc : TokCompat C π.tok)","+    (hlay0 : NewLayout π.L (S3.init statics).P 0 0 π.geom (rootIdx (statics.map (·.1))))","+    (hdec0 : DecAlong ObR ObW MM02.State.empty (initOpsOf π statics))","+    (hlay : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →","+      LayoutObl π op s3 s3' s2)","+    (hdec : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →","+      DecAlong ObR ObW s2 (assoc π op s3 s2))","+    (hfc : ∀ ops s3 pv os s2 p auth s3', Trans k statics π ops s3 pv os s2 →","+      Step3 k (.free p auth) s3 s3' → k.FreeCompat p auth → FreeCompatInst C π.ptok pv p auth)","+    {ops : List Op3} {s3 : S3} (hexec : Exec3 k statics ops s3) :","+    ∃ pv os s2, Trans k statics π ops s3 pv os s2 ∧ AllOk C ObR ObW MM02.State.empty os ∧","+      exec MM02.State.empty os = s2 ∧ Repr π.tok π.ptok pv π.L s3 s2 := by","+  obtain ⟨pv, os, s2, ht⟩ := Trans.of_exec π hexec","+  obtain ⟨h1, h2, h3, -⟩ := simulation_each_step hdd hstatR hstatW hpl hg htc hlay0 hdec0 hlay","+    hdec hfc ht","+  exact ⟨pv, os, s2, ht, h1, h2, h3⟩","+"," /-! ## Cases (step 6 of the task)"," "," Each verdict is checked by `decide` on the precondition of the MM-03 step and on `Repr`, which is"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean"]}},"serverClassifierContext":{"request":"c0a2b224-793e-49e5-bce8-3c904a2ac6cb","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/refinement_0.1","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"644b1012-58bd-4b8b-a38b-cd46578eadef","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"type":"api-request-blob","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","hash":"1d1466186828f5e2cb421e1441ebaf1a613f705cb6131d37118176e251423ee4","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01NYLaxy3ki42TeCfZtAXcem","name":"Bash","input":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && cat > /private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/sim.lean <<'EOF'\n/-! ## Simulation (step 5 of the task) -/\n\n/-- An operation of MM-03 with its arguments (MM-03.3 §3–6), the bytes written by `write3` and\n`writeShared` included: they are data of the program, not a choice of the refinement. -/\ninductive Op3 where\n  | derive (src q : Nat) (m : Mode)\n  | split (src : Nat) (rs : List (List Nat))\n  | release (a : Nat)\n  | transfer (src dst : Nat)\n  | depend (q x : Nat)\n  | enter (ps : List Nat) (ls : List (Option Nat × Option Nat × Nat))\n  | exit\n  | read (a : Nat) (ls : List Nat)\n  | write (a : Nat) (ls : List Nat) (w : Nat → Nat → UInt8 × Option Nat)\n  | writeShared (a : Nat) (ls : List Nat) (w : Nat → Nat → UInt8 × Option Nat)\n  | pin (p : Nat)\n  | unpin (p : Nat)\n  | endUse (p : Nat)\n  | free (p auth : Nat)\n  | alloc (pr ow : Nat) (ls : List (Option Nat × Option Nat × Nat))\n  | newArena (st i : Nat)\n  | issue (i via : Nat) (region : List Nat) (dst : Nat)\n  | reset (i via : Nat)\n  | store (a p : Nat)\n\n/-- L1: the shape of an `enterFrame` has no owning element: its locals are owned by the frame. -/\ndef NoOwner (ls : List (Option Nat × Option Nat × Nat)) : Prop :=\n  ∀ i < ls.length, (ls[i]?).bind (·.2.1) = none\n\n/-- An `ok` step of MM-03 labelled by its operation, within the envelope of L1 (an `enterFrame`\nwhose shape has an owning element is outside the language) and L2 (the shape of `alloc` has exactly\none root). -/\ndef Step3 (k : K) : Op3 → S3 → S3 → Prop\n  | .derive src q m, s, s' => DeriveStep src q m s (.ok s')\n  | .split src rs, s, s' => SplitStep k src rs s (.ok s')\n  | .release a, s, s' => ReleaseStep a s (.ok s')\n  | .transfer src dst, s, s' => TransferStep k src dst s (.ok s')\n  | .depend q x, s, s' => DependStep q x s (.ok s')\n  | .enter ps ls, s, s' => NoOwner ls ∧ EnterStep ps ls s (.ok s')\n  | .exit, s, s' => ExitStep k s (.ok s')\n  | .read a ls, s, s' => Read3Step a ls s (.ok s')\n  | .write a ls _, s, s' => Write3Step a ls s (.ok s')\n  | .writeShared a ls _, s, s' => WriteSharedStep k a ls s (.ok s')\n  | .pin p, s, s' => PinStep p s (.ok s')\n  | .unpin p, s, s' => UnpinStep k p s (.ok s')\n  | .endUse p, s, s' => EndUseStep k p s (.ok s')\n  | .free p auth, s, s' => FreeStep k p auth s (.ok s')\n  | .alloc pr ow ls, s, s' => (∃ i, rootIdx ls = [i]) ∧ AllocStep k pr ow ls s (.ok s')\n  | .newArena st i, s, s' => NewArenaStep st i s (.ok s')\n  | .issue i via region dst, s, s' => IssueAt k i via region dst s (.ok s')\n  | .reset i via, s, s' => ResetAtStep k i via s (.ok s')\n  | .store a p, s, s' => StoreStep a p s (.ok s')\n\n/-- A labelled step is a step of `Reachable` (MM-03.3 §10). -/\ntheorem Step3.step {k : K} {op : Op3} {s s' : S3} (h : Step3 k op s s') : Step k s s' := by\n  cases op with\n  | derive => exact .kernel (.derive h)\n  | split => exact .kernel (.split h)\n  | release => exact .kernel (.release h)\n  | transfer => exact .kernel (.transfer h)\n  | depend => exact .kernel (.depend h)\n  | enter => exact .kernel (.enter h.2)\n  | exit => exact .kernel (.exit h)\n  | read => exact .kernel (.read h)\n  | write => exact .kernel (.write h)\n  | writeShared => exact .kernel (.writeShared h)\n  | pin => exact .kernel (.pin h)\n  | unpin => exact .kernel (.unpin h)\n  | endUse => exact .kernel (.endUse h)\n  | free => exact .kernel (.free h)\n  | alloc => exact .kernel (.alloc h.2)\n  | newArena => exact .newArena h\n  | issue => exact .issue h\n  | reset => exact .reset h\n  | store => exact .kernel (.store h)\n\n/-- An execution of MM-03 from `S3.init statics` within the envelope of L1 and L2: the operations,\nmost recent first, and the state reached. -/\ninductive Exec3 (k : K) (statics : Statics) : List Op3 → S3 → Prop where\n  | init : ShapeOK 0 (statics.map (·.1)) → Exec3 k statics [] (S3.init statics)\n  | step {ops : List Op3} {s s' : S3} {op : Op3} : Exec3 k statics ops s → Step3 k op s s' →\n      Exec3 k statics (op :: ops) s'\n\ntheorem Exec3.reachable {k : K} {statics : Statics} {ops : List Op3} {s : S3}\n    (h : Exec3 k statics ops s) : Reachable k statics s := by\n  induction h with\n  | init hsh => exact .init hsh\n  | step _ hs ih => exact ih.ofStep hs.step\n\n/-- Parameters of the refinement fixed once for a whole execution (step 5): the layout, the frame\nand provider tokens (K2, L4), the placement (K2), the geometry of the allocation of each root place,\nread on its index, the encoding of pointers (L6), the initial bytes of the statics (K3). -/\nstructure Params where\n  L : Layout\n  tok : Nat → Nat\n  ptok : Nat → Nat\n  pl : Placement\n  geom : Nat → Geom\n  pe : PtrEnc\n  w0 : Nat → Nat → UInt8 × Option Nat\n\n/-- K4, L6: the MM-02 sequence associated with an MM-03 operation from the states `s3`, `s2`. -/\ndef assoc (π : Params) : Op3 → S3 → MM02.State → List Op2\n  | .read _ ls, _, s2 => readOps s2 π.L ls\n  | .write _ ls w, _, s2 => writeOps s2 π.L w ls\n  | .writeShared _ ls w, _, s2 => writeOps s2 π.L w ls\n  | .transfer src dst, s3, s2 => transferOps s2 π.L s3.P src dst\n  | .store a p, s3, s2 => storeOps π.pe s2 π.L s3 a p\n  | .issue _ _ region dst, _, s2 => issueOps π.pe s2 π.L region dst\n  | .alloc pr _ ls, s3, s2 =>\n    allocOps π.pl (fun i => π.geom (s3.P.length + i)) (some (π.ptok pr)) s2 (rootIdx ls)\n  | .enter _ ls, s3, s2 =>\n    allocOps π.pl (fun i => π.geom (s3.P.length + i)) (some (π.tok s3.nF)) s2 (rootIdx ls)\n  | .free p auth, s3, _ => deallocOps [rootAlloc π.L s3.P p] auth\n  | .exit, s3, _ => exitOps π.L π.tok s3\n  | _, _, _ => []\n\n/-- L4: the ghost `provOf` after an operation: `alloc pr _ ls` maps the places it creates to the\nprovider `pr`; no other operation changes it. -/\ndef provStep : Op3 → S3 → (Nat → Option Nat) → Nat → Option Nat\n  | .alloc pr _ ls, s3, pv => fun r =>\n    if s3.P.length ≤ r ∧ r < s3.P.length + ls.length then some pr else pv r\n  | _, _, pv => pv\n\n/-- K3: the MM-02 operations of the initial state with the parameters `π`. -/\ndef initOpsOf (π : Params) (statics : Statics) : List Op2 :=\n  initOps π.pl π.geom π.tok π.L π.w0 statics\n\n/-- The lock-step translation of an MM-03 execution: the operations (most recent first), the MM-03\nstate, the ghost `provOf`, the MM-02 operations (in the order of execution) and the MM-02 state.\nIt starts with the MM-02 run of `repr_init`; each MM-03 step appends its associated sequence. It is\ndetermined by the execution and the parameters. -/\ninductive Trans (k : K) (statics : Statics) (π : Params) :\n    List Op3 → S3 → (Nat → Option Nat) → List Op2 → MM02.State → Prop where\n  | init : ShapeOK 0 (statics.map (·.1)) →\n      Trans k statics π [] (S3.init statics) (fun _ => none) (initOpsOf π statics)\n        (exec MM02.State.empty (initOpsOf π statics))\n  | step {ops : List Op3} {s3 s3' : S3} {pv : Nat → Option Nat} {os : List Op2}\n      {s2 : MM02.State} {op : Op3} :\n      Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →\n      Trans k statics π (op :: ops) s3' (provStep op s3 pv) (os ++ assoc π op s3 s2)\n        (exec s2 (assoc π op s3 s2))\n\n/-- Every MM-03 execution has a translation. -/\ntheorem Trans.of_exec {k : K} {statics : Statics} (π : Params) {ops : List Op3} {s3 : S3}\n    (h : Exec3 k statics ops s3) : ∃ pv os s2, Trans k statics π ops s3 pv os s2 := by\n  induction h with\n  | init hsh => exact ⟨_, _, _, .init hsh⟩\n  | step _ hs ih => obtain ⟨pv, os, s2, ht⟩ := ih; exact ⟨_, _, _, ht.step hs⟩\n\n/-- K1, K2: the layout obligation of an operation that creates root places: the new roots are laid\nout in fresh allocations, within their geometry (`NewLayout`). -/\ndef LayoutObl (π : Params) : Op3 → S3 → S3 → MM02.State → Prop\n  | .enter _ ls, s3, s3', s2 =>\n    NewLayout π.L s3'.P s3.P.length s2.next (fun i => π.geom (s3.P.length + i)) (rootIdx ls)\n  | .alloc _ _ ls, s3, s3', s2 =>\n    NewLayout π.L s3'.P s3.P.length s2.next (fun i => π.geom (s3.P.length + i)) (rootIdx ls)\n  | _, _, _, _ => True\n\ntheorem ReprB.provOf_congr {tok ptok : Nat → Nat} {pv pv' : Nat → Option Nat} {L : Layout}\n    {s3 : S3} {s2 : MM02.State} (hR : ReprB tok ptok pv L s3 s2)\n    (h : ∀ r < s3.P.length, pv' r = pv r) : ReprB tok ptok pv' L s3 s2 :=\n  { hR with provTokens := fun r hr hrt => by rw [h r hr]; exact hR.provTokens r hr hrt }\n\ntheorem decAlong_readOps {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec} {s2 s2' : MM02.State}\n    {L : Layout} : ∀ {ls : List Nat}, DecAlong ObR ObW s2 (readOps s2' L ls) →\n      ∀ l ∈ ls, ObR.dec s2 (leafAcc s2' L .read l)\n  | [], _, _, h => by cases h\n  | _ :: _, ⟨h0, h⟩, _, hl => by\n    rcases List.mem_cons.1 hl with rfl | hl\n    · exact h0\n    · exact decAlong_readOps h _ hl\n\n/-- `simulation` at each step (step 5): along the translation of an MM-03 execution, every MM-02\noutcome is `ok`, the MM-02 state is the one reached by the run from `State.empty`, the states are\nin `Repr`, the MM-03 state is reached, and the ghost `provOf` is empty beyond the places. The\nhypotheses are fixed for the whole execution or bear on its canonical run (`Trans`): `DDSound k`;\n`stat` (K5); the obligation of the placement and valid alignments (K2); the compatibility of the\nframe tokens (K2); the layout of the statics and of every new root (`LayoutObl`); `dec` along the\nrun (K5); `FreeCompat` instantiated by the provider tokens at every `free` (L4). -/\ntheorem simulation_each_step {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec}\n    {ObW : MM02.WriteOblSpec} {k : K} {statics : Statics} {π : Params} (hdd : DDSound k)\n    (hstatR : ∀ s ac, ObR.stat s ac) (hstatW : ∀ s ac w, ObW.stat s ac w)\n    (hpl : PlacementOK π.pl) (hg : ∀ r, 0 < (π.geom r).align ∧ MM02.Pow2 (π.geom r).align)\n    (htc : TokCompat C π.tok)\n    (hlay0 : NewLayout π.L (S3.init statics).P 0 0 π.geom (rootIdx (statics.map (·.1))))\n    (hdec0 : DecAlong ObR ObW MM02.State.empty (initOpsOf π statics))\n    (hlay : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →\n      LayoutObl π op s3 s3' s2)\n    (hdec : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →\n      DecAlong ObR ObW s2 (assoc π op s3 s2))\n    (hfc : ∀ ops s3 pv os s2 p auth s3', Trans k statics π ops s3 pv os s2 →\n      Step3 k (.free p auth) s3 s3' → k.FreeCompat p auth → FreeCompatInst C π.ptok pv p auth) :\n    ∀ {ops s3 pv os s2}, Trans k statics π ops s3 pv os s2 →\n      AllOk C ObR ObW MM02.State.empty os ∧ exec MM02.State.empty os = s2 ∧\n      Repr π.tok π.ptok pv π.L s3 s2 ∧ Reachable k statics s3 ∧\n      ∀ r, s3.P.length ≤ r → pv r = none := by\n  intro ops s3 pv os s2 ht\n  induction ht with\n  | init hsh =>\n    have := repr_init (C := C) (ObR := ObR) (ObW := ObW) (tok := π.tok) (ptok := π.ptok)\n      (provOf := fun _ => none) hsh hpl (fun i _ => hg i) hlay0 (fun _ _ => rfl) hstatW hdec0\n    exact ⟨this.1, rfl, this.2, .init hsh, fun _ _ => rfl⟩\n  | @step ops s3 s3' pv os s2 op ht hs ih =>\n    obtain ⟨hok, hex, hR, hr, hpv⟩ := ih\n    have hwf := (reachable_invariants hdd hr).1\n    have hnd := (reachable_invariants hdd hr).2.1.nd\n    have hfl := (reachable_fpLeaves_frameOwnedLive hdd hr).1\n    have hfo := (reachable_fpLeaves_frameOwnedLive hdd hr).2\n    have hr' : Reachable k statics s3' := hr.ofStep hs.step\n    have hdc := hdec ops s3 pv os s2 op s3' ht hs\n    have hly := hlay ops s3 pv os s2 op s3' ht hs\n    -- the MM-02 side of the step\n    have key : AllOk C ObR ObW s2 (assoc π op s3 s2) ∧\n        Repr π.tok π.ptok (provStep op s3 pv) π.L s3' (exec s2 (assoc π op s3 s2)) := by\n      cases op with\n      | derive => exact r6_noStep hR (.derive hs)\n      | split => exact r6_noStep hR (.split hs)\n      | release => exact r6_noStep hR (.release hs)\n      | transfer => exact r6_transfer hwf hR hs hstatR hstatW hdc\n      | depend => exact r6_noStep hR (.depend hs)\n      | enter ps ls =>\n        exact r6_enter hwf hR hpl (fun i _ => hg _) hs.2 (fun i _ => hpv _ (Nat.le_add_right _ _))\n          hly\n      | exit => exact r6_exit hwf hfo hR htc hs\n      | read => exact r6_read3 hwf hnd hfl hR hs hstatR (decAlong_readOps hdc)\n      | write => exact r2_write3 hwf hnd hfl hR hs hstatW hdc\n      | writeShared => exact r2_writeShared hwf hnd hfl hR hs hstatW hdc\n      | pin => exact r6_noStep hR (.pin hs)\n      | unpin => exact r6_noStep hR (.unpin hs)\n      | endUse => exact r6_noStep hR (.endUse hs)\n      | free p auth => exact r6_free hwf hR (hfc ops s3 pv os s2 p auth s3' ht hs) hs\n      | alloc pr ow ls =>\n        obtain ⟨⟨i, hone⟩, hs'⟩ := hs\n        have hi : i < ls.length := (rootIdx_mem (k := 0) (by rw [hone]; rfl)).1\n        have hR₁ : Repr π.tok π.ptok (provStep (.alloc pr ow ls) s3 pv) π.L s3 s2 :=\n          ⟨hR.toReprB.provOf_congr fun r hr => by\n            simp only [provStep, show ¬ (s3.P.length ≤ r ∧ r < s3.P.length + ls.length) from\n              fun h => absurd h.1 (Nat.not_le.2 hr), ↓reduceIte], hR.wf2⟩\n        have := r6_alloc (C := C) (ObR := ObR) (ObW := ObW) (pl := π.pl)\n          (g := fun i => π.geom (s3.P.length + i)) (i := i) hwf hR₁ hpl (hg _) hs' hone\n          (by simp only [provStep, show s3.P.length ≤ s3.P.length + i ∧\n              s3.P.length + i < s3.P.length + ls.length from ⟨Nat.le_add_right _ _, by omega⟩,\n              and_self, ↓reduceIte])\n          (by simp only [LayoutObl] at hly; rw [hone] at hly; exact hly)\n        simp only [assoc, hone]\n        exact this\n      | newArena => exact r6_noStep hR (.newArena hs)\n      | issue => exact (r6_issue hwf hR hs hstatW hdc.1).1.symm ▸ (r6_issue hwf hR hs hstatW hdc.1)\n          |>.imp id fun h => h.1\n      | reset => exact r6_noStep hR (.reset hs)\n      | store => exact (r6_store hwf hR hs hstatW hdc.1).imp id fun h => h.1\n    refine ⟨along_append.2 ⟨hok, hex ▸ key.1⟩, by rw [exec_append, hex], key.2, hr', fun r hr => ?_⟩\n    have hlen := (step_extends hwf hs.step).1\n    cases op with\n    | alloc pr ow ls =>\n      have hP : s3'.P.length = s3.P.length + ls.length := by\n        obtain ⟨-, hs'⟩ := hs\n        cases hs' with\n        | ok _ _ => exact allocP_len s3 ow ls\n      simp only [provStep, show ¬ (s3.P.length ≤ r ∧ r < s3.P.length + ls.length) from\n        fun h => by omega, ↓reduceIte]\n      exact hpv r (by omega)\n    | _ => exact hpv r (by omega)\n\n/-- `simulation` (step 5): every MM-03 execution from `S3.init statics` within the envelope of L1\nand L2 has a translation into an MM-02 run from `State.empty` that starts with the run of\n`repr_init`, appends at each step the sequence associated by K4 and L6, has only `ok` outcomes,\nand is in `Repr` with the MM-03 state at each step (`simulation_each_step` applies to every prefix,\nwhose translation is a sub-derivation). The parameters `π` are fixed once for the execution; the\nremaining hypotheses are those of `simulation_each_step`. -/\ntheorem simulation {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n    {k : K} {statics : Statics} {π : Params} (hdd : DDSound k)\n    (hstatR : ∀ s ac, ObR.stat s ac) (hstatW : ∀ s ac w, ObW.stat s ac w)\n    (hpl : PlacementOK π.pl) (hg : ∀ r, 0 < (π.geom r).align ∧ MM02.Pow2 (π.geom r).align)\n    (htc : TokCompat C π.tok)\n    (hlay0 : NewLayout π.L (S3.init statics).P 0 0 π.geom (rootIdx (statics.map (·.1))))\n    (hdec0 : DecAlong ObR ObW MM02.State.empty (initOpsOf π statics))\n    (hlay : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →\n      LayoutObl π op s3 s3' s2)\n    (hdec : ∀ ops s3 pv os s2 op s3', Trans k statics π ops s3 pv os s2 → Step3 k op s3 s3' →\n      DecAlong ObR ObW s2 (assoc π op s3 s2))\n    (hfc : ∀ ops s3 pv os s2 p auth s3', Trans k statics π ops s3 pv os s2 →\n      Step3 k (.free p auth) s3 s3' → k.FreeCompat p auth → FreeCompatInst C π.ptok pv p auth)\n    {ops : List Op3} {s3 : S3} (hexec : Exec3 k statics ops s3) :\n    ∃ pv os s2, Trans k statics π ops s3 pv os s2 ∧ AllOk C ObR ObW MM02.State.empty os ∧\n      exec MM02.State.empty os = s2 ∧ Repr π.tok π.ptok pv π.L s3 s2 := by\n  obtain ⟨pv, os, s2, ht⟩ := Trans.of_exec π hexec\n  obtain ⟨h1, h2, h3, -⟩ := simulation_each_step hdd hstatR hstatW hpl hg htc hlay0 hdec0 hlay\n    hdec hfc ht\n  exact ⟨pv, os, s2, ht, h1, h2, h3⟩\n\nEOF\npython3 - <<'EOF'\np='/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean'\ns=open(p).read()\nc=open('/private/tmp/claude-501/-Users-guygouri-Devlab-ernlang-ern/c986905c-e900-4fd9-bebc-4a3ce7ebb180/scratchpad/p2work/sim.lean').read()\ns=s.replace(\"/-! ## Cases (step 6 of the task)\", c+\"/-! ## Cases (step 6 of the task)\",1)\nopen(p,'w').write(s)\nEOF\n~/.elan/bin/lake env lean Ern/MM23.lean 2>&1 | grep -E \"^Ern\" -A14 | head -80","description":"Write the simulation section and compile"},"caller":{"type":"direct"}}]}}
