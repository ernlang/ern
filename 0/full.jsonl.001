α s s') (src dst : Nat) :\nErn/MemoryModel/Access/Rename/Places.lean:134:theorem corr_none {src dst r : Nat} (hr : r ≠ src) (hp : parentOf P r = none) :\nErn/MemoryModel/Access/Rename/Places.lean:139:theorem corr_ren (hP : PRel π P P') (hd : DownP P) (hd' : DownP P') (hs : SibMono π P)\nErn/MemoryModel/Access/Rename/Invariants.lean:281:theorem Sim.i5_corr (hK : KCorr π α k k') (hS : Sim π α s s') : I5 k' s' ↔ I5 k s :=\nErn/MemoryModel/Access/Rename/OpsSmall.lean:172:theorem derive_corr (hS : Sim π α s s') (src : Nat) (region : List Nat) (m : Mode) :\nErn/MemoryModel/Access/Rename/OpsSmall.lean:249:theorem split_corr_of (hK : KCorr π α k k') (hS : Sim π α s s') (src : Nat)\nErn/MemoryModel/Access/Rename/OpsSmall.lean:256:theorem split_corr (hS : Sim π α s s') (src : Nat) (rs : List (List Nat)) :\nErn/MemoryModel/Access/Rename/OpsSmall.lean:347:theorem release_corr (hS : Sim π α s s') (a : Nat) :\nErn/MemoryModel/Access/Rename/OpsSmall.lean:390:theorem depend_corr (hS : Sim π α s s') (q x : Nat) :\nErn/MemoryModel/Access/Rename/OpsSmall.lean:477:theorem store_corr (hS : Sim π α s s') (a p : Nat) :\nErn/MemoryModel/Access/Rename/OpsSmall.lean:516:theorem read_corr (hS : Sim π α s s') (a : Nat) (ls : List Nat) :\nErn/MemoryModel/Access/Rename/OpsSmall.lean:563:theorem write_corr (hS : Sim π α s s') (a : Nat) (ls : List Nat) :\nErn/MemoryModel/Access/Rename/OpsSmall.lean:600:theorem writeShared_corr_of (hK : KCorr π α k k') (hS : Sim π α s s') (a : Nat)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"71b09905-d073-4649-8aa9-091a65ab72a9","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibili