evlab/ernlang/ern","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/derivability_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"1151b1fb-a20a-491a-8f45-215cf8f6a3e5","isSidechain":false,"promptId":"fcfe6e6f-a978-46ba-b770-f92b3a29d346","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MnN5WdGGDHoTpBydSykRQD","type":"tool_result","content":"import Ern.MM02\nimport Ern.MM03\n\n/-!\n# Refinement MM-03.3 v0.3 → MM-02 v0.4 (milestone 2, passes 1 and 2)\n\nRepresentation of the abstract states of MM-03.3 (module `Ern.MM03`) by the states of the abstract\nmachine of MM-02 (module `Ern.MM02`), refinement of every operation of MM-03 (R6), and simulation\nof an execution. Both modules are imported unchanged; a lemma they lack is proved here.\n\nThe arbitrages of the task are cited as `K1`…`K5` (pass 1) and `L1`…`L8` (pass 2, which replace\nthe K arbitrages where they say so). The rules of the specifications are cited as `MM-02.x`\n(MM-02 v0.4) and `MM-03.3 …` (MM-03.3 v0.3 révisée). Out of scope: concurrency, finite addresses,\nrepresentation of the metadata of arenas, low-level translation. The decisions not dictated by the\ntexts are listed in the reports `formal/reports/MM23_v0.1.md` (pass 1) and\n`formal/reports/MM23_v0.1_p2.md` (pass 2), section (c); the gaps between the drafts and their\ntexts, section (f) of the pass-1 report.\n-/\n\nnamespace Ern.MM23\n\nopen Ern.MM03\n\n/-! ## Allocations of the MM-02 state -/\n\n/-- The MM-02 allocation `i` is registered (MM-02.2) and satisfies `p`. -/\ndef AllocP (s2 : MM02.State) (i : Nat) (p : MM02.Alloc → Prop) : Prop :=\n  ∃ a, s2.allocs i = some a ∧ p a\n\ninstance (s2 : MM02.State) (i : Nat) (p : MM02.Alloc → Prop) [DecidablePred p] :\n    Decidable (AllocP s2 i p) :=\n  match h : s2.allocs i with\n  | some a =>\n    if ha : p a then isTrue ⟨a, h, ha⟩\n    else isFalse fun ⟨b, hb, hb'⟩ => by rw [h] at hb; cases hb; exact ha hb'\n  | none => isFalse fun ⟨b, hb, _⟩ => by rw [h] at hb; cases hb\n\n/-- The MM-02 allocation `i` is registered and live (MM-02.2). -/\nabbrev LiveAlloc (s2 : MM02.State) (i : Nat) : Prop := AllocP s2 i (·.live = true)\n\n/-- The MM-02 allocation `i` is registered and dead (MM-02.2, MM-02.D). -/\nabbrev DeadAlloc (s2 : MM02.State) (i : Nat) : Prop := AllocP s2 i (·.live = false)\n\n/-! ## Layout (K1) -/\n\n/-- K1: layout of the leaves. The leaf `l` occupies the byte range `L l` of an MM-02 allocation:\nits identity `alloc`, an offset `off` and a size `len` (an MM-02.4 place). The layout fixes no\nABI, no type alignment and no order of fields. It is a parameter of an execution, defined on\nevery index, present or future. -/\nabbrev Layout := Nat → MM02.Place\n\n/-- K1, obligations `LayoutWF` of a layout in an MM-03 state `s3` and an MM-02 state `s2`:\n(a) the leaves of one root place are in one allocation; (b) two distinct leaves in one allocation\nhave disjoint ranges (`RangeDisjoint`, MM-02.2); (c) the range of every leaf lies within its\nallocation, which is registered (MM-02.B, spatial containment). (d) No size is bounded below: a\nrange may be empty, so a shape of one leaf may have size zero. No other hypothesis. -/\nstructure LayoutWF (L : Layout) (s3 : S3) (s2 : MM02.State) : Prop where\n  sameAlloc : ∀ r < s3.P.length, RootPlace s3.P r → ∀ l ∈ footprint s3.P r,\n    ∀ l' ∈ footprint s3.P r, (L l).alloc = (L l').alloc\n  disjoint : ∀ l < s3.P.length, ∀ l' < s3.P.length, isLeaf s3.P l → isLeaf s3.P l' → l ≠ l' →\n27:def AllocP (s2 : MM02.State) (i : Nat) (p : MM02.Alloc → Prop) : Prop :=\n57:structure LayoutWF (L : Layout) (s3 : S3) (s2 : MM02.State) : Prop where\n80:def FrameGone (F : Frames) : Holder → Prop\n89:def tokOf (tok : Nat → Nat) : Holder → Option Nat\n110:structure ReprB (tok ptok : Nat → Nat) (provOf : Nat → Option Nat) (L : Layout) (s3 : S3)\n161:structure Repr (tok ptok : Nat → Nat) (provOf : Nat → Option Nat) (L : Layout) (s3 : S3)\n168:inductive Op2 where\n175:def Op2.eff : Op2 → MM02.State → MM02.State\n182:def exec : MM02.State → List Op2 → MM02.State\n187:def Along (p : MM02.State → Op2 → Prop) : MM02.State → List Op2 → Prop\n198:def OpOk (C : Nat → Nat → Prop) (ObR : MM02.ReadOblSpec) (ObW : MM02.WriteOblSpec)\n213:def Op2.Dec (ObR : MM02.ReadOblSpec) (ObW : MM02.WriteOblSpec) (s : MM02.State) : Op2 → Prop\n227:structure Geom where\n239:def PlacementOK (pl : Placement) : Prop :=\n244:def allocEnd (s : MM02.State) (i : Nat) : Nat := ((s.allocs i).map fun a => a.base + a.size).getD 0\n247:def maxEnd (s : MM02.State) : Nat → Nat\n251:theorem le_maxEnd (s : MM02.State) : ∀ n i, i < n → allocEnd s i ≤ maxEnd s n\n261:def topPlacement : Placement := fun s g => g.align * (maxEnd s s.next / g.align + 1)\n263:theorem topPlacement_ok : PlacementOK topPlacement := by\n275:theorem placement_exists {s : MM02.State} (hwf : MM02.WF s) (g : Geom) (h0 : 0 < g.align)\n283:def leafAcc (s2 : MM02.State) (L : Layout) (au : MM02.Auth) (l : Nat) : MM02.Access :=\n287:def readOps (s2 : MM02.State) (L : Layout) (ls : List Nat) : List Op2 :=\n292:def writeOps (s2 : MM02.State) (L : Layout) (w : Nat → Nat → UInt8 × Option Nat) (ls : List Nat) :\n298:def allocOps (pl : Placement) (g : Nat → Geom) (fa : Option Nat) :\n306:theorem exec_append (s : MM02.State) (os os' : List Op2) :\n312:theorem along_append {p : MM02.State → Op2 → Prop} {s : MM02.State} {os os' : List Op2} :\n318:theorem exec_wf : ∀ (ops : List Op2) (s : MM02.State), MM02.WF s → MM02.WF (exec s ops)\n332:def Dom (s s' : MM02.State) : Prop :=\n337:theorem Dom.refl (s : MM02.State) : Dom s s :=\n340:theorem Dom.trans {s s' s'' : MM02.State} (h : Dom s s') (h' : Dom s' s'') : Dom s s'' := by\n347:theorem write_allocs (s : MM02.State) (ac : MM02.Access) (w : Nat → UInt8 × Option Nat) (i : Nat) :\n351:theorem Dom.write (s : MM02.State) (ac : MM02.Access) (w : Nat → UInt8 × Option Nat) :\n364:theorem Dom.alloc {s : MM02.State} (hwf : MM02.WF s) (space base size align : Nat)\n369:theorem AllocP.of_dom {s s' : MM02.State} {i : Nat} {p : MM02.Alloc → Prop} (h : AllocP s i p)\n378:theorem AllocP.and {s : MM02.State} {i : Nat} {p q : MM02.Alloc → Prop} (hp : AllocP s i p)\n385:theorem AllocP.mono {s : MM02.State} {i : Nat} {p q : MM02.Alloc → Prop} (h : AllocP s i p)\n389:theorem AllocP.lt {s : MM02.State} (hwf : MM02.WF s) {i : Nat} {p : MM02.Alloc → Prop}\n395:theorem OptP.imp {α : Type} {o : Option α} {P Q : α → Prop} {d d' : Prop} (h : OptP o P d)\n404:theorem ReprB.change {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n434:theorem leafAcc_of {s2 : MM02.State} {L : Layout} {au : MM02.Auth} {l : Nat} {a : MM02.Alloc}\n439:theorem leafAcc_dom {s2 s2' : MM02.State} (hd : Dom s2 s2') {L : Layout} {au : MM02.Auth} {l : Nat}\n448:theorem write_leaf_ok {ObW : MM02.WriteOblSpec} {s2 : MM02.State} {L : Layout} {l : Nat}\n459:theorem write_leaf_init {s2 : MM02.State} {L : Layout} {l : Nat} {w : Nat → UInt8 × Option Nat}\n471:theorem write3Eff_cons (s : S3) (l : Nat) (ls : List Nat) :\n479:theorem repr_writes {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n526:theorem allocOps_next : ∀ (roots : List Nat) (s : MM02.State),\n533:theorem allocOps_old : ∀ (roots : List Nat) (s : MM02.State) (i : Nat), i < s.next →\n541:theorem allocOps_new : ∀ (roots : List Nat) (s : MM02.State) (j i : Nat), roots[j]? = some i →\n561:theorem allocOps_wf : ∀ (roots : List Nat) (s : MM02.State), MM02.WF s →\n568:theorem allocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n581:theorem AllocP.of_eq {s s' : MM02.State} {i : Nat} {p : MM02.Alloc → Prop} (h : AllocP s i p)\n590:theorem shape_isLeaf_old (hsh : ShapeOK P.length ls) {l : Nat} (hl : l < P.length) :\n604:theorem shape_rootPlace_old {r : Nat} (hr : r < P.length) :\n609:theorem shape_rootPlace_new {r : Nat} (h : RootPlace (shapeP P hd ls) r) (hr : P.length ≤ r) :\n619:theorem shape_part_root (hsh : ShapeOK P.length ls) : ∀ m l, l < m → P.length ≤ l →\n646:structure NewLayout (L : Layout) (P' : List Place) (n next : Nat) (g : Nat → Geom)\n665:theorem NewLayout.at {L : Layout} {P' : List Place} {n next : Nat} {g : Nat → Geom}\n672:theorem not_frameGone_of_usable {s : S3} {q : Nat} {pl : Place} (hu : s.Usable q)\n684:theorem repr_extend {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n868:theorem repr_of_nil {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n879:def initLeaves (statics : Statics) : List Nat :=\n886:def initOps (pl : Placement) (g : Nat → Geom) (tok : Nat → Nat) (L : Layout)\n899:theorem repr_init {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n969:def FpLeaves (s : S3) : Prop :=\n974:theorem covered_live {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n986:theorem covered_of_effective {s : S3} {a l : Nat} (h : effective s a l ≠ none) :\n999:theorem r1_read3 {ObR : MM02.ReadOblSpec} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n1030:theorem r2_write3 {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n1046:theorem r2_writeShared {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n1065:def FrameOwnedLive (s : S3) : Prop :=\n1070:theorem FpLeaves.step {s s' : S3} (hwf : WF3 s) (h : FpLeaves s)\n1083:theorem FrameOwnedLive.step {s s' : S3} (h : FrameOwnedLive s)\n1092:theorem isLeaf_of_parentOf {P P' : List Place} (hlen : P'.length = P.length)\n1098:theorem step_fpLeaves_frameOwnedLive {k : K} {s s' : S3} (hwf : WF3 s)\n1289:theorem reachable_fpLeaves_frameOwnedLive {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n1323:theorem r1_read3_reachable {k : K} {statics : Statics} {ObR : MM02.ReadOblSpec} {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n1334:theorem r2_write3_reachable {k : K} {statics : Statics} {C : Nat → Nat → Prop}\n1346:theorem r2_writeShared_reachable {k : K} {statics : Statics} {C : Nat → Nat → Prop}\n1360:theorem exists_leaf {s : S3} (hwf : WF3 s) : ∀ m q, s.P.length ≤ q + m → q < s.P.length →\n1373:def rootAlloc (L : Layout) (P : List Place) (r : Nat) : Nat := (L ((footprint P r).headD r)).alloc\n1375:theorem headD_mem_footprint {s : S3} (hwf : WF3 s) {r : Nat} (hr : r < s.P.length) :\n1383:theorem rootAlloc_eq {L : Layout} {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3)\n1392:def deallocOps (ids : List Nat) (au : Nat) : List Op2 := ids.map fun i => .dealloc i au\n1394:theorem dealloc_allocs (s : MM02.State) (id i : Nat) :\n1398:theorem exec_deallocOps (au : Nat) : ∀ (ids : List Nat) (s : MM02.State) (j : Nat),\n1418:theorem deallocOps_ok {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n1434:theorem ReprB.shrink {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n1459:theorem repr_deallocs {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}\n1522:theorem posIn_cons_eq {a r : Nat} {l : List Nat} (h : a = r) : posIn r (a :: l) = 0 := by\n1525:theorem posIn_cons_ne {a r : Nat} {l : List Nat} (h : ¬ a = r) :\n1531:theorem posIn_inj : ∀ {l : List Nat} {r₁ r₂ : Nat}, r₁ ∈ l → r₂ ∈ l →\n1545:theorem index_inj_of_lt : ∀ {l : List Nat}, l.Pairwise (· < ·) → ∀ {i j x : Nat},\n1563:theorem kids_lt (P : List Place) (x : Nat) : (kids P x).Pairwise (· < ·) :=\n1567:theorem partOf_parent_of_ne {P : List Place} {r src p : Nat} (hr : partOf P r src)\n1578:theorem corr_parent {s : S3} (hw : WF3 s) {src dst r x : Nat} (hr : partOf s.P r src)\n1598:theorem corr_ne_dst {s : S3} (hw : WF3 s) {src dst r : Nat} (hd : dst < s.P.length)\n1609:theorem corr_inj_aux {s : S3} (hw : WF3 s) {src dst : Nat} (hd : dst < s.P.length) :\n1631:theorem corr_leaf_fwd {s : S3} (hw : WF3 s) {src dst : Nat} (hd : dst < s.P.length)\n1648:theorem corr_leaf_back {s : S3} {src dst : Nat} (hsh : SameShape s.P src dst)\n1662:theorem corr_inj {s : S3} (hw : WF3 s) {src dst : Nat} (hd : dst < s.P.length)\n1673:def FreeSound (k : K) (C : Nat → Nat → Prop) (L : Layout) (s3 : S3) (s2 : MM02.State)\n1681:def TokCompat (C : Nat → Nat → Prop) (tok : Nat → Nat) : Prop := ∀ f, C (tok f) (tok f)\n1683:theorem exec_readOps (s2 s2' : MM02.State) (L : Layout) :\n1690:theorem r6_read3 {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}\n1714:theorem r6_a