xioms: [propext]\n'List.pairwise_map' depends on axioms: [propext, Quot.sound]\n'List.Pairwise.imp_of_mem' does not depend on any axioms\n'List.pairwise_cons' does not depend on any axioms\n@List.pairwise_cons : ∀ {α : Type u_1} {R : α → α → Prop} {a : α} {l : List α},\n  List.Pairwise R (a :: l) ↔ (∀ (a' : α), a' ∈ l → R a a') ∧ List.Pairwise R l","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"10bbe641-e53a-406a-aae5-657484a604ec","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/refinement_0.1","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"8af67a5a-fac1-4ff0-b2a2-97d33ca46301","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
