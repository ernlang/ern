43,"oldLines":4,"newStart":143,"newLines":160,"lines":["     rw [← h.eff b l hb (mem_footprint.1 hl).1]","     exact hc l hl'"," ","+/-! ## The creation phase and the transfer phases -/","+","+/-- A leaf of the footprint of `q` is `q` or one of its parts (Spec 1 §40), so not below it. -/","+theorem fp_ge {P : List Place} {q l : Nat} (h : l ∈ footprint P q) : q ≤ l := by","+  obtain ⟨-, -, -, h | h⟩ := mem_footprint.1 h","+  · omega","+  · exact Nat.le_of_lt (chain_lt h)","+","+/-- Authorities appended without origin are no descendants: they leave the effective modes of the","+existing authorities unchanged (Spec 1 §43). -/","+theorem effective_append_none {u v : S3} {N : List Authority} (hA : u.A = v.A ++ N)","+    (hN : ∀ z ∈ N, z.origin = none) {b : Nat} (hb : b < v.A.length) (l : Nat) :","+    effective u b l = effective v b l := by","+  have hold : ∀ j, j < v.A.length → u.A[j]? = v.A[j]? := fun j hj => by","+    rw [hA, List.getElem?_append_left hj]","+  have horg : ∀ j, j < v.A.length → u.org j = v.org j := fun j hj => by","+    show (u.A[j]?).bind (·.origin) = (v.A[j]?).bind (·.origin); rw [hold j hj]","+  have hd : descModes u b l = descModes v b l := by","+    unfold descModes","+    have hlen : u.A.length = v.A.length + N.length := by rw [hA, List.length_append]","+    rw [hlen, List.range_add, List.filterMap_append]","+    have h2 : ((List.range N.length).map (v.A.length + ·)).filterMap (fun j =>","+        match u.A[j]? with","+        | some y => if y.active = true ∧ l ∈ y.footprint ∧ b ∈ u.ancs j then some y.mode else none","+        | none => none) = [] := by","+      rw [List.filterMap_eq_nil_iff]","+      intro j hj","+      obtain ⟨i, -, rfl⟩ := List.mem_map.1 hj","+      cases hy : u.A[v.A.length + i]? with","+      | none => rfl","+      | some y =>","+        have hy' : y ∈ N := by","+          rw [hA, List.getElem?_append_right (by omega)] at hy","+          simp only [Nat.add_sub_cancel_left] at hy","+          exact List.mem_of_getElem? hy","+        have hno : u.org (v.A.length + i) = none := by","+          show (u.A[v.A.length + i]?).bind (·.origin) = none; rw [hy]; exact hN y hy'","+        simp [S3.ancs, chain_none hno]","+    rw [h2, List.append_nil]","+    refine filterMap_congr' fun j hj => ?_","+    have hj' := List.mem_range.1 hj","+    rw [hold j hj']","+    have : u.ancs j = v.ancs j := chain_congr fun i hi => horg i (by omega)","+    rw [this]","+  unfold effective; rw [hold b hb, hd]","+","+/-- The current frame of a context with a nonempty stack is the head of its stack (WC5.2 C2). -/","+theorem view_top_eq {s : SC} {c : Nat} (hne : s.stk c ≠ []) :","+    (s.view c).top = (s.stk c).headD 0 := by","+  obtain ⟨f, r, hfr⟩ := List.exists_cons_of_ne_nil hne","+  show (s.stk c ++ _).headD 0 = _","+  rw [hfr]; rfl","+","+/-- The creation phase of the by-value composite (WC5.2 C5 phase 1) is a phase state. -/","+theorem phaseRel_create {s : SC} {c : Nat} {ls : LocalShape} (hw : WF3 s.flat)","+    (hw₀ : WF3 (spawnCreate s c ls).flat) (hsh : ShapeOK s.P.length ls.toShape)","+    (hl : s.Live c) (hne : s.stk c ≠ []) : PhaseRel s c (spawnCreate s c ls) := by","+  have hP : (spawnCreate s c ls).P = shapeP s.P (.frame s.nF) ls.toShape := rfl","+  have hA : (spawnCreate s c ls).A = (enterEff (s.view c) [] ls).A := rfl","+  have hold : ∀ a, a < s.A.length → (spawnCreate s c ls).A[a]? = s.A[a]? := fun a ha => by","+    rw [hA, Frames.enter_lt (s := s.view c) ha]","+    show ((s.A[a]?).map _) = _","+    cases s.A[a]? <;> simp","+  have hps := pskel_shapeP (hd := .frame s.nF) hsh","+  refine ⟨by rw [hP]; exact hps.1, ?_, fun q o h => (hw₀.parent_lt h).1, fun q hq l => ?_,","+    fun q l hq h => Nat.le_trans hq (fp_ge h), fun a y p hy ya hp => ?_, fun a y hy ha => ?_,","+    fun a y hy ha => ?_, fun b l hb _ => ?_, ?_⟩","+  · rw [hA]; simp [enterEff, length_mapI]","+  · rw [hP]; exact footprint_shapeP hsh hq l","+  · have := hw₀.holders a y hy ya","+    rw [hp] at this; exact this.lt","+  · rw [hold a ha] at hy","+    exact ⟨y, hy, rfl, fun _ h => h, fun _ h _ => h⟩","+  · rw [hA] at hy","+    rcases Frames.enter_get (s := s.view c) hy with ⟨hlt, -⟩ | ⟨-, i, -, rfl⟩","+    · exact absurd ha (by show ¬ s.A.length ≤ a; exact Nat.not_le.2 hlt)","+    · rfl","+  · have hAeq : (spawnCreate s c ls).flat.A = s.flat.A ++","+        (rootIdx ls.toShape).map fun i => (⟨.modify, none, footprint (enterP (s.view c) ls)","+          ((s.view c).P.length + i), .frame (s.view c).nF, true⟩ : Authority) := by","+      show (enterEff (s.view c) [] ls).A = _","+      simp only [enterEff]","+      rw [mapI_id 0 _ fun _ _ => by simp]","+      rfl","+    exact effective_append_none hAeq (fun z hz => by","+      obtain ⟨i, -, rfl⟩ := List.mem_map.1 hz; rfl) hb l","+  · rw [view_top_eq (by rw [stk_spawnCreate hl]; exact hne), view_top_eq hne, stk_spawnCreate hl]","+","+/-- A transfer phase whose destination is a fresh place keeps a phase state (WC5.2 C5 phase 2;","+Spec 1 §63 effect). -/","+theorem phaseRel_transfer {s t : SC} {c src dst : Nat} (h : PhaseRel s c t)","+    (hd : s.P.length ≤ dst) (hdl : dst < t.P.length) :","+    PhaseRel s c (transferEffC t c src dst) := by","+  have hP : (transferEffC t c src dst).P = (transferEff (t.view c) src dst).P := rfl","+  have hget : ∀ j : Nat, (transferEffC t c src dst).A[j]? = (t.A[j]?).map fun (y : Authority) =>","+      if heldIn t.P src y.holder then { y with holder := mvTo t.P src dst y.holder } else y :=","+    fun j => transfer_A_get (t.view c) src dst j","+  have hlenP : (transferEffC t c src dst).P.length = t.P.length := by","+    rw [hP, transfer_len]; rfl","+  have hpar : parentOf (transferEffC t c src dst).P = parentOf t.P := by","+    rw [hP, transfer_parentOf]; rfl","+  have hfp : ∀ q, footprint (transferEffC t c src dst).P q = footprint t.P q := fun q => by","+    rw [hP, transfer_footprint]; rfl","+  refine ⟨by rw [hlenP]; exact h.lenP, ?_, fun q o hq => h.parentLt q o (by rwa [hpar] at hq),","+    fun q hq l => by rw [hfp]; exact h.fpOld q hq l, fun q l hq hl => h.fpNew q l hq (by","+      rwa [hfp] at hl), fun a y p hy ya hp => ?_, fun a y hy ha => ?_, fun a y hy ha => ?_,","+    fun b l hb hl => ?_, rfl⟩","+  · show (transferEff (t.view c) src dst).A.length ≤ _ |>.symm ▸ h.lenA","+    have : (transferEff (t.view c) src dst).A.length = t.A.length := by simp [transferEff]; rfl","+    exact this ▸ h.lenA","+  · rw [hget] at hy","+    obtain ⟨y₁, hy₁, rfl⟩ := Option.map_eq_some_iff.1 hy","+    split at hp","+    · rename_i hh","+      cases hq : y₁.holder with","+      | frame f => rw [hq] at hh; exact hh.elim","+      | place r =>","+        rw [hq] at hp","+        obtain ⟨p', hp', -, hlt⟩ := mvTo_ge h.parentLt hd hdl r","+        rw [hp'] at hp; cases hp","+        rw [hlenP]; exact hlt","+    · rw [hlenP]; exact h.holdLt a y₁ p hy₁ (by split at ya <;> simp_all) hp","+  · rw [hget] at hy","+    obtain ⟨y₁, hy₁, rfl⟩ := Option.map_eq_some_iff.1 hy","+    obtain ⟨y₀, hy₀, hsk, hfr, hpl⟩ := h.aOld a y₁ hy₁ ha","+    refine ⟨y₀, hy₀, by split <;> exact hsk, fun f hf => ?_, fun p hp hpo => ?_⟩","+    · split at hf","+      · rename_i hh","+        cases hq : y₁.holder with","+        | frame f' => rw [hq] at hh; exact hh.elim","+        | place r =>","+          rw [hq] at hf","+          obtain ⟨p', hp', -⟩ := mvTo_ge h.parentLt hd hdl r","+          rw [hp'] at hf; cases hf","+      · exact hfr f hf","+    · split at hp","+      · rename_i hh","+        cases hq : y₁.holder with","+        | frame f' => rw [hq] at hh; exact hh.elim","+        | place r =>","+          rw [hq] at hp","+          obtain ⟨p', hp', hge, -⟩ := mvTo_ge h.parentLt hd hdl r","+          rw [hp'] at hp; cases hp","+          omega","+      · exact hpl p hp hpo","+  · rw [hget] at hy","+    obtain ⟨y₁, hy₁, rfl⟩ := Option.map_eq_some_iff.1 hy","+    have hn := h.aNew a y₁ hy₁ ha","+    have : ¬ heldIn t.P src y₁.holder := by rw [hn]; exact id","+    simp only [this, ↓reduceIte]; exact hn","+  · rw [← h.eff b l hb hl]","+    have h1 := (transfer_skel (t.view c) src dst).effective b l","+    rw [effective_of_A (t := (transferEffC t c src dst).flat)","+      (t' := transferEff (t.view c) src dst) rfl, h1]","+    exact effective_of_A rfl b l","+"," end Ern.Concurrency.FullEncap"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/SpawnValCap.lean"]}},"serverClassifierContext":{"request":"3da3bcae-8df6-413d-a332-a47c2e4a9394","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"81a2e8a6-2b1c-4251-ac05-6ac4a93c0e55","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"5316f400e42ae5d92cfdc08d8394d75c3969fb5b221968f393bcd417b4a792b4","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01AgiCfT4XF7sChw8Uv8PEUx","name":"Bash","input":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && grep -n \"def ParamsOK\" -A 3 Ern/Concurrency/*.lean | head -5; python3 - <<'EOF'\np='Ern/Concurrency/FullEncap/SpawnValCap.lean'\ns=open(p).read()\nadd='''\n/-! ## The creation phase and the transfer phases -/\n\n/-- A leaf of the footprint of `q` is `q` or one of its parts (Spec 1 §40), so not below it. -/\ntheorem fp_ge {P : List Place} {q l : Nat} (h : l ∈ footprint P q) : q ≤ l := by\n  obtain ⟨-, -, -, h | h⟩ := mem_footprint.1 h\n  · omega\n  · exact Nat.le_of_lt (chain_lt h)\n\n/-- Authorities appended without origin are no descendants: they leave the effective modes of the\nexisting authorities unchanged (Spec 1 §43). -/\ntheorem effective_append_none {u v : S3} {N : List Authority} (hA : u.A = v.A ++ N)\n    (hN : ∀ z ∈ N, z.origin = none) {b : Nat} (hb : b < v.A.length) (l : Nat) :\n    effective u b l = effective v b l := by\n  have hold : ∀ j, j < v.A.length → u.A[j]? = v.A[j]? := fun j hj => by\n    rw [hA, List.getElem?_append_left hj]\n  have horg : ∀ j, j < v.A.length → u.org j = v.org j := fun j hj => by\n    show (u.A[j]?).bind (·.origin) = (v.A[j]?).bind (·.origin); rw [hold j hj]\n  have hd : descModes u b l = descModes v b l := by\n    unfold descModes\n    have hlen : u.A.length = v.A.length + N.length := by rw [hA, List.length_append]\n    rw [hlen, List.range_add, List.filterMap_append]\n    have h2 : ((List.range N.length).map (v.A.length + ·)).filterMap (fun j =>\n        match u.A[j]? with\n        | some y => if y.active = true ∧ l ∈ y.footprint ∧ b ∈ u.ancs j then some y.mode else none\n        | none => none) = [] := by\n      rw [List.filterMap_eq_nil_iff]\n      intro j hj\n      obtain ⟨i, -, rfl⟩ := List.mem_map.1 hj\n      cases hy : u.A[v.A.length + i]? with\n      | none => rfl\n      | some y =>\n        have hy' : y ∈ N := by\n          rw [hA, List.getElem?_append_right (by omega)] at hy\n          simp only [Nat.add_sub_cancel_left] at hy\n          exact List.mem_of_getElem? hy\n        have hno : u.org (v.A.length + i) = none := by\n          show (u.A[v.A.length + i]?).bind (·.origin) = none; rw [hy]; exact hN y hy'\n        simp [S3.ancs, chain_none hno]\n    rw [h2, List.append_nil]\n    refine filterMap_congr' fun j hj => ?_\n    have hj' := List.mem_range.1 hj\n    rw [hold j hj']\n    have : u.ancs j = v.ancs j := chain_congr fun i hi => horg i (by omega)\n    rw [this]\n  unfold effective; rw [hold b hb, hd]\n\n/-- The current frame of a context with a nonempty stack is the head of its stack (WC5.2 C2). -/\ntheorem view_top_eq {s : SC} {c : Nat} (hne : s.stk c ≠ []) :\n    (s.view c).top = (s.stk c).headD 0 := by\n  obtain ⟨f, r, hfr⟩ := List.exists_cons_of_ne_nil hne\n  show (s.stk c ++ _).headD 0 = _\n  rw [hfr]; rfl\n\n/-- The creation phase of the by-value composite (WC5.2 C5 phase 1) is a phase state. -/\ntheorem phaseRel_create {s : SC} {c : Nat} {ls : LocalShape} (hw : WF3 s.flat)\n    (hw₀ : WF3 (spawnCreate s c ls).flat) (hsh : ShapeOK s.P.length ls.toShape)\n    (hl : s.Live c) (hne : s.stk c ≠ []) : PhaseRel s c (spawnCreate s c ls) := by\n  have hP : (spawnCreate s c ls).P = shapeP s.P (.frame s.nF) ls.toShape := rfl\n  have hA : (spawnCreate s c ls).A = (enterEff (s.view c) [] ls).A := rfl\n  have hold : ∀ a, a < s.A.length → (spawnCreate s c ls).A[a]? = s.A[a]? := fun a ha => by\n    rw [hA, Frames.enter_lt (s := s.view c) ha]\n    show ((s.A[a]?).map _) = _\n    cases s.A[a]? <;> simp\n  have hps := pskel_shapeP (hd := .frame s.nF) hsh\n  refine ⟨by rw [hP]; exact hps.1, ?_, fun q o h => (hw₀.parent_lt h).1, fun q hq l => ?_,\n    fun q l hq h => Nat.le_trans hq (fp_ge h), fun a y p hy ya hp => ?_, fun a y hy ha => ?_,\n    fun a y hy ha => ?_, fun b l hb _ => ?_, ?_⟩\n  · rw [hA]; simp [enterEff, length_mapI]\n  · rw [hP]; exact footprint_shapeP hsh hq l\n  · have := hw₀.holders a y hy ya\n    rw [hp] at this; exact this.lt\n  · rw [hold a ha] at hy\n    exact ⟨y, hy, rfl, fun _ h => h, fun _ h _ => h⟩\n  · rw [hA] at hy\n    rcases Frames.enter_get (s := s.view c) hy with ⟨hlt, -⟩ | ⟨-, i, -, rfl⟩\n    · exact absurd ha (by show ¬ s.A.length ≤ a; exact Nat.not_le.2 hlt)\n    · rfl\n  · have hAeq : (spawnCreate s c ls).flat.A = s.flat.A ++\n        (rootIdx ls.toShape).map fun i => (⟨.modify, none, footprint (enterP (s.view c) ls)\n          ((s.view c).P.length + i), .frame (s.view c).nF, true⟩ : Authority) := by\n      show (enterEff (s.view c) [] ls).A = _\n      simp only [enterEff]\n      rw [mapI_id 0 _ fun _ _ => by simp]\n      rfl\n    exact effective_append_none hAeq (fun z hz => by\n      obtain ⟨i, -, rfl⟩ := List.mem_map.1 hz; rfl) hb l\n  · rw [view_top_eq (by rw [stk_spawnCreate hl]; exact hne), view_top_eq hne, stk_spawnCreate hl]\n\n/-- A transfer phase whose destination is a fresh place keeps a phase state (WC5.2 C5 phase 2;\nSpec 1 §63 effect). -/\ntheorem phaseRel_transfer {s t : SC} {c src dst : Nat} (h : PhaseRel s c t)\n    (hd : s.P.length ≤ dst) (hdl : dst < t.P.length) :\n    PhaseRel s c (transferEffC t c src dst) := by\n  have hP : (transferEffC t c src dst).P = (transferEff (t.view c) src dst).P := rfl\n  have hget : ∀ j : Nat, (transferEffC t c src dst).A[j]? = (t.A[j]?).map fun (y : Authority) =>\n      if heldIn t.P src y.holder then { y with holder := mvTo t.P src dst y.holder } else y :=\n    fun j => transfer_A_get (t.view c) src dst j\n  have hlenP : (transferEffC t c src dst).P.length = t.P.length := by\n    rw [hP, transfer_len]; rfl\n  have hpar : parentOf (transferEffC t c src dst).P = parentOf t.P := by\n    rw [hP, transfer_parentOf]; rfl\n  have hfp : ∀ q, footprint (transferEffC t c src dst).P q = footprint t.P q := fun q => by\n    rw [hP, transfer_footprint]; rfl\n  refine ⟨by rw [hlenP]; exact h.lenP, ?_, fun q o hq => h.parentLt q o (by rwa [hpar] at hq),\n    fun q hq l => by rw [hfp]; exact h.fpOld q hq l, fun q l hq hl => h.fpNew q l hq (by\n      rwa [hfp] at hl), fun a y p hy ya hp => ?_, fun a y hy ha => ?_, fun a y hy ha => ?_,\n    fun b l hb hl => ?_, rfl⟩\n  · show (transferEff (t.view c) src dst).A.length ≤ _ |>.symm ▸ h.lenA\n    have : (transferEff (t.view c) src dst).A.length = t.A.length := by simp [transferEff]; rfl\n    exact this ▸ h.lenA\n  · rw [hget] at hy\n    obtain ⟨y₁, hy₁, rfl⟩ := Option.map_eq_some_iff.1 hy\n    split at hp\n    · rename_i hh\n      cases hq : y₁.holder with\n      | frame f => rw [hq] at hh; exact hh.elim\n      | place r =>\n        rw [hq] at hp\n        obtain ⟨p', hp', -, hlt⟩ := mvTo_ge h.parentLt hd hdl r\n        rw [hp'] at hp; cases hp\n        rw [hlenP]; exact hlt\n    · rw [hlenP]; exact h.holdLt a y₁ p hy₁ (by split at ya <;> simp_all) hp\n  · rw [hget] at hy\n    obtain ⟨y₁, hy₁, rfl⟩ := Option.map_eq_some_iff.1 hy\n    obtain ⟨y₀, hy₀, hsk, hfr, hpl⟩ := h.aOld a y₁ hy₁ ha\n    refine ⟨y₀, hy₀, by split <;> exact hsk, fun f hf => ?_, fun p hp hpo => ?_⟩\n    · split at hf\n      · rename_i hh\n        cases hq : y₁.holder with\n        | frame f' => rw [hq] at hh; exact hh.elim\n        | place r =>\n          rw [hq] at hf\n          obtain ⟨p', hp', -⟩ := mvTo_ge h.parentLt hd hdl r\n          rw [hp'] at hf; cases hf\n      · exact hfr f hf\n    · split at hp\n      · rename_i hh\n        cases hq : y₁.holder with\n        | frame f' => rw [hq] at hh; exact hh.elim\n        | place r =>\n          rw [hq] at hp\n          obtain ⟨p', hp', hge, -⟩ := mvTo_ge h.parentLt hd hdl r\n          rw [hp'] at hp; cases hp\n          omega\n      · exact hpl p hp hpo\n  · rw [hget] at hy\n    obtain ⟨y₁, hy₁, rfl⟩ := Option.map_eq_some_iff.1 hy\n    have hn := h.aNew a y₁ hy₁ ha\n    have : ¬ heldIn t.P src y₁.holder := by rw [hn]; exact id\n    simp only [this, ↓reduceIte]; exact hn\n  · rw [← h.eff b l hb hl]\n    have h1 := (transfer_skel (t.view c) src dst).effective b l\n    rw [effective_of_A (t := (transferEffC t c src dst).flat)\n      (t' := transferEff (t.view c) src dst) rfl, h1]\n    exact effective_of_A rfl b l\n\nend Ern.Concurrency.FullEncap'''\nassert s.count('\\nend Ern.Concurrency.FullEncap')==1\ns=s.replace('\\nend Ern.Concurrency.FullEncap', add, 1)\nopen(p,'w').write(s)\nEOF\ntime ~/.elan/bin/lake env lean Ern/Concurrency/FullEncap/SpawnValCap.lean 2>&1 | head -80","description":"Add phase relation lemmas","timeout":900000},"caller":{"type":"direct"}}]}}
