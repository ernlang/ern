{"parentUuid":"6cac2632-e843-4e88-b8b4-292492b6cf19","isSidechain":false,"promptId":"afea6d65-2af9-420c-969b-b55d07c96f18","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019K6WZTtQyBCTa1n2cGyaSu","type":"tool_result","content":"3384\tnamespace CaseInit\n3385\t\n3386\t/-- One static leaf, declared `Init`, in a 4-byte range of the static allocation. -/\n3387\tdef st : Statics := [((none, none, 0), true)]\n3388\tdef L : Layout := fun _ => ⟨0, 0, 4⟩\n3389\tdef tk : Nat → Nat := fun f => 100 + f\n3390\t/-- Provider tokens (L4) and the ghost `provOf`: no root is allocated by `alloc`. -/\n3391\tdef ptk : Nat → Nat := fun pr => 6 + pr\n3392\tdef prov : Nat → Option Nat := fun _ => none\n3393\tdef g : Nat → Geom := fun _ => ⟨0, 4, 4⟩\n3394\tdef w : Nat → Nat → UInt8 × Option Nat := fun l i => ((l + i).toUInt8, none)\n3395\t/-- Test obligations (K5): `dec`, an access aligned on 4 bytes; `stat`, true. -/\n3396\tdef obR : MM02.ReadOblSpec := ⟨fun _ ac => ac.addr % 4 = 0, fun _ _ => True⟩\n3397\tdef obW : MM02.WriteOblSpec := ⟨fun _ ac _ => ac.addr % 4 = 0, fun _ _ _ => True⟩\n3398\tinstance : ∀ s o, Decidable (Op2.Dec obR obW s o) := fun s o => by\n3399\t  cases o <;> simp only [Op2.Dec, obR, obW] <;> infer_instance\n3400\tdef s2 : MM02.State := exec MM02.State.empty (initOps topPlacement g tk L w st)\n3401\t\n3402\t/-- `repr_init` on the static storage, and the same verdict by `decide`; without the write of the\n3403\tstatic, `Repr` fails (K3: an `Init` leaf has its bytes initialised). -/\n3404\texample : ReprB tk ptk prov L (S3.init st) s2 :=\n3405\t  (repr_init (C := fun _ _ => False) (ObR := obR) (ObW := obW) (by decide) topPlacement_ok\n3406\t    (by decide) (by decide) (by decide) (fun _ _ _ => trivial) (by decide)).2.toReprB\n3407\texample : ReprB tk ptk prov L (S3.init st) s2 := by decide\n3408\texample : ¬ ReprB tk ptk prov L (S3.init st)\n3409\t    (exec MM02.State.empty (allocOps topPlacement g (some (tk 0)) MM02.State.empty [0])) := by\n3410\t  decide\n3411\t\n3412\t/-- Counterexample kept (report, (f)): the draft `canRead3` does not ask the leaves read to be\n3413\tusable (MM-03.3 O9.1). In a state outside the reached ones, where the static 0 is freed but its\n3414\troot authority stays active, `read3` is `ok`, `Repr` holds, and the MM-02 read is `ub`: R1 needs\n3415\t`NoDangling`. -/\n3416\tdef cx : S3 := { S3.init st with dead := fun _ => true, freed := fun _ => true }\n3417\tdef cx2 : MM02.State := s2.dealloc 0\n3418\texample : ReprB tk ptk prov L cx cx2 := by decide\n3419\texample : Read3Step 0 [0] cx (.ok cx) := .ok (by decide)\n3420\texample : MM02.ReadStep obR (leafAcc cx2 L .read 0) cx2 .ub :=\n3421\t  .ub fun ⟨h, _⟩ => absurd h (by decide)\n3422\texample : ¬ NoDangling cx := fun h => h 0 _ rfl rfl 0 (by decide) 0 (by decide) (by decide)\n3423\t\n3424\tend CaseInit\n3425\t\n3426\tnamespace Cases\n3427\t\n3428\t/-- Test contracts: leaf 5 `SharedMutable`; `ExternalDone` for 2; place 6 deallocable with the\n3429\tauthority 7; the allocator at place 1 satisfiable, any other not. -/\n3430\tdef KC : K := ⟨fun _ _ => False, (· ∈ [5]), (· ∈ ([] : List Nat)), (· ∈ [2]), (· ∈ [6]),\n3431\t  fun p a => (p, a) ∈ [(6, 7)], fun pr _ _ => pr = 1⟩\n3432\tinstance : ∀ r r', Decidable (KC.DeclaredDisjoint r r') := fun _ _ => instDecidableFalse\n3433\tinstance : DecidablePred KC.SharedMutable := fun l => inferInstanceAs (Decidable (l ∈ [5]))\n3434\tinstance : DecidablePred KC.Pinned := fun l => inferInstanceAs (Decidable (l ∈ ([] : List Nat)))\n3435\tinstance : DecidablePred KC.ExternalDone := fun l => inferInstanceAs (Decidable (l ∈ [2]))\n3436\tinstance : DecidablePred KC.Deallocable := fun p => inferInstanceAs (Decidable (p ∈ [6]))\n3437\tinstance : ∀ p a, Decidable (KC.FreeCompat p a) :=\n3438\t  fun p a => inferInstanceAs (Decidable ((p, a) ∈ [(6, 7)]))\n3439\tinstance : ∀ p ls s, Decidable (KC.Satisfiable p ls s) :=\n3440\t  fun p _ _ => inferInstanceAs (Decidable (p = 1))\n3441\ttheorem kc_dd : DDSound KC := fun _ _ h => h.elim\n3442\t\n3443\t/-- The scenario. Static 0 (`Init`). Frame 1 with locals 1 (an allocator value), 2 (owner of\n3444\tallocated storage, then arena value) and 3, a value with fields 4 and 5. Then: writes of 1 and 2,\n3445\tread of 1, `derive` of 4 from the root of 3 and its `release`, `split` of 3 into 4 and 5, `write3`\n3446\tof 4, `writeShared` of 5, `depend` of 2 on the root of 1, `pin` and `unpin` of 2, `alloc` of the\n3447\tstorage 6 owned by 2 (`fail` from the allocator 2), `newArena` on 6, `reset`, `endUse` of 2 (6\n3448\tdies, not freed), `exitFrame`. On a branch, `free` of 6 after its allocation. -/\n3449\tdef st : Statics := [((none, none, 0), true)]\n3450\tdef lsF : List (Option Nat × Option Nat × Nat) :=\n3451\t  [(none, none, 0), (none, none, 0), (none, none, 0), (some 3, none, 0), (some 3, none, 0)]\n3452\tdef e0 : S3 := S3.init st\n3453\tdef e1 : S3 := enterEff e0 [] lsF\n3454\tdef e2 : S3 := write3Eff e1 [1]\n3455\tdef e3 : S3 := write3Eff e2 [2]\n3456\tdef e4 : S3 := deriveEff e3 3 4 .observe\n3457\tdef e5 : S3 := releaseEff e4 4\n3458\tdef e6 : S3 := splitEff e5 3 [[4], [5]]\n3459\tdef e7 : S3 := write3Eff e6 [4]\n3460\tdef e8 : S3 := write3Eff e7 [5]\n3461\tdef e9 : S3 := dependEff e8 2 1\n3462\tdef e10 : S3 := pinEff e9 2 true\n3463\tdef e11 : S3 := pinEff e10 2 false\n3464\tdef e12 : S3 := allocEff e11 1 2 [(none, none, 0)]\n3465\tdef e13 : S3 := newArenaEff e12 6 7\n3466\tdef e14 : S3 := resetAtEff e13 0\n3467\tdef e15 : S3 := endUseEff e14 2\n3468\tdef e16 : S3 := exitEff e15\n3469\tdef f13 : S3 := freeEff e12 6\n3470\t\n3471\ttheorem r0 : Reachable KC st e0 := .init (by decide)\n3472\ttheorem r1 : Reachable KC st e1 := .enter r0 (.ok (by decide))\n3473\ttheorem r2 : Reachable KC st e2 := .write r1 (.ok (by decide) : Write3Step 1 [1] e1 (.ok e2))\n3474\ttheorem r3 : Reachable KC st e3 := .write r2 (.ok (by decide) : Write3Step 2 [2] e2 (.ok e3))\n3475\ttheorem r4 : Reachable KC st e4 := .derive r3 (.ok (by decide) : DeriveStep 3 4 .observe e3 (.ok e4))\n3476\ttheorem r5 : Reachable KC st e5 := .release r4 (.ok (by decide) : ReleaseStep 4 e4 (.ok e5))\n3477\ttheorem r6 : Reachable KC st e6 := .split r5 (.ok (by decide) : SplitStep KC 3 [[4], [5]] e5 (.ok e6))\n3478\ttheorem r7 : Reachable KC st e7 := .write r6 (.ok (by decide) : Write3Step 5 [4] e6 (.ok e7))\n3479\ttheorem r8 : Reachable KC st e8 :=\n3480\t  .writeShared r7 (.ok (by decide) : WriteSharedStep KC 6 [5] e7 (.ok e8))\n3481\ttheorem r9 : Reachable KC st e9 := .depend r8 (.ok (by decide) : DependStep 2 1 e8 (.ok e9))\n3482\ttheorem r10 : Reachable KC st e10 := .pin r9 (.ok (by decide) : PinStep 2 e9 (.ok e10))\n3483\ttheorem r11 : Reachable KC st e11 := .unpin r10 (.ok (by decide) : UnpinStep KC 2 e10 (.ok e11))\n3484\ttheorem r12 : Reachable KC st e12 :=\n3485\t  .alloc r11 (.ok (by decide) (by decide) : AllocStep KC 1 2 [(none, none, 0)] e11 (.ok e12))\n3486\ttheorem r13 : Reachable KC st e13 := .newArena r12 (.ok (by decide) : NewArenaStep 6 7 e12 (.ok e13))\n3487\ttheorem r14 : Reachable KC st e14 := .reset r13 (.ok (by decide) : ResetAtStep KC 0 2 e13 (.ok e14))\n3488\ttheorem r15 : Reachable KC st e15 := .endUse r14 (.ok (by decide) : EndUseStep KC 2 e14 (.ok e15))\n3489\ttheorem r16 : Reachable KC st e16 := .exit r15 (.ok (by decide) : ExitStep KC e15 (.ok e16))\n3490\ttheorem rf : Reachable KC st f13 := .free r12 (.ok (by decide) : FreeStep KC 6 7 e12 (.ok f13))\n3491\t\n3492\t/-- MM-02 parameters: compatibility by equality of tokens (so `TokCompat`); frame token `100 + f`;\n3493\tgeometry: 8 bytes aligned on 4; layout: one allocation per root, fields 4 and 5 at offsets 0 and 4\n3494\tof the allocation of 3; the bytes written in leaf `l` are `10 l + i`. -/\n3495\tdef C : Nat → Nat → Prop := fun a d => a = d\n3496\tdef tk : Nat → Nat := fun f => 100 + f\n3497\t/-- Provider tokens (L4): the allocator at place 1 has the token 7. Ghost `provOf`: the places 6\n3498\tand 7 are allocated from the provider 1. -/\n3499\tdef ptk : Nat → Nat := fun pr => 6 + pr\n3500\tdef prov : Nat → Option Nat := fun r => if r = 6 ∨ r = 7 then some 1 else none\n3501\tdef g : Nat → Geom := fun _ => ⟨0, 8, 4⟩\n3502\tdef L : Layout := fun q => match q with\n3503\t  | 0 => ⟨0, 0, 4⟩ | 1 => ⟨1, 0, 4⟩ | 2 => ⟨2, 0, 4⟩ | 3 => ⟨3, 0, 8⟩\n3504\t  | 4 => ⟨3, 0, 4⟩ | 5 => ⟨3, 4, 4⟩ | 6 => ⟨4, 0, 4⟩ | _ => ⟨99, 0, 0⟩\n3505\tdef w : Nat → Nat → UInt8 × Option Nat := fun l i => ((10 * l + i).toUInt8, none)\n3506\t/-- Test obligations (K5): `dec`, an access aligned on 4 bytes; `stat`, true. -/\n3507\tdef obR : MM02.ReadOblSpec := ⟨fun _ ac => ac.addr % 4 = 0, fun _ _ => True⟩\n3508\tdef obW : MM02.WriteOblSpec := ⟨fun _ ac _ => ac.addr % 4 = 0, fun _ _ _ => True⟩\n3509\tinstance : ∀ s o, Decidable (Op2.Dec obR obW s o) := fun s o => by\n3510\t  cases o <;> simp only [Op2.Dec, obR, obW] <;> infer_instance\n3511\t\n3512\t/-- The MM-02 sequences attached to the steps (K4) and the states they reach. -/\n3513\tdef m0 : MM02.State := exec MM02.State.empty (initOps topPlacement g tk L w st)\n3514\tdef ops1 : List Op2 := allocOps topPlacement g (some (tk e0.nF)) m0 (rootIdx lsF)\n3515\tdef m1 : MM02.State := exec m0 ops1\n3516\tdef ops2 : List Op2 := writeOps m1 L w [1]\n3517\tdef m2 : MM02.State := exec m1 ops2\n3518\tdef ops3 : List Op2 := writeOps m2 L w [2]\n3519\tdef m3 : MM02.State := exec m2 ops3\n3520\tdef ops7 : List Op2 := writeOps m3 L w [4]\n3521\tdef m7 : MM02.State := exec m3 ops7\n3522\tdef ops8 : List Op2 := writeOps m7 L w [5]\n3523\tdef m8 : MM02.State := exec m7 ops8\n3524\tdef ops12 : List Op2 :=\n3525\t  [.alloc (g 0).space (topPlacement m8 (g 0)) (g 0).size (g 0).align (some 7)]\n3526\tdef m12 : MM02.State := exec m8 ops12\n3527\tdef ops16 : List Op2 := exitOps L tk e15\n3528\tdef m16 : MM02.State := exec m12 ops16\n3529\tdef opsF : List Op2 := deallocOps [rootAlloc L e12.P 6] 7\n3530\tdef mF : MM02.State := exec m12 opsF\n3531\t\n3532\ttheorem wf_m0 : MM02.WF m0 := exec_wf _ _ fun _ _ => rfl\n3533\ttheorem wf_m1 : MM02.WF m1 := exec_wf _ _ wf_m0\n3534\ttheorem wf_m2 : MM02.WF m2 := exec_wf _ _ wf_m1\n3535\ttheorem wf_m3 : MM02.WF m3 := exec_wf _ _ wf_m2\n3536\ttheorem wf_m7 : MM02.WF m7 := exec_wf _ _ wf_m3\n3537\ttheorem wf_m8 : MM02.WF m8 := exec_wf _ _ wf_m7\n3538\ttheorem wf_m12 : MM02.WF m12 := exec_wf _ _ wf_m8\n3539\ttheorem wf_m16 : MM02.WF m16 := exec_wf _ _ wf_m12\n3540\ttheorem wf_mF : MM02.WF mF := exec_wf _ _ wf_m12\n3541\t\n3542\t/-- The sequences exhibited: the bases chosen by `topPlacement` for the locals (16, 28, 40) and the\n3543\tallocated storage (52), with their tokens; the deallocations of `exitFrame`, of the allocations 1,\n3544\t2, 3 of the roots owned by frame 1, with its token 101. -/\n3545\texample : (m1.allocs 1).map (·.base) = some 16 ∧ (m1.allocs 2).map (·.base) = some 28 ∧\n3546\t    (m1.allocs 3).map (·.base) = some 40 ∧ (m1.allocs 3).map (·.freeAuth) = some (some 101) := by\n3547\t  decide\n3548\texample : (m12.allocs 4).map (·.base) = some 52 ∧ (m12.allocs 4).map (·.live) = some true ∧\n3549\t    (m12.allocs 4).map (·.freeAuth) = some (some 7) := by decide\n3550\texample : (frameRoots e15 e15.top).map (rootAlloc L e15.P) = [1, 2, 3] ∧ tk e15.top = 101 := by\n3551\t  decide\n3552\t\n3553\t/-- `Repr` at each point, by `decide`. -/\n3554\texample : ReprB tk ptk prov L e0 m0 ∧ ReprB tk ptk prov L e1 m1 ∧ ReprB tk ptk prov L e2 m2 ∧ ReprB tk ptk prov L e3 m3 ∧\n3555\t    ReprB tk ptk prov L e6 m3 ∧ ReprB tk ptk prov L e8 m8 ∧ ReprB tk ptk prov L e12 m12 ∧ ReprB tk ptk prov L e15 m12 ∧\n3556\t    ReprB tk ptk prov L e16 m16 ∧ ReprB tk ptk prov L f13 mF := by decide\n3557\t\n3558\t/-- K3: initial state (`repr_init`). -/\n3559\texample : AllOk C obR obW MM02.State.empty (initOps topPlacement g tk L w st) ∧\n3560\t    Repr tk ptk prov L e0 m0 :=\n3561\t  repr_init (by decide) topPlacement_ok (by decide) (by decide) (by decide) (fun _ _ _ => trivial)\n3562\t    (by decide)\n3563\t/-- R6, `enterFrame`: three allocations, one per root local. -/\n3564\texample : AllOk C obR obW m0 ops1 ∧ Repr tk ptk prov L e1 m1 :=\n3565\t  r6_enter (reachable_invariants kc_dd r0).1 ⟨by decide, wf_m0⟩ topPlacement_ok (by decide)\n3566\t    (.ok (by decide)) (by decide) (by decide)\n3567\t/-- R2, `write3`. -/\n3568\texample : AllOk C obR obW m1 ops2 ∧ Repr tk ptk prov L e2 m2 :=\n3569\t  r2_write3_reachable kc_dd r1 ⟨by decide, wf_m1⟩ (.ok (by decide) : Write3Step 1 [1] e1 (.ok e2))\n3570\t    (fun _ _ _ => trivial) (by decide)\n3571\texample : AllOk C obR obW m2 ops3 ∧ Repr tk ptk prov L e3 m3 :=\n3572\t  r2_write3_reachable kc_dd r2 ⟨by decide, wf_m2⟩ (.ok (by decide) : Write3Step 2 [2] e2 (.ok e3))\n3573\t    (fun _ _ _ => trivial) (by decide)\n3574\texample : AllOk C obR obW m3 ops7 ∧ Repr tk ptk prov L e7 m7 :=\n3575\t  r2_write3_reachable kc_dd r6 ⟨by decide, wf_m3⟩ (.ok (by decide) : Write3Step 5 [4] e6 (.ok e7))\n3576\t    (fun _ _ _ => trivial) (by decide)\n3577\t/-- R2, `writeShared` under an authority of effective mode present. -/\n3578\texample : AllOk C obR obW m7 ops8 ∧ Repr tk ptk prov L e8 m8 :=\n3579\t  r2_writeShared_reachable kc_dd r7 ⟨by decide, wf_m7⟩\n3580\t    (.ok (by decide) : WriteSharedStep KC 6 [5] e7 (.ok e8)) (fun _ _ _ => trivial) (by decide)\n3581\t/-- R1 and R6, `read3`; the value read is the 4 bytes written by `write3` in leaf 1. -/\n3582\texample : AllOk C obR obW m3 (readOps m3 L [1]) ∧\n3583\t    Repr tk ptk prov L e3 (exec m3 (readOps m3 L [1])) :=\n3584\t  r6_read3 (reachable_invariants kc_dd r3).1 (reachable_invariants kc_dd r3).2.1.nd\n3585\t    (reachable_fpLeaves_frameOwnedLive kc_dd r3).1 ⟨by decide, wf_m3⟩\n3586\t    (.ok (by decide) : Read3Step 1 [1] e3 (.ok e3)) (fun _ _ => trivial) (fun l hl => by\n3587\t      rw [List.mem_singleton] at hl; subst hl; show (leafAcc m3 L .read 1).addr % 4 = 0; decide)\n3588\texample : ((m3.allocs 1).map fun a => a.bytesAt 0 4) =\n3589\t    some [.init 10 none, .init 11 none, .init 12 none, .init 13 none] := by decide\n3590\texample : ((m8.allocs 3).map fun a => a.bytesAt 0 8) = some [.init 40 none, .init 41 none,\n3591\t    .init 42 none, .init 43 none, .init 50 none, .init 51 none, .init 52 none, .init 53 none] := by\n3592\t  decide\n3593\t/-- R6, `alloc` `ok`: one allocation, at base 52, token 7. -/\n3594\texample : AllOk C obR obW m8 ops12 ∧ Repr tk ptk prov L e12 m12 :=\n3595\t  r6_alloc (i := 0) (ptok := ptk) (provOf := prov) (pr := 1) (reachable_invariants kc_dd r11).1\n3596\t    ⟨by decide, wf_m8⟩ topPlacement_ok\n3597\t    (by decide) (.ok (by decide) (by decide) : AllocStep KC 1 2 [(none, none, 0)] e11 (.ok e12)) rfl\n3598\t    (by decide) (by decide)\n3599\t/-- R6, `alloc` `fail`: allocator 2 not satisfiable, no step. -/\n3600\texample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e12 (exec m12 []) :=\n3601\t  r6_alloc_fail ⟨by decide, wf_m12⟩\n3602\t    (.fail (by decide) (by decide) : AllocStep KC 2 2 [(none, none, 0)] e12 (.fail e12))\n3603\t/-- R6, `free` of 6 with the authority 7: the allocation 4 dies. -/\n3604\texample : AllOk C obR obW m12 opsF ∧ Repr tk ptk prov L f13 mF :=\n3605\t  r6_free (k := KC) (auth := 7) (reachable_invariants kc_dd r12).1 ⟨by decide, wf_m12⟩\n3606\t    (fun _ => ⟨1, rfl, rfl⟩) (.ok (by decide))\n3607\texample : DeadAlloc mF 4 := by decide\n3608\t/-- R6, `exitFrame`: three deallocations; the storage 6, dead by `endUse` and not freed, keeps\n3609\tits allocation 4 live (leak, K3, K4). -/\n3610\texample : AllOk C obR obW m12 ops16 ∧ Repr tk ptk prov L e16 m16 :=\n3611\t  r6_exit_reachable kc_dd r15 ⟨by decide, wf_m12⟩ (fun _ => rfl) (.ok (by decide))\n3612\texample : DeadAlloc m16 1 ∧ DeadAlloc m16 2 ∧ DeadAlloc m16 3 ∧ LiveAlloc m16 4 ∧\n3613\t    LiveAlloc m16 0 := by decide\n3614\t/-- R6, the steps without MM-02 step (K4). After `endUse` of 2, the storage 6 is not usable and\n3615\tnot freed, and its allocation stays live. -/\n3616\texample : AllOk C obR obW m3 [] ∧ Repr tk ptk prov L e4 (exec m3 []) :=\n3617\t  r6_noStep (k := KC) ⟨by decide, wf_m3⟩ (.derive (.ok (by decide) : DeriveStep 3 4 .observe e3 (.ok e4)))\n3618\texample : AllOk C obR obW m3 [] ∧ Repr tk ptk prov L e5 (exec m3 []) :=\n3619\t  r6_noStep (k := KC) ⟨by decide, wf_m3⟩ (.release (.ok (by decide) : ReleaseStep 4 e4 (.ok e5)))\n3620\texample : AllOk C obR obW m3 [] ∧ Repr tk ptk prov L e6 (exec m3 []) :=\n3621\t  r6_noStep ⟨by decide, wf_m3⟩ (.split (.ok (by decide) : SplitStep KC 3 [[4], [5]] e5 (.ok e6)))\n3622\texample : AllOk C obR obW m8 [] ∧ Repr tk ptk prov L e9 (exec m8 []) :=\n3623\t  r6_noStep (k := KC) ⟨by decide, wf_m8⟩ (.depend (.ok (by decide) : DependStep 2 1 e8 (.ok e9)))\n3624\texample : AllOk C obR obW m8 [] ∧ Repr tk ptk prov L e10 (exec m8 []) :=\n3625\t  r6_noStep (k := KC) ⟨by decide, wf_m8⟩ (.pin (.ok (by decide) : PinStep 2 e9 (.ok e10)))\n3626\texample : AllOk C obR obW m8 [] ∧ Repr tk ptk prov L e11 (exec m8 []) :=\n3627\t  r6_noStep ⟨by decide, wf_m8⟩ (.unpin (.ok (by decide) : UnpinStep KC 2 e10 (.ok e11)))\n3628\texample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e13 (exec m12 []) :=\n3629\t  r6_noStep (k := KC) ⟨by decide, wf_m12⟩ (.newArena (.ok (by decide) : NewArenaStep 6 7 e12 (.ok e13)))\n3630\texample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e14 (exec m12 []) :=\n3631\t  r6_noStep ⟨by decide, wf_m12⟩ (.reset (.ok (by decide) : ResetAtStep KC 0 2 e13 (.ok e14)))\n3632\texample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e15 (exec m12 []) :=\n3633\t  r6_noStep ⟨by decide, wf_m12⟩ (.endUse (.ok (by decide) : EndUseStep KC 2 e14 (.ok e15)))\n3634\texample : ¬ e15.Usable 6 ∧ e15.freed 6 = false ∧ LiveAlloc m12 4 := by decide\n3635\t\n3636\t/-- R4 on the reached state after `exitFrame`: the authorities still active cover only the\n3637\tstatic leaf, in a live allocation. -/\n3638\texample : ∀ j < e16.A.length, e16.Active j → e16.afp j = [0] := by decide\n3639\texample : LiveAlloc m16 (L 0).alloc :=\n3640\t  (r4_no_dead_cover (tok := tk) (ptok := ptk) (provOf := prov) kc_dd r16 ⟨by decide, wf_m16⟩ 0 _\n3641\t    rfl rfl 0\n3642\t    (List.mem_singleton_self _)).2.2\n3643\t\n3644\t/-- `exclusive_bytes`: after `split`, authority 5 has effective `Modify` on leaf 4; the root 3,\n3645\tactive and covering 4, has no effective mode there; authority 6 keeps effective `Modify` on the\n3646\tadjacent range of leaf 5. A layout where the ranges of 4 and 5 overlap violates `LayoutWF`. -/\n3647\texample : effective e6 5 4 = some .modify ∧ e6.Active 3 ∧ 4 ∈ e6.afp 3 ∧\n3648\t    effective e6 6 5 = some .modify := by decide\n3649\texample : effective e6 3 4 = none :=\n3650\t  exclusive_bytes (L := L) (s2 := m3) (by decide) (reachable_invariants kc_dd r6).2.1.base.1\n3651\t    (l := 4) (l' := 4) (by decide) (by decide) (by decide) (by decide) (a := 5) (by decide)\n3652\t    (by decide) rfl (by decide)\n3653\tdef Lov : Layout := fun q => if q = 5 then ⟨3, 2, 4⟩ else L q\n3654\texample : ¬ LayoutWF Lov e6 m3 := by decide\n3655\t\n3656\t/-- K1 (d): the storage 6, a shape of one leaf, may have size zero. -/\n3657\tdef L0 : Layout := fun q => if q = 6 then ⟨4, 0, 0⟩ else L q\n3658\tdef m12z : MM02.State := exec m8 [.alloc 0 (topPlacement m8 ⟨0, 0, 4⟩) 0 4 (some 7)]\n3659\texample : ReprB tk ptk prov L0 e12 m12z := by decide\n3660\t\n3661\t/-- Each clause of `Repr` rejects a wrong MM-02 state: a usable root with a dead allocation; a\n3662\tleaked root deallocated at `endUse`; two roots in one allocation (`LayoutWF` holds); a wrong frame\n3663\ttoken; an exited root or a freed root whose allocation is still live. -/\n3664\texample : ¬ ReprB tk ptk prov L e3 (m3.dealloc 1) := by decide\n3665\texample : ¬ ReprB tk ptk prov L e15 (m12.dealloc 4) := by decide\n3666\tdef Lsh : Layout := fun q => if q = 2 then ⟨1, 4, 4⟩ else L q\n3667\texample : LayoutWF Lsh e1 m1 ∧ ¬ ReprB tk ptk prov Lsh e1 m1 := by decide\n3668\texample : ¬ ReprB (fun f => 200 + f) ptk prov L e1 m1 := by decide\n3669\texample : ¬ ReprB tk ptk prov L e16 m12 ∧ ¬ ReprB tk ptk prov L f13 m12 := by decide\n3670\t\n3671\t/-- Counterexample kept (report, (e), (f)): the draft accepts `alloc` of a shape with two roots,\n3672\twhere O14 creates one root; with the one `AllocStep` of K4, a layout putting both roots in the\n3673\tfresh allocation satisfies `LayoutWF` but not `Repr` (two roots, one allocation). -/\n3674\tdef e12b : S3 := allocEff e11 1 2 [(none, none, 0), (none, none, 0)]\n3675\texample : AllocStep KC 1 2 [(none, none, 0), (none, none, 0)] e11 (.ok e12b) :=\n3676\t  .ok (by decide) (by decide)\n3677\tdef L2 : Layout := fun q => if q = 7 then ⟨4, 4, 4⟩ else L q\n3678\tdef m12b : MM02.State := exec m8 [.alloc 0 (topPlacement m8 (g 0)) 8 4 (some 7)]\n3679\texample : LayoutWF L2 e12b m12b ∧ ¬ ReprB tk ptk prov L2 e12b m12b := by decide\n3680\t\n3681\t/-- Witness of question (e) 7 of the report: the storage 7, allocated with owner the storage 6,\n3682\tdies with the `free` of 6 (O13); `free` has one `DeallocStep`, of the allocation 4 of 6, and the\n3683\tallocation 5 of 7 stays live; deallocating it too breaks `Repr` (clause `leaked`). -/\n3684\tdef ao13 : S3 := allocEff e12 1 6 [(none, none, 0)]\n3685\tdef af14 : S3 := freeEff ao13 6\n3686\ttheorem ra13 : Reachable KC st ao13 :=\n3687\t  .alloc r12 (.ok (by decide) (by decide) : AllocStep KC 1 6 [(none, none, 0)] e12 (.ok ao13))\n3688\ttheorem ra14 : Reachable KC st af14 := .free ra13 (.ok (by decide) : FreeStep KC 6 7 ao13 (.ok af14))\n3689\tdef La : Layout := fun q => if q = 7 then ⟨5, 0, 4⟩ else L q\n3690\tdef na13 : MM02.State := exec m12 [.alloc 0 (topPlacement m12 (g 0)) 8 4 (some 7)]\n3691\tdef na14 : MM02.State := exec na13 (deallocOps [rootAlloc La ao13.P 6] 7)\n3692\texample : ReprB tk ptk prov La ao13 na13 ∧ ReprB tk ptk prov La af14 na14 := by decide\n3693\texample : ¬ af14.Usable 7 ∧ af14.freed 7 = false ∧ LiveAlloc na14 5 ∧ DeadAlloc na14 4 := by decide\n3694\texample : ¬ ReprB tk ptk prov La af14 (na14.dealloc 5) := by decide\n3695\t\n3696\t/-- Clauses K1 (a) and (c) reject a layout on their own among the clauses of `LayoutWF`: the field\n3697\t5 of 3 in a fresh allocation 4 (with the token of frame 1) other than the allocation 3 of the field\n3698\t4 breaks (a) only; the range of leaf 1 past the size of its allocation breaks (c) only. -/\n3699\tdef m3x : MM02.State := exec m3 [.alloc 0 (topPlacement m3 (g 0)) 8 4 (some (tk 1))]\n3700\tdef Lsa : Layout := fun q => if q = 5 then ⟨4, 0, 4⟩ else L q\n3701\texample : ¬ (∀ r < e6.P.length, RootPlace e6.P r → ∀ l ∈ footprint e6.P r,\n3702\t    ∀ l' ∈ footprint e6.P r, (Lsa l).alloc = (Lsa l').alloc) := by decide\n3703\tset_option synthInstance.maxSize 512 in\n3704\texample : (∀ l < e6.P.length, ∀ l' < e6.P.length, isLeaf e6.P l → isLeaf e6.P l' → l ≠ l' →\n3705\t    (Lsa l).alloc = (Lsa l').alloc →\n3706\t      MM02.RangeDisjoint (Lsa l).off (Lsa l).len (Lsa l').off (Lsa l').len) ∧\n3707\t    (∀ l < e6.P.length, isLeaf e6.P l →\n3708\t      AllocP m3x (Lsa l).alloc fun a => (Lsa l).off + (Lsa l).len ≤ a.size) := by decide\n3709\tdef Lwi : Layout := fun q => if q = 1 then ⟨1, 6, 4⟩ else L q\n3710\texample : ¬ (∀ l < e1.P.length, isLeaf e1.P l →\n3711\t    AllocP m1 (Lwi l).alloc fun a => (Lwi l).off + (Lwi l).len ≤ a.size) := by decide\n3712\tset_option synthInstance.maxSize 512 in\n3713\texample : (∀ r < e1.P.length, RootPlace e1.P r → ∀ l ∈ footprint e1.P r,\n3714\t      ∀ l' ∈ footprint e1.P r, (Lwi l).alloc = (Lwi l').alloc) ∧\n3715\t    (∀ l < e1.P.length, ∀ l' < e1.P.length, isLeaf e1.P l → isLeaf e1.P l' → l ≠ l' →\n3716\t      (Lwi l).alloc = (Lwi l').alloc →\n3717\t        MM02.RangeDisjoint (Lwi l).off (Lwi l).len (Lwi l').off (Lwi l').len) := by decide\n3718\t\n3719\t/-- R1 applied directly to the read of leaf 1 in `e3`: an allocation, the range initialised, a\n3720\tread of outcome `ok` with the bytes of the range, never `ub`. -/\n3721\texample : ∃ al, m3.allocs (L 1).alloc = some al ∧ al.InitRange (L 1).off (L 1).len ∧\n3722\t    MM02.ReadStep obR (leafAcc m3 L .read 1) m3 (.ok (al.bytesAt (L 1).off (L 1).len)) ∧\n3723\t    ¬ MM02.ReadStep obR (leafAcc m3 L .read 1) m3 .ub :=\n3724\t  r1_read3 (tok := tk) (reachable_invariants kc_dd r3).1 (reachable_invariants kc_dd r3).2.1.nd\n3725\t    (reachable_fpLeaves_frameOwnedLive kc_dd r3).1 (ptok := ptk) (provOf := prov) ⟨by decide, wf_m3⟩\n3726\t    (.ok (by decide) : Read3Step 1 [1] e3 (.ok e3)) (fun _ _ => trivial) (fun l hl => by\n3727\t      rw [List.mem_singleton] at hl; subst hl; show (leafAcc m3 L .read 1).addr % 4 = 0; decide)\n3728\t    1 (List.mem_singleton_self _)\n3729\t\n3730\t/-- Gap kept (report, (f) 4): after `free` of 6, the storage 7 it owns stops being usable but is\n3731\tnot marked dead, where O13 marks dead \"le stockage qui cesse de vivre\". -/\n3732\texample : af14.dead 7 = false ∧ ¬ af14.Usable 7 := by decide\n3733\t\n3734\t/-- Owned storage that dies with its frame (K4: no `DeallocStep` for it): `exitFrame` directly from\n3735\t`e12`, where the storage 6 is owned by the local 2; the allocations 1, 2, 3 die, the allocation 4 of\n3736\t6 stays live, as the clause `leaked` asks; deallocating it too breaks `Repr` (report, (c) 4). -/\n3737\tdef eX : S3 := exitEff e12\n3738\ttheorem rX : Reachable KC st eX := .exit r12 (.ok (by decide) : ExitStep KC e12 (.ok eX))\n3739\texample : AllOk C obR obW m12 (exitOps L tk e12) ∧\n3740\t    Repr tk ptk prov L eX (exec m12 (exitOps L tk e12)) :=\n3741\t  r6_exit_reachable kc_dd r12 ⟨by decide, wf_m12⟩ (fun _ => rfl) (.ok (by decide))\n3742\texample : ¬ eX.Usable 6 ∧ eX.dead 6 = false ∧ LiveAlloc (exec m12 (exitOps L tk e12)) 4 ∧\n3743\t    DeadAlloc (exec m12 (exitOps L tk e12)) 2 := by decide\n3744\texample : ¬ ReprB tk ptk prov L eX ((exec m12 (exitOps L tk e12)).dealloc 4) := by decide\n3745\t\n3746\t/-- L4: the clause `provTokens` rejects a wrong provider token: the allocation 4 of the storage 6,\n3747\tallocated from the provider 1, has the token `ptk 1 = 7`, not `9 + 1`; before the `alloc`, the\n3748\tghost already maps 6 to the provider 1 and nothing is required (6 does not exist yet). -/\n3749\texample : ¬ ReprB tk (fun pr => 9 + pr) prov L e12 m12 := by decide\n3750\texample : ReprB tk (fun pr => 9 + pr) prov L e11 m8 ∧ e11.P.length = 6 := by decide\n3751\t\n3752\tend Cases\n3753\t\n3754\tnamespace CaseOwnedLocal\n3755\t\n3756\t/-- Witness of question (e) 1 of the report: frame 1 with a local 0 and a local 1 owned by the\n3757\tlocal 0 (an element of the shape with an owning element). Local 1 is a root local (K4: one\n3758\t`AllocStep` at the entry, with the token of the frame, K2) and owned storage (O13: `OwnedRoot`, so\n3759\t`free` applies to it). `exitFrame` deallocates the allocations of the roots owned by the frame\n3760\tonly: after `free` of 1, a second deallocation of its allocation would be `ub` (MM-02.D); without\n3761\t`free`, its allocation stays live after the exit. -/\n3762\tabbrev KO : K := KT [] [] [] [1] [(1, 101)]\n3763\tdef lsO : List (Option Nat × Option Nat × Nat) := [(none, none, 0), (none, some 0, 0)]\n3764\tdef o0 : S3 := S3.init []\n3765\tdef o1 : S3 := enterEff o0 [] lsO\n3766\tdef o2 : S3 := freeEff o1 1\n3767\tdef o3 : S3 := exitEff o2\n3768\tdef o3' : S3 := exitEff o1\n3769\texample : EnterStep [] lsO o0 (.ok o1) := .ok (by decide)\n3770\texample : FreeStep KO 1 101 o1 (.ok o2) := .ok (by decide)\n3771\texample : ExitStep KO o2 (.ok o3) := .ok (by decide)\n3772\texample : ExitStep KO o1 (.ok o3') := .ok (by decide)\n3773\tdef C : Nat → Nat → Prop := fun a d => a = d\n3774\tinstance : DecidableRel C := fun a d => inferInstanceAs (Decidable (a = d))\n3775\tdef tk : Nat → Nat := fun f => 100 + f\n3776\tdef ptk : Nat → Nat := fun pr => 6 + pr\n3777\tdef prov : Nat → Option Nat := fun _ => none\n3778\tdef g : Nat → Geom := fun _ => ⟨0, 4, 4⟩\n3779\tdef L : Layout := fun q => ⟨q, 0, 4⟩\n3780\tdef n1 : MM02.State :=\n3781\t  exec MM02.State.empty (allocOps topPlacement g (some (tk o0.nF)) MM02.State.empty (rootIdx lsO))\n3782\tdef n2 : MM02.State := exec n1 (deallocOps [rootAlloc L o1.P 1] 101)\n3783\texample : ReprB tk ptk prov L o1 n1 ∧ ReprB tk ptk prov L o2 n2 := by decide\n3784\texample : (frameRoots o2 o2.top).map (rootAlloc L o2.P) = [0] := by decide\n3785\texample : ReprB tk ptk prov L o3 (exec n2 (exitOps L tk o2)) ∧ ReprB tk ptk prov L o3' (exec n1 (exitOps L tk o1)) := by\n3786\t  decide\n3787\texample : LiveAlloc (exec n1 (exitOps L tk o1)) 1 := by decide\n3788\texample : MM02.DeallocStep C 1 101 (exec n2 (exitOps L tk o2)) .ub := .ub (by decide)\n3789\t\n3790\tend CaseOwnedLocal\n3791\t\n3792\tnamespace DraftGaps\n3793\t\n3794\t/-- Gap kept (report, (f) 5): the `WF3` of the draft accepts a usable root place without its\n3795\tactive root authority (MM-03.3 §2.1, clause 7, `RootHeld`: \"chaque emplacement racine utilisable\n3796\tpossède son autorité racine `Modify` active\"); the draft `RootHeld` only constrains the root\n3797\tauthorities that exist. `RootLive` holds on the reached states under `DDSound k`\n3798\t(`reachable_rootLive`). -/\n3799\tdef sNoRoot : S3 :=\n3800\t  { F := [0], nF := 1, P := [⟨none, .frame 0, 0⟩], I := fun _ => .uninit, A := [],\n3801\t    D := fun _ => [], dead := fun _ => false, freed := fun _ => false, pin := fun _ => false,\n3802\t    arenas := [], callParams := fun _ => [] }\n3803\t\n3804\ttheorem wf_noRoot : WF3 sNoRoot := by\n3805\t  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n3806\t  · intro b y; simp [sNoRoot]\n3807\t  · intro a x; simp [sNoRoot]\n3808\t  · decide\n3809\t  · decide\n3810\t  · decide\n3811\t  · intro q pl f hq ho\n3812\t    match q, hq with\n3813\t    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho; decide\n3814\t  · intro q pl o hq ho\n3815\t    match q, hq with\n3816\t    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho\n3817\t  · intro q pl r hq hp\n3818\t    match q, hq with\n3819\t    | 0, hq => simp [sNoRoot] at hq; subst hq; cases hp\n3820\t  · intro a y hy; simp [sNoRoot] at hy\n3821\t  · intro a y l hy; simp [sNoRoot] at hy\n3822\t  · intro x z l r hz; simp [sNoRoot] at hz\n3823\t\n3824\texample : RootPlace sNoRoot.P 0 ∧ sNoRoot.Usable 0 ∧ sNoRoot.A = [] := by decide\n3825\texample : ¬ RootLive sNoRoot := fun h => by\n3826\t  obtain ⟨i, z, pr, hz, -⟩ := h 0 (by decide) (by decide)\n3827\t  simp [sNoRoot] at hz\n3828\t\n3829\t/-- Gap kept (report, (f) 6): the `WF3` of the draft accepts a cycle of owners (MM-03.3 §2.1,\n3830\tclause 3: \"des chaînes de possession bien fondées\"); it only asks owner places to exist. -/\n3831\tdef sCyc : S3 :=\n3832\t  { F := [0], nF := 1, P := [⟨none, .place 1, 0⟩, ⟨none, .place 0, 0⟩], I := fun _ => .uninit,\n3833\t    A := [], D := fun _ => [], dead := fun _ => false, freed := fun _ => false,\n3834\t    pin := fun _ => false, arenas := [], callParams := fun _ => [] }\n3835\t\n3836\ttheorem wf_cyc : WF3 sCyc := by\n3837\t  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n3838\t  · intro b y; simp [sCyc]\n3839\t  · intro a x; simp [sCyc]\n3840\t  · decide\n3841\t  · decide\n3842\t  · decide\n3843\t  · intro q pl f hq ho\n3844\t    match q, hq with\n3845\t    | 0, hq => simp [sCyc] at hq; subst hq; cases ho\n3846\t    | 1, hq => simp [sCyc] at hq; subst hq; cases ho\n3847\t  · intro q pl o hq ho\n3848\t    match q, hq with\n3849\t    | 0, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n3850\t    | 1, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n3851\t  · intro q pl r hq hp\n3852\t    match q, hq with\n3853\t    | 0, hq => simp [sCyc] at hq; subst hq; cases hp\n3854\t    | 1, hq => simp [sCyc] at hq; subst hq; cases hp\n3855\t  · intro a y hy; simp [sCyc] at hy\n3856\t  · intro a y l hy; simp [sCyc] at hy\n3857\t  · intro x z l r hz; simp [sCyc] at hz\n3858\t\n3859\texample : sCyc.P[0]? = some ⟨none, .place 1, 0⟩ ∧ sCyc.P[1]? = some ⟨none, .place 0, 0⟩ := by\n3860\t  decide\n3861\t\n3862\tend DraftGaps\n3863\t"}]},"uuid":"a1c0edd9-da23-4187-b267-8aa9eb5a44ae","timestamp":"2026-10-31T22:24:54.924Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","content":"namespace CaseInit\n\n/-- One static leaf, declared `Init`, in a 4-byte range of the static allocation. -/\ndef st : Statics := [((none, none, 0), true)]\ndef L : Layout := fun _ => ⟨0, 0, 4⟩\ndef tk : Nat → Nat := fun f => 100 + f\n/-- Provider tokens (L4) and the ghost `provOf`: no root is allocated by `alloc`. -/\ndef ptk : Nat → Nat := fun pr => 6 + pr\ndef prov : Nat → Option Nat := fun _ => none\ndef g : Nat → Geom := fun _ => ⟨0, 4, 4⟩\ndef w : Nat → Nat → UInt8 × Option Nat := fun l i => ((l + i).toUInt8, none)\n/-- Test obligations (K5): `dec`, an access aligned on 4 bytes; `stat`, true. -/\ndef obR : MM02.ReadOblSpec := ⟨fun _ ac => ac.addr % 4 = 0, fun _ _ => True⟩\ndef obW : MM02.WriteOblSpec := ⟨fun _ ac _ => ac.addr % 4 = 0, fun _ _ _ => True⟩\ninstance : ∀ s o, Decidable (Op2.Dec obR obW s o) := fun s o => by\n  cases o <;> simp only [Op2.Dec, obR, obW] <;> infer_instance\ndef s2 : MM02.State := exec MM02.State.empty (initOps topPlacement g tk L w st)\n\n/-- `repr_init` on the static storage, and the same verdict by `decide`; without the write of the\nstatic, `Repr` fails (K3: an `Init` leaf has its bytes initialised). -/\nexample : ReprB tk ptk prov L (S3.init st) s2 :=\n  (repr_init (C := fun _ _ => False) (ObR := obR) (ObW := obW) (by decide) topPlacement_ok\n    (by decide) (by decide) (by decide) (fun _ _ _ => trivial) (by decide)).2.toReprB\nexample : ReprB tk ptk prov L (S3.init st) s2 := by decide\nexample : ¬ ReprB tk ptk prov L (S3.init st)\n    (exec MM02.State.empty (allocOps topPlacement g (some (tk 0)) MM02.State.empty [0])) := by\n  decide\n\n/-- Counterexample kept (report, (f)): the draft `canRead3` does not ask the leaves read to be\nusable (MM-03.3 O9.1). In a state outside the reached ones, where the static 0 is freed but its\nroot authority stays active, `read3` is `ok`, `Repr` holds, and the MM-02 read is `ub`: R1 needs\n`NoDangling`. -/\ndef cx : S3 := { S3.init st with dead := fun _ => true, freed := fun _ => true }\ndef cx2 : MM02.State := s2.dealloc 0\nexample : ReprB tk ptk prov L cx cx2 := by decide\nexample : Read3Step 0 [0] cx (.ok cx) := .ok (by decide)\nexample : MM02.ReadStep obR (leafAcc cx2 L .read 0) cx2 .ub :=\n  .ub fun ⟨h, _⟩ => absurd h (by decide)\nexample : ¬ NoDangling cx := fun h => h 0 _ rfl rfl 0 (by decide) 0 (by decide) (by decide)\n\nend CaseInit\n\nnamespace Cases\n\n/-- Test contracts: leaf 5 `SharedMutable`; `ExternalDone` for 2; place 6 deallocable with the\nauthority 7; the allocator at place 1 satisfiable, any other not. -/\ndef KC : K := ⟨fun _ _ => False, (· ∈ [5]), (· ∈ ([] : List Nat)), (· ∈ [2]), (· ∈ [6]),\n  fun p a => (p, a) ∈ [(6, 7)], fun pr _ _ => pr = 1⟩\ninstance : ∀ r r', Decidable (KC.DeclaredDisjoint r r') := fun _ _ => instDecidableFalse\ninstance : DecidablePred KC.SharedMutable := fun l => inferInstanceAs (Decidable (l ∈ [5]))\ninstance : DecidablePred KC.Pinned := fun l => inferInstanceAs (Decidable (l ∈ ([] : List Nat)))\ninstance : DecidablePred KC.ExternalDone := fun l => inferInstanceAs (Decidable (l ∈ [2]))\ninstance : DecidablePred KC.Deallocable := fun p => inferInstanceAs (Decidable (p ∈ [6]))\ninstance : ∀ p a, Decidable (KC.FreeCompat p a) :=\n  fun p a => inferInstanceAs (Decidable ((p, a) ∈ [(6, 7)]))\ninstance : ∀ p ls s, Decidable (KC.Satisfiable p ls s) :=\n  fun p _ _ => inferInstanceAs (Decidable (p = 1))\ntheorem kc_dd : DDSound KC := fun _ _ h => h.elim\n\n/-- The scenario. Static 0 (`Init`). Frame 1 with locals 1 (an allocator value), 2 (owner of\nallocated storage, then arena value) and 3, a value with fields 4 and 5. Then: writes of 1 and 2,\nread of 1, `derive` of 4 from the root of 3 and its `release`, `split` of 3 into 4 and 5, `write3`\nof 4, `writeShared` of 5, `depend` of 2 on the root of 1, `pin` and `unpin` of 2, `alloc` of the\nstorage 6 owned by 2 (`fail` from the allocator 2), `newArena` on 6, `reset`, `endUse` of 2 (6\ndies, not freed), `exitFrame`. On a branch, `free` of 6 after its allocation. -/\ndef st : Statics := [((none, none, 0), true)]\ndef lsF : List (Option Nat × Option Nat × Nat) :=\n  [(none, none, 0), (none, none, 0), (none, none, 0), (some 3, none, 0), (some 3, none, 0)]\ndef e0 : S3 := S3.init st\ndef e1 : S3 := enterEff e0 [] lsF\ndef e2 : S3 := write3Eff e1 [1]\ndef e3 : S3 := write3Eff e2 [2]\ndef e4 : S3 := deriveEff e3 3 4 .observe\ndef e5 : S3 := releaseEff e4 4\ndef e6 : S3 := splitEff e5 3 [[4], [5]]\ndef e7 : S3 := write3Eff e6 [4]\ndef e8 : S3 := write3Eff e7 [5]\ndef e9 : S3 := dependEff e8 2 1\ndef e10 : S3 := pinEff e9 2 true\ndef e11 : S3 := pinEff e10 2 false\ndef e12 : S3 := allocEff e11 1 2 [(none, none, 0)]\ndef e13 : S3 := newArenaEff e12 6 7\ndef e14 : S3 := resetAtEff e13 0\ndef e15 : S3 := endUseEff e14 2\ndef e16 : S3 := exitEff e15\ndef f13 : S3 := freeEff e12 6\n\ntheorem r0 : Reachable KC st e0 := .init (by decide)\ntheorem r1 : Reachable KC st e1 := .enter r0 (.ok (by decide))\ntheorem r2 : Reachable KC st e2 := .write r1 (.ok (by decide) : Write3Step 1 [1] e1 (.ok e2))\ntheorem r3 : Reachable KC st e3 := .write r2 (.ok (by decide) : Write3Step 2 [2] e2 (.ok e3))\ntheorem r4 : Reachable KC st e4 := .derive r3 (.ok (by decide) : DeriveStep 3 4 .observe e3 (.ok e4))\ntheorem r5 : Reachable KC st e5 := .release r4 (.ok (by decide) : ReleaseStep 4 e4 (.ok e5))\ntheorem r6 : Reachable KC st e6 := .split r5 (.ok (by decide) : SplitStep KC 3 [[4], [5]] e5 (.ok e6))\ntheorem r7 : Reachable KC st e7 := .write r6 (.ok (by decide) : Write3Step 5 [4] e6 (.ok e7))\ntheorem r8 : Reachable KC st e8 :=\n  .writeShared r7 (.ok (by decide) : WriteSharedStep KC 6 [5] e7 (.ok e8))\ntheorem r9 : Reachable KC st e9 := .depend r8 (.ok (by decide) : DependStep 2 1 e8 (.ok e9))\ntheorem r10 : Reachable KC st e10 := .pin r9 (.ok (by decide) : PinStep 2 e9 (.ok e10))\ntheorem r11 : Reachable KC st e11 := .unpin r10 (.ok (by decide) : UnpinStep KC 2 e10 (.ok e11))\ntheorem r12 : Reachable KC st e12 :=\n  .alloc r11 (.ok (by decide) (by decide) : AllocStep KC 1 2 [(none, none, 0)] e11 (.ok e12))\ntheorem r13 : Reachable KC st e13 := .newArena r12 (.ok (by decide) : NewArenaStep 6 7 e12 (.ok e13))\ntheorem r14 : Reachable KC st e14 := .reset r13 (.ok (by decide) : ResetAtStep KC 0 2 e13 (.ok e14))\ntheorem r15 : Reachable KC st e15 := .endUse r14 (.ok (by decide) : EndUseStep KC 2 e14 (.ok e15))\ntheorem r16 : Reachable KC st e16 := .exit r15 (.ok (by decide) : ExitStep KC e15 (.ok e16))\ntheorem rf : Reachable KC st f13 := .free r12 (.ok (by decide) : FreeStep KC 6 7 e12 (.ok f13))\n\n/-- MM-02 parameters: compatibility by equality of tokens (so `TokCompat`); frame token `100 + f`;\ngeometry: 8 bytes aligned on 4; layout: one allocation per root, fields 4 and 5 at offsets 0 and 4\nof the allocation of 3; the bytes written in leaf `l` are `10 l + i`. -/\ndef C : Nat → Nat → Prop := fun a d => a = d\ndef tk : Nat → Nat := fun f => 100 + f\n/-- Provider tokens (L4): the allocator at place 1 has the token 7. Ghost `provOf`: the places 6\nand 7 are allocated from the provider 1. -/\ndef ptk : Nat → Nat := fun pr => 6 + pr\ndef prov : Nat → Option Nat := fun r => if r = 6 ∨ r = 7 then some 1 else none\ndef g : Nat → Geom := fun _ => ⟨0, 8, 4⟩\ndef L : Layout := fun q => match q with\n  | 0 => ⟨0, 0, 4⟩ | 1 => ⟨1, 0, 4⟩ | 2 => ⟨2, 0, 4⟩ | 3 => ⟨3, 0, 8⟩\n  | 4 => ⟨3, 0, 4⟩ | 5 => ⟨3, 4, 4⟩ | 6 => ⟨4, 0, 4⟩ | _ => ⟨99, 0, 0⟩\ndef w : Nat → Nat → UInt8 × Option Nat := fun l i => ((10 * l + i).toUInt8, none)\n/-- Test obligations (K5): `dec`, an access aligned on 4 bytes; `stat`, true. -/\ndef obR : MM02.ReadOblSpec := ⟨fun _ ac => ac.addr % 4 = 0, fun _ _ => True⟩\ndef obW : MM02.WriteOblSpec := ⟨fun _ ac _ => ac.addr % 4 = 0, fun _ _ _ => True⟩\ninstance : ∀ s o, Decidable (Op2.Dec obR obW s o) := fun s o => by\n  cases o <;> simp only [Op2.Dec, obR, obW] <;> infer_instance\n\n/-- The MM-02 sequences attached to the steps (K4) and the states they reach. -/\ndef m0 : MM02.State := exec MM02.State.empty (initOps topPlacement g tk L w st)\ndef ops1 : List Op2 := allocOps topPlacement g (some (tk e0.nF)) m0 (rootIdx lsF)\ndef m1 : MM02.State := exec m0 ops1\ndef ops2 : List Op2 := writeOps m1 L w [1]\ndef m2 : MM02.State := exec m1 ops2\ndef ops3 : List Op2 := writeOps m2 L w [2]\ndef m3 : MM02.State := exec m2 ops3\ndef ops7 : List Op2 := writeOps m3 L w [4]\ndef m7 : MM02.State := exec m3 ops7\ndef ops8 : List Op2 := writeOps m7 L w [5]\ndef m8 : MM02.State := exec m7 ops8\ndef ops12 : List Op2 :=\n  [.alloc (g 0).space (topPlacement m8 (g 0)) (g 0).size (g 0).align (some 7)]\ndef m12 : MM02.State := exec m8 ops12\ndef ops16 : List Op2 := exitOps L tk e15\ndef m16 : MM02.State := exec m12 ops16\ndef opsF : List Op2 := deallocOps [rootAlloc L e12.P 6] 7\ndef mF : MM02.State := exec m12 opsF\n\ntheorem wf_m0 : MM02.WF m0 := exec_wf _ _ fun _ _ => rfl\ntheorem wf_m1 : MM02.WF m1 := exec_wf _ _ wf_m0\ntheorem wf_m2 : MM02.WF m2 := exec_wf _ _ wf_m1\ntheorem wf_m3 : MM02.WF m3 := exec_wf _ _ wf_m2\ntheorem wf_m7 : MM02.WF m7 := exec_wf _ _ wf_m3\ntheorem wf_m8 : MM02.WF m8 := exec_wf _ _ wf_m7\ntheorem wf_m12 : MM02.WF m12 := exec_wf _ _ wf_m8\ntheorem wf_m16 : MM02.WF m16 := exec_wf _ _ wf_m12\ntheorem wf_mF : MM02.WF mF := exec_wf _ _ wf_m12\n\n/-- The sequences exhibited: the bases chosen by `topPlacement` for the locals (16, 28, 40) and the\nallocated storage (52), with their tokens; the deallocations of `exitFrame`, of the allocations 1,\n2, 3 of the roots owned by frame 1, with its token 101. -/\nexample : (m1.allocs 1).map (·.base) = some 16 ∧ (m1.allocs 2).map (·.base) = some 28 ∧\n    (m1.allocs 3).map (·.base) = some 40 ∧ (m1.allocs 3).map (·.freeAuth) = some (some 101) := by\n  decide\nexample : (m12.allocs 4).map (·.base) = some 52 ∧ (m12.allocs 4).map (·.live) = some true ∧\n    (m12.allocs 4).map (·.freeAuth) = some (some 7) := by decide\nexample : (frameRoots e15 e15.top).map (rootAlloc L e15.P) = [1, 2, 3] ∧ tk e15.top = 101 := by\n  decide\n\n/-- `Repr` at each point, by `decide`. -/\nexample : ReprB tk ptk prov L e0 m0 ∧ ReprB tk ptk prov L e1 m1 ∧ ReprB tk ptk prov L e2 m2 ∧ ReprB tk ptk prov L e3 m3 ∧\n    ReprB tk ptk prov L e6 m3 ∧ ReprB tk ptk prov L e8 m8 ∧ ReprB tk ptk prov L e12 m12 ∧ ReprB tk ptk prov L e15 m12 ∧\n    ReprB tk ptk prov L e16 m16 ∧ ReprB tk ptk prov L f13 mF := by decide\n\n/-- K3: initial state (`repr_init`). -/\nexample : AllOk C obR obW MM02.State.empty (initOps topPlacement g tk L w st) ∧\n    Repr tk ptk prov L e0 m0 :=\n  repr_init (by decide) topPlacement_ok (by decide) (by decide) (by decide) (fun _ _ _ => trivial)\n    (by decide)\n/-- R6, `enterFrame`: three allocations, one per root local. -/\nexample : AllOk C obR obW m0 ops1 ∧ Repr tk ptk prov L e1 m1 :=\n  r6_enter (reachable_invariants kc_dd r0).1 ⟨by decide, wf_m0⟩ topPlacement_ok (by decide)\n    (.ok (by decide)) (by decide) (by decide)\n/-- R2, `write3`. -/\nexample : AllOk C obR obW m1 ops2 ∧ Repr tk ptk prov L e2 m2 :=\n  r2_write3_reachable kc_dd r1 ⟨by decide, wf_m1⟩ (.ok (by decide) : Write3Step 1 [1] e1 (.ok e2))\n    (fun _ _ _ => trivial) (by decide)\nexample : AllOk C obR obW m2 ops3 ∧ Repr tk ptk prov L e3 m3 :=\n  r2_write3_reachable kc_dd r2 ⟨by decide, wf_m2⟩ (.ok (by decide) : Write3Step 2 [2] e2 (.ok e3))\n    (fun _ _ _ => trivial) (by decide)\nexample : AllOk C obR obW m3 ops7 ∧ Repr tk ptk prov L e7 m7 :=\n  r2_write3_reachable kc_dd r6 ⟨by decide, wf_m3⟩ (.ok (by decide) : Write3Step 5 [4] e6 (.ok e7))\n    (fun _ _ _ => trivial) (by decide)\n/-- R2, `writeShared` under an authority of effective mode present. -/\nexample : AllOk C obR obW m7 ops8 ∧ Repr tk ptk prov L e8 m8 :=\n  r2_writeShared_reachable kc_dd r7 ⟨by decide, wf_m7⟩\n    (.ok (by decide) : WriteSharedStep KC 6 [5] e7 (.ok e8)) (fun _ _ _ => trivial) (by decide)\n/-- R1 and R6, `read3`; the value read is the 4 bytes written by `write3` in leaf 1. -/\nexample : AllOk C obR obW m3 (readOps m3 L [1]) ∧\n    Repr tk ptk prov L e3 (exec m3 (readOps m3 L [1])) :=\n  r6_read3 (reachable_invariants kc_dd r3).1 (reachable_invariants kc_dd r3).2.1.nd\n    (reachable_fpLeaves_frameOwnedLive kc_dd r3).1 ⟨by decide, wf_m3⟩\n    (.ok (by decide) : Read3Step 1 [1] e3 (.ok e3)) (fun _ _ => trivial) (fun l hl => by\n      rw [List.mem_singleton] at hl; subst hl; show (leafAcc m3 L .read 1).addr % 4 = 0; decide)\nexample : ((m3.allocs 1).map fun a => a.bytesAt 0 4) =\n    some [.init 10 none, .init 11 none, .init 12 none, .init 13 none] := by decide\nexample : ((m8.allocs 3).map fun a => a.bytesAt 0 8) = some [.init 40 none, .init 41 none,\n    .init 42 none, .init 43 none, .init 50 none, .init 51 none, .init 52 none, .init 53 none] := by\n  decide\n/-- R6, `alloc` `ok`: one allocation, at base 52, token 7. -/\nexample : AllOk C obR obW m8 ops12 ∧ Repr tk ptk prov L e12 m12 :=\n  r6_alloc (i := 0) (ptok := ptk) (provOf := prov) (pr := 1) (reachable_invariants kc_dd r11).1\n    ⟨by decide, wf_m8⟩ topPlacement_ok\n    (by decide) (.ok (by decide) (by decide) : AllocStep KC 1 2 [(none, none, 0)] e11 (.ok e12)) rfl\n    (by decide) (by decide)\n/-- R6, `alloc` `fail`: allocator 2 not satisfiable, no step. -/\nexample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e12 (exec m12 []) :=\n  r6_alloc_fail ⟨by decide, wf_m12⟩\n    (.fail (by decide) (by decide) : AllocStep KC 2 2 [(none, none, 0)] e12 (.fail e12))\n/-- R6, `free` of 6 with the authority 7: the allocation 4 dies. -/\nexample : AllOk C obR obW m12 opsF ∧ Repr tk ptk prov L f13 mF :=\n  r6_free (k := KC) (auth := 7) (reachable_invariants kc_dd r12).1 ⟨by decide, wf_m12⟩\n    (fun _ => ⟨1, rfl, rfl⟩) (.ok (by decide))\nexample : DeadAlloc mF 4 := by decide\n/-- R6, `exitFrame`: three deallocations; the storage 6, dead by `endUse` and not freed, keeps\nits allocation 4 live (leak, K3, K4). -/\nexample : AllOk C obR obW m12 ops16 ∧ Repr tk ptk prov L e16 m16 :=\n  r6_exit_reachable kc_dd r15 ⟨by decide, wf_m12⟩ (fun _ => rfl) (.ok (by decide))\nexample : DeadAlloc m16 1 ∧ DeadAlloc m16 2 ∧ DeadAlloc m16 3 ∧ LiveAlloc m16 4 ∧\n    LiveAlloc m16 0 := by decide\n/-- R6, the steps without MM-02 step (K4). After `endUse` of 2, the storage 6 is not usable and\nnot freed, and its allocation stays live. -/\nexample : AllOk C obR obW m3 [] ∧ Repr tk ptk prov L e4 (exec m3 []) :=\n  r6_noStep (k := KC) ⟨by decide, wf_m3⟩ (.derive (.ok (by decide) : DeriveStep 3 4 .observe e3 (.ok e4)))\nexample : AllOk C obR obW m3 [] ∧ Repr tk ptk prov L e5 (exec m3 []) :=\n  r6_noStep (k := KC) ⟨by decide, wf_m3⟩ (.release (.ok (by decide) : ReleaseStep 4 e4 (.ok e5)))\nexample : AllOk C obR obW m3 [] ∧ Repr tk ptk prov L e6 (exec m3 []) :=\n  r6_noStep ⟨by decide, wf_m3⟩ (.split (.ok (by decide) : SplitStep KC 3 [[4], [5]] e5 (.ok e6)))\nexample : AllOk C obR obW m8 [] ∧ Repr tk ptk prov L e9 (exec m8 []) :=\n  r6_noStep (k := KC) ⟨by decide, wf_m8⟩ (.depend (.ok (by decide) : DependStep 2 1 e8 (.ok e9)))\nexample : AllOk C obR obW m8 [] ∧ Repr tk ptk prov L e10 (exec m8 []) :=\n  r6_noStep (k := KC) ⟨by decide, wf_m8⟩ (.pin (.ok (by decide) : PinStep 2 e9 (.ok e10)))\nexample : AllOk C obR obW m8 [] ∧ Repr tk ptk prov L e11 (exec m8 []) :=\n  r6_noStep ⟨by decide, wf_m8⟩ (.unpin (.ok (by decide) : UnpinStep KC 2 e10 (.ok e11)))\nexample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e13 (exec m12 []) :=\n  r6_noStep (k := KC) ⟨by decide, wf_m12⟩ (.newArena (.ok (by decide) : NewArenaStep 6 7 e12 (.ok e13)))\nexample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e14 (exec m12 []) :=\n  r6_noStep ⟨by decide, wf_m12⟩ (.reset (.ok (by decide) : ResetAtStep KC 0 2 e13 (.ok e14)))\nexample : AllOk C obR obW m12 [] ∧ Repr tk ptk prov L e15 (exec m12 []) :=\n  r6_noStep ⟨by decide, wf_m12⟩ (.endUse (.ok (by decide) : EndUseStep KC 2 e14 (.ok e15)))\nexample : ¬ e15.Usable 6 ∧ e15.freed 6 = false ∧ LiveAlloc m12 4 := by decide\n\n/-- R4 on the reached state after `exitFrame`: the authorities still active cover only the\nstatic leaf, in a live allocation. -/\nexample : ∀ j < e16.A.length, e16.Active j → e16.afp j = [0] := by decide\nexample : LiveAlloc m16 (L 0).alloc :=\n  (r4_no_dead_cover (tok := tk) (ptok := ptk) (provOf := prov) kc_dd r16 ⟨by decide, wf_m16⟩ 0 _\n    rfl rfl 0\n    (List.mem_singleton_self _)).2.2\n\n/-- `exclusive_bytes`: after `split`, authority 5 has effective `Modify` on leaf 4; the root 3,\nactive and covering 4, has no effective mode there; authority 6 keeps effective `Modify` on the\nadjacent range of leaf 5. A layout where the ranges of 4 and 5 overlap violates `LayoutWF`. -/\nexample : effective e6 5 4 = some .modify ∧ e6.Active 3 ∧ 4 ∈ e6.afp 3 ∧\n    effective e6 6 5 = some .modify := by decide\nexample : effective e6 3 4 = none :=\n  exclusive_bytes (L := L) (s2 := m3) (by decide) (reachable_invariants kc_dd r6).2.1.base.1\n    (l := 4) (l' := 4) (by decide) (by decide) (by decide) (by decide) (a := 5) (by decide)\n    (by decide) rfl (by decide)\ndef Lov : Layout := fun q => if q = 5 then ⟨3, 2, 4⟩ else L q\nexample : ¬ LayoutWF Lov e6 m3 := by decide\n\n/-- K1 (d): the storage 6, a shape of one leaf, may have size zero. -/\ndef L0 : Layout := fun q => if q = 6 then ⟨4, 0, 0⟩ else L q\ndef m12z : MM02.State := exec m8 [.alloc 0 (topPlacement m8 ⟨0, 0, 4⟩) 0 4 (some 7)]\nexample : ReprB tk ptk prov L0 e12 m12z := by decide\n\n/-- Each clause of `Repr` rejects a wrong MM-02 state: a usable root with a dead allocation; a\nleaked root deallocated at `endUse`; two roots in one allocation (`LayoutWF` holds); a wrong frame\ntoken; an exited root or a freed root whose allocation is still live. -/\nexample : ¬ ReprB tk ptk prov L e3 (m3.dealloc 1) := by decide\nexample : ¬ ReprB tk ptk prov L e15 (m12.dealloc 4) := by decide\ndef Lsh : Layout := fun q => if q = 2 then ⟨1, 4, 4⟩ else L q\nexample : LayoutWF Lsh e1 m1 ∧ ¬ ReprB tk ptk prov Lsh e1 m1 := by decide\nexample : ¬ ReprB (fun f => 200 + f) ptk prov L e1 m1 := by decide\nexample : ¬ ReprB tk ptk prov L e16 m12 ∧ ¬ ReprB tk ptk prov L f13 m12 := by decide\n\n/-- Counterexample kept (report, (e), (f)): the draft accepts `alloc` of a shape with two roots,\nwhere O14 creates one root; with the one `AllocStep` of K4, a layout putting both roots in the\nfresh allocation satisfies `LayoutWF` but not `Repr` (two roots, one allocation). -/\ndef e12b : S3 := allocEff e11 1 2 [(none, none, 0), (none, none, 0)]\nexample : AllocStep KC 1 2 [(none, none, 0), (none, none, 0)] e11 (.ok e12b) :=\n  .ok (by decide) (by decide)\ndef L2 : Layout := fun q => if q = 7 then ⟨4, 4, 4⟩ else L q\ndef m12b : MM02.State := exec m8 [.alloc 0 (topPlacement m8 (g 0)) 8 4 (some 7)]\nexample : LayoutWF L2 e12b m12b ∧ ¬ ReprB tk ptk prov L2 e12b m12b := by decide\n\n/-- Witness of question (e) 7 of the report: the storage 7, allocated with owner the storage 6,\ndies with the `free` of 6 (O13); `free` has one `DeallocStep`, of the allocation 4 of 6, and the\nallocation 5 of 7 stays live; deallocating it too breaks `Repr` (clause `leaked`). -/\ndef ao13 : S3 := allocEff e12 1 6 [(none, none, 0)]\ndef af14 : S3 := freeEff ao13 6\ntheorem ra13 : Reachable KC st ao13 :=\n  .alloc r12 (.ok (by decide) (by decide) : AllocStep KC 1 6 [(none, none, 0)] e12 (.ok ao13))\ntheorem ra14 : Reachable KC st af14 := .free ra13 (.ok (by decide) : FreeStep KC 6 7 ao13 (.ok af14))\ndef La : Layout := fun q => if q = 7 then ⟨5, 0, 4⟩ else L q\ndef na13 : MM02.State := exec m12 [.alloc 0 (topPlacement m12 (g 0)) 8 4 (some 7)]\ndef na14 : MM02.State := exec na13 (deallocOps [rootAlloc La ao13.P 6] 7)\nexample : ReprB tk ptk prov La ao13 na13 ∧ ReprB tk ptk prov La af14 na14 := by decide\nexample : ¬ af14.Usable 7 ∧ af14.freed 7 = false ∧ LiveAlloc na14 5 ∧ DeadAlloc na14 4 := by decide\nexample : ¬ ReprB tk ptk prov La af14 (na14.dealloc 5) := by decide\n\n/-- Clauses K1 (a) and (c) reject a layout on their own among the clauses of `LayoutWF`: the field\n5 of 3 in a fresh allocation 4 (with the token of frame 1) other than the allocation 3 of the field\n4 breaks (a) only; the range of leaf 1 past the size of its allocation breaks (c) only. -/\ndef m3x : MM02.State := exec m3 [.alloc 0 (topPlacement m3 (g 0)) 8 4 (some (tk 1))]\ndef Lsa : Layout := fun q => if q = 5 then ⟨4, 0, 4⟩ else L q\nexample : ¬ (∀ r < e6.P.length, RootPlace e6.P r → ∀ l ∈ footprint e6.P r,\n    ∀ l' ∈ footprint e6.P r, (Lsa l).alloc = (Lsa l').alloc) := by decide\nset_option synthInstance.maxSize 512 in\nexample : (∀ l < e6.P.length, ∀ l' < e6.P.length, isLeaf e6.P l → isLeaf e6.P l' → l ≠ l' →\n    (Lsa l).alloc = (Lsa l').alloc →\n      MM02.RangeDisjoint (Lsa l).off (Lsa l).len (Lsa l').off (Lsa l').len) ∧\n    (∀ l < e6.P.length, isLeaf e6.P l →\n      AllocP m3x (Lsa l).alloc fun a => (Lsa l).off + (Lsa l).len ≤ a.size) := by decide\ndef Lwi : Layout := fun q => if q = 1 then ⟨1, 6, 4⟩ else L q\nexample : ¬ (∀ l < e1.P.length, isLeaf e1.P l →\n    AllocP m1 (Lwi l).alloc fun a => (Lwi l).off + (Lwi l).len ≤ a.size) := by decide\nset_option synthInstance.maxSize 512 in\nexample : (∀ r < e1.P.length, RootPlace e1.P r → ∀ l ∈ footprint e1.P r,\n      ∀ l' ∈ footprint e1.P r, (Lwi l).alloc = (Lwi l').alloc) ∧\n    (∀ l < e1.P.length, ∀ l' < e1.P.length, isLeaf e1.P l → isLeaf e1.P l' → l ≠ l' →\n      (Lwi l).alloc = (Lwi l').alloc →\n        MM02.RangeDisjoint (Lwi l).off (Lwi l).len (Lwi l').off (Lwi l').len) := by decide\n\n/-- R1 applied directly to the read of leaf 1 in `e3`: an allocation, the range initialised, a\nread of outcome `ok` with the bytes of the range, never `ub`. -/\nexample : ∃ al, m3.allocs (L 1).alloc = some al ∧ al.InitRange (L 1).off (L 1).len ∧\n    MM02.ReadStep obR (leafAcc m3 L .read 1) m3 (.ok (al.bytesAt (L 1).off (L 1).len)) ∧\n    ¬ MM02.ReadStep obR (leafAcc m3 L .read 1) m3 .ub :=\n  r1_read3 (tok := tk) (reachable_invariants kc_dd r3).1 (reachable_invariants kc_dd r3).2.1.nd\n    (reachable_fpLeaves_frameOwnedLive kc_dd r3).1 (ptok := ptk) (provOf := prov) ⟨by decide, wf_m3⟩\n    (.ok (by decide) : Read3Step 1 [1] e3 (.ok e3)) (fun _ _ => trivial) (fun l hl => by\n      rw [List.mem_singleton] at hl; subst hl; show (leafAcc m3 L .read 1).addr % 4 = 0; decide)\n    1 (List.mem_singleton_self _)\n\n/-- Gap kept (report, (f) 4): after `free` of 6, the storage 7 it owns stops being usable but is\nnot marked dead, where O13 marks dead \"le stockage qui cesse de vivre\". -/\nexample : af14.dead 7 = false ∧ ¬ af14.Usable 7 := by decide\n\n/-- Owned storage that dies with its frame (K4: no `DeallocStep` for it): `exitFrame` directly from\n`e12`, where the storage 6 is owned by the local 2; the allocations 1, 2, 3 die, the allocation 4 of\n6 stays live, as the clause `leaked` asks; deallocating it too breaks `Repr` (report, (c) 4). -/\ndef eX : S3 := exitEff e12\ntheorem rX : Reachable KC st eX := .exit r12 (.ok (by decide) : ExitStep KC e12 (.ok eX))\nexample : AllOk C obR obW m12 (exitOps L tk e12) ∧\n    Repr tk ptk prov L eX (exec m12 (exitOps L tk e12)) :=\n  r6_exit_reachable kc_dd r12 ⟨by decide, wf_m12⟩ (fun _ => rfl) (.ok (by decide))\nexample : ¬ eX.Usable 6 ∧ eX.dead 6 = false ∧ LiveAlloc (exec m12 (exitOps L tk e12)) 4 ∧\n    DeadAlloc (exec m12 (exitOps L tk e12)) 2 := by decide\nexample : ¬ ReprB tk ptk prov L eX ((exec m12 (exitOps L tk e12)).dealloc 4) := by decide\n\n/-- L4: the clause `provTokens` rejects a wrong provider token: the allocation 4 of the storage 6,\nallocated from the provider 1, has the token `ptk 1 = 7`, not `9 + 1`; before the `alloc`, the\nghost already maps 6 to the provider 1 and nothing is required (6 does not exist yet). -/\nexample : ¬ ReprB tk (fun pr => 9 + pr) prov L e12 m12 := by decide\nexample : ReprB tk (fun pr => 9 + pr) prov L e11 m8 ∧ e11.P.length = 6 := by decide\n\nend Cases\n\nnamespace CaseOwnedLocal\n\n/-- Witness of question (e) 1 of the report: frame 1 with a local 0 and a local 1 owned by the\nlocal 0 (an element of the shape with an owning element). Local 1 is a root local (K4: one\n`AllocStep` at the entry, with the token of the frame, K2) and owned storage (O13: `OwnedRoot`, so\n`free` applies to it). `exitFrame` deallocates the allocations of the roots owned by the frame\nonly: after `free` of 1, a second deallocation of its allocation would be `ub` (MM-02.D); without\n`free`, its allocation stays live after the exit. -/\nabbrev KO : K := KT [] [] [] [1] [(1, 101)]\ndef lsO : List (Option Nat × Option Nat × Nat) := [(none, none, 0), (none, some 0, 0)]\ndef o0 : S3 := S3.init []\ndef o1 : S3 := enterEff o0 [] lsO\ndef o2 : S3 := freeEff o1 1\ndef o3 : S3 := exitEff o2\ndef o3' : S3 := exitEff o1\nexample : EnterStep [] lsO o0 (.ok o1) := .ok (by decide)\nexample : FreeStep KO 1 101 o1 (.ok o2) := .ok (by decide)\nexample : ExitStep KO o2 (.ok o3) := .ok (by decide)\nexample : ExitStep KO o1 (.ok o3') := .ok (by decide)\ndef C : Nat → Nat → Prop := fun a d => a = d\ninstance : DecidableRel C := fun a d => inferInstanceAs (Decidable (a = d))\ndef tk : Nat → Nat := fun f => 100 + f\ndef ptk : Nat → Nat := fun pr => 6 + pr\ndef prov : Nat → Option Nat := fun _ => none\ndef g : Nat → Geom := fun _ => ⟨0, 4, 4⟩\ndef L : Layout := fun q => ⟨q, 0, 4⟩\ndef n1 : MM02.State :=\n  exec MM02.State.empty (allocOps topPlacement g (some (tk o0.nF)) MM02.State.empty (rootIdx lsO))\ndef n2 : MM02.State := exec n1 (deallocOps [rootAlloc L o1.P 1] 101)\nexample : ReprB tk ptk prov L o1 n1 ∧ ReprB tk ptk prov L o2 n2 := by decide\nexample : (frameRoots o2 o2.top).map (rootAlloc L o2.P) = [0] := by decide\nexample : ReprB tk ptk prov L o3 (exec n2 (exitOps L tk o2)) ∧ ReprB tk ptk prov L o3' (exec n1 (exitOps L tk o1)) := by\n  decide\nexample : LiveAlloc (exec n1 (exitOps L tk o1)) 1 := by decide\nexample : MM02.DeallocStep C 1 101 (exec n2 (exitOps L tk o2)) .ub := .ub (by decide)\n\nend CaseOwnedLocal\n\nnamespace DraftGaps\n\n/-- Gap kept (report, (f) 5): the `WF3` of the draft accepts a usable root place without its\nactive root authority (MM-03.3 §2.1, clause 7, `RootHeld`: \"chaque emplacement racine utilisable\npossède son autorité racine `Modify` active\"); the draft `RootHeld` only constrains the root\nauthorities that exist. `RootLive` holds on the reached states under `DDSound k`\n(`reachable_rootLive`). -/\ndef sNoRoot : S3 :=\n  { F := [0], nF := 1, P := [⟨none, .frame 0, 0⟩], I := fun _ => .uninit, A := [],\n    D := fun _ => [], dead := fun _ => false, freed := fun _ => false, pin := fun _ => false,\n    arenas := [], callParams := fun _ => [] }\n\ntheorem wf_noRoot : WF3 sNoRoot := by\n  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n  · intro b y; simp [sNoRoot]\n  · intro a x; simp [sNoRoot]\n  · decide\n  · decide\n  · decide\n  · intro q pl f hq ho\n    match q, hq with\n    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho; decide\n  · intro q pl o hq ho\n    match q, hq with\n    | 0, hq => simp [sNoRoot] at hq; subst hq; cases ho\n  · intro q pl r hq hp\n    match q, hq with\n    | 0, hq => simp [sNoRoot] at hq; subst hq; cases hp\n  · intro a y hy; simp [sNoRoot] at hy\n  · intro a y l hy; simp [sNoRoot] at hy\n  · intro x z l r hz; simp [sNoRoot] at hz\n\nexample : RootPlace sNoRoot.P 0 ∧ sNoRoot.Usable 0 ∧ sNoRoot.A = [] := by decide\nexample : ¬ RootLive sNoRoot := fun h => by\n  obtain ⟨i, z, pr, hz, -⟩ := h 0 (by decide) (by decide)\n  simp [sNoRoot] at hz\n\n/-- Gap kept (report, (f) 6): the `WF3` of the draft accepts a cycle of owners (MM-03.3 §2.1,\nclause 3: \"des chaînes de possession bien fondées\"); it only asks owner places to exist. -/\ndef sCyc : S3 :=\n  { F := [0], nF := 1, P := [⟨none, .place 1, 0⟩, ⟨none, .place 0, 0⟩], I := fun _ => .uninit,\n    A := [], D := fun _ => [], dead := fun _ => false, freed := fun _ => false,\n    pin := fun _ => false, arenas := [], callParams := fun _ => [] }\n\ntheorem wf_cyc : WF3 sCyc := by\n  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\n  · intro b y; simp [sCyc]\n  · intro a x; simp [sCyc]\n  · decide\n  · decide\n  · decide\n  · intro q pl f hq ho\n    match q, hq with\n    | 0, hq => simp [sCyc] at hq; subst hq; cases ho\n    | 1, hq => simp [sCyc] at hq; subst hq; cases ho\n  · intro q pl o hq ho\n    match q, hq with\n    | 0, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n    | 1, hq => simp [sCyc] at hq; subst hq; cases ho; decide\n  · intro q pl r hq hp\n    match q, hq with\n    | 0, hq => simp [sCyc] at hq; subst hq; cases hp\n    | 1, hq => simp [sCyc] at hq; subst hq; cases hp\n  · intro a y hy; simp [sCyc] at hy\n  · intro a y l hy; simp [sCyc] at hy\n  · intro x z l r hz; simp [sCyc] at hz\n\nexample : sCyc.P[0]? = some ⟨none, .place 1, 0⟩ ∧ sCyc.P[1]? = some ⟨none, .place 0, 0⟩ := by\n  decide\n\nend DraftGaps\n","numLines":480,"startLine":3384,"totalLines":3865}},"sourceToolAssistantUUID":"6cac2632-e843-4e88-b8b4-292492b6cf19","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
