s derived, is still derived. -/","+def KeepsAuth (s s' : S3) : Prop :=","+  s.A.length ≤ s'.A.length ∧ ∀ (j : Nat) (y' : Authority), s'.A[j]? = some y' → j < s.A.length →","+    ∃ y, s.A[j]? = some y ∧ y'.mode = y.mode ∧ y'.footprint = y.footprint ∧","+      (y'.active = true → y.active = true ∧ (y.origin ≠ none → y'.origin ≠ none))","+","+theorem KeepsAuth.refl (s : S3) : KeepsAuth s s :=","+  ⟨Nat.le_refl _, fun _ y' hy' _ => ⟨y', hy', rfl, rfl, fun ha => ⟨ha, id⟩⟩⟩","+","+theorem KeepsAuth.trans {s s₁ s₂ : S3} (h₁ : KeepsAuth s s₁) (h₂ : KeepsAuth s₁ s₂) :","+    KeepsAuth s s₂ := by","+  refine ⟨Nat.le_trans h₁.1 h₂.1, fun j y₂ hy₂ hj => ?_⟩","+  obtain ⟨y₁, hy₁, m₁, f₁, a₁⟩ := h₂.2 j y₂ hy₂ (Nat.lt_of_lt_of_le hj h₁.1)","+  obtain ⟨y, hy, m, f, a⟩ := h₁.2 j y₁ hy₁ hj","+  exact ⟨y, hy, m₁.trans m, f₁.trans f, fun ha =>","+    ⟨(a (a₁ ha).1).1, fun ho => (a₁ ha).2 ((a (a₁ ha).1).2 ho)⟩⟩","+","+theorem KeepsAuth.of_releases {s s₁ : S3} (h : OnlyReleases s s₁) : KeepsAuth s s₁ :=","+  ⟨Nat.le_of_eq h.1.symm, fun j z hz _ => by","+    obtain ⟨y, hy, m, o, f, -, a⟩ := h.2 j z hz","+    exact ⟨y, hy, m, f, fun ha => ⟨a ha, fun hn => by rw [o]; exact hn⟩⟩⟩","+","+theorem KeepsAuth.app {s s₁ : S3} {l : List Authority} (h : s₁.A = s.A ++ l) : KeepsAuth s s₁ :=","+  ⟨by rw [h]; simp, fun j y' hy' hj => ⟨y', by rw [h, List.getElem?_append_left hj] at hy'; exact hy',","+    rfl, rfl, fun ha => ⟨ha, id⟩⟩⟩","+","+theorem KeepsAuth.same {s s₁ : S3} (h : s₁.A = s.A) : KeepsAuth s s₁ :=","+  KeepsAuth.app (l := []) (by rw [h, List.append_nil])","+","+/-- A kernel step keeps the authorities (MM-03.3 §3–5): it appends, releases, or changes holders;","+`exitFrame` re-attaches a surviving derived authority to a surviving ancestor (O7, `ExitPre`). -/","+theorem KStep.keeps {k : K} {s s' : S3} (h : KStep k s s') : KeepsAuth s s' := by","+  cases h with","+  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .app rfl","+  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .app rfl","+  | release hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .of_releases (release_releases s _)","+  | transfer hs =>","+    rename_i src dst","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    refine ⟨by simp [transferEff], fun j y' hy' _ => ?_⟩","+    rw [transfer_A_get] at hy'","+    obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hy'","+    refine ⟨y, hy, ?_⟩","+    split <;> exact ⟨rfl, rfl, fun ha => ⟨ha, id⟩⟩","+  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | read hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | write hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | writeShared hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | enter hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    refine ⟨by simp [enterEff, length_mapI], fun j y' hy' hj => ?_⟩","+    rw [enter_lt hj] at hy'","+    obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hy'","+    refine ⟨y, hy, ?_⟩","+    split <;> exact ⟨rfl, rfl, fun ha => ⟨ha, id⟩⟩","+  | exit hs =>","+    obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs","+    unfold ExitPre at hpre","+    split at hpre","+    · rename_i f F₀ hF","+      refine ⟨by rw [exitEff_eq hF]; simp [length_mapI], fun j y' hy' hj => ?_⟩","+      rw [exit_A_get hF] at hy'","+      obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hy'","+      obtain ⟨hm, hf, -⟩ := exitG_same s F₀ j y","+      refine ⟨y, hy, hm, hf, fun ha => ⟨exitG_active' hy ha, fun ho => ?_⟩⟩","+      rcases exitG_origin (s := s) (F₀ := F₀) (a := j) (y := y) with e | ⟨hsv, -, e⟩","+      · rw [e]; exact ho","+      · rw [e]","+        exact hpre.2.2.1 j (List.mem_range.2 hj) hsv (by simp only [S3.org, hy]; exact ho)","+    · exact hpre.elim","+  | endUse hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    exact .of_releases ((endUseS_releases s _).trans cleanup_releases)","+  | free hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    exact .of_releases ((freeS_releases s _).trans cleanup_releases)","+  | alloc hs => cases hs; exact .app rfl","+  | store hs =>","+    rename_i a p","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    have sk := store_skel s a p","+    refine ⟨Nat.le_of_eq sk.1.symm, fun j y' hy' _ => ?_⟩","+    obtain ⟨y, hy, e⟩ := sk.get hy'","+    simp only [skel, Prod.mk.injEq] at e","+    obtain ⟨hm, ho, hf, ha⟩ := e","+    exact ⟨y, hy, hm, hf, fun h => ⟨ha ▸ h, fun hn => by rw [ho]; exact hn⟩⟩","+","+/-- A step of `Reachable` keeps the authorities (MM-03.3 §3–6). -/","+theorem Step.keeps {k : K} {s s' : S3} (h : Step k s s') : KeepsAuth s s' := by","+  cases h with","+  | kernel hk => exact hk.keeps","+  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | issue hs =>","+    cases hs with","+    | ok _ hst =>","+      obtain ⟨-, -, -, -, e⟩ := issue_ok_iff.1 hst","+      have e1 := congrArg Prod.fst e; simp only at e1; subst e1","+      exact .app rfl","+  | reset hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    unfold resetAtEff; split <;> exact .same rfl","+","+/-- The places of `s` remain in `s'` with their footprint. -/","+def FpStable (s s' : S3) : Prop :=","+  s.P.length ≤ s'.P.length ∧ ∀ q < s.P.length, ∀ l, l ∈ footprint s'.P q ↔ l ∈ footprint s.P q","+","+theorem FpStable.same {s s₁ : S3} (h : s₁.P = s.P) : FpStable s s₁ :=","+  ⟨by rw [h]; exact Nat.le_refl _, fun _ _ _ => by rw [h]⟩","+","+theorem FpStable.refl (s : S3) : FpStable s s := .same rfl","+","+theorem FpStable.trans {s s₁ s₂ : S3} (h₁ : FpStable s s₁) (h₂ : FpStable s₁ s₂) :","+    FpStable s s₂ :=","+  ⟨Nat.le_trans h₁.1 h₂.1, fun q hq l =>","+    (h₂.2 q (Nat.lt_of_lt_of_le hq h₁.1) l).trans (h₁.2 q hq l)⟩","+","+/-- A kernel step removes no place and changes no footprint of an existing place (MM-03.3 §3–5):","+only `transfer` changes places, their owners, and `enterFrame` and `alloc` append places whose","+parents are new (`EnterPreBase`, `ShapeOK`). -/","+theorem KStep.fp {k : K} {s s' : S3} (h : KStep k s s') : FpStable s s' := by","+  cases h with","+  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | release hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    exact .same (by unfold releaseEff; split <;> rfl)","+  | transfer hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    exact ⟨by rw [transfer_len], fun q _ l => by rw [transfer_footprint]⟩","+  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | read hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | write hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | writeShared hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | enter hs =>","+    obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs","+    exact ⟨by simp [enterEff, enterP], fun q hq => enter_footprint_old hpre.1 hq⟩","+  | exit hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    exact .same (by unfold exitEff; split <;> rfl)","+  | endUse hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | free hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | alloc hs =>","+    cases hs with","+    | ok hst _ =>","+      exact ⟨by simp [allocEff, allocP, shapeP], fun q hq => shape_footprint_old hst.2.2.2.2.2.1 hq⟩","+  | store hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    exact .same (by unfold storeEff; split <;> rfl)","+","+/-- A step of `Reachable` removes no place and changes no footprint of an existing place. -/","+theorem Step.fp {k : K} {s s' : S3} (h : Step k s s') : FpStable s s' := by","+  cases h with","+  | kernel hk => exact hk.fp","+  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl","+  | issue hs =>","+    cases hs with","+    | ok _ hst =>","+      obtain ⟨-, -, -, -, e⟩ := issue_ok_iff.1 hst","+      have e1 := congrArg Prod.fst e; simp only at e1; subst e1","+      exact .same rfl","+  | reset hs =>","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs","+    unfold resetAtEff; split <;> exact .same rfl","+","+/-- `Reachable` is closed under its steps (MM-03.3 §10, `Step`). -/","+theorem reachable_step {k : K} {statics : Statics} {s s' : S3} (hr : Reachable k statics s)","+    (h : Step k s s') : Reachable k statics s' := by","+  cases h with","+  | kernel hk =>","+    cases hk with","+    | derive hs => exact .derive hr hs","+    | split hs => exact .split hr hs","+    | release hs => exact .release hr hs","+    | transfer hs => exact .transfer hr hs","+    | depend hs => exact .depend hr hs","+    | enter hs => exact .enter hr hs","+    | exit hs => exact .exit hr hs","+    | read hs => exact .read hr hs","+    | write hs => exact .write hr hs","+    | writeShared hs => exact .writeShared hr hs","+    | pin hs => exact .pin hr hs","+    | unpin hs => exact .unpin hr hs","+    | endUse hs => exact .endUse hr hs","+    | free hs => exact .free hr hs","+    | alloc hs => exact .alloc hr hs","+    | store hs => exact .store hr hs","+  | newArena hs => exact .newArena hr hs","+  | issue hs => exact .issue hr hs","+  | reset hs => exact .reset hr hs","+","+/-- Finite sequences of steps of `Reachable`. -/","+inductive Steps (k : K) : S3 → S3 → Prop where","+  | refl (s : S3) : Steps k s s","+  | tail {s s₁ s₂ : S3} : Steps k s s₁ → Step k s₁ s₂ → Steps k s s₂","+","+theorem Steps.keeps {k : K} {s s' : S3} (h : Steps k s s') : KeepsAuth s s' := by","+  induction h with","+  | refl s => exact .refl s","+  | tail _ h ih => exact ih.trans h.keeps","+","+theorem Steps.fp {k : K} {s s' : S3} (h : Steps k s s') : FpStable s s' := by","+  induction h with","+  | refl s => exact .refl s","+  | tail _ h ih => exact ih.trans h.fp","+","+theorem reachable_steps {k : K} {statics : Statics} {s s' : S3} (hr : Reachable k statics s)","+    (h : Steps k s s') : Reachable k statics s' := by","+  induction h with","+  | refl => exact hr","+  | tail _ h ih => exact reachable_step ih h","+","+theorem Steps.single {k : K} {s s' : S3} (h : Step k s s') : Steps k s s' := .tail (.refl s) h","+","+theorem Steps.trans {k : K} {s s₁ s₂ : S3} (h₁ : Steps k s s₁) (h₂ : Steps k s₁ s₂) :","+    Steps k s s₂ := by","+  induction h₂ with","+  | refl => exact h₁","+  | tail _ h ih => exact .tail ih h","+"," end Ern.HandlePool"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/HandlePool.lean"]}},"serverClassifierContext":{"request":"497f911a-ec3c-4e07-a362-61d046b12a49","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/validation_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"e608c466-39d2-40c6-ad09-0eae090b64fe","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/validation_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"a7e80894-41a6-429a-91ce-37c62111c8c3","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/HandlePool.lean","snippet":""},"type":"attachment","uuid":"84a2fe6c-dee1-4670-8cca-500ef593e12a","timestamp":"2026-11-01T17:33:35.086Z","rendered":[{"content":"<system-reminder>\nNote: /Users/guygouri/Devlab/ernlang/ern/formal/Ern/HandlePool.lean changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. The changes are not shown here; use Read if you need the current content.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/validation_0.1","slug":"effervescent-gathering-wind"}
{"type":"api-request-blob","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","hash":"bd187bbd0cd677748e95196ea629df5f961dcab4d2edd0bad30f9959f674e9fa","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_018eMzLnqbDd5fJ5kRxia6Qk","name":"Bash","input":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && python3 - <<'EOF'\np='Ern/HandlePool.lean'\ns=open(p).read()\nadd=r'''\n/-! ## Kernel steps keep authorities and footprints (MM-03.3 §3–6) -/\n\n/-- The authorities of `s` remain in `s'` with their mode and footprint; one active in `s'` was\nactive in `s` and, if it was derived, is still derived. -/\ndef KeepsAuth (s s' : S3) : Prop :=\n  s.A.length ≤ s'.A.length ∧ ∀ (j : Nat) (y' : Authority), s'.A[j]? = some y' → j < s.A.length →\n    ∃ y, s.A[j]? = some y ∧ y'.mode = y.mode ∧ y'.footprint = y.footprint ∧\n      (y'.active = true → y.active = true ∧ (y.origin ≠ none → y'.origin ≠ none))\n\ntheorem KeepsAuth.refl (s : S3) : KeepsAuth s s :=\n  ⟨Nat.le_refl _, fun _ y' hy' _ => ⟨y', hy', rfl, rfl, fun ha => ⟨ha, id⟩⟩⟩\n\ntheorem KeepsAuth.trans {s s₁ s₂ : S3} (h₁ : KeepsAuth s s₁) (h₂ : KeepsAuth s₁ s₂) :\n    KeepsAuth s s₂ := by\n  refine ⟨Nat.le_trans h₁.1 h₂.1, fun j y₂ hy₂ hj => ?_⟩\n  obtain ⟨y₁, hy₁, m₁, f₁, a₁⟩ := h₂.2 j y₂ hy₂ (Nat.lt_of_lt_of_le hj h₁.1)\n  obtain ⟨y, hy, m, f, a⟩ := h₁.2 j y₁ hy₁ hj\n  exact ⟨y, hy, m₁.trans m, f₁.trans f, fun ha =>\n    ⟨(a (a₁ ha).1).1, fun ho => (a₁ ha).2 ((a (a₁ ha).1).2 ho)⟩⟩\n\ntheorem KeepsAuth.of_releases {s s₁ : S3} (h : OnlyReleases s s₁) : KeepsAuth s s₁ :=\n  ⟨Nat.le_of_eq h.1.symm, fun j z hz _ => by\n    obtain ⟨y, hy, m, o, f, -, a⟩ := h.2 j z hz\n    exact ⟨y, hy, m, f, fun ha => ⟨a ha, fun hn => by rw [o]; exact hn⟩⟩⟩\n\ntheorem KeepsAuth.app {s s₁ : S3} {l : List Authority} (h : s₁.A = s.A ++ l) : KeepsAuth s s₁ :=\n  ⟨by rw [h]; simp, fun j y' hy' hj => ⟨y', by rw [h, List.getElem?_append_left hj] at hy'; exact hy',\n    rfl, rfl, fun ha => ⟨ha, id⟩⟩⟩\n\ntheorem KeepsAuth.same {s s₁ : S3} (h : s₁.A = s.A) : KeepsAuth s s₁ :=\n  KeepsAuth.app (l := []) (by rw [h, List.append_nil])\n\n/-- A kernel step keeps the authorities (MM-03.3 §3–5): it appends, releases, or changes holders;\n`exitFrame` re-attaches a surviving derived authority to a surviving ancestor (O7, `ExitPre`). -/\ntheorem KStep.keeps {k : K} {s s' : S3} (h : KStep k s s') : KeepsAuth s s' := by\n  cases h with\n  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .app rfl\n  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .app rfl\n  | release hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .of_releases (release_releases s _)\n  | transfer hs =>\n    rename_i src dst\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    refine ⟨by simp [transferEff], fun j y' hy' _ => ?_⟩\n    rw [transfer_A_get] at hy'\n    obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hy'\n    refine ⟨y, hy, ?_⟩\n    split <;> exact ⟨rfl, rfl, fun ha => ⟨ha, id⟩⟩\n  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | read hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | write hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | writeShared hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | enter hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    refine ⟨by simp [enterEff, length_mapI], fun j y' hy' hj => ?_⟩\n    rw [enter_lt hj] at hy'\n    obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hy'\n    refine ⟨y, hy, ?_⟩\n    split <;> exact ⟨rfl, rfl, fun ha => ⟨ha, id⟩⟩\n  | exit hs =>\n    obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold ExitPre at hpre\n    split at hpre\n    · rename_i f F₀ hF\n      refine ⟨by rw [exitEff_eq hF]; simp [length_mapI], fun j y' hy' hj => ?_⟩\n      rw [exit_A_get hF] at hy'\n      obtain ⟨y, hy, rfl⟩ := Option.map_eq_some_iff.1 hy'\n      obtain ⟨hm, hf, -⟩ := exitG_same s F₀ j y\n      refine ⟨y, hy, hm, hf, fun ha => ⟨exitG_active' hy ha, fun ho => ?_⟩⟩\n      rcases exitG_origin (s := s) (F₀ := F₀) (a := j) (y := y) with e | ⟨hsv, -, e⟩\n      · rw [e]; exact ho\n      · rw [e]\n        exact hpre.2.2.1 j (List.mem_range.2 hj) hsv (by simp only [S3.org, hy]; exact ho)\n    · exact hpre.elim\n  | endUse hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    exact .of_releases ((endUseS_releases s _).trans cleanup_releases)\n  | free hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    exact .of_releases ((freeS_releases s _).trans cleanup_releases)\n  | alloc hs => cases hs; exact .app rfl\n  | store hs =>\n    rename_i a p\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    have sk := store_skel s a p\n    refine ⟨Nat.le_of_eq sk.1.symm, fun j y' hy' _ => ?_⟩\n    obtain ⟨y, hy, e⟩ := sk.get hy'\n    simp only [skel, Prod.mk.injEq] at e\n    obtain ⟨hm, ho, hf, ha⟩ := e\n    exact ⟨y, hy, hm, hf, fun h => ⟨ha ▸ h, fun hn => by rw [ho]; exact hn⟩⟩\n\n/-- A step of `Reachable` keeps the authorities (MM-03.3 §3–6). -/\ntheorem Step.keeps {k : K} {s s' : S3} (h : Step k s s') : KeepsAuth s s' := by\n  cases h with\n  | kernel hk => exact hk.keeps\n  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | issue hs =>\n    cases hs with\n    | ok _ hst =>\n      obtain ⟨-, -, -, -, e⟩ := issue_ok_iff.1 hst\n      have e1 := congrArg Prod.fst e; simp only at e1; subst e1\n      exact .app rfl\n  | reset hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold resetAtEff; split <;> exact .same rfl\n\n/-- The places of `s` remain in `s'` with their footprint. -/\ndef FpStable (s s' : S3) : Prop :=\n  s.P.length ≤ s'.P.length ∧ ∀ q < s.P.length, ∀ l, l ∈ footprint s'.P q ↔ l ∈ footprint s.P q\n\ntheorem FpStable.same {s s₁ : S3} (h : s₁.P = s.P) : FpStable s s₁ :=\n  ⟨by rw [h]; exact Nat.le_refl _, fun _ _ _ => by rw [h]⟩\n\ntheorem FpStable.refl (s : S3) : FpStable s s := .same rfl\n\ntheorem FpStable.trans {s s₁ s₂ : S3} (h₁ : FpStable s s₁) (h₂ : FpStable s₁ s₂) :\n    FpStable s s₂ :=\n  ⟨Nat.le_trans h₁.1 h₂.1, fun q hq l =>\n    (h₂.2 q (Nat.lt_of_lt_of_le hq h₁.1) l).trans (h₁.2 q hq l)⟩\n\n/-- A kernel step removes no place and changes no footprint of an existing place (MM-03.3 §3–5):\nonly `transfer` changes places, their owners, and `enterFrame` and `alloc` append places whose\nparents are new (`EnterPreBase`, `ShapeOK`). -/\ntheorem KStep.fp {k : K} {s s' : S3} (h : KStep k s s') : FpStable s s' := by\n  cases h with\n  | derive hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | split hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | release hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    exact .same (by unfold releaseEff; split <;> rfl)\n  | transfer hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    exact ⟨by rw [transfer_len], fun q _ l => by rw [transfer_footprint]⟩\n  | depend hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | read hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | write hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | writeShared hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | pin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | unpin hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | enter hs =>\n    obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 hs\n    exact ⟨by simp [enterEff, enterP], fun q hq => enter_footprint_old hpre.1 hq⟩\n  | exit hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    exact .same (by unfold exitEff; split <;> rfl)\n  | endUse hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | free hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | alloc hs =>\n    cases hs with\n    | ok hst _ =>\n      exact ⟨by simp [allocEff, allocP, shapeP], fun q hq => shape_footprint_old hst.2.2.2.2.2.1 hq⟩\n  | store hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    exact .same (by unfold storeEff; split <;> rfl)\n\n/-- A step of `Reachable` removes no place and changes no footprint of an existing place. -/\ntheorem Step.fp {k : K} {s s' : S3} (h : Step k s s') : FpStable s s' := by\n  cases h with\n  | kernel hk => exact hk.fp\n  | newArena hs => obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs; exact .same rfl\n  | issue hs =>\n    cases hs with\n    | ok _ hst =>\n      obtain ⟨-, -, -, -, e⟩ := issue_ok_iff.1 hst\n      have e1 := congrArg Prod.fst e; simp only at e1; subst e1\n      exact .same rfl\n  | reset hs =>\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hs\n    unfold resetAtEff; split <;> exact .same rfl\n\n/-- `Reachable` is closed under its steps (MM-03.3 §10, `Step`). -/\ntheorem reachable_step {k : K} {statics : Statics} {s s' : S3} (hr : Reachable k statics s)\n    (h : Step k s s') : Reachable k statics s' := by\n  cases h with\n  | kernel hk =>\n    cases hk with\n    | derive hs => exact .derive hr hs\n    | split hs => exact .split hr hs\n    | release hs => exact .release hr hs\n    | transfer hs => exact .transfer hr hs\n    | depend hs => exact .depend hr hs\n    | enter hs => exact .enter hr hs\n    | exit hs => exact .exit hr hs\n    | read hs => exact .read hr hs\n    | write hs => exact .write hr hs\n    | writeShared hs => exact .writeShared hr hs\n    | pin hs => exact .pin hr hs\n    | unpin hs => exact .unpin hr hs\n    | endUse hs => exact .endUse hr hs\n    | free hs => exact .free hr hs\n    | alloc hs => exact .alloc hr hs\n    | store hs => exact .store hr hs\n  | newArena hs => exact .newArena hr hs\n  | issue hs => exact .issue hr hs\n  | reset hs => exact .reset hr hs\n\n/-- Finite sequences of steps of `Reachable`. -/\ninductive Steps (k : K) : S3 → S3 → Prop where\n  | refl (s : S3) : Steps k s s\n  | tail {s s₁ s₂ : S3} : Steps k s s₁ → Step k s₁ s₂ → Steps k s s₂\n\ntheorem Steps.keeps {k : K} {s s' : S3} (h : Steps k s s') : KeepsAuth s s' := by\n  induction h with\n  | refl s => exact .refl s\n  | tail _ h ih => exact ih.trans h.keeps\n\ntheorem Steps.fp {k : K} {s s' : S3} (h : Steps k s s') : FpStable s s' := by\n  induction h with\n  | refl s => exact .refl s\n  | tail _ h ih => exact ih.trans h.fp\n\ntheorem reachable_steps {k : K} {statics : Statics} {s s' : S3} (hr : Reachable k statics s)\n    (h : Steps k s s') : Reachable k statics s' := by\n  induction h with\n  | refl => exact hr\n  | tail _ h ih => exact reachable_step ih h\n\ntheorem Steps.single {k : K} {s s' : S3} (h : Step k s s') : Steps k s s' := .tail (.refl s) h\n\ntheorem Steps.trans {k : K} {s s₁ s₂ : S3} (h₁ : Steps k s s₁) (h₂ : Steps k s₁ s₂) :\n    Steps k s s₂ := by\n  induction h₂ with\n  | refl => exact h₁\n  | tail _ h ih => exact .tail ih h\n\n'''\ns=s.replace('\\nend Ern.HandlePool\\n', add+'end Ern.HandlePool\\n')\nopen(p,'w').write(s)\nEOF\ntime ~/.elan/bin/lake env lean Ern/HandlePool.lean 2>&1 | head -60","description":"Add kernel step lemmas and compile","timeout":600000},"caller":{"type":"direct"}}]}}
