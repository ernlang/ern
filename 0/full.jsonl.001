{"type":"custom-title","customTitle":"formalisation ERN memory model","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180"}
{"type":"agent-name","agentName":"formalisation ERN memory model","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180"}
{"type":"mode","mode":"normal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180"}
