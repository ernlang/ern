{"parentUuid":"71358cfc-1164-4d8b-bf98-b6306ea4b0ea","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgaqpSvLkSYHLs2kYcB3G","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CL3juQFJyw7wtxRmdxZmh8","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":4084,"limit":100},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7651,"cache_read_input_tokens":212396,"output_tokens":1754,"output_tokens_details":{"thinking_tokens":1502},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7651,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1754,"cache_read_input_tokens":212396,"cache_creation_input_tokens":7651,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7651},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01CL3juQFJyw7wtxRmdxZmh8":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":4084,"limit":100}},"serverClassifierRequest":"6c172384-16f8-4002-ac69-b33ef57b9486","apiBlockIndex":1,"requestId":"req_011CgaqpSeDVqyN229svxmmu","requestRef":"9c69743f-6add-433c-a390-d3bc785e731e","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"ab7c60f4-a446-4f81-a0ac-933952a784be","timestamp":"2026-10-31T19:09:56.960Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"ab7c60f4-a446-4f81-a0ac-933952a784be","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CL3juQFJyw7wtxRmdxZmh8","type":"tool_result","content":"4084\t/-! ## `free` (A6) -/\n4085\t\n4086\t/-- The holder is a place (A4, A5). -/\n4087\tdef Holder.isPlace : Holder → Bool\n4088\t  | .place _ => true\n4089\t  | .frame _ => false\n4090\t\n4091\t/-- The place `p` is an owned root (A6, owned place): no parent, owned by a place. -/\n4092\tdef OwnedRoot (s : S3) (p : Nat) : Prop :=\n4093\t  OptP (s.P[p]?) (fun pl => pl.parent = none ∧ pl.owner.isPlace = true) False\n4094\t\n4095\tinstance (s : S3) (p : Nat) : Decidable (OwnedRoot s p) := by\n4096\t  unfold OwnedRoot; infer_instance\n4097\t\n4098\t/-- Storage at `p` released (A6), before releasing authorities whose holder died: `p` and its\n4099\tparts are dead, `p` is freed, every authority covering a leaf of `p` or held within `p` is\n4100\treleased, the anchors of `p` and its parts are removed. -/\n4101\tdef freeS (s : S3) (p : Nat) : S3 :=\n4102\t  { s with\n4103\t    D := fun q => if partOf s.P q p then [] else s.D q\n4104\t    dead := fun q => s.dead q || decide (partOf s.P q p)\n4105\t    freed := fun q => s.freed q || decide (q = p)\n4106\t    A := s.A.map fun y => if (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∨ heldIn s.P p y.holder then\n4107\t      { y with active := false } else y }\n4108\t\n4109\t/-- Effect of `free p auth` (A6): `freeS`, then the authorities whose holder died are\n4110\treleased. -/\n4111\tdef freeEff (s : S3) (p : Nat) : S3 := cleanup (freeS s p)\n4112\t\n4113\t/-- Leaves whose storage ends with the release of `p` (A6): those of `p`, and those of places\n4114\tthat stop being usable, such as the places owned by `p`. -/\n4115\tdef FreedLeaf (s : S3) (p l : Nat) : Prop :=\n4116\t  l ∈ footprint s.P p ∨ (s.Usable l ∧ ¬ (freeS s p).Usable l)\n4117\t\n4118\tinstance (s : S3) (p l : Nat) : Decidable (FreedLeaf s p l) := by\n4119\t  unfold FreedLeaf; infer_instance\n4120\t\n4121\t/-- Authority `a` is released by the release of `p` (A4, A6): it is active, and covers a leaf of\n4122\t`p` or is held within `p` (released by `freeS`), or its holder is not live after `freeS`\n4123\t(released by `cleanup`). Under the possession clause of `WF3`, that holder dies with `p`. -/\n4124\tdef FreeDeact (s : S3) (p a : Nat) : Prop :=\n4125\t  OptP (s.A[a]?) (fun z => z.active = true ∧ ((∃ l ∈ z.footprint, l ∈ footprint s.P p) ∨\n4126\t    heldIn s.P p z.holder ∨ ¬ HolderLive (freeS s p) z.holder)) False\n4127\t\n4128\tinstance (s : S3) (p a : Nat) : Decidable (FreeDeact s p a) := by\n4129\t  unfold FreeDeact; infer_instance\n4130\t\n4131\t/-- Authority `j` does not block the release of `p` (A6): if it is an active derived authority on\n4132\ta freed leaf, or descending from an authority that the release releases (MM-03.3 §3, O3.2), it\n4133\tis held within `p` or its holder dies. -/\n4134\tdef FreeAccessOK (s : S3) (p j : Nat) : Prop :=\n4135\t  OptP (s.A[j]?) (fun y => y.active = true → y.origin ≠ none →\n4136\t    ((∃ l ∈ y.footprint, FreedLeaf s p l) ∨ ∃ a ∈ s.ancs j, FreeDeact s p a) →\n4137\t      heldIn s.P p y.holder ∨ ¬ HolderLive (freeS s p) y.holder) True\n4138\t\n4139\tinstance (s : S3) (p j : Nat) : Decidable (FreeAccessOK s p j) := by\n4140\t  unfold FreeAccessOK OptP; split <;> infer_instance\n4141\t\n4142\t/-- Anchor `x` survives the release of `p` (A6): it covers no leaf of `p`, is not held within\n4143\t`p`, and its holder stays live. -/\n4144\tdef FreeAnchorOK (s : S3) (p x : Nat) : Prop :=\n4145\t  OptP (s.A[x]?) (fun y => ¬ (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∧ ¬ heldIn s.P p y.holder ∧\n4146\t    HolderLive (freeS s p) y.holder) True\n4147\t\n4148\tinstance (s : S3) (p x : Nat) : Decidable (FreeAnchorOK s p x) := by\n4149\t  unfold FreeAnchorOK OptP; split <;> infer_instance\n4150\t\n4151\t/-- Preconditions of `free p auth` (A6), in order: `p` deallocable by the allocator contract\n4152\t(`Deallocable`) and `auth` a compatible deallocation authority (`FreeCompat`, MM-03.3.8); `p` a\n4153\tusable owned root (a part is not a unit of storage, and `WF3` gives a part the `dead` flag of its\n4154\tparent); exercisable `Modify` on `p` (B2); no active derived authority on a freed leaf, or\n4155\tdescending from a deactivated authority, held elsewhere and staying live; no usable place\n4156\tanchored on an authority covering `p`, held within `p`, or whose holder dies; no freed leaf\n4157\tpinned, statically (`Pinned`) or dynamically, without exception (B6: external obligations end\n4158\tonly through `unpin` under `ExternalDone`). -/\n4159\tdef FreePre (k : K) (s : S3) (p auth : Nat) : Prop :=\n4160\t  k.Deallocable p ∧ k.FreeCompat p auth ∧ s.Usable p ∧ OwnedRoot s p ∧ HasRight s .modify p ∧\n4161\t  (∀ j ∈ List.range s.A.length, FreeAccessOK s p j) ∧\n4162\t  (∀ q ∈ List.range s.P.length, (freeS s p).Usable q → ∀ x ∈ (freeS s p).D q,\n4163\t    FreeAnchorOK s p x) ∧\n4164\t  (∀ l ∈ List.range s.P.length, FreedLeaf s p l → s.pin l = false ∧ ¬ k.Pinned l)\n4165\t\n4166\tinstance (k : K) [DecidablePred k.Pinned]\n4167\t    [DecidablePred k.Deallocable] [∀ p a, Decidable (k.FreeCompat p a)] (s : S3) (p auth : Nat) :\n4168\t    Decidable (FreePre k s p auth) := by\n4169\t  unfold FreePre; infer_instance\n4170\t\n4171\t/-- `free` as a relation (A6). -/\n4172\tdef FreeStep (k : K) (p auth : Nat) (s : S3) : Outcome3 S3 → Prop :=\n4173\t  Guarded (FreePre k s p auth) (freeEff s p)\n4174\t\n4175\ttheorem freeS_get (s : S3) (p j : Nat) : (freeS s p).A[j]? = (s.A[j]?).map fun y =>\n4176\t    if (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∨ heldIn s.P p y.holder then\n4177\t      { y with active := false } else y := by\n4178\t  simp [freeS]\n4179\t\n4180\ttheorem freeS_releases (s : S3) (p : Nat) : OnlyReleases s (freeS s p) := by\n4181\t  refine ⟨by simp [freeS], fun j z hz => ?_⟩\n4182\t  rw [freeS_get] at hz\n4183\t  cases hy : s.A[j]? with"}]},"uuid":"3fe4adb3-da3f-4e6c-8239-6d9a68b029bb","timestamp":"2026-10-31T19:09:56.984Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","content":"/-! ## `free` (A6) -/\n\n/-- The holder is a place (A4, A5). -/\ndef Holder.isPlace : Holder → Bool\n  | .place _ => true\n  | .frame _ => false\n\n/-- The place `p` is an owned root (A6, owned place): no parent, owned by a place. -/\ndef OwnedRoot (s : S3) (p : Nat) : Prop :=\n  OptP (s.P[p]?) (fun pl => pl.parent = none ∧ pl.owner.isPlace = true) False\n\ninstance (s : S3) (p : Nat) : Decidable (OwnedRoot s p) := by\n  unfold OwnedRoot; infer_instance\n\n/-- Storage at `p` released (A6), before releasing authorities whose holder died: `p` and its\nparts are dead, `p` is freed, every authority covering a leaf of `p` or held within `p` is\nreleased, the anchors of `p` and its parts are removed. -/\ndef freeS (s : S3) (p : Nat) : S3 :=\n  { s with\n    D := fun q => if partOf s.P q p then [] else s.D q\n    dead := fun q => s.dead q || decide (partOf s.P q p)\n    freed := fun q => s.freed q || decide (q = p)\n    A := s.A.map fun y => if (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∨ heldIn s.P p y.holder then\n      { y with active := false } else y }\n\n/-- Effect of `free p auth` (A6): `freeS`, then the authorities whose holder died are\nreleased. -/\ndef freeEff (s : S3) (p : Nat) : S3 := cleanup (freeS s p)\n\n/-- Leaves whose storage ends with the release of `p` (A6): those of `p`, and those of places\nthat stop being usable, such as the places owned by `p`. -/\ndef FreedLeaf (s : S3) (p l : Nat) : Prop :=\n  l ∈ footprint s.P p ∨ (s.Usable l ∧ ¬ (freeS s p).Usable l)\n\ninstance (s : S3) (p l : Nat) : Decidable (FreedLeaf s p l) := by\n  unfold FreedLeaf; infer_instance\n\n/-- Authority `a` is released by the release of `p` (A4, A6): it is active, and covers a leaf of\n`p` or is held within `p` (released by `freeS`), or its holder is not live after `freeS`\n(released by `cleanup`). Under the possession clause of `WF3`, that holder dies with `p`. -/\ndef FreeDeact (s : S3) (p a : Nat) : Prop :=\n  OptP (s.A[a]?) (fun z => z.active = true ∧ ((∃ l ∈ z.footprint, l ∈ footprint s.P p) ∨\n    heldIn s.P p z.holder ∨ ¬ HolderLive (freeS s p) z.holder)) False\n\ninstance (s : S3) (p a : Nat) : Decidable (FreeDeact s p a) := by\n  unfold FreeDeact; infer_instance\n\n/-- Authority `j` does not block the release of `p` (A6): if it is an active derived authority on\na freed leaf, or descending from an authority that the release releases (MM-03.3 §3, O3.2), it\nis held within `p` or its holder dies. -/\ndef FreeAccessOK (s : S3) (p j : Nat) : Prop :=\n  OptP (s.A[j]?) (fun y => y.active = true → y.origin ≠ none →\n    ((∃ l ∈ y.footprint, FreedLeaf s p l) ∨ ∃ a ∈ s.ancs j, FreeDeact s p a) →\n      heldIn s.P p y.holder ∨ ¬ HolderLive (freeS s p) y.holder) True\n\ninstance (s : S3) (p j : Nat) : Decidable (FreeAccessOK s p j) := by\n  unfold FreeAccessOK OptP; split <;> infer_instance\n\n/-- Anchor `x` survives the release of `p` (A6): it covers no leaf of `p`, is not held within\n`p`, and its holder stays live. -/\ndef FreeAnchorOK (s : S3) (p x : Nat) : Prop :=\n  OptP (s.A[x]?) (fun y => ¬ (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∧ ¬ heldIn s.P p y.holder ∧\n    HolderLive (freeS s p) y.holder) True\n\ninstance (s : S3) (p x : Nat) : Decidable (FreeAnchorOK s p x) := by\n  unfold FreeAnchorOK OptP; split <;> infer_instance\n\n/-- Preconditions of `free p auth` (A6), in order: `p` deallocable by the allocator contract\n(`Deallocable`) and `auth` a compatible deallocation authority (`FreeCompat`, MM-03.3.8); `p` a\nusable owned root (a part is not a unit of storage, and `WF3` gives a part the `dead` flag of its\nparent); exercisable `Modify` on `p` (B2); no active derived authority on a freed leaf, or\ndescending from a deactivated authority, held elsewhere and staying live; no usable place\nanchored on an authority covering `p`, held within `p`, or whose holder dies; no freed leaf\npinned, statically (`Pinned`) or dynamically, without exception (B6: external obligations end\nonly through `unpin` under `ExternalDone`). -/\ndef FreePre (k : K) (s : S3) (p auth : Nat) : Prop :=\n  k.Deallocable p ∧ k.FreeCompat p auth ∧ s.Usable p ∧ OwnedRoot s p ∧ HasRight s .modify p ∧\n  (∀ j ∈ List.range s.A.length, FreeAccessOK s p j) ∧\n  (∀ q ∈ List.range s.P.length, (freeS s p).Usable q → ∀ x ∈ (freeS s p).D q,\n    FreeAnchorOK s p x) ∧\n  (∀ l ∈ List.range s.P.length, FreedLeaf s p l → s.pin l = false ∧ ¬ k.Pinned l)\n\ninstance (k : K) [DecidablePred k.Pinned]\n    [DecidablePred k.Deallocable] [∀ p a, Decidable (k.FreeCompat p a)] (s : S3) (p auth : Nat) :\n    Decidable (FreePre k s p auth) := by\n  unfold FreePre; infer_instance\n\n/-- `free` as a relation (A6). -/\ndef FreeStep (k : K) (p auth : Nat) (s : S3) : Outcome3 S3 → Prop :=\n  Guarded (FreePre k s p auth) (freeEff s p)\n\ntheorem freeS_get (s : S3) (p j : Nat) : (freeS s p).A[j]? = (s.A[j]?).map fun y =>\n    if (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∨ heldIn s.P p y.holder then\n      { y with active := false } else y := by\n  simp [freeS]\n\ntheorem freeS_releases (s : S3) (p : Nat) : OnlyReleases s (freeS s p) := by\n  refine ⟨by simp [freeS], fun j z hz => ?_⟩\n  rw [freeS_get] at hz\n  cases hy : s.A[j]? with","numLines":100,"startLine":4084,"totalLines":11961}},"sourceToolAssistantUUID":"ab7c60f4-a446-4f81-a0ac-933952a784be","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"3fe4adb3-da3f-4e6c-8239-6d9a68b029bb","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgaqpSvLkSYHLs2kYcB3G","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MeJMmELfZKohW5iYMqL2id","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":4290,"limit":120},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7651,"cache_read_input_tokens":212396,"output_tokens":1754,"output_tokens_details":{"thinking_tokens":1502},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7651,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1754,"cache_read_input_tokens":212396,"cache_creation_input_tokens":7651,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7651},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01MeJMmELfZKohW5iYMqL2id":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":4290,"limit":120}},"serverClassifierRequest":"6c172384-16f8-4002-ac69-b33ef57b9486","apiBlockIndex":2,"requestId":"req_011CgaqpSeDVqyN229svxmmu","requestRef":"9c69743f-6add-433c-a390-d3bc785e731e","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"2e0f06c8-6079-422e-8b7d-750db247e90a","timestamp":"2026-10-31T19:09:57.963Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"parentUuid":"2e0f06c8-6079-422e-8b7d-750db247e90a","isSidechain":false,"promptId":"06503e62-b7bb-46dd-8bf0-90c46d6d2b97","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MeJMmELfZKohW5iYMqL2id","type":"tool_result","content":"4290\t  exact hpre.2.2.2.2.2.2.2 l (List.mem_range.2 hl.lt) hl\n4291\t\n4292\t/-! ## `alloc` (B5, C6, C9) -/\n4293\t\n4294\t/-- Outcomes of `alloc` (B5): `ok`; `fail`, a defined failure of the allocator contract, with the\n4295\tstate unchanged; `reject` by the static discipline (MM-03.3 §3). -/\n4296\tinductive AOutcome where\n4297\t  | ok (s : S3)\n4298\t  | fail (s : S3)\n4299\t  | reject\n4300\t\n4301\t/-- Right to update the metadata of the allocator value at `provider` (B5): exercisable `Modify` on\n4302\t`provider`, or a `writeShared` right (A9) on its leaves, all `SharedMutable`. -/\n4303\tdef ProviderRight (k : K) (s : S3) (provider : Nat) : Prop :=\n4304\t  HasRight s .modify provider ∨\n4305\t  ∃ via ∈ List.range s.A.length, s.ExercisableAt via .observe ∧\n4306\t    ∀ l ∈ footprint s.P provider, effective s via l ≠ none ∧ k.SharedMutable l ∧ DepsValid s l\n4307\t\n4308\tinstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (provider : Nat) :\n4309\t    Decidable (ProviderRight k s provider) := by\n4310\t  unfold ProviderRight; infer_instance\n4311\t\n4312\t/-- Owner of the element of index `i` of a shape `ls` (A5; C6): its owning element if any, `hd`\n4313\totherwise. The owner of a local of `enterFrame` is the case `hd = .frame f` (`localOwner`). -/\n4314\tdef shapeOwner (ls : List (Option Nat × Option Nat × Nat)) (hd : Holder) (i : Nat) : Holder :=\n4315\t  match (ls[i]?).bind (·.2.1) with\n4316\t  | some o => .place o\n4317\t  | none => hd\n4318\t\n4319\t/-- Places `P` followed by the elements of the shape `ls` (C6: the encoding of the locals of\n4320\t`enterFrame`, an indexed forest of (parent, owning element, kind)); the elements without owning\n4321\telement are owned by `hd` (A5). -/\n4322\tdef shapeP (P : List Place) (hd : Holder) (ls : List (Option Nat × Option Nat × Nat)) :\n4323\t    List Place :=\n4324\t  P ++ (List.range ls.length).map fun i =>\n4325\t    ⟨(ls[i]?).bind (·.1), shapeOwner ls hd i, ((ls[i]?).map (·.2.2)).getD 0⟩\n4326\t\n4327\t/-- `enterFrame` lays out its locals as a shape (C6). -/\n4328\ttheorem enterP_eq_shapeP (s : S3) (ls : List (Option Nat × Option Nat × Nat)) :\n4329\t    enterP s ls = shapeP s.P (.frame s.nF) ls := rfl\n4330\t\n4331\t/-- Well-formed shape at offset `n` (MM-03.3 §4, O6; C6): the parent and the owning element of an\n4332\telement are earlier elements, and a part has the owning element of its parent. It is the clause\n4333\tof `EnterPre` on the locals (`enterPre_shapeOK`). -/\n4334\tdef ShapeOK (n : Nat) (ls : List (Option Nat × Option Nat × Nat)) : Prop :=\n4335\t  ∀ i ∈ List.range ls.length,\n4336\t    OptP ((ls[i]?).bind (·.1)) (fun r => n ≤ r ∧ r < n + i ∧\n4337\t      (ls[i]?).bind (·.2.1) = (ls[r - n]?).bind (·.2.1)) True ∧\n4338\t    OptP ((ls[i]?).bind (·.2.1)) (fun o => n ≤ o ∧ o < n + i) True\n4339\t\n4340\tinstance (n : Nat) (ls : List (Option Nat × Option Nat × Nat)) : Decidable (ShapeOK n ls) := by\n4341\t  unfold ShapeOK; infer_instance\n4342\t\n4343\ttheorem enterPre_shapeOK {s : S3} {ps : List Nat} {ls : List (Option Nat × Option Nat × Nat)}\n4344\t    (h : EnterPreBase s ps ls) : ShapeOK s.P.length ls := h.2.2\n4345\t\n4346\t/-- Static preconditions of `alloc provider owner shape` (B5; C6; D2): the allocator value at\n4347\t`provider` is usable, with the right to update its metadata; the place `owner`, which receives\n4348\tthe ownership, is usable, with exercisable `Modify`; the leaves of the provider are `Init`; the\n4349\tshape is well-formed and not empty (D2: an allocation of size zero is a shape of one leaf). -/\n4350\tdef AllocStatic (k : K) (s : S3) (provider owner : Nat)\n4351\t    (ls : List (Option Nat × Option Nat × Nat)) : Prop :=\n4352\t  s.Usable provider ∧ ProviderRight k s provider ∧ s.Usable owner ∧ HasRight s .modify owner ∧\n4353\t    (∀ l ∈ footprint s.P provider, s.I l = .init) ∧ ShapeOK s.P.length ls ∧ ls ≠ []\n4354\t\n4355\tinstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (provider owner : Nat)\n4356\t    (ls : List (Option Nat × Option Nat × Nat)) : Decidable (AllocStatic k s provider owner ls) := by\n4357\t  unfold AllocStatic; infer_instance\n4358\t\n4359\t/-- Places after `alloc` (B5; C6): the elements of the shape appended, those without owning\n4360\telement owned by `owner`. -/\n4361\tdef allocP (s : S3) (owner : Nat) (ls : List (Option Nat × Option Nat × Nat)) : List Place :=\n4362\t  shapeP s.P (.place owner) ls\n4363\t\n4364\t/-- Effect of `alloc provider owner shape` (B5; C6): the elements of the shape appended as places\n4365\tof fresh identities, `Uninit`, without anchor, alive, not freed, not pinned; one root authority\n4366\t`Modify` per root element, on its footprint, held by the owner of the element (A4); the metadata\n4367\tof the provider, its leaves, set to `Init`. The shape is abstract: it fixes neither alignment nor\n4368\tlayout (milestone 2). -/\n4369\tdef allocEff (s : S3) (provider owner : Nat) (ls : List (Option Nat × Option Nat × Nat)) : S3 :=\n4370\t  { s with\n4371\t    P := allocP s owner ls\n4372\t    I := fun l => if s.P.length ≤ l then .uninit\n4373\t      else if l ∈ footprint s.P provider then .init else s.I l\n4374\t    A := s.A ++ (rootIdx ls).map fun i =>\n4375\t      ⟨.modify, none, footprint (allocP s owner ls) (s.P.length + i),\n4376\t        shapeOwner ls (.place owner) i, true⟩\n4377\t    D := fun q => if s.P.length ≤ q then [] else s.D q\n4378\t    dead := fun q => if s.P.length ≤ q then false else s.dead q\n4379\t    freed := fun q => if s.P.length ≤ q then false else s.freed q\n4380\t    pin := fun q => if s.P.length ≤ q then false else s.pin q }\n4381\t\n4382\t/-- `alloc provider owner shape` as a relation (B5; C6; C9): `reject` when a static precondition\n4383\tfails; `fail`, with the state unchanged, when the allocator contract cannot satisfy the request in\n4384\tthe current state (`Satisfiable`); `ok` otherwise. -/\n4385\tinductive AllocStep (k : K) (provider owner : Nat) (ls : List (Option Nat × Option Nat × Nat))\n4386\t    (s : S3) : AOutcome → Prop where\n4387\t  | ok : AllocStatic k s provider owner ls → k.Satisfiable provider ls s →\n4388\t      AllocStep k provider owner ls s (.ok (allocEff s provider owner ls))\n4389\t  | fail : AllocStatic k s provider owner ls → ¬ k.Satisfiable provider ls s →\n4390\t      AllocStep k provider owner ls s (.fail s)\n4391\t  | reject : ¬ AllocStatic k s provider owner ls → AllocStep k provider owner ls s .reject\n4392\t\n4393\t/-- Determinism of `alloc` (B5). -/\n4394\ttheorem alloc_det {k : K} {pr ow : Nat} {ls : List (Option Nat × Option Nat × Nat)} {s : S3}\n4395\t    {o₁ o₂ : AOutcome} (h₁ : AllocStep k pr ow ls s o₁) (h₂ : AllocStep k pr ow ls s o₂) :\n4396\t    o₁ = o₂ := by\n4397\t  cases h₁ <;> cases h₂ <;> first | rfl | contradiction\n4398\t\n4399\t/-- `alloc_fail_unchanged` (B5; C9): a failed allocation leaves the state unchanged, and happens\n4400\texactly when the static preconditions hold and the allocator contract cannot satisfy the request\n4401\tin the current state. -/\n4402\ttheorem alloc_fail_unchanged {k : K} {pr ow : Nat} {ls : List (Option Nat × Option Nat × Nat)}\n4403\t    {s s' : S3} (h : AllocStep k pr ow ls s (.fail s')) :\n4404\t    s' = s ∧ AllocStatic k s pr ow ls ∧ ¬ k.Satisfiable pr ls s := by\n4405\t  cases h with\n4406\t  | fail h1 h2 => exact ⟨rfl, h1, h2⟩\n4407\t\n4408\tsection Shape\n4409\tvariable {P : List Place} {hd : Holder} {ls : List (Option Nat × Option Nat × Nat)}"}]},"uuid":"abcaa9de-368f-47eb-abdc-e853208318b0","timestamp":"2026-10-31T19:09:57.991Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","content":"  exact hpre.2.2.2.2.2.2.2 l (List.mem_range.2 hl.lt) hl\n\n/-! ## `alloc` (B5, C6, C9) -/\n\n/-- Outcomes of `alloc` (B5): `ok`; `fail`, a defined failure of the allocator contract, with the\nstate unchanged; `reject` by the static discipline (MM-03.3 §3). -/\ninductive AOutcome where\n  | ok (s : S3)\n  | fail (s : S3)\n  | reject\n\n/-- Right to update the metadata of the allocator value at `provider` (B5): exercisable `Modify` on\n`provider`, or a `writeShared` right (A9) on its leaves, all `SharedMutable`. -/\ndef ProviderRight (k : K) (s : S3) (provider : Nat) : Prop :=\n  HasRight s .modify provider ∨\n  ∃ via ∈ List.range s.A.length, s.ExercisableAt via .observe ∧\n    ∀ l ∈ footprint s.P provider, effective s via l ≠ none ∧ k.SharedMutable l ∧ DepsValid s l\n\ninstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (provider : Nat) :\n    Decidable (ProviderRight k s provider) := by\n  unfold ProviderRight; infer_instance\n\n/-- Owner of the element of index `i` of a shape `ls` (A5; C6): its owning element if any, `hd`\notherwise. The owner of a local of `enterFrame` is the case `hd = .frame f` (`localOwner`). -/\ndef shapeOwner (ls : List (Option Nat × Option Nat × Nat)) (hd : Holder) (i : Nat) : Holder :=\n  match (ls[i]?).bind (·.2.1) with\n  | some o => .place o\n  | none => hd\n\n/-- Places `P` followed by the elements of the shape `ls` (C6: the encoding of the locals of\n`enterFrame`, an indexed forest of (parent, owning element, kind)); the elements without owning\nelement are owned by `hd` (A5). -/\ndef shapeP (P : List Place) (hd : Holder) (ls : List (Option Nat × Option Nat × Nat)) :\n    List Place :=\n  P ++ (List.range ls.length).map fun i =>\n    ⟨(ls[i]?).bind (·.1), shapeOwner ls hd i, ((ls[i]?).map (·.2.2)).getD 0⟩\n\n/-- `enterFrame` lays out its locals as a shape (C6). -/\ntheorem enterP_eq_shapeP (s : S3) (ls : List (Option Nat × Option Nat × Nat)) :\n    enterP s ls = shapeP s.P (.frame s.nF) ls := rfl\n\n/-- Well-formed shape at offset `n` (MM-03.3 §4, O6; C6): the parent and the owning element of an\nelement are earlier elements, and a part has the owning element of its parent. It is the clause\nof `EnterPre` on the locals (`enterPre_shapeOK`). -/\ndef ShapeOK (n : Nat) (ls : List (Option Nat × Option Nat × Nat)) : Prop :=\n  ∀ i ∈ List.range ls.length,\n    OptP ((ls[i]?).bind (·.1)) (fun r => n ≤ r ∧ r < n + i ∧\n      (ls[i]?).bind (·.2.1) = (ls[r - n]?).bind (·.2.1)) True ∧\n    OptP ((ls[i]?).bind (·.2.1)) (fun o => n ≤ o ∧ o < n + i) True\n\ninstance (n : Nat) (ls : List (Option Nat × Option Nat × Nat)) : Decidable (ShapeOK n ls) := by\n  unfold ShapeOK; infer_instance\n\ntheorem enterPre_shapeOK {s : S3} {ps : List Nat} {ls : List (Option Nat × Option Nat × Nat)}\n    (h : EnterPreBase s ps ls) : ShapeOK s.P.length ls := h.2.2\n\n/-- Static preconditions of `alloc provider owner shape` (B5; C6; D2): the allocator value at\n`provider` is usable, with the right to update its metadata; the place `owner`, which receives\nthe ownership, is usable, with exercisable `Modify`; the leaves of the provider are `Init`; the\nshape is well-formed and not empty (D2: an allocation of size zero is a shape of one leaf). -/\ndef AllocStatic (k : K) (s : S3) (provider owner : Nat)\n    (ls : List (Option Nat × Option Nat × Nat)) : Prop :=\n  s.Usable provider ∧ ProviderRight k s provider ∧ s.Usable owner ∧ HasRight s .modify owner ∧\n    (∀ l ∈ footprint s.P provider, s.I l = .init) ∧ ShapeOK s.P.length ls ∧ ls ≠ []\n\ninstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (provider owner : Nat)\n    (ls : List (Option Nat × Option Nat × Nat)) : Decidable (AllocStatic k s provider owner ls) := by\n  unfold AllocStatic; infer_instance\n\n/-- Places after `alloc` (B5; C6): the elements of the shape appended, those without owning\nelement owned by `owner`. -/\ndef allocP (s : S3) (owner : Nat) (ls : List (Option Nat × Option Nat × Nat)) : List Place :=\n  shapeP s.P (.place owner) ls\n\n/-- Effect of `alloc provider owner shape` (B5; C6): the elements of the shape appended as places\nof fresh identities, `Uninit`, without anchor, alive, not freed, not pinned; one root authority\n`Modify` per root element, on its footprint, held by the owner of the element (A4); the metadata\nof the provider, its leaves, set to `Init`. The shape is abstract: it fixes neither alignment nor\nlayout (milestone 2). -/\ndef allocEff (s : S3) (provider owner : Nat) (ls : List (Option Nat × Option Nat × Nat)) : S3 :=\n  { s with\n    P := allocP s owner ls\n    I := fun l => if s.P.length ≤ l then .uninit\n      else if l ∈ footprint s.P provider then .init else s.I l\n    A := s.A ++ (rootIdx ls).map fun i =>\n      ⟨.modify, none, footprint (allocP s owner ls) (s.P.length + i),\n        shapeOwner ls (.place owner) i, true⟩\n    D := fun q => if s.P.length ≤ q then [] else s.D q\n    dead := fun q => if s.P.length ≤ q then false else s.dead q\n    freed := fun q => if s.P.length ≤ q then false else s.freed q\n    pin := fun q => if s.P.length ≤ q then false else s.pin q }\n\n/-- `alloc provider owner shape` as a relation (B5; C6; C9): `reject` when a static precondition\nfails; `fail`, with the state unchanged, when the allocator contract cannot satisfy the request in\nthe current state (`Satisfiable`); `ok` otherwise. -/\ninductive AllocStep (k : K) (provider owner : Nat) (ls : List (Option Nat × Option Nat × Nat))\n    (s : S3) : AOutcome → Prop where\n  | ok : AllocStatic k s provider owner ls → k.Satisfiable provider ls s →\n      AllocStep k provider owner ls s (.ok (allocEff s provider owner ls))\n  | fail : AllocStatic k s provider owner ls → ¬ k.Satisfiable provider ls s →\n      AllocStep k provider owner ls s (.fail s)\n  | reject : ¬ AllocStatic k s provider owner ls → AllocStep k provider owner ls s .reject\n\n/-- Determinism of `alloc` (B5). -/\ntheorem alloc_det {k : K} {pr ow : Nat} {ls : List (Option Nat × Option Nat × Nat)} {s : S3}\n    {o₁ o₂ : AOutcome} (h₁ : AllocStep k pr ow ls s o₁) (h₂ : AllocStep k pr ow ls s o₂) :\n    o₁ = o₂ := by\n  cases h₁ <;> cases h₂ <;> first | rfl | contradiction\n\n/-- `alloc_fail_unchanged` (B5; C9): a failed allocation leaves the state unchanged, and happens\nexactly when the static preconditions hold and the allocator contract cannot satisfy the request\nin the current state. -/\ntheorem alloc_fail_unchanged {k : K} {pr ow : Nat} {ls : List (Option Nat × Option Nat × Nat)}\n    {s s' : S3} (h : AllocStep k pr ow ls s (.fail s')) :\n    s' = s ∧ AllocStatic k s pr ow ls ∧ ¬ k.Satisfiable pr ls s := by\n  cases h with\n  | fail h1 h2 => exact ⟨rfl, h1, h2⟩\n\nsection Shape\nvariable {P : List Place} {hd : Holder} {ls : List (Option Nat × Option Nat × Nat)}","numLines":120,"startLine":4290,"totalLines":11961}},"sourceToolAssistantUUID":"2e0f06c8-6079-422e-8b7d-750db247e90a","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
{"type":"api-request-blob","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","hash":"29893bff16a9976e5aaed240d850ec40f93ec3202ce6c0d4f17fb4b073dd9e06","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01CL3juQFJyw7wtxRmdxZmh8","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":4084,"limit":100},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01MeJMmELfZKohW5iYMqL2id","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM03.lean","offset":4290,"limit":120},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","hash":"7f482e661bf3e716a5ade7ca969312b716ba16f147092cf1dd9ff72d0f9bc767","message":{"role":"user","content":[{"tool_use_id":"toolu_01CL3juQFJyw7wtxRmdxZmh8","type":"tool_result","content":"4084\t/-! ## `free` (A6) -/\n4085\t\n4086\t/-- The holder is a place (A4, A5). -/\n4087\tdef Holder.isPlace : Holder → Bool\n4088\t  | .place _ => true\n4089\t  | .frame _ => false\n4090\t\n4091\t/-- The place `p` is an owned root (A6, owned place): no parent, owned by a place. -/\n4092\tdef OwnedRoot (s : S3) (p : Nat) : Prop :=\n4093\t  OptP (s.P[p]?) (fun pl => pl.parent = none ∧ pl.owner.isPlace = true) False\n4094\t\n4095\tinstance (s : S3) (p : Nat) : Decidable (OwnedRoot s p) := by\n4096\t  unfold OwnedRoot; infer_instance\n4097\t\n4098\t/-- Storage at `p` released (A6), before releasing authorities whose holder died: `p` and its\n4099\tparts are dead, `p` is freed, every authority covering a leaf of `p` or held within `p` is\n4100\treleased, the anchors of `p` and its parts are removed. -/\n4101\tdef freeS (s : S3) (p : Nat) : S3 :=\n4102\t  { s with\n4103\t    D := fun q => if partOf s.P q p then [] else s.D q\n4104\t    dead := fun q => s.dead q || decide (partOf s.P q p)\n4105\t    freed := fun q => s.freed q || decide (q = p)\n4106\t    A := s.A.map fun y => if (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∨ heldIn s.P p y.holder then\n4107\t      { y with active := false } else y }\n4108\t\n4109\t/-- Effect of `free p auth` (A6): `freeS`, then the authorities whose holder died are\n4110\treleased. -/\n4111\tdef freeEff (s : S3) (p : Nat) : S3 := cleanup (freeS s p)\n4112\t\n4113\t/-- Leaves whose storage ends with the release of `p` (A6): those of `p`, and those of places\n4114\tthat stop being usable, such as the places owned by `p`. -/\n4115\tdef FreedLeaf (s : S3) (p l : Nat) : Prop :=\n4116\t  l ∈ footprint s.P p ∨ (s.Usable l ∧ ¬ (freeS s p).Usable l)\n4117\t\n4118\tinstance (s : S3) (p l : Nat) : Decidable (FreedLeaf s p l) := by\n4119\t  unfold FreedLeaf; infer_instance\n4120\t\n4121\t/-- Authority `a` is released by the release of `p` (A4, A6): it is active, and covers a leaf of\n4122\t`p` or is held within `p` (released by `freeS`), or its holder is not live after `freeS`\n4123\t(released by `cleanup`). Under the possession clause of `WF3`, that holder dies with `p`. -/\n4124\tdef FreeDeact (s : S3) (p a : Nat) : Prop :=\n4125\t  OptP (s.A[a]?) (fun z => z.active = true ∧ ((∃ l ∈ z.footprint, l ∈ footprint s.P p) ∨\n4126\t    heldIn s.P p z.holder ∨ ¬ HolderLive (freeS s p) z.holder)) False\n4127\t\n4128\tinstance (s : S3) (p a : Nat) : Decidable (FreeDeact s p a) := by\n4129\t  unfold FreeDeact; infer_instance\n4130\t\n4131\t/-- Authority `j` does not block the release of `p` (A6): if it is an active derived authority on\n4132\ta freed leaf, or descending from an authority that the release releases (MM-03.3 §3, O3.2), it\n4133\tis held within `p` or its holder dies. -/\n4134\tdef FreeAccessOK (s : S3) (p j : Nat) : Prop :=\n4135\t  OptP (s.A[j]?) (fun y => y.active = true → y.origin ≠ none →\n4136\t    ((∃ l ∈ y.footprint, FreedLeaf s p l) ∨ ∃ a ∈ s.ancs j, FreeDeact s p a) →\n4137\t      heldIn s.P p y.holder ∨ ¬ HolderLive (freeS s p) y.holder) True\n4138\t\n4139\tinstance (s : S3) (p j : Nat) : Decidable (FreeAccessOK s p j) := by\n4140\t  unfold FreeAccessOK OptP; split <;> infer_instance\n4141\t\n4142\t/-- Anchor `x` survives the release of `p` (A6): it covers no leaf of `p`, is not held within\n4143\t`p`, and its holder stays live. -/\n4144\tdef FreeAnchorOK (s : S3) (p x : Nat) : Prop :=\n4145\t  OptP (s.A[x]?) (fun y => ¬ (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∧ ¬ heldIn s.P p y.holder ∧\n4146\t    HolderLive (freeS s p) y.holder) True\n4147\t\n4148\tinstance (s : S3) (p x : Nat) : Decidable (FreeAnchorOK s p x) := by\n4149\t  unfold FreeAnchorOK OptP; split <;> infer_instance\n4150\t\n4151\t/-- Preconditions of `free p auth` (A6), in order: `p` deallocable by the allocator contract\n4152\t(`Deallocable`) and `auth` a compatible deallocation authority (`FreeCompat`, MM-03.3.8); `p` a\n4153\tusable owned root (a part is not a unit of storage, and `WF3` gives a part the `dead` flag of its\n4154\tparent); exercisable `Modify` on `p` (B2); no active derived authority on a freed leaf, or\n4155\tdescending from a deactivated authority, held elsewhere and staying live; no usable place\n4156\tanchored on an authority covering `p`, held within `p`, or whose holder dies; no freed leaf\n4157\tpinned, statically (`Pinned`) or dynamically, without exception (B6: external obligations end\n4158\tonly through `unpin` under `ExternalDone`). -/\n4159\tdef FreePre (k : K) (s : S3) (p auth : Nat) : Prop :=\n4160\t  k.Deallocable p ∧ k.FreeCompat p auth ∧ s.Usable p ∧ OwnedRoot s p ∧ HasRight s .modify p ∧\n4161\t  (∀ j ∈ List.range s.A.length, FreeAccessOK s p j) ∧\n4162\t  (∀ q ∈ List.range s.P.length, (freeS s p).Usable q → ∀ x ∈ (freeS s p).D q,\n4163\t    FreeAnchorOK s p x) ∧\n4164\t  (∀ l ∈ List.range s.P.length, FreedLeaf s p l → s.pin l = false ∧ ¬ k.Pinned l)\n4165\t\n4166\tinstance (k : K) [DecidablePred k.Pinned]\n4167\t    [DecidablePred k.Deallocable] [∀ p a, Decidable (k.FreeCompat p a)] (s : S3) (p auth : Nat) :\n4168\t    Decidable (FreePre k s p auth) := by\n4169\t  unfold FreePre; infer_instance\n4170\t\n4171\t/-- `free` as a relation (A6). -/\n4172\tdef FreeStep (k : K) (p auth : Nat) (s : S3) : Outcome3 S3 → Prop :=\n4173\t  Guarded (FreePre k s p auth) (freeEff s p)\n4174\t\n4175\ttheorem freeS_get (s : S3) (p j : Nat) : (freeS s p).A[j]? = (s.A[j]?).map fun y =>\n4176\t    if (∃ l ∈ y.footprint, l ∈ footprint s.P p) ∨ heldIn s.P p y.holder then\n4177\t      { y with active := false } else y := by\n4178\t  simp [freeS]\n4179\t\n4180\ttheorem freeS_releases (s : S3) (p : Nat) : OnlyReleases s (freeS s p) := by\n4181\t  refine ⟨by simp [freeS], fun j z hz => ?_⟩\n4182\t  rw [freeS_get] at hz\n4183\t  cases hy : s.A[j]? with"},{"tool_use_id":"toolu_01MeJMmELfZKohW5iYMqL2id","type":"tool_result","content":"4290\t  exact hpre.2.2.2.2.2.2.2 l (List.mem_range.2 hl.lt) hl\n4291\t\n4292\t/-! ## `alloc` (B5, C6, C9) -/\n4293\t\n4294\t/-- Outcomes of `alloc` (B5): `ok`; `fail`, a defined failure of the allocator contract, with the\n4295\tstate unchanged; `reject` by the static discipline (MM-03.3 §3). -/\n4296\tinductive AOutcome where\n4297\t  | ok (s : S3)\n4298\t  | fail (s : S3)\n4299\t  | reject\n4300\t\n4301\t/-- Right to update the metadata of the allocator value at `provider` (B5): exercisable `Modify` on\n4302\t`provider`, or a `writeShared` right (A9) on its leaves, all `SharedMutable`. -/\n4303\tdef ProviderRight (k : K) (s : S3) (provider : Nat) : Prop :=\n4304\t  HasRight s .modify provider ∨\n4305\t  ∃ via ∈ List.range s.A.length, s.ExercisableAt via .observe ∧\n4306\t    ∀ l ∈ footprint s.P provider, effective s via l ≠ none ∧ k.SharedMutable l ∧ DepsValid s l\n4307\t\n4308\tinstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (provider : Nat) :\n4309\t    Decidable (ProviderRight k s provider) := by\n4310\t  unfold ProviderRight; infer_instance\n4311\t\n4312\t/-- Owner of the element of index `i` of a shape `ls` (A5; C6): its owning element if any, `hd`\n4313\totherwise. The owner of a local of `enterFrame` is the case `hd = .frame f` (`localOwner`). -/\n4314\tdef shapeOwner (ls : List (Option Nat × Option Nat × Nat)) (hd : Holder) (i : Nat) : Holder :=\n4315\t  match (ls[i]?).bind (·.2.1) with\n4316\t  | some o => .place o\n4317\t  | none => hd\n4318\t\n4319\t/-- Places `P` followed by the elements of the shape `ls` (C6: the encoding of the locals of\n4320\t`enterFrame`, an indexed forest of (parent, owning element, kind)); the elements without owning\n4321\telement are owned by `hd` (A5). -/\n4322\tdef shapeP (P : List Place) (hd : Holder) (ls : List (Option Nat × Option Nat × Nat)) :\n4323\t    List Place :=\n4324\t  P ++ (List.range ls.length).map fun i =>\n4325\t    ⟨(ls[i]?).bind (·.1), shapeOwner ls hd i, ((ls[i]?).map (·.2.2)).getD 0⟩\n4326\t\n4327\t/-- `enterFrame` lays out its locals as a shape (C6). -/\n4328\ttheorem enterP_eq_shapeP (s : S3) (ls : List (Option Nat × Option Nat × Nat)) :\n4329\t    enterP s ls = shapeP s.P (.frame s.nF) ls := rfl\n4330\t\n4331\t/-- Well-formed shape at offset `n` (MM-03.3 §4, O6; C6): the parent and the owning element of an\n4332\telement are earlier elements, and a part has the owning element of its parent. It is the clause\n4333\tof `EnterPre` on the locals (`enterPre_shapeOK`). -/\n4334\tdef ShapeOK (n : Nat) (ls : List (Option Nat × Option Nat × Nat)) : Prop :=\n4335\t  ∀ i ∈ List.range ls.length,\n4336\t    OptP ((ls[i]?).bind (·.1)) (fun r => n ≤ r ∧ r < n + i ∧\n4337\t      (ls[i]?).bind (·.2.1) = (ls[r - n]?).bind (·.2.1)) True ∧\n4338\t    OptP ((ls[i]?).bind (·.2.1)) (fun o => n ≤ o ∧ o < n + i) True\n4339\t\n4340\tinstance (n : Nat) (ls : List (Option Nat × Option Nat × Nat)) : Decidable (ShapeOK n ls) := by\n4341\t  unfold ShapeOK; infer_instance\n4342\t\n4343\ttheorem enterPre_shapeOK {s : S3} {ps : List Nat} {ls : List (Option Nat × Option Nat × Nat)}\n4344\t    (h : EnterPreBase s ps ls) : ShapeOK s.P.length ls := h.2.2\n4345\t\n4346\t/-- Static preconditions of `alloc provider owner shape` (B5; C6; D2): the allocator value at\n4347\t`provider` is usable, with the right to update its metadata; the place `owner`, which receives\n4348\tthe ownership, is usable, with exercisable `Modify`; the leaves of the provider are `Init`; the\n4349\tshape is well-formed and not empty (D2: an allocation of size zero is a shape of one leaf). -/\n4350\tdef AllocStatic (k : K) (s : S3) (provider owner : Nat)\n4351\t    (ls : List (Option Nat × Option Nat × Nat)) : Prop :=\n4352\t  s.Usable provider ∧ ProviderRight k s provider ∧ s.Usable owner ∧ HasRight s .modify owner ∧\n4353\t    (∀ l ∈ footprint s.P provider, s.I l = .init) ∧ ShapeOK s.P.length ls ∧ ls ≠ []\n4354\t\n4355\tinstance (k : K) [DecidablePred k.SharedMutable] (s : S3) (provider owner : Nat)\n4356\t    (ls : List (Option Nat × Option Nat × Nat)) : Decidable (AllocStatic k s provider owner ls) := by\n4357\t  unfold AllocStatic; infer_instance\n4358\t\n4359\t/-- Places after `alloc` (B5; C6): the elements of the shape appended, those without owning\n4360\telement owned by `owner`. -/\n4361\tdef allocP (s : S3) (owner : Nat) (ls : List (Option Nat × Option Nat × Nat)) : List Place :=\n4362\t  shapeP s.P (.place owner) ls\n4363\t\n4364\t/-- Effect of `alloc provider owner shape` (B5; C6): the elements of the shape appended as places\n4365\tof fresh identities, `Uninit`, without anchor, alive, not freed, not pinned; one root authority\n4366\t`Modify` per root element, on its footprint, held by the owner of the element (A4); the metadata\n4367\tof the provider, its leaves, set to `Init`. The shape is abstract: it fixes neither alignment nor\n4368\tlayout (milestone 2). -/\n4369\tdef allocEff (s : S3) (provider owner : Nat) (ls : List (Option Nat × Option Nat × Nat)) : S3 :=\n4370\t  { s with\n4371\t    P := allocP s owner ls\n4372\t    I := fun l => if s.P.length ≤ l then .uninit\n4373\t      else if l ∈ footprint s.P provider then .init else s.I l\n4374\t    A := s.A ++ (rootIdx ls).map fun i =>\n4375\t      ⟨.modify, none, footprint (allocP s owner ls) (s.P.length + i),\n4376\t        shapeOwner ls (.place owner) i, true⟩\n4377\t    D := fun q => if s.P.length ≤ q then [] else s.D q\n4378\t    dead := fun q => if s.P.length ≤ q then false else s.dead q\n4379\t    freed := fun q => if s.P.length ≤ q then false else s.freed q\n4380\t    pin := fun q => if s.P.length ≤ q then false else s.pin q }\n4381\t\n4382\t/-- `alloc provider owner shape` as a relation (B5; C6; C9): `reject` when a static precondition\n4383\tfails; `fail`, with the state unchanged, when the allocator contract cannot satisfy the request in\n4384\tthe current state (`Satisfiable`); `ok` otherwise. -/\n4385\tinductive AllocStep (k : K) (provider owner : Nat) (ls : List (Option Nat × Option Nat × Nat))\n4386\t    (s : S3) : AOutcome → Prop where\n4387\t  | ok : AllocStatic k s provider owner ls → k.Satisfiable provider ls s →\n4388\t      AllocStep k provider owner ls s (.ok (allocEff s provider owner ls))\n4389\t  | fail : AllocStatic k s provider owner ls → ¬ k.Satisfiable provider ls s →\n4390\t      AllocStep k provider owner ls s (.fail s)\n4391\t  | reject : ¬ AllocStatic k s provider owner ls → AllocStep k provider owner ls s .reject\n4392\t\n4393\t/-- Determinism of `alloc` (B5). -/\n4394\ttheorem alloc_det {k : K} {pr ow : Nat} {ls : List (Option Nat × Option Nat × Nat)} {s : S3}\n4395\t    {o₁ o₂ : AOutcome} (h₁ : AllocStep k pr ow ls s o₁) (h₂ : AllocStep k pr ow ls s o₂) :\n4396\t    o₁ = o₂ := by\n4397\t  cases h₁ <;> cases h₂ <;> first | rfl | contradiction\n4398\t\n4399\t/-- `alloc_fail_unchanged` (B5; C9): a failed allocation leaves the state unchanged, and happens\n4400\texactly when the static preconditions hold and the allocator contract cannot satisfy the request\n4401\tin the current state. -/\n4402\ttheorem alloc_fail_unchanged {k : K} {pr ow : Nat} {ls : List (Option Nat × Option Nat × Nat)}\n4403\t    {s s' : S3} (h : AllocStep k pr ow ls s (.fail s')) :\n4404\t    s' = s ∧ AllocStatic k s pr ow ls ∧ ¬ k.Satisfiable pr ls s := by\n4405\t  cases h with\n4406\t  | fail h1 h2 => exact ⟨rfl, h1, h2⟩\n4407\t\n4408\tsection Shape\n4409\tvariable {P : List Place} {hd : Holder} {ls : List (Option Nat × Option Nat × Nat)}"}]}}
