Reg} {e' : SyncEntry} (hu : Uniq s reg)\n1055:theorem newMutex_preserves {k : K} {L : MutexLayout} {ar : ArenaReg} {s : SC} {reg : SyncReg}\n1078:theorem acquire_preserves {k : K} {L : MutexLayout} {s : SC} {reg : SyncReg} {c i : Nat}\n1123:theorem unlock_preserves {L : MutexLayout} {s : SC} {reg : SyncReg} {c i : Nat}\n1157:theorem resetLock_preserves {L : MutexLayout} {s : SC} {reg : SyncReg} {c i : Nat}\n1171:theorem deriveSync_excluded {k : K} {L : MutexLayout} {reg : SyncReg} {s s' : SC} {c g : Nat}\n1181:theorem ctl_same_eq {L : MutexLayout} {s s' : SC} {e : SyncEntry} (hw : WF3 s.flat)\n1199:theorem ctlUnique_step {L : MutexLayout} {s s' : SC} {reg : SyncReg} (hsk : Skel s s')\n1220:theorem controlOf_guarded {L : MutexLayout} {s : SC} {x y : SyncEntry}\n1225:theorem ctlUnique_set {L : MutexLayout} {s : SC} {reg : SyncReg} {i : Nat} {e e' : SyncEntry}\n1237:theorem ctlUnique_append {L : MutexLayout} {s : SC} {reg : SyncReg} {e' : SyncEntry}\n1249:theorem newMutex_ctlUnique {k : K} {L : MutexLayout} {ar : ArenaReg} {s : SC} {reg : SyncReg}\n1259:theorem acquire_ctlUnique {k : K} {L : MutexLayout} {s : SC} {reg : SyncReg} {c i : Nat}\n1273:theorem unlock_ctlUnique {L : MutexLayout} {s : SC} {reg : SyncReg} {c i : Nat}\n1288:theorem resetLock_ctlUnique {L : MutexLayout} {s : SC} {reg : SyncReg} {c i : Nat}\n1295:theorem facts_ctlUnique {L : MutexLayout} {reg : SyncReg} {s s' : SC} (hf : StepFacts reg s s')\n1323:theorem nm0_framesC : FramesC nm0 where\n1342:theorem nm0_kInvC : KInvC nm0 :=\n1351:theorem newMutex_nonleaf_rejected :","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"e78b8659-c936-44b3-bb14-10543b9b9e06","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncate