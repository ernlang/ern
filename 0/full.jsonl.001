 (s.set (allocEff (s.view c) ow ls)).flat.Usable q\nbut is expected to have type\n  s.flat.Usable q\nin the application\n  flat_usable_back hw (fun x hq => ?m.599) (fun q hq hd => ?m.604) (fun x x_1 hm => hm) hq hu\nErn/Concurrency/FullEncap/HandoffExtClass.lean:477:24: error: 'show' tactic failed, pattern\n  (shapeP s.P ?m.615 ?m.616)[?m.617]? = ?m.619\nis not definitionally equal to target\n  s.P[x✝]? = s.P[x✝]?\nErn/Concurrency/FullEncap/HandoffExtClass.lean:479:75: error: Type mismatch\n  hd\nhas type\n  s.dead q = false\nbut is expected to have type\n  (if s.P.length ≤ q then false else s.dead q) = false\nErn/Concurrency/FullEncap/HandoffExtClass.lean:551:67: error: Application type mismatch: The argument\n  hu\nhas type\n  (termEffC s c, reg, ar).fst.flat.Usable q\nbut is expected to have type\n  (s, reg, ar).fst.flat.Usable q\nin the application\n  flat_usable_back hk.left.left.right (fun x x_1 => rfl) (fun x x_1 hd => hd)\n    (fun f x hm => ((ReparentAux.Pop.mem_frames hk.left.left.left.nodup hpop).mp ?m.330).left) hq hu","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/HandoffExtClass.lean","hunks":[{"oldStart":243,"oldLines":4,"newStart":243,"newLines":336,"lines":["     exact (hlen ((opStepC_len hrl (fun _ _ e => by cases e) (fun _ _ _ e => by cases e)).trans","       (opStepC_len hd (fun _ _ e => by cases e) (fun _ _ _ e => by cases e))) hge hlt).elim"," ","+/-! ## The capacity of an existing touched leaf -/","+","+/-- Unfolding of `ExtPair`. -/","+theorem ExtPair.out {k : K} {L : MutexLayout} {σ : Nat → SC × SyncReg × ArenaReg}","+    {lbls : List Label} {i j l : Nat} (hp : ExtPair k L σ lbls i j l) :","+    ∃ (hij : i < j) (hj : j < lbls.length),","+      (lbls[i]'(Nat.lt_trans hij hj)).ctx ≠ lbls[j].ctx ∧","+      TouchL L (σ i) (σ (i + 1)) (lbls[i]'(Nat.lt_trans hij hj)) l ∧","+      TouchL L (σ j) (σ (j + 1)) lbls[j] l ∧","+      (ExclTouch k L (σ i) (σ (i + 1)) (lbls[i]'(Nat.lt_trans hij hj)) l ∨","+        ExclTouch k L (σ j) (σ (j + 1)) lbls[j] l) := by","+  obtain ⟨hij, hp⟩ := hp","+  have hjl : j < lbls.length := by","+    refine Nat.lt_of_not_le fun hle => ?_","+    rw [List.getElem?_eq_none hle] at hp","+    revert hp; cases lbls[i]? <;> exact id","+  rw [List.getElem?_eq_getElem (Nat.lt_trans hij hjl), List.getElem?_eq_getElem hjl] at hp","+  exact ⟨hij, hjl, hp⟩","+","+/-- The required mode of a touched leaf gives the capacity of the acting context (`CapReq`, brief","+of slice 3, task 4), the sources of a by-value `spawn` being given by `hsv` (WC5.3 C5, additional","+precondition 1). -/","+theorem capReq_mode {k : K} {st : SC × SyncReg × ArenaReg} {lbl : Label} {l : Nat} {m : Mode}","+    (hc : CapReq k st lbl l) (hm : ReqMode k st lbl l m)","+    (hsv : ∀ c ps ls vs, lbl = .spawnVal c ps ls vs → ∀ v ∈ vs, ∀ l' ∈ footprint st.1.P v.1,","+      Allows (cap5 st.1 st.2.1 c l') .modify) :","+    Allows (cap5 st.1 st.2.1 lbl.ctx l) m := by","+  cases lbl with","+  | kernel c op =>","+    cases op with","+    | read | writeShared => have e : m = .observe := hm; subst e; exact hc","+    | write | store | transfer => have e : m = .modify := hm; subst e; exact hc","+    | endUse p | free p _ => obtain ⟨hl, rfl⟩ := hm; exact hc hl","+    | alloc pr ow ls =>","+      rcases hm with ⟨rfl, rfl⟩ | ⟨-, hl, ⟨-, rfl⟩ | ⟨hs, rfl⟩⟩","+      · exact hc.2 rfl","+      · exact (hc.1 hl).1","+      · rcases (hc.1 hl).2 with h | h","+        · exact h","+        · exact absurd h hs","+    | _ => exact (hm : False).elim","+  | issue | newMutex => have e : m = .modify := hm; subst e; exact hc","+  | acquire | unlock | resetLock => have e : m = .observe := hm; subst e; exact hc","+  | spawnVal c ps ls vs =>","+    obtain ⟨⟨v, hv, hl⟩, rfl⟩ := hm","+    exact hsv c ps ls vs rfl v hv l hl","+  | _ => exact (hm : False).elim","+","+/-- On a leaf where the clause requires a mode, `CapReq` gives at least `Observe`. -/","+theorem capReq_observe {k : K} {st : SC × SyncReg × ArenaReg} {lbl : Label} {l : Nat}","+    (hc : CapReq k st lbl l) (hr : HasReq st lbl l)","+    (hsv : ∀ c ps ls vs, lbl = .spawnVal c ps ls vs → ∀ v ∈ vs, ∀ l' ∈ footprint st.1.P v.1,","+      Allows (cap5 st.1 st.2.1 c l') .modify) :","+    Allows (cap5 st.1 st.2.1 lbl.ctx l) .observe := by","+  cases lbl with","+  | kernel c op =>","+    cases op with","+    | read | writeShared => exact hc","+    | write | store | transfer => exact allows_observe_of_modify hc","+    | endUse p | free p _ => exact allows_observe_of_modify (hc hr)","+    | alloc pr ow ls =>","+      rcases hr with hl | hl","+      · exact (hc.1 hl).1","+      · exact allows_observe_of_modify (hc.2 hl)","+    | _ => exact (hr : False).elim","+  | issue | newMutex => exact allows_observe_of_modify hc","+  | acquire | unlock | resetLock => exact hc","+  | spawnVal c ps ls vs =>","+    obtain ⟨v, hv, hl⟩ := hr","+    exact allows_observe_of_modify (hsv c ps ls vs rfl v hv l hl)","+  | _ => exact (hr : False).elim","+","+/-- A leaf on which a context has a `cap5` is usable when `NoDangling` holds (Spec 1 §54): an","+authority attaining it is active and covers the leaf. -/","+theorem usable_of_cap5 {s : SC} {reg : SyncReg} {c l : Nat} (hnd : NoDangling s.flat)","+    (hleaf : isLeaf s.P l) (hlt : l < s.P.length) (h : Allows (cap5 s reg c l) .observe) :","+    s.flat.Usable l := by","+  obtain ⟨x, -, -, hex⟩ := cap5_attained h","+  obtain ⟨z, hz, za, hlz, -⟩ := eff_present (ne_none_of_allows hex)","+  exact Decidable.byContradiction fun hu => hnd x z hz za l hu l (mem_footprint_self hleaf hlt) hlz","+","+/-- On a `RunFull` from the initial state, the sources of a by-value `spawn` step carry `Modify`","+for the creator (`spawnVal_cap_pre`), in the form `capReq_mode` reads. -/","+theorem spawnVal_cap_run {k : K} {L : MutexLayout} {statics : Statics}","+    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)","+    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))","+    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) :","+    ∀ c ps ls vs, lbls[i] = .spawnVal c ps ls vs → ∀ v ∈ vs, ∀ l' ∈ footprint (σ i).1.P v.1,","+      Allows (cap5 (σ i).1 (σ i).2.1 c l') .modify :=","+  fun _ _ _ _ e v hv l hl => (spawnVal_cap_pre hdd hstat h0 h hi e v hv l hl).2","+","+/-- Brief, task 2, link of class E: on a `RunFull` from the initial state, a touch of class E","+with required mode `m` is made with `cap5` at least `m` (`capacity_run`, `spawnVal_cap_pre`). -/","+theorem classEm_cap_run {k : K} {L : MutexLayout} {statics : Statics}","+    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)","+    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))","+    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {l : Nat} {m : Mode}","+    (ht : TouchL L (σ i) (σ (i + 1)) lbls[i] l) (hE : ClassEm k (σ i) (σ (i + 1)) lbls[i] l m) :","+    Allows (cap5 (σ i).1 (σ i).2.1 lbls[i].ctx l) m := by","+  obtain ⟨⟨hlt, hleaf, -, -⟩, hm⟩ := hE","+  have htf : TouchesF L (σ i) lbls[i] l := by","+    rcases ht with ⟨-, -, h⟩ | ⟨hc, -⟩ | hc","+    · exact h","+    · exact absurd hlt (Nat.not_lt.2 hc.1)","+    · exact absurd hlt (Nat.not_lt.2 hc.1.1)","+  exact capReq_mode (capacity_run hdd hstat h0 h hi hleaf hlt htf) hm","+    (spawnVal_cap_run hdd hstat h0 h hi)","+","+/-- Brief, task 2, link of class D: on a `RunFull` from the initial state, no context other than","+the acting one has a `cap5` on a leaf of class D (`other_cap_dying_run`). -/","+theorem classD_other_run {k : K} {L : MutexLayout} {statics : Statics}","+    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)","+    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))","+    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {c' l : Nat}","+    (hc' : c' ≠ lbls[i].ctx) (hD : ClassD (σ i) (σ (i + 1)) l) :","+    cap5 (σ i).1 (σ i).2.1 c' l = none :=","+  other_cap_dying_run hdd hstat h0 h hi hc' hD","+","+/-! ## Dead leaves, first statement -/","+","+/-- Brief, task 2, \"Feuilles mortes\", first statement: on a `RunFull` from the initial state, a","+step that touches an existing leaf requires it to be usable in the state before the step. A leaf of","+class D is usable before the step by definition; one of class E carries a `cap5` of the acting","+context (`capacity_run`, `spawnVal_cap_pre`), so an active authority covers it, and `NoDangling`","+(Spec 1 §54) makes it usable. Each clause that touches an existing leaf indeed requires its place","+usable (Spec 1 §63.1, §65.2, §66.1, §67.1, §69.1, §70, §71.2; WC5.3 C13 item 3, C21 item 3). -/","+theorem touch_usable_run {k : K} {L : MutexLayout} {statics : Statics}","+    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)","+    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))","+    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {l : Nat}","+    (ht : TouchL L (σ i) (σ (i + 1)) lbls[i] l) (hlt : l < (σ i).1.P.length) :","+    (σ i).1.flat.Usable l := by","+  obtain ⟨-, hleaf, htf⟩ : l < (σ i).1.P.length ∧ isLeaf (σ i).1.P l ∧ TouchesF L (σ i) lbls[i] l := by","+    rcases ht with h | ⟨hc, -⟩ | hc","+    · exact h","+    · exact absurd hlt (Nat.not_lt.2 hc.1)","+    · exact absurd hlt (Nat.not_lt.2 hc.1.1)","+  rcases existing_classDE (h i hi).2 hlt hleaf htf with hD | ⟨-, -, -, hr⟩","+  · exact hD.2.1","+  · have hk := (runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)).1","+    exact usable_of_cap5 (c := lbls[i].ctx) hk.1.2.1.2.2 hleaf hlt","+      (capReq_observe (capacity_run hdd hstat h0 h hi hleaf hlt htf) hr","+        (spawnVal_cap_run hdd hstat h0 h hi))","+","+/-! ## Dead leaves, second statement: usability is never regained -/","+","+/-- A place existing before a step and usable after it was usable before, when the step keeps the","+existing places, marks no marked place unmarked and adds only frames of identity at least `nF`","+(Spec 1 §40; §49.3: owner frames are below `nF`). -/","+theorem flat_usable_back {s s' : SC} (hw : WF3 s.flat)","+    (hP : ∀ q < s.P.length, s'.P[q]? = s.P[q]?)","+    (hd : ∀ q < s.P.length, s'.dead q = false → s.dead q = false)","+    (hF : ∀ f, f < s.nF → f ∈ s'.frames → f ∈ s.frames) {q : Nat} (hq : q < s.P.length)","+    (h : s'.flat.Usable q) : s.flat.Usable q := by","+  revert hq","+  induction h with","+  | @frame q f pl hpl hdq ho hf =>","+    intro hq","+    have hpl' : s.P[q]? = some pl := (hP q hq).symm.trans hpl","+    exact .frame hpl' (hd q hq hdq) ho (hF f (hw.owners.1 q pl f hpl' ho) hf)","+  | @place q o pl hpl hdq ho _ ih =>","+    intro hq","+    have hpl' : s.P[q]? = some pl := (hP q hq).symm.trans hpl","+    exact .place hpl' (hd q hq hdq) ho (ih (hw.owners.2.1 q pl o hpl' ho))","+","+/-- The frames of `enterFrame` and `spawn` are the old ones and `nF` (Spec 1 §72; WC5.3 C4). -/","+theorem push_old {s s' : SC} {top : Nat} (hp : Push s s' top) :","+    ∀ f, f < s.nF → f ∈ s'.frames → f ∈ s.frames := fun f hf hm => by","+  rcases (hp.mem f).1 hm with rfl | h","+  · exact absurd hf (Nat.lt_irrefl _)","+  · exact h","+","+/-- `spawn` executed by `c`, and the creation phase of the by-value `spawn`, make no existing","+place usable that was not (Spec 1 §72 effect; WC5.3 C4 effect, C5 phase 1). -/","+theorem spawn_usable_back {s : SC} {c : Nat} {ps : List Nat} {ls : LocalShape} (hfr : FramesC s)","+    (hw : WF3 s.flat) (hc : s.stk c ≠ []) {q : Nat} (hq : q < s.P.length)","+    (h : (spawnEff s c ps ls).flat.Usable q) : s.flat.Usable q :=","+  flat_usable_back hw","+    (fun _ hq => by show (shapeP s.P _ _)[_]? = _; exact List.getElem?_append_left hq)","+    (fun q hq hd => by","+      have e : (if s.P.length ≤ q then false else s.dead q) = false := hd","+      split at e","+      · exact absurd hq (Nat.not_lt.2 ‹_›)","+      · exact e)","+    (push_old (spawn_push (ps := ps) (ls := ls) hfr hc)) hq h","+","+/-- The kernel operations, executed by `c` from a state satisfying `KInvCA`, make no existing place","+usable that was not (Spec 1 §40; §60–§75 effects: places are only appended, death markers only","+set, frames only pushed fresh or popped; §63 effect with §63.1 for `transfer`,","+`transfer_usable_back`). -/","+theorem opStepC_usable_back {k : K} {op : KernelOp} {c : Nat} {s s' : SC} (hk : KInvCA s)","+    (h : opStepC k op c s (.ok s')) {q : Nat} (hq : q < s.P.length) (hu : s'.flat.Usable q) :","+    s.flat.Usable q := by","+  have hw : WF3 s.flat := hk.1.1.2","+  cases op with","+  | transfer src dst =>","+    obtain ⟨-, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+    have h1 := (set_usable (s := s) (t := transferEff (s.view c) src dst)","+      fun _ => SC.mem_view_F (s := s) (c := c)).1 hu","+    exact (usable_mem_congr (t := s.flat) (F' := (s.view c).F) fun _ => SC.mem_view_F).1","+      (transfer_usable_back (view_facts hk c).1 hpre.srcUsable h1)","+  | enter ps ls =>","+    obtain ⟨-, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+    exact flat_usable_back hw","+      (fun _ hq => by show (shapeP s.P _ _)[_]? = _; exact List.getElem?_append_left hq)","+      (fun q hq hd => by","+        have e : (if s.P.length ≤ q then false else s.dead q) = false := hd","+        split at e","+        · exact absurd hq (Nat.not_lt.2 ‹_›)","+        · exact e)","+      (push_old (enter_push (ps := ps) (ls := ls) hk.1.1.1 hpre.callerLive)) hq hu","+  | exit =>","+    obtain ⟨hl, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+    have hpop := exitEffC_pop hk.1.1.1.nodup hpre.hasCaller","+    exact flat_usable_back hw (fun _ _ => rfl) (fun _ _ hd => hd)","+      (fun f _ hm => ((hpop.mem_frames hk.1.1.1.nodup).1 hm).1) hq hu","+  | endUse p =>","+    obtain ⟨t, hR, rfl⟩ := viewStep_ok h","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR","+    exact flat_usable_back hw (fun _ _ => rfl)","+      (fun q _ hd => (Bool.or_eq_false_iff.1 hd).1) (fun _ _ hm => hm) hq hu","+  | free p au =>","+    obtain ⟨t, hR, rfl⟩ := viewStep_ok h","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR","+    exact flat_usable_back hw (fun _ _ => rfl)","+      (fun q _ hd => (Bool.or_eq_false_iff.1 hd).1) (fun _ _ hm => hm) hq hu","+  | alloc pr ow ls =>","+    obtain ⟨t, hR, rfl⟩ := viewStep_ok h","+    cases hR with","+    | ok =>","+      exact flat_usable_back hw","+        (fun _ hq => by show (shapeP s.P _ _)[_]? = _; exact List.getElem?_append_left hq)","+        (fun q hq hd => by","+          have e : (if s.P.length ≤ q then false else s.dead q) = false := hd","+          split at e","+          · exact absurd hq (Nat.not_lt.2 ‹_›)","+          · exact e)","+        (fun _ _ hm => hm) hq hu","+  | depend q' x =>","+    obtain ⟨-, h⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h","+    exact (set_usable_iff rfl rfl).1 hu","+  | store a p =>","+    obtain ⟨-, h⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h","+    exact (set_usable_iff (by unfold storeEff; split <;> rfl)","+      (by unfold storeEff; split <;> rfl)).1 hu","+  | release a =>","+    obtain ⟨t, hR, rfl⟩ := viewStep_ok h","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR","+    exact (set_usable_iff (by unfold releaseEff; split <;> rfl)","+      (by unfold releaseEff; split <;> rfl)).1 hu","+  | _ =>","+    obtain ⟨t, hR, rfl⟩ := viewStep_ok h","+    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR","+    exact (set_usable_iff rfl rfl).1 hu","+","+/-- The transfer phases of a by-value `spawn` make no place usable that was not (WC5.3 C5","+phase 2; Spec 1 §63 effect, §63.1 at the start of each phase, `ValTransferPre.srcUsable`). -/","+theorem transfers_usable_back {k : K} {fin : S3} {c : Nat} :","+    ∀ (t : SC) (vs : List (Nat × Nat)), ValTransfersPre k fin c t vs → KBase t →","+      (∀ v ∈ vs, FrameOwned t.P v.2) → ∀ (q : Nat), (transfersEff c t vs).flat.Usable q →","+        t.flat.Usable q","+  | _, [], _, _, _, _, h => h","+  | t, v :: vs, ⟨hpre, hrest⟩, hk, hown, q, h => by","+    have hd' := transfer_usable_frameOwned (src := v.1) (dst := v.2) hpre.dstUsable","+      (hown v (List.mem_cons_self ..))","+    have hk₁ := transfer_base hk hpre.srcUsable hpre.dstUsable hpre.depsValid hpre.sameShape","+      hpre.disjoint hd'","+    have h₁ := transfers_usable_back (transferEffC t c v.1 v.2) vs hrest hk₁","+      (fun w hw => transfer_frameOwned (hown w (List.mem_cons_of_mem _ hw))) q h","+    have h₂ := (set_usable (s := t) (t := transferEff (t.view c) v.1 v.2)","+      fun _ => SC.mem_view_F (s := t) (c := c)).1 h₁","+    exact (usable_mem_congr (t := t.flat) (F' := (t.view c).F) fun _ => SC.mem_view_F).1","+      (transfer_usable_back (view_facts_base hk c).1 hpre.srcUsable h₂)","+","+/-- The by-value `spawn` makes no existing place usable that was not (WC5.3 C5: creation, transfer","+phases, yield, which changes holders only). -/","+theorem spawnVal_usable_back {k : K} {s s' : SC} {c : Nat} {ps : List Nat} {ls : LocalShape}","+    {vs : List (Nat × Nat)} (hk : KInvCA s) (h : SpawnValStep k s c ps ls vs (.ok s')) {q : Nat}","+    (hq : q < s.P.length) (hu : s'.flat.Usable q) : s.flat.Usable q := by","+  obtain ⟨-, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+  have hb₀ : KBase (spawnCreate s c ls) :=","+    spawn_base hk hpre.creatorLive (fun _ h => nomatch h) hpre.localsOK","+  have h₂ : (transfersEff c (spawnCreate s c ls) vs).flat.Usable q :=","+    (S3.Usable.congr (s := (transfersEff c (spawnCreate s c ls) vs).flat)","+      (s' := (spawnValEff s c ps ls vs).flat) rfl rfl rfl).1 hu","+  have h₁ := transfers_usable_back (spawnCreate s c ls) vs hpre.transfers hb₀","+    (fun v hv => spawn_frameOwned (hpre.freshDst v hv)) q h₂","+  exact spawn_usable_back hk.1.1.1 hk.1.1.2 hpre.creatorLive hq h₁","+","+/-- Per-step form, under `KInvCA`: no step makes usable an existing place that was not (Spec 1","+§40; the effects of WC5.3 C2–C8, C13–C18 and Spec 1 §60–§78 on the places, the death markers and","+the live frames). -/","+theorem usable_back_step {k : K} {L : MutexLayout} {st st' : SC × SyncReg × ArenaReg}","+    {lbl : Label} (hk : KInvCA st.1) (hs : LStep k L lbl st st') {q : Nat}","+    (hq : q < st.1.P.length) (hu : st'.1.flat.Usable q) : st.1.flat.Usable q := by","+  cases hs with","+  | kernel h => exact opStepC_usable_back hk h hq hu","+  | spawn h =>","+    obtain ⟨-, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'","+    exact spawn_usable_back hk.1.1.1 hk.1.1.2 hpre.creatorLive hq hu","+  | @terminate s s' reg ar c h =>","+    obtain ⟨hl, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'","+    have hpop := termEffC_pop hk.1.1.1.nodup hpre.initialOnly","+      (hk.1.1.1.rooted c hpre.nonInitial hl)","+    exact flat_usable_back hk.1.1.2 (fun _ _ => rfl) (fun _ _ hd => hd)","+      (fun f _ hm => ((hpop.mem_frames hk.1.1.1.nodup).1 hm).1) hq hu","+  | join h => cases h; exact hu","+  | deriveSync h =>","+    obtain ⟨-, h'⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h'","+    exact (set_usable_iff rfl rfl).1 hu","+  | newMutex h => obtain ⟨-, -, rfl⟩ := h; exact hu","+  | acquire h =>","+    obtain ⟨-, _, -, -, -, rfl⟩ := h","+    exact (set_usable_iff rfl rfl).1 hu","+  | unlock h =>","+    obtain ⟨-, _, _, -, -, -, -, -, rfl⟩ := h","+    exact (set_usable_iff (by unfold releaseEff; split <;> rfl)","+      (by unfold releaseEff; split <;> rfl)).1 hu","+  | resetLock h => obtain ⟨-, _, -, -, -, -, rfl⟩ := h; exact hu","+  | spawnVal h => exact spawnVal_usable_back hk h hq hu","+  | newArena h => obtain ⟨-, -, rfl⟩ := newArenaStepC_ok h; exact hu","+  | issue h =>","+    obtain ⟨_, _, -, -, -, hsp, hsto, -⟩ := issueStepC_ok h","+    have hk₁ := (opStep_kInvCA (hk := hk) hsp)","+    exact opStepC_usable_back hk hsp hq (opStepC_usable_back hk₁ hsto","+      (by rw [opStepC_len hsp (fun _ _ e => by cases e) (fun _ _ _ e => by cases e)]; exact hq) hu)","+  | reset h =>","+    obtain ⟨_, _, -, hd, hrl, -, -⟩ := resetStepC_ok (k := k) h","+    have hk₁ := (opStep_kInvCA (hk := hk) hd)","+    exact opStepC_usable_back hk hd hq (opStepC_usable_back hk₁ hrl","+      (by rw [opStepC_len hd (fun _ _ e => by cases e) (fun _ _ _ e => by cases e)]; exact hq) hu)","+"," end Ern.Concurrency.FullEncap.HandoffExt"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/HandoffExtClass.lean"]}},"serverClassifierContext":{"request":"c5fa37dc-1011-4ab1-b1e4-6db886f32c70","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"fcfbe314-d972-498b-90da-edf8ff981960","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"339792067a447160e2579813f3a38da246bbee98924d1f70aa73ac945c67281a","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01LG7quhTjmG4dg1RWhuHo8J","name":"Bash","input":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && python3 - <<'EOF'\np='Ern/Concurrency/FullEncap/HandoffExtClass.lean'\ns=open(p).read()\ntail='end Ern.Concurrency.FullEncap.HandoffExt\\n'\nassert s.endswith(tail)\nadd=r'''/-! ## The capacity of an existing touched leaf -/\n\n/-- Unfolding of `ExtPair`. -/\ntheorem ExtPair.out {k : K} {L : MutexLayout} {σ : Nat → SC × SyncReg × ArenaReg}\n    {lbls : List Label} {i j l : Nat} (hp : ExtPair k L σ lbls i j l) :\n    ∃ (hij : i < j) (hj : j < lbls.length),\n      (lbls[i]'(Nat.lt_trans hij hj)).ctx ≠ lbls[j].ctx ∧\n      TouchL L (σ i) (σ (i + 1)) (lbls[i]'(Nat.lt_trans hij hj)) l ∧\n      TouchL L (σ j) (σ (j + 1)) lbls[j] l ∧\n      (ExclTouch k L (σ i) (σ (i + 1)) (lbls[i]'(Nat.lt_trans hij hj)) l ∨\n        ExclTouch k L (σ j) (σ (j + 1)) lbls[j] l) := by\n  obtain ⟨hij, hp⟩ := hp\n  have hjl : j < lbls.length := by\n    refine Nat.lt_of_not_le fun hle => ?_\n    rw [List.getElem?_eq_none hle] at hp\n    revert hp; cases lbls[i]? <;> exact id\n  rw [List.getElem?_eq_getElem (Nat.lt_trans hij hjl), List.getElem?_eq_getElem hjl] at hp\n  exact ⟨hij, hjl, hp⟩\n\n/-- The required mode of a touched leaf gives the capacity of the acting context (`CapReq`, brief\nof slice 3, task 4), the sources of a by-value `spawn` being given by `hsv` (WC5.3 C5, additional\nprecondition 1). -/\ntheorem capReq_mode {k : K} {st : SC × SyncReg × ArenaReg} {lbl : Label} {l : Nat} {m : Mode}\n    (hc : CapReq k st lbl l) (hm : ReqMode k st lbl l m)\n    (hsv : ∀ c ps ls vs, lbl = .spawnVal c ps ls vs → ∀ v ∈ vs, ∀ l' ∈ footprint st.1.P v.1,\n      Allows (cap5 st.1 st.2.1 c l') .modify) :\n    Allows (cap5 st.1 st.2.1 lbl.ctx l) m := by\n  cases lbl with\n  | kernel c op =>\n    cases op with\n    | read | writeShared => have e : m = .observe := hm; subst e; exact hc\n    | write | store | transfer => have e : m = .modify := hm; subst e; exact hc\n    | endUse p | free p _ => obtain ⟨hl, rfl⟩ := hm; exact hc hl\n    | alloc pr ow ls =>\n      rcases hm with ⟨rfl, rfl⟩ | ⟨-, hl, ⟨-, rfl⟩ | ⟨hs, rfl⟩⟩\n      · exact hc.2 rfl\n      · exact (hc.1 hl).1\n      · rcases (hc.1 hl).2 with h | h\n        · exact h\n        · exact absurd h hs\n    | _ => exact (hm : False).elim\n  | issue | newMutex => have e : m = .modify := hm; subst e; exact hc\n  | acquire | unlock | resetLock => have e : m = .observe := hm; subst e; exact hc\n  | spawnVal c ps ls vs =>\n    obtain ⟨⟨v, hv, hl⟩, rfl⟩ := hm\n    exact hsv c ps ls vs rfl v hv l hl\n  | _ => exact (hm : False).elim\n\n/-- On a leaf where the clause requires a mode, `CapReq` gives at least `Observe`. -/\ntheorem capReq_observe {k : K} {st : SC × SyncReg × ArenaReg} {lbl : Label} {l : Nat}\n    (hc : CapReq k st lbl l) (hr : HasReq st lbl l)\n    (hsv : ∀ c ps ls vs, lbl = .spawnVal c ps ls vs → ∀ v ∈ vs, ∀ l' ∈ footprint st.1.P v.1,\n      Allows (cap5 st.1 st.2.1 c l') .modify) :\n    Allows (cap5 st.1 st.2.1 lbl.ctx l) .observe := by\n  cases lbl with\n  | kernel c op =>\n    cases op with\n    | read | writeShared => exact hc\n    | write | store | transfer => exact allows_observe_of_modify hc\n    | endUse p | free p _ => exact allows_observe_of_modify (hc hr)\n    | alloc pr ow ls =>\n      rcases hr with hl | hl\n      · exact (hc.1 hl).1\n      · exact allows_observe_of_modify (hc.2 hl)\n    | _ => exact (hr : False).elim\n  | issue | newMutex => exact allows_observe_of_modify hc\n  | acquire | unlock | resetLock => exact hc\n  | spawnVal c ps ls vs =>\n    obtain ⟨v, hv, hl⟩ := hr\n    exact allows_observe_of_modify (hsv c ps ls vs rfl v hv l hl)\n  | _ => exact (hr : False).elim\n\n/-- A leaf on which a context has a `cap5` is usable when `NoDangling` holds (Spec 1 §54): an\nauthority attaining it is active and covers the leaf. -/\ntheorem usable_of_cap5 {s : SC} {reg : SyncReg} {c l : Nat} (hnd : NoDangling s.flat)\n    (hleaf : isLeaf s.P l) (hlt : l < s.P.length) (h : Allows (cap5 s reg c l) .observe) :\n    s.flat.Usable l := by\n  obtain ⟨x, -, -, hex⟩ := cap5_attained h\n  obtain ⟨z, hz, za, hlz, -⟩ := eff_present (ne_none_of_allows hex)\n  exact Decidable.byContradiction fun hu => hnd x z hz za l hu l (mem_footprint_self hleaf hlt) hlz\n\n/-- On a `RunFull` from the initial state, the sources of a by-value `spawn` step carry `Modify`\nfor the creator (`spawnVal_cap_pre`), in the form `capReq_mode` reads. -/\ntheorem spawnVal_cap_run {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) :\n    ∀ c ps ls vs, lbls[i] = .spawnVal c ps ls vs → ∀ v ∈ vs, ∀ l' ∈ footprint (σ i).1.P v.1,\n      Allows (cap5 (σ i).1 (σ i).2.1 c l') .modify :=\n  fun _ _ _ _ e v hv l hl => (spawnVal_cap_pre hdd hstat h0 h hi e v hv l hl).2\n\n/-- Brief, task 2, link of class E: on a `RunFull` from the initial state, a touch of class E\nwith required mode `m` is made with `cap5` at least `m` (`capacity_run`, `spawnVal_cap_pre`). -/\ntheorem classEm_cap_run {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {l : Nat} {m : Mode}\n    (ht : TouchL L (σ i) (σ (i + 1)) lbls[i] l) (hE : ClassEm k (σ i) (σ (i + 1)) lbls[i] l m) :\n    Allows (cap5 (σ i).1 (σ i).2.1 lbls[i].ctx l) m := by\n  obtain ⟨⟨hlt, hleaf, -, -⟩, hm⟩ := hE\n  have htf : TouchesF L (σ i) lbls[i] l := by\n    rcases ht with ⟨-, -, h⟩ | ⟨hc, -⟩ | hc\n    · exact h\n    · exact absurd hlt (Nat.not_lt.2 hc.1)\n    · exact absurd hlt (Nat.not_lt.2 hc.1.1)\n  exact capReq_mode (capacity_run hdd hstat h0 h hi hleaf hlt htf) hm\n    (spawnVal_cap_run hdd hstat h0 h hi)\n\n/-- Brief, task 2, link of class D: on a `RunFull` from the initial state, no context other than\nthe acting one has a `cap5` on a leaf of class D (`other_cap_dying_run`). -/\ntheorem classD_other_run {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {c' l : Nat}\n    (hc' : c' ≠ lbls[i].ctx) (hD : ClassD (σ i) (σ (i + 1)) l) :\n    cap5 (σ i).1 (σ i).2.1 c' l = none :=\n  other_cap_dying_run hdd hstat h0 h hi hc' hD\n\n/-! ## Dead leaves, first statement -/\n\n/-- Brief, task 2, \"Feuilles mortes\", first statement: on a `RunFull` from the initial state, a\nstep that touches an existing leaf requires it to be usable in the state before the step. A leaf of\nclass D is usable before the step by definition; one of class E carries a `cap5` of the acting\ncontext (`capacity_run`, `spawnVal_cap_pre`), so an active authority covers it, and `NoDangling`\n(Spec 1 §54) makes it usable. Each clause that touches an existing leaf indeed requires its place\nusable (Spec 1 §63.1, §65.2, §66.1, §67.1, §69.1, §70, §71.2; WC5.3 C13 item 3, C21 item 3). -/\ntheorem touch_usable_run {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {l : Nat}\n    (ht : TouchL L (σ i) (σ (i + 1)) lbls[i] l) (hlt : l < (σ i).1.P.length) :\n    (σ i).1.flat.Usable l := by\n  obtain ⟨-, hleaf, htf⟩ : l < (σ i).1.P.length ∧ isLeaf (σ i).1.P l ∧ TouchesF L (σ i) lbls[i] l := by\n    rcases ht with h | ⟨hc, -⟩ | hc\n    · exact h\n    · exact absurd hlt (Nat.not_lt.2 hc.1)\n    · exact absurd hlt (Nat.not_lt.2 hc.1.1)\n  rcases existing_classDE (h i hi).2 hlt hleaf htf with hD | ⟨-, -, -, hr⟩\n  · exact hD.2.1\n  · have hk := (runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)).1\n    exact usable_of_cap5 (c := lbls[i].ctx) hk.1.2.1.2.2 hleaf hlt\n      (capReq_observe (capacity_run hdd hstat h0 h hi hleaf hlt htf) hr\n        (spawnVal_cap_run hdd hstat h0 h hi))\n\n/-! ## Dead leaves, second statement: usability is never regained -/\n\n/-- A place existing before a step and usable after it was usable before, when the step keeps the\nexisting places, marks no marked place unmarked and adds only frames of identity at least `nF`\n(Spec 1 §40; §49.3: owner frames are below `nF`). -/\ntheorem flat_usable_back {s s' : SC} (hw : WF3 s.flat)\n    (hP : ∀ q < s.P.length, s'.P[q]? = s.P[q]?)\n    (hd : ∀ q < s.P.length, s'.dead q = false → s.dead q = false)\n    (hF : ∀ f, f < s.nF → f ∈ s'.frames → f ∈ s.frames) {q : Nat} (hq : q < s.P.length)\n    (h : s'.flat.Usable q) : s.flat.Usable q := by\n  revert hq\n  induction h with\n  | @frame q f pl hpl hdq ho hf =>\n    intro hq\n    have hpl' : s.P[q]? = some pl := (hP q hq).symm.trans hpl\n    exact .frame hpl' (hd q hq hdq) ho (hF f (hw.owners.1 q pl f hpl' ho) hf)\n  | @place q o pl hpl hdq ho _ ih =>\n    intro hq\n    have hpl' : s.P[q]? = some pl := (hP q hq).symm.trans hpl\n    exact .place hpl' (hd q hq hdq) ho (ih (hw.owners.2.1 q pl o hpl' ho))\n\n/-- The frames of `enterFrame` and `spawn` are the old ones and `nF` (Spec 1 §72; WC5.3 C4). -/\ntheorem push_old {s s' : SC} {top : Nat} (hp : Push s s' top) :\n    ∀ f, f < s.nF → f ∈ s'.frames → f ∈ s.frames := fun f hf hm => by\n  rcases (hp.mem f).1 hm with rfl | h\n  · exact absurd hf (Nat.lt_irrefl _)\n  · exact h\n\n/-- `spawn` executed by `c`, and the creation phase of the by-value `spawn`, make no existing\nplace usable that was not (Spec 1 §72 effect; WC5.3 C4 effect, C5 phase 1). -/\ntheorem spawn_usable_back {s : SC} {c : Nat} {ps : List Nat} {ls : LocalShape} (hfr : FramesC s)\n    (hw : WF3 s.flat) (hc : s.stk c ≠ []) {q : Nat} (hq : q < s.P.length)\n    (h : (spawnEff s c ps ls).flat.Usable q) : s.flat.Usable q :=\n  flat_usable_back hw\n    (fun _ hq => by show (shapeP s.P _ _)[_]? = _; exact List.getElem?_append_left hq)\n    (fun q hq hd => by\n      have e : (if s.P.length ≤ q then false else s.dead q) = false := hd\n      split at e\n      · exact absurd hq (Nat.not_lt.2 ‹_›)\n      · exact e)\n    (push_old (spawn_push (ps := ps) (ls := ls) hfr hc)) hq h\n\n/-- The kernel operations, executed by `c` from a state satisfying `KInvCA`, make no existing place\nusable that was not (Spec 1 §40; §60–§75 effects: places are only appended, death markers only\nset, frames only pushed fresh or popped; §63 effect with §63.1 for `transfer`,\n`transfer_usable_back`). -/\ntheorem opStepC_usable_back {k : K} {op : KernelOp} {c : Nat} {s s' : SC} (hk : KInvCA s)\n    (h : opStepC k op c s (.ok s')) {q : Nat} (hq : q < s.P.length) (hu : s'.flat.Usable q) :\n    s.flat.Usable q := by\n  have hw : WF3 s.flat := hk.1.1.2\n  cases op with\n  | transfer src dst =>\n    obtain ⟨-, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n    have h1 := (set_usable (s := s) (t := transferEff (s.view c) src dst)\n      fun _ => SC.mem_view_F (s := s) (c := c)).1 hu\n    exact (usable_mem_congr (t := s.flat) (F' := (s.view c).F) fun _ => SC.mem_view_F).1\n      (transfer_usable_back (view_facts hk c).1 hpre.srcUsable h1)\n  | enter ps ls =>\n    obtain ⟨-, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n    exact flat_usable_back hw\n      (fun _ hq => by show (shapeP s.P _ _)[_]? = _; exact List.getElem?_append_left hq)\n      (fun q hq hd => by\n        have e : (if s.P.length ≤ q then false else s.dead q) = false := hd\n        split at e\n        · exact absurd hq (Nat.not_lt.2 ‹_›)\n        · exact e)\n      (push_old (enter_push (ps := ps) (ls := ls) hk.1.1.1 hpre.callerLive)) hq hu\n  | exit =>\n    obtain ⟨hl, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n    have hpop := exitEffC_pop hk.1.1.1.nodup hpre.hasCaller\n    exact flat_usable_back hw (fun _ _ => rfl) (fun _ _ hd => hd)\n      (fun f _ hm => ((hpop.mem_frames hk.1.1.1.nodup).1 hm).1) hq hu\n  | endUse p =>\n    obtain ⟨t, hR, rfl⟩ := viewStep_ok h\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR\n    exact flat_usable_back hw (fun _ _ => rfl)\n      (fun q _ hd => (Bool.or_eq_false_iff.1 hd).1) (fun _ _ hm => hm) hq hu\n  | free p au =>\n    obtain ⟨t, hR, rfl⟩ := viewStep_ok h\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR\n    exact flat_usable_back hw (fun _ _ => rfl)\n      (fun q _ hd => (Bool.or_eq_false_iff.1 hd).1) (fun _ _ hm => hm) hq hu\n  | alloc pr ow ls =>\n    obtain ⟨t, hR, rfl⟩ := viewStep_ok h\n    cases hR with\n    | ok =>\n      exact flat_usable_back hw\n        (fun _ hq => by show (shapeP s.P _ _)[_]? = _; exact List.getElem?_append_left hq)\n        (fun q hq hd => by\n          have e : (if s.P.length ≤ q then false else s.dead q) = false := hd\n          split at e\n          · exact absurd hq (Nat.not_lt.2 ‹_›)\n          · exact e)\n        (fun _ _ hm => hm) hq hu\n  | depend q' x =>\n    obtain ⟨-, h⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n    exact (set_usable_iff rfl rfl).1 hu\n  | store a p =>\n    obtain ⟨-, h⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h\n    exact (set_usable_iff (by unfold storeEff; split <;> rfl)\n      (by unfold storeEff; split <;> rfl)).1 hu\n  | release a =>\n    obtain ⟨t, hR, rfl⟩ := viewStep_ok h\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR\n    exact (set_usable_iff (by unfold releaseEff; split <;> rfl)\n      (by unfold releaseEff; split <;> rfl)).1 hu\n  | _ =>\n    obtain ⟨t, hR, rfl⟩ := viewStep_ok h\n    obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 hR\n    exact (set_usable_iff rfl rfl).1 hu\n\n/-- The transfer phases of a by-value `spawn` make no place usable that was not (WC5.3 C5\nphase 2; Spec 1 §63 effect, §63.1 at the start of each phase, `ValTransferPre.srcUsable`). -/\ntheorem transfers_usable_back {k : K} {fin : S3} {c : Nat} :\n    ∀ (t : SC) (vs : List (Nat × Nat)), ValTransfersPre k fin c t vs → KBase t →\n      (∀ v ∈ vs, FrameOwned t.P v.2) → ∀ (q : Nat), (transfersEff c t vs).flat.Usable q →\n        t.flat.Usable q\n  | _, [], _, _, _, _, h => h\n  | t, v :: vs, ⟨hpre, hrest⟩, hk, hown, q, h => by\n    have hd' := transfer_usable_frameOwned (src := v.1) (dst := v.2) hpre.dstUsable\n      (hown v (List.mem_cons_self ..))\n    have hk₁ := transfer_base hk hpre.srcUsable hpre.dstUsable hpre.depsValid hpre.sameShape\n      hpre.disjoint hd'\n    have h₁ := transfers_usable_back (transferEffC t c v.1 v.2) vs hrest hk₁\n      (fun w hw => transfer_frameOwned (hown w (List.mem_cons_of_mem _ hw))) q h\n    have h₂ := (set_usable (s := t) (t := transferEff (t.view c) v.1 v.2)\n      fun _ => SC.mem_view_F (s := t) (c := c)).1 h₁\n    exact (usable_mem_congr (t := t.flat) (F' := (t.view c).F) fun _ => SC.mem_view_F).1\n      (transfer_usable_back (view_facts_base hk c).1 hpre.srcUsable h₂)\n\n/-- The by-value `spawn` makes no existing place usable that was not (WC5.3 C5: creation, transfer\nphases, yield, which changes holders only). -/\ntheorem spawnVal_usable_back {k : K} {s s' : SC} {c : Nat} {ps : List Nat} {ls : LocalShape}\n    {vs : List (Nat × Nat)} (hk : KInvCA s) (h : SpawnValStep k s c ps ls vs (.ok s')) {q : Nat}\n    (hq : q < s.P.length) (hu : s'.flat.Usable q) : s.flat.Usable q := by\n  obtain ⟨-, h⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  have hb₀ : KBase (spawnCreate s c ls) :=\n    spawn_base hk hpre.creatorLive (fun _ h => nomatch h) hpre.localsOK\n  have h₂ : (transfersEff c (spawnCreate s c ls) vs).flat.Usable q :=\n    (S3.Usable.congr (s := (transfersEff c (spawnCreate s c ls) vs).flat)\n      (s' := (spawnValEff s c ps ls vs).flat) rfl rfl rfl).1 hu\n  have h₁ := transfers_usable_back (spawnCreate s c ls) vs hpre.transfers hb₀\n    (fun v hv => spawn_frameOwned (hpre.freshDst v hv)) q h₂\n  exact spawn_usable_back hk.1.1.1 hk.1.1.2 hpre.creatorLive hq h₁\n\n/-- Per-step form, under `KInvCA`: no step makes usable an existing place that was not (Spec 1\n§40; the effects of WC5.3 C2–C8, C13–C18 and Spec 1 §60–§78 on the places, the death markers and\nthe live frames). -/\ntheorem usable_back_step {k : K} {L : MutexLayout} {st st' : SC × SyncReg × ArenaReg}\n    {lbl : Label} (hk : KInvCA st.1) (hs : LStep k L lbl st st') {q : Nat}\n    (hq : q < st.1.P.length) (hu : st'.1.flat.Usable q) : st.1.flat.Usable q := by\n  cases hs with\n  | kernel h => exact opStepC_usable_back hk h hq hu\n  | spawn h =>\n    obtain ⟨-, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'\n    exact spawn_usable_back hk.1.1.1 hk.1.1.2 hpre.creatorLive hq hu\n  | @terminate s s' reg ar c h =>\n    obtain ⟨hl, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'\n    have hpop := termEffC_pop hk.1.1.1.nodup hpre.initialOnly\n      (hk.1.1.1.rooted c hpre.nonInitial hl)\n    exact flat_usable_back hk.1.1.2 (fun _ _ => rfl) (fun _ _ hd => hd)\n      (fun f _ hm => ((hpop.mem_frames hk.1.1.1.nodup).1 hm).1) hq hu\n  | join h => cases h; exact hu\n  | deriveSync h =>\n    obtain ⟨-, h'⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h'\n    exact (set_usable_iff rfl rfl).1 hu\n  | newMutex h => obtain ⟨-, -, rfl⟩ := h; exact hu\n  | acquire h =>\n    obtain ⟨-, _, -, -, -, rfl⟩ := h\n    exact (set_usable_iff rfl rfl).1 hu\n  | unlock h =>\n    obtain ⟨-, _, _, -, -, -, -, -, rfl⟩ := h\n    exact (set_usable_iff (by unfold releaseEff; split <;> rfl)\n      (by unfold releaseEff; split <;> rfl)).1 hu\n  | resetLock h => obtain ⟨-, _, -, -, -, -, rfl⟩ := h; exact hu\n  | spawnVal h => exact spawnVal_usable_back hk h hq hu\n  | newArena h => obtain ⟨-, -, rfl⟩ := newArenaStepC_ok h; exact hu\n  | issue h =>\n    obtain ⟨_, _, -, -, -, hsp, hsto, -⟩ := issueStepC_ok h\n    have hk₁ := (opStep_kInvCA (hk := hk) hsp)\n    exact opStepC_usable_back hk hsp hq (opStepC_usable_back hk₁ hsto\n      (by rw [opStepC_len hsp (fun _ _ e => by cases e) (fun _ _ _ e => by cases e)]; exact hq) hu)\n  | reset h =>\n    obtain ⟨_, _, -, hd, hrl, -, -⟩ := resetStepC_ok (k := k) h\n    have hk₁ := (opStep_kInvCA (hk := hk) hd)\n    exact opStepC_usable_back hk hd hq (opStepC_usable_back hk₁ hrl\n      (by rw [opStepC_len hd (fun _ _ e => by cases e) (fun _ _ _ e => by cases e)]; exact hq) hu)\n\n'''\ns=s[:-len(tail)]+add+tail\nopen(p,'w').write(s)\nEOF\n~/.elan/bin/lake env lean Ern/Concurrency/FullEncap/HandoffExtClass.lean 2>&1 | head -60","description":"Add capacity links and backward usability, compile","timeout":600000},"caller":{"type":"direct"}}]}}
{"type":"api-request","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","id":"080f63fb-74fd-451e-ae44-c89489d326c8","timestamp":"2026-11-14T08:25:05.794Z","version":"2.1.321","querySource":"sdk","shapeHash":"9f52ff250c3bf9a62496bf9c3c72b82c93ae96b1c01a28d5faa78501f67d1ec2","params":{"model":"claude-opus-5-5","betas":["claude-code-20250219","oauth-2025-04-20","interleaved-thinking-2025-05-14","context-management-2025-06-27","prompt-caching-scope-2026-01-05","per-turn-control-2026-07-01","mid-conversation-tool-changes-2026-07-01","inline-tools-2026-09-15","advisor-tool-2026-03-01","thinking-token-count-2026-05-13","advanced-tool-use-2025-11-20","mid-conversation-system-clear-at-2026-08-21","effort-2025-11-24","dangerous-tool-use-2026-09-03","thinking-binding-controls-2026-08-01","thinking-display-updates-2026-08-18","afk-mode-2026-01-31","extended-cache-ttl-2025-04-11","cache-diagnosis-2026-04-07","message-threads-2026-08-12"],"max_tokens":128000,"thinking":{"type":"adaptive","display":"updates"},"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},"output_config":{"effort":"xhigh"}},"base":"168ba606-1a39-4af7-b8ae-b4ddfc221e5d","keep":154,"tail":["339792067a447160e2579813f3a38da246bbee98924d1f70aa73ac945c67281a","2e8c300337ab63de7fea8cec6bc0005026507d568d99a68c4d1c88d59fbab383"],"cacheControl":[{"path":["system",1],"value":{"type":"ephemeral","ttl":"1h","scope":"global"}},{"path":["system",2],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",154,"content",0],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",155,"content",0],"value":{"type":"ephemeral","ttl":"1h"}}],"requestDigest":"9a846a755856ee8e8707532e2cdb41aab52b83c6186f23c5bc6832c75b835c0c"}
