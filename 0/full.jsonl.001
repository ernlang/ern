02\nErn/MM23.lean:1038: 104\nErn/MM23.lean:1064: 102\nErn/MM23.lean:1145: 108\nErn/MM23.lean:1160: 106\nErn/MM23.lean:1187: 106\nErn/MM23.lean:1222: 127\nErn/MM23.lean:1232: 127\nErn/MM23.lean:1248: 108\nErn/MM23.lean:1289: 106\nErn/MM23.lean:1321: 134\nErn/MM23.lean:1323: 103\nErn/MM23.lean:1333: 109\nErn/MM23.lean:1335: 103","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean","hunks":[{"oldStart":399,"oldLines":7,"newStart":399,"newLines":8,"lines":[" /-- `ReprB` carries over when the MM-02 state only keeps its allocations (`Dom`) and the MM-03 state"," keeps its places, stack, `dead` and `freed` marks, every leaf that becomes `Init` having its range"," initialised (K3). -/","-theorem ReprB.change {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3} {s2 s2' : MM02.State}","+theorem ReprB.change {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}","+    {L : Layout} {s3 s3' : S3} {s2 s2' : MM02.State}","     (hR : ReprB tok ptok provOf L s3 s2) (hd : Dom s2 s2') (hP : s3'.P = s3.P) (hF : s3'.F = s3.F)","     (hdead : s3'.dead = s3.dead) (hfr : s3'.freed = s3.freed)","     (hI : ∀ l < s3.P.length, isLeaf s3.P l → s3'.I l = .init →"]},{"oldStart":474,"oldLines":7,"newStart":475,"newLines":8,"lines":[" `ok`, and the states where those leaves are `Init` stay in `Repr`, under `dec` along the"," sequence and `stat` (K5). -/"," theorem repr_writes {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","-    {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {w : Nat → Nat → UInt8 × Option Nat}","+    {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}","+    {L : Layout} {w : Nat → Nat → UInt8 × Option Nat}","     (hstat : ∀ s ac w, ObW.stat s ac w) :","     ∀ (ls : List Nat) (s3 : S3) (s2 : MM02.State), ReprB tok ptok provOf L s3 s2 →","       (∀ l ∈ ls, l < s3.P.length ∧ isLeaf s3.P l ∧ LiveAlloc s2 (L l).alloc) →"]},{"oldStart":677,"oldLines":7,"newStart":679,"newLines":8,"lines":[" usability, `freed` marks and frame; the new places are usable and not freed; no leaf becomes"," `Init`; a new root owned by the frame `f` has the token `tok f`; a new root allocated from the"," provider `pr` (`provOf`) has the token `ptok pr`. -/","-theorem repr_extend {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {hd : Holder}","+theorem repr_extend {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}","+    {L : Layout} {s3 s3' : S3} {s2 : MM02.State} {hd : Holder}","     {ls : List (Option Nat × Option Nat × Nat)} {pl : Placement} {g : Nat → Geom}","     {fa : Option Nat} (hR : ReprB tok ptok provOf L s3 s2) (hwf : MM02.WF s2)","     (hP : s3'.P = shapeP s3.P hd ls) (hsh : ShapeOK s3.P.length ls)"]},{"oldStart":860,"oldLines":7,"newStart":863,"newLines":8,"lines":[" /-! ## Initial state (K3) -/"," "," /-- `Repr` holds trivially for a state without places. -/","-theorem repr_of_nil {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 : S3} {s2 : MM02.State}","+theorem repr_of_nil {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}","+    {L : Layout} {s3 : S3} {s2 : MM02.State}","     (h : s3.P.length = 0) : ReprB tok ptok provOf L s3 s2 :=","   ⟨⟨fun _ hr => absurd hr (by omega), fun _ hr => absurd hr (by omega),","     fun _ hr => absurd hr (by omega)⟩, fun _ hr => absurd hr (by omega),"]},{"oldStart":965,"oldLines":7,"newStart":969,"newLines":8,"lines":[" "," /-- K3, MM-03.3 §2.6 (`NoDangling`): under `WF3` and `FpLeaves`, a leaf covered by an active"," authority belongs to a usable root, so its allocation is live. -/","-theorem covered_live {tok ptok : Nat → Nat} {provOf : Nat → Option Nat} {L : Layout} {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3)","+theorem covered_live {tok ptok : Nat → Nat} {provOf : Nat → Option Nat}","+    {L : Layout} {s3 : S3} {s2 : MM02.State} (hwf : WF3 s3)","     (hnd : NoDangling s3) (hfl :