ngLeaf s p l) →\n724-      heldIn s.P p y.holder ∨ ¬ HolderLive (endUseS s p) y.holder) True\n725-\n726-/-- Decidability of `EndUseAccessOK` (§69.2). -/\n727-instance (s : S3) (p j : Nat) : Decidable (EndUseAccessOK s p j) := by\n57:def arenaValue (s : S3) (E : ArenaEntry) : Option Nat :=\n58-  match s.A[E.internal]? with\n59-  | some y => match y.holder with\n60-    | .place v => some v\n61-    | .frame _ => none\n62-  | none => none","is_error":false}]},"uuid":"da0a2f55-aa3d-426b-9c76-5d2b072dadc0","timestamp":"2026-11-12T16:38:47.974Z","toolUseResult":{"stdout":"Ern/Concurrency/Frames.lean:36:def ViewStep (R : S3 → Outcome3 S3 → Prop) (c : Nat) (s : SC) (o : Outcome3 SC) : Prop :=\nErn/Concurrency/Frames.lean-37-  s.Live c ∧ ∃ o₃, R (s.view c) o₃ ∧ o = omap s.set o₃\nErn/Concurrency/Frames.lean-38-\nErn/Concurrency/Frames.lean-39-/-! ## O4 `transfer` re-indexed (Spec 1 §63) -/\nErn/Concurrency/Frames.lean-40-\nErn/Concurrency/Frames.lean-41-/-- Effect of `transfer` executed by `c` (Spec 1 §63 effect, WC4 C2). -/\nErn/Concurrency/Frames.lean-42-def transferEffC (s : SC) (c src dst : Nat) : SC := s.set (transferEff (s.view c) src dst)\n    HolderLive (freeS s p) y.holder) True\n\n/-- Decidability of `FreeAnchorOK` (§70.3). -/\ninstance (s : S3) (p x : Nat) : Decidable (FreeAnchorOK s p x) := by\n  unfold FreeAnchorOK OptP; split <;> infer_instance\n\n/-- Preconditions of `free p auth` (§70). -/\nstructure FreePre (k : K) (s : S3) (p auth : Nat) : Prop where\n  /-- §70.1: `place` is an `OwnedRoot`. -/\n  ownedRoot : OwnedRoot s p\n  /-- §70.2: `K.Deallocable(place)`. -/\n  deallocable : k.Deallocable p\n  /-- §70.2: `K.FreeCompat(place, auth)`. -/\ndef FreedPlace (P : List Place) (p q : Nat) : Prop := partOf P q p ∨ OwnedIn P p q\n\n/-- Decidability of `FreedPlace` (§70). -/\ninstance (P : List Place) (p q : Nat) : Decidable (FreedPlace P p q) := by\n  unfold FreedPlace; infer_instance\n\n906:  providerRight : HasRight s .modify provider ∨\n907-    ∃ via ∈ List.rang