sable leaf under exercisable `Modify` holding no active authority. -/","-def PushStatic (s : S3) (st : Stack) (dst : Nat) : Prop :=","+/-- Static preconditions of `push` of the cells `r`, checked before the room (§58, §77.4), those of","+the restricted `issue` (`IssueStaticR`, §77.1 and §77.2): the stack is live, the current frame has","+exercisable `Modify` on the stack value (`MetaRightM`), and the destination is a usable leaf under","+exercisable `Modify`, not `Init`, holding no active authority and outside `r`. The inclusion of the","+region in the storage is the room. -/","+def PushStatic (s : S3) (st : Stack) (r : List Nat) (dst : Nat) : Prop :=","   s.Active st.internal ∧ MetaRightM s st.arena ∧ s.Usable dst ∧ isLeaf s.P dst ∧","-    HasRight s .modify dst ∧ NoHeld s dst","+    HasRight s .modify dst ∧ (∀ l ∈ footprint s.P dst, s.I l ≠ .init) ∧ NoHeld s dst ∧ dst ∉ r"," ","-instance (s : S3) (st : Stack) (dst : Nat) : Decidable (PushStatic s st dst) := by","+instance (s : S3) (st : Stack) (r : List Nat) (dst : Nat) : Decidable (PushStatic s st r dst) := by","   unfold PushStatic; infer_instance"," "," /-- The derived `issue` (question 1, `issue_as_kernel_split`): `split` of `internal` on `r`, then"]},{"oldStart":136,"oldLines":13,"newStart":141,"newLines":17,"lines":["     .ok { d with stacks := d.stacks ++ [⟨storage, i, footprint d.s.P storage, 0, [], []⟩] }","   else .reject"," ","-/-- `push size dst` on the stack `j` (brief): the derived `issue` of the `size` cells at the top into","-`dst`; `fail` when fewer than `size` cells are left. -/","+/-- `push size dst` on the stack `j` (brief: \"émission au sommet (`issue` restreint)\"): the static","+clauses of the restricted `issue` (`PushStatic`), then `fail` when fewer than `size` cells are left,","+then the derived `issue` of the `size` cells at the top into `dst`. By `issue_as_kernel_split`, this","+realisation through kernel steps differs from the restricted `issue` only by clause 5 of `store`","+(O8.5), which it inherits. `size` may be zero: the block then has an empty footprint, as the","+restricted `issue` of the empty region (`ce_empty_region`), and it blocks no `rewind`. -/"," def push (d : DS) (j size dst : Nat) : Out :=","   match d.stacks[j]? with","   | none => .reject","   | some st =>","-    if PushStatic d.s st dst then","+    if PushStatic d.s st (cellsOf st st.top size) dst then","       if st.top + size ≤ st.cells.length then","         if IssueSeq k d.s st (cellsOf st st.top size) dst then","           .ok { d with"]},{"oldStart":164,"oldLines":10,"newStart":173,"newLines":13,"lines":["       stacks := d.stacks.set j { st with marks := st.marks ++ [⟨j, d.fresh, st.top⟩] }","       fresh := d.fresh + 1 }"," ","-/-- `rewind m` on the stack `j` (brief): `fail` when `m` is not a live mark of the stack; the derived","-`reset` on the cells above `m`, rejected when an active authority derived from `internal` covers","-one of them (`rewind_rejects_live_above`); `ok`: the top returns to the top of `m`, the blocks above","-`m` are forgotten, `m` and the later marks are removed, the older marks stay. -/","+/-- `rewind m` on the stack `j` (brief): `fail` when `m` is not a live mark of the stack; then the","+derived `reset` on the cells above `m`, `split` of `internal` on them and `release`, which rejects","+when an active authority derived from `internal` covers one of them (`rewind_rejects_live_above`)","+and also when the current frame cannot exercise `internal` at `Modify` (O2.1, the restricted","+`MetaRight` of §78.1); `ok`: the top returns to the top of `m`, the blocks whose base is above it","+are forgotten, `m` and the later marks are removed, the older marks stay (`rewind_removes`). A stack","+that does not exist rejects (no stack value). -/"," def rewind (d : DS) (j : Nat) (m : Mark) : Out :=","   match d.stacks[j]? with","   | none => .reject"]},{"oldStart":184,"oldLines":10,"newStart":196,"newLines":13,"lines":["       else .reject","     else .fail"," ","-/-- `grow b extra` on the stack `j` (brief: in place only): `b` is the authority of the last block,","-at the top, `extra` is positive and `b` can be released; `fail` when fewer than `extra` cells follow","-the block; otherwise `release` of `b`, then the derived `issue` of the region of the same base and","-of size `size + extra` into the destination of the block. -/","+/-- `grow b extra` on the stack `j` (brief: in place only). Static clauses, checked before the room","+(§58): `b` is the authority of the last block, at the top, `extra` is positive (\"taille plus","+grande\"), `b` can be released, the stack is live and the current frame has exercisable `Modify` on","+the stack value (`MetaRightM`). `fail` when fewer than `extra` cells follow the block; otherwise","+`release` of `b`, then the derived `issue` of the region of the same base and of size `size + extra`","+into the destination recorded for the block. That destination is `Init` (the first `store` wrote","+it): the derived `issue` accepts it (O8.2), the restricted `issue` would not (§77.2, report (c)). -/"," def grow (d : DS) (j b extra : Nat) : Out :=","   match d.stacks[j]? with","   | none => .reject"]},{"oldStart":195,"oldLines":7,"newStart":210,"newLines":8,"lines":["     match st.blocks.getLast? with","     | none => .reject","     | some x =>","-      if 0 < extra ∧ x.auth = b ∧ x.base + x.size = st.top ∧ ReleasePre d.s b then","+      if 0 < extra ∧ x.auth = b ∧ x.base + x.size = st.top ∧ ReleasePre d.s b ∧","+          d.s.Active st.internal ∧ MetaRightM d.s st.arena then","         if x.base + x.size + extra ≤ st.cells.length then","           if IssueSeq k (releaseEff d.s b) st (cellsOf st x.base (x.size + extra)) x.dst then","             .ok { d with"]},{"oldStart":266,"oldLines":7,"newStart":282,"newLines":8,"lines":["   · cases h"," "," theorem push_ok {d d' : DS} {j size dst : Nat} (h : push k d j size dst = .ok d') :","-    ∃ st, d.stacks[j]? = some st ∧ PushStatic d.s st dst ∧ st.top + size ≤ st.cells.length ∧","+    ∃ st, d.stacks[j]? = some st ∧ PushStatic d.s st (cellsOf st st.top size) dst ∧","+      st.top + size ≤ st.cells.length ∧","       IssueSeq k d.s st (cellsOf st st.top size) dst ∧","       d' = { d with","         s := issueSeqEff d.s st (cellsOf st st.top size) dst"]},{"oldStart":317,"oldLines":7,"newStart":334,"newLines":8,"lines":[" "," theorem grow_ok {d d' : DS} {j b extra : Nat} (h : grow k d j b extra = .ok d') :","     ∃ st x, d.stacks[j]? = some st ∧ st.blocks.getLast? = some x ∧ 0 < extra ∧ x.auth = b ∧","-      x.base + x.size = st.top ∧ ReleasePre d.s b ∧ x.base + x.size + extra ≤ st.cells.length ∧","+      x.base + x.size = st.top ∧ ReleasePre d.s b ∧","+      (d.s.Active st.internal ∧ MetaRightM d.s st.arena) ∧ x.base + x.size + extra ≤ st.cells.length ∧","       IssueSeq k (releaseEff d.s b) st (cellsOf st x.base (x.size + extra)) x.dst ∧","       d' = { d with","         s := issueSeqEff (releaseEff d.s b) st (cellsOf st x.base (x.size + extra)) x.dst"]},{"oldStart":337,"oldLines":7,"newStart":355,"newLines":8,"lines":["         split at h","         · split at h","           · cases h","-            exact ⟨st, x, hst, hx, hc.1, hc.2.1, hc.2.2.1, hc.2.2.2, by assumption, by assumption, rfl⟩","+            exact ⟨st, x, hst, hx, hc.1, hc.2.1, hc.2.2.1, hc.2.2.2.1, hc.2.2.2.2, by assumption,","+              by assumption, rfl⟩","           · cases h","         · cases h","       · cases h"]},{"oldStart":394,"oldLines":7,"newStart":413,"newLines":7,"lines":["       .split hr (rs := [above st m]) (src := st.internal) (.ok hsp)","     exact .release h1 (.ok hrel)","   | grow j b extra =>","-    obtain ⟨st, x, -, -, -, -, -, hrel, -, hseq, rfl⟩ := grow_ok h","+    obtain ⟨st, x, -, -, -, -, -, hrel, -, -, hseq, rfl⟩ := grow_ok h","     exact (issueSeq_reach (.release hr (.ok hrel)) hseq).2"," "," theorem drun_reach {statics : Statics} : ∀ {d d' : DS} {os : List DOp},"]},{"oldStart":479,"oldLines":9,"newStart":498,"newLines":10,"lines":[" variable {k : K} [∀ r r', Decidable (k.DeclaredDisjoint r r')]"," "," /-- `rewind_rejects_live_above` (brief): `rewind m` of a live mark is rejected when an active","-authority derived from `internal` covers a cell above `m`, where the regions issued after `m` lie:","-its effective `Modify` on that cell is gone, so `split` of `internal` on the cells above `m` is","-rejected (O2.1). -/","+authority derived from `internal` covers a cell above `m` (`above`, the cells that the rewind","+returns): its effective `Modify` on that cell is gone, so `split` of `internal` on the cells above","+`m` is rejected (O2.1). The brief's \"couvre une région émise après `m`\" is read on the cells that the","+rewind returns (`above`; report, (f)). -/"," theorem rewind_rejects_live_above {d : DS} {j : Nat} {st : Stack} {m : Mark}","     (hst : d.stacks[j]? = some st) (hm : m ∈ st.marks) {x l : Nat} {y : Authority}","     (hy : d.s.A[x]? = some y) (ya : y.active = true) (hx : st.internal ∈ d.s.ancs x)"]},{"oldStart":490,"oldLines":8,"newStart":510,"newLines":10,"lines":["     effective_ne_modify_of_active_desc hy ya hly hx (h.1.2.2.1 _ (List.mem_singleton_self _) l hl)","   simp [rewind, hst, hm, hn]"," ","-/-- Converse of `rewind_rejects_live_above`: an `ok` of `rewind m` is the rewind of a live mark of","-the stack above which no active authority derived from `internal` covers a cell. -/","+/-- `rewind_rejects_live_above` read on an `ok` (its contrapositive): an `ok` of `rewind m` is the","+rewind of a live mark of the stack above which no active authority derived from `internal` covers a","+cell. The converse of `rewind_rejects_live_above` does not hold: `rewind` also rejects when the","+current frame cannot exercise `internal` (see `rewind`). -/"," theorem rewind_ok_no_live_above {d d' : DS} {j : Nat} {m : Mark} (h : rewind k d j m = .ok d') :","     ∃ st, d.stacks[j]? = some st ∧ m ∈ st.marks ∧","       ∀ (x : Nat) (y : Authority), d.s.A[x]? = some y → y.active = true →"]},{"oldStart":537,"oldLines":7,"newStart":559,"newLines":7,"lines":["       d'.s.afp d.s.A.length = cellsOf st x.base (x.size + extra) ∧","       cellsOf st x.base x.size <+: cellsOf st x.base (x.size + extra) ∧","       (releaseEff d.s b).A[b]?.map (·.active) = some false := by","-  obtain ⟨st, x, hst, hx, hex, hb, -, hrel, -, -, rfl⟩ := grow_ok h","+  obtain ⟨st, x, hst, hx, hex, hb, -, hrel, -, -, hseq, rfl⟩ := grow_ok h","   have hj : j < d.stacks.length := lt_of_getElem? hst","   refine ⟨st, x, _, hst, hx, hb, hex, List.getElem?_set_self hj, by simp, grow_new_auth,","     cellsOf_prefix st _ _ _, ?_⟩"]},{"oldStart":550,"oldLines":7,"newStart":572,"newLines":7,"lines":[" theorem grow_keeps_prefix_init {d d' : DS} {j b extra : Nat} (h : grow k d j b extra = .ok d')","     {st : Stack} {x : Blk} (hst : d.stacks[j]? = some st) (hx : st.blocks.getLast? = some x) :","     ∀ l ∈ cellsOf st x.base x.size, d'.s.I l = d.s.I l := by","-  obtain ⟨st₀, x₀, hst₀, hx₀, -, -, -, -, -, ⟨-, hstore⟩, rfl⟩ := grow_ok h","+  obtain ⟨st₀, x₀, hst₀, hx₀, -, -, -, -, -, -, ⟨-, hstore⟩, rfl⟩ := grow_ok h","   rw [hst] at hst₀; cases hst₀; rw [hx] at hx₀; cases hx₀","   intro l hl","   have hy₀ := addAuth_self (releaseEff d.s b)"]},{"oldStart":634,"oldLines":7,"newStart":656,"newLines":7,"lines":["     intro i st'' h' m' hm'","     exact stacks_set_marks hst hQ h' (fun _ h => List.takeWhile_subset _ h) m' hm'","   | grow j b extra =>","-    obtain ⟨st, x, hst, -, -, -, -, -, -, -, rfl⟩ := grow_ok h","+    obtain ⟨st, x, hst, -, -, -, -, -, -, -, -, rfl⟩ := grow_ok h","     refine ⟨hid, fin ?_⟩","     intro i st'' h' m' hm'; exact stacks_set_marks hst hQ h' (fun _ h => h) m' hm'"," "]},{"oldStart":675,"oldLines":7,"newStart":697,"newLines":7,"lines":["     intro i st'' h' m hm","     exact stacks_set_marks hst hw h' (fun _ h => List.takeWhile_subset _ h) m hm","   | grow j b extra =>","-    obtain ⟨st, x, hst, -, -, -, -, -, -, -, rfl⟩ := grow_ok h","+    obtain ⟨st, x, hst, -, -, -, -, -, -, -, -, rfl⟩ := grow_ok h","     intro i st'' h' m hm; exact stacks_set_marks hst hw h' (fun _ h => h) m hm"," "," theorem drun_marksWF : ∀ {d d' : DS} {os : List DOp}, drun k d os = some d' → MarksWF d →"]},{"oldStart":742,"oldLines":7,"newStart":764,"newLines":7,"lines":["       ∀ l ∈ cellsOf st x.base x.size,","         MM23.rangeBytes (MM23.exec s2 (MM23.storeOps pe s2 L (growMid d.s st x b extra)","           (releaseEff d.s b).A.length x.dst)) L l = MM23.rangeBytes s2 L l := by","-  obtain ⟨st₀, x₀, hst₀, hx₀, -, -, -, hrel, -, ⟨hsp, hstore⟩, rfl⟩ := grow_ok h","+  obtain ⟨st₀, x₀, hst₀, hx₀, -, -, -, hrel, -, -, ⟨hsp, hstore⟩, rfl⟩ := grow_ok h","   rw [hst] at hst₀; cases hst₀; rw [hx] at hx₀; cases hx₀","   have hr₁ : Reachable k statics (releaseEff d.s b) := .release hr (.ok hrel)","   have hr₂ : Reachable k statics (growMid d.s st x b extra) :="]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Lib/DataStack.lean"]}},"serverClassifierContext":{"request":"6d37a483-131a-4c8d-bf4e-3c811e273f9d","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/derivability_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"6535e464-0246-4abf-b66f-cd8387fb07b1","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/