c.lean-188-/-- Active authority (§42); as an anchor, a valid anchor (§44). -/\nErn/MemoryModel/Access/Basic.lean-189-def S3.Active (s : S3) (x : Nat) : Prop := ∃ y, s.A[x]? = some y ∧ y.active = true\nErn/MemoryModel/Access/Basic.lean-190-\nErn/MemoryModel/Access/Basic.lean-191-/-- Decidability of `S3.Active` (§42, §44). -/\nErn/MemoryModel/RefinementArena.lean:937:variable (k : K) [∀ r r', Decidable (k.DeclaredDisjoint r r')] [DecidablePred k.SharedMutable]\nErn/MemoryModel/Refinement.lean:2838:variable (k : K) [∀ r r', Decidable (k.DeclaredDisjoint r r')] [DecidablePred k.SharedMutable]\nErn/MemoryModel/Refinement.lean:2869:    [DecidablePred k.SharedMutable] [DecidablePred k.Pinned] [DecidablePred k.ExternalDone]\nErn/MemoryModel/Access/Ops.lean:669:instance (k : K) [DecidablePred k.SharedMutable] (s : S3) (a : Nat) (ls : List Nat) :\nErn/MemoryModel/Access/Ops.lean:914:instance (k : K) [DecidablePred k.SharedMutable] (s : S3) (provider owner : Nat)\nErn/MemoryModel/Access/Invariants.lean:204:instance : DecidablePred K0.SharedMutable := fun _ => inferInstanceAs (Decidable True)\nErn/Corpus/Runner.lean:49:instance (d : KD) : DecidablePred d.toK.SharedMutable :=\nErn/Corpus/Runner.lean:143:variable (k : K) [∀ r r', Decidable (k.DeclaredDisjoint r r')] [DecidablePred k.SharedMutable]\nErn/Corpus/Runner.lean:264:variable {k : K} [∀ r r', Decidable (k.DeclaredDisjoint r r')] [DecidablePred k.SharedMutable]\nErn/Corpus/MM23H.lean:75:instance (d : KD) (dd sat : Bool) : DecidablePred (KT d dd sat).SharedMutable :=","is_error":false}]},"uuid":"56fed0fa-846a-44a1-b86e-740ef34fbb79","timestamp":"2026-11-14T07:56:49.993Z","toolUseResult":{"stdout":"Ern/MemoryModel/Access/Basic.lean:166:structure K where\nErn/MemoryModel/Access/Basic.lean-167-  DeclaredDisjoint : List Nat → List Nat → Prop\nErn/MemoryModel/Access/Basic.lean-168-  SharedMutable : Nat → Prop\nErn/MemoryModel/Access/Basic.lean-169-  Pinned : Nat → Prop\nErn/MemoryModel/Access/Basic.lean-170-  ExternalDone : Nat 