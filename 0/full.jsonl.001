ng/ern/formal/Ern/Derived/Arena.lean","hunks":[{"oldStart":299,"oldLines":4,"newStart":299,"newLines":111,"lines":["     rw [addAuth_self] at hx; cases hx","     exact absurd hlx (hout l hl)"," ","+/-- Exercise after `store` (O8) comes from an exercise before: `store` only moves the stored","+authority from the current frame to a place, and keeps every effective mode (`store_skel`). -/","+theorem exercisable_store_back {s : S3} {a p : Nat} {y : Authority} (hy : s.A[a]? = some y)","+    (hh : y.holder = .frame s.top) {b : Nat} {m : Mode} (h : (storeEff s a p).ExercisableAt b m) :","+    s.ExercisableAt b m := by","+  have hA : (storeEff s a p).A = s.A.set a { y with holder := .place p } := by","+    rw [storeEff_eq hy]","+  have hF : (storeEff s a p).F = s.F := by rw [storeEff_eq hy]","+  have hP : (storeEff s a p).P = s.P := by rw [storeEff_eq hy]","+  have he := (store_skel s a p).effective","+  have hal := lt_of_getElem? hy","+  induction h with","+  | @base b m z hz za hle hf =>","+    have hne : a ≠ b := by","+      rintro rfl","+      rw [hA, List.getElem?_set_self hal] at hz; cases hz","+      simp at hf","+    rw [hA, List.getElem?_set_ne hne] at hz","+    exact .base hz za hle (by rw [hf]; simp only [S3.top, hF])","+  | @held b q c m z hz za hle hq _ hc ih =>","+    by_cases hba : a = b","+    · subst hba","+      rw [hA, List.getElem?_set_self hal] at hz; cases hz","+      exact .base hy za hle hh","+    · rw [hA, List.getElem?_set_ne hba] at hz","+      exact .held hz za hle hq ih fun l hl => by rw [← he]; exact hc l (by rw [hP]; exact hl)","+","+/-- `HasRight` after `store` comes from `HasRight` before. -/","+theorem hasRight_store_back {s : S3} {a p q : Nat} {y : Authority} {m : Mode}","+    (hy : s.A[a]? = some y) (hh : y.holder = .frame s.top) (h : HasRight (storeEff s a p) m q) :","+    HasRight s m q := by","+  obtain ⟨b, -, hb, hall⟩ := h","+  have hP : (storeEff s a p).P = s.P := by rw [storeEff_eq hy]","+  have hb' := exercisable_store_back hy hh hb","+  exact ⟨b, List.mem_range.2 hb'.lt, hb', fun l hl => by","+    rw [← (store_skel s a p).effective]; exact hall l (by rw [hP]; exact hl)⟩","+","+/-- A place of the strict ancestors of `i` is the parent of some place. -/","+theorem mem_chainF_parent {org : Nat → Option Nat} :","+    ∀ k i x, x ∈ chainF org k i → ∃ j, org j = some x","+  | 0, _, _, h => by simp [chainF] at h","+  | k + 1, i, x, h => by","+    simp only [chainF] at h","+    cases ho : org i with","+    | none => rw [ho] at h; simp at h","+    | some o =>","+      rw [ho] at h; simp only at h","+      split at h","+      · rcases List.mem_cons.1 h with rfl | h","+        · exact ⟨i, ho⟩","+        · exact mem_chainF_parent k o x h","+      · simp at h","+","+/-- A leaf is a strict ancestor of no place (§42, `isLeaf`). -/","+theorem not_mem_chain_of_leaf {P : List Place} {d x : Nat} (hd : isLeaf P d) :","+    d ∉ chain (parentOf P) x := by","+  intro h","+  obtain ⟨j, hj⟩ := mem_chainF_parent _ _ _ h","+  have hjl : j < P.length := by","+    unfold parentOf at hj","+    cases hp : P[j]? with","+    | none => rw [hp] at hj; simp at hj","+    | some _ => exact lt_of_getElem? hp","+  exact hd j hjl hj","+","+/-- The footprint of a leaf is the leaf itself. -/","+theorem mem_footprint_leaf {P : List Place} {d l : Nat} (hd : isLeaf P d) (hlt : d < P.length) :","+    l ∈ footprint P d ↔ l = d := by","+  constructor","+  · intro hl","+    obtain ⟨-, -, -, h⟩ := mem_footprint.1 hl","+    exact h.resolve_right (not_mem_chain_of_leaf hd)","+  · rintro rfl; exact mem_footprint.2 ⟨hlt, hd, hlt, .inl rfl⟩","+","+/-- `NoDangling` (§54): a place containing a leaf covered by an active authority is usable. -/","+theorem usable_of_covered {s : S3} (hnd : NoDangling s) {j q l : Nat} {y : Authority}","+    (hy : s.A[j]? = some y) (ya : y.active = true) (hly : l ∈ y.footprint)","+    (hl : l ∈ footprint s.P q) : s.Usable q :=","+  Decidable.byContradiction fun hu => hnd j y hy ya q hu l hl hly","+","+/-- A usable place owned, transitively, by the leaf `dst` makes `dst` hold an active authority: the","+root authority of its root place, held by the owner of that place (`RootLive`, §54). -/","+theorem ownedIn_holds {s : S3} (hw : WF3 s) (hr : RootLive s) {dst : Nat} (hd : isLeaf s.P dst)","+    {q : Nat} (h : OwnedIn s.P dst q) (hu : s.Usable q) :","+    ∃ j z, s.A[j]? = some z ∧ z.active = true ∧ z.holder = .place dst := by","+  induction h with","+  | @direct q o pl hq ho hpo =>","+    have hod : o = dst := hpo.2.resolve_right (not_mem_chain_of_leaf hd)","+    subst hod","+    obtain ⟨r, hrp, hqr⟩ := exists_rootPlace hw (q + 1) q (Nat.lt_succ_self q) hu.lt","+    obtain ⟨pl', pr, hpl', hpr, hown⟩ := hw.ownerOf hqr","+    rw [hq] at hpl'; cases hpl'","+    have hdead : s.dead r = false := by rw [← hw.deadOf hqr]; cases hu <;> assumption","+    have hou : s.Usable o := by","+      cases hu with","+      | frame hq' _ ho' _ => rw [hq] at hq'; cases hq'; rw [ho] at ho'; cases ho'","+      | place hq' _ ho' hu' => rw [hq] at hq'; cases hq'; rw [ho] at ho'; cases ho'; exact hu'","+    have hur : s.Usable r := .place hpr hdead (by rw [← hown, ho]) hou","+    obtain ⟨i, z, pr', hz, za, -, hpr', hzh, -⟩ := hr r hrp hur","+    rw [hpr] at hpr'; cases hpr'","+    exact ⟨i, z, hz, za, by rw [hzh, ← hown, ho]⟩","+  | @step q o pl hq ho _ ih =>","+    apply ih","+    cases hu with","+    | frame hq' _ ho' _ => rw [hq] at hq'; cases hq'; rw [ho] at ho'; cases ho'","+    | place hq' _ ho' hu' => rw [hq] at hq'; cases hq'; rw [ho] at ho'; cases ho'; exact hu'","+"," end Ern.Derived.Arena"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Derived/Arena.lean"]}},"serverClassifierContext":{"request":"bb191fa7-27a6-4094-86a1-dffa17392cf2","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/derivability_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"un