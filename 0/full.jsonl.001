cations are live have the outcome"," `ok`, and the states where those leaves are `Init` stay in `Repr`, under `dec` along the","-sequence and in the sequential fragment (K5). -/","+sequence and `stat` (K5). -/"," theorem repr_writes {C : Nat → Nat → Prop} {ObR : MM02.ReadOblSpec} {ObW : MM02.WriteOblSpec}","     {tok : Nat → Nat} {L : Layout} {w : Nat → Nat → UInt8 × Option Nat}","     (hstat : ∀ s ac w, ObW.stat s ac w) :"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/MM23.lean"]}},"serverClassifierContext":{"request":"e9c9964f-050d-4a08-9d8d-971a81b82144","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/refinement_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"65412290-e897-4a1a-a63b-2c3ae2f106a4","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/refinement_0.1","slug":"effervescent-gathering-wind"}
