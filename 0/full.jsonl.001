y/FullEncap/Witness.lean","hunks":[{"oldStart":205,"oldLines":4,"newStart":205,"newLines":122,"lines":["       (.unlock ⟨by decide, ⟨5, some 7⟩, 7, rfl, by decide, rfl, by decide, by decide, rfl⟩) .nil","   exact ⟨rfl, runFull_of_run7 (run7_of_run5R (hs.run _) (by decide)) (by decide)⟩"," ","+/-! ## W-RX -/","+","+/-- Statics of W-RX (Spec 1 §47): `0` the outer mutex value `M` with fields `1` (`slot`, `Uninit`)","+and `2` (`lock`, `Init`); `3` its protected root `T`, owned by `M`, whose part `4` is the inner","+mutex value `N` with fields `5` (`slot_n`, `Uninit`) and `6` (`lock_n`, `Init`); `7` the protected","+root `U` of `N`, a leaf, `Init`, owned by `N`. Root authorities: `0` of `M` (frame 0), `1` of `T`","+(held by `M`), `2` of `U` (held by `N`). -/","+def rxst : Statics :=","+  [((none, none, 0), false), ((some 0, none, 0), false), ((some 0, none, 0), true),","+   ((none, some 0, 0), false), ((some 3, some 0, 0), false), ((some 4, some 0, 0), false),","+   ((some 4, some 0, 0), true), ((none, some 4, 0), true)]","+","+/-- The statics are well formed (Spec 1 §47). -/","+theorem rxst_ok : StaticsOK rxst := by decide","+","+/-- The contract of W-RX: the two controllers `lock` (place 2) and `lock_n` (place 6) are the","+`SharedMutable` leaves (WC5.2 C13 item 6). -/","+abbrev KX : K := KC [2, 6]","+","+/-- Initial state of W-RX. -/","+def rx0 : SC := SC.ofS3 (S3.init rxst)","+/-- `guarded_n := derive(root_U, Modify, footprint(U))`, authority 3 (O1). -/","+def rx1 : SC := rx0.set (deriveEff (rx0.view 0) 2 [7] .modify)","+/-- `store(guarded_n, slot_n)` (O8). -/","+def rx2 : SC := storeEffC rx1 0 3 5","+/-- The registry after `newMutex(guarded_n)` (WC5.2 C13): entry `e_n`, index 0. -/","+def rxReg1 : SyncReg := [⟨3, none⟩]","+/-- `guarded := derive(root_T, Modify, footprint(T))`, authority 4 (O1). -/","+def rx3 : SC := rx2.set (deriveEff (rx2.view 0) 1 [5, 6] .modify)","+/-- `store(guarded, slot)` (O8). -/","+def rx4 : SC := storeEffC rx3 0 4 1","+/-- The registry after `newMutex(guarded)` (WC5.2 C13): entry `e`, index 1. -/","+def rxReg : SyncReg := [⟨3, none⟩, ⟨4, none⟩]","+/-- Step B, `c0 : acquire(e)`: `g`, authority 5, held by frame 0 (WC5.2 C16). -/","+def rx5 : SC := deriveSyncEff rx4 0 4","+/-- The registry with `g` recorded for `e`. -/","+def rxRegG : SyncReg := [⟨3, none⟩, ⟨4, some 5⟩]","+","+/-- The labels of the setup of W-RX: the inner mutex first, then the outer one; no grant. -/","+def rxSetup : List Label :=","+  [.kernel 0 (.derive 2 [7] .modify), .kernel 0 (.store 3 5), .newMutex 0 3,","+   .kernel 0 (.derive 1 [5, 6] .modify), .kernel 0 (.store 4 1), .newMutex 0 4]","+","+/-- The setup of W-RX from the initial state, each step admitted by `Encap5R`. -/","+theorem rx_setup {sts : List (SC × SyncReg × ArenaReg)} {lbls : List Label}","+    (h : Steps5R KX L0 ((rx4, rxReg, []) :: sts) lbls) :","+    Steps5R KX L0 ((rx0, [], []) :: (rx1, [], []) :: (rx2, [], []) :: (rx2, rxReg1, []) ::","+      (rx3, rxReg1, []) :: (rx4, rxReg1, []) :: (rx4, rxReg, []) :: sts) (rxSetup ++ lbls) :=","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|","+  .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, _, .ok (by decide), rfl⟩) <|","+  .cons (by decide) (.kernel ⟨by decide, .ok (by decide)⟩) <|","+  .cons (by decide) (.newMutex ⟨by decide, by decide, rfl⟩) h","+","+/-- The labels of W-RX, step A. -/","+def rxaLbls : List Label := rxSetup ++ [.resetLock 0 0]","+","+/-- The named states of W-RX, step A. -/","+def rxaσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(rx0, [], []), (rx1, [], []), (rx2, [], []), (rx2, rxReg1, []), (rx3, rxReg1, []),","+    (rx4, rxReg1, []), (rx4, rxReg, []), (rx4, rxReg, [])].getD i (rx4, rxReg, [])","+","+/-- `corpus-spec2-m3.md` v13 §2 duodecies W-RX: the nested setup is accepted by the kernel; both","+entries are live and `ControlOf(e_n) = lock_n`, `ControlOf(e) = lock` (WC5.2 C13). -/","+theorem W_RX_setup : rxaσ 0 = (SC.ofS3 (S3.init rxst), [], []) ∧","+    ControlOf L0 rx4 ⟨3, none⟩ = some 6 ∧ ControlOf L0 rx4 ⟨4, none⟩ = some 2 ∧","+    (⟨3, none⟩ : SyncEntry).Live rx4 ∧ (⟨4, none⟩ : SyncEntry).Live rx4 := by","+  exact ⟨rfl, by decide, by decide, by decide, by decide⟩","+","+/-- `corpus-spec2-m3.md` v13 §2 duodecies W-RX, step A, `ok` (WC5.2 C18 item 1:","+`ExercisableAt(guarded_n, Modify)`, `guarded_n` being held by `slot_n`, a leaf of `T`, on which","+`guarded` has effective `Modify`, `guarded` being held by `slot` under `root_M`, third clause of","+Spec 1 §43 twice; C18 items 2 and 3; C18 item 4 through the same chain):","+`resetLock(e_n)` by context 0 without the grant of `e`. -/","+theorem W_RX_A_ok : ResetLockOk L0 rx4 rxReg 0 0 (rx4, rxReg) ∧","+    AmCondF L0 (rx4, rxReg, []) (.resetLock 0 0) :=","+  ⟨⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, by decide, rfl⟩, by decide⟩","+","+/-- `corpus-spec2-m3.md` v13 §2 duodecies W-RX, step A, under the existing encapsulation: from the","+initial state, the trace is a final amended execution (nothing in `Encap7` reads the right of","+C18 item 1). -/","+theorem W_RX_A_current : RunAmF KX L0 rxaσ rxaLbls := by","+  have h : Steps5R KX L0 [(rx4, rxReg, []), (rx4, rxReg, [])] [.resetLock 0 0] :=","+    .cons (by decide) (.resetLock W_RX_A_ok.1) .nil","+  exact ⟨run7_of_run5R ((rx_setup h).run _) (by decide), by decide⟩","+","+/-- `corpus-spec2-m3.md` v13 §2 duodecies W-RX, step A, excluded by the complete encapsulation:","+the chain of the right on `slot_n` contains `guarded`, the `guarded` of the other live entry `e`","+(WC5.2 C22 item 6, `resetLock` exception); so does the controller-access right of C18 item 4.","+Both guard-free forms fail; the trace is no `RunFull`. -/","+theorem W_RX_A_excluded :","+    ¬ ResetExerG (rx4, rxReg) 0 0 ∧ ¬ CtrlRight5 L0 (rx4, rxReg) ⟨3, none⟩ 0 ∧","+    ¬ PremG KX L0 (rx4, rxReg, []) (.resetLock 0 0) ∧ ¬ RunFull KX L0 rxaσ rxaLbls := by","+  have h : ¬ PremG KX L0 (rx4, rxReg, []) (.resetLock 0 0) := by decide","+  exact ⟨by decide, by decide, h, fun hr => h (hr 6 (by decide)).1.2⟩","+","+/-- The labels of W-RX, twin B. -/","+def rxbLbls : List Label := rxSetup ++ [.acquire 0 1, .resetLock 0 0]","+","+/-- The named states of W-RX, twin B. -/","+def rxbσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(rx0, [], []), (rx1, [], []), (rx2, [], []), (rx2, rxReg1, []), (rx3, rxReg1, []),","+    (rx4, rxReg1, []), (rx4, rxReg, []), (rx5, rxRegG, []), (rx5, rxRegG, [])].getD i","+    (rx5, rxRegG, [])","+","+/-- `corpus-spec2-m3.md` v13 §2 duodecies W-RX, twin B, `ok` and admitted: `c0 : acquire(e)`,","+then `c0 : resetLock(e_n)`; the rights on `slot_n` and `lock_n` rest on `g`, held by `f0`; only","+`guarded_n`, the subject of the check, is exempt. From the initial state, the trace is a","+`RunFull`. -/","+theorem W_RX_B : rxbσ 0 = (SC.ofS3 (S3.init rxst), [], []) ∧ RunFull KX L0 rxbσ rxbLbls := by","+  have h : Steps5R KX L0 [(rx4, rxReg, []), (rx5, rxRegG, []), (rx5, rxRegG, [])]","+      [.acquire 0 1, .resetLock 0 0] :=","+    .cons (by decide) (.acquire ⟨by decide, ⟨4, none⟩, rfl, by decide, by decide, rfl⟩) <|","+    .cons (by decide) (.resetLock ⟨by decide, ⟨3, none⟩, rfl, by decide, by decide, by decide,","+      rfl⟩) .nil","+  exact ⟨rfl, runFull_of_run7 (run7_of_run5R ((rx_setup h).run _) (by decide)) (by decide)⟩","+"," end Ern.Concurrency.FullEncap.Witness"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/Witness.lean"]}},"serverClassifierContext":{"request":"3d636fbe-7263-43b9-9e7d-70fe4da9779c","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remo