p s.A.length dst s₁ (.ok s₂)) (hav : Avail ar region)","+    (hni : ∀ l ∈ footprint s.P dst, s.I l ≠ .init) :","+    s₁ = s.addAuth (blockOf s ar region) ∧","+      IssueR ar region dst s (.ok s₂ (issueEffR s ar region dst).2) := by","+  obtain ⟨-, -, -, hais⟩ := reachable_invariants hdd hr","+  obtain ⟨⟨hact, hex, hright, hreg, -, -⟩, rfl⟩ := Guarded.ok_iff.1 hsp","+  obtain ⟨⟨-, hu₁, hrd₁, hcov, -, hleaf, hnoh₁, -, haoh⟩, rfl⟩ := Guarded.ok_iff.1 hst","+  refine ⟨rfl, ?_⟩","+  have hy₀ : (s.addAuth (blockOf s ar region)).A[s.A.length]? = some (blockOf s ar region) :=","+    addAuth_self _ _","+  have hud : s.Usable dst :=","+    (S3.Usable.congr (s := s) (s' := s.addAuth (blockOf s ar region)) rfl rfl rfl).1 hu₁","+  have hfd : ∀ l, l ∈ footprint s.P dst ↔ l = dst := fun l => mem_footprint_leaf hleaf hud.lt","+  have hnot : dst ∉ region := by","+    intro hd","+    have := (hcov dst (by show dst ∈ (s.addAuth _).afp _; simp only [S3.afp, hy₀]; exact hd)).1","+    exact this ((hfd dst).2 rfl)","+  have hright' : IssueRight s ar region := fun l hl => hright region (List.mem_singleton_self _) l hl","+  have hai := hais ar har hact","+  have harr' := issueEffR_eq s ar region dst","+  have hstat : IssueStaticR s ar region dst := by","+    refine ⟨(metaRightM_iff hai hact).2 hex, hact,","+      fun l hl => (hreg region (List.mem_singleton_self _) l hl).1, hud, ?_, hni, hleaf, ?_, hnot⟩","+    · exact hasRight_addAuth_back hex (fun l hl => hright' l hl)","+        (fun l hl hlr => hnot (by rw [(hfd l).1 hl] at hlr; exact hlr)) hrd₁","+    · intro j hj","+      have hjl := List.mem_range.1 hj","+      have := hnoh₁ j (List.mem_range.2 (by simp [S3.addAuth]; omega))","+      rwa [addAuth_lt hjl] at this","+  have harr : ArrivalR s ar region dst := by","+    refine ⟨?_, by rw [harr']; exact haoh⟩","+    rw [harr']","+    have hP : (storeEff (s.addAuth (blockOf s ar region)) s.A.length dst).P = s.P := by","+      rw [storeEff_eq hy₀]; rfl","+    refine haoh dst ((S3.Usable.congr hP (by rw [storeEff_eq hy₀]; rfl)","+      (by rw [storeEff_eq hy₀]; rfl)).2 hud) s.A.length { blockOf s ar region with holder := .place dst }","+      (by rw [storeEff_eq hy₀]; exact List.getElem?_set_self (by simp [S3.addAuth])) rfl rfl","+  have hok := IssueR.ok hstat hav hright' harr","+  rwa [harr'] at hok","+","+/-- `issue_as_kernel` for a region (brief, question 1), in reached states: the restricted `issue`","+is `ok` with a destination still exercisable at `Modify` iff the region is available, the","+destination is not `Init`, and `split` of `internal` on the region then `store` of the block into","+the destination are `ok`; the arrival state of the kernel part is the same, and the metadata is that","+of the restricted `issue`. `fail` is `issueR_fail_iff`, `reject` is `issueR_reject_iff`. -/","+theorem issue_as_kernel_split {s' : S3} {ar' : Arena} :","+    (IssueR ar region dst s (.ok s' ar') ∧ HasRight s' .modify dst) ↔","+      Avail ar region ∧ (∀ l ∈ footprint s.P dst, s.I l ≠ .init) ∧","+      SplitStep k ar.internal [region] s (.ok (s.addAuth (blockOf s ar region))) ∧","+      StoreStep s.A.length dst (s.addAuth (blockOf s ar region)) (.ok s') ∧","+      ar' = (issueEffR s ar region dst).2 := by","+  constructor","+  · rintro ⟨h, hg2⟩","+    obtain ⟨hsp, hst⟩ := issue_to_seq hdd hr har h hg2","+    obtain ⟨hstat, hav, -, -, he⟩ := issueR_ok_iff.1 h","+    exact ⟨hav, hstat.2.2.2.2.2.1, hsp, hst, congrArg Prod.snd he⟩","+  · rintro ⟨hav, hni, hsp, hst, rfl⟩","+    obtain ⟨-, h⟩ := seq_to_issue hdd hr har hsp hst hav hni","+    exact ⟨h, (Guarded.ok_iff.1 hst).1.2.2.2.2.2.2.2.1 |> fun h' => by","+      rw [(Guarded.ok_iff.1 hst).2]; exact h'⟩","+","+/-- On a place `q` with a leaf, `derive` of `internal` at `Modify` (O1) is `split` of `internal` on","+the footprint of `q` (O2, one region), with the same effect: the usability of `q` asked by","+`derive` follows from `NoDangling`, `internal` being active and covering the footprint. -/","+theorem derive_iff_split {q : Nat} (hq : q < s.P.length) {s₁ : S3} :","+    DeriveStep ar.internal q .modify s (.ok s₁) ↔","+      SplitStep k ar.internal [footprint s.P q] s (.ok s₁) := by","+  obtain ⟨hwf, hinv, -, -⟩ := reachable_invariants hdd hr","+  constructor","+  · intro h","+    obtain ⟨⟨hact, hex, -, hsub, hal⟩, rfl⟩ := Guarded.ok_iff.1 h","+    have hm : ∀ p ∈ footprint s.P q, effective s ar.internal p = some .modify :=","+      fun p hp => allows_modify_iff.1 (hal p hp)","+    refine .ok ⟨hact, hex, ?_, ?_, List.pairwise_singleton _ _, ?_⟩","+    · intro r hr' p hp; rw [List.mem_singleton.1 hr'] at hp; exact hm p hp","+    · intro r hr' p hp; rw [List.mem_singleton.1 hr'] at hp","+      exact ⟨hsub p hp, by rw [hm p hp]; simp⟩","+    · intro r hr' p hp j _ hd","+      rw [List.mem_singleton.1 hr'] at hp","+      unfold DistribExcl at hd","+      cases hj : s.A[j]? with","+      | none => rw [hj] at hd; exact hd","+      | some y =>","+        rw [hj] at hd; obtain ⟨ya, hanc, hpy, hmy⟩ := hd","+        exact effective_ne_modify_of_desc hj ya hpy hanc hmy (hm p hp)","+  · intro h","+    obtain ⟨⟨hact, hex, hright, hreg, -, -⟩, rfl⟩ := Guarded.ok_iff.1 h","+    obtain ⟨l, hl⟩ := exists_mem_footprint hwf (s.P.length - q + 1) q (by omega) hq","+    obtain ⟨yi, hyi, yia⟩ := hact","+    have hli : l ∈ yi.footprint := by","+      have := (hreg _ (List.mem_singleton_self _) l hl).1; simpa [S3.afp, hyi] using this","+    refine .ok ⟨⟨yi, hyi, yia⟩, hex, usable_of_covered hinv.nd hyi yia hli hl,","+      fun p hp => (hreg _ (List.mem_singleton_self _) p hp).1,","+      fun p hp => by rw [hright _ (List.mem_singleton_self _) p hp]; exact allows_some_modify _⟩","+","+/-- `issue_as_kernel` (brief, question 1), with `derive` (O1) of `internal` at `Modify` on a place","+`q`, the region being the footprint of `q`. Same statement as `issue_as_kernel_split`. A region that","+is not the footprint of a place, the empty region included (`exists_mem_footprint`), is out of reach","+of the kernel `derive`, which takes a place; `split` on one region covers it. -/","+theorem issue_as_kernel {q : Nat} (hq : q < s.P.length) {s' : S3} {ar' : Arena} :","+    (IssueR ar (footprint s.P q) dst s (.ok s' ar') ∧ HasRight s' .modify dst) ↔","+      Avail ar (footprint s.P q) ∧ (∀ l ∈ footprint s.P dst, s.I l ≠ .init) ∧","+      DeriveStep ar.internal q .modify s (.ok (deriveEff s ar.internal q .modify)) ∧","+      StoreStep s.A.length dst (deriveEff s ar.internal q .modify) (.ok s') ∧","+      ar' = (issueEffR s ar (footprint s.P q) dst).2 := by","+  rw [issue_as_kernel_split hdd hr har, derive_iff_split hdd hr har hq, deriveEff_eq]","+"," end IssueAsKernel"," "," end Ern.Derived.Arena"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Derived/Arena.lean"]}},"serverClassifierContext":{"request":"4c088656-6828-4161-96d0-a55caca00617","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/derivability_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"aea9c8a8-9da6-4c01-b7a8-0e1e384c3b09","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/derivability_0.1","slug":"effervescent-gathering-wind"}
