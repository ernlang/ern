2:def writeOps (s2 : MM02.State) (L : Layout) (w : Nat → Nat → UInt8 × Option Nat) (ls : List Nat) :\n298:def allocOps (pl : Placement) (g : Nat → Geom) (fa : Option Nat) :\n332:def Dom (s s' : MM02.State) : Prop :=\n646:structure NewLayout (L : Layout) (P' : List Place) (n next : Nat) (g : Nat → Geom)\n879:def initLeaves (statics : Statics) : List Nat :=\n886:def initOps (pl : Placement) (g : Nat → Geom) (tok : Nat → Nat) (L : Layout)\n969:def FpLeaves (s : S3) : Prop :=\n1065:def FrameOwnedLive (s : S3) : Prop :=\n1373:def rootAlloc (L : Layout) (P : List Place) (r : Nat) : Nat := (L ((footprint P r).headD r)).alloc\n1392:def deallocOps (ids : List Nat) (au : Nat) : List Op2 := ids.map fun i => .dealloc i au\n1673:def FreeSound (k : K) (C : Nat → Nat → Prop) (L : Layout) (s3 : S3) (s2 : MM02.State)\n1681:def TokCompat (C : Nat → Nat → Prop) (tok : Nat → Nat) : Prop := ∀ f, C (tok f) (tok f)\n1759:def FreeCompatInst (C : Nat → Nat → Prop) (ptok : Nat → Nat) (provOf : Nat → Option Nat)\n1858:def frameRoots (s3 : S3) (f : Nat) : List Nat :=\n1871:def exitOps (L : Layout) (tok : Nat → Nat) (s3 : S3) : List Op2 :=\n1957:inductive NoStep (k : K) : S3 → S3 → Prop where\n2020:def rangeBytes (s2 : MM02.State) (L : Layout) (l : Nat) : Option (List MM02.AByte) :=\n2025:def bytesOf (s2 : MM02.State) (L : Layout) (l : Nat) : Nat → UInt8 × Option Nat := fun i =>\n2032:def transferPairs (P : List Place) (src dst : Nat) : List (Nat × Nat) :=\n2038:def copyOps (s2 : MM02.State) (L : Layout) : List (Nat × Nat) → List Op2\n2044:def transferOps (s2 : MM02.State) (L : Layout) (P : List Place) (src dst : Nat) : List Op2 :=\n2048:def SameSizeAlong (L : Layout) (P : List Place) (src dst : Nat) : Prop :=\n2445:structure PtrEnc where\n2453:def PtrEncAt (pe : PtrEnc) (addr : Nat) (prov : Option Nat) : Prop :=\n2460:def regionAddr (s2 : MM02.State) (L : Layout) (rg : List Nat) : Nat :=\n2467:def regionProv (L : Layout) (rg : List Nat) : Option Nat := rg.head?.map fun l => (L l).alloc\n2470:d