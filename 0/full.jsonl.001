hl : l ∈ y.footprint)","+    (hz : z ∈ s.ancs j) : ¬ Allows (effective s z l) .modify := by","+  have hd : y.mode ∈ descModes s z l := mem_descModes.2 ⟨j, y, hy, ya, hl, hz, rfl⟩","+  have hne : descModes s z l ≠ [] := fun h => by rw [h] at hd; cases hd","+  unfold effective","+  split","+  · split","+    · simp only [effOf, hne, ↓reduceIte]","+      split","+      · exact id","+      · intro h; rcases h with h | h <;> cases h","+    · exact id","+  · exact id","+","+/-- At the creation of a companion (material §4, `resolve`), every active companion of the same","+pool and the new one are both `Observe`: an active companion is unrelated to `internal`, which I1","+excludes since `internal` is `Modify`, or descends from it, which takes away the effective mode","+that the `derive` of the new companion requires (MM-03.3.5; MM-03.3 §2, I1; O1). -/","+theorem companion_blocks {s : S3} (hw : WF3 s) (hi1 : I1 s) {pl : Pool} {m : Mode}","+    (hR : ResolveRight s pl m) {xi : Authority} (hxi : s.A[pl.internal]? = some xi)","+    (hmi : xi.mode = .modify) {c : Nat} {y : Authority} (hc : s.A[c]? = some y)","+    (hya : y.active = true) (hlt : pl.internal < c)","+    (hfp : ∀ l, l ∈ y.footprint ↔ l ∈ footprint s.P pl.storage) :","+    y.mode = .observe ∧ m = .observe := by","+  obtain ⟨hact, -, hus, hsub, hall⟩ := hR","+  obtain ⟨l, hl⟩ := exists_mem_footprint hw (s.P.length - pl.storage + 1) pl.storage (by omega)","+    hus.lt","+  have hli : l ∈ xi.footprint := by have := hsub l hl; simpa [S3.afp, hxi] using this","+  have hxa : xi.active = true := by","+    obtain ⟨z, hz, za⟩ := hact; rw [hxi] at hz; cases hz; exact za","+  have hly : l ∈ y.footprint := (hfp l).2 hl","+  have hz : pl.internal ∈ s.ancs c := Decidable.byContradiction fun hn => by","+    have hn2 : c ∉ s.ancs pl.internal := fun h => absurd (chain_lt h) (by omega)","+    have := hi1 pl.internal c xi y l (by omega) hxi hc hxa hya hli hly hn hn2","+    rw [hmi] at this; cases this.1","+  have hdesc := hall l hl","+  cases hm : y.mode with","+  | modify =>","+    rw [effective_none_of_desc_modify hc hya hly hm hz] at hdesc; exact hdesc.elim","+  | observe =>","+    refine ⟨rfl, ?_⟩","+    cases m with","+    | observe => rfl","+    | modify => exact absurd hdesc (not_allows_modify_of_desc hc hya hly hz)","+","+/-- After `endUse p` (MM-03.3 §3, O12), a derived authority covering exactly the leaves of `p` is","+inactive: its precondition requires it held within `p` or by a holder that dies","+(`EndUseAccessOK`). -/","+theorem endUse_kills {k : K} {s : S3} {p x : Nat} {y : Authority} (hw : WF3 s)","+    (hpre : EndUsePre k s p) (hy : s.A[x]? = some y) (hor : y.active = true → y.origin ≠ none)","+    (hfp : ∀ l, l ∈ y.footprint ↔ l ∈ footprint s.P p) : ¬ (endUseEff s p).Active x := by","+  rintro ⟨y', hy', ya'⟩","+  obtain ⟨l, hl⟩ := exists_mem_footprint hw (s.P.length - p + 1) p (by omega) hpre.1.lt","+  have e1 : (endUseEff s p).A[x]? = ((s.A[x]?).map fun y =>","+      if heldIn s.P p y.holder then { y with active := false } else y).map","+      (fun y => if HolderLive (endUseS s p) y.holder then y else { y with active := false }) := by","+    show (cleanup (endUseS s p)).A[x]? = _","+    rw [cleanup_get, endUseS_get]","+  rw [e1, hy] at hy'","+  simp only [Option.map_some, Option.some.injEq] at hy'","+  subst hy'","+  have hacc := hpre.2.2.1 x (List.mem_range.2 (lt_of_getElem? hy))","+  simp only [EndUseAccessOK, hy, OptP] at hacc","+  by_cases hh : heldIn s.P p y.holder","+  · simp only [hh, ↓reduceIte] at ya'; split at ya' <;> simp at ya'","+  · simp only [hh, ↓reduceIte] at ya'","+    split at ya'","+    · rename_i hlive","+      rcases hacc ya' (hor ya') (.inl ⟨l, (hfp l).2 hl, .inl hl⟩) with h | h","+      · exact hh h","+      · exact h hlive","+    · simp at ya'","+","+theorem pinv_kernel {k : K} {ps : PS} {s' : S3} (hwf : PoolWF ps) (hns : NoStale ps)","+    (hce : CompExcl ps) (h : Step k ps.s s') :","+    PoolWF { ps with s := s' } ∧ NoStale { ps with s := s' } ∧ CompExcl { ps with s := s' } :=","+  ⟨hwf.transport (step_keeps h) (step_fp h) rfl, hns.transport hwf (step_keeps h),","+    hce.transport hwf (step_keeps h)⟩","+","+theorem pinv_newPool {ps ps' : PS} {st i : Nat} (hwf : PoolWF ps) (hns : NoStale ps)","+    (hce : CompExcl ps) (h : NewPoolStep st i ps (.ok ps')) :","+    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by","+  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h","+  obtain ⟨-, hu, hint, -⟩ := hpre","+  obtain ⟨h1, h2, h3, h4⟩ := hwf","+  have mem : ∀ pl ∈ ps.pools, pl ∈ (newPoolEff ps st i).pools := fun pl hpl =>","+    List.mem_append_left _ hpl","+  refine ⟨⟨fun pl hpl => ?_, ?_, fun pl hpl => ?_, fun r hr => ?_⟩, fun r hr e he ha => ?_, hce⟩","+  · rcases List.mem_append.1 hpl with hpl | hpl","+    · exact Nat.lt_succ_of_lt (h1 pl hpl)","+    · rw [List.mem_singleton.1 hpl]; exact Nat.lt_succ_self _","+  · simp only [newPoolEff, List.map_append, List.map_cons, List.map_nil]","+    refine List.nodup_append.2 ⟨h2, List.nodup_singleton _, fun a ha b hb => ?_⟩","+    rw [List.mem_singleton.1 hb]","+    obtain ⟨pl, hpl, rfl⟩ := List.mem_map.1 ha","+    exact Nat.ne_of_lt (h1 pl hpl)","+  · rcases List.mem_append.1 hpl with hpl | hpl","+    · exact h3 pl hpl","+    · rw [List.mem_singleton.1 hpl]","+      obtain ⟨y, hy, -, hm, -⟩ := optP_false_iff.1 hint","+      refine ⟨optP_false_iff.2 ⟨y, hy, hm⟩, hu.lt, fun sl hsl => ?_⟩","+      obtain ⟨q, hq, rfl⟩ := List.mem_map.1 hsl","+      exact (mem_kids.1 hq).1","+  · obtain ⟨pl, hpl, rest⟩ := h4 r hr","+    exact ⟨pl, mem pl hpl, rest⟩","+  · obtain ⟨pl, hpl, rest⟩ := hns r hr e he ha","+    exact ⟨pl, mem pl hpl, rest⟩","+","+theorem pinv_allocSlot {k : K} {ps ps' : PS} {j via dst : Nat} (hwf : PoolWF ps)","+    (hns : NoStale ps) (hce : CompExcl ps) (h : AllocSlotStep k j via dst ps (.ok ps')) :","+    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by","+  cases h with","+  | @ok pl i sl hpj _ hff hsl =>","+    have hshape := map_set_same Pool.shape hpj (setSlot_shape (x := { sl with live := true }) hsl rfl)","+    refine ⟨hwf.transport (.same rfl) (.same rfl) hshape, fun r hr e he ha => ?_,","+      hce.transport hwf (s' := write3Eff ps.s [dst]) (.same rfl)⟩","+    obtain ⟨pl0, hpl0, hid, sl0, hs0, hg, hlv⟩ := hns r hr e he ha","+    by_cases hp : pl0 = pl","+    · subst hp","+      refine ⟨_, mem_set_self' hpj, rfl, ?_⟩","+      by_cases hi : e.2.1 = i","+      · rw [hi, hsl] at hs0; cases hs0","+        rw [firstFree_free hff hsl] at hlv; cases hlv","+      · exact ⟨sl0, by simp only [setSlot]; rw [getElem?_set_ne' hi]; exact hs0, hg, hlv⟩","+    · exact ⟨pl0, mem_set_of_ne hpj hpl0 hp, hid, sl0, hs0, hg, hlv⟩","+","+theorem resolveS_comp (s : S3) (pl : Pool) (q : Nat) (m : Mode) :","+    (resolveS s pl q m).A[s.A.length]? =","+      some ⟨m, some pl.internal, footprint s.P pl.storage, .frame s.top, true⟩ := by","+  simp [resolveS, deriveEff, S3.addAuth]","+","+theorem resolveS_entry (s : S3) (pl : Pool) (q : Nat) (m : Mode) :","+    (resolveS s pl q m).A[s.A.length + 1]? =","+      some ⟨m, some s.A.length, footprint s.P q, .frame s.top, true⟩ := by","+  simp [resolveS, deriveEff, S3.addAuth, S3.top]","+","+theorem resolveManyS_comp (s : S3) (pl : Pool) (hs : List Handle) (m : Mode) :","+    (resolveManyS s pl hs m).A[s.A.length]? =","+      some ⟨m, some pl.internal, footprint s.P pl.storage, .frame s.top, true⟩ := by","+  simp [resolveManyS, splitEff, deriveEff, S3.addAuth]","+","+theorem mem_batchEntries' : ∀ {n : Nat} {hs : List Handle} {e : Nat × Nat × Nat},","+    e ∈ batchEntries n hs → ∃ i h, hs[i]? = some h ∧ e = (n + 1 + i, h.slot, h.gen)","+  | _, [], _, he => by simp [batchEntries, mapI] at he","+  | n, h :: hs, e, he => by","+    simp only [batchEntries, mapI, List.mem_cons] at he","+    rcases he with rfl | he","+    · exact ⟨0, h, rfl, rfl⟩","+    · obtain ⟨i, h', hh', rfl⟩ := mem_batchEntries' (n := n + 1) he","+      exact ⟨i + 1, h', by simpa using hh', by simp only [Prod.mk.injEq]; omega⟩","+","+theorem resolveManyS_entry (s : S3) (pl : Pool) (hs : List Handle) (m : Mode) {i : Nat}","+    {h : Handle} (hh : hs[i]? = some h) :","+    (resolveManyS s pl hs m).A[s.A.length + 1 + i]? =","+      some ⟨.modify, some s.A.length, footprint s.P (slotPlace pl h.slot), .frame s.top, true⟩ := by","+  simp only [resolveManyS, splitEff, deriveEff, S3.addAuth, batchRegions, S3.top]","+  rw [List.getElem?_append_right (by simp; omega)]","+  simp [hh]","+","+/-- Common part of `resolve` and `resolveMany`: a new resolution whose companion was derived from","+`internal` in `s` under `ResolveRight` keeps `CompExcl`. -/","+theorem compExcl_new {ps : PS} {s' : S3} {pl : Pool} {m : Mode} {rn : Res}","+    (hw : WF3 ps.s) (hi1 : I1 ps.s) (hwf : PoolWF ps) (hce : CompExcl ps) (hk : KeepsAuth ps.s s')","+    (hpl : pl ∈ ps.pools) (hR : ResolveRight ps.s pl m) (hrp : rn.pool = pl.id)","+    (hrc : rn.comp = ps.s.A.length) (hrm : rn.mode = m) :","+    CompExcl ⟨s', ps.pools, ps.nId, ps.res ++ [rn]⟩ := by","+  obtain ⟨-, h2, h3, h4⟩ := hwf","+  obtain ⟨xi, hxi, hmi⟩ := optP_false_iff.1 (h3 pl hpl).1","+  have key : ∀ r ∈ ps.res, r.pool = pl.id → ps.s.Active r.comp →","+      r.mode = .observe ∧ m = .observe := fun r hr hp ha => by","+    obtain ⟨pl0, hpl0, hid, hint, hlt, hc, -⟩ := h4 r hr","+    have e : pl0 = pl := eq_of_id_eq h2 hpl0 hpl (hid.trans hp)","+    subst e","+    obtain ⟨y, hy, hm, hfp⟩ := optP_false_iff.1 hc","+    obtain ⟨y', hy', ya⟩ := ha; rw [hy] at hy'; cases hy'","+    have := companion_blocks hw hi1 hR hxi hmi hy ya (hint ▸ hlt) hfp","+    exact ⟨hm ▸ this.1, this.2⟩","+  have lt : ∀ r ∈ ps.res, r.comp < ps.s.A.length := fun r hr => by","+    obtain ⟨_, _, _, _, _, hc, _⟩ := h4 r hr","+    obtain ⟨y, hy, -⟩ := optP_false_iff.1 hc","+    exact lt_of_getElem? hy","+  intro r₁ hr₁ r₂ hr₂ hp hne ha₁ ha₂","+  rcases List.mem_append.1 hr₁ with hr₁ | hr₁ <;> rcases List.mem_append.1 hr₂ with hr₂ | hr₂","+  · exact hce r₁ hr₁ r₂ hr₂ hp hne (hk.active (lt r₁ hr₁) ha₁) (hk.active (lt r₂ hr₂) ha₂)","+  · rw [List.mem_singleton.1 hr₂] at hp ⊢","+    have := key r₁ hr₁ (hp.trans hrp) (hk.active (lt r₁ hr₁) ha₁)","+    exact ⟨this.1, hrm.trans this.2⟩","+  · rw [List.mem_singleton.1 hr₁] at hp ⊢","+    have := key r₂ hr₂ (hp.symm.trans hrp) (hk.active (lt r₂ hr₂) ha₂)","+    exact ⟨hrm.trans this.2, this.1⟩","+  · rw [List.mem_singleton.1 hr₁, List.mem_singleton.1 hr₂] at hne; exact absurd rfl hne","+","+theorem pinv_resolve {ps ps' : PS} {j : Nat} {h : Handle} {m : Mode} (hw : WF3 ps.s)","+    (hi1 : I1 ps.s) (hwf : PoolWF ps) (hns : NoStale ps) (hce : CompExcl ps)","+    (hst : ResolveStep j h m ps (.ok ps')) : PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by","+  cases hst with","+  | @ok pl sl hpj hR hH hsl _ =>","+    have hpl : pl ∈ ps.pools := List.mem_of_getElem? hpj","+    have hk : KeepsAuth ps.s (resolveS ps.s pl sl.place m) := KeepsAuth.trans (.app rfl) (.app rfl)","+    have hwf' := hwf.transport hk (.same rfl) rfl","+    have hns' := hns.transport hwf hk","+    obtain ⟨hid, hsl'⟩ := hH","+    rw [hsl] at hsl'; obtain ⟨hg, hlv⟩ := hsl'","+    refine ⟨⟨hwf'.1, hwf'.2.1, hwf'.2.2.1, fun r hr => ?_⟩, fun r hr e he ha => ?_,","+      compExcl_new hw hi1 hwf hce hk hpl hR rfl rfl rfl⟩","+    · rcases List.mem_append.1 hr with hr | hr","+      · exact hwf'.2.2.2 r hr","+      · rw [List.mem_singleton.1 hr]","+        obtain ⟨y, hy, -⟩ := optP_false_iff.1 (hwf.2.2.1 pl hpl).1","+        refine ⟨pl, hpl, rfl, rfl, lt_of_getElem? hy, ?_, fun e he => ?_⟩","+        · rw [resolveS_comp]; exact ⟨rfl, fun _ => Iff.rfl⟩","+        · rw [List.mem_singleton.1 he]","+          refine ⟨sl, hsl, ?_⟩","+          rw [resolveS_entry]; exact ⟨fun _ => Iff.rfl, fun _ => by simp⟩","+    · rcases List.mem_append.1 hr with hr | hr","+      · exact hns' r hr e he ha","+      · rw [List.mem_singleton.1 hr] at he ⊢","+        rw [List.mem_singleton.1 he]","+        exact ⟨pl, hpl, rfl, sl, hsl, hg, hlv⟩","+","+theorem pinv_resolveMany {k : K} {ps ps' : PS} {j : Nat} {hs : List Handle} {m : Mode}","+    (hw : WF3 ps.s) (hi1 : I1 ps.s) (hwf : PoolWF ps) (hns : NoStale ps) (hce : CompExcl ps)","+    (hst : ResolveManyStep k j hs m ps (.ok ps')) : PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by","+  cases hst with","+  | @ok pl hpj hR hB _ =>","+    have hpl : pl ∈ ps.pools := List.mem_of_getElem? hpj","+    have hk : KeepsAuth ps.s (resolveManyS ps.s pl hs m) := KeepsAuth.trans (.app rfl) (.app rfl)","+    have hwf' := hwf.transport hk (.same rfl) rfl","+    have hns' := hns.transport hwf hk","+    have hok : ∀ h ∈ hs, ∃ sl, pl.slots[h.slot]? = some sl ∧ h.gen = sl.gen ∧ sl.live = true ∧","+        slotPlace pl h.slot = sl.place := fun h hh => by","+      obtain ⟨-, hsl⟩ := hB.1 h hh","+      obtain ⟨sl, hsl, hg, hlv⟩ := optP_false_iff.1 hsl","+      exact ⟨sl, hsl, hg.symm, hlv, by simp [slotPlace, hsl]⟩","+    refine ⟨⟨hwf'.1, hwf'.2.1, hwf'.2.2.1, fun r hr => ?_⟩, fun r hr e he ha => ?_,","+      compExcl_new hw hi1 hwf hce hk hpl hR rfl rfl rfl⟩","+    · rcases List.mem_append.1 hr with hr | hr","+      · exact hwf'.2.2.2 r hr","+      · rw [List.mem_singleton.1 hr]","+        obtain ⟨y, hy, -⟩ := optP_false_iff.1 (hwf.2.2.1 pl hpl).1","+        refine ⟨pl, hpl, rfl, rfl, lt_of_getElem? hy, ?_, fun e he => ?_⟩","+        · rw [resolveManyS_comp]; exact ⟨rfl, fun _ => Iff.rfl⟩","+        · obtain ⟨i, h, hh, rfl⟩ := mem_batchEntries' he","+          obtain ⟨sl, hsl, -, -, hp⟩ := hok h (List.mem_of_getElem? hh)","+          refine ⟨sl, hsl, ?_⟩","+          rw [resolveManyS_entry _ _ _ _ hh, hp]; exact ⟨fun _ => Iff.rfl, fun _ => by simp⟩","+    · rcases List.mem_append.1 hr with hr | hr","+      · exact hns' r hr e he ha","+      · rw [List.mem_singleton.1 hr] at he ⊢","+        obtain ⟨h, hh, e1, e2⟩ := mem_batchEntries he","+        obtain ⟨sl, hsl, hg, hlv, -⟩ := hok h hh","+        exact ⟨pl, hpl, rfl, sl, e1 ▸ hsl, e2 ▸ hg.symm, hlv⟩","+","+theorem pinv_unresolve {k : K} {ps ps' : PS} {c : Nat} (hwf : PoolWF ps) (hns : NoStale ps)","+    (hce : CompExcl ps) (h : UnresolveStep c ps (.ok ps')) :","+    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by","+  cases h with","+  | ok _ hr =>","+    have hss := releaseAll_steps (k := k) hr","+    exact ⟨hwf.transport hss.keeps hss.fp rfl, hns.transport hwf hss.keeps,","+      hce.transport hwf hss.keeps⟩","+","+theorem pinv_freeSlot {k : K} {ps ps' : PS} {j via : Nat} {h : Handle} (hw : WF3 ps.s)","+    (hwf : PoolWF ps) (hns : NoStale ps) (hce : CompExcl ps)","+    (hst : FreeSlotStep k j via h ps (.ok ps')) : PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by","+  cases hst with","+  | @ok pl sl hpj _ _ hsl _ hE =>","+    have hstep : Step k ps.s (endUseEff ps.s sl.place) := .kernel (.endUse (Guarded.ok hE))","+    have hk := step_keeps hstep","+    have hshape := map_set_same Pool.shape hpj","+      (setSlot_shape (x := ⟨sl.place, sl.gen + 1, false⟩) hsl rfl)","+    refine ⟨hwf.transport hk (step_fp hstep) hshape, fun r hr e he ha => ?_,","+      hce.transport hwf hk⟩","+    have hpl : pl ∈ ps.pools := List.mem_of_getElem? hpj","+    obtain ⟨_, _, _, _, _, hc, hen⟩ := hwf.2.2.2 r hr","+    obtain ⟨_, _, ho⟩ := hen e he","+    obtain ⟨y, hy, -⟩ := optP_false_iff.1 ho","+    obtain ⟨pl0, hpl0, hid, sl0, hs0, hg, hlv⟩ := hns r hr e he (hk.active (lt_of_getElem? hy) ha)","+    by_cases hp : pl0 = pl","+    · subst hp","+      refine ⟨_, mem_set_self' hpj, rfl, ?_⟩","+      by_cases hi : e.2.1 = h.slot","+      · exfalso","+        obtain ⟨pl1, hpl1, hid1, -, -, -, hen1⟩ := hwf.2.2.2 r hr","+        have e1 : pl1 = pl0 := eq_of_id_eq hwf.2.1 hpl1 hpl0 (hid1.trans hid.symm)","+        subst e1","+        obtain ⟨sl1, hs1, ho1⟩ := hen1 e he","+        rw [hi, hsl] at hs1; cases hs1","+        obtain ⟨y1, hy1, hfp1, hor1⟩ := optP_false_iff.1 ho1","+        exact endUse_kills hw hE hy1 hor1 hfp1 ha","+      · exact ⟨sl0, by simp only [setSlot]; rw [getElem?_set_ne' hi]; exact hs0, hg, hlv⟩","+    · exact ⟨pl0, mem_set_of_ne hpj hpl0 hp, hid, sl0, hs0, hg, hlv⟩","+","+/-- Every pool step keeps the invariants of the pool layer. -/","+theorem pstep_inv {k : K} {ps ps' : PS} (hw : WF3 ps.s) (hi1 : I1 ps.s) (hwf : PoolWF ps)","+    (hns : NoStale ps) (hce : CompExcl ps) (h : PStep k ps ps') :","+    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by","+  cases h with","+  | kernel h => exact pinv_kernel hwf hns hce h","+  | newPool h => exact pinv_newPool hwf hns hce h","+  | allocSlot h => exact pinv_allocSlot hwf hns hce h","+  | resolve h => exact pinv_resolve hw hi1 hwf hns hce h","+  | resolveMany h => exact pinv_resolveMany hw hi1 hwf hns hce h","+  | unresolve h => exact pinv_unresolve (k := k) hwf hns hce h","+  | freeSlot h => exact pinv_freeSlot hw hwf hns hce h","+","+/-- Invariants of the states reached with pool steps (material §4), under `DDSound k`","+(MM-03.3.8): the kernel state is reached (`pReach_reachable`), the pool layer is well formed,","+no entry authority is stale and the companions are exclusive. -/","+theorem pReach_inv {k : K} (hdd : DDSound k) {statics : Statics} {ps : PS}","+    (h : PReach k statics ps) :","+    Reachable k statics ps.s ∧ PoolWF ps ∧ NoStale ps ∧ CompExcl ps := by","+  induction h with","+  | init hsh =>","+    refine ⟨.init hsh, ⟨?_, ?_, ?_, ?_⟩, ?_, ?_⟩ <;> simp [PS.init, NoStale, CompExcl]","+  | step _ hs ih =>","+    obtain ⟨hr, hwf, hns, hce⟩ := ih","+    obtain ⟨hw, hinv, -⟩ := reachable_invariants hdd hr","+    exact ⟨reachable_steps hr (pstep_steps hw hinv.1.2.2.1 hs),","+      pstep_inv hw hinv.1.1 hwf hns hce hs⟩","+"," end Ern.HandlePool"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/HandlePool.lean"]}},"serverClassifierContext":{"request":"cd05dace-6c46-4613-ab3d-00d62e19c7f9","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/validation_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"b6cf28e8-2df6-4283-97c7-6b7026572711","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/validation_0.1","slug":"effervescent-gathering-wind"}
{"type":"api-request-blob","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","hash":"f30884e26062f6e6da9c138edef62365a980f3dfb36e4c85a387ce95f3bbe2d4","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Transport lemmas compile. Now the per-operation preservation proofs and the main induction."},{"type":"tool_use","id":"toolu_01TEhCsLtmkADoGoQukydQHB","name":"Bash","input":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && python3 - <<'EOF'\np='Ern/HandlePool.lean'\ns=open(p).read()\nadd=r'''\n/-! ## Preservation by each step -/\n\n/-- An active descendant of `z` covering `l` takes the effective `Modify` on `l` away from `z`\n(MM-03.3.5, cases 3 and 4). -/\ntheorem not_allows_modify_of_desc {s : S3} {j z l : Nat} {y : Authority}\n    (hy : s.A[j]? = some y) (ya : y.active = true) (hl : l ∈ y.footprint)\n    (hz : z ∈ s.ancs j) : ¬ Allows (effective s z l) .modify := by\n  have hd : y.mode ∈ descModes s z l := mem_descModes.2 ⟨j, y, hy, ya, hl, hz, rfl⟩\n  have hne : descModes s z l ≠ [] := fun h => by rw [h] at hd; cases hd\n  unfold effective\n  split\n  · split\n    · simp only [effOf, hne, ↓reduceIte]\n      split\n      · exact id\n      · intro h; rcases h with h | h <;> cases h\n    · exact id\n  · exact id\n\n/-- At the creation of a companion (material §4, `resolve`), every active companion of the same\npool and the new one are both `Observe`: an active companion is unrelated to `internal`, which I1\nexcludes since `internal` is `Modify`, or descends from it, which takes away the effective mode\nthat the `derive` of the new companion requires (MM-03.3.5; MM-03.3 §2, I1; O1). -/\ntheorem companion_blocks {s : S3} (hw : WF3 s) (hi1 : I1 s) {pl : Pool} {m : Mode}\n    (hR : ResolveRight s pl m) {xi : Authority} (hxi : s.A[pl.internal]? = some xi)\n    (hmi : xi.mode = .modify) {c : Nat} {y : Authority} (hc : s.A[c]? = some y)\n    (hya : y.active = true) (hlt : pl.internal < c)\n    (hfp : ∀ l, l ∈ y.footprint ↔ l ∈ footprint s.P pl.storage) :\n    y.mode = .observe ∧ m = .observe := by\n  obtain ⟨hact, -, hus, hsub, hall⟩ := hR\n  obtain ⟨l, hl⟩ := exists_mem_footprint hw (s.P.length - pl.storage + 1) pl.storage (by omega)\n    hus.lt\n  have hli : l ∈ xi.footprint := by have := hsub l hl; simpa [S3.afp, hxi] using this\n  have hxa : xi.active = true := by\n    obtain ⟨z, hz, za⟩ := hact; rw [hxi] at hz; cases hz; exact za\n  have hly : l ∈ y.footprint := (hfp l).2 hl\n  have hz : pl.internal ∈ s.ancs c := Decidable.byContradiction fun hn => by\n    have hn2 : c ∉ s.ancs pl.internal := fun h => absurd (chain_lt h) (by omega)\n    have := hi1 pl.internal c xi y l (by omega) hxi hc hxa hya hli hly hn hn2\n    rw [hmi] at this; cases this.1\n  have hdesc := hall l hl\n  cases hm : y.mode with\n  | modify =>\n    rw [effective_none_of_desc_modify hc hya hly hm hz] at hdesc; exact hdesc.elim\n  | observe =>\n    refine ⟨rfl, ?_⟩\n    cases m with\n    | observe => rfl\n    | modify => exact absurd hdesc (not_allows_modify_of_desc hc hya hly hz)\n\n/-- After `endUse p` (MM-03.3 §3, O12), a derived authority covering exactly the leaves of `p` is\ninactive: its precondition requires it held within `p` or by a holder that dies\n(`EndUseAccessOK`). -/\ntheorem endUse_kills {k : K} {s : S3} {p x : Nat} {y : Authority} (hw : WF3 s)\n    (hpre : EndUsePre k s p) (hy : s.A[x]? = some y) (hor : y.active = true → y.origin ≠ none)\n    (hfp : ∀ l, l ∈ y.footprint ↔ l ∈ footprint s.P p) : ¬ (endUseEff s p).Active x := by\n  rintro ⟨y', hy', ya'⟩\n  obtain ⟨l, hl⟩ := exists_mem_footprint hw (s.P.length - p + 1) p (by omega) hpre.1.lt\n  have e1 : (endUseEff s p).A[x]? = ((s.A[x]?).map fun y =>\n      if heldIn s.P p y.holder then { y with active := false } else y).map\n      (fun y => if HolderLive (endUseS s p) y.holder then y else { y with active := false }) := by\n    show (cleanup (endUseS s p)).A[x]? = _\n    rw [cleanup_get, endUseS_get]\n  rw [e1, hy] at hy'\n  simp only [Option.map_some, Option.some.injEq] at hy'\n  subst hy'\n  have hacc := hpre.2.2.1 x (List.mem_range.2 (lt_of_getElem? hy))\n  simp only [EndUseAccessOK, hy, OptP] at hacc\n  by_cases hh : heldIn s.P p y.holder\n  · simp only [hh, ↓reduceIte] at ya'; split at ya' <;> simp at ya'\n  · simp only [hh, ↓reduceIte] at ya'\n    split at ya'\n    · rename_i hlive\n      rcases hacc ya' (hor ya') (.inl ⟨l, (hfp l).2 hl, .inl hl⟩) with h | h\n      · exact hh h\n      · exact h hlive\n    · simp at ya'\n\ntheorem pinv_kernel {k : K} {ps : PS} {s' : S3} (hwf : PoolWF ps) (hns : NoStale ps)\n    (hce : CompExcl ps) (h : Step k ps.s s') :\n    PoolWF { ps with s := s' } ∧ NoStale { ps with s := s' } ∧ CompExcl { ps with s := s' } :=\n  ⟨hwf.transport (step_keeps h) (step_fp h) rfl, hns.transport hwf (step_keeps h),\n    hce.transport hwf (step_keeps h)⟩\n\ntheorem pinv_newPool {ps ps' : PS} {st i : Nat} (hwf : PoolWF ps) (hns : NoStale ps)\n    (hce : CompExcl ps) (h : NewPoolStep st i ps (.ok ps')) :\n    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by\n  obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h\n  obtain ⟨-, hu, hint, -⟩ := hpre\n  obtain ⟨h1, h2, h3, h4⟩ := hwf\n  have mem : ∀ pl ∈ ps.pools, pl ∈ (newPoolEff ps st i).pools := fun pl hpl =>\n    List.mem_append_left _ hpl\n  refine ⟨⟨fun pl hpl => ?_, ?_, fun pl hpl => ?_, fun r hr => ?_⟩, fun r hr e he ha => ?_, hce⟩\n  · rcases List.mem_append.1 hpl with hpl | hpl\n    · exact Nat.lt_succ_of_lt (h1 pl hpl)\n    · rw [List.mem_singleton.1 hpl]; exact Nat.lt_succ_self _\n  · simp only [newPoolEff, List.map_append, List.map_cons, List.map_nil]\n    refine List.nodup_append.2 ⟨h2, List.nodup_singleton _, fun a ha b hb => ?_⟩\n    rw [List.mem_singleton.1 hb]\n    obtain ⟨pl, hpl, rfl⟩ := List.mem_map.1 ha\n    exact Nat.ne_of_lt (h1 pl hpl)\n  · rcases List.mem_append.1 hpl with hpl | hpl\n    · exact h3 pl hpl\n    · rw [List.mem_singleton.1 hpl]\n      obtain ⟨y, hy, -, hm, -⟩ := optP_false_iff.1 hint\n      refine ⟨optP_false_iff.2 ⟨y, hy, hm⟩, hu.lt, fun sl hsl => ?_⟩\n      obtain ⟨q, hq, rfl⟩ := List.mem_map.1 hsl\n      exact (mem_kids.1 hq).1\n  · obtain ⟨pl, hpl, rest⟩ := h4 r hr\n    exact ⟨pl, mem pl hpl, rest⟩\n  · obtain ⟨pl, hpl, rest⟩ := hns r hr e he ha\n    exact ⟨pl, mem pl hpl, rest⟩\n\ntheorem pinv_allocSlot {k : K} {ps ps' : PS} {j via dst : Nat} (hwf : PoolWF ps)\n    (hns : NoStale ps) (hce : CompExcl ps) (h : AllocSlotStep k j via dst ps (.ok ps')) :\n    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by\n  cases h with\n  | @ok pl i sl hpj _ hff hsl =>\n    have hshape := map_set_same Pool.shape hpj (setSlot_shape (x := { sl with live := true }) hsl rfl)\n    refine ⟨hwf.transport (.same rfl) (.same rfl) hshape, fun r hr e he ha => ?_,\n      hce.transport hwf (s' := write3Eff ps.s [dst]) (.same rfl)⟩\n    obtain ⟨pl0, hpl0, hid, sl0, hs0, hg, hlv⟩ := hns r hr e he ha\n    by_cases hp : pl0 = pl\n    · subst hp\n      refine ⟨_, mem_set_self' hpj, rfl, ?_⟩\n      by_cases hi : e.2.1 = i\n      · rw [hi, hsl] at hs0; cases hs0\n        rw [firstFree_free hff hsl] at hlv; cases hlv\n      · exact ⟨sl0, by simp only [setSlot]; rw [getElem?_set_ne' hi]; exact hs0, hg, hlv⟩\n    · exact ⟨pl0, mem_set_of_ne hpj hpl0 hp, hid, sl0, hs0, hg, hlv⟩\n\ntheorem resolveS_comp (s : S3) (pl : Pool) (q : Nat) (m : Mode) :\n    (resolveS s pl q m).A[s.A.length]? =\n      some ⟨m, some pl.internal, footprint s.P pl.storage, .frame s.top, true⟩ := by\n  simp [resolveS, deriveEff, S3.addAuth]\n\ntheorem resolveS_entry (s : S3) (pl : Pool) (q : Nat) (m : Mode) :\n    (resolveS s pl q m).A[s.A.length + 1]? =\n      some ⟨m, some s.A.length, footprint s.P q, .frame s.top, true⟩ := by\n  simp [resolveS, deriveEff, S3.addAuth, S3.top]\n\ntheorem resolveManyS_comp (s : S3) (pl : Pool) (hs : List Handle) (m : Mode) :\n    (resolveManyS s pl hs m).A[s.A.length]? =\n      some ⟨m, some pl.internal, footprint s.P pl.storage, .frame s.top, true⟩ := by\n  simp [resolveManyS, splitEff, deriveEff, S3.addAuth]\n\ntheorem mem_batchEntries' : ∀ {n : Nat} {hs : List Handle} {e : Nat × Nat × Nat},\n    e ∈ batchEntries n hs → ∃ i h, hs[i]? = some h ∧ e = (n + 1 + i, h.slot, h.gen)\n  | _, [], _, he => by simp [batchEntries, mapI] at he\n  | n, h :: hs, e, he => by\n    simp only [batchEntries, mapI, List.mem_cons] at he\n    rcases he with rfl | he\n    · exact ⟨0, h, rfl, rfl⟩\n    · obtain ⟨i, h', hh', rfl⟩ := mem_batchEntries' (n := n + 1) he\n      exact ⟨i + 1, h', by simpa using hh', by simp only [Prod.mk.injEq]; omega⟩\n\ntheorem resolveManyS_entry (s : S3) (pl : Pool) (hs : List Handle) (m : Mode) {i : Nat}\n    {h : Handle} (hh : hs[i]? = some h) :\n    (resolveManyS s pl hs m).A[s.A.length + 1 + i]? =\n      some ⟨.modify, some s.A.length, footprint s.P (slotPlace pl h.slot), .frame s.top, true⟩ := by\n  simp only [resolveManyS, splitEff, deriveEff, S3.addAuth, batchRegions, S3.top]\n  rw [List.getElem?_append_right (by simp; omega)]\n  simp [hh]\n\n/-- Common part of `resolve` and `resolveMany`: a new resolution whose companion was derived from\n`internal` in `s` under `ResolveRight` keeps `CompExcl`. -/\ntheorem compExcl_new {ps : PS} {s' : S3} {pl : Pool} {m : Mode} {rn : Res}\n    (hw : WF3 ps.s) (hi1 : I1 ps.s) (hwf : PoolWF ps) (hce : CompExcl ps) (hk : KeepsAuth ps.s s')\n    (hpl : pl ∈ ps.pools) (hR : ResolveRight ps.s pl m) (hrp : rn.pool = pl.id)\n    (hrc : rn.comp = ps.s.A.length) (hrm : rn.mode = m) :\n    CompExcl ⟨s', ps.pools, ps.nId, ps.res ++ [rn]⟩ := by\n  obtain ⟨-, h2, h3, h4⟩ := hwf\n  obtain ⟨xi, hxi, hmi⟩ := optP_false_iff.1 (h3 pl hpl).1\n  have key : ∀ r ∈ ps.res, r.pool = pl.id → ps.s.Active r.comp →\n      r.mode = .observe ∧ m = .observe := fun r hr hp ha => by\n    obtain ⟨pl0, hpl0, hid, hint, hlt, hc, -⟩ := h4 r hr\n    have e : pl0 = pl := eq_of_id_eq h2 hpl0 hpl (hid.trans hp)\n    subst e\n    obtain ⟨y, hy, hm, hfp⟩ := optP_false_iff.1 hc\n    obtain ⟨y', hy', ya⟩ := ha; rw [hy] at hy'; cases hy'\n    have := companion_blocks hw hi1 hR hxi hmi hy ya (hint ▸ hlt) hfp\n    exact ⟨hm ▸ this.1, this.2⟩\n  have lt : ∀ r ∈ ps.res, r.comp < ps.s.A.length := fun r hr => by\n    obtain ⟨_, _, _, _, _, hc, _⟩ := h4 r hr\n    obtain ⟨y, hy, -⟩ := optP_false_iff.1 hc\n    exact lt_of_getElem? hy\n  intro r₁ hr₁ r₂ hr₂ hp hne ha₁ ha₂\n  rcases List.mem_append.1 hr₁ with hr₁ | hr₁ <;> rcases List.mem_append.1 hr₂ with hr₂ | hr₂\n  · exact hce r₁ hr₁ r₂ hr₂ hp hne (hk.active (lt r₁ hr₁) ha₁) (hk.active (lt r₂ hr₂) ha₂)\n  · rw [List.mem_singleton.1 hr₂] at hp ⊢\n    have := key r₁ hr₁ (hp.trans hrp) (hk.active (lt r₁ hr₁) ha₁)\n    exact ⟨this.1, hrm.trans this.2⟩\n  · rw [List.mem_singleton.1 hr₁] at hp ⊢\n    have := key r₂ hr₂ (hp.symm.trans hrp) (hk.active (lt r₂ hr₂) ha₂)\n    exact ⟨hrm.trans this.2, this.1⟩\n  · rw [List.mem_singleton.1 hr₁, List.mem_singleton.1 hr₂] at hne; exact absurd rfl hne\n\ntheorem pinv_resolve {ps ps' : PS} {j : Nat} {h : Handle} {m : Mode} (hw : WF3 ps.s)\n    (hi1 : I1 ps.s) (hwf : PoolWF ps) (hns : NoStale ps) (hce : CompExcl ps)\n    (hst : ResolveStep j h m ps (.ok ps')) : PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by\n  cases hst with\n  | @ok pl sl hpj hR hH hsl _ =>\n    have hpl : pl ∈ ps.pools := List.mem_of_getElem? hpj\n    have hk : KeepsAuth ps.s (resolveS ps.s pl sl.place m) := KeepsAuth.trans (.app rfl) (.app rfl)\n    have hwf' := hwf.transport hk (.same rfl) rfl\n    have hns' := hns.transport hwf hk\n    obtain ⟨hid, hsl'⟩ := hH\n    rw [hsl] at hsl'; obtain ⟨hg, hlv⟩ := hsl'\n    refine ⟨⟨hwf'.1, hwf'.2.1, hwf'.2.2.1, fun r hr => ?_⟩, fun r hr e he ha => ?_,\n      compExcl_new hw hi1 hwf hce hk hpl hR rfl rfl rfl⟩\n    · rcases List.mem_append.1 hr with hr | hr\n      · exact hwf'.2.2.2 r hr\n      · rw [List.mem_singleton.1 hr]\n        obtain ⟨y, hy, -⟩ := optP_false_iff.1 (hwf.2.2.1 pl hpl).1\n        refine ⟨pl, hpl, rfl, rfl, lt_of_getElem? hy, ?_, fun e he => ?_⟩\n        · rw [resolveS_comp]; exact ⟨rfl, fun _ => Iff.rfl⟩\n        · rw [List.mem_singleton.1 he]\n          refine ⟨sl, hsl, ?_⟩\n          rw [resolveS_entry]; exact ⟨fun _ => Iff.rfl, fun _ => by simp⟩\n    · rcases List.mem_append.1 hr with hr | hr\n      · exact hns' r hr e he ha\n      · rw [List.mem_singleton.1 hr] at he ⊢\n        rw [List.mem_singleton.1 he]\n        exact ⟨pl, hpl, rfl, sl, hsl, hg, hlv⟩\n\ntheorem pinv_resolveMany {k : K} {ps ps' : PS} {j : Nat} {hs : List Handle} {m : Mode}\n    (hw : WF3 ps.s) (hi1 : I1 ps.s) (hwf : PoolWF ps) (hns : NoStale ps) (hce : CompExcl ps)\n    (hst : ResolveManyStep k j hs m ps (.ok ps')) : PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by\n  cases hst with\n  | @ok pl hpj hR hB _ =>\n    have hpl : pl ∈ ps.pools := List.mem_of_getElem? hpj\n    have hk : KeepsAuth ps.s (resolveManyS ps.s pl hs m) := KeepsAuth.trans (.app rfl) (.app rfl)\n    have hwf' := hwf.transport hk (.same rfl) rfl\n    have hns' := hns.transport hwf hk\n    have hok : ∀ h ∈ hs, ∃ sl, pl.slots[h.slot]? = some sl ∧ h.gen = sl.gen ∧ sl.live = true ∧\n        slotPlace pl h.slot = sl.place := fun h hh => by\n      obtain ⟨-, hsl⟩ := hB.1 h hh\n      obtain ⟨sl, hsl, hg, hlv⟩ := optP_false_iff.1 hsl\n      exact ⟨sl, hsl, hg.symm, hlv, by simp [slotPlace, hsl]⟩\n    refine ⟨⟨hwf'.1, hwf'.2.1, hwf'.2.2.1, fun r hr => ?_⟩, fun r hr e he ha => ?_,\n      compExcl_new hw hi1 hwf hce hk hpl hR rfl rfl rfl⟩\n    · rcases List.mem_append.1 hr with hr | hr\n      · exact hwf'.2.2.2 r hr\n      · rw [List.mem_singleton.1 hr]\n        obtain ⟨y, hy, -⟩ := optP_false_iff.1 (hwf.2.2.1 pl hpl).1\n        refine ⟨pl, hpl, rfl, rfl, lt_of_getElem? hy, ?_, fun e he => ?_⟩\n        · rw [resolveManyS_comp]; exact ⟨rfl, fun _ => Iff.rfl⟩\n        · obtain ⟨i, h, hh, rfl⟩ := mem_batchEntries' he\n          obtain ⟨sl, hsl, -, -, hp⟩ := hok h (List.mem_of_getElem? hh)\n          refine ⟨sl, hsl, ?_⟩\n          rw [resolveManyS_entry _ _ _ _ hh, hp]; exact ⟨fun _ => Iff.rfl, fun _ => by simp⟩\n    · rcases List.mem_append.1 hr with hr | hr\n      · exact hns' r hr e he ha\n      · rw [List.mem_singleton.1 hr] at he ⊢\n        obtain ⟨h, hh, e1, e2⟩ := mem_batchEntries he\n        obtain ⟨sl, hsl, hg, hlv, -⟩ := hok h hh\n        exact ⟨pl, hpl, rfl, sl, e1 ▸ hsl, e2 ▸ hg.symm, hlv⟩\n\ntheorem pinv_unresolve {k : K} {ps ps' : PS} {c : Nat} (hwf : PoolWF ps) (hns : NoStale ps)\n    (hce : CompExcl ps) (h : UnresolveStep c ps (.ok ps')) :\n    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by\n  cases h with\n  | ok _ hr =>\n    have hss := releaseAll_steps (k := k) hr\n    exact ⟨hwf.transport hss.keeps hss.fp rfl, hns.transport hwf hss.keeps,\n      hce.transport hwf hss.keeps⟩\n\ntheorem pinv_freeSlot {k : K} {ps ps' : PS} {j via : Nat} {h : Handle} (hw : WF3 ps.s)\n    (hwf : PoolWF ps) (hns : NoStale ps) (hce : CompExcl ps)\n    (hst : FreeSlotStep k j via h ps (.ok ps')) : PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by\n  cases hst with\n  | @ok pl sl hpj _ _ hsl _ hE =>\n    have hstep : Step k ps.s (endUseEff ps.s sl.place) := .kernel (.endUse (Guarded.ok hE))\n    have hk := step_keeps hstep\n    have hshape := map_set_same Pool.shape hpj\n      (setSlot_shape (x := ⟨sl.place, sl.gen + 1, false⟩) hsl rfl)\n    refine ⟨hwf.transport hk (step_fp hstep) hshape, fun r hr e he ha => ?_,\n      hce.transport hwf hk⟩\n    have hpl : pl ∈ ps.pools := List.mem_of_getElem? hpj\n    obtain ⟨_, _, _, _, _, hc, hen⟩ := hwf.2.2.2 r hr\n    obtain ⟨_, _, ho⟩ := hen e he\n    obtain ⟨y, hy, -⟩ := optP_false_iff.1 ho\n    obtain ⟨pl0, hpl0, hid, sl0, hs0, hg, hlv⟩ := hns r hr e he (hk.active (lt_of_getElem? hy) ha)\n    by_cases hp : pl0 = pl\n    · subst hp\n      refine ⟨_, mem_set_self' hpj, rfl, ?_⟩\n      by_cases hi : e.2.1 = h.slot\n      · exfalso\n        obtain ⟨pl1, hpl1, hid1, -, -, -, hen1⟩ := hwf.2.2.2 r hr\n        have e1 : pl1 = pl0 := eq_of_id_eq hwf.2.1 hpl1 hpl0 (hid1.trans hid.symm)\n        subst e1\n        obtain ⟨sl1, hs1, ho1⟩ := hen1 e he\n        rw [hi, hsl] at hs1; cases hs1\n        obtain ⟨y1, hy1, hfp1, hor1⟩ := optP_false_iff.1 ho1\n        exact endUse_kills hw hE hy1 hor1 hfp1 ha\n      · exact ⟨sl0, by simp only [setSlot]; rw [getElem?_set_ne' hi]; exact hs0, hg, hlv⟩\n    · exact ⟨pl0, mem_set_of_ne hpj hpl0 hp, hid, sl0, hs0, hg, hlv⟩\n\n/-- Every pool step keeps the invariants of the pool layer. -/\ntheorem pstep_inv {k : K} {ps ps' : PS} (hw : WF3 ps.s) (hi1 : I1 ps.s) (hwf : PoolWF ps)\n    (hns : NoStale ps) (hce : CompExcl ps) (h : PStep k ps ps') :\n    PoolWF ps' ∧ NoStale ps' ∧ CompExcl ps' := by\n  cases h with\n  | kernel h => exact pinv_kernel hwf hns hce h\n  | newPool h => exact pinv_newPool hwf hns hce h\n  | allocSlot h => exact pinv_allocSlot hwf hns hce h\n  | resolve h => exact pinv_resolve hw hi1 hwf hns hce h\n  | resolveMany h => exact pinv_resolveMany hw hi1 hwf hns hce h\n  | unresolve h => exact pinv_unresolve (k := k) hwf hns hce h\n  | freeSlot h => exact pinv_freeSlot hw hwf hns hce h\n\n/-- Invariants of the states reached with pool steps (material §4), under `DDSound k`\n(MM-03.3.8): the kernel state is reached (`pReach_reachable`), the pool layer is well formed,\nno entry authority is stale and the companions are exclusive. -/\ntheorem pReach_inv {k : K} (hdd : DDSound k) {statics : Statics} {ps : PS}\n    (h : PReach k statics ps) :\n    Reachable k statics ps.s ∧ PoolWF ps ∧ NoStale ps ∧ CompExcl ps := by\n  induction h with\n  | init hsh =>\n    refine ⟨.init hsh, ⟨?_, ?_, ?_, ?_⟩, ?_, ?_⟩ <;> simp [PS.init, NoStale, CompExcl]\n  | step _ hs ih =>\n    obtain ⟨hr, hwf, hns, hce⟩ := ih\n    obtain ⟨hw, hinv, -⟩ := reachable_invariants hdd hr\n    exact ⟨reachable_steps hr (pstep_steps hw hinv.1.2.2.1 hs),\n      pstep_inv hw hinv.1.1 hwf hns hce hs⟩\n\n'''\ns=s.replace('\\nend Ern.HandlePool\\n', add+'end Ern.HandlePool\\n')\nopen(p,'w').write(s)\nEOF\ntime ~/.elan/bin/lake env lean Ern/HandlePool.lean 2>&1 | head -70","description":"Add per-operation preservation and main induction","timeout":600000},"caller":{"type":"direct"}}]}}
