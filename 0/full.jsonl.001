j y' _ hy' hj hyo)","     · exact .inr (.inl ⟨hj, o, ho, hc⟩)"," ","+/-- The source condition carries over a phase that creates no authority and keeps every origin. -/","+theorem src_carry {s s₁ s₂ : SC} {reg : SyncReg}","+    (hsrc : ∀ e ∈ reg, e.Live s → ∀ j y' o, s₁.A[j]? = some y' → s.A.length ≤ j →","+      y'.origin = some o → o ≠ e.guarded)","+    (hlen : s₂.A.length = s₁.A.length) (horg : ∀ i, s₂.flat.org i = s₁.flat.org i) :","+    ∀ e ∈ reg, e.Live s → ∀ j y'' o, s₂.A[j]? = some y'' → s.A.length ≤ j →","+      y''.origin = some o → o ≠ e.guarded := by","+  intro e he hl j y'' o hy'' hj ho","+  obtain ⟨y', hy'⟩ := getElem?_of_lt (show j < s₁.A.length by","+    have := lt_of_getElem? hy''; omega)","+  have h := horg j","+  simp only [S3.org] at h","+  have e1 : s₂.flat.A[j]? = some y'' := hy''","+  have e2 : s₁.flat.A[j]? = some y' := hy'","+  rw [e1, e2] at h","+  simp only [Option.bind_some] at h","+  exact hsrc e he hl j y' o hy' hj (h ▸ ho)","+","+/-- `store` executed by `c` of an authority held by the current frame (Spec 1 §65.1) is a step","+read through `Skel`. -/","+theorem store_skel' {s : SC} {c a p : Nat}","+    (hd : OptP ((s.view c).A[a]?) (fun y => y.active = true ∧ y.origin ≠ none ∧","+      y.holder = .frame (s.view c).top) False) : Skel s (storeEffC s c a p) := by","+  unfold OptP at hd","+  split at hd","+  · rename_i y hy","+    have hy' : s.A[a]? = some y := hy","+    have hA : (storeEffC s c a p).A = s.A.set a { y with holder := .place p } := by","+      show (storeEff (s.view c) a p).A = _; simp [storeEff, hy]; rfl","+    exact (skel_set hy' hA ⟨rfl, rfl, rfl, id, fun q hq => by rw [hd.2.2] at hq; cases hq⟩).1","+  · exact hd.elim","+","+/-- `release` executed by `c` of an existing authority (Spec 1 §62) is a step read through","+`Skel`. -/","+theorem release_skel' {t : SC} {c a : Nat} {x : Authority} (hx : t.A[a]? = some x) :","+    Skel t (t.set (releaseEff (t.view c) a)) := by","+  have hx' : (t.view c).A[a]? = some x := hx","+  have hA : (t.set (releaseEff (t.view c) a)).A = t.A.set a { x with active := false } := by","+    show (releaseEff (t.view c) a).A = _; rw [releaseEff_eq hx']; rfl","+  exact (skel_set hx hA (same_deact x)).1","+","+/-- Brief of the complement, task 2, step form: an `ok` step admitted by `Encap` (WC5.2 C22 items","+1–3, 5), from a state satisfying `KInvCA` and the separation of the registries (`AdminSep`, Spec 1","+§56, WC5.2 C13 item 7), satisfies the closure. -/","+theorem closure_step {k : K} {L : MutexLayout} {st st' : SC × SyncReg × ArenaReg} {lbl : Label}","+    (hk : KInvCA st.1) (hsep : AdminSep st.1 st.2.1 st.2.2) (he : Encap L (st.1, st.2.1) lbl)","+    (hs : LStep k L lbl st st') : ClosureStep st lbl st' := by","+  have hw : WF3 st.1.flat := hk.1.1.2","+  cases hs with","+  | @kernel s s' reg ar c op h =>","+    cases op","+    case transfer src dst =>","+      obtain ⟨-, h'⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h'","+      obtain ⟨hsk, hlen, -⟩ := transfer_skel s c src dst","+      exact closure_of_skel hsk (src_none hlen)","+    all_goals","+      have hf := opStep_facts (reg := reg) h he (fun _ _ h => by cases h) hw","+      exact closure_of_skel hf.skel hf.src","+  | @spawn s s' reg ar c ps ls h =>","+    obtain ⟨-, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'","+    have hf := spawnEff_facts (reg := reg) hpre.params hpre.localsOK","+    exact closure_of_skel hf.skel hf.src","+  | @terminate s s' reg ar c h =>","+    have hf := term_facts (reg := reg) hw h","+    exact closure_of_skel hf.skel hf.src","+  | @join s s' reg ar c d h =>","+    have hf := join_facts (reg := reg) h","+    exact closure_of_skel hf.skel hf.src","+  | deriveSync h => exact (deriveSync_excluded h he).elim","+  | newMutex h =>","+    obtain ⟨-, -, rfl⟩ := h","+    exact closure_of_skel (skel_refl _) (src_none rfl)","+  | @acquire s reg ar c i st₁ h =>","+    obtain ⟨-, e₀, hi, -, hpre, rfl⟩ := h","+    have hA : (deriveSyncEff s c e₀.guarded).A = s.A ++ [⟨.modify, some e₀.guarded,","+        (s.view c).afp e₀.guarded, .frame (s.view c).top, true⟩] := rfl","+    obtain ⟨hsk, -⟩ := skel_append hA rfl (fun j y' hy' => ⟨y', hy', Same.refl _⟩) fun z hz => by","+      rw [List.mem_singleton] at hz; subst hz","+      exact .inr ⟨e₀.guarded, rfl, active_lt hpre.active, hpre.active, fun l hl => hl⟩","+    intro e _ hl _ j hjr hcov","+    rcases cover_of_skel hsk (active_lt hl) hcov with h | ⟨hj, o, ho, hor⟩","+    · exact .inl h","+    · have hjlen : j < s.A.length + 1 := by","+        have := List.mem_range.1 hjr","+        simp only [hA, List.length_append, List.length_singleton] at this","+        exact this","+      have hje : j = s.A.length := by omega","+      have hoe : o = e₀.guarded := by","+        have : ((deriveSyncEff s c e₀.guarded).A[j]?).bind (·.origin) = some o := ho","+        rw [hA, hje, List.getElem?_append_right (Nat.le_refl _)] at this","+        simpa using this.symm","+      rcases hor with hg | hc","+      · refine .inr (.inr ?_)","+        show OptP (reg[i]?) _ False","+        rw [hi]","+        exact ⟨by rw [← hoe, hg], hje⟩","+      · exact .inr (.inl ⟨hj, o, ho, hc⟩)","+  | @unlock s reg ar c i st₁ h =>","+    obtain ⟨-, e₀, g₀, -, -, -, hpre, -, rfl⟩ := h","+    obtain ⟨x, hx, -⟩ := hpre.active","+    have hsk := release_skel' (c := c) (show s.A[g₀]? = some x from hx)","+    exact closure_of_skel hsk (src_none (release_org s c g₀).1)","+  | resetLock h =>","+    obtain ⟨-, -, -, -, -, -, rfl⟩ := h","+    exact closure_of_skel (skel_refl _) (src_none rfl)","+  | @spawnVal s s' reg ar c ps ls vs h =>","+    obtain ⟨-, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'","+    have hf := spawnEff_facts (reg := reg) (c := c) (ps := []) (s := s) (fun _ h => by cases h)","+      hpre.localsOK","+    obtain ⟨h1, l1, o1⟩ := transfers_skel c (spawnCreate s c ls) vs","+    have hp : ∀ a ∈ ps, ∀ y, (transfersEff c (spawnCreate s c ls) vs).A[a]? = some y →","+        ∃ g, y.holder = .frame g := by","+      intro a ha y hy","+      have := hpre.paramsAtYield a ha","+      have hy' : ((transfersEff c (spawnCreate s c ls) vs).view c).A[a]? = some y := hy","+      rw [hy'] at this","+      exact ⟨_, this.2.1⟩","+    obtain ⟨h2, l2, o2⟩ := yield_skel' (f := s.nF) hp","+    have hsk : Skel s (spawnValEff s c ps ls vs) :=","+      Skel.comp (Skel.comp hf.skel h1 l1 o1) h2 l2 o2","+    exact closure_of_skel hsk","+      (src_carry (src_carry hf.src l1 o1) l2 o2)","+  | newArena h =>","+    obtain ⟨-, -, rfl⟩ := newArenaStepC_ok h","+    exact closure_of_skel (skel_refl _) (src_none rfl)","+  | @issue s reg ar c i region dst st₁ h =>","+    obtain ⟨E, s₁, hE, hst, -, hsp, hsto, -⟩ := issueStepC_ok h","+    have hsep' : Encap L (s, reg) (.kernel c (.split E.internal [region])) :=","+      fun e hm hl heq => hsep e hm E (List.mem_of_getElem? hE) hl","+        (by show s.flat.Active E.internal; rw [heq]; exact hl) heq.symm","+    have hf := opStep_facts (reg := reg) hsp hsep' (fun _ _ h => by cases h) hw","+    obtain ⟨-, h'⟩ := hsto; obtain ⟨hpre, he₂⟩ := Guarded.ok_iff.1 h'","+    rw [he₂]","+    obtain ⟨l2, o2⟩ := store_org s₁ c s.A.length dst","+    exact closure_of_skel (Skel.comp hf.skel (store_skel' hpre.derivedHeld) l2 o2)","+      (src_carry hf.src l2 o2)","+  | @reset s reg ar c i st₁ h =>","+    obtain ⟨E, s₁, hE, hd, hrl, -, -⟩ := resetStepC_ok (k := k) h","+    have hl₀ : s.flat.Active E.internal := by","+      obtain ⟨-, o, hR, ho⟩ := hd","+      cases hR with","+      | ok hp => exact hp.active","+      | reject => cases ho","+    have hsep' : Encap L (s, reg) (.kernel c (.derive E.internal (footprint s.P E.storage) .modify)) :=","+      fun e hm hl heq => hsep e hm E (List.mem_of_getElem? hE) hl","+        (by show s.flat.Active E.internal; exact hl₀) heq.symm","+    have hf := opStep_facts (reg := reg) hd hsep' (fun _ _ h => by cases h) hw","+    obtain ⟨-, o, hR, ho⟩ := hrl","+    cases hR with","+    | ok hp =>","+      cases ho","+      obtain ⟨x, hx, -⟩ := hp.active","+      obtain ⟨l2, o2⟩ := release_org s₁ c s.A.length","+      exact closure_of_skel (Skel.comp hf.skel (release_skel' (c := c) hx) l2 o2)","+        (src_carry hf.src l2 o2)","+    | reject => cases ho","+","+/-- Brief of the complement, task 2: on a `RunFull` from the initial state of Spec 1 §47, under","+`DDSound` (Spec 1 §80), every step satisfies the closure of the covering descendants: an authority","+enters the covering descendants of a live entry only by being created from one of them, or as the","+grant of an `acquire` of that entry. -/","+theorem closure_run {k : K} {L : MutexLayout} {statics : Statics}","+    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)","+    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))","+    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) :","+    ClosureStep (σ i) lbls[i] (σ (i + 1)) := by","+  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)","+  exact closure_step hk hlib.2.1 (h i hi).1.1.1.1.1 (h i hi).2","+"," end Ern.Concurrency.FullEncap"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/Closure.lean"]}},"serverClassifierContext":{"request":"143f19e4-8dd5-4d32-b454-347b026b610b","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"8274bd21-8937-4fff-acb1-0ee5757b2832","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"443df89572cb7d881171b0efe65713c36a8e343a802d2697e4fa44a30afacc16","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Les fondations compilent. J'écris le théorème de fermeture par genre (`closure_step`) et sa forme sur les exécutions (`closure_run`)."},{"type":"tool_use","id":"toolu_01FJhpYdHcD2ZoKJ5unGQJ9f","name":"Bash","input":{"command":"cd /Users/guygouri/Devlab/ernlang/ern/formal && python3 - <<'EOF'\np='Ern/Concurrency/FullEncap/Closure.lean'\ns=open(p).read()\nadd='''\n/-- The source condition carries over a phase that creates no authority and keeps every origin. -/\ntheorem src_carry {s s₁ s₂ : SC} {reg : SyncReg}\n    (hsrc : ∀ e ∈ reg, e.Live s → ∀ j y' o, s₁.A[j]? = some y' → s.A.length ≤ j →\n      y'.origin = some o → o ≠ e.guarded)\n    (hlen : s₂.A.length = s₁.A.length) (horg : ∀ i, s₂.flat.org i = s₁.flat.org i) :\n    ∀ e ∈ reg, e.Live s → ∀ j y'' o, s₂.A[j]? = some y'' → s.A.length ≤ j →\n      y''.origin = some o → o ≠ e.guarded := by\n  intro e he hl j y'' o hy'' hj ho\n  obtain ⟨y', hy'⟩ := getElem?_of_lt (show j < s₁.A.length by\n    have := lt_of_getElem? hy''; omega)\n  have h := horg j\n  simp only [S3.org] at h\n  have e1 : s₂.flat.A[j]? = some y'' := hy''\n  have e2 : s₁.flat.A[j]? = some y' := hy'\n  rw [e1, e2] at h\n  simp only [Option.bind_some] at h\n  exact hsrc e he hl j y' o hy' hj (h ▸ ho)\n\n/-- `store` executed by `c` of an authority held by the current frame (Spec 1 §65.1) is a step\nread through `Skel`. -/\ntheorem store_skel' {s : SC} {c a p : Nat}\n    (hd : OptP ((s.view c).A[a]?) (fun y => y.active = true ∧ y.origin ≠ none ∧\n      y.holder = .frame (s.view c).top) False) : Skel s (storeEffC s c a p) := by\n  unfold OptP at hd\n  split at hd\n  · rename_i y hy\n    have hy' : s.A[a]? = some y := hy\n    have hA : (storeEffC s c a p).A = s.A.set a { y with holder := .place p } := by\n      show (storeEff (s.view c) a p).A = _; simp [storeEff, hy]; rfl\n    exact (skel_set hy' hA ⟨rfl, rfl, rfl, id, fun q hq => by rw [hd.2.2] at hq; cases hq⟩).1\n  · exact hd.elim\n\n/-- `release` executed by `c` of an existing authority (Spec 1 §62) is a step read through\n`Skel`. -/\ntheorem release_skel' {t : SC} {c a : Nat} {x : Authority} (hx : t.A[a]? = some x) :\n    Skel t (t.set (releaseEff (t.view c) a)) := by\n  have hx' : (t.view c).A[a]? = some x := hx\n  have hA : (t.set (releaseEff (t.view c) a)).A = t.A.set a { x with active := false } := by\n    show (releaseEff (t.view c) a).A = _; rw [releaseEff_eq hx']; rfl\n  exact (skel_set hx hA (same_deact x)).1\n\n/-- Brief of the complement, task 2, step form: an `ok` step admitted by `Encap` (WC5.2 C22 items\n1–3, 5), from a state satisfying `KInvCA` and the separation of the registries (`AdminSep`, Spec 1\n§56, WC5.2 C13 item 7), satisfies the closure. -/\ntheorem closure_step {k : K} {L : MutexLayout} {st st' : SC × SyncReg × ArenaReg} {lbl : Label}\n    (hk : KInvCA st.1) (hsep : AdminSep st.1 st.2.1 st.2.2) (he : Encap L (st.1, st.2.1) lbl)\n    (hs : LStep k L lbl st st') : ClosureStep st lbl st' := by\n  have hw : WF3 st.1.flat := hk.1.1.2\n  cases hs with\n  | @kernel s s' reg ar c op h =>\n    cases op\n    case transfer src dst =>\n      obtain ⟨-, h'⟩ := h; obtain ⟨-, rfl⟩ := Guarded.ok_iff.1 h'\n      obtain ⟨hsk, hlen, -⟩ := transfer_skel s c src dst\n      exact closure_of_skel hsk (src_none hlen)\n    all_goals\n      have hf := opStep_facts (reg := reg) h he (fun _ _ h => by cases h) hw\n      exact closure_of_skel hf.skel hf.src\n  | @spawn s s' reg ar c ps ls h =>\n    obtain ⟨-, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'\n    have hf := spawnEff_facts (reg := reg) hpre.params hpre.localsOK\n    exact closure_of_skel hf.skel hf.src\n  | @terminate s s' reg ar c h =>\n    have hf := term_facts (reg := reg) hw h\n    exact closure_of_skel hf.skel hf.src\n  | @join s s' reg ar c d h =>\n    have hf := join_facts (reg := reg) h\n    exact closure_of_skel hf.skel hf.src\n  | deriveSync h => exact (deriveSync_excluded h he).elim\n  | newMutex h =>\n    obtain ⟨-, -, rfl⟩ := h\n    exact closure_of_skel (skel_refl _) (src_none rfl)\n  | @acquire s reg ar c i st₁ h =>\n    obtain ⟨-, e₀, hi, -, hpre, rfl⟩ := h\n    have hA : (deriveSyncEff s c e₀.guarded).A = s.A ++ [⟨.modify, some e₀.guarded,\n        (s.view c).afp e₀.guarded, .frame (s.view c).top, true⟩] := rfl\n    obtain ⟨hsk, -⟩ := skel_append hA rfl (fun j y' hy' => ⟨y', hy', Same.refl _⟩) fun z hz => by\n      rw [List.mem_singleton] at hz; subst hz\n      exact .inr ⟨e₀.guarded, rfl, active_lt hpre.active, hpre.active, fun l hl => hl⟩\n    intro e _ hl _ j hjr hcov\n    rcases cover_of_skel hsk (active_lt hl) hcov with h | ⟨hj, o, ho, hor⟩\n    · exact .inl h\n    · have hjlen : j < s.A.length + 1 := by\n        have := List.mem_range.1 hjr\n        simp only [hA, List.length_append, List.length_singleton] at this\n        exact this\n      have hje : j = s.A.length := by omega\n      have hoe : o = e₀.guarded := by\n        have : ((deriveSyncEff s c e₀.guarded).A[j]?).bind (·.origin) = some o := ho\n        rw [hA, hje, List.getElem?_append_right (Nat.le_refl _)] at this\n        simpa using this.symm\n      rcases hor with hg | hc\n      · refine .inr (.inr ?_)\n        show OptP (reg[i]?) _ False\n        rw [hi]\n        exact ⟨by rw [← hoe, hg], hje⟩\n      · exact .inr (.inl ⟨hj, o, ho, hc⟩)\n  | @unlock s reg ar c i st₁ h =>\n    obtain ⟨-, e₀, g₀, -, -, -, hpre, -, rfl⟩ := h\n    obtain ⟨x, hx, -⟩ := hpre.active\n    have hsk := release_skel' (c := c) (show s.A[g₀]? = some x from hx)\n    exact closure_of_skel hsk (src_none (release_org s c g₀).1)\n  | resetLock h =>\n    obtain ⟨-, -, -, -, -, -, rfl⟩ := h\n    exact closure_of_skel (skel_refl _) (src_none rfl)\n  | @spawnVal s s' reg ar c ps ls vs h =>\n    obtain ⟨-, h'⟩ := h; obtain ⟨hpre, rfl⟩ := Guarded.ok_iff.1 h'\n    have hf := spawnEff_facts (reg := reg) (c := c) (ps := []) (s := s) (fun _ h => by cases h)\n      hpre.localsOK\n    obtain ⟨h1, l1, o1⟩ := transfers_skel c (spawnCreate s c ls) vs\n    have hp : ∀ a ∈ ps, ∀ y, (transfersEff c (spawnCreate s c ls) vs).A[a]? = some y →\n        ∃ g, y.holder = .frame g := by\n      intro a ha y hy\n      have := hpre.paramsAtYield a ha\n      have hy' : ((transfersEff c (spawnCreate s c ls) vs).view c).A[a]? = some y := hy\n      rw [hy'] at this\n      exact ⟨_, this.2.1⟩\n    obtain ⟨h2, l2, o2⟩ := yield_skel' (f := s.nF) hp\n    have hsk : Skel s (spawnValEff s c ps ls vs) :=\n      Skel.comp (Skel.comp hf.skel h1 l1 o1) h2 l2 o2\n    exact closure_of_skel hsk\n      (src_carry (src_carry hf.src l1 o1) l2 o2)\n  | newArena h =>\n    obtain ⟨-, -, rfl⟩ := newArenaStepC_ok h\n    exact closure_of_skel (skel_refl _) (src_none rfl)\n  | @issue s reg ar c i region dst st₁ h =>\n    obtain ⟨E, s₁, hE, hst, -, hsp, hsto, -⟩ := issueStepC_ok h\n    have hsep' : Encap L (s, reg) (.kernel c (.split E.internal [region])) :=\n      fun e hm hl heq => hsep e hm E (List.mem_of_getElem? hE) hl\n        (by show s.flat.Active E.internal; rw [heq]; exact hl) heq.symm\n    have hf := opStep_facts (reg := reg) hsp hsep' (fun _ _ h => by cases h) hw\n    obtain ⟨-, h'⟩ := hsto; obtain ⟨hpre, he₂⟩ := Guarded.ok_iff.1 h'\n    rw [he₂]\n    obtain ⟨l2, o2⟩ := store_org s₁ c s.A.length dst\n    exact closure_of_skel (Skel.comp hf.skel (store_skel' hpre.derivedHeld) l2 o2)\n      (src_carry hf.src l2 o2)\n  | @reset s reg ar c i st₁ h =>\n    obtain ⟨E, s₁, hE, hd, hrl, -, -⟩ := resetStepC_ok (k := k) h\n    have hl₀ : s.flat.Active E.internal := by\n      obtain ⟨-, o, hR, ho⟩ := hd\n      cases hR with\n      | ok hp => exact hp.active\n      | reject => cases ho\n    have hsep' : Encap L (s, reg) (.kernel c (.derive E.internal (footprint s.P E.storage) .modify)) :=\n      fun e hm hl heq => hsep e hm E (List.mem_of_getElem? hE) hl\n        (by show s.flat.Active E.internal; exact hl₀) heq.symm\n    have hf := opStep_facts (reg := reg) hd hsep' (fun _ _ h => by cases h) hw\n    obtain ⟨-, o, hR, ho⟩ := hrl\n    cases hR with\n    | ok hp =>\n      cases ho\n      obtain ⟨x, hx, -⟩ := hp.active\n      obtain ⟨l2, o2⟩ := release_org s₁ c s.A.length\n      exact closure_of_skel (Skel.comp hf.skel (release_skel' (c := c) hx) l2 o2)\n        (src_carry hf.src l2 o2)\n    | reject => cases ho\n\n/-- Brief of the complement, task 2: on a `RunFull` from the initial state of Spec 1 §47, under\n`DDSound` (Spec 1 §80), every step satisfies the closure of the covering descendants: an authority\nenters the covering descendants of a live entry only by being created from one of them, or as the\ngrant of an `acquire` of that entry. -/\ntheorem closure_run {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) :\n    ClosureStep (σ i) lbls[i] (σ (i + 1)) := by\n  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n  exact closure_step hk hlib.2.1 (h i hi).1.1.1.1.1 (h i hi).2\n\nend Ern.Concurrency.FullEncap'''\nassert s.count('\\nend Ern.Concurrency.FullEncap')==1\ns=s.replace('\\nend Ern.Concurrency.FullEncap', add, 1)\nopen(p,'w').write(s)\nEOF\ntime ~/.elan/bin/lake env lean Ern/Concurrency/FullEncap/Closure.lean 2>&1 | head -80","description":"Add closure_step and closure_run","timeout":900000},"caller":{"type":"direct"}}]}}
