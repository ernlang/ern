ncReg × ArenaReg :=\n66:/-- `corpus-spec2-m3.md` v14 §2 terdecies, W-GR under the complete encapsulation. Local verdict:\n72:theorem W_GR_full : opStepC KM (.read 3 [3]) 1 x4 (.ok GuardedRead.gr1) ∧ GuardedRead.gr1 = x4 ∧\n74:    wrσ 0 = (SC.ofS3 (S3.init mxst), [], []) ∧ RunFull KM L0 wrσ wrLbls := by\n90:/-- W-GC, suite without step 1: `c0 : acquire(e)`, grant `g`, authority 6. -/\n91:def cg7 : SC := deriveSyncEff GuardedChain.gc6 0 4\n92:/-- W-GC, suite: `c0 : write3(Y)` via `z` (O10). -/\n93:def cg8 : SC := cg7.set (write3Eff (cg7.view 0) [4])\n94:/-- W-GC, suite: `c0 : read3(Y)` via `z` (O9). -/\n95:def cg9 : SC := cg8.set (cg8.view 0)\n96:/-- The registry with `g` recorded. -/\n97:def cgReg : SyncReg := [⟨4, some 6⟩]\n99:/-- The labels of the positive suite of W-GC: the setup, then steps 2 to 4. -/\n100:def cgLbls : List Label :=\n104:/-- The named states of the positive suite of W-GC. -/\n105:def cgσ (i : Nat) : SC × SyncReg × ArenaReg :=\n111:/-- `corpus-spec2-m3.md` v14 §2 terdecies, W-GC under the complete encapsulation. Local verdict:\n117:theorem W_GC_full : opStepC KM (.read 3 [4]) 1 gc6 (.ok gc7) ∧ gc7 = gc6 ∧\n119:    cgσ 0 = (SC.ofS3 (S3.init zst), [], []) ∧ RunFull KM L0 cgσ cgLbls := by\n139:/-- `corpus-spec2-m3.md` v14 §2 terdecies, W-GS under the complete encapsulation. Local verdict:\n145:theorem W_GS_full : opStepC KM (.store 4 3) 0 gs5 (.ok gs6) ∧\n149:    RunFull KM L0 MutexReal.NonRegression.gsTwinσ MutexReal.NonRegression.gsTwinLbls :=\n153:/-- W-GS, steps 2 and 3 on the states of the corpus trace, after the excluded step 1: `c1 :\n158:theorem W_GS_2_3_local :\n169:/-- The labels of S2 (`s2_trace`): `MX₄`, `c1 : acquire(e)`, `write3(T)`, `unlock(e)`. -/\n170:def s2Lbls : List Label := mx4Lbls ++ [.acquire 1 0, .kernel 1 (.write 5 [3]), .unlock 1 0]\n172:/-- `corpus-spec2-m3.md` §1 S2 (`s2_trace`, `cycle_trace5`) is a `RunFull` from the initial\n174:theorem S2_full : (MutexEdge.rl0Lbls.take 8) = s2Lbls ∧\n175:    RunFull KM L0 MutexEdge.rl0σ