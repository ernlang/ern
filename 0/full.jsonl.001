{"parentUuid":"d9e0e708-39ec-4c6b-9037-9579216ba3f0","isSidechain":false,"promptId":"c6363317-3632-459e-8779-ebed992e8329","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GTCYDB8taYugDnWf5eq17K","type":"tool_result","content":"Ern/Concurrency/SyncLib.lean:497:inductive Label where\nErn/Concurrency/SyncLib.lean-498-  | kernel (c : Nat) (op : KernelOp)\nErn/Concurrency/SyncLib.lean-499-  | spawn (c : Nat) (ps : List Nat) (ls : LocalShape)\nErn/Concurrency/SyncLib.lean-500-  | terminate (c : Nat)\nErn/Concurrency/SyncLib.lean-501-  | join (c d : Nat)\nErn/Concurrency/SyncLib.lean-502-  | deriveSync (c g : Nat)\nErn/Concurrency/SyncLib.lean-503-  | newMutex (c g : Nat)\nErn/Concurrency/SyncLib.lean-504-  | acquire (c i : Nat)\nErn/Concurrency/SyncLib.lean-505-  | unlock (c i : Nat)\nErn/Concurrency/SyncLib.lean-506-  | resetLock (c i : Nat)\nErn/Concurrency/SyncLib.lean-507-  | spawnVal (c : Nat) (ps : List Nat) (ls : LocalShape) (vs : List (Nat × Nat))\nErn/Concurrency/SyncLib.lean-508-  | newArena (c storage internal : Nat)\nErn/Concurrency/SyncLib.lean-509-  | issue (c arena : Nat) (region : List Nat) (dst : Nat)\nErn/Concurrency/SyncLib.lean-510-  | reset (c arena : Nat)\nErn/Concurrency/SyncLib.lean-511-\nErn/Concurrency/SyncLib.lean-512-/-- Labelled `ok` step of the concurrent kernel with the synchronization and arena libraries\nErn/Concurrency/SyncLib.lean-513-(WC4 C2, C4, C5, C6–C8, C13, C15–C18, C19; WC4 C23 for the by-value composite; Spec 1 §76–§78 for\nErn/Concurrency/SyncLib.lean-514-the arenas): kernel and frame steps keep both registries; raw `deriveSync` runs under the library\nErn/Concurrency/SyncLib.lean-515-instantiation of `SyncAuthorized` on the current registry (WC4 C14); the mutex operations change\nErn/Concurrency/SyncLib.lean-516-the synchronization registry, the arena operations the arena registry (Spec 1 §46). -/\nErn/Concurrency/SyncLib.lean-517-inductive LStep (k : K) (L : MutexLayout) :\nErn/Concurrency/SyncLib.lean-518-    Label → SC × SyncReg × ArenaReg → SC × SyncReg × ArenaReg → Prop where\nErn/Concurrency/SyncLib.lean-519-  | kernel {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {op : KernelOp} :\nErn/Concurrency/SyncLib.lean-520-      opStepC k op c s (.ok s') → LStep k L (.kernel c op) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-521-  | spawn {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {ps : List Nat}\nErn/Concurrency/SyncLib.lean-522-      {ls : LocalShape} :\nErn/Concurrency/SyncLib.lean-523-      SpawnStep s c ps ls (.ok s') → LStep k L (.spawn c ps ls) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-524-  | terminate {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} :\nErn/Concurrency/SyncLib.lean-525-      TermStep k s c (.ok s') → LStep k L (.terminate c) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-526-  | join {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c d : Nat} :\nErn/Concurrency/SyncLib.lean-527-      JoinStep s c d (.ok s') → LStep k L (.join c d) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-528-  | deriveSync {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} :\nErn/Concurrency/SyncLib.lean-529-      DeriveSyncStep (libKC k L) reg s c g (.ok s') →\nErn/Concurrency/SyncLib.lean-530-      LStep k L (.deriveSync c g) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-531-  | newMutex {s : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} {st' : SC × SyncReg} :\nErn/Concurrency/SyncLib.lean-532-      NewMutexOk k L ar s reg c g st' → LStep k L (.newMutex c g) (s, reg, ar) (st'.1, st'.2, ar)\nErn/Concurrency/SyncLib.lean-533-  | acquire {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\nErn/Concurrency/SyncLib.lean-534-      AcquireOk k L s reg c i st' → LStep k L (.acquire c i) (s, reg, ar) (st'.1, st'.2, ar)\nErn/Concurrency/SyncLib.lean-535-  | unlock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\nErn/Concurrency/SyncLib.lean-536-      UnlockOk L s reg c i st' → LStep k L (.unlock c i) (s, reg, ar) (st'.1, st'.2, ar)\nErn/Concurrency/SyncLib.lean-537-  | resetLock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n  | terminate (c : Nat)\n  | join (c d : Nat)\n  | deriveSync (c g : Nat)\n  | newMutex (c g : Nat)\n  | acquire (c i : Nat)\n  | unlock (c i : Nat)\n  | resetLock (c i : Nat)\n  | spawnVal (c : Nat) (ps : List Nat) (ls : LocalShape) (vs : List (Nat × Nat))\n  | newArena (c storage internal : Nat)\n  | issue (c arena : Nat) (region : List Nat) (dst : Nat)\n  | reset (c arena : Nat)\n\n/-- Labelled `ok` step of the concurrent kernel with the synchronization and arena libraries\n(WC4 C2, C4, C5, C6–C8, C13, C15–C18, C19; WC4 C23 for the by-value composite; Spec 1 §76–§78 for\nthe arenas): kernel and frame steps keep both registries; raw `deriveSync` runs under the library\ninstantiation of `SyncAuthorized` on the current registry (WC4 C14); the mutex operations change\nthe synchronization registry, the arena operations the arena registry (Spec 1 §46). -/\ninductive LStep (k : K) (L : MutexLayout) :\n    Label → SC × SyncReg × ArenaReg → SC × SyncReg × ArenaReg → Prop where\n  | kernel {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {op : KernelOp} :\n      opStepC k op c s (.ok s') → LStep k L (.kernel c op) (s, reg, ar) (s', reg, ar)\n  | spawn {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {ps : List Nat}\n      {ls : LocalShape} :\n      SpawnStep s c ps ls (.ok s') → LStep k L (.spawn c ps ls) (s, reg, ar) (s', reg, ar)\n  | terminate {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} :\n      TermStep k s c (.ok s') → LStep k L (.terminate c) (s, reg, ar) (s', reg, ar)\n  | join {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c d : Nat} :\n      JoinStep s c d (.ok s') → LStep k L (.join c d) (s, reg, ar) (s', reg, ar)\n  | deriveSync {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} :\n      DeriveSyncStep (libKC k L) reg s c g (.ok s') →\n      LStep k L (.deriveSync c g) (s, reg, ar) (s', reg, ar)\n  | newMutex {s : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} {st' : SC × SyncReg} :\n      NewMutexOk k L ar s reg c g st' → LStep k L (.newMutex c g) (s, reg, ar) (st'.1, st'.2, ar)\n  | acquire {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n      AcquireOk k L s reg c i st' → LStep k L (.acquire c i) (s, reg, ar) (st'.1, st'.2, ar)\n  | unlock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n      UnlockOk L s reg c i st' → LStep k L (.unlock c i) (s, reg, ar) (st'.1, st'.2, ar)\n  | resetLock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n      ResetLockOk L s reg c i st' → LStep k L (.resetLock c i) (s, reg, ar) (st'.1, st'.2, ar)\n  | spawnVal {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {ps : List Nat}\n      {ls : LocalShape} {vs : List (Nat × Nat)} :\n      SpawnValStep k s c ps ls vs (.ok s') →\n      LStep k L (.spawnVal c ps ls vs) (s, reg, ar) (s', reg, ar)\n  | newArena {s : SC} {reg : SyncReg} {ar : ArenaReg} {c st i : Nat} {st' : SC × ArenaReg} :\n      NewArenaStepC s reg ar c st i (.ok st') →\n      LStep k L (.newArena c st i) (s, reg, ar) (st'.1, reg, st'.2)\n  | issue {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {region : List Nat} {dst : Nat}\n      {st' : SC × ArenaReg} :\n      IssueStepC k s ar c i region dst (.ok st') →\n      LStep k L (.issue c i region dst) (s, reg, ar) (st'.1, reg, st'.2)\n  | reset {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × ArenaReg} :\n      ResetStepC s ar c i (.ok st') → LStep k L (.reset c i) (s, reg, ar) (st'.1, reg, st'.2)\n\n/-- WC4 C22.3 for the source `src` of a transfer in state `st`: for each live entry, `src` is\nneither the place `slot` holding `guarded`, nor a strict structural subplace of `slot`, nor the\ncontroller leaf `ctl`. -/\ndef TransferExcl (L : MutexLayout) (st : SC × SyncReg) (src : Nat) : Prop :=\n  ∀ e ∈ st.2, e.Live st.1 →\n    OptP (slotOf st.1 e.guarded) (fun q => ¬ partOf st.1.P src q) True ∧\n      ControlOf L st.1 e ≠ some src\n\n/-- Decidability of `TransferExcl` (WC4 C22.3). -/\ninstance (L : MutexLayout) (st : SC × SyncReg) (src : Nat) : Decidable (TransferExcl L st src) := by\n  unfold TransferExcl; infer_instance\n\n/-- WC4 C22.3 for the transfers of the by-value composite (WC4 C23):\nthe source of every transfer phase satisfies `TransferExcl` in the state where that phase starts\n(WC4 C5.2), the registry being `reg`. -/\ndef EncapVals (L : MutexLayout) (reg : SyncReg) (c : Nat) : SC → List (Nat × Nat) → Prop\n  | _, [] => True\n  | t, v :: vs => TransferExcl L (t, reg) v.1 ∧ EncapVals L reg c (transferEffC t c v.1 v.2) vs\n\n/-- Encapsulation of one step in state `st` (hypothesis on traces, WC4 C22, C23): for each live\nentry, WC4 C22.1 (`derive`, `split`), C22.2 (raw `deriveSync`), C22.3 (`transfer`, and the\ntransfer phases of the by-value composite) and C22.5 (`endUse` whose place is the controller leaf\n`ctl` or a strict structural subplace of `slot`). WC4 C22.4 (controller-write protocol) is a\nrealization/interface obligation (WC4 C22) with no content in `S_C`, which has no values (Spec 1\n§41), and is not represented. -/\ndef Encap (L : MutexLayout) (st : SC × SyncReg) : Label → Prop\n  | .kernel _ (.derive src _ _) => ∀ e ∈ st.2, e.Live st.1 → src ≠ e.guarded\n  | .kernel _ (.split src _) => ∀ e ∈ st.2, e.Live st.1 → src ≠ e.guarded\n  | .kernel _ (.transfer src _) => TransferExcl L st src\n  | .kernel _ (.endUse p) => ∀ e ∈ st.2, e.Live st.1 → ControlOf L st.1 e ≠ some p ∧\n      OptP (slotOf st.1 e.guarded) (fun q => partOf st.1.P p q → p = q) True\n  | .spawnVal c _ ls vs => EncapVals L st.2 c (spawnCreate st.1 c ls) vs\n  | .deriveSync _ g => ∀ e ∈ st.2, e.Live st.1 → g ≠ e.guarded\n  | _ => True\n\n/-- Runs of labelled steps. -/\ninductive LRun (k : K) (L : MutexLayout) :\n    SC × SyncReg × ArenaReg → List Label → SC × SyncReg × ArenaReg → Prop where\n  | nil {st : SC × SyncReg × ArenaReg} : LRun k L st [] st\n  | cons {st st₁ st₂ : SC × SyncReg × ArenaReg} {lbl : Label} {lbls : List Label} :\n      LStep k L lbl st st₁ → LRun k L st₁ lbls st₂ → LRun k L st (lbl :: lbls) st₂\n\n/-- `EncapsulatedTrace` (WC4 C22, C23: \"Any lemma conditional on encapsulation must expose that\ncondition in its theorem statement or the reachable-trace assumptions\"): a run every step of which\nsatisfies `Encap` in the state where it is taken, read on the kernel state and the\nsynchronization registry. -/\ninductive EncapsulatedTrace (k : K) (L : MutexLayout) :\n    SC × SyncReg × ArenaReg → List Label → SC × SyncReg × ArenaReg → Prop where","is_error":false}]},"uuid":"27db67c3-452a-4f9a-9230-718af5ad06bf","timestamp":"2026-11-14T07:52:40.724Z","toolUseResult":{"stdout":"Ern/Concurrency/SyncLib.lean:497:inductive Label where\nErn/Concurrency/SyncLib.lean-498-  | kernel (c : Nat) (op : KernelOp)\nErn/Concurrency/SyncLib.lean-499-  | spawn (c : Nat) (ps : List Nat) (ls : LocalShape)\nErn/Concurrency/SyncLib.lean-500-  | terminate (c : Nat)\nErn/Concurrency/SyncLib.lean-501-  | join (c d : Nat)\nErn/Concurrency/SyncLib.lean-502-  | deriveSync (c g : Nat)\nErn/Concurrency/SyncLib.lean-503-  | newMutex (c g : Nat)\nErn/Concurrency/SyncLib.lean-504-  | acquire (c i : Nat)\nErn/Concurrency/SyncLib.lean-505-  | unlock (c i : Nat)\nErn/Concurrency/SyncLib.lean-506-  | resetLock (c i : Nat)\nErn/Concurrency/SyncLib.lean-507-  | spawnVal (c : Nat) (ps : List Nat) (ls : LocalShape) (vs : List (Nat × Nat))\nErn/Concurrency/SyncLib.lean-508-  | newArena (c storage internal : Nat)\nErn/Concurrency/SyncLib.lean-509-  | issue (c arena : Nat) (region : List Nat) (dst : Nat)\nErn/Concurrency/SyncLib.lean-510-  | reset (c arena : Nat)\nErn/Concurrency/SyncLib.lean-511-\nErn/Concurrency/SyncLib.lean-512-/-- Labelled `ok` step of the concurrent kernel with the synchronization and arena libraries\nErn/Concurrency/SyncLib.lean-513-(WC4 C2, C4, C5, C6–C8, C13, C15–C18, C19; WC4 C23 for the by-value composite; Spec 1 §76–§78 for\nErn/Concurrency/SyncLib.lean-514-the arenas): kernel and frame steps keep both registries; raw `deriveSync` runs under the library\nErn/Concurrency/SyncLib.lean-515-instantiation of `SyncAuthorized` on the current registry (WC4 C14); the mutex operations change\nErn/Concurrency/SyncLib.lean-516-the synchronization registry, the arena operations the arena registry (Spec 1 §46). -/\nErn/Concurrency/SyncLib.lean-517-inductive LStep (k : K) (L : MutexLayout) :\nErn/Concurrency/SyncLib.lean-518-    Label → SC × SyncReg × ArenaReg → SC × SyncReg × ArenaReg → Prop where\nErn/Concurrency/SyncLib.lean-519-  | kernel {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {op : KernelOp} :\nErn/Concurrency/SyncLib.lean-520-      opStepC k op c s (.ok s') → LStep k L (.kernel c op) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-521-  | spawn {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {ps : List Nat}\nErn/Concurrency/SyncLib.lean-522-      {ls : LocalShape} :\nErn/Concurrency/SyncLib.lean-523-      SpawnStep s c ps ls (.ok s') → LStep k L (.spawn c ps ls) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-524-  | terminate {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} :\nErn/Concurrency/SyncLib.lean-525-      TermStep k s c (.ok s') → LStep k L (.terminate c) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-526-  | join {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c d : Nat} :\nErn/Concurrency/SyncLib.lean-527-      JoinStep s c d (.ok s') → LStep k L (.join c d) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-528-  | deriveSync {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} :\nErn/Concurrency/SyncLib.lean-529-      DeriveSyncStep (libKC k L) reg s c g (.ok s') →\nErn/Concurrency/SyncLib.lean-530-      LStep k L (.deriveSync c g) (s, reg, ar) (s', reg, ar)\nErn/Concurrency/SyncLib.lean-531-  | newMutex {s : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} {st' : SC × SyncReg} :\nErn/Concurrency/SyncLib.lean-532-      NewMutexOk k L ar s reg c g st' → LStep k L (.newMutex c g) (s, reg, ar) (st'.1, st'.2, ar)\nErn/Concurrency/SyncLib.lean-533-  | acquire {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\nErn/Concurrency/SyncLib.lean-534-      AcquireOk k L s reg c i st' → LStep k L (.acquire c i) (s, reg, ar) (st'.1, st'.2, ar)\nErn/Concurrency/SyncLib.lean-535-  | unlock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\nErn/Concurrency/SyncLib.lean-536-      UnlockOk L s reg c i st' → LStep k L (.unlock c i) (s, reg, ar) (st'.1, st'.2, ar)\nErn/Concurrency/SyncLib.lean-537-  | resetLock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n  | terminate (c : Nat)\n  | join (c d : Nat)\n  | deriveSync (c g : Nat)\n  | newMutex (c g : Nat)\n  | acquire (c i : Nat)\n  | unlock (c i : Nat)\n  | resetLock (c i : Nat)\n  | spawnVal (c : Nat) (ps : List Nat) (ls : LocalShape) (vs : List (Nat × Nat))\n  | newArena (c storage internal : Nat)\n  | issue (c arena : Nat) (region : List Nat) (dst : Nat)\n  | reset (c arena : Nat)\n\n/-- Labelled `ok` step of the concurrent kernel with the synchronization and arena libraries\n(WC4 C2, C4, C5, C6–C8, C13, C15–C18, C19; WC4 C23 for the by-value composite; Spec 1 §76–§78 for\nthe arenas): kernel and frame steps keep both registries; raw `deriveSync` runs under the library\ninstantiation of `SyncAuthorized` on the current registry (WC4 C14); the mutex operations change\nthe synchronization registry, the arena operations the arena registry (Spec 1 §46). -/\ninductive LStep (k : K) (L : MutexLayout) :\n    Label → SC × SyncReg × ArenaReg → SC × SyncReg × ArenaReg → Prop where\n  | kernel {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {op : KernelOp} :\n      opStepC k op c s (.ok s') → LStep k L (.kernel c op) (s, reg, ar) (s', reg, ar)\n  | spawn {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {ps : List Nat}\n      {ls : LocalShape} :\n      SpawnStep s c ps ls (.ok s') → LStep k L (.spawn c ps ls) (s, reg, ar) (s', reg, ar)\n  | terminate {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} :\n      TermStep k s c (.ok s') → LStep k L (.terminate c) (s, reg, ar) (s', reg, ar)\n  | join {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c d : Nat} :\n      JoinStep s c d (.ok s') → LStep k L (.join c d) (s, reg, ar) (s', reg, ar)\n  | deriveSync {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} :\n      DeriveSyncStep (libKC k L) reg s c g (.ok s') →\n      LStep k L (.deriveSync c g) (s, reg, ar) (s', reg, ar)\n  | newMutex {s : SC} {reg : SyncReg} {ar : ArenaReg} {c g : Nat} {st' : SC × SyncReg} :\n      NewMutexOk k L ar s reg c g st' → LStep k L (.newMutex c g) (s, reg, ar) (st'.1, st'.2, ar)\n  | acquire {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n      AcquireOk k L s reg c i st' → LStep k L (.acquire c i) (s, reg, ar) (st'.1, st'.2, ar)\n  | unlock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n      UnlockOk L s reg c i st' → LStep k L (.unlock c i) (s, reg, ar) (st'.1, st'.2, ar)\n  | resetLock {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × SyncReg} :\n      ResetLockOk L s reg c i st' → LStep k L (.resetLock c i) (s, reg, ar) (st'.1, st'.2, ar)\n  | spawnVal {s s' : SC} {reg : SyncReg} {ar : ArenaReg} {c : Nat} {ps : List Nat}\n      {ls : LocalShape} {vs : List (Nat × Nat)} :\n      SpawnValStep k s c ps ls vs (.ok s') →\n      LStep k L (.spawnVal c ps ls vs) (s, reg, ar) (s', reg, ar)\n  | newArena {s : SC} {reg : SyncReg} {ar : ArenaReg} {c st i : Nat} {st' : SC × ArenaReg} :\n      NewArenaStepC s reg ar c st i (.ok st') →\n      LStep k L (.newArena c st i) (s, reg, ar) (st'.1, reg, st'.2)\n  | issue {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {region : List Nat} {dst : Nat}\n      {st' : SC × ArenaReg} :\n      IssueStepC k s ar c i region dst (.ok st') →\n      LStep k L (.issue c i region dst) (s, reg, ar) (st'.1, reg, st'.2)\n  | reset {s : SC} {reg : SyncReg} {ar : ArenaReg} {c i : Nat} {st' : SC × ArenaReg} :\n      ResetStepC s ar c i (.ok st') → LStep k L (.reset c i) (s, reg, ar) (st'.1, reg, st'.2)\n\n/-- WC4 C22.3 for the source `src` of a transfer in state `st`: for each live entry, `src` is\nneither the place `slot` holding `guarded`, nor a strict structural subplace of `slot`, nor the\ncontroller leaf `ctl`. -/\ndef TransferExcl (L : MutexLayout) (st : SC × SyncReg) (src : Nat) : Prop :=\n  ∀ e ∈ st.2, e.Live st.1 →\n    OptP (slotOf st.1 e.guarded) (fun q => ¬ partOf st.1.P src q) True ∧\n      ControlOf L st.1 e ≠ some src\n\n/-- Decidability of `TransferExcl` (WC4 C22.3). -/\ninstance (L : MutexLayout) (st : SC × SyncReg) (src : Nat) : Decidable (TransferExcl L st src) := by\n  unfold TransferExcl; infer_instance\n\n/-- WC4 C22.3 for the transfers of the by-value composite (WC4 C23):\nthe source of every transfer phase satisfies `TransferExcl` in the state where that phase starts\n(WC4 C5.2), the registry being `reg`. -/\ndef EncapVals (L : MutexLayout) (reg : SyncReg) (c : Nat) : SC → List (Nat × Nat) → Prop\n  | _, [] => True\n  | t, v :: vs => TransferExcl L (t, reg) v.1 ∧ EncapVals L reg c (transferEffC t c v.1 v.2) vs\n\n/-- Encapsulation of one step in state `st` (hypothesis on traces, WC4 C22, C23): for each live\nentry, WC4 C22.1 (`derive`, `split`), C22.2 (raw `deriveSync`), C22.3 (`transfer`, and the\ntransfer phases of the by-value composite) and C22.5 (`endUse` whose place is the controller leaf\n`ctl` or a strict structural subplace of `slot`). WC4 C22.4 (controller-write protocol) is a\nrealization/interface obligation (WC4 C22) with no content in `S_C`, which has no values (Spec 1\n§41), and is not represented. -/\ndef Encap (L : MutexLayout) (st : SC × SyncReg) : Label → Prop\n  | .kernel _ (.derive src _ _) => ∀ e ∈ st.2, e.Live st.1 → src ≠ e.guarded\n  | .kernel _ (.split src _) => ∀ e ∈ st.2, e.Live st.1 → src ≠ e.guarded\n  | .kernel _ (.transfer src _) => TransferExcl L st src\n  | .kernel _ (.endUse p) => ∀ e ∈ st.2, e.Live st.1 → ControlOf L st.1 e ≠ some p ∧\n      OptP (slotOf st.1 e.guarded) (fun q => partOf st.1.P p q → p = q) True\n  | .spawnVal c _ ls vs => EncapVals L st.2 c (spawnCreate st.1 c ls) vs\n  | .deriveSync _ g => ∀ e ∈ st.2, e.Live st.1 → g ≠ e.guarded\n  | _ => True\n\n/-- Runs of labelled steps. -/\ninductive LRun (k : K) (L : MutexLayout) :\n    SC × SyncReg × ArenaReg → List Label → SC × SyncReg × ArenaReg → Prop where\n  | nil {st : SC × SyncReg × ArenaReg} : LRun k L st [] st\n  | cons {st st₁ st₂ : SC × SyncReg × ArenaReg} {lbl : Label} {lbls : List Label} :\n      LStep k L lbl st st₁ → LRun k L st₁ lbls st₂ → LRun k L st (lbl :: lbls) st₂\n\n/-- `EncapsulatedTrace` (WC4 C22, C23: \"Any lemma conditional on encapsulation must expose that\ncondition in its theorem statement or the reachable-trace assumptions\"): a run every step of which\nsatisfies `Encap` in the state where it is taken, read on the kernel state and the\nsynchronization registry. -/\ninductive EncapsulatedTrace (k : K) (L : MutexLayout) :\n    SC × SyncReg × ArenaReg → List Label → SC × SyncReg × ArenaReg → Prop where","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"29dd53a0-0e65-43f8-a966-b264343bc06d","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlan