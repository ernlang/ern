A.length, ar.internal ∈ s.ancs j → ¬ s.Active j) ∧","   (∀ q ∈ List.range s.P.length, s.Usable q → ∀ x ∈ s.D q, x ≠ ar.internal ∧ ar.internal ∉ s.ancs x)"," "," instance (s : S3) (ar : Arena) : Decidable (ResetPreR s ar) := by","   unfold ResetPreR; infer_instance"," ","-/-- The restricted `reset` is the kernel `ResetPre` with the restricted right. -/","+/-- The restricted `reset` is the kernel `ResetPre` of a live entry with the restricted right. -/"," theorem resetPreR_iff {k : K} {via : Nat} {s : S3} {ar : Arena} :","-    ResetPreR s ar ↔ MetaRightM s ar ∧ ResetPre k s ar via :=","-  ⟨fun ⟨h0, h1, h2⟩ => ⟨h0, .inl h0, h1, h2⟩, fun ⟨h0, ⟨_, h1, h2⟩⟩ => ⟨h0, h1, h2⟩⟩","+    ResetPreR s ar ↔ s.Active ar.internal ∧ MetaRightM s ar ∧ ResetPre k s ar via :=","+  ⟨fun ⟨ha, h0, h1, h2⟩ => ⟨ha, h0, .inl h0, h1, h2⟩,","+   fun ⟨ha, h0, ⟨_, h1, h2⟩⟩ => ⟨ha, h0, h1, h2⟩⟩","+","+/-- The restricted `reset` on the entry `i` of the state (§78.1, \"L'entrée existe et est vivante\"):","+the entry exists and `ResetPreR` holds, as the kernel `ResetAtPre`. -/","+def ResetAtPreR (s : S3) (i : Nat) : Prop := OptP (s.arenas[i]?) (fun ar => ResetPreR s ar) False","+","+instance (s : S3) (i : Nat) : Decidable (ResetAtPreR s i) := by","+  unfold ResetAtPreR; infer_instance","+","+theorem resetAtPreR_iff {s : S3} {i : Nat} :","+    ResetAtPreR s i ↔ ∃ ar, s.arenas[i]? = some ar ∧ ResetPreR s ar := by","+  unfold ResetAtPreR","+  cases h : s.arenas[i]? with","+  | none => simp [OptP]","+  | some ar => simp [OptP]"," "," /-- The footprint of an authority derived, transitively, from `a` lies in the footprint of `a`"," (I2, §42: \"La création de droits dérivés n'accroît ni la portée\"). -/"]},{"oldStart":712,"oldLines":19,"newStart":729,"newLines":19,"lines":[" section ResetAsKernel"," "," variable {k : K} (hdd : DDSound k) {statics : Statics} {s : S3} (hr : Reachable k statics s)","-  {ar : Arena} (har : ar ∈ s.arenas) (hact : s.Active ar.internal)","-include hdd hr har hact","+  {ar : Arena} (har : ar ∈ s.arenas)","+include hdd hr har"," ","-/-- Direction `reset` → sequence (brief, question 1): the restricted `reset` of a live arena gives","-the `ok` of `derive` of `internal` at `Modify` on the storage (O1), then of `release` of the derived","+/-- Direction `reset` → sequence (brief, question 1): the restricted `reset` of an entry gives the","+`ok` of `derive` of `internal` at `Modify` on the storage (O1), then of `release` of the derived"," authority (O3). -/"," theorem reset_to_seq (h : ResetPreR s ar) :","     DeriveStep ar.internal ar.storage .modify s (.ok (deriveEff s ar.internal ar.storage .modify)) ∧","       ReleaseStep s.A.length (deriveEff s ar.internal ar.storage .modify)","         (.ok (releaseEff (deriveEff s ar.internal ar.storage .modify) s.A.length)) := by","   obtain ⟨-, hinv, -, hais⟩ := reachable_invariants hdd hr","+  obtain ⟨hact, hm, h2, -⟩ := h","   have hai := hais ar har hact","-  obtain ⟨hm, h2, -⟩ := h","   obtain ⟨yi, hyi, yia⟩ := hact","   refine ⟨.ok ⟨⟨yi, hyi, yia⟩, (metaRightM_iff hai ⟨yi, hyi, yia⟩).1 hm,","     live_arena_storage_usable hdd hr ar har ⟨yi, hyi, yia⟩, fun l hl => (hai.2.2.2.2.2.2.2 l).2 hl,"]},{"oldStart":762,"oldLines":8,"newStart":779,"newLines":8,"lines":["     (hemp : ∀ j ∈ List.range s.A.length, ar.internal ∈ s.ancs j → s.Active j → s.afp j ≠ [])","     (hanc : ∀ q, s.Usable q → ar.internal ∉ s.D q) : ResetPreR s ar := by","   obtain ⟨hwf, hinv, -, hais⟩ := reachable_invariants hdd hr","+  obtain ⟨⟨hact, hex, -, -, hal⟩, -⟩ := Guarded.ok_iff.1 hd","   have hai := hais ar har hact","-  obtain ⟨⟨-, hex, -, -, hal⟩, -⟩ := Guarded.ok_iff.1 hd","   have h2 : ∀ j ∈ List.range s.A.length, ar.internal ∈ s.ancs j → ¬ s.Active j := by","     intro j hj ha hja","     obtain ⟨l, hl⟩ := List.exists_mem_of_ne_nil _ (hemp j hj ha hja)"]},{"oldStart":777,"oldLines":13,"newStart":794,"newLines":13,"lines":["     rcases effOf_cases hx with ⟨h0, -⟩ | ⟨-, -, h1⟩","     · rw [h0] at hmem; simp at hmem","     · cases h1","-  refine ⟨(metaRightM_iff hai hact).2 hex, h2, fun q _ hq x hx => ⟨fun he => hanc q hq (he ▸ hx),","-    fun hxa => ?_⟩⟩","+  refine ⟨hact, (metaRightM_iff hai hact).2 hex, h2, fun q _ hq x hx =>","+    ⟨fun he => hanc q hq (he ▸ hx), fun hxa => ?_⟩⟩","   obtain ⟨z, hz, za⟩ := hinv.base.2.2.1 q hq x hx","   exact h2 x (List.mem_range.2 (lt_of_getElem? hz)) hxa ⟨z, hz, za⟩"," ","-/-- `reset_as_kernel` (brief, question 1), in reached states, for a live arena: the restricted","-`reset` holds iff `derive` of `internal` at `Modify` on the storage then `release` of the derived","+/-- `reset_as_kernel` (brief, question 1), in reached states, for an entry of the state: the","+restricted `reset` holds iff `derive` of `internal` at `Modify` on the storage then `release` of the derived"," authority are `ok`, no active authority derived from `internal` has an empty footprint, and no"," usable place has `internal` as anchor. The kernel part of the arrival states differs by the released"," authority alone (`reset_seq_arrival`). -/"]},{"oldStart":796,"oldLines":13,"newStart":813,"newLines":13,"lines":["       (∀ q, s.Usable q → ar.internal ∉ s.D q) := by","   constructor","   · intro h","-    obtain ⟨hd, hrl⟩ := reset_to_seq hdd hr har hact h","-    exact ⟨hd, hrl, fun j hj ha hja => absurd hja (h.2.1 j hj ha), fun q hq hx =>","-      (h.2.2 q (List.mem_range.2 hq.lt) hq _ hx).1 rfl⟩","+    obtain ⟨hd, hrl⟩ := reset_to_seq hdd hr har h","+    exact ⟨hd, hrl, fun j hj ha hja => absurd hja (h.2.2.1 j hj ha), fun q hq hx =>","+      (h.2.2.2 q (List.mem_range.2 hq.lt) hq _ hx).1 rfl⟩","   · rintro ⟨hd, hrl, hemp, hanc⟩","-    exact seq_to_reset hdd hr har hact hd hrl hemp hanc","+    exact seq_to_reset hdd hr har hd hrl hemp hanc"," ","-omit har hact in","+omit har in"," /-- Under the strict reading of §78.3 (the subtree of origins of `internal` without `internal`),"," the clause follows from §78.2 and I3 in reached states. -/"," theorem reset_clause3_strict (h2 : ∀ j ∈ List.range s.A.length, ar.internal ∈ s.ancs j → ¬ s.Active j) :"]},{"oldStart":1174,"oldLines":7,"newStart":1191,"newLines":7,"lines":[" usable. -/"," theorem reset_blocked_by_stored_internal {s : S3} {ar : Arena} {v : Nat} (hv : s.Usable v)","     (hx : ar.internal ∈ s.D v) : ¬ ResetPreR s ar :=","-  fun h => (h.2.2 v (List.mem_range.2 hv.lt) hv _ hx).1 rfl","+  fun h => (h.2.2.2 v (List.mem_range.2 hv.lt) hv _ hx).1 rfl"," "," /-- Prefix with an allocated storage: frame 1 with the leaves 0 (arena value), 1 (allocator"," value), 2 and 3 (destinations); `alloc` of the storage 4, of parts 5 and 6, owned by 0, of root"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Derived/Arena.lean"]}},"serverClassifierContext":{"request":"eb788823-32a4-4011-8a31-b24f542425af","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/derivability_0.1","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"f046abdc-619b-4e47-868c-20df1900baff","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"c986905c-e900-4fd9-bebc-4a3ce7ebb180","version":"2.1.309","gitBranch":"formal/derivability_0.1","slug":"effervescent-gathering-wind"}
