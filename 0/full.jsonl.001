 := write3Eff x3 [0]","-def x5 : S3 := newArenaEff x4 4 4","-def x6 : S3 := deriveEff x5 0 0 .observe","-def x7 : S3 := deriveEff x6 2 2 .modify","-def x8 : S3 := pinEff x7 1 true","-def x9 : S3 := enterEff x8 [5, 6] lsE","-def x10 : S3 := arenaSet (issueEff x9 arS [5] 7).1 0 (issueEff x9 arS [5] 7).2","-def x11 : S3 := storeEff x10 5 8","-def x12 : S3 := transferEff x11 7 2","-def x13 : S3 := exitEff x12","-def x14 : S3 := endUseEff x13 2","-def x15 : S3 := resetAtEff x14 0","-def x16 : S3 := pinEff x15 1 false","-def x17 : S3 := freeEff x16 4","-def x18 : S3 := exitEff x17","-","-/-- MM-02 parameters fixed once for the run (): compatibility by equality of tokens (so","-); frame token , provider token  (the allocator at place 1 has the","-token 7); geometry of 16 bytes aligned on 8 for every root; layout: one allocation per root, leaves","-of 8 bytes, the parts 5 and 6 at offsets 0 and 8 of the allocation of 4; pointers of 8 bytes, little","-endian, each byte carrying the provenance; the bytes written in leaf total 64","-drwxr-xr-x  12 guy  staff   384B Oct 28 02:03 .","-drwxr-xr-x@ 14 guy  staff   448B Oct 27 18:19 ..","--rw-r--r--@  1 guy  staff     7B Oct 21 16:42 .gitignore","-drwxr-xr-x@  3 guy  staff    96B Oct 21 16:46 .lake","--rw-r--r--@  1 guy  staff   5.3K Oct 27 17:37 DESIGN.md","-drwxr-xr-x@  6 guy  staff   192B Oct 31 23:21 Ern","--rw-r--r--@  1 guy  staff   172B Oct 31 20:36 Ern.lean","--rw-r--r--@  1 guy  staff     5B Oct 21 16:42 README.md","--rw-r--r--@  1 guy  staff   135B Oct 21 16:43 lake-manifest.json","--rw-r--r--@  1 guy  staff   108B Oct 21 16:44 lakefile.toml","--rw-r--r--@  1 guy  staff    25B Oct 21 16:42 lean-toolchain","-drwxr-xr-x@ 16 guy  staff   512B Oct 31 20:59 reports are . -/","-def C : Nat → Nat → Prop := fun a d => a = d","-def L : Layout := fun q => match q with","-  | 0 => ⟨0, 0, 8⟩ | 1 => ⟨1, 0, 8⟩ | 2 => ⟨2, 0, 8⟩ | 3 => ⟨3, 0, 8⟩ | 4 => ⟨4, 0, 16⟩","-  | 5 => ⟨4, 0, 8⟩ | 6 => ⟨4, 8, 8⟩ | 7 => ⟨5, 0, 8⟩ | 8 => ⟨6, 0, 8⟩ | _ => ⟨99, 0, 0⟩","-def pe : PtrEnc :=","-  ⟨fun addr prov i => ((addr >>> (8 * i)).toUInt8, prov),","-   fun f => (List.range 8).foldl (fun acc i => acc ||| ((f i).1.toNat <<< (8 * i))) 0⟩","-def w : Nat → Nat → UInt8 × Option Nat := fun l i => ((10 * l + i).toUInt8, none)","-def π : Params := ⟨L, fun f => 100 + f, fun pr => 6 + pr, topPlacement, fun _ => ⟨0, 16, 8⟩, pe, w⟩","-/-- Test obligations (K5): , an access aligned on 4 bytes; 4294967295 3384108 srw-rw-rw- 0 guy staff 0 0 \"Jan  1 01:00:00 1970\" \"Jan  1 01:00:00 1970\" \"Jan  1 01:00:00 1970\" \"Jan  1 01:00:00 1970\" 8192 0 0 (stdin), true. -/","-def obR : MM02.ReadOblSpec := ⟨fun _ ac => ac.addr % 4 = 0, fun _ _ => True⟩","-def obW : MM02.WriteOblSpec := ⟨fun _ ac _ => ac.addr % 4 = 0, fun _ _ _ => True⟩","-instance : ∀ s o, Decidable (Op2.Dec obR obW s o) := fun s o => by","-  cases o <;> simp only [Op2.Dec, obR, obW] <;> infer_instance","-","-/-- The ghost  (L4): empty, then the places 4, 5, 6 allocated from the provider 1. -/","-def pv0 : Nat → Option Nat := fun _ => none","-def pvA : Nat → Option Nat := provStep (.alloc 1 0 lsA) x2 pv0","-","-/-- The MM-02 states of the translation: the run of  (no static), then the sequence","-associated with each step (); the steps without MM-02 operation keep the state. -/","-def n0 : MM02.State := exec MM02.State.empty (initOpsOf π [])","-def n1 : MM02.State := exec n0 (assoc π (.enter [] lsC) x0 n0)","-def n2 : MM02.State := exec n1 (assoc π (.write 1 [1] w) x1 n1)","-def n3 : MM02.State := exec n2 (assoc π (.alloc 1 0 lsA) x2 n2)","-def n4 : MM02.State := exec n3 (assoc π (.write 0 [0] w) x3 n3)","-def n9 : MM02.State := exec n4 (assoc π (.enter [5, 6] lsE) x8 n4)","-def n10 : MM02.State := exec n9 (assoc π (.issue 0 5 [5] 7) x9 n9)","-def n11 : MM02.State := exec n10 (assoc π (.store 5 8) x10 n10)","-def n12 : MM02.State := exec n11 (assoc π (.transfer 7 2) x11 n11)","-def n13 : MM02.State := exec n12 (assoc π .exit x12 n12)","-def n17 : MM02.State := exec n13 (assoc π (.free 4 7) x16 n13)","-def n18 : MM02.State := exec n17 (assoc π .exit x17 n17)","-","-/-- A prefix of the execution with its translation, the ghost and the MM-02 state named. -/","-abbrev Run (s3 : S3) (pv : Nat → Option Nat) (s2 : MM02.State) : Prop :=","-  ∃ ops os, SimRun KS C obR obW [] π ops s3 pv os s2","-","-/-- The execution, step by step: each  step of MM-03 (, checked by ) with its","-obligations (:  for  and ,  along its sequence, and","- for , met by the provider 1 of 4 and ). -/","-theorem run0 : Run x0 pv0 n0 := ⟨_, _, .init (by decide) (by decide) trivial⟩","-theorem run1 : Run x1 pv0 n1 := by","-  obtain ⟨_, _, h⟩ := run0","-  exact ⟨_, _, h.step (op := .enter [] lsC) ⟨by decide, .ok (by decide)⟩ ⟨by decide, by decide, trivial⟩⟩","-theorem run2 : Run x2 pv0 n2 := by","-  obtain ⟨_, _, h⟩ := run1","-  exact ⟨_, _, h.step (op := .write 1 [1] w) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run3 : Run x3 pvA n3 := by","-  obtain ⟨_, _, h⟩ := run2","-  exact ⟨_, _, h.step (op := .alloc 1 0 lsA) ⟨⟨0, by decide⟩, .ok (by decide) trivial⟩ ⟨by decide, by decide, trivial⟩⟩","-theorem run4 : Run x4 pvA n4 := by","-  obtain ⟨_, _, h⟩ := run3","-  exact ⟨_, _, h.step (op := .write 0 [0] w) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run5 : Run x5 pvA n4 := by","-  obtain ⟨_, _, h⟩ := run4","-  exact ⟨_, _, h.step (op := .newArena 4 4) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run6 : Run x6 pvA n4 := by","-  obtain ⟨_, _, h⟩ := run5","-  exact ⟨_, _, h.step (op := .derive 0 0 .observe) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run7 : Run x7 pvA n4 := by","-  obtain ⟨_, _, h⟩ := run6","-  exact ⟨_, _, h.step (op := .derive 2 2 .modify) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run8 : Run x8 pvA n4 := by","-  obtain ⟨_, _, h⟩ := run7","-  exact ⟨_, _, h.step (op := .pin 1) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run9 : Run x9 pvA n9 := by","-  obtain ⟨_, _, h⟩ := run8","-  exact ⟨_, _, h.step (op := .enter [5, 6] lsE) ⟨by decide, .ok (by decide)⟩ ⟨by decide, by decide, trivial⟩⟩","-theorem step10 : Step3 KS (.issue 0 5 [5] 7) x9 x10 :=","-  IssueAt.ok (ar := arS) (by decide) (.ok (by decide) (by decide) (by decide) (by decide))","-theorem run10 : Run x10 pvA n10 := by","-  obtain ⟨_, _, h⟩ := run9","-  exact ⟨_, _, h.step step10 ⟨by decide, by decide, trivial⟩⟩","-theorem run11 : Run x11 pvA n11 := by","-  obtain ⟨_, _, h⟩ := run10","-  exact ⟨_, _, h.step (op := .store 5 8) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem step12 : Step3 KS (.transfer 7 2) x11 x12 := .ok (by decide)","-theorem ob12 : Oblig KS C obR obW π (.transfer 7 2) x11 x12 pvA n11 := ⟨trivial, by decide, trivial⟩","-theorem run12 : Run x12 pvA n12 := by","-  obtain ⟨_, _, h⟩ := run11","-  exact ⟨_, _, h.step step12 ob12⟩","-theorem run13 : Run x13 pvA n13 := by","-  obtain ⟨_, _, h⟩ := run12","-  exact ⟨_, _, h.step (op := .exit) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run14 : Run x14 pvA n13 := by","-  obtain ⟨_, _, h⟩ := run13","-  exact ⟨_, _, h.step (op := .endUse 2) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run15 : Run x15 pvA n13 := by","-  obtain ⟨_, _, h⟩ := run14","-  exact ⟨_, _, h.step (op := .reset 0 0) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run16 : Run x16 pvA n13 := by","-  obtain ⟨_, _, h⟩ := run15","-  exact ⟨_, _, h.step (op := .unpin 1) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-theorem run17 : Run x17 pvA n17 := by","-  obtain ⟨_, _, h⟩ := run16","-  exact ⟨_, _, h.step (op := .free 4 7) (.ok (by decide))","-    ⟨trivial, by decide, fun _ => ⟨1, by decide, rfl⟩⟩⟩","-theorem run18 : Run x18 pvA n18 := by","-  obtain ⟨_, _, h⟩ := run17","-  exact ⟨_, _, h.step (op := .exit) (.ok (by decide)) ⟨by decide, by decide, trivial⟩⟩","-","-/--  on every prefix of the run: an MM-02 run from  with only ","-outcomes, reaching the state of the translation, in . -/","-theorem sim {s3 : S3} {pv : Nat → Option Nat} {s2 : MM02.State} (h : Run s3 pv s2) :","-    ∃ os, AllOk C obR obW MM02.State.empty os ∧ exec MM02.State.empty os = s2 ∧","-      Repr π.tok π.ptok pv π.L s3 s2 ∧ Reachable KS [] s3 := by","-  obtain ⟨_, os, h⟩ := h","-  have := simulation (KT_dd _ _ _ _ _) (fun _ _ => trivial) (fun _ _ _ => trivial) topPlacement_ok","-    (fun _ => ⟨(by decide : 0 < 8), (by decide : MM02.Pow2 8)⟩) (fun _ => rfl) h","-  exact ⟨os, this.1, this.2.1, this.2.2.1, this.2.2.2.1⟩","-","-/-- The whole execution: every MM-02 operation ,  at the end; every allocation is dead at","-the end (the storage 4 freed with the token 7, the locals deallocated at the exits). -/","-example : ∃ os, AllOk C obR obW MM02.State.empty os ∧ exec MM02.State.empty os = n18 ∧","-    Repr π.tok π.ptok pvA L x18 n18 := (sim run18).imp fun _ h => ⟨h.1, h.2.1, h.2.2.1⟩","-example : ∀ i < 7, DeadAlloc n18 i := by decide","-example : (n18.allocs 4).map (·.freeAuth) = some (some 7) := by decide","-","-","-/-- The invariants of MM-03 and  on a prefix of the run. -/","-theorem inv {s3 : S3} {pv : Nat → Option Nat} {s2 : MM02.State} (h : Run s3 pv s2) :","-    Repr π.tok π.ptok pv L s3 s2 ∧ WF3 s3 ∧ NoDangling s3 ∧ FpLeaves s3 ∧ Reachable KS [] s3 := by","-  obtain ⟨_, _, -, hR, hr⟩ := sim h","-  exact ⟨hR, (reachable_invariants (KT_dd _ _ _ _ _) hr).1,","-    (reachable_invariants (KT_dd _ _ _ _ _) hr).2.1.nd,","-    (reachable_fpLeaves_frameOwnedLive (KT_dd _ _ _ _ _) hr).1, hr⟩","-","-/--  (L6): R6 on the step of the run, and : the bytes written in the","-destination 7 decode to the address 104 of the leaf 5 (base of the allocation 4 of the storage, plus","-offset 0), and each carries the provenance 4, a live allocation. -/","-example : AllOk C obR obW n9 (issueOps pe n9 L [5] 7) ∧ Repr π.tok π.ptok pvA L x10 n10 := by","-  obtain ⟨hR, hwf, -⟩ := inv run9","-  have := r6_issue (C := C) (ObR := obR) (ObW := obW) (pe := pe) hwf hR step10 (fun _