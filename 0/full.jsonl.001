321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"parentUuid":"57df72be-d091-49e5-ab07-4c926c423fb2","isSidechain":false,"promptId":"ad10e2fd-52be-47f7-a4f7-932245537372","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JaqEJ6tESJFD5pzKGqLJB5","type":"tool_result","content":"1\timport Ern.Concurrency.FullEncap.SpawnValCap\n2\timport Ern.Concurrency.FullEncap.Dying\n3\t\n4\t/-!\n5\t# Last acquire and protected data\n6\t\n7\tBrief of milestone 4, slice 3, complement, task 5 (`corpus-spec2-m3.md` v14 §2 terdecies,\n8\t\"Dernière prise\", \"Donnée protégée, en trois cas\"). On a `RunFull` from the initial state:\n9\t\n10\t* without a grant, the covering descendants of a live entry are empty (`GrantDiscipline`, WC5.2\n11\t  C22, established on the reached states by `trace_inv`);\n12\t* with a grant `g`, every covering descendant is `g` or was created after the last `acquire` of\n13\t  the entry by a step of case 2 of the closure (`last_acquire`);\n14\t* every step touching a protected leaf of an entry live before and after it falls in one of three\n15\t  cases, read on the grant before the step (`three_cases`): no grant, impossible; an active grant,\n16\t  a capacity from `g` or a descendant of `g`; an inactive grant, a capacity from the covering\n17\t  descendants;\n18\t* the fact \"Donnée protégée\" of §2 duodecies, v14 wording (`protected_cap_run`).\n19\t\n20\tThe provenance results do not order accesses: W-AG has a race on the strict graph\n21\t(`W_AG_strict`), and W-AG-J is ordered by `terminate` and `join` (WC5.2 C46).\n22\t-/\n23\t\n24\tset_option autoImplicit false\n25\t\n26\tnamespace Ern.Concurrency.FullEncap\n27\t\n28\topen Ern.MemoryModel Ern.MemoryModel.Access Ern.Concurrency Ern.Concurrency.MutexReal\n29\topen SyncPreserveAux SyncInitAux TransferPreserveAux\n30\t\n31\t/-! ## Capacities and their provenance -/\n32\t\n33\t/-- `Allows` is antitone in the requested mode (Spec 1 §43). -/\n34\ttheorem allows_mono {e : Option Mode} {m m' : Mode} (h : Allows e m') (hm : m.le m') :\n35\t    Allows e m := by\n36\t  cases e with\n37\t  | none => exact h.elim\n38\t  | some x =>\n39\t    show m.le x\n40\t    have h' : m'.le x := h\n41\t    rcases hm with rfl | rfl\n42\t    · exact Or.inl rfl\n43\t    · rcases h' with h1 | h1\n44\t      · cases h1\n45\t      · exact Or.inr h1\n46\t\n47\t/-- The mode order is transitive (Spec 1 §43). -/\n48\ttheorem Mode.le_trans' {m m' m'' : Mode} (h : m.le m') (h' : m'.le m'') : m.le m'' := by\n49\t  rcases h with rfl | rfl\n50\t  · exact Or.inl rfl\n51\t  · rcases h' with h' | h'\n52\t    · cases h'\n53\t    · exact Or.inr h'\n54\t\n55\t/-- `Attr5` is antitone in the requested mode (WC5.2 C43). -/\n56\ttheorem attr5_mono {s : SC} {reg : SyncReg} {c x : Nat} {m m' : Mode} (h : Attr5 s reg c x m')\n57\t    (hm : m.le m') : Attr5 s reg c x m := by\n58\t  induction h with\n59\t  | base hg hy ha hm' hf hin => exact .base hg hy ha (Mode.le_trans' hm hm') hf hin\n60\t  | held hg hy ha hm' hp _ hc ih =>\n61\t    exact .held hg hy ha (Mode.le_trans' hm hm') hp (ih hm) fun l hl => allows_mono (hc l hl) hm\n62\t\n63\t/-- A capacity is attained by an attributable authority (WC5.2 C43, `cap5`). -/\n64\ttheorem cap5_attained {s : SC} {reg : SyncReg} {c l : Nat} {m : Mode}\n65\t    (h : Allows (cap5 s reg c l) m) : ∃ x ∈ List.range s.A.length,\n66\t      Attr5 s reg c x m ∧ Allows (effective s.flat x l) m := by\n67\t  by_cases h1 : CapAt5 s reg c l .modify\n68\t  · obtain ⟨x, hx, ha, he⟩ := h1\n69\t    have hm : m.le .modify := Or.inr rfl\n70\t    exact ⟨x, hx, attr5_mono ha hm, allows_mono he hm⟩\n71\t  · by_cases h2 : CapAt5 s reg c l .observe\n72\t    · simp only [cap5, h1, h2, ↓reduceIte] at h\n73\t      have hm : m = .observe := by\n74\t        rcases (h : m.le .observe) with h | h\n75\t        · exact h\n76\t        · cases h\n77\t      subst hm\n78\t      exact h2\n79\t    · simp only [cap5, h1, h2, ↓reduceIte] at h; exact h.elim\n80\t\n81\t/-- The capacity of `c` on `l` in mode `m`, attained by an authority attributable to `c` without\n82\ta live `guarded` (WC5.2 C43) that belongs to `S` (brief of the complement, \"Capacité de provenance\n83\tdonnée\"). -/\n84\tdef ProvCap (st : SC × SyncReg × ArenaReg) (S : Nat → Prop) (c l : Nat) (m : Mode) : Prop :=\n85\t  ∃ x ∈ List.range st.1.A.length, S x ∧ Attr5 st.1 st.2.1 c x m ∧\n86\t    Allows (effective st.1.flat x l) m\n87\t\n88\t/-- `CapReq` (slice 3, task 4) with every capacity attained from `S`; for the by-value `spawn`,\n89\t`Modify` on the leaves of the sources (task 4 of the complement). -/\n90\tdef CapFrom (k : K) (st : SC × SyncReg × ArenaReg) (S : Nat → Prop) : Label → Nat → Prop\n91\t  | .kernel c (.read _ _), l | .kernel c (.writeShared _ _), l => ProvCap st S c l .observe\n92\t  | .kernel c (.write _ _), l | .kernel c (.store _ _), l | .kernel c (.transfer _ _), l =>\n93\t      ProvCap st S c l .modify\n94\t  | .kernel c (.endUse p), l | .kernel c (.free p _), l =>\n95\t      l ∈ footprint st.1.P p → ProvCap st S c l .modify\n96\t  | .kernel c (.alloc pr ow _), l =>\n97\t      (l ∈ footprint st.1.P pr → ProvCap st S c l .observe ∧\n98\t        (ProvCap st S c l .modify ∨ k.SharedMutable l)) ∧\n99\t      (l = ow → ProvCap st S c l .modify)\n100\t  | .issue c _ _ _, l | .newMutex c _, l => ProvCap st S c l .modify\n101\t  | .acquire c _, l | .unlock c _, l | .resetLock c _, l => ProvCap st S c l .observe\n102\t  | .spawnVal c _ _ vs, l => (∃ v ∈ vs, l ∈ footprint st.1.P v.1) → ProvCap st S c l .modify\n103\t  | _, _ => True\n104\t\n105\t/-- A capacity whose every attaining authority is in `S` is a capacity of provenance `S`. -/\n106\ttheorem prov_of {st : SC × SyncReg × ArenaReg} {S : Nat → Prop} {c l : Nat} {m : Mode}\n107\t    (hS : ∀ x m, Attr5 st.1 st.2.1 c x m → Allows (effective st.1.flat x l) m → S x)\n108\t    (h : Allows (cap5 st.1 st.2.1 c l) m) : ProvCap st S c l m := by\n109\t  obtain ⟨x, hx, ha, he⟩ := cap5_attained h\n110\t  exact ⟨x, hx, hS x m ha he, ha, he⟩\n111\t\n112\t/-- A capacity of provenance `S` is an attributable authority with a present effective mode. -/\n113\ttheorem some_of_prov {st : SC × SyncReg × ArenaReg} {S : Nat → Prop} {c l : Nat} {m : Mode}\n114\t    (h : ProvCap st S c l m) : ∃ x m', Attr5 st.1 st.2.1 c x m' ∧\n115\t      Allows (effective st.1.flat x l) m' :=\n116\t  let ⟨x, _, _, ha, he⟩ := h; ⟨x, m, ha, he⟩\n117\t\n118\t/-- Brief of the complement, task 5, step form: a step touching a leaf `l` that does not die\n119\t(task 3), with the required capacity of slice 3 (`CapReq`) and, for the by-value `spawn`, the\n120\tcapacity on the sources before the step (task 4), is made with the required capacity of\n121\tprovenance `S`, as soon as every attributable authority with a present effective mode on `l` is\n122\tin `S`; and some attributable authority has a present effective mode on `l`. -/\n123\ttheorem capFrom_step {k : K} {L : MutexLayout} {st st' : SC × SyncReg × ArenaReg} {lbl : Label}\n124\t    {l : Nat} {S : Nat → Prop} (hs : LStep k L lbl st st')\n125\t    (hS : ∀ c x m, Attr5 st.1 st.2.1 c x m → Allows (effective st.1.flat x l) m → S x)"}]},"uuid":"535b2da8-ccc7-4f0f-a203-a5d8785fb392","timestamp":"2026-11-12T23:45:43.167Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/LastAcquire.lean","content":"import Ern.Concurrency.FullEncap.SpawnValCap\nimport Ern.Concurrency.FullEncap.Dying\n\n/-!\n# Last acquire and protected data\n\nBrief of milestone 4, slice 3, complement, task 5 (`corpus-spec2-m3.md` v14 §2 terdecies,\n\"Dernière prise\", \"Donnée protégée, en trois cas\"). On a `RunFull` from the initial state:\n\n* without a grant, the covering descendants of a live entry are empty (`GrantDiscipline`, WC5.2\n  C22, established on the reached states by `trace_inv`);\n* with a grant `g`, every covering descendant is `g` or was created after the last `acquire` of\n  the entry by a step of case 2 of the closure (`last_acquire`);\n* every step touching a protected leaf of an entry live before and after it falls in one of three\n  cases, read on the grant before the step (`three_cases`): no grant, impossible; an active grant,\n  a capacity from `g` or a descendant of `g`; an inactive grant, a capacity from the covering\n  descendants;\n* the fact \"Donnée protégée\" of §2 duodecies, v14 wording (`protected_cap_run`).\n\nThe provenance results do not order accesses: W-AG has a race on the strict graph\n(`W_AG_strict`), and W-AG-J is ordered by `terminate` and `join` (WC5.2 C46).\n-/\n\nset_option autoImplicit false\n\nnamespace Ern.Concurrency.FullEncap\n\nopen Ern.MemoryModel Ern.MemoryModel.Access Ern.Concurrency Ern.Concurrency.MutexReal\nopen SyncPreserveAux SyncInitAux TransferPreserveAux\n\n/-! ## Capacities and their provenance -/\n\n/-- `Allows` is antitone in the requested mode (Spec 1 §43). -/\ntheorem allows_mono {e : Option Mode} {m m' : Mode} (h : Allows e m') (hm : m.le m') :\n    Allows e m := by\n  cases e with\n  | none => exact h.elim\n  | some x =>\n    show m.le x\n    have h' : m'.le x := h\n    rcases hm with rfl | rfl\n    · exact Or.inl rfl\n    · rcases h' with h1 | h1\n      · cases h1\n      · exact Or.inr h1\n\n/-- The mode order is transitive (Spec 1 §43). -/\ntheorem Mode.le_trans' {m m' m'' : Mode} (h : m.le m') (h' : m'.le m'') : m.le m'' := by\n  rcases h with rfl | rfl\n  · exact Or.inl rfl\n  · rcases h' with h' | h'\n    · cases h'\n    · exact Or.inr h'\n\n/-- `Attr5` is antitone in the requested mode (WC5.2 C43). -/\ntheorem attr5_mono {s : SC} {reg : SyncReg} {c x : Nat} {m m' : Mode} (h : Attr5 s reg c x m')\n    (hm : m.le m') : Attr5 s reg c x m := by\n  induction h with\n  | base hg hy ha hm' hf hin => exact .base hg hy ha (Mode.le_trans' hm hm') hf hin\n  | held hg hy ha hm' hp _ hc ih =>\n    exact .held hg hy ha (Mode.le_trans' hm hm') hp (ih hm) fun l hl => allows_mono (hc l hl) hm\n\n/-- A capacity is attained by an attributable authority (WC5.2 C43, `cap5`). -/\ntheorem cap5_attained {s : SC} {reg : SyncReg} {c l : Nat} {m : Mode}\n    (h : Allows (cap5 s reg c l) m) : ∃ x ∈ List.range s.A.length,\n      Attr5 s reg c x m ∧ Allows (effective s.flat x l) m := by\n  by_cases h1 : CapAt5 s reg c l .modify\n  · obtain ⟨x, hx, ha, he⟩ := h1\n    have hm : m.le .modify := Or.inr rfl\n    exact ⟨x, hx, attr5_mono ha hm, allows_mono he hm⟩\n  · by_cases h2 : CapAt5 s reg c l .observe\n    · simp only [cap5, h1, h2, ↓reduceIte] at h\n      have hm : m = .observe := by\n        rcases (h : m.le .observe) with h | h\n        · exact h\n        · cases h\n      subst hm\n      exact h2\n    · simp only [cap5, h1, h2, ↓reduceIte] at h; exact h.elim\n\n/-- The capacity of `c` on `l` in mode `m`, attained by an authority attributable to `c` without\na live `guarded` (WC5.2 C43) that belongs to `S` (brief of the complement, \"Capacité de provenance\ndonnée\"). -/\ndef ProvCap (st : SC × SyncReg × ArenaReg) (S : Nat → Prop) (c l : Nat) (m : Mode) : Prop :=\n  ∃ x ∈ List.range st.1.A.length, S x ∧ Attr5 st.1 st.2.1 c x m ∧\n    Allows (effective st.1.flat x l) m\n\n/-- `CapReq` (slice 3, task 4) with every capacity attained from `S`; for the by-value `spawn`,\n`Modify` on the leaves of the sources (task 4 of the complement). -/\ndef CapFrom (k : K) (st : SC × SyncReg × ArenaReg) (S : Nat → Prop) : Label → Nat → Prop\n  | .kernel c (.read _ _), l | .kernel c (.writeShared _ _), l => ProvCap st S c l .observe\n  | .kernel c (.write _ _), l | .kernel c (.store _ _), l | .kernel c (.transfer _ _), l =>\n      ProvCap st S c l .modify\n  | .kernel c (.endUse p), l | .kernel c (.free p _), l =>\n      l ∈ footprint st.1.P p → ProvCap st S c l .modify\n  | .kernel c (.alloc pr ow _), l =>\n      (l ∈ footprint st.1.P pr → ProvCap st S c l .observe ∧\n        (ProvCap st S c l .modify ∨ k.SharedMutable l)) ∧\n      (l = ow → ProvCap st S c l .modify)\n  | .issue c _ _ _, l | .newMutex c _, l => ProvCap st S c l .modify\n  | .acquire c _, l | .unlock c _, l | .resetLock c _, l => ProvCap st S c l .observe\n  | .spawnVal c _ _ vs, l => (∃ v ∈ vs, l ∈ footprint st.1.P v.1) → ProvCap st S c l .modify\n  | _, _ => True\n\n/-- A capacity whose every attaining authority is in `S` is a capacity of provenance `S`. -/\ntheorem prov_of {st : SC × SyncReg × ArenaReg} {S : Nat → Prop} {c l : Nat} {m : Mode}\n    (hS : ∀ x m, Attr5 st.1 st.2.1 c x m → Allows (effective st.1.flat x l) m → S x)\n    (h : Allows (cap5 st.1 st.2.1 c l) m) : ProvCap st S c l m := by\n  obtain ⟨x, hx, ha, he⟩ := cap5_attained h\n  exact ⟨x, hx, hS x m ha he, ha, he⟩\n\n/-- A capacity of provenance `S` is an attributable authority with a present effective mode. -/\ntheorem some_of_prov {st : SC × SyncReg × ArenaReg} {S : Nat → Prop} {c l : Nat} {m : Mode}\n    (h : ProvCap st S c l m) : ∃ x m', Attr5 st.1 st.2.1 c x m' ∧\n      Allows (effective st.1.flat x l) m' :=\n  let ⟨x, _, _, ha, he⟩ := h; ⟨x, m, ha, he⟩\n\n/-- Brief of the complement, task 5, step form: a step touching a leaf `l` that does not die\n(task 3), with the required capacity of slice 3 (`CapReq`) and, for the by-value `spawn`, the\ncapacity on the sources before the step (task 4), is made with the required capacity of\nprovenance `S`, as soon as every attributable authority with a present effective mode on `l` is\nin `S`; and some attributable authority has a present effective mode on `l`. -/\ntheorem capFrom_step {k : K} {L : MutexLayout} {st st' : SC × SyncReg × ArenaReg} {lbl : Label}\n    {l : Nat} {S : Nat → Prop} (hs : LStep k L lbl st st')\n    (hS : ∀ c x m, Attr5 st.1 st.2.1 c x m → Allows (effective st.1.flat x l) m → S x)","numLines":125,"startLine":1,"totalLines":446}},"sourceToolAssistantUUID":"57df72be-d091-49e5-ab07-4c926c423fb2","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"parentUuid":"535b2da8-ccc7-4f0f-a203-a5d8785fb392","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cgyva3u2iXqEwqxNukLVh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01A5iLazoNJYBwsHFRruZzFh","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/LastAcquire.lean","offset":195,"limit":230},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12724,"cache_read_input_tokens":229775,"output_tokens":419,"output_tokens_details":{"thinking_tokens":106},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":12724,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":419,"cache_read_input_tokens":229775,"cache_creation_input_tokens":12724,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12724},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"toolInputStreamMs":1004,"wireToolInputs":{"toolu_01A5iLazoNJYBwsHFRruZzFh":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/LastAcquire.lean","offset":195,"limit":230}},"serverClassifierRequest":"77ec4712-71e9-4a99-9c57-67e3fbc6cf35","apiBlockIndex":3,"requestId":"req_011Cgyva3e9pizH2m1SuMuAJ","requestRef":"d278e16e-2b59-4f89-89ec-4b04ed1e9902","requestedModel":"claude-opus-5-5","promptCacheRequested":"1h","type":"assistant","uuid":"5f975472-8ab9-444f-a5ed-07cc6481b272","timestamp":"2026-11-12T23:45:44.156Z","advisorModel":"claude-fable-5-2","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"parentUuid":"5f975472-8ab9-444f-a5ed-07cc6481b272","isSidechain":false,"promptId":"ad10e2fd-52be-47f7-a4f7-932245537372","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A5iLazoNJYBwsHFRruZzFh","type":"tool_result","content":"195\t\n196\t/-- Brief of the complement, task 5: under I1 (Spec 1 §50) and WC5.2 C21 item 1 (the `guarded` of\n197\ta live entry is active, of own mode `Modify`), an authority that is not a live `guarded` and has a\n198\tpresent effective mode on a leaf of `footprint(guarded)` is a covering descendant of `guarded`:\n199\tan ancestor of `guarded` has no effective mode there (Spec 1 §43.3), and an unrelated one would\n200\tcontradict I1. -/\n201\ttheorem cov_of_attr {L : MutexLayout} {s : SC} {reg : SyncReg} {e : SyncEntry}\n202\t    (hi1 : I1 s.flat) (hinv : SyncInv L s reg) (he : e ∈ reg) (hl : e.Live s) {x l : Nat}\n203\t    (hng : NotGuarded s reg x) (hfp : l ∈ s.flat.afp e.guarded)\n204\t    (hex : effective s.flat x l ≠ none) : CoveringDesc s e.guarded x := by\n205\t  have hg := hinv.guarded e he hl\n206\t  obtain ⟨yg, hyg, ya⟩ := hl\n207\t  have hyg' : s.A[e.guarded]? = some yg := hyg\n208\t  rw [hyg'] at hg\n209\t  obtain ⟨hgm, -⟩ := hg\n210\t  obtain ⟨z, hz, za, hlz, hnm⟩ := eff_present hex\n211\t  have hxg : x ≠ e.guarded := hng e he ⟨yg, hyg, ya⟩\n212\t  have hlg : l ∈ yg.footprint := by rw [afp_of hyg'] at hfp; exact hfp\n213\t  by_cases h1 : x ∈ s.flat.ancs e.guarded\n214\t  · have hmem := mem_descModes (t := s.flat) hyg ya hlg h1\n215\t    rw [hgm] at hmem\n216\t    exact absurd hmem hnm\n217\t  · by_cases h2 : e.guarded ∈ s.flat.ancs x\n218\t    · exact ⟨h2, ⟨z, hz, za⟩, l, by rw [afp_of hz]; exact hlz, hfp⟩\n219\t    · have := hi1 x e.guarded z yg l hxg hz hyg za ya hlz hlg h1 h2\n220\t      rw [hgm] at this; cases this.2\n221\t\n222\t/-! ## The three cases -/\n223\t\n224\t/-- Brief of the complement, task 5, \"Trois cas\": on a `RunFull` from the initial state, under\n225\t`DDSound`, for every step of a context `c`, every entry `e` live before and after it and every\n226\tleaf `l` of `footprint(e.guarded)` in the final footprint of the step, the grant being read before\n227\tthe step:\n228\t* `grant = none`: no such step exists;\n229\t* `grant = some g` with `g` active: `c` has the required capacity (`CapFrom`) attained by `g` or a\n230\t  descendant of `g`;\n231\t* `grant = some g` with `g` inactive: `c` has the required capacity attained by a covering\n232\t  descendant of `e`.\n233\tInvariants used: I1 and WC5.2 C21 item 1 (`cov_of_attr`), C21 item 5 (`GrantSubtree`), C22\n234\t(`GrantDiscipline`); tasks 3 (`protected_not_dying_run`) and 4 (`spawnVal_cap_pre`) and the\n235\tcapacity of slice 3 (`capacity_run`). -/\n236\ttheorem three_cases {k : K} {L : MutexLayout} {statics : Statics}\n237\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n238\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n239\t    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {e : SyncEntry}\n240\t    (he : e ∈ (σ i).2.1) (hl : e.Live (σ i).1) (hl' : e.Live (σ (i + 1)).1) {l : Nat}\n241\t    (hfp : l ∈ (σ i).1.flat.afp e.guarded) (ht : TouchesF L (σ i) lbls[i] l) :\n242\t    (e.grant = none → False) ∧\n243\t    (∀ g, e.grant = some g → (σ i).1.flat.Active g →\n244\t      CapFrom k (σ i) (fun x => x = g ∨ g ∈ (σ i).1.flat.ancs x) lbls[i] l) ∧\n245\t    (∀ g, e.grant = some g → ¬ (σ i).1.flat.Active g →\n246\t      CapFrom k (σ i) (CoveringDesc (σ i).1 e.guarded) lbls[i] l) := by\n247\t  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n248\t  have hinv := hlib.1.1\n249\t  have hi1 := hk.parts.2.2\n250\t  have hw := hk.parts.2.1\n251\t  obtain ⟨yg, hyg, ya⟩ := hl\n252\t  have hfpg : l ∈ yg.footprint := by rw [afp_of hyg] at hfp; exact hfp\n253\t  obtain ⟨hlt, hleaf⟩ := hw.footprints e.guarded yg hyg l hfpg\n254\t  have hcap := capacity_run hdd hstat h0 h hi hleaf hlt ht\n255\t  have hnd := protected_not_dying_run hdd hstat h0 h hi ⟨yg, hyg, ya⟩ hl' hfp\n256\t  have hsv : ∀ c ps ls vs, lbls[i] = .spawnVal c ps ls vs → ∀ v ∈ vs,\n257\t      l ∈ footprint (σ i).1.P v.1 → ∃ x ∈ List.range (σ i).1.A.length,\n258\t        Attr5 (σ i).1 (σ i).2.1 c x .modify ∧ Allows (effective (σ i).1.flat x l) .modify :=\n259\t    fun c ps ls vs hlb v hv hlv => (spawnVal_cap_pre hdd hstat h0 h hi hlb v hv l hlv).1\n260\t  have hcov : ∀ c x m, Attr5 (σ i).1 (σ i).2.1 c x m →\n261\t      Allows (effective (σ i).1.flat x l) m → CoveringDesc (σ i).1 e.guarded x :=\n262\t    fun c x m ha hex => cov_of_attr hi1 hinv he ⟨yg, hyg, ya⟩ ha.notGuarded hfp\n263\t      (ne_none_of_allows hex)\n264\t  obtain ⟨hcf, x, m, hax, hex⟩ := capFrom_step (h i hi).2 hcov hlt hcap hnd hsv ht\n265\t  refine ⟨fun hn => ?_, fun g hg ha => ?_, fun g hg _ => hcf⟩\n266\t  · exact hlib.1.2 e he ⟨yg, hyg, ya⟩ hn _ (List.mem_range.2 (Attr5.lt hax)) (hcov _ x m hax hex)\n267\t  · refine (capFrom_step (S := fun x => x = g ∨ g ∈ (σ i).1.flat.ancs x) (h i hi).2\n268\t      (fun c x m hax hex => ?_) hlt hcap hnd hsv ht).1\n269\t    exact hinv.grantSubtree e he ⟨yg, hyg, ya⟩ g hg ha x (hcov c x m hax hex)\n270\t\n271\t/-- Brief of the complement, task 5, the fact \"Donnée protégée\" of §2 duodecies (v14 wording), for\n272\tthe 28 kinds: on a `RunFull` from the initial state, under `DDSound`, no step touches a leaf\n273\tprotected by an entry live before and after it without its context holding a capacity on that\n274\tleaf outside any chain through a live `guarded` (`cap5`, WC5.2 C43). -/\n275\ttheorem protected_cap_run {k : K} {L : MutexLayout} {statics : Statics}\n276\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n277\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n278\t    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {e : SyncEntry}\n279\t    (hl : e.Live (σ i).1) (hl' : e.Live (σ (i + 1)).1) {l : Nat}\n280\t    (hfp : l ∈ (σ i).1.flat.afp e.guarded) (ht : TouchesF L (σ i) lbls[i] l) :\n281\t    cap5 (σ i).1 (σ i).2.1 lbls[i].ctx l ≠ none := by\n282\t  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n283\t  obtain ⟨yg, hyg, ya⟩ := hl\n284\t  have hfpg : l ∈ yg.footprint := by rw [afp_of hyg] at hfp; exact hfp\n285\t  obtain ⟨hlt, hleaf⟩ := hk.parts.2.1.footprints e.guarded yg hyg l hfpg\n286\t  obtain ⟨-, x, m, hax, hex⟩ := capFrom_step (S := fun _ => True) (h i hi).2\n287\t    (fun _ _ _ _ _ => trivial) hlt (capacity_run hdd hstat h0 h hi hleaf hlt ht)\n288\t    (protected_not_dying_run hdd hstat h0 h hi ⟨yg, hyg, ya⟩ hl' hfp)\n289\t    (fun c ps ls vs hlb v hv hlv => (spawnVal_cap_pre hdd hstat h0 h hi hlb v hv l hlv).1) ht\n290\t  exact ne_none_of_allows (cap5_of hax hex)\n291\t\n292\t/-- Brief of the complement, task 5, \"Ensemble vide sans grant\": on a `RunFull` from the initial\n293\tstate, under `DDSound`, at every index where an entry is live with `grant = none`, its covering\n294\tdescendants are empty (`GrantDiscipline`, WC5.2 C22, on the reached states by `runFull_inv`). -/\n295\ttheorem empty_without_grant {k : K} {L : MutexLayout} {statics : Statics}\n296\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n297\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n298\t    (h : RunFull k L σ lbls) {n : Nat} (hn : n ≤ lbls.length) {e : SyncEntry}\n299\t    (he : e ∈ (σ n).2.1) (hl : e.Live (σ n).1) (hg : e.grant = none) :\n300\t    NoCoveringDesc (σ n).1 e.guarded :=\n301\t  (runFull_inv hdd hstat h0 h hn).2.1.2 e he hl hg\n302\t\n303\t/-! ## Last acquire -/\n304\t\n305\t/-- How a step changes the entry at index `i` of the registry (WC5.2 C12, C13, C16–C18 effects):\n306\tit is unchanged and the step is no `acquire` of `i`; or it has no grant; or the step is an\n307\t`acquire` of `i` that records the fresh identity `|A|` in an entry without grant. -/\n308\ttheorem reg_step {k : K} {L : MutexLayout} {lbl : Label} {st st' : SC × SyncReg × ArenaReg}\n309\t    (hs : LStep k L lbl st st') {i : Nat} {e' : SyncEntry} (he' : st'.2.1[i]? = some e') :\n310\t    (st.2.1[i]? = some e' ∧ ∀ c, lbl ≠ .acquire c i) ∨ e'.grant = none ∨\n311\t    (∃ c e, lbl = .acquire c i ∧ st.2.1[i]? = some e ∧ e.grant = none ∧\n312\t      e' = { e with grant := some st.1.A.length }) := by\n313\t  cases hs with\n314\t  | @newMutex s reg ar c g st₁ hn =>\n315\t    obtain ⟨-, -, rfl⟩ := hn\n316\t    by_cases hi : i < reg.length\n317\t    · refine .inl ⟨?_, fun c' h => by cases h⟩\n318\t      have : (reg ++ [⟨g, none⟩])[i]? = reg[i]? := List.getElem?_append_left hi\n319\t      rw [← this]; exact he'\n320\t    · refine .inr (.inl ?_)\n321\t      have h1 : (reg ++ [(⟨g, none⟩ : SyncEntry)])[i]? = some e' := he'\n322\t      rw [List.getElem?_append_right (Nat.le_of_not_lt hi)] at h1\n323\t      have h2 := List.mem_of_getElem? h1\n324\t      rw [List.mem_singleton] at h2\n325\t      rw [h2]\n326\t  | @acquire s reg ar c i₀ st₁ ha =>\n327\t    obtain ⟨-, e₀, hi₀, ⟨-, hn, -⟩, -, rfl⟩ := ha\n328\t    have h1 : (reg.set i₀ { e₀ with grant := some s.A.length })[i]? = some e' := he'\n329\t    by_cases e : i₀ = i\n330\t    · subst e\n331\t      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n332\t      cases h1\n333\t      exact .inr (.inr ⟨c, e₀, rfl, hi₀, hn, rfl⟩)\n334\t    · rw [List.getElem?_set_ne e] at h1\n335\t      exact .inl ⟨h1, fun c' h => by cases h; exact e rfl⟩\n336\t  | @unlock s reg ar c i₀ st₁ hu =>\n337\t    obtain ⟨-, e₀, g₀, hi₀, -, -, -, -, rfl⟩ := hu\n338\t    have h1 : (reg.set i₀ { e₀ with grant := none })[i]? = some e' := he'\n339\t    by_cases e : i₀ = i\n340\t    · subst e\n341\t      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n342\t      cases h1; exact .inr (.inl rfl)\n343\t    · rw [List.getElem?_set_ne e] at h1\n344\t      exact .inl ⟨h1, fun c' h => by cases h⟩\n345\t  | @resetLock s reg ar c i₀ st₁ hr =>\n346\t    obtain ⟨-, e₀, hi₀, -, -, -, rfl⟩ := hr\n347\t    have h1 : (reg.set i₀ { e₀ with grant := none })[i]? = some e' := he'\n348\t    by_cases e : i₀ = i\n349\t    · subst e\n350\t      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n351\t      cases h1; exact .inr (.inl rfl)\n352\t    · rw [List.getElem?_set_ne e] at h1\n353\t      exact .inl ⟨h1, fun c' h => by cases h⟩\n354\t  | kernel => exact .inl ⟨he', fun c' h => by cases h⟩\n355\t  | spawn => exact .inl ⟨he', fun c' h => by cases h⟩\n356\t  | terminate => exact .inl ⟨he', fun c' h => by cases h⟩\n357\t  | join => exact .inl ⟨he', fun c' h => by cases h⟩\n358\t  | deriveSync => exact .inl ⟨he', fun c' h => by cases h⟩\n359\t  | spawnVal => exact .inl ⟨he', fun c' h => by cases h⟩\n360\t  | newArena => exact .inl ⟨he', fun c' h => by cases h⟩\n361\t  | issue => exact .inl ⟨he', fun c' h => by cases h⟩\n362\t  | reset => exact .inl ⟨he', fun c' h => by cases h⟩\n363\t\n364\t/-- Brief of the complement, task 5, \"Dernière prise\": on a `RunFull` from the initial state,\n365\tunder `DDSound`, at every index `n` where the entry at index `i` of the registry is live with\n366\t`grant = some g`, there is a last successful `acquire` of `i` before `n`, at index `k`, which\n367\trecorded `g` (the fresh identity `|A|` of WC5.2 C16), and every covering descendant of the entry\n368\tis `g` or was created by a step `k'` with `k < k' < n` of case 2 of the closure (created from a\n369\tcovering descendant of the state before that step). No history of origins is kept in the state:\n370\tthe induction runs on the indices of the run. -/\n371\ttheorem last_acquire {k : K} {L : MutexLayout} {statics : Statics}\n372\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n373\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n374\t    (h : RunFull k L σ lbls) :\n375\t    ∀ n, n ≤ lbls.length → ∀ i e, (σ n).2.1[i]? = some e → e.Live (σ n).1 → ∀ g,\n376\t      e.grant = some g → ∃ kk, kk < n ∧ (∃ c, lbls[kk]? = some (.acquire c i)) ∧\n377\t        (∀ k', kk < k' → k' < n → ∀ c, lbls[k']? ≠ some (.acquire c i)) ∧\n378\t        g = (σ kk).1.A.length ∧\n379\t        ∀ j, CoveringDesc (σ n).1 e.guarded j → j = g ∨ ∃ k', kk < k' ∧ k' < n ∧\n380\t          (σ k').1.A.length ≤ j ∧ j < (σ (k' + 1)).1.A.length ∧\n381\t          ∃ o, (σ (k' + 1)).1.flat.org j = some o ∧ CoveringDesc (σ k').1 e.guarded o\n382\t  | 0, _, i, e, he, _, _, _ => by rw [h0] at he; cases he\n383\t  | n + 1, hn, i, e, he, hl, g, hg => by\n384\t    have hn' : n < lbls.length := hn\n385\t    obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hn')\n386\t    have hinv := hlib.1.1\n387\t    have hs := (h n hn').2\n388\t    obtain ⟨hsk, -⟩ := shape_step hk hlib.2.1 (h n hn').1.1.1.1.1 hs\n389\t    have hcl := closure_run hdd hstat h0 h hn'\n390\t    have hlbl : lbls[n]? = some lbls[n] := List.getElem?_eq_getElem hn'\n391\t    rcases reg_step hs he with ⟨he₀, hna⟩ | hgn | ⟨c, e₀, hacq, he₀, hn₀, rfl⟩\n392\t    · have hb := hinv.regBound e (List.mem_of_getElem? he₀)\n393\t      have hl₀ : e.Live (σ n).1 := hsk.active hb hl\n394\t      obtain ⟨kk, hkk, hacq, hlast, hgk, hcov⟩ :=\n395\t        last_acquire hdd hstat h0 h n (Nat.le_of_lt hn') i e he₀ hl₀ g hg\n396\t      refine ⟨kk, by omega, hacq, fun k' h1 h2 c => ?_, hgk, fun j hj => ?_⟩\n397\t      · by_cases hk' : k' < n\n398\t        · exact hlast k' h1 hk' c\n399\t        · have : k' = n := by omega\n400\t          subst this\n401\t          rw [hlbl]; intro heq\n402\t          exact hna c (Option.some.inj heq)\n403\t      · rcases hcl e (List.mem_of_getElem? he₀) hl₀ hl j\n404\t          (List.mem_range.2 (active_lt hj.2.1)) hj with h1 | ⟨h1, o, ho, h2⟩ | h3\n405\t        · rcases hcov j h1 with h | ⟨k', a1, a2, a3⟩\n406\t          · exact .inl h\n407\t          · exact .inr ⟨k', a1, by omega, a3⟩\n408\t        · exact .inr ⟨n, hkk, Nat.lt_succ_self n, h1, active_lt hj.2.1, o, ho, h2⟩\n409\t        · exfalso\n410\t          revert h3\n411\t          unfold GrantOf\n412\t          split\n413\t          · rename_i c' i'' heq\n414\t            intro h3\n415\t            have hne : i'' ≠ i := fun hh => hna c' (by rw [heq, hh])\n416\t            revert h3\n417\t            cases hx : (σ n).2.1[i'']? with\n418\t            | none => exact id\n419\t            | some x =>\n420\t              rintro ⟨hgx, -⟩\n421\t              have hlx : x.Live (σ n).1 := by unfold SyncEntry.Live; rw [hgx]; exact hl₀\n422\t              exact hne (hinv.unique i'' i x e hx he₀ hlx hl₀ hgx)\n423\t          · exact id\n424\t    · rw [hgn] at hg; cases hg"}]},"uuid":"2a29663a-6080-41a5-a66c-fd788c18e209","timestamp":"2026-11-12T23:45:44.173Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/LastAcquire.lean","content":"\n/-- Brief of the complement, task 5: under I1 (Spec 1 §50) and WC5.2 C21 item 1 (the `guarded` of\na live entry is active, of own mode `Modify`), an authority that is not a live `guarded` and has a\npresent effective mode on a leaf of `footprint(guarded)` is a covering descendant of `guarded`:\nan ancestor of `guarded` has no effective mode there (Spec 1 §43.3), and an unrelated one would\ncontradict I1. -/\ntheorem cov_of_attr {L : MutexLayout} {s : SC} {reg : SyncReg} {e : SyncEntry}\n    (hi1 : I1 s.flat) (hinv : SyncInv L s reg) (he : e ∈ reg) (hl : e.Live s) {x l : Nat}\n    (hng : NotGuarded s reg x) (hfp : l ∈ s.flat.afp e.guarded)\n    (hex : effective s.flat x l ≠ none) : CoveringDesc s e.guarded x := by\n  have hg := hinv.guarded e he hl\n  obtain ⟨yg, hyg, ya⟩ := hl\n  have hyg' : s.A[e.guarded]? = some yg := hyg\n  rw [hyg'] at hg\n  obtain ⟨hgm, -⟩ := hg\n  obtain ⟨z, hz, za, hlz, hnm⟩ := eff_present hex\n  have hxg : x ≠ e.guarded := hng e he ⟨yg, hyg, ya⟩\n  have hlg : l ∈ yg.footprint := by rw [afp_of hyg'] at hfp; exact hfp\n  by_cases h1 : x ∈ s.flat.ancs e.guarded\n  · have hmem := mem_descModes (t := s.flat) hyg ya hlg h1\n    rw [hgm] at hmem\n    exact absurd hmem hnm\n  · by_cases h2 : e.guarded ∈ s.flat.ancs x\n    · exact ⟨h2, ⟨z, hz, za⟩, l, by rw [afp_of hz]; exact hlz, hfp⟩\n    · have := hi1 x e.guarded z yg l hxg hz hyg za ya hlz hlg h1 h2\n      rw [hgm] at this; cases this.2\n\n/-! ## The three cases -/\n\n/-- Brief of the complement, task 5, \"Trois cas\": on a `RunFull` from the initial state, under\n`DDSound`, for every step of a context `c`, every entry `e` live before and after it and every\nleaf `l` of `footprint(e.guarded)` in the final footprint of the step, the grant being read before\nthe step:\n* `grant = none`: no such step exists;\n* `grant = some g` with `g` active: `c` has the required capacity (`CapFrom`) attained by `g` or a\n  descendant of `g`;\n* `grant = some g` with `g` inactive: `c` has the required capacity attained by a covering\n  descendant of `e`.\nInvariants used: I1 and WC5.2 C21 item 1 (`cov_of_attr`), C21 item 5 (`GrantSubtree`), C22\n(`GrantDiscipline`); tasks 3 (`protected_not_dying_run`) and 4 (`spawnVal_cap_pre`) and the\ncapacity of slice 3 (`capacity_run`). -/\ntheorem three_cases {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {e : SyncEntry}\n    (he : e ∈ (σ i).2.1) (hl : e.Live (σ i).1) (hl' : e.Live (σ (i + 1)).1) {l : Nat}\n    (hfp : l ∈ (σ i).1.flat.afp e.guarded) (ht : TouchesF L (σ i) lbls[i] l) :\n    (e.grant = none → False) ∧\n    (∀ g, e.grant = some g → (σ i).1.flat.Active g →\n      CapFrom k (σ i) (fun x => x = g ∨ g ∈ (σ i).1.flat.ancs x) lbls[i] l) ∧\n    (∀ g, e.grant = some g → ¬ (σ i).1.flat.Active g →\n      CapFrom k (σ i) (CoveringDesc (σ i).1 e.guarded) lbls[i] l) := by\n  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n  have hinv := hlib.1.1\n  have hi1 := hk.parts.2.2\n  have hw := hk.parts.2.1\n  obtain ⟨yg, hyg, ya⟩ := hl\n  have hfpg : l ∈ yg.footprint := by rw [afp_of hyg] at hfp; exact hfp\n  obtain ⟨hlt, hleaf⟩ := hw.footprints e.guarded yg hyg l hfpg\n  have hcap := capacity_run hdd hstat h0 h hi hleaf hlt ht\n  have hnd := protected_not_dying_run hdd hstat h0 h hi ⟨yg, hyg, ya⟩ hl' hfp\n  have hsv : ∀ c ps ls vs, lbls[i] = .spawnVal c ps ls vs → ∀ v ∈ vs,\n      l ∈ footprint (σ i).1.P v.1 → ∃ x ∈ List.range (σ i).1.A.length,\n        Attr5 (σ i).1 (σ i).2.1 c x .modify ∧ Allows (effective (σ i).1.flat x l) .modify :=\n    fun c ps ls vs hlb v hv hlv => (spawnVal_cap_pre hdd hstat h0 h hi hlb v hv l hlv).1\n  have hcov : ∀ c x m, Attr5 (σ i).1 (σ i).2.1 c x m →\n      Allows (effective (σ i).1.flat x l) m → CoveringDesc (σ i).1 e.guarded x :=\n    fun c x m ha hex => cov_of_attr hi1 hinv he ⟨yg, hyg, ya⟩ ha.notGuarded hfp\n      (ne_none_of_allows hex)\n  obtain ⟨hcf, x, m, hax, hex⟩ := capFrom_step (h i hi).2 hcov hlt hcap hnd hsv ht\n  refine ⟨fun hn => ?_, fun g hg ha => ?_, fun g hg _ => hcf⟩\n  · exact hlib.1.2 e he ⟨yg, hyg, ya⟩ hn _ (List.mem_range.2 (Attr5.lt hax)) (hcov _ x m hax hex)\n  · refine (capFrom_step (S := fun x => x = g ∨ g ∈ (σ i).1.flat.ancs x) (h i hi).2\n      (fun c x m hax hex => ?_) hlt hcap hnd hsv ht).1\n    exact hinv.grantSubtree e he ⟨yg, hyg, ya⟩ g hg ha x (hcov c x m hax hex)\n\n/-- Brief of the complement, task 5, the fact \"Donnée protégée\" of §2 duodecies (v14 wording), for\nthe 28 kinds: on a `RunFull` from the initial state, under `DDSound`, no step touches a leaf\nprotected by an entry live before and after it without its context holding a capacity on that\nleaf outside any chain through a live `guarded` (`cap5`, WC5.2 C43). -/\ntheorem protected_cap_run {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {e : SyncEntry}\n    (hl : e.Live (σ i).1) (hl' : e.Live (σ (i + 1)).1) {l : Nat}\n    (hfp : l ∈ (σ i).1.flat.afp e.guarded) (ht : TouchesF L (σ i) lbls[i] l) :\n    cap5 (σ i).1 (σ i).2.1 lbls[i].ctx l ≠ none := by\n  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n  obtain ⟨yg, hyg, ya⟩ := hl\n  have hfpg : l ∈ yg.footprint := by rw [afp_of hyg] at hfp; exact hfp\n  obtain ⟨hlt, hleaf⟩ := hk.parts.2.1.footprints e.guarded yg hyg l hfpg\n  obtain ⟨-, x, m, hax, hex⟩ := capFrom_step (S := fun _ => True) (h i hi).2\n    (fun _ _ _ _ _ => trivial) hlt (capacity_run hdd hstat h0 h hi hleaf hlt ht)\n    (protected_not_dying_run hdd hstat h0 h hi ⟨yg, hyg, ya⟩ hl' hfp)\n    (fun c ps ls vs hlb v hv hlv => (spawnVal_cap_pre hdd hstat h0 h hi hlb v hv l hlv).1) ht\n  exact ne_none_of_allows (cap5_of hax hex)\n\n/-- Brief of the complement, task 5, \"Ensemble vide sans grant\": on a `RunFull` from the initial\nstate, under `DDSound`, at every index where an entry is live with `grant = none`, its covering\ndescendants are empty (`GrantDiscipline`, WC5.2 C22, on the reached states by `runFull_inv`). -/\ntheorem empty_without_grant {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) {n : Nat} (hn : n ≤ lbls.length) {e : SyncEntry}\n    (he : e ∈ (σ n).2.1) (hl : e.Live (σ n).1) (hg : e.grant = none) :\n    NoCoveringDesc (σ n).1 e.guarded :=\n  (runFull_inv hdd hstat h0 h hn).2.1.2 e he hl hg\n\n/-! ## Last acquire -/\n\n/-- How a step changes the entry at index `i` of the registry (WC5.2 C12, C13, C16–C18 effects):\nit is unchanged and the step is no `acquire` of `i`; or it has no grant; or the step is an\n`acquire` of `i` that records the fresh identity `|A|` in an entry without grant. -/\ntheorem reg_step {k : K} {L : MutexLayout} {lbl : Label} {st st' : SC × SyncReg × ArenaReg}\n    (hs : LStep k L lbl st st') {i : Nat} {e' : SyncEntry} (he' : st'.2.1[i]? = some e') :\n    (st.2.1[i]? = some e' ∧ ∀ c, lbl ≠ .acquire c i) ∨ e'.grant = none ∨\n    (∃ c e, lbl = .acquire c i ∧ st.2.1[i]? = some e ∧ e.grant = none ∧\n      e' = { e with grant := some st.1.A.length }) := by\n  cases hs with\n  | @newMutex s reg ar c g st₁ hn =>\n    obtain ⟨-, -, rfl⟩ := hn\n    by_cases hi : i < reg.length\n    · refine .inl ⟨?_, fun c' h => by cases h⟩\n      have : (reg ++ [⟨g, none⟩])[i]? = reg[i]? := List.getElem?_append_left hi\n      rw [← this]; exact he'\n    · refine .inr (.inl ?_)\n      have h1 : (reg ++ [(⟨g, none⟩ : SyncEntry)])[i]? = some e' := he'\n      rw [List.getElem?_append_right (Nat.le_of_not_lt hi)] at h1\n      have h2 := List.mem_of_getElem? h1\n      rw [List.mem_singleton] at h2\n      rw [h2]\n  | @acquire s reg ar c i₀ st₁ ha =>\n    obtain ⟨-, e₀, hi₀, ⟨-, hn, -⟩, -, rfl⟩ := ha\n    have h1 : (reg.set i₀ { e₀ with grant := some s.A.length })[i]? = some e' := he'\n    by_cases e : i₀ = i\n    · subst e\n      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n      cases h1\n      exact .inr (.inr ⟨c, e₀, rfl, hi₀, hn, rfl⟩)\n    · rw [List.getElem?_set_ne e] at h1\n      exact .inl ⟨h1, fun c' h => by cases h; exact e rfl⟩\n  | @unlock s reg ar c i₀ st₁ hu =>\n    obtain ⟨-, e₀, g₀, hi₀, -, -, -, -, rfl⟩ := hu\n    have h1 : (reg.set i₀ { e₀ with grant := none })[i]? = some e' := he'\n    by_cases e : i₀ = i\n    · subst e\n      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n      cases h1; exact .inr (.inl rfl)\n    · rw [List.getElem?_set_ne e] at h1\n      exact .inl ⟨h1, fun c' h => by cases h⟩\n  | @resetLock s reg ar c i₀ st₁ hr =>\n    obtain ⟨-, e₀, hi₀, -, -, -, rfl⟩ := hr\n    have h1 : (reg.set i₀ { e₀ with grant := none })[i]? = some e' := he'\n    by_cases e : i₀ = i\n    · subst e\n      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n      cases h1; exact .inr (.inl rfl)\n    · rw [List.getElem?_set_ne e] at h1\n      exact .inl ⟨h1, fun c' h => by cases h⟩\n  | kernel => exact .inl ⟨he', fun c' h => by cases h⟩\n  | spawn => exact .inl ⟨he', fun c' h => by cases h⟩\n  | terminate => exact .inl ⟨he', fun c' h => by cases h⟩\n  | join => exact .inl ⟨he', fun c' h => by cases h⟩\n  | deriveSync => exact .inl ⟨he', fun c' h => by cases h⟩\n  | spawnVal => exact .inl ⟨he', fun c' h => by cases h⟩\n  | newArena => exact .inl ⟨he', fun c' h => by cases h⟩\n  | issue => exact .inl ⟨he', fun c' h => by cases h⟩\n  | reset => exact .inl ⟨he', fun c' h => by cases h⟩\n\n/-- Brief of the complement, task 5, \"Dernière prise\": on a `RunFull` from the initial state,\nunder `DDSound`, at every index `n` where the entry at index `i` of the registry is live with\n`grant = some g`, there is a last successful `acquire` of `i` before `n`, at index `k`, which\nrecorded `g` (the fresh identity `|A|` of WC5.2 C16), and every covering descendant of the entry\nis `g` or was created by a step `k'` with `k < k' < n` of case 2 of the closure (created from a\ncovering descendant of the state before that step). No history of origins is kept in the state:\nthe induction runs on the indices of the run. -/\ntheorem last_acquire {k : K} {L : MutexLayout} {statics : Statics}\n    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n    (h : RunFull k L σ lbls) :\n    ∀ n, n ≤ lbls.length → ∀ i e, (σ n).2.1[i]? = some e → e.Live (σ n).1 → ∀ g,\n      e.grant = some g → ∃ kk, kk < n ∧ (∃ c, lbls[kk]? = some (.acquire c i)) ∧\n        (∀ k', kk < k' → k' < n → ∀ c, lbls[k']? ≠ some (.acquire c i)) ∧\n        g = (σ kk).1.A.length ∧\n        ∀ j, CoveringDesc (σ n).1 e.guarded j → j = g ∨ ∃ k', kk < k' ∧ k' < n ∧\n          (σ k').1.A.length ≤ j ∧ j < (σ (k' + 1)).1.A.length ∧\n          ∃ o, (σ (k' + 1)).1.flat.org j = some o ∧ CoveringDesc (σ k').1 e.guarded o\n  | 0, _, i, e, he, _, _, _ => by rw [h0] at he; cases he\n  | n + 1, hn, i, e, he, hl, g, hg => by\n    have hn' : n < lbls.length := hn\n    obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hn')\n    have hinv := hlib.1.1\n    have hs := (h n hn').2\n    obtain ⟨hsk, -⟩ := shape_step hk hlib.2.1 (h n hn').1.1.1.1.1 hs\n    have hcl := closure_run hdd hstat h0 h hn'\n    have hlbl : lbls[n]? = some lbls[n] := List.getElem?_eq_getElem hn'\n    rcases reg_step hs he with ⟨he₀, hna⟩ | hgn | ⟨c, e₀, hacq, he₀, hn₀, rfl⟩\n    · have hb := hinv.regBound e (List.mem_of_getElem? he₀)\n      have hl₀ : e.Live (σ n).1 := hsk.active hb hl\n      obtain ⟨kk, hkk, hacq, hlast, hgk, hcov⟩ :=\n        last_acquire hdd hstat h0 h n (Nat.le_of_lt hn') i e he₀ hl₀ g hg\n      refine ⟨kk, by omega, hacq, fun k' h1 h2 c => ?_, hgk, fun j hj => ?_⟩\n      · by_cases hk' : k' < n\n        · exact hlast k' h1 hk' c\n        · have : k' = n := by omega\n          subst this\n          rw [hlbl]; intro heq\n          exact hna c (Option.some.inj heq)\n      · rcases hcl e (List.mem_of_getElem? he₀) hl₀ hl j\n          (List.mem_range.2 (active_lt hj.2.1)) hj with h1 | ⟨h1, o, ho, h2⟩ | h3\n        · rcases hcov j h1 with h | ⟨k', a1, a2, a3⟩\n          · exact .inl h\n          · exact .inr ⟨k', a1, by omega, a3⟩\n        · exact .inr ⟨n, hkk, Nat.lt_succ_self n, h1, active_lt hj.2.1, o, ho, h2⟩\n        · exfalso\n          revert h3\n          unfold GrantOf\n          split\n          · rename_i c' i'' heq\n            intro h3\n            have hne : i'' ≠ i := fun hh => hna c' (by rw [heq, hh])\n            revert h3\n            cases hx : (σ n).2.1[i'']? with\n            | none => exact id\n            | some x =>\n              rintro ⟨hgx, -⟩\n              have hlx : x.Live (σ n).1 := by unfold SyncEntry.Live; rw [hgx]; exact hl₀\n              exact hne (hinv.unique i'' i x e hx he₀ hlx hl₀ hgx)\n          · exact id\n    · rw [hgn] at hg; cases hg","numLines":230,"startLine":195,"totalLines":446}},"sourceToolAssistantUUID":"5f975472-8ab9-444f-a5ed-07cc6481b272","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"51dfe5fb3d028d00b6cf1153a50cc3f8e1003f1a3ee95ba6bd3be14a16ac7165","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Reading the task 5 statements (LastAcquire.lean) to quote hypotheses exactly."},{"type":"tool_use","id":"toolu_01JaqEJ6tESJFD5pzKGqLJB5","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/LastAcquire.lean","offset":1,"limit":125},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01A5iLazoNJYBwsHFRruZzFh","name":"Read","input":{"file_path":"/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/LastAcquire.lean","offset":195,"limit":230},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","hash":"337be283b7d35eedb45503047bd87922dc84b7ee23bf6515ef72ffa851b564b7","message":{"role":"user","content":[{"tool_use_id":"toolu_01JaqEJ6tESJFD5pzKGqLJB5","type":"tool_result","content":"1\timport Ern.Concurrency.FullEncap.SpawnValCap\n2\timport Ern.Concurrency.FullEncap.Dying\n3\t\n4\t/-!\n5\t# Last acquire and protected data\n6\t\n7\tBrief of milestone 4, slice 3, complement, task 5 (`corpus-spec2-m3.md` v14 §2 terdecies,\n8\t\"Dernière prise\", \"Donnée protégée, en trois cas\"). On a `RunFull` from the initial state:\n9\t\n10\t* without a grant, the covering descendants of a live entry are empty (`GrantDiscipline`, WC5.2\n11\t  C22, established on the reached states by `trace_inv`);\n12\t* with a grant `g`, every covering descendant is `g` or was created after the last `acquire` of\n13\t  the entry by a step of case 2 of the closure (`last_acquire`);\n14\t* every step touching a protected leaf of an entry live before and after it falls in one of three\n15\t  cases, read on the grant before the step (`three_cases`): no grant, impossible; an active grant,\n16\t  a capacity from `g` or a descendant of `g`; an inactive grant, a capacity from the covering\n17\t  descendants;\n18\t* the fact \"Donnée protégée\" of §2 duodecies, v14 wording (`protected_cap_run`).\n19\t\n20\tThe provenance results do not order accesses: W-AG has a race on the strict graph\n21\t(`W_AG_strict`), and W-AG-J is ordered by `terminate` and `join` (WC5.2 C46).\n22\t-/\n23\t\n24\tset_option autoImplicit false\n25\t\n26\tnamespace Ern.Concurrency.FullEncap\n27\t\n28\topen Ern.MemoryModel Ern.MemoryModel.Access Ern.Concurrency Ern.Concurrency.MutexReal\n29\topen SyncPreserveAux SyncInitAux TransferPreserveAux\n30\t\n31\t/-! ## Capacities and their provenance -/\n32\t\n33\t/-- `Allows` is antitone in the requested mode (Spec 1 §43). -/\n34\ttheorem allows_mono {e : Option Mode} {m m' : Mode} (h : Allows e m') (hm : m.le m') :\n35\t    Allows e m := by\n36\t  cases e with\n37\t  | none => exact h.elim\n38\t  | some x =>\n39\t    show m.le x\n40\t    have h' : m'.le x := h\n41\t    rcases hm with rfl | rfl\n42\t    · exact Or.inl rfl\n43\t    · rcases h' with h1 | h1\n44\t      · cases h1\n45\t      · exact Or.inr h1\n46\t\n47\t/-- The mode order is transitive (Spec 1 §43). -/\n48\ttheorem Mode.le_trans' {m m' m'' : Mode} (h : m.le m') (h' : m'.le m'') : m.le m'' := by\n49\t  rcases h with rfl | rfl\n50\t  · exact Or.inl rfl\n51\t  · rcases h' with h' | h'\n52\t    · cases h'\n53\t    · exact Or.inr h'\n54\t\n55\t/-- `Attr5` is antitone in the requested mode (WC5.2 C43). -/\n56\ttheorem attr5_mono {s : SC} {reg : SyncReg} {c x : Nat} {m m' : Mode} (h : Attr5 s reg c x m')\n57\t    (hm : m.le m') : Attr5 s reg c x m := by\n58\t  induction h with\n59\t  | base hg hy ha hm' hf hin => exact .base hg hy ha (Mode.le_trans' hm hm') hf hin\n60\t  | held hg hy ha hm' hp _ hc ih =>\n61\t    exact .held hg hy ha (Mode.le_trans' hm hm') hp (ih hm) fun l hl => allows_mono (hc l hl) hm\n62\t\n63\t/-- A capacity is attained by an attributable authority (WC5.2 C43, `cap5`). -/\n64\ttheorem cap5_attained {s : SC} {reg : SyncReg} {c l : Nat} {m : Mode}\n65\t    (h : Allows (cap5 s reg c l) m) : ∃ x ∈ List.range s.A.length,\n66\t      Attr5 s reg c x m ∧ Allows (effective s.flat x l) m := by\n67\t  by_cases h1 : CapAt5 s reg c l .modify\n68\t  · obtain ⟨x, hx, ha, he⟩ := h1\n69\t    have hm : m.le .modify := Or.inr rfl\n70\t    exact ⟨x, hx, attr5_mono ha hm, allows_mono he hm⟩\n71\t  · by_cases h2 : CapAt5 s reg c l .observe\n72\t    · simp only [cap5, h1, h2, ↓reduceIte] at h\n73\t      have hm : m = .observe := by\n74\t        rcases (h : m.le .observe) with h | h\n75\t        · exact h\n76\t        · cases h\n77\t      subst hm\n78\t      exact h2\n79\t    · simp only [cap5, h1, h2, ↓reduceIte] at h; exact h.elim\n80\t\n81\t/-- The capacity of `c` on `l` in mode `m`, attained by an authority attributable to `c` without\n82\ta live `guarded` (WC5.2 C43) that belongs to `S` (brief of the complement, \"Capacité de provenance\n83\tdonnée\"). -/\n84\tdef ProvCap (st : SC × SyncReg × ArenaReg) (S : Nat → Prop) (c l : Nat) (m : Mode) : Prop :=\n85\t  ∃ x ∈ List.range st.1.A.length, S x ∧ Attr5 st.1 st.2.1 c x m ∧\n86\t    Allows (effective st.1.flat x l) m\n87\t\n88\t/-- `CapReq` (slice 3, task 4) with every capacity attained from `S`; for the by-value `spawn`,\n89\t`Modify` on the leaves of the sources (task 4 of the complement). -/\n90\tdef CapFrom (k : K) (st : SC × SyncReg × ArenaReg) (S : Nat → Prop) : Label → Nat → Prop\n91\t  | .kernel c (.read _ _), l | .kernel c (.writeShared _ _), l => ProvCap st S c l .observe\n92\t  | .kernel c (.write _ _), l | .kernel c (.store _ _), l | .kernel c (.transfer _ _), l =>\n93\t      ProvCap st S c l .modify\n94\t  | .kernel c (.endUse p), l | .kernel c (.free p _), l =>\n95\t      l ∈ footprint st.1.P p → ProvCap st S c l .modify\n96\t  | .kernel c (.alloc pr ow _), l =>\n97\t      (l ∈ footprint st.1.P pr → ProvCap st S c l .observe ∧\n98\t        (ProvCap st S c l .modify ∨ k.SharedMutable l)) ∧\n99\t      (l = ow → ProvCap st S c l .modify)\n100\t  | .issue c _ _ _, l | .newMutex c _, l => ProvCap st S c l .modify\n101\t  | .acquire c _, l | .unlock c _, l | .resetLock c _, l => ProvCap st S c l .observe\n102\t  | .spawnVal c _ _ vs, l => (∃ v ∈ vs, l ∈ footprint st.1.P v.1) → ProvCap st S c l .modify\n103\t  | _, _ => True\n104\t\n105\t/-- A capacity whose every attaining authority is in `S` is a capacity of provenance `S`. -/\n106\ttheorem prov_of {st : SC × SyncReg × ArenaReg} {S : Nat → Prop} {c l : Nat} {m : Mode}\n107\t    (hS : ∀ x m, Attr5 st.1 st.2.1 c x m → Allows (effective st.1.flat x l) m → S x)\n108\t    (h : Allows (cap5 st.1 st.2.1 c l) m) : ProvCap st S c l m := by\n109\t  obtain ⟨x, hx, ha, he⟩ := cap5_attained h\n110\t  exact ⟨x, hx, hS x m ha he, ha, he⟩\n111\t\n112\t/-- A capacity of provenance `S` is an attributable authority with a present effective mode. -/\n113\ttheorem some_of_prov {st : SC × SyncReg × ArenaReg} {S : Nat → Prop} {c l : Nat} {m : Mode}\n114\t    (h : ProvCap st S c l m) : ∃ x m', Attr5 st.1 st.2.1 c x m' ∧\n115\t      Allows (effective st.1.flat x l) m' :=\n116\t  let ⟨x, _, _, ha, he⟩ := h; ⟨x, m, ha, he⟩\n117\t\n118\t/-- Brief of the complement, task 5, step form: a step touching a leaf `l` that does not die\n119\t(task 3), with the required capacity of slice 3 (`CapReq`) and, for the by-value `spawn`, the\n120\tcapacity on the sources before the step (task 4), is made with the required capacity of\n121\tprovenance `S`, as soon as every attributable authority with a present effective mode on `l` is\n122\tin `S`; and some attributable authority has a present effective mode on `l`. -/\n123\ttheorem capFrom_step {k : K} {L : MutexLayout} {st st' : SC × SyncReg × ArenaReg} {lbl : Label}\n124\t    {l : Nat} {S : Nat → Prop} (hs : LStep k L lbl st st')\n125\t    (hS : ∀ c x m, Attr5 st.1 st.2.1 c x m → Allows (effective st.1.flat x l) m → S x)"},{"tool_use_id":"toolu_01A5iLazoNJYBwsHFRruZzFh","type":"tool_result","content":"195\t\n196\t/-- Brief of the complement, task 5: under I1 (Spec 1 §50) and WC5.2 C21 item 1 (the `guarded` of\n197\ta live entry is active, of own mode `Modify`), an authority that is not a live `guarded` and has a\n198\tpresent effective mode on a leaf of `footprint(guarded)` is a covering descendant of `guarded`:\n199\tan ancestor of `guarded` has no effective mode there (Spec 1 §43.3), and an unrelated one would\n200\tcontradict I1. -/\n201\ttheorem cov_of_attr {L : MutexLayout} {s : SC} {reg : SyncReg} {e : SyncEntry}\n202\t    (hi1 : I1 s.flat) (hinv : SyncInv L s reg) (he : e ∈ reg) (hl : e.Live s) {x l : Nat}\n203\t    (hng : NotGuarded s reg x) (hfp : l ∈ s.flat.afp e.guarded)\n204\t    (hex : effective s.flat x l ≠ none) : CoveringDesc s e.guarded x := by\n205\t  have hg := hinv.guarded e he hl\n206\t  obtain ⟨yg, hyg, ya⟩ := hl\n207\t  have hyg' : s.A[e.guarded]? = some yg := hyg\n208\t  rw [hyg'] at hg\n209\t  obtain ⟨hgm, -⟩ := hg\n210\t  obtain ⟨z, hz, za, hlz, hnm⟩ := eff_present hex\n211\t  have hxg : x ≠ e.guarded := hng e he ⟨yg, hyg, ya⟩\n212\t  have hlg : l ∈ yg.footprint := by rw [afp_of hyg'] at hfp; exact hfp\n213\t  by_cases h1 : x ∈ s.flat.ancs e.guarded\n214\t  · have hmem := mem_descModes (t := s.flat) hyg ya hlg h1\n215\t    rw [hgm] at hmem\n216\t    exact absurd hmem hnm\n217\t  · by_cases h2 : e.guarded ∈ s.flat.ancs x\n218\t    · exact ⟨h2, ⟨z, hz, za⟩, l, by rw [afp_of hz]; exact hlz, hfp⟩\n219\t    · have := hi1 x e.guarded z yg l hxg hz hyg za ya hlz hlg h1 h2\n220\t      rw [hgm] at this; cases this.2\n221\t\n222\t/-! ## The three cases -/\n223\t\n224\t/-- Brief of the complement, task 5, \"Trois cas\": on a `RunFull` from the initial state, under\n225\t`DDSound`, for every step of a context `c`, every entry `e` live before and after it and every\n226\tleaf `l` of `footprint(e.guarded)` in the final footprint of the step, the grant being read before\n227\tthe step:\n228\t* `grant = none`: no such step exists;\n229\t* `grant = some g` with `g` active: `c` has the required capacity (`CapFrom`) attained by `g` or a\n230\t  descendant of `g`;\n231\t* `grant = some g` with `g` inactive: `c` has the required capacity attained by a covering\n232\t  descendant of `e`.\n233\tInvariants used: I1 and WC5.2 C21 item 1 (`cov_of_attr`), C21 item 5 (`GrantSubtree`), C22\n234\t(`GrantDiscipline`); tasks 3 (`protected_not_dying_run`) and 4 (`spawnVal_cap_pre`) and the\n235\tcapacity of slice 3 (`capacity_run`). -/\n236\ttheorem three_cases {k : K} {L : MutexLayout} {statics : Statics}\n237\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n238\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n239\t    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {e : SyncEntry}\n240\t    (he : e ∈ (σ i).2.1) (hl : e.Live (σ i).1) (hl' : e.Live (σ (i + 1)).1) {l : Nat}\n241\t    (hfp : l ∈ (σ i).1.flat.afp e.guarded) (ht : TouchesF L (σ i) lbls[i] l) :\n242\t    (e.grant = none → False) ∧\n243\t    (∀ g, e.grant = some g → (σ i).1.flat.Active g →\n244\t      CapFrom k (σ i) (fun x => x = g ∨ g ∈ (σ i).1.flat.ancs x) lbls[i] l) ∧\n245\t    (∀ g, e.grant = some g → ¬ (σ i).1.flat.Active g →\n246\t      CapFrom k (σ i) (CoveringDesc (σ i).1 e.guarded) lbls[i] l) := by\n247\t  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n248\t  have hinv := hlib.1.1\n249\t  have hi1 := hk.parts.2.2\n250\t  have hw := hk.parts.2.1\n251\t  obtain ⟨yg, hyg, ya⟩ := hl\n252\t  have hfpg : l ∈ yg.footprint := by rw [afp_of hyg] at hfp; exact hfp\n253\t  obtain ⟨hlt, hleaf⟩ := hw.footprints e.guarded yg hyg l hfpg\n254\t  have hcap := capacity_run hdd hstat h0 h hi hleaf hlt ht\n255\t  have hnd := protected_not_dying_run hdd hstat h0 h hi ⟨yg, hyg, ya⟩ hl' hfp\n256\t  have hsv : ∀ c ps ls vs, lbls[i] = .spawnVal c ps ls vs → ∀ v ∈ vs,\n257\t      l ∈ footprint (σ i).1.P v.1 → ∃ x ∈ List.range (σ i).1.A.length,\n258\t        Attr5 (σ i).1 (σ i).2.1 c x .modify ∧ Allows (effective (σ i).1.flat x l) .modify :=\n259\t    fun c ps ls vs hlb v hv hlv => (spawnVal_cap_pre hdd hstat h0 h hi hlb v hv l hlv).1\n260\t  have hcov : ∀ c x m, Attr5 (σ i).1 (σ i).2.1 c x m →\n261\t      Allows (effective (σ i).1.flat x l) m → CoveringDesc (σ i).1 e.guarded x :=\n262\t    fun c x m ha hex => cov_of_attr hi1 hinv he ⟨yg, hyg, ya⟩ ha.notGuarded hfp\n263\t      (ne_none_of_allows hex)\n264\t  obtain ⟨hcf, x, m, hax, hex⟩ := capFrom_step (h i hi).2 hcov hlt hcap hnd hsv ht\n265\t  refine ⟨fun hn => ?_, fun g hg ha => ?_, fun g hg _ => hcf⟩\n266\t  · exact hlib.1.2 e he ⟨yg, hyg, ya⟩ hn _ (List.mem_range.2 (Attr5.lt hax)) (hcov _ x m hax hex)\n267\t  · refine (capFrom_step (S := fun x => x = g ∨ g ∈ (σ i).1.flat.ancs x) (h i hi).2\n268\t      (fun c x m hax hex => ?_) hlt hcap hnd hsv ht).1\n269\t    exact hinv.grantSubtree e he ⟨yg, hyg, ya⟩ g hg ha x (hcov c x m hax hex)\n270\t\n271\t/-- Brief of the complement, task 5, the fact \"Donnée protégée\" of §2 duodecies (v14 wording), for\n272\tthe 28 kinds: on a `RunFull` from the initial state, under `DDSound`, no step touches a leaf\n273\tprotected by an entry live before and after it without its context holding a capacity on that\n274\tleaf outside any chain through a live `guarded` (`cap5`, WC5.2 C43). -/\n275\ttheorem protected_cap_run {k : K} {L : MutexLayout} {statics : Statics}\n276\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n277\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n278\t    (h : RunFull k L σ lbls) {i : Nat} (hi : i < lbls.length) {e : SyncEntry}\n279\t    (hl : e.Live (σ i).1) (hl' : e.Live (σ (i + 1)).1) {l : Nat}\n280\t    (hfp : l ∈ (σ i).1.flat.afp e.guarded) (ht : TouchesF L (σ i) lbls[i] l) :\n281\t    cap5 (σ i).1 (σ i).2.1 lbls[i].ctx l ≠ none := by\n282\t  obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hi)\n283\t  obtain ⟨yg, hyg, ya⟩ := hl\n284\t  have hfpg : l ∈ yg.footprint := by rw [afp_of hyg] at hfp; exact hfp\n285\t  obtain ⟨hlt, hleaf⟩ := hk.parts.2.1.footprints e.guarded yg hyg l hfpg\n286\t  obtain ⟨-, x, m, hax, hex⟩ := capFrom_step (S := fun _ => True) (h i hi).2\n287\t    (fun _ _ _ _ _ => trivial) hlt (capacity_run hdd hstat h0 h hi hleaf hlt ht)\n288\t    (protected_not_dying_run hdd hstat h0 h hi ⟨yg, hyg, ya⟩ hl' hfp)\n289\t    (fun c ps ls vs hlb v hv hlv => (spawnVal_cap_pre hdd hstat h0 h hi hlb v hv l hlv).1) ht\n290\t  exact ne_none_of_allows (cap5_of hax hex)\n291\t\n292\t/-- Brief of the complement, task 5, \"Ensemble vide sans grant\": on a `RunFull` from the initial\n293\tstate, under `DDSound`, at every index where an entry is live with `grant = none`, its covering\n294\tdescendants are empty (`GrantDiscipline`, WC5.2 C22, on the reached states by `runFull_inv`). -/\n295\ttheorem empty_without_grant {k : K} {L : MutexLayout} {statics : Statics}\n296\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n297\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n298\t    (h : RunFull k L σ lbls) {n : Nat} (hn : n ≤ lbls.length) {e : SyncEntry}\n299\t    (he : e ∈ (σ n).2.1) (hl : e.Live (σ n).1) (hg : e.grant = none) :\n300\t    NoCoveringDesc (σ n).1 e.guarded :=\n301\t  (runFull_inv hdd hstat h0 h hn).2.1.2 e he hl hg\n302\t\n303\t/-! ## Last acquire -/\n304\t\n305\t/-- How a step changes the entry at index `i` of the registry (WC5.2 C12, C13, C16–C18 effects):\n306\tit is unchanged and the step is no `acquire` of `i`; or it has no grant; or the step is an\n307\t`acquire` of `i` that records the fresh identity `|A|` in an entry without grant. -/\n308\ttheorem reg_step {k : K} {L : MutexLayout} {lbl : Label} {st st' : SC × SyncReg × ArenaReg}\n309\t    (hs : LStep k L lbl st st') {i : Nat} {e' : SyncEntry} (he' : st'.2.1[i]? = some e') :\n310\t    (st.2.1[i]? = some e' ∧ ∀ c, lbl ≠ .acquire c i) ∨ e'.grant = none ∨\n311\t    (∃ c e, lbl = .acquire c i ∧ st.2.1[i]? = some e ∧ e.grant = none ∧\n312\t      e' = { e with grant := some st.1.A.length }) := by\n313\t  cases hs with\n314\t  | @newMutex s reg ar c g st₁ hn =>\n315\t    obtain ⟨-, -, rfl⟩ := hn\n316\t    by_cases hi : i < reg.length\n317\t    · refine .inl ⟨?_, fun c' h => by cases h⟩\n318\t      have : (reg ++ [⟨g, none⟩])[i]? = reg[i]? := List.getElem?_append_left hi\n319\t      rw [← this]; exact he'\n320\t    · refine .inr (.inl ?_)\n321\t      have h1 : (reg ++ [(⟨g, none⟩ : SyncEntry)])[i]? = some e' := he'\n322\t      rw [List.getElem?_append_right (Nat.le_of_not_lt hi)] at h1\n323\t      have h2 := List.mem_of_getElem? h1\n324\t      rw [List.mem_singleton] at h2\n325\t      rw [h2]\n326\t  | @acquire s reg ar c i₀ st₁ ha =>\n327\t    obtain ⟨-, e₀, hi₀, ⟨-, hn, -⟩, -, rfl⟩ := ha\n328\t    have h1 : (reg.set i₀ { e₀ with grant := some s.A.length })[i]? = some e' := he'\n329\t    by_cases e : i₀ = i\n330\t    · subst e\n331\t      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n332\t      cases h1\n333\t      exact .inr (.inr ⟨c, e₀, rfl, hi₀, hn, rfl⟩)\n334\t    · rw [List.getElem?_set_ne e] at h1\n335\t      exact .inl ⟨h1, fun c' h => by cases h; exact e rfl⟩\n336\t  | @unlock s reg ar c i₀ st₁ hu =>\n337\t    obtain ⟨-, e₀, g₀, hi₀, -, -, -, -, rfl⟩ := hu\n338\t    have h1 : (reg.set i₀ { e₀ with grant := none })[i]? = some e' := he'\n339\t    by_cases e : i₀ = i\n340\t    · subst e\n341\t      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n342\t      cases h1; exact .inr (.inl rfl)\n343\t    · rw [List.getElem?_set_ne e] at h1\n344\t      exact .inl ⟨h1, fun c' h => by cases h⟩\n345\t  | @resetLock s reg ar c i₀ st₁ hr =>\n346\t    obtain ⟨-, e₀, hi₀, -, -, -, rfl⟩ := hr\n347\t    have h1 : (reg.set i₀ { e₀ with grant := none })[i]? = some e' := he'\n348\t    by_cases e : i₀ = i\n349\t    · subst e\n350\t      rw [List.getElem?_set_self (lt_of_getElem? hi₀)] at h1\n351\t      cases h1; exact .inr (.inl rfl)\n352\t    · rw [List.getElem?_set_ne e] at h1\n353\t      exact .inl ⟨h1, fun c' h => by cases h⟩\n354\t  | kernel => exact .inl ⟨he', fun c' h => by cases h⟩\n355\t  | spawn => exact .inl ⟨he', fun c' h => by cases h⟩\n356\t  | terminate => exact .inl ⟨he', fun c' h => by cases h⟩\n357\t  | join => exact .inl ⟨he', fun c' h => by cases h⟩\n358\t  | deriveSync => exact .inl ⟨he', fun c' h => by cases h⟩\n359\t  | spawnVal => exact .inl ⟨he', fun c' h => by cases h⟩\n360\t  | newArena => exact .inl ⟨he', fun c' h => by cases h⟩\n361\t  | issue => exact .inl ⟨he', fun c' h => by cases h⟩\n362\t  | reset => exact .inl ⟨he', fun c' h => by cases h⟩\n363\t\n364\t/-- Brief of the complement, task 5, \"Dernière prise\": on a `RunFull` from the initial state,\n365\tunder `DDSound`, at every index `n` where the entry at index `i` of the registry is live with\n366\t`grant = some g`, there is a last successful `acquire` of `i` before `n`, at index `k`, which\n367\trecorded `g` (the fresh identity `|A|` of WC5.2 C16), and every covering descendant of the entry\n368\tis `g` or was created by a step `k'` with `k < k' < n` of case 2 of the closure (created from a\n369\tcovering descendant of the state before that step). No history of origins is kept in the state:\n370\tthe induction runs on the indices of the run. -/\n371\ttheorem last_acquire {k : K} {L : MutexLayout} {statics : Statics}\n372\t    {σ : Nat → SC × SyncReg × ArenaReg} {lbls : List Label} (hdd : DDSound k)\n373\t    (hstat : StaticsOK statics) (h0 : σ 0 = (SC.ofS3 (S3.init statics), [], []))\n374\t    (h : RunFull k L σ lbls) :\n375\t    ∀ n, n ≤ lbls.length → ∀ i e, (σ n).2.1[i]? = some e → e.Live (σ n).1 → ∀ g,\n376\t      e.grant = some g → ∃ kk, kk < n ∧ (∃ c, lbls[kk]? = some (.acquire c i)) ∧\n377\t        (∀ k', kk < k' → k' < n → ∀ c, lbls[k']? ≠ some (.acquire c i)) ∧\n378\t        g = (σ kk).1.A.length ∧\n379\t        ∀ j, CoveringDesc (σ n).1 e.guarded j → j = g ∨ ∃ k', kk < k' ∧ k' < n ∧\n380\t          (σ k').1.A.length ≤ j ∧ j < (σ (k' + 1)).1.A.length ∧\n381\t          ∃ o, (σ (k' + 1)).1.flat.org j = some o ∧ CoveringDesc (σ k').1 e.guarded o\n382\t  | 0, _, i, e, he, _, _, _ => by rw [h0] at he; cases he\n383\t  | n + 1, hn, i, e, he, hl, g, hg => by\n384\t    have hn' : n < lbls.length := hn\n385\t    obtain ⟨hk, hlib⟩ := runFull_inv hdd hstat h0 h (Nat.le_of_lt hn')\n386\t    have hinv := hlib.1.1\n387\t    have hs := (h n hn').2\n388\t    obtain ⟨hsk, -⟩ := shape_step hk hlib.2.1 (h n hn').1.1.1.1.1 hs\n389\t    have hcl := closure_run hdd hstat h0 h hn'\n390\t    have hlbl : lbls[n]? = some lbls[n] := List.getElem?_eq_getElem hn'\n391\t    rcases reg_step hs he with ⟨he₀, hna⟩ | hgn | ⟨c, e₀, hacq, he₀, hn₀, rfl⟩\n392\t    · have hb := hinv.regBound e (List.mem_of_getElem? he₀)\n393\t      have hl₀ : e.Live (σ n).1 := hsk.active hb hl\n394\t      obtain ⟨kk, hkk, hacq, hlast, hgk, hcov⟩ :=\n395\t        last_acquire hdd hstat h0 h n (Nat.le_of_lt hn') i e he₀ hl₀ g hg\n396\t      refine ⟨kk, by omega, hacq, fun k' h1 h2 c => ?_, hgk, fun j hj => ?_⟩\n397\t      · by_cases hk' : k' < n\n398\t        · exact hlast k' h1 hk' c\n399\t        · have : k' = n := by omega\n400\t          subst this\n401\t          rw [hlbl]; intro heq\n402\t          exact hna c (Option.some.inj heq)\n403\t      · rcases hcl e (List.mem_of_getElem? he₀) hl₀ hl j\n404\t          (List.mem_range.2 (active_lt hj.2.1)) hj with h1 | ⟨h1, o, ho, h2⟩ | h3\n405\t        · rcases hcov j h1 with h | ⟨k', a1, a2, a3⟩\n406\t          · exact .inl h\n407\t          · exact .inr ⟨k', a1, by omega, a3⟩\n408\t        · exact .inr ⟨n, hkk, Nat.lt_succ_self n, h1, active_lt hj.2.1, o, ho, h2⟩\n409\t        · exfalso\n410\t          revert h3\n411\t          unfold GrantOf\n412\t          split\n413\t          · rename_i c' i'' heq\n414\t            intro h3\n415\t            have hne : i'' ≠ i := fun hh => hna c' (by rw [heq, hh])\n416\t            revert h3\n417\t            cases hx : (σ n).2.1[i'']? with\n418\t            | none => exact id\n419\t            | some x =>\n420\t              rintro ⟨hgx, -⟩\n421\t              have hlx : x.Live (σ n).1 := by unfold SyncEntry.Live; rw [hgx]; exact hl₀\n422\t              exact hne (hinv.unique i'' i x e hx he₀ hlx hl₀ hgx)\n423\t          · exact id\n424\t    · rw [hgn] at hg; cases hg"}]}}
