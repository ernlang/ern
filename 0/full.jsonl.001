n Nat × Option Nat × Nat)} {i l : Nat}\n4279:theorem FreedLeaf.lt {s : S3} {p l : Nat} (h : FreedLeaf s p l) : l < s.P.length := by\n4442:theorem shape_root_fp_ge {i l : Nat} (h : l ∈ footprint (shapeP P hd ls) (P.length + i)) :\n4827:theorem alloc_owned_root_leaf {k : K} {pr ow : Nat} {s s' : S3} (hwf : WF3 s)\n5514:theorem init_fp_lt {i l : Nat} (h : l ∈ footprint (S3.init statics).P i) :\n5749:theorem S3.Usable.dead_false {s : S3} {q : Nat} (h : s.Usable q) : s.dead q = false := by\n6221:theorem store_keeps_target_reachable {s s' : S3} {a p : Nat} (h : StoreStep a p s (.ok s')) :\n6228:theorem store_writes_one_leaf {s s' : S3} {a p : Nat} (h : StoreStep a p s (.ok s')) :\n6244:theorem store_nonleaf_rejected {s : S3} {a p r : Nat} (hr : r < s.P.length)\n7184:theorem afp_addAuth_lt {s : S3} {y₀ : Authority} {j : Nat} (h : j < s.A.length) :\n8381:theorem reachable_invariants {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n8454:theorem reachable_access_invariant_underDD {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n8462:theorem reachable_no_dangling {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n8484:theorem reachable_rootLive {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n8524:theorem reachable_no_orphan {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n8532:theorem reachable_anchorOrderHeld {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n8581:theorem reachable_access_invariant_ext {k : K} (hdd : DDSound k) {statics : Statics} {s : S3}\n8717:theorem exitFrame_no_dangling_reachable {k : K} (hdd : DDSound k) {statics : Statics} {s s' : S3} {f : Nat}\n9780:theorem reachable_base_owns_statics {k : K} {statics : Statics} {s : S3}\n10010:theorem case16_reachable :\n10174:theorem shared_leaf_same_owner {s : S3} (hw : WF3 s) {q₁ q₂ l : Nat}\n10793:theorem lb5_reachable : Reachable K0 [] lb5 ∧ TransferStep K0 5 0 lb5 .reject ∧\n10855:theorem vw3_escape_rejected : Reachable K0 [] vw3 ∧ TransferStep K0 2 0 vw3 .reject := by\n10