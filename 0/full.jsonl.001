egX, [])]","+      [.kernel 0 (.derive 0 [2] .observe), .spawn 0 [4] [], .acquire 1 0, .kernel 1 (.store 4 3),","+        .unlock 1 0, .resetLock 0 0, .acquire 0 0, .kernel 0 (.release 4), .unlock 0 0,","+        .kernel 0 (.transfer 0 4)] :=","+    .cons (by decide) (.kernel d3) <| .cons (by decide) (.spawn s4) <|","+    .cons (by decide) (.acquire a5) <| .cons (by decide) (.kernel st6) <|","+    .cons (by decide) (.unlock u7) <| .cons (by decide) (.resetLock r8) <|","+    .cons (by decide) (.acquire a9) <| .cons (by decide) (.kernel rl10) <|","+    .cons (by decide) (.unlock u11) <| .cons (by decide) (.kernel t12) .nil","+  exact ⟨runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))","+    (by decide), by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩","+","+/-- The labels of the twin, without the `resetLock`. -/","+def uljLbls : List Label :=","+  [.kernel 0 (.derive 1 [3] .modify), .kernel 0 (.store 3 1), .newMutex 0 3,","+   .kernel 0 (.derive 0 [2] .observe), .spawn 0 [4] [], .acquire 1 0, .kernel 1 (.store 4 3),","+   .unlock 1 0, .acquire 0 0, .kernel 0 (.release 4), .unlock 0 0, .kernel 0 (.transfer 0 4)]","+","+/-- The named states of the twin. -/","+def uljσ (i : Nat) : SC × SyncReg × ArenaReg :=","+  [(x0, [], []), (x1, [], []), (x2, [], []), (x2, regX, []), (ul3, regX, []), (ul4, regX, []),","+    (ul5, [⟨3, some 5⟩], []), (ul6, [⟨3, some 5⟩], []), (ul7, regX, []),","+    (ul8, [⟨3, some 6⟩], []), (ul9, [⟨3, some 6⟩], []), (ul10, regX, []), (ul11, regX, [])].getD i","+    (ul11, regX, [])","+","+/-- The twin without the `resetLock`: a `RunFull` from the initial state; the same pair (indices 7","+and 11) has the same frontier and is ordered by the strict mutex edge from the `unlock` of `c1` to","+the `acquire` of `c0`. -/","+theorem unlock_r_eq_i_twin : RunFull KM L0 uljσ uljLbls ∧ ExtPair KM L0 uljσ uljLbls 7 11 2 ∧","+    IsFrontier KM uljσ uljLbls 7 11 2 7 ∧ SWS uljσ L0 uljLbls (.step 7) (.step 8) ∧","+    HBS uljσ L0 uljLbls (.step 7) (.step 11) ∧ HandoffOrderedExtAtS KM uljσ L0 uljLbls 7 11 2 := by","+  obtain ⟨d3, s4, a5, st6, u7, -, a9, rl10, u11, t12⟩ := ul_steps","+  have h : Steps5R KM L0 [(x2, regX, []), (ul3, regX, []), (ul4, regX, []),","+      (ul5, [⟨3, some 5⟩], []), (ul6, [⟨3, some 5⟩], []), (ul7, regX, []),","+      (ul8, [⟨3, some 6⟩], []), (ul9, [⟨3, some 6⟩], []), (ul10, regX, []), (ul11, regX, [])]","+      [.kernel 0 (.derive 0 [2] .observe), .spawn 0 [4] [], .acquire 1 0, .kernel 1 (.store 4 3),","+        .unlock 1 0, .acquire 0 0, .kernel 0 (.release 4), .unlock 0 0,","+        .kernel 0 (.transfer 0 4)] :=","+    .cons (by decide) (.kernel d3) <| .cons (by decide) (.spawn s4) <|","+    .cons (by decide) (.acquire a5) <| .cons (by decide) (.kernel st6) <|","+    .cons (by decide) (.unlock u7) <| .cons (by decide) (.acquire a9) <|","+    .cons (by decide) (.kernel rl10) <| .cons (by decide) (.unlock u11) <|","+    .cons (by decide) (.kernel t12) .nil","+  exact ⟨runFull_of_run7 (run7_of_run5R ((ClassifyWitness.mx3_steps h).run _) (by decide))","+    (by decide), by decide, by decide, by decide, by decide, by decide⟩","+"," end Ern.Concurrency.FullEncap.HandoffExtSame"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/HandoffExtSame.lean"]}},"serverClassifierContext":{"request":"80bf1f8a-744a-446a-9a92-141b84a0910b","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibi