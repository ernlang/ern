ff.1 hy'"]},{"oldStart":168,"oldLines":6,"newStart":175,"newLines":17,"lines":[" "," /-! ## The closure -/"," ","+/-- Case 3 of the closure: the step is an `acquire` of an entry whose `guarded` is that of `e`,","+and `j` is the grant it records, of fresh identity `|A|` (WC5.2 C16 effect). -/","+def GrantOf (st : SC × SyncReg × ArenaReg) (e : SyncEntry) (j : Nat) : Label → Prop","+  | .acquire _ i => OptP (st.2.1[i]?) (fun e' => e'.guarded = e.guarded ∧ j = st.1.A.length) False","+  | _ => False","+","+/-- Decidability of `GrantOf`. -/","+instance (st : SC × SyncReg × ArenaReg) (e : SyncEntry) (j : Nat) (lbl : Label) :","+    Decidable (GrantOf st e j lbl) := by","+  unfold GrantOf; split <;> infer_instance","+"," /-- The closure of the brief of the complement, task 2, for a step from `st` to `st'`: for every"," entry of the registry before the step, live before and after it, every covering descendant after"," the step is one before it (case 1), or is created by the step with an origin that is one before it"]},{"oldStart":179,"oldLines":20,"newStart":197,"newLines":12,"lines":["     CoveringDesc st'.1 e.guarded j →","       CoveringDesc st.1 e.guarded j ∨","       (st.1.A.length ≤ j ∧ ∃ o, st'.1.flat.org j = some o ∧ CoveringDesc st.1 e.guarded o) ∨","-      (∃ c i e', lbl = .acquire c i ∧ st.2.1[i]? = some e' ∧ e'.guarded = e.guarded ∧","-        j = st.1.A.length)","+      GrantOf st e j lbl"," "," /-- Decidability of `ClosureStep`. -/"," instance (st : SC × SyncReg × ArenaReg) (lbl : Label) (st' : SC × SyncReg × ArenaReg) :","     Decidable (ClosureStep st lbl st') := by","-  unfold ClosureStep","-  refine @List.decidableBAll _ _ (fun e => ?_) _","-  refine @instDecidableForall _ _ _ (fun _ => ?_)","-  refine @instDecidableForall _ _ _ (fun _ => ?_)","-  refine @List.decidableBAll _ _ (fun j => ?_) _","-  refine @instDecidableForall _ _ _ (fun _ => ?_)","-  refine @instDecidableOr _ _ _ (@instDecidableOr _ _ _ ?_)","-  cases lbl <;> simp only [reduceCtorEq, false_and, exists_false] <;> infer_instance","+  unfold ClosureStep; infer_instance"," "," /-- A covering descendant after a step read through `Skel` was one before it, or is created with"," an origin that is `g` itself or a covering descendant before the step (WC5.2 C22). -/"]}]}],"moreFiles":0,"changedFiles":["/Users/guygouri/Devlab/ernlang/ern/formal/Ern/Concurrency/FullEncap/Closure.lean"]}},"serverClassifierContext":{"request":"091d85fe-f0a6-47f5-9ac5-568455e12243","context":{"git_state":{"cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","root":"/Users/guygouri/Devlab/ernlang/ern","branch":"formal/spec2-m4","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"ernlang/ern","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"ernlang/ern","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"ernlang/ern","visibility":"public"}]}},"live_cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"bc46e3cf-0e2d-4969-90bf-372bde9cf9bc","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/guygouri/Devlab/ernlang/ern/formal","sessionId":"e6419d94-65c2-4a67-8a07-67ae7e574ad6","version":"2.1.321","gitBranch":"formal/spec2-m4","slug":"replicated-napping-garden"}
