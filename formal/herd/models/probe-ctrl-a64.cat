"Probe of the ctrl relation of aarch64.cat (aarch64deps.cat): flags only, no constraint"

(* As in aarch64.cat, catdep is in the main model file: with catdep only in the included file,
   the ctrl of aarch64deps.cat was observed empty on LB+ctrls-A64. *)
catdep

include "aarch64deps.cat"

flag ~empty (ctrl & (R * W)) as CtrlToWrite
flag ~empty (((R * W) & po) \ ctrl) as ReadWriteWithoutCtrl
